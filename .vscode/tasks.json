{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-server",
            "command": "dotnet",
            "type": "shell",
            "args": [
                "build",
                "-c",
                "Debug",
                "${workspaceFolder}/Marechai.Server/Marechai.Server.csproj"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build-app-desktop",
            "command": "dotnet",
            "type": "shell",
            "args": [
                "build",
                "-c",
                "Debug",
                "-f",
                "net10.0-desktop",
                "${workspaceFolder}/Marechai.App/Marechai.App.csproj"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build-app-wasm",
            "command": "dotnet",
            "type": "shell",
            "args": [
                "build",
                "-c",
                "Debug",
                "-f",
                "net10.0-browserwasm",
                "${workspaceFolder}/Marechai.App/Marechai.App.csproj"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "run-app-wasm",
            "command": "dotnet",
            "type": "shell",
            "args": [
                "run",
                "-c",
                "Debug",
                "-f",
                "net10.0-browserwasm",
                "--project",
                "${workspaceFolder}/Marechai.App/Marechai.App.csproj"
            ],
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^$",
                    "file": 1,
                    "location": 2,
                    "message": 3
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Building...",
                    "endsPattern": "Now listening on:"
                }
            }
        },
        {
            "label": "build-and-run-both",
            "dependsOn": [
                "build-server",
                "build-app-desktop"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build-all",
            "dependsOn": [
                "build-server",
                "build-app-desktop"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build-blazor",
            "command": "dotnet",
            "type": "shell",
            "args": [
                "build",
                "-c",
                "Debug",
                "${workspaceFolder}/Marechai/Marechai.csproj"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "clean",
            "command": "dotnet",
            "type": "shell",
            "args": [
                "clean",
                "${workspaceFolder}/Marechai.sln"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "reveal": "silent"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "restore",
            "command": "dotnet",
            "type": "shell",
            "args": [
                "restore",
                "${workspaceFolder}/Marechai.sln"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "reveal": "silent"
            },
            "problemMatcher": "$msCompile"
        }
    ]
}
