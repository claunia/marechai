<?xml version="1.0"
      encoding="utf-8"?>

<Page x:Class="Marechai.App.Presentation.Views.Admin.AdminResolutionsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
      x:Name="PageRoot"
      NavigationCacheMode="Required"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,0,0,1"
              Padding="16,12">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Source={StaticResource Strings}, Path=ResolutionManagementTitle}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextControlForeground}" />
                <TextBlock Text="{Binding Source={StaticResource Strings}, Path=ResolutionManagementSubtitle}"
                           FontSize="12"
                           Foreground="{ThemeResource SystemBaseMediumColor}"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">

            <StackPanel Visibility="{Binding IsAdmin, Converter={StaticResource InvertBoolToVisibilityConverter}}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Padding="24"
                        Spacing="16"
                        MaxWidth="400">
                <InfoBar IsOpen="True"
                         Severity="Warning"
                         Title="{Binding Source={StaticResource Strings}, Path=ResolutionMgmtAccessDeniedTitle}"
                         Message="{Binding Source={StaticResource Strings}, Path=ResolutionMgmtAccessDeniedMessage}"
                         IsClosable="False" />
            </StackPanel>

            <Grid Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}"
                  Canvas.ZIndex="0">

                <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Padding="32"
                            Spacing="16">
                    <ProgressRing IsActive="True" IsIndeterminate="True" Height="64" Width="64"
                                  Foreground="{ThemeResource SystemAccentColor}" />
                    <TextBlock Text="{Binding Source={StaticResource Strings}, Path=LoadingText}"
                               FontSize="14" TextAlignment="Center"
                               Foreground="{ThemeResource SystemBaseMediumColor}" />
                </StackPanel>

                <StackPanel Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"
                            VerticalAlignment="Center" HorizontalAlignment="Center"
                            Padding="24" Spacing="16" MaxWidth="400" Canvas.ZIndex="100">
                    <InfoBar IsOpen="True" Severity="Error"
                             Title="{Binding Source={StaticResource Strings}, Path=ErrorTitle}"
                             Message="{Binding ErrorMessage}" IsClosable="False" />
                    <Button Content="{Binding Source={StaticResource Strings}, Path=RetryButton}"
                            Command="{Binding LoadItemsCommand}"
                            HorizontalAlignment="Center" Style="{ThemeResource AccentButtonStyle}" />
                </StackPanel>

                <Grid Visibility="{Binding IsDataLoaded, Converter={StaticResource BoolToVisibilityConverter}}"
                      Canvas.ZIndex="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <CommandBar Grid.Row="0" DefaultLabelPosition="Right">
                                <AppBarButton Icon="Add"
                                              Label="{Binding Source={StaticResource Strings}, Path=AddResolutionButton}"
                                              Command="{Binding OpenAddCommand}" />
                                <AppBarButton Icon="Refresh"
                                              Label="{Binding Source={StaticResource Strings}, Path=RefreshResolutionsButton}"
                                              Command="{Binding LoadItemsCommand}" />
                            </CommandBar>

                            <AutoSuggestBox Grid.Row="1"
                                            Margin="16,8,16,0"
                                            PlaceholderText="{Binding Source={StaticResource Strings}, Path=ResolutionSearchPlaceholder}"
                                            QueryIcon="Find"
                                            Text="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            x:Name="FilterBox"
                                            TextChanged="FilterBox_TextChanged" />

                            <controls:DataGrid Grid.Row="2"
                                               Margin="16"
                                               ItemsSource="{Binding FilteredResolutions}"
                                               SelectedItem="{Binding SelectedResolution, Mode=TwoWay}"
                                               AutoGenerateColumns="False"
                                               GridLinesVisibility="None"
                                               HeadersVisibility="Column"
                                               AlternatingRowBackground="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                               CanUserReorderColumns="True"
                                               CanUserResizeColumns="True"
                                               CanUserSortColumns="True"
                                               IsReadOnly="True"
                                               SelectionMode="Single"
                                               HorizontalScrollBarVisibility="Auto"
                                               VerticalScrollBarVisibility="Auto">
                                <controls:DataGrid.Columns>
                                    <controls:DataGridTextColumn
                                        Header="{Binding Source={StaticResource Strings}, Path=ResolutionWidthColumn}"
                                        Binding="{Binding Width}" Width="*" />
                                    <controls:DataGridTextColumn
                                        Header="{Binding Source={StaticResource Strings}, Path=ResolutionHeightColumn}"
                                        Binding="{Binding Height}" Width="*" />
                                    <controls:DataGridTextColumn
                                        Header="{Binding Source={StaticResource Strings}, Path=ResolutionColorsColumn}"
                                        Binding="{Binding Colors}" Width="*" />
                                    <controls:DataGridTextColumn
                                        Header="{Binding Source={StaticResource Strings}, Path=ResolutionPaletteColumn}"
                                        Binding="{Binding Palette}" Width="*" />
                                    <controls:DataGridCheckBoxColumn
                                        Header="{Binding Source={StaticResource Strings}, Path=ResolutionCharsColumn}"
                                        Binding="{Binding Chars}" Width="Auto" />
                                    <controls:DataGridCheckBoxColumn
                                        Header="{Binding Source={StaticResource Strings}, Path=ResolutionGrayscaleColumn}"
                                        Binding="{Binding Grayscale}" Width="Auto" />
                                    <controls:DataGridTemplateColumn
                                        Header="{Binding Source={StaticResource Strings}, Path=ActionsColumn}"
                                        Width="Auto">
                                        <controls:DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <Button Content="&#xE3C9;"
                                                            ToolTipService.ToolTip="{Binding Source={StaticResource Strings}, Path=EditResolutionButton}"
                                                            Command="{Binding DataContext.OpenEditCommand, ElementName=PageRoot}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource AdminGridActionButtonStyle}" />
                                                    <Button Content="&#xE872;"
                                                            ToolTipService.ToolTip="{Binding Source={StaticResource Strings}, Path=DeleteResolutionButton}"
                                                            Command="{Binding DataContext.DeleteCommand, ElementName=PageRoot}"
                                                            CommandParameter="{Binding}"
                                                            Foreground="{ThemeResource SystemErrorTextColor}"
                                                            Style="{StaticResource AdminGridActionButtonStyle}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </controls:DataGridTemplateColumn.CellTemplate>
                                    </controls:DataGridTemplateColumn>
                                </controls:DataGrid.Columns>
                            </controls:DataGrid>
                        </Grid>

                        <Border Grid.Column="1"
                                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}"
                                Width="360"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="1,0,0,0">
                            <Grid RowSpacing="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Padding="16,12"
                                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                      BorderThickness="0,0,0,1">
                                    <TextBlock Text="{Binding EditPanelTitle}"
                                               FontSize="18" FontWeight="SemiBold" />
                                </Grid>

                                <ScrollViewer Grid.Row="1" Padding="16"
                                              VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="12">
                                        <NumberBox Header="{Binding Source={StaticResource Strings}, Path=ResolutionWidthLabel}"
                                                   Value="{Binding Width, Mode=TwoWay}"
                                                   SpinButtonPlacementMode="Compact"
                                                   Minimum="1" Maximum="131072" SmallChange="1"
                                                   HorizontalAlignment="Stretch" />

                                        <NumberBox Header="{Binding Source={StaticResource Strings}, Path=ResolutionHeightLabel}"
                                                   Value="{Binding Height, Mode=TwoWay}"
                                                   SpinButtonPlacementMode="Compact"
                                                   Minimum="1" Maximum="131072" SmallChange="1"
                                                   HorizontalAlignment="Stretch" />

                                        <NumberBox Header="{Binding Source={StaticResource Strings}, Path=ResolutionColorsLabel}"
                                                   Value="{Binding Colors, Mode=TwoWay}"
                                                   SpinButtonPlacementMode="Compact"
                                                   Minimum="2" SmallChange="1"
                                                   HorizontalAlignment="Stretch" />

                                        <NumberBox Header="{Binding Source={StaticResource Strings}, Path=ResolutionPaletteLabel}"
                                                   Value="{Binding Palette, Mode=TwoWay}"
                                                   SpinButtonPlacementMode="Compact"
                                                   Minimum="2" SmallChange="1"
                                                   HorizontalAlignment="Stretch" />

                                        <CheckBox Content="{Binding Source={StaticResource Strings}, Path=ResolutionCharsLabel}"
                                                  IsChecked="{Binding Chars, Mode=TwoWay}" />

                                        <CheckBox Content="{Binding Source={StaticResource Strings}, Path=ResolutionGrayscaleLabel}"
                                                  IsChecked="{Binding Grayscale, Mode=TwoWay}" />
                                    </StackPanel>
                                </ScrollViewer>

                                <Grid Grid.Row="2" Padding="16,12"
                                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                      BorderThickness="0,1,0,0" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Content="{Binding Source={StaticResource Strings}, Path=CancelButton}"
                                            Command="{Binding CancelEditCommand}"
                                            HorizontalAlignment="Stretch" />
                                    <Button Grid.Column="1"
                                            Content="{Binding Source={StaticResource Strings}, Path=SaveButton}"
                                            Command="{Binding SaveCommand}"
                                            HorizontalAlignment="Stretch"
                                            Style="{ThemeResource AccentButtonStyle}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
