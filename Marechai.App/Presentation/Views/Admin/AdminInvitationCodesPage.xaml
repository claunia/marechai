<?xml version="1.0" encoding="utf-8"?>

<Page x:Class="Marechai.App.Presentation.Views.Admin.AdminInvitationCodesPage"
      x:Name="PageRoot"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,0,0,1"
              Padding="16,12">
            <StackPanel>
                <TextBlock Text="{Binding Source={StaticResource Strings}, Path=InvitationCodesTitle}"
                           FontSize="20"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding Source={StaticResource Strings}, Path=InvitationCodesSubtitle}"
                           TextWrapping="WrapWholeWords"
                           Opacity="0.7"
                           Margin="0,4,0,8" />
                <StackPanel Orientation="Horizontal"
                            Spacing="12">
                    <Button Content="{Binding Source={StaticResource Strings}, Path=InvitationCodesGenerateButton}"
                            Command="{Binding GenerateCodeCommand}"
                            IsEnabled="{Binding IsGenerating, Converter={StaticResource InvertBoolConverter}}"
                            Style="{ThemeResource AccentButtonStyle}" />
                    <CheckBox Content="{Binding Source={StaticResource Strings}, Path=InvitationCodesShowUnusedOnly}"
                              IsChecked="{Binding UnusedOnly, Mode=TwoWay}"
                              Command="{Binding ToggleUnusedOnlyCommand}" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1"
                    Padding="16,8"
                    Spacing="8">
            <InfoBar IsOpen="{Binding LastGeneratedCode, Converter={StaticResource StringNotEmptyToBoolConverter}}"
                     Severity="Success"
                     Title="{Binding Source={StaticResource Strings}, Path=InvitationCodesGeneratedBanner}"
                     Message="{Binding LastGeneratedCode}"
                     IsClosable="True" />

            <InfoBar IsOpen="{Binding HasError}"
                     Severity="Error"
                     Title="{Binding Source={StaticResource Strings}, Path=InvitationCodesFailedToLoad}"
                     Message="{Binding ErrorMessage}"
                     IsClosable="True" />
        </StackPanel>

        <Grid Grid.Row="2">
            <StackPanel Visibility="{Binding IsLoading}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Padding="32"
                        Spacing="16">
                <ProgressRing IsActive="True"
                              IsIndeterminate="True"
                              Height="64"
                              Width="64" />
            </StackPanel>

            <ScrollViewer Visibility="{Binding IsDataLoaded}"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Codes}"
                              Margin="12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16,12"
                                    Margin="0,0,0,8">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0"
                                                Spacing="4">
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="8">
                                            <TextBlock Text="{Binding Code}"
                                                       FontFamily="Consolas"
                                                       FontWeight="SemiBold" />
                                            <Button Content="{Binding Source={StaticResource Strings}, Path=InvitationCodesCopyButton}"
                                                    Click="CopyCodeButton_OnClick"
                                                    Padding="6,2"
                                                    Background="Transparent"
                                                    BorderThickness="0" />
                                            <TextBlock Text="{Binding Source={StaticResource Strings}, Path=InvitationCodesStatusUsed}"
                                                       Visibility="{Binding IsUsed, Converter={StaticResource BoolToVisibilityConverter}}"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"
                                                       Opacity="0.7" />
                                            <TextBlock Text="{Binding Source={StaticResource Strings}, Path=InvitationCodesStatusUnused}"
                                                       Visibility="{Binding IsUsed, Converter={StaticResource InvertBoolToVisibilityConverter}}"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"
                                                       Opacity="0.7" />
                                        </StackPanel>
                                        <TextBlock FontSize="12"
                                                   Opacity="0.7">
                                            <Run Text="{Binding CreatedByUserName}" />
                                            <Run Text="·" />
                                            <Run Text="{Binding CreatedOn}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding UsedByUserName}"
                                                   Visibility="{Binding IsUsed, Converter={StaticResource BoolToVisibilityConverter}}"
                                                   FontSize="12"
                                                   Opacity="0.7" />
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            Content="{Binding Source={StaticResource Strings}, Path=InvitationCodesRevokeButton}"
                                            IsEnabled="{Binding IsUsed, Converter={StaticResource InvertBoolConverter}}"
                                            Click="RevokeButton_OnClick"
                                            VerticalAlignment="Top" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
