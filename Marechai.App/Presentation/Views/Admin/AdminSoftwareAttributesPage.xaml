<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="Marechai.App.Presentation.Views.Admin.AdminSoftwareAttributesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
      x:Name="PageRoot"
      NavigationCacheMode="Required"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="16,12">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Source={StaticResource Strings}, Path=SoftwareAttributesManagementTitle}"
                           FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource TextControlForeground}" />
                <TextBlock Text="{Binding Source={StaticResource Strings}, Path=SoftwareAttributesManagementSubtitle}"
                           FontSize="12" Foreground="{ThemeResource SystemBaseMediumColor}" Margin="0,4,0,0" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <StackPanel Visibility="{Binding IsAdmin, Converter={StaticResource InvertBoolToVisibilityConverter}}"
                        VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24" Spacing="16" MaxWidth="400">
                <InfoBar IsOpen="True" Severity="Warning"
                         Title="{Binding Source={StaticResource Strings}, Path=AccessDeniedTitle}"
                         Message="{Binding Source={StaticResource Strings}, Path=AccessDeniedMessage}"
                         IsClosable="False" />
            </StackPanel>

            <Grid Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                            VerticalAlignment="Center" HorizontalAlignment="Center" Padding="32" Spacing="16">
                    <ProgressRing IsActive="True" IsIndeterminate="True" Height="64" Width="64"
                                  Foreground="{ThemeResource SystemAccentColor}" />
                    <TextBlock Text="{Binding Source={StaticResource Strings}, Path=LoadingText}"
                               FontSize="14" TextAlignment="Center" Foreground="{ThemeResource SystemBaseMediumColor}" />
                </StackPanel>

                <Grid Visibility="{Binding IsDataLoaded, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="16,16,16,0" Spacing="8">
                                <InfoBar IsOpen="{Binding HasError}" Severity="Error"
                                         Title="{Binding Source={StaticResource Strings}, Path=ErrorTitle}"
                                         Message="{Binding ErrorMessage}" />
                                <InfoBar IsOpen="{Binding HasSuccess}" Severity="Success"
                                         Title="{Binding Source={StaticResource Strings}, Path=SuccessTitle}"
                                         Message="{Binding SuccessMessage}" />
                            </StackPanel>

                            <CommandBar Grid.Row="1" DefaultLabelPosition="Right">
                                <AppBarButton Icon="Add"
                                              Label="{Binding Source={StaticResource Strings}, Path=AddButton}"
                                              Command="{Binding OpenAddCommand}" />
                                <AppBarButton Icon="Refresh"
                                              Label="{Binding Source={StaticResource Strings}, Path=RefreshButton}"
                                              Command="{Binding LoadCommand}" />
                                <AppBarButton Icon="Clear"
                                              Label="{Binding Source={StaticResource Strings}, Path=SoftwareAttributesClearFilters}"
                                              Command="{Binding ClearFiltersCommand}" />
                            </CommandBar>

                            <Grid Grid.Row="2" Margin="16,8,16,0" ColumnSpacing="12" RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <AutoSuggestBox Grid.Row="0" Grid.Column="0"
                                                Header="{Binding Source={StaticResource Strings}, Path=SoftwareAttributesFilterSoftwareLabel}"
                                                PlaceholderText="{Binding Source={StaticResource Strings}, Path=SoftwareAttributesSearchSoftwarePlaceholder}"
                                                Text="{Binding FilterSoftwareText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                ItemsSource="{Binding FilterSoftwareSuggestions}"
                                                QueryIcon="Find"
                                                TextChanged="FilterSoftwareBox_TextChanged"
                                                SuggestionChosen="FilterSoftwareBox_SuggestionChosen"
                                                QuerySubmitted="FilterSoftwareBox_QuerySubmitted">
                                    <AutoSuggestBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" />
                                        </DataTemplate>
                                    </AutoSuggestBox.ItemTemplate>
                                </AutoSuggestBox>

                                <AutoSuggestBox Grid.Row="0" Grid.Column="1"
                                                Header="{Binding Source={StaticResource Strings}, Path=SoftwareAttributesFilterReleaseLabel}"
                                                PlaceholderText="{Binding Source={StaticResource Strings}, Path=SoftwareAttributesSearchReleasePlaceholder}"
                                                Text="{Binding FilterReleaseText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                ItemsSource="{Binding FilterReleaseSuggestions}"
                                                QueryIcon="Find"
                                                TextChanged="FilterReleaseBox_TextChanged"
                                                SuggestionChosen="FilterReleaseBox_SuggestionChosen"
                                                QuerySubmitted="FilterReleaseBox_QuerySubmitted">
                                    <AutoSuggestBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Title}" />
                                        </DataTemplate>
                                    </AutoSuggestBox.ItemTemplate>
                                </AutoSuggestBox>

                                <AutoSuggestBox Grid.Row="1" Grid.Column="0"
                                                Header="{Binding Source={StaticResource Strings}, Path=SoftwareAttributesCategoryLabel}"
                                                PlaceholderText="{Binding Source={StaticResource Strings}, Path=SoftwareAttributesSearchCategoryPlaceholder}"
                                                Text="{Binding FilterCategoryText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                ItemsSource="{Binding FilterCategorySuggestions}"
                                                QueryIcon="Find"
                                                TextChanged="FilterCategoryBox_TextChanged"
                                                SuggestionChosen="FilterCategoryBox_SuggestionChosen"
                                                QuerySubmitted="FilterCategoryBox_QuerySubmitted" />

                                <AutoSuggestBox Grid.Row="1" Grid.Column="1"
                                                Header="{Binding Source={StaticResource Strings}, Path=SoftwareAttributesKeyLabel}"
                                                PlaceholderText="{Binding Source={StaticResource Strings}, Path=SoftwareAttributesSearchKeyPlaceholder}"
                                                Text="{Binding FilterKeyText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                ItemsSource="{Binding FilterKeySuggestions}"
                                                QueryIcon="Find"
                                                TextChanged="FilterKeyBox_TextChanged"
                                                SuggestionChosen="FilterKeyBox_SuggestionChosen"
                                                QuerySubmitted="FilterKeyBox_QuerySubmitted" />
                            </Grid>

                            <controls:DataGrid Grid.Row="3" Margin="16"
                                               ItemsSource="{Binding Attributes}"
                                               AutoGenerateColumns="False"
                                               GridLinesVisibility="None"
                                               HeadersVisibility="Column"
                                               AlternatingRowBackground="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                               CanUserReorderColumns="True"
                                               CanUserResizeColumns="True"
                                               CanUserSortColumns="False"
                                               IsReadOnly="True"
                                               SelectionMode="Single"
                                               HorizontalScrollBarVisibility="Auto"
                                               VerticalScrollBarVisibility="Auto">
                                <controls:DataGrid.Columns>
                                    <controls:DataGridTextColumn Header="{Binding Source={StaticResource Strings}, Path=SoftwareAttributesSoftwareColumn}"
                                                                 Binding="{Binding SoftwareName}" Width="*" />
                                    <controls:DataGridTextColumn Header="{Binding Source={StaticResource Strings}, Path=SoftwareAttributesReleaseColumn}"
                                                                 Binding="{Binding SoftwareReleaseTitle}" Width="*" />
                                    <controls:DataGridTextColumn Header="{Binding Source={StaticResource Strings}, Path=SoftwareAttributesCategoryLabel}"
                                                                 Binding="{Binding Category}" Width="Auto" />
                                    <controls:DataGridTextColumn Header="{Binding Source={StaticResource Strings}, Path=SoftwareAttributesKeyLabel}"
                                                                 Binding="{Binding Key}" Width="Auto" />
                                    <controls:DataGridTextColumn Header="{Binding Source={StaticResource Strings}, Path=SoftwareAttributesValueLabel}"
                                                                 Binding="{Binding Value}" Width="2*" />
                                    <controls:DataGridTemplateColumn Header="{Binding Source={StaticResource Strings}, Path=ActionsColumn}"
                                                                     Width="Auto">
                                        <controls:DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <Button Content="{Binding Source={StaticResource Strings}, Path=EditButton}"
                                                            Command="{Binding DataContext.OpenEditCommand, ElementName=PageRoot}"
                                                            CommandParameter="{Binding}"
                                                            Style="{ThemeResource TextBlockButtonStyle}" Padding="8,4" />
                                                    <Button Content="{Binding Source={StaticResource Strings}, Path=DeleteButton}"
                                                            Command="{Binding DataContext.DeleteCommand, ElementName=PageRoot}"
                                                            CommandParameter="{Binding}"
                                                            Foreground="{ThemeResource SystemErrorTextColor}"
                                                            Style="{ThemeResource TextBlockButtonStyle}" Padding="8,4" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </controls:DataGridTemplateColumn.CellTemplate>
                                    </controls:DataGridTemplateColumn>
                                </controls:DataGrid.Columns>
                            </controls:DataGrid>

                            <Grid Grid.Row="4" Margin="16,0,16,16" ColumnSpacing="12" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Content="{Binding Source={StaticResource Strings}, Path=PreviousPageButton}"
                                        Command="{Binding PreviousPageCommand}"
                                        IsEnabled="{Binding CanGoPrevious}" />
                                <Button Grid.Column="1"
                                        Content="{Binding Source={StaticResource Strings}, Path=NextPageButton}"
                                        Command="{Binding NextPageCommand}"
                                        IsEnabled="{Binding CanGoNext}" />
                                <TextBlock Grid.Column="2" Text="{Binding PageSummary}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3"
                                           Text="{Binding Source={StaticResource Strings}, Path=SoftwareAttributesPageSizeLabel}"
                                           VerticalAlignment="Center" />
                                <ComboBox Grid.Column="4" Width="90"
                                          ItemsSource="{Binding PageSizeOptions}"
                                          SelectedItem="{Binding PageSize, Mode=TwoWay}"
                                          SelectionChanged="PageSizeCombo_SelectionChanged" />
                            </Grid>
                        </Grid>

                        <Border Grid.Column="1"
                                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}"
                                Width="420"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="1,0,0,0">
                            <Grid RowSpacing="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Padding="16,12"
                                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                    <TextBlock Text="{Binding EditPanelTitle}" FontSize="18" FontWeight="SemiBold" />
                                </Grid>

                                <ScrollViewer Grid.Row="1" Padding="16" VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="12">
                                        <StackPanel Visibility="{Binding IsEditingExisting, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="{Binding Source={StaticResource Strings}, Path=SoftwareAttributesContextLabel}"
                                                       FontSize="12" Opacity="0.7" />
                                            <TextBlock Text="{Binding EditingContextText}" TextWrapping="WrapWholeWords" />
                                        </StackPanel>

                                        <StackPanel Visibility="{Binding IsEditingExisting, Converter={StaticResource InvertBoolToVisibilityConverter}}"
                                                    Spacing="12">
                                            <AutoSuggestBox Header="{Binding Source={StaticResource Strings}, Path=SoftwareAttributesFilterSoftwareLabel}"
                                                            PlaceholderText="{Binding Source={StaticResource Strings}, Path=SoftwareAttributesSearchSoftwarePlaceholder}"
                                                            Text="{Binding EditSoftwareText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            ItemsSource="{Binding EditSoftwareSuggestions}"
                                                            QueryIcon="Find"
                                                            TextChanged="EditSoftwareBox_TextChanged"
                                                            SuggestionChosen="EditSoftwareBox_SuggestionChosen"
                                                            QuerySubmitted="EditSoftwareBox_QuerySubmitted">
                                                <AutoSuggestBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Name}" />
                                                    </DataTemplate>
                                                </AutoSuggestBox.ItemTemplate>
                                            </AutoSuggestBox>

                                            <ComboBox Header="{Binding Source={StaticResource Strings}, Path=SoftwareAttributesFilterReleaseLabel}"
                                                      ItemsSource="{Binding EditReleaseSuggestions}"
                                                      SelectedItem="{Binding SelectedEditRelease, Mode=TwoWay}"
                                                      HorizontalAlignment="Stretch">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Title}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>

                                        <AutoSuggestBox Header="{Binding Source={StaticResource Strings}, Path=SoftwareAttributesCategoryLabel}"
                                                        PlaceholderText="{Binding Source={StaticResource Strings}, Path=SoftwareAttributesSearchCategoryPlaceholder}"
                                                        Text="{Binding EditCategory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        ItemsSource="{Binding EditCategorySuggestions}"
                                                        QueryIcon="Find"
                                                        TextChanged="EditCategoryBox_TextChanged"
                                                        SuggestionChosen="EditCategoryBox_SuggestionChosen"
                                                        QuerySubmitted="EditCategoryBox_QuerySubmitted" />

                                        <AutoSuggestBox Header="{Binding Source={StaticResource Strings}, Path=SoftwareAttributesKeyLabel}"
                                                        PlaceholderText="{Binding Source={StaticResource Strings}, Path=SoftwareAttributesSearchKeyPlaceholder}"
                                                        Text="{Binding EditKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        ItemsSource="{Binding EditKeySuggestions}"
                                                        QueryIcon="Find"
                                                        TextChanged="EditKeyBox_TextChanged"
                                                        SuggestionChosen="EditKeyBox_SuggestionChosen"
                                                        QuerySubmitted="EditKeyBox_QuerySubmitted" />

                                        <TextBox Header="{Binding Source={StaticResource Strings}, Path=SoftwareAttributesValueLabel}"
                                                 Text="{Binding AttributeValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80" />

                                        <StackPanel Visibility="{Binding CanShowSplitSection, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Spacing="8">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button Content="{Binding Source={StaticResource Strings}, Path=SoftwareAttributesSplitPreviewButton}"
                                                        Command="{Binding PreviewSplitCommand}"
                                                        IsEnabled="{Binding IsSplitBusy, Converter={StaticResource InvertBoolConverter}}" />
                                                <Button Content="{Binding Source={StaticResource Strings}, Path=SoftwareAttributesSplitApplyButton}"
                                                        Command="{Binding ApplySplitCommand}"
                                                        IsEnabled="{Binding CanApplySplit}" />
                                            </StackPanel>

                                            <ProgressRing IsActive="{Binding IsSplitBusy}" Width="32" Height="32"
                                                          Visibility="{Binding IsSplitBusy, Converter={StaticResource BoolToVisibilityConverter}}" />

                                            <ItemsRepeater Visibility="{Binding IsSplitPreviewVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                                           ItemsSource="{Binding SplitPreviewFragments}">
                                                <ItemsRepeater.Layout>
                                                    <StackLayout Spacing="6" />
                                                </ItemsRepeater.Layout>
                                                <ItemsRepeater.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Padding="8" CornerRadius="6"
                                                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <TextBlock Text="{Binding Value}" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding Source={StaticResource Strings}, Path=SoftwareAttributesSplitExistingLabel}"
                                                                           VerticalAlignment="Center" Opacity="0.7"
                                                                           Visibility="{Binding AlreadyExisted, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                <TextBlock Text="{Binding Source={StaticResource Strings}, Path=SoftwareAttributesSplitNewLabel}"
                                                                           VerticalAlignment="Center" Opacity="0.7"
                                                                           Visibility="{Binding AlreadyExisted, Converter={StaticResource InvertBoolToVisibilityConverter}}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsRepeater.ItemTemplate>
                                            </ItemsRepeater>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>

                                <Grid Grid.Row="2" Padding="16,12"
                                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
                                      ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Content="{Binding Source={StaticResource Strings}, Path=CancelButton}"
                                            Command="{Binding CancelEditCommand}" />
                                    <Button Grid.Column="1"
                                            Content="{Binding Source={StaticResource Strings}, Path=SaveButton}"
                                            Command="{Binding SaveCommand}"
                                            Style="{ThemeResource AccentButtonStyle}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
