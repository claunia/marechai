<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="Marechai.App.Presentation.Views.Admin.AdminSoftwareReleasesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
      x:Name="PageRoot" NavigationCacheMode="Required" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid RowSpacing="0">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Content="&#xE72B;"
                    Command="{Binding GoBackCommand}"
                    Style="{ThemeResource TextBlockButtonStyle}"
                    Padding="8,4"
                    VerticalAlignment="Center"
                    Margin="0,0,12,0" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding PageTitle}" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource TextControlForeground}" />
                <TextBlock Text="{Binding Source={StaticResource Strings}, Path=SoftwareReleaseManagementSubtitle}" FontSize="12" Foreground="{ThemeResource SystemBaseMediumColor}" Margin="0,4,0,0" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1">
            <StackPanel Visibility="{Binding IsAdmin, Converter={StaticResource InvertBoolToVisibilityConverter}}"
                        VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24" Spacing="16" MaxWidth="400">
                <InfoBar IsOpen="True" Severity="Warning" Title="{Binding Source={StaticResource Strings}, Path=AccessDeniedTitle}"
                         Message="{Binding Source={StaticResource Strings}, Path=AccessDeniedMessage}" IsClosable="False" />
            </StackPanel>
            <Grid Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}" Canvas.ZIndex="0">
                <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                            VerticalAlignment="Center" HorizontalAlignment="Center" Padding="32" Spacing="16">
                    <ProgressRing IsActive="True" IsIndeterminate="True" Height="64" Width="64" Foreground="{ThemeResource SystemAccentColor}" />
                    <TextBlock Text="{Binding Source={StaticResource Strings}, Path=LoadingText}" FontSize="14" TextAlignment="Center" />
                </StackPanel>
                <StackPanel Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"
                            VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24" Spacing="16" MaxWidth="400" Canvas.ZIndex="100">
                    <InfoBar IsOpen="True" Severity="Error" Title="{Binding Source={StaticResource Strings}, Path=ErrorTitle}" Message="{Binding ErrorMessage}" IsClosable="False" />
                    <Button Content="{Binding Source={StaticResource Strings}, Path=RetryButton}" Command="{Binding LoadCommand}" HorizontalAlignment="Center" Style="{ThemeResource AccentButtonStyle}" />
                </StackPanel>
                <Grid Visibility="{Binding IsDataLoaded, Converter={StaticResource BoolToVisibilityConverter}}" Canvas.ZIndex="1">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <CommandBar Grid.Row="0" DefaultLabelPosition="Right">
                                <AppBarButton Icon="Add" Label="{Binding Source={StaticResource Strings}, Path=AddButton}" Command="{Binding OpenAddCommand}" />
                                <AppBarButton Icon="Refresh" Label="{Binding Source={StaticResource Strings}, Path=RefreshButton}" Command="{Binding LoadCommand}" />
                            </CommandBar>
                            <AutoSuggestBox Grid.Row="1" Margin="16,8,16,0" PlaceholderText="{Binding Source={StaticResource Strings}, Path=SearchPlaceholder}"
                                            QueryIcon="Find" Text="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" x:Name="FilterBox" TextChanged="FilterBox_TextChanged" />
                            <controls:DataGrid Grid.Row="2" Margin="16" ItemsSource="{Binding FilteredReleases}" AutoGenerateColumns="False"
                                               GridLinesVisibility="None" HeadersVisibility="Column" AlternatingRowBackground="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                               CanUserSortColumns="True" IsReadOnly="True" SelectionMode="Single"
                                               HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <controls:DataGrid.Columns>
                                    <controls:DataGridTextColumn Header="{Binding Source={StaticResource Strings}, Path=SoftwareVersionColumn_Header}" Binding="{Binding SoftwareVersion}" Width="2*" />
                                    <controls:DataGridTextColumn Header="{Binding Source={StaticResource Strings}, Path=PlatformColumn_Header}" Binding="{Binding Platform}" Width="*" />
                                    <controls:DataGridTextColumn Header="{Binding Source={StaticResource Strings}, Path=PublisherColumn_Header}" Binding="{Binding Publisher}" Width="*" />
                                    <controls:DataGridTextColumn Header="{Binding Source={StaticResource Strings}, Path=ReleaseDateColumn_Header}" Binding="{Binding ReleaseDate, Converter={StaticResource DateOnlyConverter}}" Width="Auto" />
                                    <controls:DataGridTemplateColumn Header="{Binding Source={StaticResource Strings}, Path=ActionsColumn_Header}" Width="Auto">
                                        <controls:DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <Button Content="&#xE70F;"
                                                            ToolTipService.ToolTip="{Binding Source={StaticResource Strings}, Path=EditButton}" Command="{Binding DataContext.OpenEditCommand, ElementName=PageRoot}" CommandParameter="{Binding}" Style="{StaticResource AdminGridActionButtonStyle}" />
                                                    <Button Content="{Binding Source={StaticResource Strings}, Path=SoftwareCoverManagementButton}" Command="{Binding DataContext.OpenCoversCommand, ElementName=PageRoot}" CommandParameter="{Binding}" Style="{StaticResource AdminGridActionButtonStyle}" />
                                                    <Button Content="&#xE74D;"
                                                            ToolTipService.ToolTip="{Binding Source={StaticResource Strings}, Path=DeleteButton}" Command="{Binding DataContext.DeleteCommand, ElementName=PageRoot}" CommandParameter="{Binding}" Style="{StaticResource AdminGridDestructiveActionButtonStyle}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </controls:DataGridTemplateColumn.CellTemplate>
                                    </controls:DataGridTemplateColumn>
                                </controls:DataGrid.Columns>
                            </controls:DataGrid>
                            <Grid Grid.Row="3" Margin="16,0,16,16" ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Previous" Command="{Binding PreviousPageCommand}" IsEnabled="{Binding CanGoPrevious}" />
                                <Button Grid.Column="1" Content="Next" Command="{Binding NextPageCommand}" IsEnabled="{Binding CanGoNext}" />
                                <TextBlock Grid.Column="2" Text="{Binding PageSummary}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding Source={StaticResource Strings}, Path=SoftwareAttributesPageSizeLabel}" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="4" Width="96" ItemsSource="{Binding PageSizeOptions}" SelectedItem="{Binding PageSize, Mode=TwoWay}" SelectionChanged="PageSizeCombo_SelectionChanged" />
                            </Grid>
                        </Grid>
                        <Border Grid.Column="1" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}"
                                Width="450" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
                            <Grid RowSpacing="0">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid Grid.Row="0" Padding="16,12" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                    <TextBlock Text="{Binding EditPanelTitle}" FontSize="18" FontWeight="SemiBold" />
                                </Grid>
                                <ScrollViewer Grid.Row="1" Padding="16" VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="12">
                                        <TextBox Header="Title"
                                                 Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="Optional. Used for compilation releases." />
                                        <AutoSuggestBox Header="{Binding Source={StaticResource Strings}, Path=SoftwareVersionLabel}"
                                                        PlaceholderText="{Binding Source={StaticResource Strings}, Path=SearchPlaceholder}"
                                                        Text="{Binding VersionSearchText, Mode=TwoWay}" QueryIcon="Find"
                                                        x:Name="VersionFilterBox" TextChanged="VersionFilterBox_TextChanged" />
                                        <ComboBox ItemsSource="{Binding VersionSuggestions}" SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch" PlaceholderText="{Binding Source={StaticResource Strings}, Path=SoftwareVersionLabel}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock>
                                                        <Run Text="{Binding Software}" /><Run Text=" - " /><Run Text="{Binding VersionString}" />
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <ComboBox Header="{Binding Source={StaticResource Strings}, Path=PlatformLabel}"
                                                  ItemsSource="{Binding Platforms}" SelectedItem="{Binding SelectedPlatform, Mode=TwoWay}"
                                                  DisplayMemberPath="Name" HorizontalAlignment="Stretch" PlaceholderText="{Binding Source={StaticResource Strings}, Path=PlatformLabel}" />
                                        <!-- Regions (multi-entry) -->
                                        <TextBlock Text="{Binding Source={StaticResource Strings}, Path=RegionsLabel}"
                                                   FontSize="14" FontWeight="SemiBold" Margin="0,8,0,4" />
                                        <ItemsRepeater ItemsSource="{Binding ReleaseRegionDisplays}">
                                            <ItemsRepeater.Layout>
                                                <StackLayout Orientation="Vertical" Spacing="4" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <Grid ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center" />
                                                        <Button Grid.Column="1" Content="✕" Padding="4,2"
                                                                Command="{Binding DataContext.RemoveRegionCommand, ElementName=PageRoot}"
                                                                CommandParameter="{Binding}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                        <AutoSuggestBox Header="{Binding Source={StaticResource Strings}, Path=AddRegionLabel}"
                                                        PlaceholderText="{Binding Source={StaticResource Strings}, Path=SearchPlaceholder}"
                                                        Text="{Binding RegionSearchText, Mode=TwoWay}" QueryIcon="Find"
                                                        x:Name="RegionFilterBox" TextChanged="RegionFilterBox_TextChanged" />
                                        <ComboBox ItemsSource="{Binding RegionSuggestions}" SelectedItem="{Binding SelectedRegionToAdd, Mode=TwoWay}"
                                                  DisplayMemberPath="Name" HorizontalAlignment="Stretch"
                                                  PlaceholderText="{Binding Source={StaticResource Strings}, Path=RegionLabel}" />
                                        <Button Content="{Binding Source={StaticResource Strings}, Path=AddButton}"
                                                Command="{Binding AddRegionCommand}" HorizontalAlignment="Stretch"
                                                Margin="0,4,0,0" />
                                        <!-- Languages (multi-entry) -->
                                        <TextBlock Text="{Binding Source={StaticResource Strings}, Path=LanguagesLabel}"
                                                   FontSize="14" FontWeight="SemiBold" Margin="0,8,0,4" />
                                        <ItemsRepeater ItemsSource="{Binding ReleaseLanguageDisplays}">
                                            <ItemsRepeater.Layout>
                                                <StackLayout Orientation="Vertical" Spacing="4" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <Grid ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center" />
                                                        <Button Grid.Column="1" Content="✕" Padding="4,2"
                                                                Command="{Binding DataContext.RemoveLanguageCommand, ElementName=PageRoot}"
                                                                CommandParameter="{Binding}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                        <AutoSuggestBox Header="{Binding Source={StaticResource Strings}, Path=AddLanguageLabel}"
                                                        PlaceholderText="{Binding Source={StaticResource Strings}, Path=SearchPlaceholder}"
                                                        Text="{Binding LanguageSearchText, Mode=TwoWay}" QueryIcon="Find"
                                                        x:Name="LanguageFilterBox" TextChanged="LanguageFilterBox_TextChanged" />
                                        <ComboBox ItemsSource="{Binding LanguageSuggestions}" SelectedItem="{Binding SelectedLanguageToAdd, Mode=TwoWay}"
                                                  DisplayMemberPath="ReferenceName" HorizontalAlignment="Stretch"
                                                  PlaceholderText="{Binding Source={StaticResource Strings}, Path=LanguageLabel}" />
                                        <Button Content="{Binding Source={StaticResource Strings}, Path=AddButton}"
                                                Command="{Binding AddLanguageCommand}" HorizontalAlignment="Stretch"
                                                Margin="0,4,0,0" />
                                        <AutoSuggestBox Header="{Binding Source={StaticResource Strings}, Path=PublisherLabel}"
                                                        PlaceholderText="{Binding Source={StaticResource Strings}, Path=SearchPlaceholder}"
                                                        Text="{Binding PublisherSearchText, Mode=TwoWay}" QueryIcon="Find"
                                                        x:Name="PublisherFilterBox" TextChanged="PublisherFilterBox_TextChanged" />
                                        <ComboBox ItemsSource="{Binding PublisherSuggestions}" SelectedItem="{Binding SelectedPublisher, Mode=TwoWay}"
                                                  DisplayMemberPath="Name" HorizontalAlignment="Stretch" PlaceholderText="{Binding Source={StaticResource Strings}, Path=PublisherLabel}" />
                                        <DatePicker Header="{Binding Source={StaticResource Strings}, Path=ReleaseDateLabel}"
                                                    SelectedDate="{Binding ReleaseDate, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                                        <ComboBox Header="{Binding Source={StaticResource Strings}, Path=DatePrecisionLabel}"
                                                  SelectedIndex="{Binding ReleaseDatePrecision, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="{Binding Source={StaticResource Strings}, Path=DatePrecisionFull}" />
                                            <ComboBoxItem Content="{Binding Source={StaticResource Strings}, Path=DatePrecisionMonthYear}" />
                                            <ComboBoxItem Content="{Binding Source={StaticResource Strings}, Path=DatePrecisionYearOnly}" />
                                        </ComboBox>

                                        <!-- Barcodes Section (edit only) -->
                                        <StackPanel Visibility="{Binding IsEditingExisting, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Spacing="8" Margin="0,16,0,0">
                                            <TextBlock Text="{Binding Source={StaticResource Strings}, Path=SoftwareBarcodesLabel}" FontSize="16" FontWeight="SemiBold" />
                                            <ItemsRepeater ItemsSource="{Binding BarcodeDisplays}">
                                                <ItemsRepeater.Layout><StackLayout Spacing="4" /></ItemsRepeater.Layout>
                                                <ItemsRepeater.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid ColumnSpacing="4">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                            <Button Grid.Column="1" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                                                    Command="{Binding DataContext.RemoveBarcodeCommand, ElementName=PageRoot}"
                                                                    CommandParameter="{Binding}" Padding="4,2" Style="{ThemeResource TextBlockButtonStyle}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsRepeater.ItemTemplate>
                                            </ItemsRepeater>
                                            <TextBox Header="{Binding Source={StaticResource Strings}, Path=BarcodeCodeLabel}"
                                                     Text="{Binding NewBarcodeCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <ComboBox Header="{Binding Source={StaticResource Strings}, Path=BarcodeTypeLabel}"
                                                      ItemsSource="{Binding BarcodeTypeItems}"
                                                      SelectedIndex="{Binding NewBarcodeType, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                                            <Button Content="+" Command="{Binding AddBarcodeCommand}" Style="{ThemeResource AccentButtonStyle}" Padding="8,4" />
                                        </StackPanel>

                                        <!-- Product Codes Section (edit only) -->
                                        <StackPanel Visibility="{Binding IsEditingExisting, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Spacing="8" Margin="0,16,0,0">
                                            <TextBlock Text="{Binding Source={StaticResource Strings}, Path=SoftwareProductCodesLabel}" FontSize="16" FontWeight="SemiBold" />
                                            <ItemsRepeater ItemsSource="{Binding ProductCodeDisplays}">
                                                <ItemsRepeater.Layout><StackLayout Spacing="4" /></ItemsRepeater.Layout>
                                                <ItemsRepeater.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid ColumnSpacing="4">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                            <Button Grid.Column="1" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                                                    Command="{Binding DataContext.RemoveProductCodeCommand, ElementName=PageRoot}"
                                                                    CommandParameter="{Binding}" Padding="4,2" Style="{ThemeResource TextBlockButtonStyle}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsRepeater.ItemTemplate>
                                            </ItemsRepeater>
                                            <TextBox Header="{Binding Source={StaticResource Strings}, Path=ProductCodeCodeLabel}"
                                                     Text="{Binding NewProductCodeCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <ComboBox Header="{Binding Source={StaticResource Strings}, Path=ProductCodeIssuerLabel}"
                                                      ItemsSource="{Binding ProductCodeIssuerItems}"
                                                      SelectedIndex="{Binding NewProductCodeIssuer, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                                            <Button Content="+" Command="{Binding AddProductCodeCommand}" Style="{ThemeResource AccentButtonStyle}" Padding="8,4" />
                                        </StackPanel>

                                        <!-- Minimum GPUs Section (edit only) -->
                                        <StackPanel Visibility="{Binding IsEditingExisting, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Spacing="8" Margin="0,16,0,0">
                                            <TextBlock Text="{Binding Source={StaticResource Strings}, Path=MinimumGpusLabel}" FontSize="16" FontWeight="SemiBold" />
                                            <ItemsRepeater ItemsSource="{Binding MinimumGpuDisplays}">
                                                <ItemsRepeater.Layout><StackLayout Spacing="4" /></ItemsRepeater.Layout>
                                                <ItemsRepeater.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid ColumnSpacing="4">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                            <Button Grid.Column="1" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                                                    Command="{Binding DataContext.RemoveMinimumGpuCommand, ElementName=PageRoot}"
                                                                    CommandParameter="{Binding}" Padding="4,2" Style="{ThemeResource TextBlockButtonStyle}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsRepeater.ItemTemplate>
                                            </ItemsRepeater>
                                            <AutoSuggestBox Header="{Binding Source={StaticResource Strings}, Path=GpuLabel}"
                                                            PlaceholderText="{Binding Source={StaticResource Strings}, Path=SearchPlaceholder}"
                                                            Text="{Binding MinimumGpuSearchText, Mode=TwoWay}" QueryIcon="Find"
                                                            x:Name="MinGpuSearchBox" TextChanged="MinGpuSearchBox_TextChanged" />
                                            <ComboBox ItemsSource="{Binding MinimumGpuSuggestions}" SelectedItem="{Binding SelectedMinimumGpu, Mode=TwoWay}"
                                                      DisplayMemberPath="Name" HorizontalAlignment="Stretch" PlaceholderText="{Binding Source={StaticResource Strings}, Path=GpuLabel}" />
                                            <Button Content="+" Command="{Binding AddMinimumGpuCommand}" Style="{ThemeResource AccentButtonStyle}" Padding="8,4" />
                                        </StackPanel>

                                        <!-- Recommended GPUs Section (edit only) -->
                                        <StackPanel Visibility="{Binding IsEditingExisting, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Spacing="8" Margin="0,16,0,0">
                                            <TextBlock Text="{Binding Source={StaticResource Strings}, Path=RecommendedGpusLabel}" FontSize="16" FontWeight="SemiBold" />
                                            <ItemsRepeater ItemsSource="{Binding RecommendedGpuDisplays}">
                                                <ItemsRepeater.Layout><StackLayout Spacing="4" /></ItemsRepeater.Layout>
                                                <ItemsRepeater.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid ColumnSpacing="4">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                            <Button Grid.Column="1" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                                                    Command="{Binding DataContext.RemoveRecommendedGpuCommand, ElementName=PageRoot}"
                                                                    CommandParameter="{Binding}" Padding="4,2" Style="{ThemeResource TextBlockButtonStyle}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsRepeater.ItemTemplate>
                                            </ItemsRepeater>
                                            <AutoSuggestBox Header="{Binding Source={StaticResource Strings}, Path=GpuLabel}"
                                                            PlaceholderText="{Binding Source={StaticResource Strings}, Path=SearchPlaceholder}"
                                                            Text="{Binding RecommendedGpuSearchText, Mode=TwoWay}" QueryIcon="Find"
                                                            x:Name="RecGpuSearchBox" TextChanged="RecGpuSearchBox_TextChanged" />
                                            <ComboBox ItemsSource="{Binding RecommendedGpuSuggestions}" SelectedItem="{Binding SelectedRecommendedGpu, Mode=TwoWay}"
                                                      DisplayMemberPath="Name" HorizontalAlignment="Stretch" PlaceholderText="{Binding Source={StaticResource Strings}, Path=GpuLabel}" />
                                            <Button Content="+" Command="{Binding AddRecommendedGpuCommand}" Style="{ThemeResource AccentButtonStyle}" Padding="8,4" />
                                        </StackPanel>

                                        <!-- Sound Synths Section (edit only) -->
                                        <StackPanel Visibility="{Binding IsEditingExisting, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Spacing="8" Margin="0,16,0,0">
                                            <TextBlock Text="{Binding Source={StaticResource Strings}, Path=SupportedSoundSynthsLabel}" FontSize="16" FontWeight="SemiBold" />
                                            <ItemsRepeater ItemsSource="{Binding SoundSynthDisplays}">
                                                <ItemsRepeater.Layout><StackLayout Spacing="4" /></ItemsRepeater.Layout>
                                                <ItemsRepeater.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid ColumnSpacing="4">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                            <Button Grid.Column="1" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                                                    Command="{Binding DataContext.RemoveSoundSynthCommand, ElementName=PageRoot}"
                                                                    CommandParameter="{Binding}" Padding="4,2" Style="{ThemeResource TextBlockButtonStyle}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsRepeater.ItemTemplate>
                                            </ItemsRepeater>
                                            <AutoSuggestBox Header="{Binding Source={StaticResource Strings}, Path=SoundSynthLabel}"
                                                            PlaceholderText="{Binding Source={StaticResource Strings}, Path=SearchPlaceholder}"
                                                            Text="{Binding SoundSynthSearchText, Mode=TwoWay}" QueryIcon="Find"
                                                            x:Name="SoundSynthSearchBox" TextChanged="SoundSynthSearchBox_TextChanged" />
                                            <ComboBox ItemsSource="{Binding SoundSynthSuggestions}" SelectedItem="{Binding SelectedSoundSynth, Mode=TwoWay}"
                                                      DisplayMemberPath="Name" HorizontalAlignment="Stretch" PlaceholderText="{Binding Source={StaticResource Strings}, Path=SoundSynthLabel}" />
                                            <Button Content="+" Command="{Binding AddSoundSynthCommand}" Style="{ThemeResource AccentButtonStyle}" Padding="8,4" />
                                        </StackPanel>

                                    </StackPanel>
                                </ScrollViewer>
                                <Grid Grid.Row="2" Padding="16,12" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="{Binding Source={StaticResource Strings}, Path=CancelButton}" Command="{Binding CancelEditCommand}" HorizontalAlignment="Stretch" />
                                    <Button Grid.Column="1" Content="{Binding Source={StaticResource Strings}, Path=SaveButton}" Command="{Binding SaveCommand}" HorizontalAlignment="Stretch" Style="{ThemeResource AccentButtonStyle}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
