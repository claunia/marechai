<?xml version="1.0"
      encoding="utf-8"?>

<Page x:Class="Marechai.App.Presentation.Views.Admin.AdminCompanyLogosPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Name="PageRoot"
      NavigationCacheMode="Required"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,0,0,1"
              Padding="16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Content="&#xE5C4;"
                    FontFamily="{StaticResource MaterialIconsFontFamily}"
                    Command="{Binding GoBackCommand}"
                    Style="{ThemeResource TextBlockButtonStyle}"
                    Padding="8,4"
                    VerticalAlignment="Center"
                    Margin="0,0,12,0" />
            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center">
                <TextBlock FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextControlForeground}">
                    <Run Text="{Binding Source={StaticResource Strings}, Path=CompanyLogosTitle}" />
                    <Run Text=" — " />
                    <Run Text="{Binding CompanyName}" />
                </TextBlock>
                <TextBlock Text="{Binding Source={StaticResource Strings}, Path=CompanyLogosSubtitle}"
                           FontSize="12"
                           Foreground="{ThemeResource SystemBaseMediumColor}"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="1">

            <!-- Access Denied -->
            <StackPanel Visibility="{Binding IsAdmin, Converter={StaticResource InvertBoolToVisibilityConverter}}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Padding="24"
                        Spacing="16"
                        MaxWidth="400">
                <InfoBar IsOpen="True"
                         Severity="Warning"
                         Title="{Binding Source={StaticResource Strings}, Path=CompanyLogosMgmtAccessDeniedTitle}"
                         Message="{Binding Source={StaticResource Strings}, Path=CompanyLogosMgmtAccessDeniedMessage}"
                         IsClosable="False" />
            </StackPanel>

            <!-- Content (admin only) -->
            <Grid Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}"
                  Canvas.ZIndex="0">

                <!-- Loading -->
                <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Padding="32"
                            Spacing="16">
                    <ProgressRing IsActive="True"
                                  IsIndeterminate="True"
                                  Height="64"
                                  Width="64"
                                  Foreground="{ThemeResource SystemAccentColor}" />
                    <TextBlock Text="{Binding Source={StaticResource Strings}, Path=LoadingText}"
                               FontSize="14"
                               TextAlignment="Center"
                               Foreground="{ThemeResource SystemBaseMediumColor}" />
                </StackPanel>

                <!-- Error -->
                <StackPanel Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Padding="24"
                            Spacing="16"
                            MaxWidth="400"
                            Canvas.ZIndex="100">
                    <InfoBar IsOpen="True"
                             Severity="Error"
                             Title="{Binding Source={StaticResource Strings}, Path=ErrorTitle}"
                             Message="{Binding ErrorMessage}"
                             IsClosable="False" />
                    <Button Content="{Binding Source={StaticResource Strings}, Path=RetryButton}"
                            Command="{Binding LoadLogosCommand}"
                            HorizontalAlignment="Center"
                            Style="{ThemeResource AccentButtonStyle}" />
                </StackPanel>

                <!-- Uploading overlay -->
                <StackPanel Visibility="{Binding IsUploading, Converter={StaticResource BoolToVisibilityConverter}}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Padding="32"
                            Spacing="16"
                            Canvas.ZIndex="200">
                    <ProgressRing IsActive="True"
                                  IsIndeterminate="True"
                                  Height="64"
                                  Width="64"
                                  Foreground="{ThemeResource SystemAccentColor}" />
                    <TextBlock Text="{Binding Source={StaticResource Strings}, Path=UploadingLogoText}"
                               FontSize="14"
                               TextAlignment="Center"
                               Foreground="{ThemeResource SystemBaseMediumColor}" />
                </StackPanel>

                <!-- Logos grid + edit panel -->
                <Grid Visibility="{Binding IsDataLoaded, Converter={StaticResource BoolToVisibilityConverter}}"
                      Canvas.ZIndex="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Logos list -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Command Bar -->
                            <CommandBar Grid.Row="0"
                                        DefaultLabelPosition="Right">
                                <AppBarButton Icon="Upload"
                                              Label="{Binding Source={StaticResource Strings}, Path=UploadLogoButton}"
                                              Command="{Binding UploadLogoCommand}" />
                                <AppBarButton Icon="Refresh"
                                              Label="{Binding Source={StaticResource Strings}, Path=RefreshLogosButton}"
                                              Command="{Binding LoadLogosCommand}" />
                            </CommandBar>

                            <!-- Logo Items -->
                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          Padding="16">
                                <ItemsRepeater ItemsSource="{Binding Logos}">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout MinItemWidth="220"
                                                           MinItemHeight="280"
                                                           MinColumnSpacing="16"
                                                           MinRowSpacing="16"
                                                           ItemsStretch="Fill" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="12">
                                                <Grid RowSpacing="8">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <!-- Logo image -->
                                                    <Image Grid.Row="0"
                                                           Source="{Binding LogoSource}"
                                                           Stretch="Uniform"
                                                           MaxHeight="180"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />

                                                    <!-- Year label -->
                                                    <TextBlock Grid.Row="1"
                                                               Text="{Binding Year}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" />

                                                    <!-- Action buttons -->
                                                    <StackPanel Grid.Row="2"
                                                                Orientation="Horizontal"
                                                                HorizontalAlignment="Center"
                                                                Spacing="8">
                                                        <Button Content="{Binding Source={StaticResource Strings}, Path=ChangeYearButton}"
                                                                Command="{Binding DataContext.OpenEditYearCommand, ElementName=PageRoot}"
                                                                CommandParameter="{Binding}"
                                                                Style="{ThemeResource TextBlockButtonStyle}"
                                                                Padding="8,4" />
                                                        <Button Content="{Binding Source={StaticResource Strings}, Path=DeleteLogoButton}"
                                                                Command="{Binding DataContext.DeleteLogoCommand, ElementName=PageRoot}"
                                                                CommandParameter="{Binding}"
                                                                Foreground="{ThemeResource SystemErrorTextColor}"
                                                                Style="{ThemeResource TextBlockButtonStyle}"
                                                                Padding="8,4" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </ScrollViewer>
                        </Grid>

                        <!-- Year Edit Panel -->
                        <Border Grid.Column="1"
                                Visibility="{Binding IsEditingYear, Converter={StaticResource BoolToVisibilityConverter}}"
                                Width="320"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="1,0,0,0">
                            <Grid RowSpacing="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Header -->
                                <Grid Grid.Row="0"
                                      Padding="16,12"
                                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                      BorderThickness="0,0,0,1">
                                    <TextBlock Text="{Binding Source={StaticResource Strings}, Path=ChangeYearDialogTitle}"
                                               FontSize="18"
                                               FontWeight="SemiBold" />
                                </Grid>

                                <!-- Form -->
                                <StackPanel Grid.Row="1"
                                            Padding="16"
                                            Spacing="12">
                                    <NumberBox Header="{Binding Source={StaticResource Strings}, Path=YearLabel}"
                                              Value="{Binding EditingYear, Mode=TwoWay}"
                                              Minimum="1000"
                                              Maximum="3000"
                                              SpinButtonPlacementMode="Inline"
                                              IsEnabled="{Binding YearIsUnknown, Converter={StaticResource InvertBoolConverter}}" />
                                    <CheckBox Content="{Binding Source={StaticResource Strings}, Path=YearUnknownLabel}"
                                              IsChecked="{Binding YearIsUnknown, Mode=TwoWay}" />
                                </StackPanel>

                                <!-- Footer (Save / Cancel) -->
                                <Grid Grid.Row="2"
                                      Padding="16,12"
                                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                      BorderThickness="0,1,0,0"
                                      ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Content="{Binding Source={StaticResource Strings}, Path=CancelButton}"
                                            Command="{Binding CancelEditYearCommand}"
                                            HorizontalAlignment="Stretch" />
                                    <Button Grid.Column="1"
                                            Content="{Binding Source={StaticResource Strings}, Path=SaveButton}"
                                            Command="{Binding SaveYearCommand}"
                                            HorizontalAlignment="Stretch"
                                            Style="{ThemeResource AccentButtonStyle}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
