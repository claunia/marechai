<?xml version="1.0"
      encoding="utf-8"?>

<Page x:Class="Marechai.App.Presentation.Views.Admin.AdminMagazinesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
      x:Name="PageRoot"
      NavigationCacheMode="Required"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,0,0,1"
              Padding="16,12">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Source={StaticResource Strings}, Path=MagazineManagementTitle}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextControlForeground}" />
                <TextBlock Text="{Binding Source={StaticResource Strings}, Path=MagazineManagementSubtitle}"
                           FontSize="12"
                           Foreground="{ThemeResource SystemBaseMediumColor}"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="1">

            <!-- Access Denied -->
            <StackPanel Visibility="{Binding IsAdmin, Converter={StaticResource InvertBoolToVisibilityConverter}}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Padding="24"
                        Spacing="16"
                        MaxWidth="400">
                <InfoBar IsOpen="True"
                         Severity="Warning"
                         Title="{Binding Source={StaticResource Strings}, Path=MagazineMgmtAccessDeniedTitle}"
                         Message="{Binding Source={StaticResource Strings}, Path=MagazineMgmtAccessDeniedMessage}"
                         IsClosable="False" />
            </StackPanel>

            <!-- Content (admin only) -->
            <Grid Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}"
                  Canvas.ZIndex="0">

                <!-- Loading -->
                <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Padding="32"
                            Spacing="16">
                    <ProgressRing IsActive="True"
                                  IsIndeterminate="True"
                                  Height="64"
                                  Width="64"
                                  Foreground="{ThemeResource SystemAccentColor}" />
                    <TextBlock Text="{Binding Source={StaticResource Strings}, Path=LoadingText}"
                               FontSize="14"
                               TextAlignment="Center"
                               Foreground="{ThemeResource SystemBaseMediumColor}" />
                </StackPanel>

                <!-- Error -->
                <StackPanel Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Padding="24"
                            Spacing="16"
                            MaxWidth="400"
                            Canvas.ZIndex="100">
                    <InfoBar IsOpen="True"
                             Severity="Error"
                             Title="{Binding Source={StaticResource Strings}, Path=ErrorTitle}"
                             Message="{Binding ErrorMessage}"
                             IsClosable="False" />
                    <Button Content="{Binding Source={StaticResource Strings}, Path=RetryButton}"
                            Command="{Binding LoadMagazinesCommand}"
                            HorizontalAlignment="Center"
                            Style="{ThemeResource AccentButtonStyle}" />
                </StackPanel>

                <!-- List View -->
                <Grid Visibility="{Binding IsDataLoaded, Converter={StaticResource BoolToVisibilityConverter}}"
                      Canvas.ZIndex="1">

                    <!-- Two-column layout: list + edit panel -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Magazines list -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Command Bar -->
                            <CommandBar Grid.Row="0"
                                        DefaultLabelPosition="Right">
                                <AppBarButton Icon="Add"
                                              Label="{Binding Source={StaticResource Strings}, Path=AddMagazineButton}"
                                              Command="{Binding OpenAddMagazineCommand}" />
                                <AppBarButton Icon="Refresh"
                                              Label="{Binding Source={StaticResource Strings}, Path=RefreshMagazinesButton}"
                                              Command="{Binding LoadMagazinesCommand}" />
                            </CommandBar>

                            <!-- Filter -->
                            <AutoSuggestBox Grid.Row="1"
                                            Margin="16,8,16,0"
                                            PlaceholderText="{Binding Source={StaticResource Strings}, Path=MagazinesSearchPlaceholder}"
                                            QueryIcon="Find"
                                            Text="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            x:Name="FilterBox"
                                            TextChanged="FilterBox_TextChanged" />

                            <!-- DataGrid -->
                            <controls:DataGrid Grid.Row="2"
                                               Margin="16"
                                               ItemsSource="{Binding FilteredMagazines}"
                                               SelectedItem="{Binding SelectedMagazine, Mode=TwoWay}"
                                               AutoGenerateColumns="False"
                                               GridLinesVisibility="None"
                                               HeadersVisibility="Column"
                                               AlternatingRowBackground="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                               CanUserReorderColumns="True"
                                               CanUserResizeColumns="True"
                                               CanUserSortColumns="True"
                                               IsReadOnly="True"
                                               SelectionMode="Single"
                                               HorizontalScrollBarVisibility="Auto"
                                               VerticalScrollBarVisibility="Auto">
                                <controls:DataGrid.Columns>
                                    <controls:DataGridTextColumn
                                        Header="{Binding Source={StaticResource Strings}, Path=MagazineTitleColumn}"
                                        Binding="{Binding Title}"
                                        Width="2*" />
                                    <controls:DataGridTextColumn
                                        Header="{Binding Source={StaticResource Strings}, Path=MagazineNativeTitleColumn}"
                                        Binding="{Binding NativeTitle}"
                                        Width="*" />
                                    <controls:DataGridTextColumn
                                        Header="{Binding Source={StaticResource Strings}, Path=MagazineSortTitleColumn}"
                                        Binding="{Binding SortTitle}"
                                        Width="*" />
                                    <controls:DataGridTextColumn
                                        Header="{Binding Source={StaticResource Strings}, Path=MagazineIssnColumn}"
                                        Binding="{Binding Issn}"
                                        Width="Auto" />
                                    <controls:DataGridTextColumn
                                        Header="{Binding Source={StaticResource Strings}, Path=MagazineCountryColumn}"
                                        Binding="{Binding Country}"
                                        Width="*" />
                                    <controls:DataGridTemplateColumn
                                        Header="{Binding Source={StaticResource Strings}, Path=ActionsColumn}"
                                        Width="Auto">
                                        <controls:DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal"
                                                            Spacing="4">
                                                    <Button Content="&#xE3C9;"
                                                            ToolTipService.ToolTip="{Binding Source={StaticResource Strings}, Path=EditMagazineButton}"
                                                            Command="{Binding DataContext.OpenEditMagazineCommand, ElementName=PageRoot}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource AdminGridActionButtonStyle}" />
                                                    <Button ToolTipService.ToolTip="{Binding Source={StaticResource Strings}, Path=IssuesButton}"
                                                            Command="{Binding DataContext.OpenIssuesCommand, ElementName=PageRoot}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource AdminGridActionButtonStyle}">
                                                        <FontIcon Glyph="&#xE02F;" FontFamily="{StaticResource MaterialIconsFontFamily}" />
                                                    </Button>
                                                    <Button ToolTipService.ToolTip="{Binding Source={StaticResource Strings}, Path=SynopsisButton}"
                                                            Command="{Binding DataContext.OpenSynopsisCommand, ElementName=PageRoot}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource AdminGridActionButtonStyle}">
                                                        <FontIcon Glyph="&#xE873;" FontFamily="{StaticResource MaterialIconsFontFamily}" />
                                                    </Button>
                                                    <Button Content="&#xE872;"
                                                            ToolTipService.ToolTip="{Binding Source={StaticResource Strings}, Path=DeleteMagazineButton}"
                                                            Command="{Binding DataContext.DeleteMagazineCommand, ElementName=PageRoot}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource AdminGridDestructiveActionButtonStyle}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </controls:DataGridTemplateColumn.CellTemplate>
                                    </controls:DataGridTemplateColumn>
                                </controls:DataGrid.Columns>
                            </controls:DataGrid>

                            <Grid Grid.Row="3"
                                  Margin="16,0,16,16"
                                  ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Content="Previous"
                                        Command="{Binding PreviousPageCommand}"
                                        IsEnabled="{Binding CanGoPrevious}" />
                                <Button Grid.Column="1"
                                        Content="Next"
                                        Command="{Binding NextPageCommand}"
                                        IsEnabled="{Binding CanGoNext}" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding PageSummary}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="3"
                                           Text="{Binding Source={StaticResource Strings}, Path=SoftwareAttributesPageSizeLabel}"
                                           VerticalAlignment="Center" />
                                <ComboBox Grid.Column="4"
                                          Width="96"
                                          ItemsSource="{Binding PageSizeOptions}"
                                          SelectedItem="{Binding PageSize, Mode=TwoWay}"
                                          SelectionChanged="PageSizeCombo_SelectionChanged" />
                            </Grid>
                        </Grid>

                        <!-- Edit Panel -->
                        <Border Grid.Column="1"
                                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}"
                                Width="500"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="1,0,0,0">
                            <Grid RowSpacing="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Edit header -->
                                <Grid Grid.Row="0"
                                      Padding="16,12"
                                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                      BorderThickness="0,0,0,1">
                                    <TextBlock Text="{Binding EditPanelTitle}"
                                               FontSize="18"
                                               FontWeight="SemiBold" />
                                </Grid>

                                <!-- Edit form (scrollable) -->
                                <ScrollViewer Grid.Row="1"
                                              Padding="16"
                                              VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="12">

                                        <!-- Title -->
                                        <TextBox Header="{Binding Source={StaticResource Strings}, Path=MagazineTitleLabel}"
                                                 Text="{Binding MagazineTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="{Binding Source={StaticResource Strings}, Path=MagazineTitleLabel}" />

                                        <!-- Native Title -->
                                        <TextBox Header="{Binding Source={StaticResource Strings}, Path=MagazineNativeTitleLabel}"
                                                 Text="{Binding NativeTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <!-- Sort Title -->
                                        <TextBox Header="{Binding Source={StaticResource Strings}, Path=MagazineSortTitleLabel}"
                                                 Text="{Binding SortTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <!-- ISSN -->
                                        <TextBox Header="{Binding Source={StaticResource Strings}, Path=MagazineIssnLabel}"
                                                 Text="{Binding Issn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 MaxLength="8" />

                                        <!-- Published -->
                                        <CalendarDatePicker Header="{Binding Source={StaticResource Strings}, Path=MagazinePublishedLabel}"
                                                            Date="{Binding Published, Mode=TwoWay}"
                                                            HorizontalAlignment="Stretch" />
                                        <ComboBox Header="{Binding Source={StaticResource Strings}, Path=DatePrecisionLabel}"
                                                  SelectedIndex="{Binding PublishedPrecision, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="{Binding Source={StaticResource Strings}, Path=DatePrecisionFull}" />
                                            <ComboBoxItem Content="{Binding Source={StaticResource Strings}, Path=DatePrecisionMonthYear}" />
                                            <ComboBoxItem Content="{Binding Source={StaticResource Strings}, Path=DatePrecisionYearOnly}" />
                                        </ComboBox>

                                        <!-- First Publication -->
                                        <CalendarDatePicker Header="{Binding Source={StaticResource Strings}, Path=MagazineFirstPublicationLabel}"
                                                            Date="{Binding FirstPublication, Mode=TwoWay}"
                                                            HorizontalAlignment="Stretch" />
                                        <ComboBox Header="{Binding Source={StaticResource Strings}, Path=DatePrecisionLabel}"
                                                  SelectedIndex="{Binding FirstPublicationPrecision, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="{Binding Source={StaticResource Strings}, Path=DatePrecisionFull}" />
                                            <ComboBoxItem Content="{Binding Source={StaticResource Strings}, Path=DatePrecisionMonthYear}" />
                                            <ComboBoxItem Content="{Binding Source={StaticResource Strings}, Path=DatePrecisionYearOnly}" />
                                        </ComboBox>

                                        <!-- Country -->
                                        <ComboBox Header="{Binding Source={StaticResource Strings}, Path=MagazineCountryLabel}"
                                                  ItemsSource="{Binding Countries}"
                                                  SelectedItem="{Binding SelectedCountry, Mode=TwoWay}"
                                                  DisplayMemberPath="Name"
                                                  HorizontalAlignment="Stretch" />

                                        <!-- ======== Junction sections (only when editing existing) ======== -->
                                        <StackPanel Visibility="{Binding IsEditingExisting, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Spacing="12">

                                            <!-- === People === -->
                                            <TextBlock Text="{Binding Source={StaticResource Strings}, Path=MagazinePeopleSectionHeader}"
                                                       FontWeight="SemiBold"
                                                       FontSize="14"
                                                       Margin="0,8,0,0" />
                                            <Grid ColumnSpacing="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <AutoSuggestBox Grid.Column="0"
                                                                PlaceholderText="{Binding Source={StaticResource Strings}, Path=PeopleSearchPlaceholder}"
                                                                QueryIcon="Find"
                                                                x:Name="PersonSearchBox"
                                                                TextChanged="PersonSearchBox_TextChanged" />
                                                <ComboBox Grid.Column="1"
                                                          ItemsSource="{Binding AvailableRoles}"
                                                          SelectedItem="{Binding SelectedPersonRole, Mode=TwoWay}"
                                                          DisplayMemberPath="Name"
                                                          HorizontalAlignment="Stretch" />
                                                <Button Grid.Column="2"
                                                        Content="+"
                                                        Command="{Binding AddPersonCommand}" />
                                            </Grid>
                                            <ComboBox ItemsSource="{Binding AvailablePeople}"
                                                      SelectedItem="{Binding SelectedAvailablePerson, Mode=TwoWay}"
                                                      HorizontalAlignment="Stretch"
                                                      PlaceholderText="{Binding Source={StaticResource Strings}, Path=PeopleSearchPlaceholder}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock>
                                                            <Run Text="{Binding Name}" />
                                                            <Run Text=" " />
                                                            <Run Text="{Binding Surname}" />
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <ItemsRepeater ItemsSource="{Binding MagazinePeopleDisplays}">
                                                <ItemsRepeater.Layout>
                                                    <StackLayout Spacing="4" />
                                                </ItemsRepeater.Layout>
                                                <ItemsRepeater.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding}"
                                                                       VerticalAlignment="Center" />
                                                            <Button Grid.Column="1"
                                                                    Content="X"
                                                                    Command="{Binding DataContext.RemovePersonCommand, ElementName=PageRoot}"
                                                                    CommandParameter="{Binding}"
                                                                    Padding="4,2"
                                                                    Style="{ThemeResource TextBlockButtonStyle}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsRepeater.ItemTemplate>
                                            </ItemsRepeater>

                                            <!-- === Companies === -->
                                            <TextBlock Text="{Binding Source={StaticResource Strings}, Path=MagazineCompaniesSectionHeader}"
                                                       FontWeight="SemiBold"
                                                       FontSize="14"
                                                       Margin="0,8,0,0" />
                                            <Grid ColumnSpacing="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <AutoSuggestBox Grid.Column="0"
                                                                PlaceholderText="{Binding Source={StaticResource Strings}, Path=CompaniesSearchBox_Placeholder}"
                                                                QueryIcon="Find"
                                                                x:Name="CompanySearchBox"
                                                                TextChanged="CompanySearchBox_TextChanged" />
                                                <ComboBox Grid.Column="1"
                                                          ItemsSource="{Binding AvailableRoles}"
                                                          SelectedItem="{Binding SelectedCompanyRole, Mode=TwoWay}"
                                                          DisplayMemberPath="Name"
                                                          HorizontalAlignment="Stretch" />
                                                <Button Grid.Column="2"
                                                        Content="+"
                                                        Command="{Binding AddCompanyCommand}" />
                                            </Grid>
                                            <ComboBox ItemsSource="{Binding AvailableCompanies}"
                                                      SelectedItem="{Binding SelectedAvailableCompany, Mode=TwoWay}"
                                                      DisplayMemberPath="Name"
                                                      HorizontalAlignment="Stretch"
                                                      PlaceholderText="{Binding Source={StaticResource Strings}, Path=CompaniesSearchBox_Placeholder}" />
                                            <ItemsRepeater ItemsSource="{Binding MagazineCompanyDisplays}">
                                                <ItemsRepeater.Layout>
                                                    <StackLayout Spacing="4" />
                                                </ItemsRepeater.Layout>
                                                <ItemsRepeater.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding}"
                                                                       VerticalAlignment="Center" />
                                                            <Button Grid.Column="1"
                                                                    Content="X"
                                                                    Command="{Binding DataContext.RemoveCompanyCommand, ElementName=PageRoot}"
                                                                    CommandParameter="{Binding}"
                                                                    Padding="4,2"
                                                                    Style="{ThemeResource TextBlockButtonStyle}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsRepeater.ItemTemplate>
                                            </ItemsRepeater>

                                            <!-- === Machines === -->
                                            <TextBlock Text="{Binding Source={StaticResource Strings}, Path=MagazineMachinesSectionHeader}"
                                                       FontWeight="SemiBold"
                                                       FontSize="14"
                                                       Margin="0,8,0,0" />
                                            <Grid ColumnSpacing="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ComboBox Grid.Column="0"
                                                          ItemsSource="{Binding AvailableMachines}"
                                                          SelectedItem="{Binding SelectedAvailableMachine, Mode=TwoWay}"
                                                          DisplayMemberPath="Name"
                                                          HorizontalAlignment="Stretch" />
                                                <Button Grid.Column="1"
                                                        Content="+"
                                                        Command="{Binding AddMachineCommand}" />
                                            </Grid>
                                            <ItemsRepeater ItemsSource="{Binding MagazineMachineDisplays}">
                                                <ItemsRepeater.Layout>
                                                    <StackLayout Spacing="4" />
                                                </ItemsRepeater.Layout>
                                                <ItemsRepeater.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding}"
                                                                       VerticalAlignment="Center" />
                                                            <Button Grid.Column="1"
                                                                    Content="X"
                                                                    Command="{Binding DataContext.RemoveMachineCommand, ElementName=PageRoot}"
                                                                    CommandParameter="{Binding}"
                                                                    Padding="4,2"
                                                                    Style="{ThemeResource TextBlockButtonStyle}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsRepeater.ItemTemplate>
                                            </ItemsRepeater>

                                            <!-- === Machine Families === -->
                                            <TextBlock Text="{Binding Source={StaticResource Strings}, Path=MagazineMachineFamiliesSectionHeader}"
                                                       FontWeight="SemiBold"
                                                       FontSize="14"
                                                       Margin="0,8,0,0" />
                                            <Grid ColumnSpacing="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ComboBox Grid.Column="0"
                                                          ItemsSource="{Binding AvailableMachineFamilies}"
                                                          SelectedItem="{Binding SelectedAvailableMachineFamily, Mode=TwoWay}"
                                                          DisplayMemberPath="Name"
                                                          HorizontalAlignment="Stretch" />
                                                <Button Grid.Column="1"
                                                        Content="+"
                                                        Command="{Binding AddMachineFamilyCommand}" />
                                            </Grid>
                                            <ItemsRepeater ItemsSource="{Binding MagazineMachineFamilyDisplays}">
                                                <ItemsRepeater.Layout>
                                                    <StackLayout Spacing="4" />
                                                </ItemsRepeater.Layout>
                                                <ItemsRepeater.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding}"
                                                                       VerticalAlignment="Center" />
                                                            <Button Grid.Column="1"
                                                                    Content="X"
                                                                    Command="{Binding DataContext.RemoveMachineFamilyCommand, ElementName=PageRoot}"
                                                                    CommandParameter="{Binding}"
                                                                    Padding="4,2"
                                                                    Style="{ThemeResource TextBlockButtonStyle}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsRepeater.ItemTemplate>
                                            </ItemsRepeater>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- Edit footer (Save / Cancel) -->
                                <Grid Grid.Row="2"
                                      Padding="16,12"
                                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                      BorderThickness="0,1,0,0"
                                      ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Content="{Binding Source={StaticResource Strings}, Path=CancelButton}"
                                            Command="{Binding CancelEditCommand}"
                                            HorizontalAlignment="Stretch" />
                                    <Button Grid.Column="1"
                                            Content="{Binding Source={StaticResource Strings}, Path=SaveButton}"
                                            Command="{Binding SaveMagazineCommand}"
                                            HorizontalAlignment="Stretch"
                                            Style="{ThemeResource AccentButtonStyle}" />
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Synopsis Panel -->
                        <Border Grid.Column="1"
                                Visibility="{Binding IsEditingSynopsis, Converter={StaticResource BoolToVisibilityConverter}}"
                                Width="500"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="1,0,0,0">
                            <Grid RowSpacing="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Synopsis header -->
                                <Grid Grid.Row="0"
                                      Padding="16,12"
                                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                      BorderThickness="0,0,0,1">
                                    <TextBlock Text="{Binding Source={StaticResource Strings}, Path=SynopsisSectionHeader}"
                                               FontSize="18"
                                               FontWeight="SemiBold" />
                                </Grid>

                                <!-- Language selector -->
                                <StackPanel Grid.Row="1"
                                            Padding="16,8"
                                            Spacing="4"
                                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                            BorderThickness="0,0,0,1">
                                    <TextBlock Text="{Binding Source={StaticResource Strings}, Path=LanguageLabel}"
                                               FontWeight="SemiBold" />
                                    <ComboBox ItemsSource="{Binding AvailableLanguages}"
                                              SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch"
                                              DisplayMemberPath="DisplayName" />
                                </StackPanel>

                                <!-- Existing synopses list -->
                                <StackPanel Grid.Row="2"
                                            Padding="16,8"
                                            Spacing="4"
                                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                            BorderThickness="0,0,0,1">
                                    <TextBlock Text="{Binding Source={StaticResource Strings}, Path=ExistingTranslationsLabel}"
                                               FontWeight="SemiBold" />
                                    <ItemsRepeater ItemsSource="{Binding ExistingSynopses}">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Spacing="4" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Language}"
                                                               VerticalAlignment="Center" />
                                                    <Button Grid.Column="1"
                                                            Content="&#xE3C9;"
                                                            FontFamily="{StaticResource MaterialIconsFontFamily}"
                                                            Command="{Binding DataContext.EditSynopsisCommand, ElementName=PageRoot}"
                                                            CommandParameter="{Binding}"
                                                            Padding="4,2"
                                                            Style="{ThemeResource TextBlockButtonStyle}" />
                                                    <Button Grid.Column="2"
                                                            Content="&#xE872;"
                                                            FontFamily="{StaticResource MaterialIconsFontFamily}"
                                                            Command="{Binding DataContext.DeleteSynopsisCommand, ElementName=PageRoot}"
                                                            CommandParameter="{Binding}"
                                                            Padding="4,2"
                                                            Style="{ThemeResource TextBlockButtonStyle}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </StackPanel>

                                <!-- Synopsis editor -->
                                <TextBox Grid.Row="3"
                                         Margin="16"
                                         Text="{Binding SynopsisText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalAlignment="Stretch"
                                         HorizontalAlignment="Stretch"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto" />

                                <!-- Synopsis footer -->
                                <Grid Grid.Row="4"
                                      Padding="16,12"
                                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                      BorderThickness="0,1,0,0"
                                      ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Content="{Binding Source={StaticResource Strings}, Path=CancelButton}"
                                            Command="{Binding CancelSynopsisCommand}"
                                            HorizontalAlignment="Stretch" />
                                    <Button Grid.Column="1"
                                            Content="{Binding Source={StaticResource Strings}, Path=SaveButton}"
                                            Command="{Binding SaveSynopsisCommand}"
                                            HorizontalAlignment="Stretch"
                                            Style="{ThemeResource AccentButtonStyle}" />
                                </Grid>
