<?xml version="1.0"
      encoding="utf-8"?>

<Page x:Class="Marechai.App.Presentation.Views.Admin.AdminBooksPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
      x:Name="PageRoot"
      NavigationCacheMode="Required"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,0,0,1"
              Padding="16,12">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Source={StaticResource Strings}, Path=BookManagementTitle}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextControlForeground}" />
                <TextBlock Text="{Binding Source={StaticResource Strings}, Path=BookManagementSubtitle}"
                           FontSize="12"
                           Foreground="{ThemeResource SystemBaseMediumColor}"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="1">

            <!-- Access Denied -->
            <StackPanel Visibility="{Binding IsAdmin, Converter={StaticResource InvertBoolToVisibilityConverter}}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Padding="24"
                        Spacing="16"
                        MaxWidth="400">
                <InfoBar IsOpen="True"
                         Severity="Warning"
                         Title="{Binding Source={StaticResource Strings}, Path=BookMgmtAccessDeniedTitle}"
                         Message="{Binding Source={StaticResource Strings}, Path=BookMgmtAccessDeniedMessage}"
                         IsClosable="False" />
            </StackPanel>

            <!-- Content (admin only) -->
            <Grid Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}"
                  Canvas.ZIndex="0">

                <!-- Loading -->
                <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Padding="32"
                            Spacing="16">
                    <ProgressRing IsActive="True"
                                  IsIndeterminate="True"
                                  Height="64"
                                  Width="64"
                                  Foreground="{ThemeResource SystemAccentColor}" />
                    <TextBlock Text="{Binding Source={StaticResource Strings}, Path=LoadingText}"
                               FontSize="14"
                               TextAlignment="Center"
                               Foreground="{ThemeResource SystemBaseMediumColor}" />
                </StackPanel>

                <!-- Error -->
                <StackPanel Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Padding="24"
                            Spacing="16"
                            MaxWidth="400"
                            Canvas.ZIndex="100">
                    <InfoBar IsOpen="True"
                             Severity="Error"
                             Title="{Binding Source={StaticResource Strings}, Path=ErrorTitle}"
                             Message="{Binding ErrorMessage}"
                             IsClosable="False" />
                    <Button Content="{Binding Source={StaticResource Strings}, Path=RetryButton}"
                            Command="{Binding LoadBooksCommand}"
                            HorizontalAlignment="Center"
                            Style="{ThemeResource AccentButtonStyle}" />
                </StackPanel>

                <!-- List View -->
                <Grid Visibility="{Binding IsDataLoaded, Converter={StaticResource BoolToVisibilityConverter}}"
                      Canvas.ZIndex="1">

                    <!-- Two-column layout: list + edit panel -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Books list -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Command Bar -->
                            <CommandBar Grid.Row="0"
                                        DefaultLabelPosition="Right">
                                <AppBarButton Icon="Add"
                                              Label="{Binding Source={StaticResource Strings}, Path=AddBookButton}"
                                              Command="{Binding OpenAddBookCommand}" />
                                <AppBarButton Icon="Refresh"
                                              Label="{Binding Source={StaticResource Strings}, Path=RefreshBooksButton}"
                                              Command="{Binding LoadBooksCommand}" />
                            </CommandBar>

                            <!-- Filter -->
                            <AutoSuggestBox Grid.Row="1"
                                            Margin="16,8,16,0"
                                            PlaceholderText="{Binding Source={StaticResource Strings}, Path=BooksSearchPlaceholder}"
                                            QueryIcon="Find"
                                            Text="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            x:Name="FilterBox"
                                            TextChanged="FilterBox_TextChanged" />

                            <!-- DataGrid -->
                            <controls:DataGrid Grid.Row="2"
                                               Margin="16"
                                               ItemsSource="{Binding FilteredBooks}"
                                               SelectedItem="{Binding SelectedBook, Mode=TwoWay}"
                                               AutoGenerateColumns="False"
                                               GridLinesVisibility="None"
                                               HeadersVisibility="Column"
                                               AlternatingRowBackground="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                               CanUserReorderColumns="True"
                                               CanUserResizeColumns="True"
                                               CanUserSortColumns="True"
                                               IsReadOnly="True"
                                               SelectionMode="Single"
                                               HorizontalScrollBarVisibility="Auto"
                                               VerticalScrollBarVisibility="Auto">
                                <controls:DataGrid.Columns>
                                    <controls:DataGridTextColumn
                                        Header="{Binding Source={StaticResource Strings}, Path=BookTitleColumn}"
                                        Binding="{Binding Title}"
                                        Width="2*" />
                                    <controls:DataGridTextColumn
                                        Header="{Binding Source={StaticResource Strings}, Path=BookNativeTitleColumn}"
                                        Binding="{Binding NativeTitle}"
                                        Width="*" />
                                    <controls:DataGridTextColumn
                                        Header="{Binding Source={StaticResource Strings}, Path=BookSortTitleColumn}"
                                        Binding="{Binding SortTitle}"
                                        Width="*" />
                                    <controls:DataGridTextColumn
                                        Header="{Binding Source={StaticResource Strings}, Path=BookIsbnColumn}"
                                        Binding="{Binding Isbn}"
                                        Width="*" />
                                    <controls:DataGridTextColumn
                                        Header="{Binding Source={StaticResource Strings}, Path=BookPagesColumn}"
                                        Binding="{Binding Pages}"
                                        Width="80" />
                                    <controls:DataGridTextColumn
                                        Header="{Binding Source={StaticResource Strings}, Path=BookCountryColumn}"
                                        Binding="{Binding Country}"
                                        Width="*" />
                                    <controls:DataGridTemplateColumn
                                        Header="{Binding Source={StaticResource Strings}, Path=ActionsColumn}"
                                        Width="Auto">
                                        <controls:DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal"
                                                            Spacing="4">
                                                    <Button Content="&#xE70F;"
                                                            ToolTipService.ToolTip="{Binding Source={StaticResource Strings}, Path=EditBookButton}"
                                                            Command="{Binding DataContext.OpenEditBookCommand, ElementName=PageRoot}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource AdminGridActionButtonStyle}" />
                                                    <Button ToolTipService.ToolTip="{Binding Source={StaticResource Strings}, Path=SynopsisButton}"
                                                            Command="{Binding DataContext.OpenSynopsisCommand, ElementName=PageRoot}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource AdminGridActionButtonStyle}">
                                                        <SymbolIcon Symbol="Document" />
                                                    </Button>
                                                    <Button Content="&#xE74D;"
                                                            ToolTipService.ToolTip="{Binding Source={StaticResource Strings}, Path=DeleteBookButton}"
                                                            Command="{Binding DataContext.DeleteBookCommand, ElementName=PageRoot}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource AdminGridDestructiveActionButtonStyle}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </controls:DataGridTemplateColumn.CellTemplate>
                                    </controls:DataGridTemplateColumn>
                                </controls:DataGrid.Columns>
                            </controls:DataGrid>
                        </Grid>

                        <!-- Edit Panel -->
                        <Border Grid.Column="1"
                                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}"
                                Width="500"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="1,0,0,0">
                            <Grid RowSpacing="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Edit header -->
                                <Grid Grid.Row="0"
                                      Padding="16,12"
                                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                      BorderThickness="0,0,0,1">
                                    <TextBlock Text="{Binding EditPanelTitle}"
                                               FontSize="18"
                                               FontWeight="SemiBold" />
                                </Grid>

                                <!-- Edit form (scrollable) -->
                                <ScrollViewer Grid.Row="1"
                                              Padding="16"
                                              VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="12">

                                        <!-- Title -->
                                        <TextBox Header="{Binding Source={StaticResource Strings}, Path=BookTitleLabel}"
                                                 Text="{Binding BookTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="{Binding Source={StaticResource Strings}, Path=BookTitleLabel}" />

                                        <!-- Native Title -->
                                        <TextBox Header="{Binding Source={StaticResource Strings}, Path=BookNativeTitleLabel}"
                                                 Text="{Binding NativeTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <!-- Sort Title -->
                                        <TextBox Header="{Binding Source={StaticResource Strings}, Path=BookSortTitleLabel}"
                                                 Text="{Binding SortTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <!-- ISBN -->
                                        <TextBox Header="{Binding Source={StaticResource Strings}, Path=BookIsbnLabel}"
                                                 Text="{Binding Isbn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <!-- Pages -->
                                        <NumberBox Header="{Binding Source={StaticResource Strings}, Path=BookPagesLabel}"
                                                   Value="{Binding Pages, Mode=TwoWay}"
                                                   SpinButtonPlacementMode="Compact"
                                                   Minimum="0" />

                                        <!-- Edition -->
                                        <NumberBox Header="{Binding Source={StaticResource Strings}, Path=BookEditionLabel}"
                                                   Value="{Binding Edition, Mode=TwoWay}"
                                                   SpinButtonPlacementMode="Compact"
                                                   Minimum="1" />

                                        <!-- Published -->
                                        <CalendarDatePicker Header="{Binding Source={StaticResource Strings}, Path=BookPublishedLabel}"
                                                            Date="{Binding Published, Mode=TwoWay}"
                                                            HorizontalAlignment="Stretch" />
                                        <ComboBox Header="{Binding Source={StaticResource Strings}, Path=DatePrecisionLabel}"
                                                  SelectedIndex="{Binding PublishedPrecision, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="{Binding Source={StaticResource Strings}, Path=DatePrecisionFull}" />
                                            <ComboBoxItem Content="{Binding Source={StaticResource Strings}, Path=DatePrecisionMonthYear}" />
                                            <ComboBoxItem Content="{Binding Source={StaticResource Strings}, Path=DatePrecisionYearOnly}" />
                                        </ComboBox>

                                        <!-- Country -->
                                        <ComboBox Header="{Binding Source={StaticResource Strings}, Path=BookCountryLabel}"
                                                  ItemsSource="{Binding Countries}"
                                                  SelectedItem="{Binding SelectedCountry, Mode=TwoWay}"
                                                  DisplayMemberPath="Name"
                                                  HorizontalAlignment="Stretch" />

                                        <!-- Previous Book -->
                                        <AutoSuggestBox Header="{Binding Source={StaticResource Strings}, Path=BookPreviousLabel}"
                                                        PlaceholderText="{Binding Source={StaticResource Strings}, Path=BooksSearchPlaceholder}"
                                                        Text="{Binding PreviousBookSearchText, Mode=TwoWay}"
                                                        QueryIcon="Find"
                                                        x:Name="PreviousBookFilterBox"
                                                        TextChanged="PreviousBookFilterBox_TextChanged" />
                                        <ComboBox ItemsSource="{Binding PreviousBookSuggestions}"
                                                  SelectedItem="{Binding SelectedPreviousBook, Mode=TwoWay}"
                                                  DisplayMemberPath="Title"
                                                  HorizontalAlignment="Stretch"
                                                  PlaceholderText="{Binding Source={StaticResource Strings}, Path=BookPreviousLabel}" />

                                        <!-- Source Book -->
                                        <AutoSuggestBox Header="{Binding Source={StaticResource Strings}, Path=BookSourceLabel}"
                                                        PlaceholderText="{Binding Source={StaticResource Strings}, Path=BooksSearchPlaceholder}"
                                                        Text="{Binding SourceBookSearchText, Mode=TwoWay}"
                                                        QueryIcon="Find"
                                                        x:Name="SourceBookFilterBox"
                                                        TextChanged="SourceBookFilterBox_TextChanged" />
                                        <ComboBox ItemsSource="{Binding SourceBookSuggestions}"
                                                  SelectedItem="{Binding SelectedSourceBook, Mode=TwoWay}"
                                                  DisplayMemberPath="Title"
                                                  HorizontalAlignment="Stretch"
                                                  PlaceholderText="{Binding Source={StaticResource Strings}, Path=BookSourceLabel}" />

                                        <!-- ======== Junction sections (only when editing existing) ======== -->
                                        <StackPanel Visibility="{Binding IsEditingExisting, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Spacing="12">

                                            <!-- === Cover === -->
                                            <TextBlock Text="{Binding Source={StaticResource Strings}, Path=BookCoverSectionHeader}"
                                                       FontWeight="SemiBold"
                                                       FontSize="14"
                                                       Margin="0,8,0,0" />

                                            <!-- Uploading indicator -->
                                            <StackPanel Visibility="{Binding IsUploadingCover, Converter={StaticResource BoolToVisibilityConverter}}"
                                                        Orientation="Horizontal"
                                                        Spacing="8"
                                                        HorizontalAlignment="Center">
                                                <ProgressRing IsActive="True"
                                                              IsIndeterminate="True"
                                                              Height="24"
                                                              Width="24" />
                                                <TextBlock Text="{Binding Source={StaticResource Strings}, Path=UploadingCoverLabel}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>

                                            <!-- Cover thumbnail -->
                                            <Image Source="{Binding CoverThumbnailSource}"
                                                   Visibility="{Binding HasCover, Converter={StaticResource BoolToVisibilityConverter}}"
                                                   MaxHeight="200"
                                                   MaxWidth="200"
                                                   HorizontalAlignment="Left"
                                                   Stretch="Uniform" />

                                            <!-- No cover label -->
                                            <TextBlock Text="{Binding Source={StaticResource Strings}, Path=NoCoverLabel}"
                                                       Visibility="{Binding HasCover, Converter={StaticResource InvertBoolToVisibilityConverter}}"
                                                       Foreground="{ThemeResource SystemBaseMediumColor}"
                                                       FontStyle="Italic" />

                                            <!-- Cover action buttons -->
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="8">
                                                <Button Content="{Binding Source={StaticResource Strings}, Path=UploadCoverButton}"
                                                        Command="{Binding UploadCoverCommand}"
                                                        Style="{ThemeResource AccentButtonStyle}" />
                                                <Button Content="{Binding Source={StaticResource Strings}, Path=DeleteCoverButton}"
                                                        Command="{Binding DeleteCoverCommand}"
                                                        Visibility="{Binding HasCover, Converter={StaticResource BoolToVisibilityConverter}}"
                                                        Foreground="{ThemeResource SystemErrorTextColor}" />
                                            </StackPanel>

                                            <!-- === People === -->
                                            <TextBlock Text="{Binding Source={StaticResource Strings}, Path=BookPeopleSectionHeader}"
                                                       FontWeight="SemiBold"
                                                       FontSize="14"
                                                       Margin="0,8,0,0" />
                                            <Grid ColumnSpacing="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <AutoSuggestBox Grid.Column="0"
                                                                PlaceholderText="{Binding Source={StaticResource Strings}, Path=PeopleSearchPlaceholder}"
                                                                QueryIcon="Find"
                                                                x:Name="PersonSearchBox"
                                                                TextChanged="PersonSearchBox_TextChanged" />
                                                <ComboBox Grid.Column="1"
                                                          ItemsSource="{Binding AvailableRoles}"
                                                          SelectedItem="{Binding SelectedPersonRole, Mode=TwoWay}"
                                                          DisplayMemberPath="Name"
                                                          HorizontalAlignment="Stretch" />
                                                <Button Grid.Column="2"
                                                        Content="+"
                                                        Command="{Binding AddPersonCommand}" />
                                            </Grid>
                                            <ComboBox ItemsSource="{Binding AvailablePeople}"
                                                      SelectedItem="{Binding SelectedAvailablePerson, Mode=TwoWay}"
                                                      HorizontalAlignment="Stretch"
                                                      PlaceholderText="{Binding Source={StaticResource Strings}, Path=PeopleSearchPlaceholder}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock>
                                                            <Run Text="{Binding Name}" />
                                                            <Run Text=" " />
                                                            <Run Text="{Binding Surname}" />
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <ItemsRepeater ItemsSource="{Binding BookPeopleDisplays}">
                                                <ItemsRepeater.Layout>
                                                    <StackLayout Spacing="4" />
                                                </ItemsRepeater.Layout>
                                                <ItemsRepeater.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding}"
                                                                       VerticalAlignment="Center" />
                                                            <Button Grid.Column="1"
                                                                    Content="X"
                                                                    Command="{Binding DataContext.RemovePersonCommand, ElementName=PageRoot}"
                                                                    CommandParameter="{Binding}"
                                                                    Padding="4,2"
                                                                    Style="{ThemeResource TextBlockButtonStyle}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsRepeater.ItemTemplate>
                                            </ItemsRepeater>

                                            <!-- === Companies === -->
                                            <TextBlock Text="{Binding Source={StaticResource Strings}, Path=BookCompaniesSectionHeader}"
                                                       FontWeight="SemiBold"
                                                       FontSize="14"
                                                       Margin="0,8,0,0" />
                                            <Grid ColumnSpacing="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <AutoSuggestBox Grid.Column="0"
                                                                PlaceholderText="{Binding Source={StaticResource Strings}, Path=CompaniesSearchBox_Placeholder}"
                                                                QueryIcon="Find"
                                                                x:Name="CompanySearchBox"
                                                                TextChanged="CompanySearchBox_TextChanged" />
                                                <ComboBox Grid.Column="1"
                                                          ItemsSource="{Binding AvailableRoles}"
                                                          SelectedItem="{Binding SelectedCompanyRole, Mode=TwoWay}"
                                                          DisplayMemberPath="Name"
                                                          HorizontalAlignment="Stretch" />
                                                <Button Grid.Column="2"
                                                        Content="+"
                                                        Command="{Binding AddCompanyCommand}" />
                                            </Grid>
                                            <ComboBox ItemsSource="{Binding AvailableCompanies}"
                                                      SelectedItem="{Binding SelectedAvailableCompany, Mode=TwoWay}"
                                                      DisplayMemberPath="Name"
                                                      HorizontalAlignment="Stretch"
                                                      PlaceholderText="{Binding Source={StaticResource Strings}, Path=CompaniesSearchBox_Placeholder}" />
                                            <ItemsRepeater ItemsSource="{Binding BookCompanyDisplays}">
                                                <ItemsRepeater.Layout>
                                                    <StackLayout Spacing="4" />
                                                </ItemsRepeater.Layout>
                                                <ItemsRepeater.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding}"
                                                                       VerticalAlignment="Center" />
                                                            <Button Grid.Column="1"
                                                                    Content="X"
                                                                    Command="{Binding DataContext.RemoveCompanyCommand, ElementName=PageRoot}"
                                                                    CommandParameter="{Binding}"
                                                                    Padding="4,2"
                                                                    Style="{ThemeResource TextBlockButtonStyle}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsRepeater.ItemTemplate>
                                            </ItemsRepeater>

                                            <!-- === Machines === -->
                                            <TextBlock Text="{Binding Source={StaticResource Strings}, Path=BookMachinesSectionHeader}"
                                                       FontWeight="SemiBold"
                                                       FontSize="14"
                                                       Margin="0,8,0,0" />
                                            <Grid ColumnSpacing="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ComboBox Grid.Column="0"
                                                          ItemsSource="{Binding AvailableMachines}"
                                                          SelectedItem="{Binding SelectedAvailableMachine, Mode=TwoWay}"
                                                          DisplayMemberPath="Name"
                                                          HorizontalAlignment="Stretch" />
                                                <Button Grid.Column="1"
                                                        Content="+"
                                                        Command="{Binding AddMachineCommand}" />
                                            </Grid>
                                            <ItemsRepeater ItemsSource="{Binding BookMachineDisplays}">
                                                <ItemsRepeater.Layout>
                                                    <StackLayout Spacing="4" />
                                                </ItemsRepeater.Layout>
                                                <ItemsRepeater.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding}"
                                                                       VerticalAlignment="Center" />
                                                            <Button Grid.Column="1"
                                                                    Content="X"
                                                                    Command="{Binding DataContext.RemoveMachineCommand, ElementName=PageRoot}"
                                                                    CommandParameter="{Binding}"
                                                                    Padding="4,2"
                                                                    Style="{ThemeResource TextBlockButtonStyle}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsRepeater.ItemTemplate>
                                            </ItemsRepeater>

                                            <!-- === Machine Families === -->
                                            <TextBlock Text="{Binding Source={StaticResource Strings}, Path=BookMachineFamiliesSectionHeader}"
                                                       FontWeight="SemiBold"
                                                       FontSize="14"
                                                       Margin="0,8,0,0" />
                                            <Grid ColumnSpacing="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ComboBox Grid.Column="0"
                                                          ItemsSource="{Binding AvailableMachineFamilies}"
                                                          SelectedItem="{Binding SelectedAvailableMachineFamily, Mode=TwoWay}"
                                                          DisplayMemberPath="Name"
                                                          HorizontalAlignment="Stretch" />
                                                <Button Grid.Column="1"
                                                        Content="+"
                                                        Command="{Binding AddMachineFamilyCommand}" />
                                            </Grid>
                                            <ItemsRepeater ItemsSource="{Binding BookMachineFamilyDisplays}">
                                                <ItemsRepeater.Layout>
                                                    <StackLayout Spacing="4" />
                                                </ItemsRepeater.Layout>
                                                <ItemsRepeater.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding}"
                                                                       VerticalAlignment="Center" />
                                                            <Button Grid.Column="1"
                                                                    Content="X"
                                                                    Command="{Binding DataContext.RemoveMachineFamilyCommand, ElementName=PageRoot}"
                                                                    CommandParameter="{Binding}"
                                                                    Padding="4,2"
                                                                    Style="{ThemeResource TextBlockButtonStyle}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsRepeater.ItemTemplate>
                                            </ItemsRepeater>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- Edit footer (Save / Cancel) -->
                                <Grid Grid.Row="2"
                                      Padding="16,12"
                                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                      BorderThickness="0,1,0,0"
                                      ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Content="{Binding Source={StaticResource Strings}, Path=CancelButton}"
                                            Command="{Binding CancelEditCommand}"
                                            HorizontalAlignment="Stretch" />
                                    <Button Grid.Column="1"
                                            Content="{Binding Source={StaticResource Strings}, Path=SaveButton}"
                                            Command="{Binding SaveBookCommand}"
                                            HorizontalAlignment="Stretch"
                                            Style="{ThemeResource AccentButtonStyle}" />
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Synopsis Panel -->
                        <Border Grid.Column="1"
                                Visibility="{Binding IsEditingSynopsis, Converter={StaticResource BoolToVisibilityConverter}}"
                                Width="500"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="1,0,0,0">
                            <Grid RowSpacing="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Synopsis header -->
                                <Grid Grid.Row="0"
                                      Padding="16,12"
                                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                      BorderThickness="0,0,0,1">
                                    <TextBlock Text="{Binding Source={StaticResource Strings}, Path=SynopsisSectionHeader}"
                                               FontSize="18"
                                               FontWeight="SemiBold" />
                                </Grid>

                                <!-- Language selector -->
                                <StackPanel Grid.Row="1"
                                            Padding="16,8"
                                            Spacing="4"
                                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                            BorderThickness="0,0,0,1">
                                    <TextBlock Text="{Binding Source={StaticResource Strings}, Path=LanguageLabel}"
                                               FontWeight="SemiBold" />
                                    <ComboBox ItemsSource="{Binding AvailableLanguages}"
                                              SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch"
                                              DisplayMemberPath="DisplayName" />
                                </StackPanel>

                                <!-- Existing synopses list -->
                                <StackPanel Grid.Row="2"
                                            Padding="16,8"
                                            Spacing="4"
                                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                            BorderThickness="0,0,0,1">
                                    <TextBlock Text="{Binding Source={StaticResource Strings}, Path=ExistingTranslationsLabel}"
                                               FontWeight="SemiBold" />
                                    <ItemsRepeater ItemsSource="{Binding ExistingSynopses}">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Spacing="4" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Language}"
                                                               VerticalAlignment="Center" />
                                                    <Button Grid.Column="1"
                                                            Content="✏️"
                                                            Command="{Binding DataContext.EditSynopsisCommand, ElementName=PageRoot}"
                                                            CommandParameter="{Binding}"
                                                            Padding="4,2"
                                                            Style="{ThemeResource TextBlockButtonStyle}" />
                                                    <Button Grid.Column="2"
                                                            Content="🗑️"
                                                            Command="{Binding DataContext.DeleteSynopsisCommand, ElementName=PageRoot}"
                                                            CommandParameter="{Binding}"
                                                            Padding="4,2"
                                                            Style="{ThemeResource TextBlockButtonStyle}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </StackPanel>

                                <!-- Synopsis editor -->
                                <TextBox Grid.Row="3"
                                         Margin="16"
                                         Text="{Binding SynopsisText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalAlignment="Stretch"
                                         HorizontalAlignment="Stretch"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto" />

                                <!-- Synopsis footer -->
                                <Grid Grid.Row="4"
                                      Padding="16,12"
                                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                      BorderThickness="0,1,0,0"
                                      ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Content="{Binding Source={StaticResource Strings}, Path=CancelButton}"
                                            Command="{Binding CancelSynopsisCommand}"
                                            HorizontalAlignment="Stretch" />
                                    <Button Grid.Column="1"
                                            Content="{Binding Source={StaticResource Strings}, Path=SaveButton}"
                                            Command="{Binding SaveSynopsisCommand}"
                                            HorizontalAlignment="Stretch"
                                            Style="{ThemeResource AccentButtonStyle}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
