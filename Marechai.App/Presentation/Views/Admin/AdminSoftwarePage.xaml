<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="Marechai.App.Presentation.Views.Admin.AdminSoftwarePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
      x:Name="PageRoot" NavigationCacheMode="Required"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="16,12">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Source={StaticResource Strings}, Path=SoftwareManagementTitle}"
                           FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource TextControlForeground}" />
                <TextBlock Text="{Binding Source={StaticResource Strings}, Path=SoftwareManagementSubtitle}"
                           FontSize="12" Foreground="{ThemeResource SystemBaseMediumColor}" Margin="0,4,0,0" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <StackPanel Visibility="{Binding IsAdmin, Converter={StaticResource InvertBoolToVisibilityConverter}}"
                        VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24" Spacing="16" MaxWidth="400">
                <InfoBar IsOpen="True" Severity="Warning" Title="{Binding Source={StaticResource Strings}, Path=AccessDeniedTitle}"
                         Message="{Binding Source={StaticResource Strings}, Path=AccessDeniedMessage}" IsClosable="False" />
            </StackPanel>

            <Grid Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}" Canvas.ZIndex="0">
                <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                            VerticalAlignment="Center" HorizontalAlignment="Center" Padding="32" Spacing="16">
                    <ProgressRing IsActive="True" IsIndeterminate="True" Height="64" Width="64" Foreground="{ThemeResource SystemAccentColor}" />
                    <TextBlock Text="{Binding Source={StaticResource Strings}, Path=LoadingText}" FontSize="14" TextAlignment="Center" Foreground="{ThemeResource SystemBaseMediumColor}" />
                </StackPanel>

                <StackPanel Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"
                            VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24" Spacing="16" MaxWidth="400" Canvas.ZIndex="100">
                    <InfoBar IsOpen="True" Severity="Error" Title="{Binding Source={StaticResource Strings}, Path=ErrorTitle}"
                             Message="{Binding ErrorMessage}" IsClosable="False" />
                    <Button Content="{Binding Source={StaticResource Strings}, Path=RetryButton}" Command="{Binding LoadCommand}"
                            HorizontalAlignment="Center" Style="{ThemeResource AccentButtonStyle}" />
                </StackPanel>

                <Grid Visibility="{Binding IsDataLoaded, Converter={StaticResource BoolToVisibilityConverter}}" Canvas.ZIndex="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <CommandBar Grid.Row="0" DefaultLabelPosition="Right">
                                <AppBarButton Icon="Add" Label="{Binding Source={StaticResource Strings}, Path=AddButton}" Command="{Binding OpenAddCommand}" />
                                <AppBarButton Icon="Refresh" Label="{Binding Source={StaticResource Strings}, Path=RefreshButton}" Command="{Binding LoadCommand}" />
                            </CommandBar>

                            <AutoSuggestBox Grid.Row="1" Margin="16,8,16,0"
                                            PlaceholderText="{Binding Source={StaticResource Strings}, Path=SearchPlaceholder}"
                                            QueryIcon="Find" Text="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            x:Name="FilterBox" TextChanged="FilterBox_TextChanged" />

                            <controls:DataGrid Grid.Row="2" Margin="16"
                                               ItemsSource="{Binding FilteredSoftware}" SelectedItem="{Binding SelectedSoftware, Mode=TwoWay}"
                                               AutoGenerateColumns="False" GridLinesVisibility="None" HeadersVisibility="Column"
                                               AlternatingRowBackground="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                               CanUserReorderColumns="True" CanUserResizeColumns="True" CanUserSortColumns="True"
                                               IsReadOnly="True" SelectionMode="Single">
                                <controls:DataGrid.Columns>
                                    <controls:DataGridTextColumn Header="{Binding Source={StaticResource Strings}, Path=NameColumn_Header}" Binding="{Binding Name}" Width="2*" />
                                    <controls:DataGridTextColumn Header="{Binding Source={StaticResource Strings}, Path=FamilyColumn_Header}" Binding="{Binding Family}" Width="*" />
                                    <controls:DataGridTemplateColumn Header="{Binding Source={StaticResource Strings}, Path=ActionsColumn_Header}" Width="Auto">
                                        <controls:DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <Button Content="{Binding Source={StaticResource Strings}, Path=EditButton}"
                                                            Command="{Binding DataContext.OpenEditCommand, ElementName=PageRoot}" CommandParameter="{Binding}"
                                                            Style="{ThemeResource TextBlockButtonStyle}" Padding="8,4" />
                                                    <Button Content="{Binding Source={StaticResource Strings}, Path=VersionsButton}"
                                                            Command="{Binding DataContext.OpenVersionsCommand, ElementName=PageRoot}" CommandParameter="{Binding}"
                                                            Style="{ThemeResource TextBlockButtonStyle}" Padding="8,4" />
                                                    <Button Content="{Binding Source={StaticResource Strings}, Path=DescriptionButton}"
                                                            Command="{Binding DataContext.OpenDescriptionCommand, ElementName=PageRoot}" CommandParameter="{Binding}"
                                                            Style="{ThemeResource TextBlockButtonStyle}" Padding="8,4" />
                                                    <Button Content="{Binding Source={StaticResource Strings}, Path=DeleteButton}"
                                                            Command="{Binding DataContext.DeleteCommand, ElementName=PageRoot}" CommandParameter="{Binding}"
                                                            Foreground="{ThemeResource SystemErrorTextColor}" Style="{ThemeResource TextBlockButtonStyle}" Padding="8,4" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </controls:DataGridTemplateColumn.CellTemplate>
                                    </controls:DataGridTemplateColumn>
                                </controls:DataGrid.Columns>
                            </controls:DataGrid>
                        </Grid>

                        <Border Grid.Column="1" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}"
                                Width="420" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
                            <Grid RowSpacing="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Padding="16,12" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                    <TextBlock Text="{Binding EditPanelTitle}" FontSize="18" FontWeight="SemiBold" />
                                </Grid>

                                <ScrollViewer Grid.Row="1" Padding="16" VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="12">
                                        <TextBox Header="{Binding Source={StaticResource Strings}, Path=NameLabel}"
                                                 Text="{Binding SoftwareName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <AutoSuggestBox Header="{Binding Source={StaticResource Strings}, Path=FamilyLabel}"
                                                        PlaceholderText="{Binding Source={StaticResource Strings}, Path=SearchPlaceholder}"
                                                        Text="{Binding FamilySearchText, Mode=TwoWay}" QueryIcon="Find"
                                                        x:Name="FamilyFilterBox" TextChanged="FamilyFilterBox_TextChanged" />
                                        <ComboBox ItemsSource="{Binding FamilySuggestions}" SelectedItem="{Binding SelectedFamily, Mode=TwoWay}"
                                                  DisplayMemberPath="Name" HorizontalAlignment="Stretch"
                                                  PlaceholderText="{Binding Source={StaticResource Strings}, Path=FamilyLabel}" />

                                        <ComboBox SelectedIndex="{Binding Kind, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="{Binding Source={StaticResource Strings}, Path=SoftwareIsSoftwareLabel}" />
                                            <ComboBoxItem Content="{Binding Source={StaticResource Strings}, Path=IsOperatingSystemLabel}" />
                                            <ComboBoxItem Content="{Binding Source={StaticResource Strings}, Path=IsGameLabel}" />
                                            <ComboBoxItem Content="{Binding Source={StaticResource Strings}, Path=SoftwareIsDlcLabel}" />
                                        </ComboBox>

                                        <!-- Company Roles (edit only) -->
                                        <StackPanel Visibility="{Binding IsEditingExisting, Converter={StaticResource BoolToVisibilityConverter}}" Spacing="8">
                                            <TextBlock Text="{Binding Source={StaticResource Strings}, Path=CompanyRolesHeader}" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0" />
                                            <Grid ColumnSpacing="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ComboBox Grid.Column="0" ItemsSource="{Binding CompanySuggestions}"
                                                          SelectedItem="{Binding SelectedCompanyToAdd, Mode=TwoWay}" DisplayMemberPath="Name"
                                                          PlaceholderText="{Binding Source={StaticResource Strings}, Path=CompanyLabel}" HorizontalAlignment="Stretch" />
                                                <ComboBox Grid.Column="1" ItemsSource="{Binding Roles}"
                                                          SelectedItem="{Binding SelectedRoleToAdd, Mode=TwoWay}" DisplayMemberPath="Name"
                                                          PlaceholderText="{Binding Source={StaticResource Strings}, Path=RoleLabel}" HorizontalAlignment="Stretch" />
                                                <Button Grid.Column="2" Content="+" Command="{Binding AddCompanyRoleCommand}" VerticalAlignment="Bottom" Padding="10,6" />
                                            </Grid>
                                            <ItemsRepeater ItemsSource="{Binding CompanyRoleDisplays}">
                                                <ItemsRepeater.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,2" ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding}" />
                                                            <Button Grid.Column="1" Content="{Binding Source={StaticResource Strings}, Path=DeleteButton}"
                                                                    Command="{Binding DataContext.RemoveCompanyRoleByDisplayCommand, ElementName=PageRoot}" CommandParameter="{Binding}"
                                                                    Foreground="{ThemeResource SystemErrorTextColor}" Style="{ThemeResource TextBlockButtonStyle}" Padding="8,4" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsRepeater.ItemTemplate>
                                            </ItemsRepeater>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>

                                <Grid Grid.Row="2" Padding="16,12" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="{Binding Source={StaticResource Strings}, Path=CancelButton}" Command="{Binding CancelEditCommand}" HorizontalAlignment="Stretch" />
                                    <Button Grid.Column="1" Content="{Binding Source={StaticResource Strings}, Path=SaveButton}" Command="{Binding SaveCommand}" HorizontalAlignment="Stretch" Style="{ThemeResource AccentButtonStyle}" />
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Description Panel -->
                        <Border Grid.Column="1" Visibility="{Binding IsEditingDescription, Converter={StaticResource BoolToVisibilityConverter}}"
                                Width="500" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
                            <Grid RowSpacing="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Padding="16,12" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                    <TextBlock Text="{Binding Source={StaticResource Strings}, Path=DescriptionDialogTitle}" FontSize="18" FontWeight="SemiBold" />
                                </Grid>

                                <ComboBox Grid.Row="1" Margin="16,12,16,0"
                                          ItemsSource="{Binding AvailableLanguages}"
                                          SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName"
                                          PlaceholderText="{Binding Source={StaticResource Strings}, Path=LanguageLabel}"
                                          HorizontalAlignment="Stretch" />

                                <ItemsRepeater Grid.Row="2" Margin="16,8" ItemsSource="{Binding ExistingTranslations}">
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2" ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding Language}" />
                                                <Button Grid.Column="1" Content="{Binding Source={StaticResource Strings}, Path=EditButton}"
                                                        Command="{Binding DataContext.EditTranslationCommand, ElementName=PageRoot}" CommandParameter="{Binding}"
                                                        Style="{ThemeResource TextBlockButtonStyle}" Padding="8,4" />
                                                <Button Grid.Column="2" Content="{Binding Source={StaticResource Strings}, Path=DeleteButton}"
                                                        Command="{Binding DataContext.DeleteTranslationCommand, ElementName=PageRoot}" CommandParameter="{Binding}"
                                                        Foreground="{ThemeResource SystemErrorTextColor}" Style="{ThemeResource TextBlockButtonStyle}" Padding="8,4" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>

                                <TextBox Grid.Row="3" Margin="16" AcceptsReturn="True" TextWrapping="Wrap"
                                         Text="{Binding DescriptionMarkdown, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="Markdown"
                                         MinHeight="200"
                                         VerticalAlignment="Stretch" />

                                <Grid Grid.Row="4" Padding="16,12" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="{Binding Source={StaticResource Strings}, Path=CancelButton}" Command="{Binding CancelDescriptionCommand}" HorizontalAlignment="Stretch" />
                                    <Button Grid.Column="1" Content="{Binding Source={StaticResource Strings}, Path=SaveButton}" Command="{Binding SaveDescriptionCommand}" HorizontalAlignment="Stretch" Style="{ThemeResource AccentButtonStyle}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
