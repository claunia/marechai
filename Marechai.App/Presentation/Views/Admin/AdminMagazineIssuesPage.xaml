<?xml version="1.0"
      encoding="utf-8"?>

<Page x:Class="Marechai.App.Presentation.Views.Admin.AdminMagazineIssuesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
      x:Name="PageRoot"
      NavigationCacheMode="Required"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,0,0,1"
              Padding="16,12">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Content="{Binding Source={StaticResource Strings}, Path=BackToMagazinesButton}"
                        Command="{Binding GoBackCommand}"
                        Style="{ThemeResource TextBlockButtonStyle}" />
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding Source={StaticResource Strings}, Path=MagazineIssuesManagementTitle}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextControlForeground}" />
                    <TextBlock Text="{Binding MagazineTitle}"
                               FontSize="12"
                               Foreground="{ThemeResource SystemBaseMediumColor}"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="1">

            <!-- Access Denied -->
            <StackPanel Visibility="{Binding IsAdmin, Converter={StaticResource InvertBoolToVisibilityConverter}}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Padding="24"
                        Spacing="16"
                        MaxWidth="400">
                <InfoBar IsOpen="True"
                         Severity="Warning"
                         Title="{Binding Source={StaticResource Strings}, Path=MagazineMgmtAccessDeniedTitle}"
                         Message="{Binding Source={StaticResource Strings}, Path=MagazineMgmtAccessDeniedMessage}"
                         IsClosable="False" />
            </StackPanel>

            <!-- Content (admin only) -->
            <Grid Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}"
                  Canvas.ZIndex="0">

                <!-- Loading -->
                <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Padding="32"
                            Spacing="16">
                    <ProgressRing IsActive="True"
                                  IsIndeterminate="True"
                                  Height="64"
                                  Width="64"
                                  Foreground="{ThemeResource SystemAccentColor}" />
                    <TextBlock Text="{Binding Source={StaticResource Strings}, Path=LoadingText}"
                               FontSize="14"
                               TextAlignment="Center"
                               Foreground="{ThemeResource SystemBaseMediumColor}" />
                </StackPanel>

                <!-- Error -->
                <StackPanel Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Padding="24"
                            Spacing="16"
                            MaxWidth="400"
                            Canvas.ZIndex="100">
                    <InfoBar IsOpen="True"
                             Severity="Error"
                             Title="{Binding Source={StaticResource Strings}, Path=ErrorTitle}"
                             Message="{Binding ErrorMessage}"
                             IsClosable="False" />
                    <Button Content="{Binding Source={StaticResource Strings}, Path=RetryButton}"
                            Command="{Binding LoadIssuesCommand}"
                            HorizontalAlignment="Center"
                            Style="{ThemeResource AccentButtonStyle}" />
                </StackPanel>

                <!-- List View -->
                <Grid Visibility="{Binding IsDataLoaded, Converter={StaticResource BoolToVisibilityConverter}}"
                      Canvas.ZIndex="1">

                    <!-- Two-column layout: list + edit panel -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Issues list -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Command Bar -->
                            <CommandBar Grid.Row="0"
                                        DefaultLabelPosition="Right">
                                <AppBarButton Icon="Add"
                                              Label="{Binding Source={StaticResource Strings}, Path=AddMagazineIssueButton}"
                                              Command="{Binding OpenAddIssueCommand}" />
                                <AppBarButton Icon="Refresh"
                                              Label="{Binding Source={StaticResource Strings}, Path=RefreshMagazineIssuesButton}"
                                              Command="{Binding LoadIssuesCommand}" />
                            </CommandBar>

                            <!-- DataGrid -->
                            <controls:DataGrid Grid.Row="1"
                                               Margin="16"
                                               ItemsSource="{Binding Issues}"
                                               SelectedItem="{Binding SelectedIssue, Mode=TwoWay}"
                                               AutoGenerateColumns="False"
                                               GridLinesVisibility="None"
                                               HeadersVisibility="Column"
                                               AlternatingRowBackground="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                               CanUserReorderColumns="True"
                                               CanUserResizeColumns="True"
                                               CanUserSortColumns="True"
                                               IsReadOnly="True"
                                               SelectionMode="Single"
                                               HorizontalScrollBarVisibility="Auto"
                                               VerticalScrollBarVisibility="Auto">
                                <controls:DataGrid.Columns>
                                    <controls:DataGridTextColumn
                                        Header="{Binding Source={StaticResource Strings}, Path=MagazineIssueNumberColumn}"
                                        Binding="{Binding IssueNumber}"
                                        Width="Auto" />
                                    <controls:DataGridTextColumn
                                        Header="{Binding Source={StaticResource Strings}, Path=MagazineIssueCaptionColumn}"
                                        Binding="{Binding Caption}"
                                        Width="2*" />
                                    <controls:DataGridTextColumn
                                        Header="{Binding Source={StaticResource Strings}, Path=MagazineIssueNativeCaptionColumn}"
                                        Binding="{Binding NativeCaption}"
                                        Width="*" />
                                    <controls:DataGridTextColumn
                                        Header="{Binding Source={StaticResource Strings}, Path=MagazinePublishedLabel}"
                                        Binding="{Binding Published}"
                                        Width="Auto" />
                                    <controls:DataGridTextColumn
                                        Header="{Binding Source={StaticResource Strings}, Path=MagazineIssueProductCodeColumn}"
                                        Binding="{Binding ProductCode}"
                                        Width="Auto" />
                                    <controls:DataGridTextColumn
                                        Header="{Binding Source={StaticResource Strings}, Path=MagazineIssuePagesColumn}"
                                        Binding="{Binding Pages}"
                                        Width="Auto" />
                                    <controls:DataGridTemplateColumn
                                        Header="{Binding Source={StaticResource Strings}, Path=ActionsColumn}"
                                        Width="Auto">
                                        <controls:DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal"
                                                            Spacing="4">
                                                    <Button Content="&#xE70F;"
                                                            ToolTipService.ToolTip="{Binding Source={StaticResource Strings}, Path=EditMagazineIssueButton}"
                                                            Command="{Binding DataContext.OpenEditIssueCommand, ElementName=PageRoot}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource AdminGridActionButtonStyle}" />
                                                    <Button Content="&#xE74D;"
                                                            ToolTipService.ToolTip="{Binding Source={StaticResource Strings}, Path=DeleteMagazineIssueButton}"
                                                            Command="{Binding DataContext.DeleteIssueCommand, ElementName=PageRoot}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource AdminGridDestructiveActionButtonStyle}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </controls:DataGridTemplateColumn.CellTemplate>
                                    </controls:DataGridTemplateColumn>
                                </controls:DataGrid.Columns>
                            </controls:DataGrid>
                        </Grid>

                        <!-- Edit Panel -->
                        <Border Grid.Column="1"
                                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}"
                                Width="500"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="1,0,0,0">
                            <Grid RowSpacing="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Edit header -->
                                <Grid Grid.Row="0"
                                      Padding="16,12"
                                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                      BorderThickness="0,0,0,1">
                                    <TextBlock Text="{Binding EditPanelTitle}"
                                               FontSize="18"
                                               FontWeight="SemiBold" />
                                </Grid>

                                <!-- Edit form (scrollable) -->
                                <ScrollViewer Grid.Row="1"
                                              Padding="16"
                                              VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="12">

                                        <!-- Caption -->
                                        <TextBox Header="{Binding Source={StaticResource Strings}, Path=MagazineIssueCaptionLabel}"
                                                 Text="{Binding Caption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <!-- Native Caption -->
                                        <TextBox Header="{Binding Source={StaticResource Strings}, Path=MagazineIssueNativeCaptionLabel}"
                                                 Text="{Binding NativeCaption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <!-- Issue Number -->
                                        <NumberBox Header="{Binding Source={StaticResource Strings}, Path=MagazineIssueNumberLabel}"
                                                   Value="{Binding IssueNumber, Mode=TwoWay}"
                                                   Minimum="1"
                                                   SpinButtonPlacementMode="Compact" />

                                        <!-- Published -->
                                        <CalendarDatePicker Header="{Binding Source={StaticResource Strings}, Path=MagazinePublishedLabel}"
                                                            Date="{Binding Published, Mode=TwoWay}"
                                                            HorizontalAlignment="Stretch" />
                                        <ComboBox Header="{Binding Source={StaticResource Strings}, Path=DatePrecisionLabel}"
                                                  SelectedIndex="{Binding PublishedPrecision, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="{Binding Source={StaticResource Strings}, Path=DatePrecisionFull}" />
                                            <ComboBoxItem Content="{Binding Source={StaticResource Strings}, Path=DatePrecisionMonthYear}" />
                                            <ComboBoxItem Content="{Binding Source={StaticResource Strings}, Path=DatePrecisionYearOnly}" />
                                        </ComboBox>

                                        <!-- Product Code -->
                                        <TextBox Header="{Binding Source={StaticResource Strings}, Path=MagazineIssueProductCodeLabel}"
                                                 Text="{Binding ProductCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 MaxLength="18" />

                                        <!-- Pages -->
                                        <NumberBox Header="{Binding Source={StaticResource Strings}, Path=MagazineIssuePagesLabel}"
                                                   Value="{Binding Pages, Mode=TwoWay}"
                                                   Minimum="1"
                                                   SpinButtonPlacementMode="Compact" />

                                        <!-- Internet Archive URL -->
                                        <TextBox Header="{Binding Source={StaticResource Strings}, Path=MagazineIssueInternetArchiveUrlLabel}"
                                                 Text="{Binding InternetArchiveUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="https://archive.org/details/..."
                                                 MaxLength="2048" />

                                        <!-- ======== Cover + Junction sections (only when editing existing) ======== -->
                                        <StackPanel Visibility="{Binding IsEditingExisting, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Spacing="12">

                                            <!-- === Cover === -->
                                            <TextBlock Text="{Binding Source={StaticResource Strings}, Path=MagazineIssueCoverSectionHeader}"
                                                       FontWeight="SemiBold"
                                                       FontSize="14"
                                                       Margin="0,8,0,0" />
                                            <TextBlock Text="{Binding Source={StaticResource Strings}, Path=MagazineIssueHasCoverMessage}"
                                                       Visibility="{Binding HasCover, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <TextBlock Text="{Binding Source={StaticResource Strings}, Path=MagazineIssueNoCoverMessage}"
                                                       Visibility="{Binding HasCover, Converter={StaticResource InvertBoolToVisibilityConverter}}" />
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="8">
                                                <Button Content="{Binding Source={StaticResource Strings}, Path=UploadCoverButton}"
                                                        Command="{Binding UploadCoverCommand}"
                                                        IsEnabled="{Binding IsUploadingCover, Converter={StaticResource InvertBoolConverter}}"
                                                        Style="{ThemeResource AccentButtonStyle}" />
                                                <Button Content="{Binding Source={StaticResource Strings}, Path=DeleteCoverButton}"
                                                        Command="{Binding DeleteCoverCommand}"
                                                        Visibility="{Binding HasCover, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            </StackPanel>
                                            <ProgressRing IsActive="{Binding IsUploadingCover}"
                                                          IsIndeterminate="True"
                                                          Height="24"
                                                          Width="24"
                                                          HorizontalAlignment="Left" />
                                            <InfoBar IsOpen="{Binding HasCoverMessage, Mode=TwoWay}"
                                                     Message="{Binding CoverMessage}"
                                                     Severity="Informational" />

                                            <!-- === People === -->
                                            <TextBlock Text="{Binding Source={StaticResource Strings}, Path=MagazinePeopleSectionHeader}"
                                                       FontWeight="SemiBold"
                                                       FontSize="14"
                                                       Margin="0,8,0,0" />
                                            <Grid ColumnSpacing="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <AutoSuggestBox Grid.Column="0"
                                                                PlaceholderText="{Binding Source={StaticResource Strings}, Path=PeopleSearchPlaceholder}"
                                                                QueryIcon="Find"
                                                                x:Name="PersonSearchBox"
                                                                TextChanged="PersonSearchBox_TextChanged" />
                                                <ComboBox Grid.Column="1"
                                                          ItemsSource="{Binding AvailableRoles}"
                                                          SelectedItem="{Binding SelectedPersonRole, Mode=TwoWay}"
                                                          DisplayMemberPath="Name"
                                                          HorizontalAlignment="Stretch" />
                                                <Button Grid.Column="2"
                                                        Content="+"
                                                        Command="{Binding AddPersonCommand}" />
                                            </Grid>
                                            <ComboBox ItemsSource="{Binding AvailablePeople}"
                                                      SelectedItem="{Binding SelectedAvailablePerson, Mode=TwoWay}"
                                                      HorizontalAlignment="Stretch"
                                                      PlaceholderText="{Binding Source={StaticResource Strings}, Path=PeopleSearchPlaceholder}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock>
                                                            <Run Text="{Binding Name}" />
                                                            <Run Text=" " />
                                                            <Run Text="{Binding Surname}" />
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <ItemsRepeater ItemsSource="{Binding IssuePeopleDisplays}">
                                                <ItemsRepeater.Layout>
                                                    <StackLayout Spacing="4" />
                                                </ItemsRepeater.Layout>
                                                <ItemsRepeater.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding}"
                                                                       VerticalAlignment="Center" />
                                                            <Button Grid.Column="1"
                                                                    Content="X"
                                                                    Command="{Binding DataContext.RemovePersonCommand, ElementName=PageRoot}"
                                                                    CommandParameter="{Binding}"
                                                                    Padding="4,2"
                                                                    Style="{ThemeResource TextBlockButtonStyle}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsRepeater.ItemTemplate>
                                            </ItemsRepeater>

                                            <!-- === Machines === -->
                                            <TextBlock Text="{Binding Source={StaticResource Strings}, Path=MagazineMachinesSectionHeader}"
                                                       FontWeight="SemiBold"
                                                       FontSize="14"
                                                       Margin="0,8,0,0" />
                                            <Grid ColumnSpacing="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ComboBox Grid.Column="0"
                                                          ItemsSource="{Binding AvailableMachines}"
                                                          SelectedItem="{Binding SelectedAvailableMachine, Mode=TwoWay}"
                                                          DisplayMemberPath="Name"
                                                          HorizontalAlignment="Stretch" />
                                                <Button Grid.Column="1"
                                                        Content="+"
                                                        Command="{Binding AddMachineCommand}" />
                                            </Grid>
                                            <ItemsRepeater ItemsSource="{Binding IssueMachineDisplays}">
                                                <ItemsRepeater.Layout>
                                                    <StackLayout Spacing="4" />
                                                </ItemsRepeater.Layout>
                                                <ItemsRepeater.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding}"
                                                                       VerticalAlignment="Center" />
                                                            <Button Grid.Column="1"
                                                                    Content="X"
                                                                    Command="{Binding DataContext.RemoveMachineCommand, ElementName=PageRoot}"
                                                                    CommandParameter="{Binding}"
                                                                    Padding="4,2"
                                                                    Style="{ThemeResource TextBlockButtonStyle}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsRepeater.ItemTemplate>
                                            </ItemsRepeater>

                                            <!-- === Machine Families === -->
                                            <TextBlock Text="{Binding Source={StaticResource Strings}, Path=MagazineMachineFamiliesSectionHeader}"
                                                       FontWeight="SemiBold"
                                                       FontSize="14"
                                                       Margin="0,8,0,0" />
                                            <Grid ColumnSpacing="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ComboBox Grid.Column="0"
                                                          ItemsSource="{Binding AvailableMachineFamilies}"
                                                          SelectedItem="{Binding SelectedAvailableMachineFamily, Mode=TwoWay}"
                                                          DisplayMemberPath="Name"
                                                          HorizontalAlignment="Stretch" />
                                                <Button Grid.Column="1"
                                                        Content="+"
                                                        Command="{Binding AddMachineFamilyCommand}" />
                                            </Grid>
                                            <ItemsRepeater ItemsSource="{Binding IssueMachineFamilyDisplays}">
                                                <ItemsRepeater.Layout>
                                                    <StackLayout Spacing="4" />
                                                </ItemsRepeater.Layout>
                                                <ItemsRepeater.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding}"
                                                                       VerticalAlignment="Center" />
                                                            <Button Grid.Column="1"
                                                                    Content="X"
                                                                    Command="{Binding DataContext.RemoveMachineFamilyCommand, ElementName=PageRoot}"
                                                                    CommandParameter="{Binding}"
                                                                    Padding="4,2"
                                                                    Style="{ThemeResource TextBlockButtonStyle}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsRepeater.ItemTemplate>
                                            </ItemsRepeater>

                                            <!-- === Software === -->
                                            <TextBlock Text="{Binding Source={StaticResource Strings}, Path=MagazineIssueSoftwareSectionHeader}"
                                                       FontWeight="SemiBold"
                                                       FontSize="14"
                                                       Margin="0,8,0,0" />
                                            <Grid ColumnSpacing="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ComboBox Grid.Column="0"
                                                          ItemsSource="{Binding AvailableSoftware}"
                                                          SelectedItem="{Binding SelectedAvailableSoftware, Mode=TwoWay}"
                                                          DisplayMemberPath="Name"
                                                          HorizontalAlignment="Stretch" />
                                                <Button Grid.Column="1"
                                                        Content="+"
                                                        Command="{Binding AddSoftwareCommand}" />
                                            </Grid>
                                            <ItemsRepeater ItemsSource="{Binding IssueSoftwareDisplays}">
                                                <ItemsRepeater.Layout>
                                                    <StackLayout Spacing="4" />
                                                </ItemsRepeater.Layout>
                                                <ItemsRepeater.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding}"
                                                                       VerticalAlignment="Center" />
                                                            <Button Grid.Column="1"
                                                                    Content="X"
                                                                    Command="{Binding DataContext.RemoveSoftwareCommand, ElementName=PageRoot}"
                                                                    CommandParameter="{Binding}"
                                                                    Padding="4,2"
                                                                    Style="{ThemeResource TextBlockButtonStyle}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsRepeater.ItemTemplate>
                                            </ItemsRepeater>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- Edit footer (Save / Cancel) -->
                                <Grid Grid.Row="2"
                                      Padding="16,12"
                                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                      BorderThickness="0,1,0,0"
                                      ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Content="{Binding Source={StaticResource Strings}, Path=CancelButton}"
                                            Command="{Binding CancelEditCommand}"
                                            HorizontalAlignment="Stretch" />
                                    <Button Grid.Column="1"
                                            Content="{Binding Source={StaticResource Strings}, Path=SaveButton}"
                                            Command="{Binding SaveIssueCommand}"
                                            HorizontalAlignment="Stretch"
                                            Style="{ThemeResource AccentButtonStyle}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
