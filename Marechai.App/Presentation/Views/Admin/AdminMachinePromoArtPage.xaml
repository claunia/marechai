<?xml version="1.0"
      encoding="utf-8"?>

<Page x:Class="Marechai.App.Presentation.Views.Admin.AdminMachinePromoArtPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Name="PageRoot"
      NavigationCacheMode="Required"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,0,0,1"
              Padding="16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Content="&#xE5C4;"
                    FontFamily="{StaticResource MaterialIconsFontFamily}"
                    Command="{Binding GoBackCommand}"
                    Style="{ThemeResource TextBlockButtonStyle}"
                    Padding="8,4"
                    VerticalAlignment="Center"
                    Margin="0,0,12,0" />
            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center">
                <TextBlock FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextControlForeground}">
                    <Run Text="{Binding Source={StaticResource Strings}, Path=MachinePromoArtTitle}" />
                    <Run Text=" - " />
                    <Run Text="{Binding MachineName}" />
                </TextBlock>
                <TextBlock Text="{Binding Source={StaticResource Strings}, Path=MachinePromoArtSubtitle}"
                           FontSize="12"
                           Foreground="{ThemeResource SystemBaseMediumColor}"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">

            <StackPanel Visibility="{Binding IsAdmin, Converter={StaticResource InvertBoolToVisibilityConverter}}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Padding="24"
                        Spacing="16"
                        MaxWidth="400">
                <InfoBar IsOpen="True"
                         Severity="Warning"
                         Title="{Binding Source={StaticResource Strings}, Path=MachinePromoArtMgmtAccessDeniedTitle}"
                         Message="{Binding Source={StaticResource Strings}, Path=MachinePromoArtMgmtAccessDeniedMessage}"
                         IsClosable="False" />
            </StackPanel>

            <Grid Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <CommandBar Grid.Row="0"
                            DefaultLabelPosition="Right">
                    <AppBarButton Icon="Refresh"
                                  Label="{Binding Source={StaticResource Strings}, Path=RefreshButton}"
                                  Command="{Binding LoadPromoArtCommand}" />
                </CommandBar>

                <ScrollViewer Grid.Row="1"
                              Grid.RowSpan="2"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="16"
                                Spacing="16">

                        <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Padding="32"
                                    Spacing="16">
                            <ProgressRing IsActive="True"
                                          IsIndeterminate="True"
                                          Height="64"
                                          Width="64"
                                          Foreground="{ThemeResource SystemAccentColor}" />
                            <TextBlock Text="{Binding Source={StaticResource Strings}, Path=LoadingText}"
                                       FontSize="14"
                                       TextAlignment="Center"
                                       Foreground="{ThemeResource SystemBaseMediumColor}" />
                        </StackPanel>

                        <InfoBar IsOpen="{Binding HasError}"
                                 Severity="Error"
                                 Title="{Binding Source={StaticResource Strings}, Path=ErrorTitle}"
                                 Message="{Binding ErrorMessage}"
                                 IsClosable="False" />

                        <InfoBar IsOpen="{Binding HasStatusMessage}"
                                 Severity="{Binding StatusSeverity}"
                                 Message="{Binding StatusMessage}"
                                 IsClosable="False" />

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{Binding Source={StaticResource Strings}, Path=MachinePromoArtUploadSectionTitle}"
                                           FontSize="16"
                                           FontWeight="SemiBold" />

                                <AutoSuggestBox Header="{Binding Source={StaticResource Strings}, Path=MachinePromoArtGroupLabel}"
                                                Text="{Binding GroupNameInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                ItemsSource="{Binding GroupSuggestions}" />

                                <TextBox Header="{Binding Source={StaticResource Strings}, Path=MachinePromoArtCaptionLabel}"
                                         Text="{Binding CaptionInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                <Button Content="{Binding Source={StaticResource Strings}, Path=MachinePromoArtUploadButton}"
                                        Command="{Binding UploadPromoArtCommand}"
                                        Style="{ThemeResource AccentButtonStyle}"
                                        HorizontalAlignment="Left"
                                        IsEnabled="{Binding CanUploadPromoArt}" />
                            </StackPanel>
                        </Border>

                        <StackPanel Visibility="{Binding IsDataLoaded, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Spacing="12">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8">
                                <TextBlock Text="{Binding Source={StaticResource Strings}, Path=MachinePromoArtTitle}"
                                           FontSize="16"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding PromoArt.Count}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{ThemeResource SystemAccentColor}" />
                            </StackPanel>

                            <InfoBar IsOpen="True"
                                     Visibility="{Binding PromoArt.Count, Converter={StaticResource ZeroToVisibilityConverter}}"
                                     Severity="Informational"
                                     Message="{Binding Source={StaticResource Strings}, Path=MachinePromoArtEmptyMessage}"
                                     IsClosable="False" />

                            <ItemsRepeater ItemsSource="{Binding PromoArt}">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout MinItemWidth="320"
                                                       MinItemHeight="380"
                                                       MinColumnSpacing="16"
                                                       MinRowSpacing="16"
                                                       ItemsStretch="Fill" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="12">
                                            <StackPanel Spacing="12">
                                                <Grid Height="160"
                                                      Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                      CornerRadius="6">
                                                    <Image Source="{Binding ThumbnailImageSource}"
                                                           Stretch="Uniform" />
                                                </Grid>

                                                <AutoSuggestBox Header="{Binding Source={StaticResource Strings}, Path=MachinePromoArtGroupLabel}"
                                                                Text="{Binding GroupName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                ItemsSource="{Binding DataContext.GroupSuggestions, ElementName=PageRoot}" />

                                                <TextBox Header="{Binding Source={StaticResource Strings}, Path=MachinePromoArtCaptionLabel}"
                                                         Text="{Binding Caption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                                <StackPanel Orientation="Horizontal"
                                                            Spacing="8">
                                                    <Button Content="{Binding Source={StaticResource Strings}, Path=SaveButton}"
                                                            Command="{Binding DataContext.SaveItemCommand, ElementName=PageRoot}"
                                                            CommandParameter="{Binding}"
                                                            Style="{ThemeResource AccentButtonStyle}" />
                                                    <Button Content="{Binding Source={StaticResource Strings}, Path=DeleteButton}"
                                                            Command="{Binding DataContext.DeleteItemCommand, ElementName=PageRoot}"
                                                            CommandParameter="{Binding}"
                                                            Foreground="{ThemeResource SystemErrorTextColor}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Page>
