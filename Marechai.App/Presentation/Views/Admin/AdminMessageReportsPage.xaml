<?xml version="1.0" encoding="utf-8"?>

<Page x:Class="Marechai.App.Presentation.Views.Admin.AdminMessageReportsPage"
      x:Name="PageRoot"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,0,0,1"
              Padding="16,12">
            <StackPanel>
                <TextBlock Text="Message Reports"
                           FontSize="20"
                           FontWeight="SemiBold" />
                <CheckBox Content="Show resolved"
                          IsChecked="{Binding IncludeResolved, Mode=TwoWay}"
                          Command="{Binding ToggleResolvedCommand}"
                          Margin="0,8,0,0" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <StackPanel Visibility="{Binding IsLoading}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Padding="32"
                        Spacing="16">
                <ProgressRing IsActive="True"
                              IsIndeterminate="True"
                              Height="64"
                              Width="64" />
                <TextBlock Text="Loading message reports..." />
            </StackPanel>

            <StackPanel Visibility="{Binding HasError}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Padding="24"
                        Spacing="16"
                        MaxWidth="400">
                <InfoBar IsOpen="True"
                         Severity="Error"
                         Title="Could not load reports"
                         Message="{Binding ErrorMessage}"
                         IsClosable="False" />
                <Button Content="Retry"
                        Command="{Binding RefreshCommand}"
                        HorizontalAlignment="Center"
                        Style="{ThemeResource AccentButtonStyle}" />
            </StackPanel>

            <Grid Visibility="{Binding IsDataLoaded}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Reports}"
                                  Margin="12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16,12"
                                        Margin="0,0,0,8">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{Binding Reporter}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding ReasonText}" />
                                        <TextBlock Text="{Binding Explanation}"
                                                   TextWrapping="WrapWholeWords" />
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    Spacing="8">
                                            <TextBlock Text="{Binding CreatedOnText}"
                                                       VerticalAlignment="Center"
                                                       FontSize="12" />
                                            <TextBlock Text="{Binding StatusText}"
                                                       VerticalAlignment="Center"
                                                       FontSize="12" />
                                            <Button Content="Open thread"
                                                    Command="{Binding DataContext.OpenConversationCommand, ElementName=PageRoot}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Resolve"
                                                    Visibility="{Binding IsResolved, Converter={StaticResource InvertBoolToVisibilityConverter}}"
                                                    Command="{Binding DataContext.ResolveReportCommand, ElementName=PageRoot}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="8"
                            Margin="12">
                    <Button Content="Previous"
                            Command="{Binding PreviousPageCommand}"
                            IsEnabled="{Binding CanGoPrevious}" />
                    <Button Content="Next"
                            Command="{Binding NextPageCommand}"
                            IsEnabled="{Binding CanGoNext}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
