<?xml version="1.0"
      encoding="utf-8"?>

<Page x:Class="Marechai.App.Presentation.Views.Admin.AdminMessageReportsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
      x:Name="PageRoot"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,0,0,1"
              Padding="16,12">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Source={StaticResource Strings}, Path=MessageReportsTitle}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextControlForeground}" />
                <TextBlock Text="{Binding Source={StaticResource Strings}, Path=MessageReportsSubtitle}"
                           FontSize="12"
                           Foreground="{ThemeResource SystemBaseMediumColor}"
                           Margin="0,4,0,8" />
                <CheckBox Content="{Binding Source={StaticResource Strings}, Path=MessageReportsShowResolved}"
                          IsChecked="{Binding IncludeResolved, Mode=TwoWay}"
                          Command="{Binding ToggleResolvedCommand}" />
            </StackPanel>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="1">

            <!-- Access Denied -->
            <StackPanel Visibility="{Binding IsAdmin, Converter={StaticResource InvertBoolToVisibilityConverter}}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Padding="24"
                        Spacing="16"
                        MaxWidth="400">
                <InfoBar IsOpen="True"
                         Severity="Warning"
                         Title="{Binding Source={StaticResource Strings}, Path=MessageReportsAccessDeniedTitle}"
                         Message="{Binding Source={StaticResource Strings}, Path=MessageReportsAccessDeniedMessage}"
                         IsClosable="False" />
            </StackPanel>

            <!-- Content (admin only) -->
            <Grid Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}">

                <!-- Loading -->
                <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Padding="32"
                            Spacing="16">
                    <ProgressRing IsActive="True"
                                  IsIndeterminate="True"
                                  Height="64"
                                  Width="64"
                                  Foreground="{ThemeResource SystemAccentColor}" />
                    <TextBlock Text="{Binding Source={StaticResource Strings}, Path=LoadingText}"
                               FontSize="14"
                               TextAlignment="Center"
                               Foreground="{ThemeResource SystemBaseMediumColor}" />
                </StackPanel>

                <!-- Error -->
                <StackPanel Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Padding="24"
                            Spacing="16"
                            MaxWidth="400">
                    <InfoBar IsOpen="True"
                             Severity="Error"
                             Title="{Binding Source={StaticResource Strings}, Path=MessageReportsFailedToLoad}"
                             Message="{Binding ErrorMessage}"
                             IsClosable="False" />
                    <Button Content="{Binding Source={StaticResource Strings}, Path=RetryButton}"
                            Command="{Binding RefreshCommand}"
                            HorizontalAlignment="Center"
                            Style="{ThemeResource AccentButtonStyle}" />
                </StackPanel>

                <!-- Data -->
                <Grid Visibility="{Binding IsDataLoaded, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <controls:DataGrid Grid.Row="0"
                                       Margin="16"
                                       ItemsSource="{Binding Reports}"
                                       AutoGenerateColumns="False"
                                       GridLinesVisibility="None"
                                       HeadersVisibility="Column"
                                       AlternatingRowBackground="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                       CanUserReorderColumns="True"
                                       CanUserResizeColumns="True"
                                       CanUserSortColumns="True"
                                       IsReadOnly="True"
                                       SelectionMode="Single"
                                       HorizontalScrollBarVisibility="Auto"
                                       VerticalScrollBarVisibility="Auto">
                        <controls:DataGrid.Columns>
                            <controls:DataGridTextColumn
                                Header="{Binding Source={StaticResource Strings}, Path=MessageReportsDateColumn}"
                                Binding="{Binding CreatedOnText}"
                                Width="Auto" />
                            <controls:DataGridTextColumn
                                Header="{Binding Source={StaticResource Strings}, Path=MessageReportsReporterColumn}"
                                Binding="{Binding Reporter}"
                                Width="*" />
                            <controls:DataGridTextColumn
                                Header="{Binding Source={StaticResource Strings}, Path=MessageReportsReasonColumn}"
                                Binding="{Binding ReasonText}"
                                Width="Auto" />
                            <controls:DataGridTextColumn
                                Header="{Binding Source={StaticResource Strings}, Path=MessageReportsExplanationColumn}"
                                Binding="{Binding Explanation}"
                                Width="*" />
                            <controls:DataGridTextColumn
                                Header="{Binding Source={StaticResource Strings}, Path=MessageReportsStatusColumn}"
                                Binding="{Binding StatusText}"
                                Width="Auto" />
                            <controls:DataGridTemplateColumn
                                Header="{Binding Source={StaticResource Strings}, Path=MessageReportsActionsColumn}"
                                Width="Auto">
                                <controls:DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="4">
                                            <Button Content="{Binding Source={StaticResource Strings}, Path=MessageReportsViewThreadButton}"
                                                    Visibility="{Binding HasConversation, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Command="{Binding DataContext.OpenConversationCommand, ElementName=PageRoot}"
                                                    CommandParameter="{Binding}"
                                                    Style="{ThemeResource TextBlockButtonStyle}"
                                                    Padding="8,4" />
                                            <Button Content="{Binding Source={StaticResource Strings}, Path=MessageReportsResolveButton}"
                                                    Visibility="{Binding IsResolved, Converter={StaticResource InvertBoolToVisibilityConverter}}"
                                                    Command="{Binding DataContext.ResolveReportCommand, ElementName=PageRoot}"
                                                    CommandParameter="{Binding}"
                                                    Style="{ThemeResource TextBlockButtonStyle}"
                                                    Padding="8,4" />
                                        </StackPanel>
                                    </DataTemplate>
                                </controls:DataGridTemplateColumn.CellTemplate>
                            </controls:DataGridTemplateColumn>
                        </controls:DataGrid.Columns>
                    </controls:DataGrid>

                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Spacing="12"
                                Margin="12">
                        <Button Content="{Binding Source={StaticResource Strings}, Path=MessageReportsPreviousButton}"
                                Command="{Binding PreviousPageCommand}"
                                IsEnabled="{Binding CanGoPrevious}" />
                        <TextBlock Text="{Binding PaginationText}"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource SystemBaseMediumColor}" />
                        <Button Content="{Binding Source={StaticResource Strings}, Path=MessageReportsNextButton}"
                                Command="{Binding NextPageCommand}"
                                IsEnabled="{Binding CanGoNext}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
