<?xml version="1.0"
      encoding="utf-8"?>

<Page x:Class="Marechai.App.Presentation.Views.Admin.AdminGpusPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
      x:Name="PageRoot"
      NavigationCacheMode="Required"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,0,0,1"
              Padding="16,12">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Source={StaticResource Strings}, Path=GpuManagementTitle}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextControlForeground}" />
                <TextBlock Text="{Binding Source={StaticResource Strings}, Path=GpuManagementSubtitle}"
                           FontSize="12"
                           Foreground="{ThemeResource SystemBaseMediumColor}"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="1">

            <!-- Access Denied -->
            <StackPanel Visibility="{Binding IsAdmin, Converter={StaticResource InvertBoolToVisibilityConverter}}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Padding="24"
                        Spacing="16"
                        MaxWidth="400">
                <InfoBar IsOpen="True"
                         Severity="Warning"
                         Title="{Binding Source={StaticResource Strings}, Path=GpuMgmtAccessDeniedTitle}"
                         Message="{Binding Source={StaticResource Strings}, Path=GpuMgmtAccessDeniedMessage}"
                         IsClosable="False" />
            </StackPanel>

            <!-- Content (admin only) -->
            <Grid Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}"
                  Canvas.ZIndex="0">

                <!-- Loading -->
                <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Padding="32"
                            Spacing="16">
                    <ProgressRing IsActive="True"
                                  IsIndeterminate="True"
                                  Height="64"
                                  Width="64"
                                  Foreground="{ThemeResource SystemAccentColor}" />
                    <TextBlock Text="{Binding Source={StaticResource Strings}, Path=LoadingText}"
                               FontSize="14"
                               TextAlignment="Center"
                               Foreground="{ThemeResource SystemBaseMediumColor}" />
                </StackPanel>

                <!-- Error -->
                <StackPanel Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Padding="24"
                            Spacing="16"
                            MaxWidth="400"
                            Canvas.ZIndex="100">
                    <InfoBar IsOpen="True"
                             Severity="Error"
                             Title="{Binding Source={StaticResource Strings}, Path=ErrorTitle}"
                             Message="{Binding ErrorMessage}"
                             IsClosable="False" />
                    <Button Content="{Binding Source={StaticResource Strings}, Path=RetryButton}"
                            Command="{Binding LoadGpusCommand}"
                            HorizontalAlignment="Center"
                            Style="{ThemeResource AccentButtonStyle}" />
                </StackPanel>

                <!-- List View -->
                <Grid Visibility="{Binding IsDataLoaded, Converter={StaticResource BoolToVisibilityConverter}}"
                      Canvas.ZIndex="1">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- GPUs list -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Command Bar -->
                            <CommandBar Grid.Row="0"
                                        DefaultLabelPosition="Right">
                                <AppBarButton Icon="Add"
                                              Label="{Binding Source={StaticResource Strings}, Path=AddGpuButton}"
                                              Command="{Binding OpenAddGpuCommand}" />
                                <AppBarButton Icon="Refresh"
                                              Label="{Binding Source={StaticResource Strings}, Path=RefreshGpusButton}"
                                              Command="{Binding LoadGpusCommand}" />
                            </CommandBar>

                            <!-- Filter -->
                            <AutoSuggestBox Grid.Row="1"
                                            Margin="16,8,16,0"
                                            PlaceholderText="{Binding Source={StaticResource Strings}, Path=GpuSearchPlaceholder}"
                                            QueryIcon="Find"
                                            Text="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            x:Name="FilterBox"
                                            TextChanged="FilterBox_TextChanged" />

                            <!-- DataGrid -->
                            <controls:DataGrid Grid.Row="2"
                                               Margin="16"
                                               ItemsSource="{Binding FilteredGpus}"
                                               SelectedItem="{Binding SelectedGpu, Mode=TwoWay}"
                                               AutoGenerateColumns="False"
                                               GridLinesVisibility="None"
                                               HeadersVisibility="Column"
                                               AlternatingRowBackground="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                               CanUserReorderColumns="True"
                                               CanUserResizeColumns="True"
                                               CanUserSortColumns="True"
                                               IsReadOnly="True"
                                               SelectionMode="Single"
                                               HorizontalScrollBarVisibility="Auto"
                                               VerticalScrollBarVisibility="Auto">
                                <controls:DataGrid.Columns>
                                    <controls:DataGridTextColumn
                                        Header="{Binding Source={StaticResource Strings}, Path=GpuNameColumn}"
                                        Binding="{Binding Name}"
                                        Width="2*" />
                                    <controls:DataGridTextColumn
                                        Header="{Binding Source={StaticResource Strings}, Path=GpuCompanyColumn}"
                                        Binding="{Binding Company}"
                                        Width="*" />
                                    <controls:DataGridTextColumn
                                        Header="{Binding Source={StaticResource Strings}, Path=GpuModelCodeColumn}"
                                        Binding="{Binding ModelCode}"
                                        Width="*" />
                                    <controls:DataGridTemplateColumn
                                        Header="{Binding Source={StaticResource Strings}, Path=ActionsColumn}"
                                        Width="Auto">
                                        <controls:DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal"
                                                            Spacing="4">
                                                    <Button Content="{Binding Source={StaticResource Strings}, Path=EditGpuButton}"
                                                            Command="{Binding DataContext.OpenEditGpuCommand, ElementName=PageRoot}"
                                                            CommandParameter="{Binding}"
                                                            Style="{ThemeResource TextBlockButtonStyle}"
                                                            Padding="8,4" />
                                                    <Button Content="{Binding Source={StaticResource Strings}, Path=DeleteGpuButton}"
                                                            Command="{Binding DataContext.DeleteGpuCommand, ElementName=PageRoot}"
                                                            CommandParameter="{Binding}"
                                                            Foreground="{ThemeResource SystemErrorTextColor}"
                                                            Style="{ThemeResource TextBlockButtonStyle}"
                                                            Padding="8,4" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </controls:DataGridTemplateColumn.CellTemplate>
                                    </controls:DataGridTemplateColumn>
                                </controls:DataGrid.Columns>
                            </controls:DataGrid>
                        </Grid>

                        <!-- Edit Panel -->
                        <Border Grid.Column="1"
                                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}"
                                Width="420"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="1,0,0,0">
                            <Grid RowSpacing="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Edit header -->
                                <Grid Grid.Row="0"
                                      Padding="16,12"
                                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                      BorderThickness="0,0,0,1">
                                    <TextBlock Text="{Binding EditPanelTitle}"
                                               FontSize="18"
                                               FontWeight="SemiBold" />
                                </Grid>

                                <!-- Edit form -->
                                <ScrollViewer Grid.Row="1"
                                              Padding="16"
                                              VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="12">

                                        <!-- Name -->
                                        <TextBox Header="{Binding Source={StaticResource Strings}, Path=GpuNameLabel}"
                                                 Text="{Binding GpuName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="{Binding Source={StaticResource Strings}, Path=GpuNameLabel}" />

                                        <!-- Company -->
                                        <AutoSuggestBox Header="{Binding Source={StaticResource Strings}, Path=GpuCompanyLabel}"
                                                        PlaceholderText="{Binding Source={StaticResource Strings}, Path=CompaniesSearchBox_Placeholder}"
                                                        Text="{Binding CompanySearchText, Mode=TwoWay}"
                                                        QueryIcon="Find"
                                                        x:Name="CompanyFilterBox"
                                                        TextChanged="CompanyFilterBox_TextChanged" />
                                        <ComboBox ItemsSource="{Binding CompanySuggestions}"
                                                  SelectedItem="{Binding SelectedCompany, Mode=TwoWay}"
                                                  DisplayMemberPath="Name"
                                                  HorizontalAlignment="Stretch"
                                                  PlaceholderText="{Binding Source={StaticResource Strings}, Path=GpuCompanyLabel}" />

                                        <!-- Model Code -->
                                        <TextBox Header="{Binding Source={StaticResource Strings}, Path=GpuModelCodeLabel}"
                                                 Text="{Binding ModelCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <!-- Introduced -->
                                        <CalendarDatePicker Header="{Binding Source={StaticResource Strings}, Path=GpuIntroducedLabel}"
                                                            Date="{Binding Introduced, Mode=TwoWay}"
                                                            HorizontalAlignment="Stretch" />

                                        <!-- Package -->
                                        <TextBox Header="{Binding Source={StaticResource Strings}, Path=GpuPackageLabel}"
                                                 Text="{Binding Package, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <!-- Process -->
                                        <TextBox Header="{Binding Source={StaticResource Strings}, Path=GpuProcessLabel}"
                                                 Text="{Binding Process, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <!-- Process (nm) -->
                                        <NumberBox Header="{Binding Source={StaticResource Strings}, Path=GpuProcessNmLabel}"
                                                   Value="{Binding ProcessNm, Mode=TwoWay}"
                                                   SpinButtonPlacementMode="Compact"
                                                   Minimum="0"
                                                   SmallChange="0.1"
                                                   HorizontalAlignment="Stretch" />

                                        <!-- Die Size (mm²) -->
                                        <NumberBox Header="{Binding Source={StaticResource Strings}, Path=GpuDieSizeLabel}"
                                                   Value="{Binding DieSize, Mode=TwoWay}"
                                                   SpinButtonPlacementMode="Compact"
                                                   Minimum="0"
                                                   SmallChange="0.1"
                                                   HorizontalAlignment="Stretch" />

                                        <!-- Transistors -->
                                        <NumberBox Header="{Binding Source={StaticResource Strings}, Path=GpuTransistorsLabel}"
                                                   Value="{Binding Transistors, Mode=TwoWay}"
                                                   SpinButtonPlacementMode="Compact"
                                                   Minimum="1"
                                                   SmallChange="1"
                                                   HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- Edit footer -->
                                <Grid Grid.Row="2"
                                      Padding="16,12"
                                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                      BorderThickness="0,1,0,0"
                                      ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Content="{Binding Source={StaticResource Strings}, Path=CancelButton}"
                                            Command="{Binding CancelEditCommand}"
                                            HorizontalAlignment="Stretch" />
                                    <Button Grid.Column="1"
                                            Content="{Binding Source={StaticResource Strings}, Path=SaveButton}"
                                            Command="{Binding SaveGpuCommand}"
                                            HorizontalAlignment="Stretch"
                                            Style="{ThemeResource AccentButtonStyle}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
