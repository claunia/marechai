<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="Marechai.App.Presentation.Views.Admin.AdminMachinesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
      xmlns:local="using:Marechai.App.Presentation.Views"
      x:Name="PageRoot" NavigationCacheMode="Required"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid RowSpacing="0">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="16,12">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Source={StaticResource Strings}, Path=MachineManagementTitle}" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Source={StaticResource Strings}, Path=MachineManagementSubtitle}" FontSize="12" Foreground="{ThemeResource SystemBaseMediumColor}" Margin="0,4,0,0" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1">
            <StackPanel Visibility="{Binding IsAdmin, Converter={StaticResource InvertBoolToVisibilityConverter}}" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24" Spacing="16" MaxWidth="400">
                <InfoBar IsOpen="True" Severity="Warning" Title="{Binding Source={StaticResource Strings}, Path=MachineMgmtAccessDeniedTitle}" Message="{Binding Source={StaticResource Strings}, Path=MachineMgmtAccessDeniedMessage}" IsClosable="False" />
            </StackPanel>
            <Grid Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}" Canvas.ZIndex="0">
                <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="32" Spacing="16">
                    <ProgressRing IsActive="True" IsIndeterminate="True" Height="64" Width="64" Foreground="{ThemeResource SystemAccentColor}" />
                    <TextBlock Text="{Binding Source={StaticResource Strings}, Path=LoadingText}" FontSize="14" TextAlignment="Center" />
                </StackPanel>
                <StackPanel Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24" Spacing="16" MaxWidth="400" Canvas.ZIndex="100">
                    <InfoBar IsOpen="True" Severity="Error" Title="{Binding Source={StaticResource Strings}, Path=ErrorTitle}" Message="{Binding ErrorMessage}" IsClosable="False" />
                    <Button Content="{Binding Source={StaticResource Strings}, Path=RetryButton}" Command="{Binding LoadItemsCommand}" HorizontalAlignment="Center" Style="{ThemeResource AccentButtonStyle}" />
                </StackPanel>
                <Grid Visibility="{Binding IsDataLoaded, Converter={StaticResource BoolToVisibilityConverter}}" Canvas.ZIndex="1">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Grid Grid.Column="0"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <CommandBar Grid.Row="0" DefaultLabelPosition="Right">
                                <AppBarButton Icon="Add" Label="{Binding Source={StaticResource Strings}, Path=AddMachineButton}" Command="{Binding OpenAddCommand}" />
                                <AppBarButton Icon="Refresh" Label="{Binding Source={StaticResource Strings}, Path=RefreshMachinesButton}" Command="{Binding LoadItemsCommand}" />
                            </CommandBar>
                            <AutoSuggestBox Grid.Row="1" Margin="16,8,16,0" PlaceholderText="{Binding Source={StaticResource Strings}, Path=MachineSearchPlaceholder}" QueryIcon="Find" Text="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" x:Name="FilterBox" TextChanged="FilterBox_TextChanged" />
                            <controls:DataGrid Grid.Row="2" Margin="16" ItemsSource="{Binding FilteredMachines}" SelectedItem="{Binding SelectedMachine, Mode=TwoWay}" AutoGenerateColumns="False" GridLinesVisibility="None" HeadersVisibility="Column" AlternatingRowBackground="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CanUserReorderColumns="True" CanUserResizeColumns="True" CanUserSortColumns="True" IsReadOnly="True" SelectionMode="Single" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <controls:DataGrid.Columns>
                                    <controls:DataGridTextColumn Header="{Binding Source={StaticResource Strings}, Path=MachineNameColumn}" Binding="{Binding Name}" Width="2*" />
                                    <controls:DataGridTextColumn Header="{Binding Source={StaticResource Strings}, Path=MachineCompanyColumn}" Binding="{Binding Company}" Width="*" />
                                    <controls:DataGridTextColumn Header="{Binding Source={StaticResource Strings}, Path=MachineModelColumn}" Binding="{Binding Model}" Width="*" />
                                    <controls:DataGridTemplateColumn Header="{Binding Source={StaticResource Strings}, Path=ActionsColumn}" Width="Auto">
                                        <controls:DataGridTemplateColumn.CellTemplate><DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <Button Content="&#xE70F;"
                                                            ToolTipService.ToolTip="{Binding Source={StaticResource Strings}, Path=EditMachineButton}" Command="{Binding DataContext.OpenEditCommand, ElementName=PageRoot}" CommandParameter="{Binding}" Style="{StaticResource AdminGridActionButtonStyle}" />
                                                <Button ToolTipService.ToolTip="{Binding Source={StaticResource Strings}, Path=DescriptionButton}"
                                                        Command="{Binding DataContext.OpenDescriptionCommand, ElementName=PageRoot}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource AdminGridActionButtonStyle}">
                                                    <SymbolIcon Symbol="Document" />
                                                </Button>
                                                <Button Content="&#xE91B;"
                                                            ToolTipService.ToolTip="{Binding Source={StaticResource Strings}, Path=PhotosButton}" Command="{Binding DataContext.OpenPhotosCommand, ElementName=PageRoot}" CommandParameter="{Binding}" Style="{StaticResource AdminGridActionButtonStyle}" />
                                                <Button Content="&#xE714;"
                                                            ToolTipService.ToolTip="{Binding Source={StaticResource Strings}, Path=VideosButton}" Command="{Binding DataContext.OpenVideosCommand, ElementName=PageRoot}" CommandParameter="{Binding}" Style="{StaticResource AdminGridActionButtonStyle}" />
                                                <Button Content="&#xE91B;"
                                                            ToolTipService.ToolTip="{Binding Source={StaticResource Strings}, Path=PromoArtButton}" Command="{Binding DataContext.OpenPromoArtCommand, ElementName=PageRoot}" CommandParameter="{Binding}" Style="{StaticResource AdminGridActionButtonStyle}" />
                                                <Button Content="&#xE74D;"
                                                            ToolTipService.ToolTip="{Binding Source={StaticResource Strings}, Path=DeleteMachineButton}" Command="{Binding DataContext.DeleteCommand, ElementName=PageRoot}" CommandParameter="{Binding}" Style="{StaticResource AdminGridDestructiveActionButtonStyle}" />
                                            </StackPanel>
                                        </DataTemplate></controls:DataGridTemplateColumn.CellTemplate>
                                    </controls:DataGridTemplateColumn>
                                </controls:DataGrid.Columns>
                            </controls:DataGrid>
                        </Grid>

                        <!-- Edit Panel -->
                        <Border Grid.Column="1" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}" Width="500" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
                            <Grid RowSpacing="0"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid Grid.Row="0" Padding="16,12" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                    <TextBlock Text="{Binding EditPanelTitle}" FontSize="18" FontWeight="SemiBold" />
                                </Grid>
                                <ScrollViewer Grid.Row="1" Padding="16" VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="12">
                                        <!-- Basic Info -->
                                        <TextBlock Text="{Binding Source={StaticResource Strings}, Path=MachineBasicInfoHeader}" FontSize="14" FontWeight="SemiBold" />
                                        <TextBox Header="{Binding Source={StaticResource Strings}, Path=MachineNameLabel}" Text="{Binding MachineName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Header="{Binding Source={StaticResource Strings}, Path=MachineModelLabel}" Text="{Binding Model, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <ComboBox Header="{Binding Source={StaticResource Strings}, Path=MachineTypeLabel}" ItemsSource="{Binding MachineTypeItems}" SelectedIndex="{Binding MachineTypeIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                                        <CalendarDatePicker Header="{Binding Source={StaticResource Strings}, Path=MachineIntroducedLabel}" Date="{Binding Introduced, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                                        <ComboBox Header="{Binding Source={StaticResource Strings}, Path=DatePrecisionLabel}"
                                                  SelectedIndex="{Binding IntroducedPrecision, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="{Binding Source={StaticResource Strings}, Path=DatePrecisionFull}" />
                                            <ComboBoxItem Content="{Binding Source={StaticResource Strings}, Path=DatePrecisionMonthYear}" />
                                            <ComboBoxItem Content="{Binding Source={StaticResource Strings}, Path=DatePrecisionYearOnly}" />
                                        </ComboBox>
                                        <AutoSuggestBox Header="{Binding Source={StaticResource Strings}, Path=MachineCompanyLabel}" PlaceholderText="{Binding Source={StaticResource Strings}, Path=CompaniesSearchBox_Placeholder}" Text="{Binding CompanySearchText, Mode=TwoWay}" QueryIcon="Find" x:Name="CompanyFilterBox" TextChanged="CompanyFilterBox_TextChanged" />
                                        <ComboBox ItemsSource="{Binding CompanySuggestions}" SelectedItem="{Binding SelectedCompany, Mode=TwoWay}" DisplayMemberPath="Name" HorizontalAlignment="Stretch" PlaceholderText="{Binding Source={StaticResource Strings}, Path=MachineCompanyLabel}" />
                                        <ComboBox Header="{Binding Source={StaticResource Strings}, Path=MachineFamilyLabel}" ItemsSource="{Binding Families}" SelectedItem="{Binding SelectedFamily, Mode=TwoWay}" DisplayMemberPath="Name" HorizontalAlignment="Stretch" />

                                        <!-- Junction sections (only visible when editing existing machine) -->
                                        <StackPanel Visibility="{Binding IsEditingExisting, Converter={StaticResource BoolToVisibilityConverter}}" Spacing="12">

                                        <!-- GPUs -->
                                        <TextBlock Text="{Binding Source={StaticResource Strings}, Path=MachineGpusHeader}" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0" />
                                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <ComboBox Grid.Column="0" ItemsSource="{Binding AvailableGpus}" SelectedItem="{Binding SelectedAvailableGpu, Mode=TwoWay}" DisplayMemberPath="Name" HorizontalAlignment="Stretch" />
                                            <Button Grid.Column="1" Content="+" Command="{Binding AddGpuCommand}" VerticalAlignment="Bottom" Padding="10,6" />
                                        </Grid>
                                        <ItemsRepeater ItemsSource="{Binding MachineGpuDisplays}"><ItemsRepeater.ItemTemplate><DataTemplate><Grid Margin="0,2" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Content="X" Command="{Binding DataContext.RemoveGpuCommand, ElementName=PageRoot}" CommandParameter="{Binding}" Foreground="{ThemeResource SystemErrorTextColor}" Style="{ThemeResource TextBlockButtonStyle}" Padding="6,2" />
                                        </Grid></DataTemplate></ItemsRepeater.ItemTemplate></ItemsRepeater>

                                        <!-- Processors -->
                                        <TextBlock Text="{Binding Source={StaticResource Strings}, Path=MachineProcessorsHeader}" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0" />
                                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <ComboBox Grid.Column="0" ItemsSource="{Binding AvailableProcessors}" SelectedItem="{Binding SelectedAvailableProcessor, Mode=TwoWay}" DisplayMemberPath="Name" HorizontalAlignment="Stretch" />
                                            <NumberBox Grid.Column="1" PlaceholderText="MHz" Value="{Binding ProcessorSpeed, Mode=TwoWay}" SpinButtonPlacementMode="Compact" Minimum="0" SmallChange="1" />
                                            <Button Grid.Column="2" Content="+" Command="{Binding AddProcessorCommand}" VerticalAlignment="Bottom" Padding="10,6" />
                                        </Grid>
                                        <ItemsRepeater ItemsSource="{Binding MachineProcessorDisplays}"><ItemsRepeater.ItemTemplate><DataTemplate><Grid Margin="0,2" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Content="X" Command="{Binding DataContext.RemoveProcessorCommand, ElementName=PageRoot}" CommandParameter="{Binding}" Foreground="{ThemeResource SystemErrorTextColor}" Style="{ThemeResource TextBlockButtonStyle}" Padding="6,2" />
                                        </Grid></DataTemplate></ItemsRepeater.ItemTemplate></ItemsRepeater>

                                        <!-- Sound Synths -->
                                        <TextBlock Text="{Binding Source={StaticResource Strings}, Path=MachineSoundsHeader}" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0" />
                                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <ComboBox Grid.Column="0" ItemsSource="{Binding AvailableSounds}" SelectedItem="{Binding SelectedAvailableSound, Mode=TwoWay}" DisplayMemberPath="Name" HorizontalAlignment="Stretch" />
                                            <Button Grid.Column="1" Content="+" Command="{Binding AddSoundCommand}" VerticalAlignment="Bottom" Padding="10,6" />
                                        </Grid>
                                        <ItemsRepeater ItemsSource="{Binding MachineSoundDisplays}"><ItemsRepeater.ItemTemplate><DataTemplate><Grid Margin="0,2" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Content="X" Command="{Binding DataContext.RemoveSoundCommand, ElementName=PageRoot}" CommandParameter="{Binding}" Foreground="{ThemeResource SystemErrorTextColor}" Style="{ThemeResource TextBlockButtonStyle}" Padding="6,2" />
                                        </Grid></DataTemplate></ItemsRepeater.ItemTemplate></ItemsRepeater>

                                        <!-- Screens -->
                                        <TextBlock Text="{Binding Source={StaticResource Strings}, Path=MachineScreensHeader}" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0" />
                                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <ComboBox Grid.Column="0" ItemsSource="{Binding AvailableScreens}" SelectedItem="{Binding SelectedAvailableScreen, Mode=TwoWay}" DisplayMemberPath="Type" HorizontalAlignment="Stretch" />
                                            <Button Grid.Column="1" Content="+" Command="{Binding AddScreenCommand}" VerticalAlignment="Bottom" Padding="10,6" />
                                        </Grid>
                                        <ItemsRepeater ItemsSource="{Binding MachineScreenDisplays}"><ItemsRepeater.ItemTemplate><DataTemplate><Grid Margin="0,2" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Content="X" Command="{Binding DataContext.RemoveScreenCommand, ElementName=PageRoot}" CommandParameter="{Binding}" Foreground="{ThemeResource SystemErrorTextColor}" Style="{ThemeResource TextBlockButtonStyle}" Padding="6,2" />
                                        </Grid></DataTemplate></ItemsRepeater.ItemTemplate></ItemsRepeater>

                                        <!-- Memory -->
                                        <TextBlock Text="{Binding Source={StaticResource Strings}, Path=MachineMemoryHeader}" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0" />
                                        <Grid ColumnSpacing="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <ComboBox Grid.Column="0" ItemsSource="{Binding MemoryTypeItems}" SelectedIndex="{Binding MemoryTypeIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding MemoryUsageItems}" SelectedIndex="{Binding MemoryUsageIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                                            <NumberBox Grid.Column="2" PlaceholderText="Bytes" Value="{Binding MemorySize, Mode=TwoWay}" SpinButtonPlacementMode="Compact" Minimum="0" SmallChange="1024" />
                                            <Button Grid.Column="3" Content="+" Command="{Binding AddMemoryCommand}" VerticalAlignment="Bottom" Padding="10,6" />
                                        </Grid>
                                        <ItemsRepeater ItemsSource="{Binding MachineMemoryDisplays}"><ItemsRepeater.ItemTemplate><DataTemplate><Grid Margin="0,2" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Content="X" Command="{Binding DataContext.RemoveMemoryCommand, ElementName=PageRoot}" CommandParameter="{Binding}" Foreground="{ThemeResource SystemErrorTextColor}" Style="{ThemeResource TextBlockButtonStyle}" Padding="6,2" />
                                        </Grid></DataTemplate></ItemsRepeater.ItemTemplate></ItemsRepeater>

                                        <!-- Storage -->
                                        <TextBlock Text="{Binding Source={StaticResource Strings}, Path=MachineStorageHeader}" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0" />
                                        <Grid ColumnSpacing="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <ComboBox Grid.Column="0" ItemsSource="{Binding StorageTypeItems}" SelectedIndex="{Binding StorageTypeIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding StorageInterfaceItems}" SelectedIndex="{Binding StorageInterfaceIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                                            <NumberBox Grid.Column="2" PlaceholderText="Bytes" Value="{Binding StorageCapacity, Mode=TwoWay}" SpinButtonPlacementMode="Compact" Minimum="0" SmallChange="1048576" />
                                            <Button Grid.Column="3" Content="+" Command="{Binding AddStorageCommand}" VerticalAlignment="Bottom" Padding="10,6" />
                                        </Grid>
                                        <ItemsRepeater ItemsSource="{Binding MachineStorageDisplays}"><ItemsRepeater.ItemTemplate><DataTemplate><Grid Margin="0,2" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Content="X" Command="{Binding DataContext.RemoveStorageCommand, ElementName=PageRoot}" CommandParameter="{Binding}" Foreground="{ThemeResource SystemErrorTextColor}" Style="{ThemeResource TextBlockButtonStyle}" Padding="6,2" />
                                        </Grid></DataTemplate></ItemsRepeater.ItemTemplate></ItemsRepeater>

                                        <!-- Software Platforms -->
                                        <TextBlock Text="{Binding Source={StaticResource Strings}, Path=MachineSoftwarePlatformsHeader}" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0" />
                                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <ComboBox Grid.Column="0" ItemsSource="{Binding AvailableSoftwarePlatforms}" SelectedItem="{Binding SelectedAvailableSoftwarePlatform, Mode=TwoWay}" DisplayMemberPath="Name" HorizontalAlignment="Stretch" />
                                            <Button Grid.Column="1" Content="+" Command="{Binding AddSoftwarePlatformCommand}" VerticalAlignment="Bottom" Padding="10,6" />
                                        </Grid>
                                        <ItemsRepeater ItemsSource="{Binding MachineSoftwarePlatformDisplays}"><ItemsRepeater.ItemTemplate><DataTemplate><Grid Margin="0,2" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Content="X" Command="{Binding DataContext.RemoveSoftwarePlatformCommand, ElementName=PageRoot}" CommandParameter="{Binding}" Foreground="{ThemeResource SystemErrorTextColor}" Style="{ThemeResource TextBlockButtonStyle}" Padding="6,2" />
                                        </Grid></DataTemplate></ItemsRepeater.ItemTemplate></ItemsRepeater>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                                <Grid Grid.Row="2" Padding="16,12" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="{Binding Source={StaticResource Strings}, Path=CancelButton}" Command="{Binding CancelEditCommand}" HorizontalAlignment="Stretch" />
                                    <Button Grid.Column="1" Content="{Binding Source={StaticResource Strings}, Path=SaveButton}" Command="{Binding SaveCommand}" HorizontalAlignment="Stretch" Style="{ThemeResource AccentButtonStyle}" />
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Description Panel -->
                        <Border Grid.Column="1"
                                Visibility="{Binding IsEditingDescription, Converter={StaticResource BoolToVisibilityConverter}}"
                                Width="560"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="1,0,0,0">
                            <Grid RowSpacing="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0"
                                      Padding="16,12"
                                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                      BorderThickness="0,0,0,1">
                                    <TextBlock Text="{Binding Source={StaticResource Strings}, Path=DescriptionDialogTitle}"
                                               FontSize="18"
                                               FontWeight="SemiBold" />
                                </Grid>

                                <StackPanel Grid.Row="1"
                                            Padding="16,8"
                                            Spacing="4"
                                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                            BorderThickness="0,0,0,1">
                                    <TextBlock Text="{Binding Source={StaticResource Strings}, Path=LanguageLabel}"
                                               FontWeight="SemiBold" />
                                    <ComboBox ItemsSource="{Binding AvailableLanguages}"
                                              SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch"
                                              DisplayMemberPath="DisplayName" />
                                </StackPanel>

                                <StackPanel Grid.Row="2"
                                            Padding="16,8"
                                            Spacing="4"
                                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                            BorderThickness="0,0,0,1">
                                    <TextBlock Text="{Binding Source={StaticResource Strings}, Path=ExistingTranslationsLabel}"
                                               FontWeight="SemiBold" />
                                    <ItemsRepeater ItemsSource="{Binding ExistingTranslations}">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Spacing="4" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Language}"
                                                               VerticalAlignment="Center" />
                                                    <Button Grid.Column="1"
                                                            Content="✏️"
                                                            Command="{Binding DataContext.EditTranslationCommand, ElementName=PageRoot}"
                                                            CommandParameter="{Binding}"
                                                            Padding="4,2"
                                                            Style="{ThemeResource TextBlockButtonStyle}" />
                                                    <Button Grid.Column="2"
                                                            Content="🗑️"
                                                            Command="{Binding DataContext.DeleteTranslationCommand, ElementName=PageRoot}"
                                                            CommandParameter="{Binding}"
                                                            Padding="4,2"
                                                            Style="{ThemeResource TextBlockButtonStyle}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </StackPanel>

                                <Grid Grid.Row="3"
                                      Margin="16"
                                      RowSpacing="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0"
                                                Spacing="6">
                                        <TextBlock Text="{Binding Source={StaticResource Strings}, Path=MarkdownSourceLabel}"
                                                   FontWeight="SemiBold" />
                                        <Border MinHeight="180"
                                                Padding="1"
                                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                            <TextBox Text="{Binding DescriptionMarkdown, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     PlaceholderText="{Binding Source={StaticResource Strings}, Path=DescriptionMarkdownPlaceholder}"
                                                     VerticalAlignment="Stretch"
                                                     HorizontalAlignment="Stretch"
                                                     BorderThickness="0"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1"
                                                Spacing="6">
                                        <TextBlock Text="{Binding Source={StaticResource Strings}, Path=MarkdownPreviewLabel}"
                                                   FontWeight="SemiBold" />
                                        <Border MinHeight="180"
                                                Padding="12"
                                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <local:MessageMarkdownView Markdown="{Binding DescriptionMarkdown}" />
                                            </ScrollViewer>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="4"
                                      Padding="16,12"
                                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                      BorderThickness="0,1,0,0"
                                      ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Content="{Binding Source={StaticResource Strings}, Path=CancelButton}"
                                            Command="{Binding CancelDescriptionCommand}"
                                            HorizontalAlignment="Stretch" />
                                    <Button Grid.Column="1"
                                            Content="{Binding Source={StaticResource Strings}, Path=SaveButton}"
                                            Command="{Binding SaveDescriptionCommand}"
                                            IsEnabled="{Binding CanSaveDescription}"
                                            HorizontalAlignment="Stretch"
                                            Style="{ThemeResource AccentButtonStyle}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
