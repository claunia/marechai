<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="Marechai.App.Presentation.Views.Admin.AdminWwpcImportsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
      x:Name="PageRoot"
      NavigationCacheMode="Disabled"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,0,0,1"
              Padding="16,12">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Source={StaticResource Strings}, Path=WwpcImportsTitle}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextControlForeground}" />
                <TextBlock Text="{Binding Source={StaticResource Strings}, Path=WwpcImportsSubtitle}"
                           FontSize="12"
                           Foreground="{ThemeResource SystemBaseMediumColor}"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <StackPanel Visibility="{Binding IsAdmin, Converter={StaticResource InvertBoolToVisibilityConverter}}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Padding="24"
                        Spacing="16"
                        MaxWidth="400">
                <InfoBar IsOpen="True"
                         Severity="Warning"
                         Title="{Binding Source={StaticResource Strings}, Path=AccessDeniedTitle}"
                         Message="{Binding Source={StaticResource Strings}, Path=AccessDeniedMessage}"
                         IsClosable="False" />
            </StackPanel>

            <Grid Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Padding="32"
                            Spacing="16">
                    <ProgressRing IsActive="True"
                                  IsIndeterminate="True"
                                  Height="64"
                                  Width="64"
                                  Foreground="{ThemeResource SystemAccentColor}" />
                    <TextBlock Text="{Binding Source={StaticResource Strings}, Path=LoadingText}"
                               FontSize="14"
                               TextAlignment="Center"
                               Foreground="{ThemeResource SystemBaseMediumColor}" />
                </StackPanel>

                <StackPanel Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Padding="24"
                            Spacing="16"
                            MaxWidth="400">
                    <InfoBar IsOpen="True"
                             Severity="Error"
                             Title="{Binding Source={StaticResource Strings}, Path=ErrorTitle}"
                             Message="{Binding ErrorMessage}"
                             IsClosable="False" />
                    <Button Content="{Binding Source={StaticResource Strings}, Path=RetryButton}"
                            Command="{Binding LoadCommand}"
                            HorizontalAlignment="Center"
                            Style="{ThemeResource AccentButtonStyle}" />
                </StackPanel>

                <Grid Visibility="{Binding IsDataLoaded, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <CommandBar Grid.Row="0" DefaultLabelPosition="Right">
                        <AppBarButton Icon="Refresh"
                                      Label="{Binding Source={StaticResource Strings}, Path=RefreshButton}"
                                      Command="{Binding LoadCommand}" />
                    </CommandBar>

                    <StackPanel Grid.Row="1" Padding="16,12" Spacing="12">
                        <InfoBar IsOpen="True"
                                 Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}"
                                 Severity="{Binding StatusIsSuccess, Converter={StaticResource BoolToInfoBarSeverityConverter}}"
                                 Title="{Binding Source={StaticResource Strings}, Path=WwpcImportsStatusTitle}"
                                 Message="{Binding StatusMessage}"
                                 IsClosable="True"
                                 CloseButtonCommand="{Binding ClearStatusMessageCommand}" />

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <ComboBox Grid.Column="0"
                                      Header="{Binding Source={StaticResource Strings}, Path=StatusText}"
                                      ItemsSource="{Binding StatusOptions}"
                                      SelectedItem="{Binding SelectedStatusOption, Mode=TwoWay}"
                                      DisplayMemberPath="Label" />

                            <ComboBox Grid.Column="1"
                                      Header="{Binding Source={StaticResource Strings}, Path=WwpcSectionLabel}"
                                      ItemsSource="{Binding ProductTypeOptions}"
                                      SelectedItem="{Binding SelectedProductTypeOption, Mode=TwoWay}"
                                      DisplayMemberPath="Label" />

                            <CheckBox Grid.Column="2"
                                      Content="{Binding Source={StaticResource Strings}, Path=WwpcHasErrorLabel}"
                                      IsChecked="{Binding HasEnrichmentError, Mode=TwoWay}"
                                      VerticalAlignment="Bottom"
                                      Margin="0,0,0,6" />

                            <TextBox Grid.Column="3"
                                     Header="{Binding Source={StaticResource Strings}, Path=SearchPlaceholder}"
                                     Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </StackPanel>

                    <controls:DataGrid Grid.Row="2"
                                       Margin="16"
                                       AutoGenerateColumns="False"
                                       ItemsSource="{Binding FilteredImports}"
                                       SelectedItem="{Binding SelectedImport, Mode=TwoWay}"
                                       CanUserReorderColumns="True"
                                       CanUserResizeColumns="True"
                                       CanUserSortColumns="True"
                                       IsReadOnly="True"
                                       HeadersVisibility="Column"
                                       GridLinesVisibility="None"
                                       AlternatingRowBackground="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                        <controls:DataGrid.Columns>
                            <controls:DataGridTemplateColumn Header="{Binding Source={StaticResource Strings}, Path=NameColumn_Header}" Width="2*">
                                <controls:DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding RawCategoriesCsv}"
                                                       FontSize="11"
                                                       Foreground="{ThemeResource SystemBaseMediumColor}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </controls:DataGridTemplateColumn.CellTemplate>
                            </controls:DataGridTemplateColumn>
                            <controls:DataGridTextColumn Header="{Binding Source={StaticResource Strings}, Path=CompanyLabel}"
                                                         Binding="{Binding VendorName}"
                                                         Width="*" />
                            <controls:DataGridTemplateColumn Header="{Binding Source={StaticResource Strings}, Path=WwpcSectionLabel}" Width="Auto">
                                <controls:DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ProductTypeLabel}" />
                                    </DataTemplate>
                                </controls:DataGridTemplateColumn.CellTemplate>
                            </controls:DataGridTemplateColumn>
                            <controls:DataGridTextColumn Header="{Binding Source={StaticResource Strings}, Path=WwpcVersionsColumn}"
                                                         Binding="{Binding VersionCount}"
                                                         Width="Auto" />
                            <controls:DataGridTextColumn Header="{Binding Source={StaticResource Strings}, Path=WwpcScreenshotsColumn}"
                                                         Binding="{Binding ScreenshotCount}"
                                                         Width="Auto" />
                            <controls:DataGridTemplateColumn Header="{Binding Source={StaticResource Strings}, Path=StatusText}" Width="Auto">
                                <controls:DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StatusLabel}" />
                                    </DataTemplate>
                                </controls:DataGridTemplateColumn.CellTemplate>
                            </controls:DataGridTemplateColumn>
                            <controls:DataGridTextColumn Header="{Binding Source={StaticResource Strings}, Path=WwpcCrawledColumn}"
                                                         Binding="{Binding CrawledOn}"
                                                         Width="Auto" />
                            <controls:DataGridTemplateColumn Header="{Binding Source={StaticResource Strings}, Path=ErrorTitle}" Width="*">
                                <controls:DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding LastError}"
                                                   Foreground="{ThemeResource SystemErrorTextColor}"
                                                   TextWrapping="Wrap"
                                                   MaxLines="2" />
                                    </DataTemplate>
                                </controls:DataGridTemplateColumn.CellTemplate>
                            </controls:DataGridTemplateColumn>
                            <controls:DataGridTemplateColumn Header="{Binding Source={StaticResource Strings}, Path=ActionsColumn}" Width="2*">
                                <controls:DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <Button Content="{Binding Source={StaticResource Strings}, Path=WwpcReviewButton}"
                                                    Command="{Binding DataContext.ReviewCommand, ElementName=PageRoot}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding CanReview, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Style="{ThemeResource AccentButtonStyle}"
                                                    Padding="8,4" />
                                            <Button Content="{Binding Source={StaticResource Strings}, Path=WwpcDuplicateButton}"
                                                    Click="Duplicate_Click"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding CanReview, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Padding="8,4" />
                                            <Button Content="{Binding Source={StaticResource Strings}, Path=WwpcRejectButton}"
                                                    Click="Reject_Click"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding CanReject, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Foreground="{ThemeResource SystemErrorTextColor}"
                                                    Padding="8,4" />
                                            <HyperlinkButton Content="{Binding Source={StaticResource Strings}, Path=WwpcOpenSourceButton}"
                                                             Click="OpenSource_Click"
                                                             CommandParameter="{Binding}"
                                                             Visibility="{Binding CanReview, Converter={StaticResource InvertBoolToVisibilityConverter}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </controls:DataGridTemplateColumn.CellTemplate>
                            </controls:DataGridTemplateColumn>
                        </controls:DataGrid.Columns>
                    </controls:DataGrid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
