<?xml version="1.0"
      encoding="utf-8"?>

<Page x:Class="Marechai.App.Presentation.Views.Admin.AdminProcessorPhotosPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:models="using:Marechai.App.Presentation.Models"
      x:Name="PageRoot"
      NavigationCacheMode="Required"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,0,0,1"
              Padding="16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Content="&#xE72B;"
                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                    Command="{Binding GoBackCommand}"
                    Style="{ThemeResource TextBlockButtonStyle}"
                    Padding="8,4"
                    VerticalAlignment="Center"
                    Margin="0,0,12,0" />
            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center">
                <TextBlock FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextControlForeground}">
                    <Run Text="{Binding Source={StaticResource Strings}, Path=ProcessorPhotosTitle}" />
                    <Run Text=" - " />
                    <Run Text="{Binding ProcessorName}" />
                </TextBlock>
                <TextBlock Text="{Binding Source={StaticResource Strings}, Path=ProcessorPhotosSubtitle}"
                           FontSize="12"
                           Foreground="{ThemeResource SystemBaseMediumColor}"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">

            <StackPanel Visibility="{Binding IsAdmin, Converter={StaticResource InvertBoolToVisibilityConverter}}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Padding="24"
                        Spacing="16"
                        MaxWidth="400">
                <InfoBar IsOpen="True"
                         Severity="Warning"
                         Title="{Binding Source={StaticResource Strings}, Path=ProcessorPhotosMgmtAccessDeniedTitle}"
                         Message="{Binding Source={StaticResource Strings}, Path=ProcessorPhotosMgmtAccessDeniedMessage}"
                         IsClosable="False" />
            </StackPanel>

            <Grid Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}"
                  Canvas.ZIndex="0">

                <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Padding="32"
                            Spacing="16">
                    <ProgressRing IsActive="True"
                                  IsIndeterminate="True"
                                  Height="64"
                                  Width="64"
                                  Foreground="{ThemeResource SystemAccentColor}" />
                    <TextBlock Text="{Binding Source={StaticResource Strings}, Path=LoadingText}"
                               FontSize="14"
                               TextAlignment="Center"
                               Foreground="{ThemeResource SystemBaseMediumColor}" />
                </StackPanel>

                <StackPanel Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Padding="24"
                            Spacing="16"
                            MaxWidth="400"
                            Canvas.ZIndex="100">
                    <InfoBar IsOpen="True"
                             Severity="Error"
                             Title="{Binding Source={StaticResource Strings}, Path=ErrorTitle}"
                             Message="{Binding ErrorMessage}"
                             IsClosable="False" />
                    <Button Content="{Binding Source={StaticResource Strings}, Path=RetryButton}"
                            Command="{Binding LoadPhotosCommand}"
                            HorizontalAlignment="Center"
                            Style="{ThemeResource AccentButtonStyle}" />
                </StackPanel>

                <Grid Visibility="{Binding IsDataLoaded, Converter={StaticResource BoolToVisibilityConverter}}"
                      Canvas.ZIndex="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <CommandBar Grid.Row="0"
                                DefaultLabelPosition="Right">
                        <AppBarButton Icon="Refresh"
                                      Label="{Binding Source={StaticResource Strings}, Path=RefreshButton}"
                                      Command="{Binding LoadPhotosCommand}" />
                    </CommandBar>

                    <InfoBar Grid.Row="1"
                             Margin="16,12,16,0"
                             IsOpen="{Binding HasStatusMessage}"
                             Severity="{Binding StatusSeverity}"
                             Message="{Binding StatusMessage}"
                             IsClosable="False" />

                    <Border Grid.Row="2"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="16,12"
                            Margin="0,12,0,0">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="12"
                                  RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Column="0"
                                            Grid.Row="0"
                                            Spacing="4">
                                    <TextBlock Text="{Binding Source={StaticResource Strings}, Path=ProcessorPhotosBatchSectionTitle}"
                                               FontSize="16"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Source={StaticResource Strings}, Path=ProcessorPhotosBatchSectionSubtitle}"
                                               TextWrapping="Wrap"
                                               Foreground="{ThemeResource SystemBaseMediumColor}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1"
                                            Grid.Row="0"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <Button Content="{Binding Source={StaticResource Strings}, Path=ProcessorPhotosAddImagesButton}"
                                            Command="{Binding AddPhotosCommand}"
                                            Style="{ThemeResource AccentButtonStyle}"
                                            IsEnabled="{Binding CanAddMorePhotos}" />
                                    <Button Content="{Binding Source={StaticResource Strings}, Path=ProcessorPhotosClearStagedButton}"
                                            Command="{Binding ClearStagedPhotosCommand}"
                                            IsEnabled="{Binding CanClearStaged}" />
                                </StackPanel>

                                <StackPanel Grid.Column="0"
                                            Grid.Row="1"
                                            Orientation="Horizontal"
                                            Spacing="12">
                                    <ComboBox ItemsSource="{Binding Licenses}"
                                              SelectedItem="{Binding SelectedLicense, Mode=TwoWay}"
                                              DisplayMemberPath="Name"
                                              PlaceholderText="{Binding Source={StaticResource Strings}, Path=SelectLicenseLabel}"
                                              MinWidth="220" />
                                    <TextBlock VerticalAlignment="Center"
                                               Foreground="{ThemeResource SystemBaseMediumColor}">
                                        <Run Text="{Binding StagedPhotos.Count}" />
                                        <Run Text="/" />
                                        <Run Text="25" />
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Grid.Column="1"
                                            Grid.Row="1"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            HorizontalAlignment="Right">
                                    <Button Content="{Binding Source={StaticResource Strings}, Path=ProcessorPhotosSubmitBatchButton}"
                                            Command="{Binding SubmitBatchCommand}"
                                            Style="{ThemeResource AccentButtonStyle}"
                                            IsEnabled="{Binding CanSubmitBatch}" />
                                </StackPanel>
                            </Grid>

                            <InfoBar IsOpen="{Binding ShowBatchProgress}"
                                     Severity="Informational"
                                     Title="{Binding Source={StaticResource Strings}, Path=ProcessorPhotosProcessingTitle}"
                                     Message="{Binding BatchProgressText}"
                                     IsClosable="False" />

                            <ProgressBar Visibility="{Binding ShowBatchProgress, Converter={StaticResource BoolToVisibilityConverter}}"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{Binding BatchProgressPercent}"
                                         Height="8" />

                            <InfoBar IsOpen="{Binding ShowBatchSummary}"
                                     Severity="{Binding StatusSeverity}"
                                     Message="{Binding StatusMessage}"
                                     IsClosable="False" />
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="3"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="16,12,16,0"
                                  MaxHeight="360">
                        <StackPanel>
                            <InfoBar IsOpen="{Binding HasStagedPhotos, Converter={StaticResource InvertBoolConverter}}"
                                     Severity="Informational"
                                     Message="{Binding Source={StaticResource Strings}, Path=ProcessorPhotosNoImagesStaged}"
                                     IsClosable="False" />

                            <ItemsRepeater ItemsSource="{Binding StagedPhotos}"
                                           Visibility="{Binding HasStagedPhotos, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout MinItemWidth="250"
                                                       MinItemHeight="320"
                                                       MinColumnSpacing="16"
                                                       MinRowSpacing="16"
                                                       ItemsStretch="Fill" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="models:AdminMachinePhotoStagedItem">
                                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="12">
                                            <Grid RowSpacing="8">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>

                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{x:Bind FileName}"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <Button Grid.Column="1"
                                                            Content="&#xE711;"
                                                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                            Command="{Binding DataContext.RemoveStagedPhotoCommand, ElementName=PageRoot}"
                                                            CommandParameter="{Binding}"
                                                            IsEnabled="{x:Bind CanRemove}"
                                                            Style="{ThemeResource TextBlockButtonStyle}"
                                                            Padding="4,0" />
                                                </Grid>

                                                <Border Grid.Row="1"
                                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                        CornerRadius="6"
                                                        Height="160">
                                                    <Grid>
                                                        <Image Source="{x:Bind ThumbnailImageSource}"
                                                               Stretch="Uniform"
                                                               Visibility="{x:Bind ShowThumbnail, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                        <ProgressRing IsActive="True"
                                                                      Width="32"
                                                                      Height="32"
                                                                      Visibility="{x:Bind ShowProgress, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                        <TextBlock Text="{Binding Source={StaticResource Strings}, Path=ProcessorPhotosPreviewUnavailable}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{ThemeResource SystemBaseMediumColor}"
                                                                   TextWrapping="Wrap"
                                                                   TextAlignment="Center"
                                                                   Visibility="{x:Bind ShowThumbnail, Converter={StaticResource InvertBoolToVisibilityConverter}}" />
                                                    </Grid>
                                                </Border>

                                                <StackPanel Grid.Row="2"
                                                            Spacing="2">
                                                    <TextBlock Text="{x:Bind StatusText}"
                                                               Foreground="{ThemeResource SystemBaseMediumColor}" />
                                                    <TextBlock Text="{x:Bind FileSizeText}"
                                                               Foreground="{ThemeResource SystemBaseMediumColor}" />
                                                    <TextBlock Text="{x:Bind DimensionsText}"
                                                               Foreground="{ThemeResource SystemBaseMediumColor}" />
                                                </StackPanel>

                                                <StackPanel Grid.Row="3"
                                                            Spacing="8">
                                                    <TextBox Text="{x:Bind SourceUrl, Mode=TwoWay}"
                                                             PlaceholderText="{Binding Source={StaticResource Strings}, Path=PhotoSourceLabel}"
                                                             IsEnabled="{x:Bind IsReady}" />
                                                    <ProgressBar Minimum="0"
                                                                 Maximum="100"
                                                                 Value="{x:Bind UploadPercent}"
                                                                 Visibility="{x:Bind ShowProgress, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    <TextBlock Text="{x:Bind ErrorText}"
                                                               Foreground="{ThemeResource SystemErrorTextColor}"
                                                               TextWrapping="Wrap"
                                                               Visibility="{x:Bind ShowError, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer Grid.Row="4"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="16">
                        <ItemsRepeater ItemsSource="{Binding Photos}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="240"
                                                   MinItemHeight="300"
                                                   MinColumnSpacing="16"
                                                   MinRowSpacing="16"
                                                   ItemsStretch="Fill" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="12">
                                        <Grid RowSpacing="8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Image Grid.Row="0"
                                                   Source="{Binding ThumbnailImageSource}"
                                                   Stretch="Uniform"
                                                   MaxHeight="180"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />

                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding CameraInfo}"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource SystemBaseMediumColor}"
                                                       HorizontalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />

                                            <StackPanel Grid.Row="2"
                                                        HorizontalAlignment="Center"
                                                        Spacing="4">
                                                <TextBlock Text="{Binding LicenseName}"
                                                           FontSize="11"
                                                           Foreground="{ThemeResource SystemBaseMediumColor}"
                                                           HorizontalAlignment="Center" />
                                                <TextBlock Text="{Binding UploadDate}"
                                                           FontSize="11"
                                                           Foreground="{ThemeResource SystemBaseMediumColor}"
                                                           HorizontalAlignment="Center" />
                                            </StackPanel>

                                            <StackPanel Grid.Row="3"
                                                        Orientation="Horizontal"
                                                        HorizontalAlignment="Center"
                                                        Spacing="8">
                                                <Button Content="{Binding Source={StaticResource Strings}, Path=ViewDetailsButton}"
                                                        Command="{Binding DataContext.ViewPhotoCommand, ElementName=PageRoot}"
                                                        CommandParameter="{Binding}"
                                                        Style="{ThemeResource TextBlockButtonStyle}"
                                                        Padding="8,4" />
                                                <Button Content="{Binding Source={StaticResource Strings}, Path=DeleteButton}"
                                                        Command="{Binding DataContext.DeletePhotoCommand, ElementName=PageRoot}"
                                                        CommandParameter="{Binding}"
                                                        Foreground="{ThemeResource SystemErrorTextColor}"
                                                        Style="{ThemeResource TextBlockButtonStyle}"
                                                        Padding="8,4" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
