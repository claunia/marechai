<?xml version="1.0"
      encoding="utf-8"?>

<Page x:Class="Marechai.App.Presentation.Views.Admin.AdminCompaniesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
      xmlns:local="using:Marechai.App.Presentation.Views"
      x:Name="PageRoot"
      NavigationCacheMode="Required"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,0,0,1"
              Padding="16,12">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Source={StaticResource Strings}, Path=CompanyManagementTitle}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextControlForeground}" />
                <TextBlock Text="{Binding Source={StaticResource Strings}, Path=CompanyManagementSubtitle}"
                           FontSize="12"
                           Foreground="{ThemeResource SystemBaseMediumColor}"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="1">

            <!-- Access Denied -->
            <StackPanel Visibility="{Binding IsAdmin, Converter={StaticResource InvertBoolToVisibilityConverter}}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Padding="24"
                        Spacing="16"
                        MaxWidth="400">
                <InfoBar IsOpen="True"
                         Severity="Warning"
                         Title="{Binding Source={StaticResource Strings}, Path=CompanyMgmtAccessDeniedTitle}"
                         Message="{Binding Source={StaticResource Strings}, Path=CompanyMgmtAccessDeniedMessage}"
                         IsClosable="False" />
            </StackPanel>

            <!-- Content (admin only) -->
            <Grid Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}"
                  Canvas.ZIndex="0">

                <!-- Loading -->
                <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Padding="32"
                            Spacing="16">
                    <ProgressRing IsActive="True"
                                  IsIndeterminate="True"
                                  Height="64"
                                  Width="64"
                                  Foreground="{ThemeResource SystemAccentColor}" />
                    <TextBlock Text="{Binding Source={StaticResource Strings}, Path=LoadingText}"
                               FontSize="14"
                               TextAlignment="Center"
                               Foreground="{ThemeResource SystemBaseMediumColor}" />
                </StackPanel>

                <!-- Error -->
                <StackPanel Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Padding="24"
                            Spacing="16"
                            MaxWidth="400"
                            Canvas.ZIndex="100">
                    <InfoBar IsOpen="True"
                             Severity="Error"
                             Title="{Binding Source={StaticResource Strings}, Path=ErrorTitle}"
                             Message="{Binding ErrorMessage}"
                             IsClosable="False" />
                    <Button Content="{Binding Source={StaticResource Strings}, Path=RetryButton}"
                            Command="{Binding LoadCompaniesCommand}"
                            HorizontalAlignment="Center"
                            Style="{ThemeResource AccentButtonStyle}" />
                </StackPanel>

                <!-- List View -->
                <Grid Visibility="{Binding IsDataLoaded, Converter={StaticResource BoolToVisibilityConverter}}"
                      Canvas.ZIndex="1">

                    <!-- Two-column layout: list + edit panel -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Companies list -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Command Bar -->
                            <CommandBar Grid.Row="0"
                                        DefaultLabelPosition="Right">
                                <AppBarButton Icon="Add"
                                              Label="{Binding Source={StaticResource Strings}, Path=AddCompanyButton}"
                                              Command="{Binding OpenAddCompanyCommand}" />
                                <AppBarButton Icon="Refresh"
                                              Label="{Binding Source={StaticResource Strings}, Path=RefreshCompaniesButton}"
                                              Command="{Binding LoadCompaniesCommand}" />
                            </CommandBar>

                            <!-- Filter -->
                            <AutoSuggestBox Grid.Row="1"
                                            Margin="16,8,16,0"
                                            PlaceholderText="{Binding Source={StaticResource Strings}, Path=CompaniesSearchBox_Placeholder}"
                                            QueryIcon="Find"
                                            Text="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            x:Name="FilterBox"
                                            TextChanged="FilterBox_TextChanged" />

                            <!-- DataGrid -->
                            <controls:DataGrid Grid.Row="2"
                                               Margin="16"
                                               ItemsSource="{Binding FilteredCompanies}"
                                               SelectedItem="{Binding SelectedCompany, Mode=TwoWay}"
                                               AutoGenerateColumns="False"
                                               GridLinesVisibility="None"
                                               HeadersVisibility="Column"
                                               AlternatingRowBackground="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                               CanUserReorderColumns="True"
                                               CanUserResizeColumns="True"
                                               CanUserSortColumns="True"
                                               IsReadOnly="True"
                                               SelectionMode="Single"
                                               HorizontalScrollBarVisibility="Auto"
                                               VerticalScrollBarVisibility="Auto">
                                <controls:DataGrid.Columns>
                                    <controls:DataGridTextColumn
                                        Header="{Binding Source={StaticResource Strings}, Path=CompanyNameColumn}"
                                        Binding="{Binding Name}"
                                        Width="2*" />
                                    <controls:DataGridTextColumn
                                        Header="{Binding Source={StaticResource Strings}, Path=CompanyLegalNameColumn}"
                                        Binding="{Binding LegalName}"
                                        Width="*" />
                                    <controls:DataGridTextColumn
                                        Header="{Binding Source={StaticResource Strings}, Path=CompanyCountryColumn}"
                                        Binding="{Binding Country}"
                                        Width="*" />
                                    <controls:DataGridTextColumn
                                        Header="{Binding Source={StaticResource Strings}, Path=CompanySoldToColumn}"
                                        Binding="{Binding SoldTo}"
                                        Width="*" />
                                    <controls:DataGridTemplateColumn
                                        Header="{Binding Source={StaticResource Strings}, Path=ActionsColumn}"
                                        Width="Auto">
                                        <controls:DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal"
                                                            Spacing="4">
                                                    <Button Content="{Binding Source={StaticResource Strings}, Path=EditCompanyButton}"
                                                            Command="{Binding DataContext.OpenEditCompanyCommand, ElementName=PageRoot}"
                                                            CommandParameter="{Binding}"
                                                            Style="{ThemeResource TextBlockButtonStyle}"
                                                            Padding="8,4" />
                                                    <Button Content="{Binding Source={StaticResource Strings}, Path=DescriptionButton}"
                                                            Command="{Binding DataContext.OpenDescriptionCommand, ElementName=PageRoot}"
                                                            CommandParameter="{Binding}"
                                                            Style="{ThemeResource TextBlockButtonStyle}"
                                                            Padding="8,4" />
                                                    <Button Content="{Binding Source={StaticResource Strings}, Path=LogosButton}"
                                                            Command="{Binding DataContext.OpenLogosCommand, ElementName=PageRoot}"
                                                            CommandParameter="{Binding}"
                                                            Style="{ThemeResource TextBlockButtonStyle}"
                                                            Padding="8,4" />
                                                    <Button Content="{Binding Source={StaticResource Strings}, Path=MergeCompanyButton}"
                                                            Command="{Binding DataContext.OpenMergeCommand, ElementName=PageRoot}"
                                                            CommandParameter="{Binding}"
                                                            Style="{ThemeResource TextBlockButtonStyle}"
                                                            Padding="8,4" />
                                                    <Button Content="{Binding Source={StaticResource Strings}, Path=DeleteCompanyButton}"
                                                            Command="{Binding DataContext.DeleteCompanyCommand, ElementName=PageRoot}"
                                                            CommandParameter="{Binding}"
                                                            Foreground="{ThemeResource SystemErrorTextColor}"
                                                            Style="{ThemeResource TextBlockButtonStyle}"
                                                            Padding="8,4" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </controls:DataGridTemplateColumn.CellTemplate>
                                    </controls:DataGridTemplateColumn>
                                </controls:DataGrid.Columns>
                            </controls:DataGrid>
                        </Grid>

                        <!-- Edit Panel (slides in from right) -->
                        <Border Grid.Column="1"
                                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}"
                                Width="420"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="1,0,0,0">
                            <Grid RowSpacing="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Edit header -->
                                <Grid Grid.Row="0"
                                      Padding="16,12"
                                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                      BorderThickness="0,0,0,1">
                                    <TextBlock Text="{Binding EditPanelTitle}"
                                               FontSize="18"
                                               FontWeight="SemiBold" />
                                </Grid>

                                <!-- Edit form (scrollable) -->
                                <ScrollViewer Grid.Row="1"
                                              Padding="16"
                                              VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="12">

                                        <!-- Name -->
                                        <TextBox Header="{Binding Source={StaticResource Strings}, Path=CompanyNameLabel}"
                                                 Text="{Binding CompanyName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="{Binding Source={StaticResource Strings}, Path=CompanyNameLabel}" />

                                        <!-- Legal Name -->
                                        <TextBox Header="{Binding Source={StaticResource Strings}, Path=CompanyLegalNameLabel}"
                                                 Text="{Binding LegalName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <!-- Status -->
                                        <ComboBox Header="{Binding Source={StaticResource Strings}, Path=CompanyStatusLabel}"
                                                  ItemsSource="{Binding StatusItems}"
                                                  SelectedIndex="{Binding StatusIndex, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch" />

                                        <!-- Founded -->
                                        <CalendarDatePicker Header="{Binding Source={StaticResource Strings}, Path=CompanyFoundedLabel}"
                                                            Date="{Binding Founded, Mode=TwoWay}"
                                                            HorizontalAlignment="Stretch" />
                                        <ComboBox Header="{Binding Source={StaticResource Strings}, Path=DatePrecisionLabel}"
                                                  SelectedIndex="{Binding FoundedPrecision, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="{Binding Source={StaticResource Strings}, Path=DatePrecisionFull}" />
                                            <ComboBoxItem Content="{Binding Source={StaticResource Strings}, Path=DatePrecisionMonthYear}" />
                                            <ComboBoxItem Content="{Binding Source={StaticResource Strings}, Path=DatePrecisionYearOnly}" />
                                        </ComboBox>
                                        <CheckBox Content="{Binding Source={StaticResource Strings}, Path=FoundedMonthUnknownLabel}"
                                                  IsChecked="{Binding FoundedMonthIsUnknown, Mode=TwoWay}" />
                                        <CheckBox Content="{Binding Source={StaticResource Strings}, Path=FoundedDayUnknownLabel}"
                                                  IsChecked="{Binding FoundedDayIsUnknown, Mode=TwoWay}" />

                                        <!-- Sold -->
                                        <CalendarDatePicker Header="{Binding Source={StaticResource Strings}, Path=CompanySoldLabel}"
                                                            Date="{Binding Sold, Mode=TwoWay}"
                                                            HorizontalAlignment="Stretch" />
                                        <ComboBox Header="{Binding Source={StaticResource Strings}, Path=DatePrecisionLabel}"
                                                  SelectedIndex="{Binding SoldPrecision, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="{Binding Source={StaticResource Strings}, Path=DatePrecisionFull}" />
                                            <ComboBoxItem Content="{Binding Source={StaticResource Strings}, Path=DatePrecisionMonthYear}" />
                                            <ComboBoxItem Content="{Binding Source={StaticResource Strings}, Path=DatePrecisionYearOnly}" />
                                        </ComboBox>
                                        <CheckBox Content="{Binding Source={StaticResource Strings}, Path=SoldMonthUnknownLabel}"
                                                  IsChecked="{Binding SoldMonthIsUnknown, Mode=TwoWay}" />
                                        <CheckBox Content="{Binding Source={StaticResource Strings}, Path=SoldDayUnknownLabel}"
                                                  IsChecked="{Binding SoldDayIsUnknown, Mode=TwoWay}" />

                                        <!-- Sold To -->
                                        <AutoSuggestBox Header="{Binding Source={StaticResource Strings}, Path=CompanySoldToLabel}"
                                                        PlaceholderText="{Binding Source={StaticResource Strings}, Path=CompaniesSearchBox_Placeholder}"
                                                        Text="{Binding SoldToSearchText, Mode=TwoWay}"
                                                        QueryIcon="Find"
                                                        x:Name="SoldToFilterBox"
                                                        TextChanged="SoldToFilterBox_TextChanged" />
                                        <ComboBox ItemsSource="{Binding SoldToSuggestions}"
                                                  SelectedItem="{Binding SelectedSoldToCompany, Mode=TwoWay}"
                                                  DisplayMemberPath="Name"
                                                  HorizontalAlignment="Stretch"
                                                  PlaceholderText="{Binding Source={StaticResource Strings}, Path=CompanySoldToLabel}" />

                                        <!-- Country -->
                                        <ComboBox Header="{Binding Source={StaticResource Strings}, Path=CompanyCountryLabel}"
                                                  ItemsSource="{Binding Countries}"
                                                  SelectedItem="{Binding SelectedCountry, Mode=TwoWay}"
                                                  DisplayMemberPath="Name"
                                                  HorizontalAlignment="Stretch" />

                                        <!-- Address -->
                                        <TextBox Header="{Binding Source={StaticResource Strings}, Path=CompanyAddressLabel}"
                                                 Text="{Binding Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Header="{Binding Source={StaticResource Strings}, Path=CompanyCityLabel}"
                                                 Text="{Binding City, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Header="{Binding Source={StaticResource Strings}, Path=CompanyProvinceLabel}"
                                                 Text="{Binding Province, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Header="{Binding Source={StaticResource Strings}, Path=CompanyPostalCodeLabel}"
                                                 Text="{Binding PostalCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <!-- Links -->
                                        <TextBox Header="{Binding Source={StaticResource Strings}, Path=WebsiteText}"
                                                 Text="{Binding Website, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Header="{Binding Source={StaticResource Strings}, Path=TwitterText}"
                                                 Text="{Binding Twitter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Header="{Binding Source={StaticResource Strings}, Path=FacebookText}"
                                                 Text="{Binding Facebook, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <!-- People Section (only when editing existing company) -->
                                        <StackPanel Visibility="{Binding IsEditingExisting, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Spacing="8"
                                                    Margin="0,16,0,0">

                                            <!-- Section header -->
                                            <TextBlock Text="{Binding Source={StaticResource Strings}, Path=CompanyPeopleSection}"
                                                       FontSize="16"
                                                       FontWeight="SemiBold" />

                                            <!-- Current people list -->
                                            <ItemsRepeater ItemsSource="{Binding CompanyPeopleDisplays}">
                                                <ItemsRepeater.Layout>
                                                    <StackLayout Spacing="4" />
                                                </ItemsRepeater.Layout>
                                                <ItemsRepeater.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid ColumnSpacing="4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding}"
                                                                       VerticalAlignment="Center"
                                                                       TextWrapping="Wrap" />
                                                            <Button Grid.Column="1"
                                                                    Content="✏️"
                                                                    Command="{Binding DataContext.EditPersonCommand, ElementName=PageRoot}"
                                                                    CommandParameter="{Binding}"
                                                                    Padding="4,2"
                                                                    Style="{ThemeResource TextBlockButtonStyle}" />
                                                            <Button Grid.Column="2"
                                                                    Content="🗑️"
                                                                    Command="{Binding DataContext.RemovePersonCommand, ElementName=PageRoot}"
                                                                    CommandParameter="{Binding}"
                                                                    Padding="4,2"
                                                                    Style="{ThemeResource TextBlockButtonStyle}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsRepeater.ItemTemplate>
                                            </ItemsRepeater>

                                            <!-- Add/Edit person form -->
                                            <AutoSuggestBox Header="{Binding Source={StaticResource Strings}, Path=CompanyPeopleLabel}"
                                                            PlaceholderText="{Binding Source={StaticResource Strings}, Path=CompanyPeopleLabel}"
                                                            Text="{Binding PersonSearchText, Mode=TwoWay}"
                                                            QueryIcon="Find"
                                                            x:Name="PersonSearchBox"
                                                            TextChanged="PersonSearchBox_TextChanged" />
                                            <ComboBox ItemsSource="{Binding AvailablePeople}"
                                                      SelectedItem="{Binding SelectedAvailablePerson, Mode=TwoWay}"
                                                      HorizontalAlignment="Stretch"
                                                      PlaceholderText="{Binding Source={StaticResource Strings}, Path=CompanyPeopleLabel}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock>
                                                            <Run Text="{Binding Name}" />
                                                            <Run Text=" " />
                                                            <Run Text="{Binding Surname}" />
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>

                                            <TextBox Header="{Binding Source={StaticResource Strings}, Path=CompanyPersonPositionLabel}"
                                                     Text="{Binding NewPersonPosition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                            <CalendarDatePicker Header="{Binding Source={StaticResource Strings}, Path=CompanyPersonStartLabel}"
                                                                Date="{Binding NewPersonStart, Mode=TwoWay}"
                                                                HorizontalAlignment="Stretch" />

                                            <CalendarDatePicker Header="{Binding Source={StaticResource Strings}, Path=CompanyPersonEndLabel}"
                                                                Date="{Binding NewPersonEnd, Mode=TwoWay}"
                                                                HorizontalAlignment="Stretch" />

                                            <CheckBox Content="{Binding Source={StaticResource Strings}, Path=CompanyPersonOngoingLabel}"
                                                      IsChecked="{Binding NewPersonOngoing, Mode=TwoWay}" />

                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="8">
                                                <Button Content="+"
                                                        Command="{Binding AddPersonCommand}"
                                                        Style="{ThemeResource AccentButtonStyle}"
                                                        Padding="8,4" />
                                                <Button Content="{Binding Source={StaticResource Strings}, Path=SaveButton}"
                                                        Command="{Binding SavePersonEditCommand}"
                                                        Padding="8,4" />
                                                <Button Content="{Binding Source={StaticResource Strings}, Path=CancelButton}"
                                                        Command="{Binding CancelPersonEditCommand}"
                                                        Padding="8,4" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- Edit footer (Save / Cancel) -->
                                <Grid Grid.Row="2"
                                      Padding="16,12"
                                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                      BorderThickness="0,1,0,0"
                                      ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Content="{Binding Source={StaticResource Strings}, Path=CancelButton}"
                                            Command="{Binding CancelEditCommand}"
                                            HorizontalAlignment="Stretch" />
                                    <Button Grid.Column="1"
                                            Content="{Binding Source={StaticResource Strings}, Path=SaveButton}"
                                            Command="{Binding SaveCompanyCommand}"
                                            HorizontalAlignment="Stretch"
                                            Style="{ThemeResource AccentButtonStyle}" />
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Description Panel -->
                        <Border Grid.Column="1"
                                Visibility="{Binding IsEditingDescription, Converter={StaticResource BoolToVisibilityConverter}}"
                                Width="560"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="1,0,0,0">
                            <Grid RowSpacing="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Description header -->
                                <Grid Grid.Row="0"
                                      Padding="16,12"
                                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                      BorderThickness="0,0,0,1">
                                    <TextBlock Text="{Binding Source={StaticResource Strings}, Path=DescriptionDialogTitle}"
                                               FontSize="18"
                                               FontWeight="SemiBold" />
                                </Grid>

                                <!-- Language selector -->
                                <StackPanel Grid.Row="1"
                                            Padding="16,8"
                                            Spacing="4"
                                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                            BorderThickness="0,0,0,1">
                                    <TextBlock Text="{Binding Source={StaticResource Strings}, Path=LanguageLabel}"
                                               FontWeight="SemiBold" />
                                    <ComboBox ItemsSource="{Binding AvailableLanguages}"
                                              SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch"
                                              DisplayMemberPath="DisplayName" />
                                </StackPanel>

                                <!-- Existing translations list -->
                                <StackPanel Grid.Row="2"
                                            Padding="16,8"
                                            Spacing="4"
                                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                            BorderThickness="0,0,0,1">
                                    <TextBlock Text="{Binding Source={StaticResource Strings}, Path=ExistingTranslationsLabel}"
                                               FontWeight="SemiBold" />
                                    <ItemsRepeater ItemsSource="{Binding ExistingTranslations}">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Spacing="4" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Language}"
                                                               VerticalAlignment="Center" />
                                                    <Button Grid.Column="1"
                                                            Content="✏️"
                                                            Command="{Binding DataContext.EditTranslationCommand, ElementName=PageRoot}"
                                                            CommandParameter="{Binding}"
                                                            Padding="4,2"
                                                            Style="{ThemeResource TextBlockButtonStyle}" />
                                                    <Button Grid.Column="2"
                                                            Content="🗑️"
                                                            Command="{Binding DataContext.DeleteTranslationCommand, ElementName=PageRoot}"
                                                            CommandParameter="{Binding}"
                                                            Padding="4,2"
                                                            Style="{ThemeResource TextBlockButtonStyle}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </StackPanel>

                                <!-- Description editor -->
                                <Grid Grid.Row="3"
                                      Margin="16"
                                      RowSpacing="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0"
                                                Spacing="6">
                                        <TextBlock Text="{Binding Source={StaticResource Strings}, Path=MarkdownSourceLabel}"
                                                   FontWeight="SemiBold" />
                                        <Border MinHeight="180"
                                                Padding="1"
                                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                            <TextBox Text="{Binding DescriptionMarkdown, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     PlaceholderText="{Binding Source={StaticResource Strings}, Path=DescriptionMarkdownPlaceholder}"
                                                     VerticalAlignment="Stretch"
                                                     HorizontalAlignment="Stretch"
                                                     BorderThickness="0"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1"
                                                Spacing="6">
                                        <TextBlock Text="{Binding Source={StaticResource Strings}, Path=MarkdownPreviewLabel}"
                                                   FontWeight="SemiBold" />
                                        <Border MinHeight="180"
                                                Padding="12"
                                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <local:MessageMarkdownView Markdown="{Binding DescriptionMarkdown}" />
                                            </ScrollViewer>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- Description footer -->
                                <Grid Grid.Row="4"
                                      Padding="16,12"
                                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                      BorderThickness="0,1,0,0"
                                      ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Content="{Binding Source={StaticResource Strings}, Path=CancelButton}"
                                            Command="{Binding CancelDescriptionCommand}"
                                            HorizontalAlignment="Stretch" />
                                    <Button Grid.Column="1"
                                            Content="{Binding Source={StaticResource Strings}, Path=SaveButton}"
                                            Command="{Binding SaveDescriptionCommand}"
                                            IsEnabled="{Binding CanSaveDescription}"
                                            HorizontalAlignment="Stretch"
                                            Style="{ThemeResource AccentButtonStyle}" />
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Merge Panel -->
                        <Border Grid.Column="1"
                                Visibility="{Binding IsMerging, Converter={StaticResource BoolToVisibilityConverter}}"
                                Width="500"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="1,0,0,0">
                            <Grid RowSpacing="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Merge header -->
                                <Grid Grid.Row="0"
                                      Padding="16,12"
                                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                      BorderThickness="0,0,0,1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Source={StaticResource Strings}, Path=MergeCompanyPanelTitle}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding MergeSourceCompany.Name}"
                                                   FontSize="13"
                                                   Foreground="{ThemeResource SystemBaseMediumColor}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>

                                <!-- Merge body (scrollable) -->
                                <ScrollViewer Grid.Row="1"
                                              Padding="16"
                                              VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="12">

                                        <!-- Target picker -->
                                        <AutoSuggestBox Header="{Binding Source={StaticResource Strings}, Path=MergeTargetLabel}"
                                                        PlaceholderText="{Binding Source={StaticResource Strings}, Path=CompaniesSearchBox_Placeholder}"
                                                        Text="{Binding MergeTargetSearchText, Mode=TwoWay}"
                                                        QueryIcon="Find"
                                                        x:Name="MergeTargetFilterBox"
                                                        TextChanged="MergeTargetFilterBox_TextChanged" />
                                        <ComboBox ItemsSource="{Binding MergeTargetSuggestions}"
                                                  SelectedItem="{Binding SelectedMergeTargetCompany, Mode=TwoWay}"
                                                  DisplayMemberPath="Name"
                                                  HorizontalAlignment="Stretch"
                                                  PlaceholderText="{Binding Source={StaticResource Strings}, Path=MergeTargetLabel}" />

                                        <!-- Warning -->
                                        <InfoBar IsOpen="{Binding IsMergeTargetSelected}"
                                                 Severity="Warning"
                                                 Title="{Binding Source={StaticResource Strings}, Path=MergeWarningTitle}"
                                                 Message="{Binding Source={StaticResource Strings}, Path=MergeWarningMessage}"
                                                 IsClosable="False" />

                                        <!-- Field diffs -->
                                        <StackPanel Visibility="{Binding IsMergeTargetSelected, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Spacing="8">
                                            <ItemsRepeater ItemsSource="{Binding MergeFieldChoices}">
                                                <ItemsRepeater.Layout>
                                                    <StackLayout Spacing="8" />
                                                </ItemsRepeater.Layout>
                                                <ItemsRepeater.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Spacing="2"
                                                                    Padding="0,4">
                                                            <TextBlock Text="{Binding Label}"
                                                                       FontWeight="SemiBold" />
                                                            <RadioButton GroupName="{Binding Label}"
                                                                         IsChecked="{Binding UseSource, Converter={StaticResource InvertBoolConverter}, Mode=TwoWay}">
                                                                <TextBlock Text="{Binding TargetValue}"
                                                                           TextWrapping="Wrap" />
                                                            </RadioButton>
                                                            <RadioButton GroupName="{Binding Label}"
                                                                         IsChecked="{Binding UseSource, Mode=TwoWay}">
                                                                <TextBlock Text="{Binding SourceValue}"
                                                                           TextWrapping="Wrap" />
                                                            </RadioButton>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsRepeater.ItemTemplate>
                                            </ItemsRepeater>
                                        </StackPanel>

                                        <!-- Relationship summary -->
                                        <StackPanel Visibility="{Binding IsMergeTargetSelected, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Spacing="4"
                                                    Margin="0,12,0,0">
                                            <TextBlock Text="{Binding Source={StaticResource Strings}, Path=MergeRelationshipsSectionTitle}"
                                                       FontSize="16"
                                                       FontWeight="SemiBold" />
                                            <ItemsRepeater ItemsSource="{Binding MergeRelationshipSummaryLines}">
                                                <ItemsRepeater.Layout>
                                                    <StackLayout Spacing="2" />
                                                </ItemsRepeater.Layout>
                                                <ItemsRepeater.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" />
                                                    </DataTemplate>
                                                </ItemsRepeater.ItemTemplate>
                                            </ItemsRepeater>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- Merge footer -->
                                <Grid Grid.Row="2"
                                      Padding="16,12"
                                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                      BorderThickness="0,1,0,0"
                                      ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Content="{Binding Source={StaticResource Strings}, Path=CancelButton}"
                                            Command="{Binding CancelMergeCommand}"
                                            HorizontalAlignment="Stretch" />
                                    <Button Grid.Column="1"
                                            Content="{Binding Source={StaticResource Strings}, Path=MergeButton}"
                                            IsEnabled="{Binding IsMergeTargetSelected}"
                                            Click="MergeButton_Click"
                                            HorizontalAlignment="Stretch"
                                            Style="{ThemeResource AccentButtonStyle}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
