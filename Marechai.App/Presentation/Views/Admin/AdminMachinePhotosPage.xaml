<?xml version="1.0"
      encoding="utf-8"?>

<Page x:Class="Marechai.App.Presentation.Views.Admin.AdminMachinePhotosPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Name="PageRoot"
      NavigationCacheMode="Required"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,0,0,1"
              Padding="16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Content="&#xE72B;"
                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                    Command="{Binding GoBackCommand}"
                    Style="{ThemeResource TextBlockButtonStyle}"
                    Padding="8,4"
                    VerticalAlignment="Center"
                    Margin="0,0,12,0" />
            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center">
                <TextBlock FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextControlForeground}">
                    <Run Text="{Binding Source={StaticResource Strings}, Path=MachinePhotosTitle}" />
                    <Run Text=" — " />
                    <Run Text="{Binding MachineName}" />
                </TextBlock>
                <TextBlock Text="{Binding Source={StaticResource Strings}, Path=MachinePhotosSubtitle}"
                           FontSize="12"
                           Foreground="{ThemeResource SystemBaseMediumColor}"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="1">

            <!-- Access Denied -->
            <StackPanel Visibility="{Binding IsAdmin, Converter={StaticResource InvertBoolToVisibilityConverter}}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Padding="24"
                        Spacing="16"
                        MaxWidth="400">
                <InfoBar IsOpen="True"
                         Severity="Warning"
                         Title="{Binding Source={StaticResource Strings}, Path=MachinePhotosMgmtAccessDeniedTitle}"
                         Message="{Binding Source={StaticResource Strings}, Path=MachinePhotosMgmtAccessDeniedMessage}"
                         IsClosable="False" />
            </StackPanel>

            <!-- Content (admin only) -->
            <Grid Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}"
                  Canvas.ZIndex="0">

                <!-- Loading -->
                <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Padding="32"
                            Spacing="16">
                    <ProgressRing IsActive="True"
                                  IsIndeterminate="True"
                                  Height="64"
                                  Width="64"
                                  Foreground="{ThemeResource SystemAccentColor}" />
                    <TextBlock Text="{Binding Source={StaticResource Strings}, Path=LoadingText}"
                               FontSize="14"
                               TextAlignment="Center"
                               Foreground="{ThemeResource SystemBaseMediumColor}" />
                </StackPanel>

                <!-- Error -->
                <StackPanel Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Padding="24"
                            Spacing="16"
                            MaxWidth="400"
                            Canvas.ZIndex="100">
                    <InfoBar IsOpen="True"
                             Severity="Error"
                             Title="{Binding Source={StaticResource Strings}, Path=ErrorTitle}"
                             Message="{Binding ErrorMessage}"
                             IsClosable="False" />
                    <Button Content="{Binding Source={StaticResource Strings}, Path=RetryButton}"
                            Command="{Binding LoadPhotosCommand}"
                            HorizontalAlignment="Center"
                            Style="{ThemeResource AccentButtonStyle}" />
                </StackPanel>

                <!-- Uploading overlay -->
                <StackPanel Visibility="{Binding IsUploading, Converter={StaticResource BoolToVisibilityConverter}}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Padding="32"
                            Spacing="16"
                            Canvas.ZIndex="200">
                    <ProgressRing IsActive="True"
                                  IsIndeterminate="True"
                                  Height="64"
                                  Width="64"
                                  Foreground="{ThemeResource SystemAccentColor}" />
                    <TextBlock Text="{Binding Source={StaticResource Strings}, Path=UploadingPhotoText}"
                               FontSize="14"
                               TextAlignment="Center"
                               Foreground="{ThemeResource SystemBaseMediumColor}" />
                </StackPanel>

                <!-- Photos grid -->
                <Grid Visibility="{Binding IsDataLoaded, Converter={StaticResource BoolToVisibilityConverter}}"
                      Canvas.ZIndex="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Command Bar -->
                    <CommandBar Grid.Row="0"
                                DefaultLabelPosition="Right">
                        <AppBarButton Icon="Refresh"
                                      Label="{Binding Source={StaticResource Strings}, Path=RefreshButton}"
                                      Command="{Binding LoadPhotosCommand}" />
                    </CommandBar>

                    <!-- Upload Section -->
                    <Border Grid.Row="1"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="16,12">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{Binding Source={StaticResource Strings}, Path=UploadPhotoLabel}"
                                       FontSize="16"
                                       FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal"
                                        Spacing="12">
                                <ComboBox ItemsSource="{Binding Licenses}"
                                          SelectedItem="{Binding SelectedLicense, Mode=TwoWay}"
                                          DisplayMemberPath="Name"
                                          PlaceholderText="{Binding Source={StaticResource Strings}, Path=SelectLicenseLabel}"
                                          MinWidth="200" />
                                <TextBox Text="{Binding SourceUrl, Mode=TwoWay}"
                                         PlaceholderText="{Binding Source={StaticResource Strings}, Path=PhotoSourceLabel}"
                                         MinWidth="250" />
                                <Button Content="{Binding Source={StaticResource Strings}, Path=UploadPhotoButton}"
                                        Command="{Binding UploadPhotoCommand}"
                                        Style="{ThemeResource AccentButtonStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Photo Items -->
                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="16">
                        <ItemsRepeater ItemsSource="{Binding Photos}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="240"
                                                   MinItemHeight="300"
                                                   MinColumnSpacing="16"
                                                   MinRowSpacing="16"
                                                   ItemsStretch="Fill" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="12">
                                        <Grid RowSpacing="8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- Photo thumbnail -->
                                            <Image Grid.Row="0"
                                                   Source="{Binding ThumbnailImageSource}"
                                                   Stretch="Uniform"
                                                   MaxHeight="180"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />

                                            <!-- Camera info -->
                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding CameraInfo}"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource SystemBaseMediumColor}"
                                                       HorizontalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />

                                            <!-- License / Upload date -->
                                            <StackPanel Grid.Row="2"
                                                        HorizontalAlignment="Center"
                                                        Spacing="4">
                                                <TextBlock Text="{Binding LicenseName}"
                                                           FontSize="11"
                                                           Foreground="{ThemeResource SystemBaseMediumColor}"
                                                           HorizontalAlignment="Center" />
                                                <TextBlock Text="{Binding UploadDate}"
                                                           FontSize="11"
                                                           Foreground="{ThemeResource SystemBaseMediumColor}"
                                                           HorizontalAlignment="Center" />
                                            </StackPanel>

                                            <!-- Action buttons -->
                                            <StackPanel Grid.Row="3"
                                                        Orientation="Horizontal"
                                                        HorizontalAlignment="Center"
                                                        Spacing="8">
                                                <Button Content="{Binding Source={StaticResource Strings}, Path=ViewDetailsButton}"
                                                        Command="{Binding DataContext.ViewPhotoCommand, ElementName=PageRoot}"
                                                        CommandParameter="{Binding}"
                                                        Style="{ThemeResource TextBlockButtonStyle}"
                                                        Padding="8,4" />
                                                <Button Content="{Binding Source={StaticResource Strings}, Path=DeleteButton}"
                                                        Command="{Binding DataContext.DeletePhotoCommand, ElementName=PageRoot}"
                                                        CommandParameter="{Binding}"
                                                        Foreground="{ThemeResource SystemErrorTextColor}"
                                                        Style="{ThemeResource TextBlockButtonStyle}"
                                                        Padding="8,4" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
