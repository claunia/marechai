<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="Marechai.App.Presentation.Views.Admin.AdminSoundSynthsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
      xmlns:local="using:Marechai.App.Presentation.Views"
      x:Name="PageRoot" NavigationCacheMode="Required"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid RowSpacing="0">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="16,12">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Source={StaticResource Strings}, Path=SoundSynthManagementTitle}"
                           FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource TextControlForeground}" />
                <TextBlock Text="{Binding Source={StaticResource Strings}, Path=SoundSynthManagementSubtitle}"
                           FontSize="12" Foreground="{ThemeResource SystemBaseMediumColor}" Margin="0,4,0,0" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1">
            <StackPanel Visibility="{Binding IsAdmin, Converter={StaticResource InvertBoolToVisibilityConverter}}"
                        VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24" Spacing="16" MaxWidth="400">
                <InfoBar IsOpen="True" Severity="Warning"
                         Title="{Binding Source={StaticResource Strings}, Path=SoundSynthMgmtAccessDeniedTitle}"
                         Message="{Binding Source={StaticResource Strings}, Path=SoundSynthMgmtAccessDeniedMessage}" IsClosable="False" />
            </StackPanel>
            <Grid Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}" Canvas.ZIndex="0">
                <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                            VerticalAlignment="Center" HorizontalAlignment="Center" Padding="32" Spacing="16">
                    <ProgressRing IsActive="True" IsIndeterminate="True" Height="64" Width="64" Foreground="{ThemeResource SystemAccentColor}" />
                    <TextBlock Text="{Binding Source={StaticResource Strings}, Path=LoadingText}" FontSize="14" TextAlignment="Center" Foreground="{ThemeResource SystemBaseMediumColor}" />
                </StackPanel>
                <StackPanel Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"
                            VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24" Spacing="16" MaxWidth="400" Canvas.ZIndex="100">
                    <InfoBar IsOpen="True" Severity="Error" Title="{Binding Source={StaticResource Strings}, Path=ErrorTitle}" Message="{Binding ErrorMessage}" IsClosable="False" />
                    <Button Content="{Binding Source={StaticResource Strings}, Path=RetryButton}" Command="{Binding LoadItemsCommand}" HorizontalAlignment="Center" Style="{ThemeResource AccentButtonStyle}" />
                </StackPanel>
                <Grid Visibility="{Binding IsDataLoaded, Converter={StaticResource BoolToVisibilityConverter}}" Canvas.ZIndex="1">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <CommandBar Grid.Row="0" DefaultLabelPosition="Right">
                                <AppBarButton Icon="Add" Label="{Binding Source={StaticResource Strings}, Path=AddSoundSynthButton}" Command="{Binding OpenAddCommand}" />
                                <AppBarButton Icon="Refresh" Label="{Binding Source={StaticResource Strings}, Path=RefreshSoundSynthsButton}" Command="{Binding LoadItemsCommand}" />
                            </CommandBar>
                            <AutoSuggestBox Grid.Row="1" Margin="16,8,16,0"
                                            PlaceholderText="{Binding Source={StaticResource Strings}, Path=SoundSynthSearchPlaceholder}"
                                            QueryIcon="Find" Text="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            x:Name="FilterBox" TextChanged="FilterBox_TextChanged" />
                            <controls:DataGrid Grid.Row="2" Margin="16" ItemsSource="{Binding FilteredSoundSynths}"
                                               SelectedItem="{Binding SelectedSoundSynth, Mode=TwoWay}" AutoGenerateColumns="False"
                                               GridLinesVisibility="None" HeadersVisibility="Column"
                                               AlternatingRowBackground="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                               CanUserReorderColumns="True" CanUserResizeColumns="True" CanUserSortColumns="True"
                                               IsReadOnly="True" SelectionMode="Single"
                                               HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <controls:DataGrid.Columns>
                                    <controls:DataGridTextColumn Header="{Binding Source={StaticResource Strings}, Path=SoundSynthNameColumn}" Binding="{Binding Name}" Width="2*" />
                                    <controls:DataGridTextColumn Header="{Binding Source={StaticResource Strings}, Path=SoundSynthCompanyColumn}" Binding="{Binding Company}" Width="*" />
                                    <controls:DataGridTextColumn Header="{Binding Source={StaticResource Strings}, Path=SoundSynthModelCodeColumn}" Binding="{Binding ModelCode}" Width="*" />
                                    <controls:DataGridTemplateColumn Header="{Binding Source={StaticResource Strings}, Path=ActionsColumn}" Width="Auto">
                                        <controls:DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <Button Content="{Binding Source={StaticResource Strings}, Path=EditSoundSynthButton}"
                                                            Command="{Binding DataContext.OpenEditCommand, ElementName=PageRoot}" CommandParameter="{Binding}"
                                                            Style="{ThemeResource TextBlockButtonStyle}" Padding="8,4" />
                                                    <Button Content="{Binding Source={StaticResource Strings}, Path=DescriptionButton}"
                                                            Command="{Binding DataContext.OpenDescriptionCommand, ElementName=PageRoot}" CommandParameter="{Binding}"
                                                            Style="{ThemeResource TextBlockButtonStyle}" Padding="8,4" />
                                                    <Button Content="{Binding Source={StaticResource Strings}, Path=PhotosButton}"
                                                            Command="{Binding DataContext.OpenPhotosCommand, ElementName=PageRoot}" CommandParameter="{Binding}"
                                                            Style="{ThemeResource TextBlockButtonStyle}" Padding="8,4" />
                                                    <Button Content="{Binding Source={StaticResource Strings}, Path=VideosButton}"
                                                            Command="{Binding DataContext.OpenVideosCommand, ElementName=PageRoot}" CommandParameter="{Binding}"
                                                            Style="{ThemeResource TextBlockButtonStyle}" Padding="8,4" />
                                                    <Button Content="{Binding Source={StaticResource Strings}, Path=DeleteSoundSynthButton}"
                                                            Command="{Binding DataContext.DeleteCommand, ElementName=PageRoot}" CommandParameter="{Binding}"
                                                            Foreground="{ThemeResource SystemErrorTextColor}" Style="{ThemeResource TextBlockButtonStyle}" Padding="8,4" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </controls:DataGridTemplateColumn.CellTemplate>
                                    </controls:DataGridTemplateColumn>
                                </controls:DataGrid.Columns>
                            </controls:DataGrid>
                        </Grid>
                        <Border Grid.Column="1" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}"
                                Width="420" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
                            <Grid RowSpacing="0">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid Grid.Row="0" Padding="16,12" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                    <TextBlock Text="{Binding EditPanelTitle}" FontSize="18" FontWeight="SemiBold" />
                                </Grid>
                                <ScrollViewer Grid.Row="1" Padding="16" VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="12">
                                        <TextBox Header="{Binding Source={StaticResource Strings}, Path=SoundSynthNameLabel}"
                                                 Text="{Binding SynthName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <AutoSuggestBox Header="{Binding Source={StaticResource Strings}, Path=SoundSynthCompanyLabel}"
                                                        PlaceholderText="{Binding Source={StaticResource Strings}, Path=CompaniesSearchBox_Placeholder}"
                                                        Text="{Binding CompanySearchText, Mode=TwoWay}" QueryIcon="Find"
                                                        x:Name="CompanyFilterBox" TextChanged="CompanyFilterBox_TextChanged" />
                                        <ComboBox ItemsSource="{Binding CompanySuggestions}" SelectedItem="{Binding SelectedCompany, Mode=TwoWay}"
                                                  DisplayMemberPath="Name" HorizontalAlignment="Stretch"
                                                  PlaceholderText="{Binding Source={StaticResource Strings}, Path=SoundSynthCompanyLabel}" />
                                        <TextBox Header="{Binding Source={StaticResource Strings}, Path=SoundSynthModelCodeLabel}"
                                                 Text="{Binding ModelCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <CalendarDatePicker Header="{Binding Source={StaticResource Strings}, Path=SoundSynthIntroducedLabel}"
                                                            Date="{Binding Introduced, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                                        <ComboBox Header="{Binding Source={StaticResource Strings}, Path=DatePrecisionLabel}"
                                                  SelectedIndex="{Binding IntroducedPrecision, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="{Binding Source={StaticResource Strings}, Path=DatePrecisionFull}" />
                                            <ComboBoxItem Content="{Binding Source={StaticResource Strings}, Path=DatePrecisionMonthYear}" />
                                            <ComboBoxItem Content="{Binding Source={StaticResource Strings}, Path=DatePrecisionYearOnly}" />
                                        </ComboBox>
                                        <NumberBox Header="{Binding Source={StaticResource Strings}, Path=SoundSynthVoicesLabel}"
                                                   Value="{Binding Voices, Mode=TwoWay}" SpinButtonPlacementMode="Compact" Minimum="1" SmallChange="1" HorizontalAlignment="Stretch" />
                                        <NumberBox Header="{Binding Source={StaticResource Strings}, Path=SoundSynthFrequencyLabel}"
                                                   Value="{Binding Frequency, Mode=TwoWay}" SpinButtonPlacementMode="Compact" Minimum="0" SmallChange="100" HorizontalAlignment="Stretch" />
                                        <NumberBox Header="{Binding Source={StaticResource Strings}, Path=SoundSynthDepthLabel}"
                                                   Value="{Binding Depth, Mode=TwoWay}" SpinButtonPlacementMode="Compact" Minimum="1" SmallChange="1" HorizontalAlignment="Stretch" />
                                        <NumberBox Header="{Binding Source={StaticResource Strings}, Path=SoundSynthSquareWaveLabel}"
                                                   Value="{Binding SquareWave, Mode=TwoWay}" SpinButtonPlacementMode="Compact" Minimum="1" SmallChange="1" HorizontalAlignment="Stretch" />
                                        <NumberBox Header="{Binding Source={StaticResource Strings}, Path=SoundSynthWhiteNoiseLabel}"
                                                   Value="{Binding WhiteNoise, Mode=TwoWay}" SpinButtonPlacementMode="Compact" Minimum="1" SmallChange="1" HorizontalAlignment="Stretch" />
                                        <ComboBox Header="{Binding Source={StaticResource Strings}, Path=SoundSynthTypeLabel}"
                                                  ItemsSource="{Binding SoundSynthTypeItems}" SelectedIndex="{Binding SynthTypeIndex, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                </ScrollViewer>
                                <Grid Grid.Row="2" Padding="16,12" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="{Binding Source={StaticResource Strings}, Path=CancelButton}" Command="{Binding CancelEditCommand}" HorizontalAlignment="Stretch" />
                                    <Button Grid.Column="1" Content="{Binding Source={StaticResource Strings}, Path=SaveButton}" Command="{Binding SaveCommand}" HorizontalAlignment="Stretch" Style="{ThemeResource AccentButtonStyle}" />
                                </Grid>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1"
                                Visibility="{Binding IsEditingDescription, Converter={StaticResource BoolToVisibilityConverter}}"
                                Width="560"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="1,0,0,0">
                            <Grid RowSpacing="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0"
                                      Padding="16,12"
                                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                      BorderThickness="0,0,0,1">
                                    <TextBlock Text="{Binding Source={StaticResource Strings}, Path=DescriptionDialogTitle}"
                                               FontSize="18"
                                               FontWeight="SemiBold" />
                                </Grid>

                                <StackPanel Grid.Row="1"
                                            Padding="16,8"
                                            Spacing="4"
                                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                            BorderThickness="0,0,0,1">
                                    <TextBlock Text="{Binding Source={StaticResource Strings}, Path=LanguageLabel}"
                                               FontWeight="SemiBold" />
                                    <ComboBox ItemsSource="{Binding AvailableLanguages}"
                                              SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch"
                                              DisplayMemberPath="DisplayName" />
                                </StackPanel>

                                <StackPanel Grid.Row="2"
                                            Padding="16,8"
                                            Spacing="4"
                                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                            BorderThickness="0,0,0,1">
                                    <TextBlock Text="{Binding Source={StaticResource Strings}, Path=ExistingTranslationsLabel}"
                                               FontWeight="SemiBold" />
                                    <ItemsRepeater ItemsSource="{Binding ExistingTranslations}">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Spacing="4" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Language}"
                                                               VerticalAlignment="Center" />
                                                    <Button Grid.Column="1"
                                                            Content="✏️"
                                                            Command="{Binding DataContext.EditTranslationCommand, ElementName=PageRoot}"
                                                            CommandParameter="{Binding}"
                                                            Padding="4,2"
                                                            Style="{ThemeResource TextBlockButtonStyle}" />
                                                    <Button Grid.Column="2"
                                                            Content="🗑️"
                                                            Command="{Binding DataContext.DeleteTranslationCommand, ElementName=PageRoot}"
                                                            CommandParameter="{Binding}"
                                                            Padding="4,2"
                                                            Style="{ThemeResource TextBlockButtonStyle}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </StackPanel>

                                <Grid Grid.Row="3"
                                      Margin="16"
                                      RowSpacing="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0"
                                                Spacing="6">
                                        <TextBlock Text="{Binding Source={StaticResource Strings}, Path=MarkdownSourceLabel}"
                                                   FontWeight="SemiBold" />
                                        <Border MinHeight="180"
                                                Padding="1"
                                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                            <TextBox Text="{Binding DescriptionMarkdown, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     PlaceholderText="{Binding Source={StaticResource Strings}, Path=DescriptionMarkdownPlaceholder}"
                                                     VerticalAlignment="Stretch"
                                                     HorizontalAlignment="Stretch"
                                                     BorderThickness="0"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1"
                                                Spacing="6">
                                        <TextBlock Text="{Binding Source={StaticResource Strings}, Path=MarkdownPreviewLabel}"
                                                   FontWeight="SemiBold" />
                                        <Border MinHeight="180"
                                                Padding="12"
                                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <local:MessageMarkdownView Markdown="{Binding DescriptionMarkdown}" />
                                            </ScrollViewer>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="4"
                                      Padding="16,12"
                                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                      BorderThickness="0,1,0,0"
                                      ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Content="{Binding Source={StaticResource Strings}, Path=CancelButton}"
                                            Command="{Binding CancelDescriptionCommand}"
                                            HorizontalAlignment="Stretch" />
                                    <Button Grid.Column="1"
                                            Content="{Binding Source={StaticResource Strings}, Path=SaveButton}"
                                            Command="{Binding SaveDescriptionCommand}"
                                            IsEnabled="{Binding CanSaveDescription}"
                                            HorizontalAlignment="Stretch"
                                            Style="{ThemeResource AccentButtonStyle}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
