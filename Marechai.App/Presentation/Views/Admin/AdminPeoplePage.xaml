<?xml version="1.0"
      encoding="utf-8"?>

<Page x:Class="Marechai.App.Presentation.Views.Admin.AdminPeoplePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
      xmlns:local="using:Marechai.App.Presentation.Views"
      x:Name="PageRoot"
      NavigationCacheMode="Required"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,0,0,1"
              Padding="16,12">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Source={StaticResource Strings}, Path=PeopleManagementTitle}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextControlForeground}" />
                <TextBlock Text="{Binding Source={StaticResource Strings}, Path=PeopleManagementSubtitle}"
                           FontSize="12"
                           Foreground="{ThemeResource SystemBaseMediumColor}"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="1">

            <!-- Access Denied -->
            <StackPanel Visibility="{Binding IsAdmin, Converter={StaticResource InvertBoolToVisibilityConverter}}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Padding="24"
                        Spacing="16"
                        MaxWidth="400">
                <InfoBar IsOpen="True"
                         Severity="Warning"
                         Title="{Binding Source={StaticResource Strings}, Path=PeopleMgmtAccessDeniedTitle}"
                         Message="{Binding Source={StaticResource Strings}, Path=PeopleMgmtAccessDeniedMessage}"
                         IsClosable="False" />
            </StackPanel>

            <!-- Content (admin only) -->
            <Grid Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}"
                  Canvas.ZIndex="0">

                <!-- Loading -->
                <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Padding="32"
                            Spacing="16">
                    <ProgressRing IsActive="True" IsIndeterminate="True" Height="64" Width="64"
                                  Foreground="{ThemeResource SystemAccentColor}" />
                    <TextBlock Text="{Binding Source={StaticResource Strings}, Path=LoadingText}"
                               FontSize="14" TextAlignment="Center"
                               Foreground="{ThemeResource SystemBaseMediumColor}" />
                </StackPanel>

                <!-- Error -->
                <StackPanel Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"
                            VerticalAlignment="Center" HorizontalAlignment="Center"
                            Padding="24" Spacing="16" MaxWidth="400" Canvas.ZIndex="100">
                    <InfoBar IsOpen="True" Severity="Error"
                             Title="{Binding Source={StaticResource Strings}, Path=ErrorTitle}"
                             Message="{Binding ErrorMessage}" IsClosable="False" />
                    <Button Content="{Binding Source={StaticResource Strings}, Path=RetryButton}"
                            Command="{Binding LoadPeopleCommand}"
                            HorizontalAlignment="Center" Style="{ThemeResource AccentButtonStyle}" />
                </StackPanel>

                <!-- List View -->
                <Grid Visibility="{Binding IsDataLoaded, Converter={StaticResource BoolToVisibilityConverter}}"
                      Canvas.ZIndex="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- People list -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Command Bar -->
                            <CommandBar Grid.Row="0" DefaultLabelPosition="Right">
                                <AppBarButton Icon="Add"
                                              Label="{Binding Source={StaticResource Strings}, Path=AddPersonButton}"
                                              Command="{Binding OpenAddCommand}" />
                                <AppBarButton Icon="Refresh"
                                              Label="{Binding Source={StaticResource Strings}, Path=RefreshPeopleButton}"
                                              Command="{Binding LoadPeopleCommand}" />
                            </CommandBar>

                            <!-- Filter -->
                            <AutoSuggestBox Grid.Row="1"
                                            Margin="16,8,16,0"
                                            PlaceholderText="{Binding Source={StaticResource Strings}, Path=PeopleSearchPlaceholder}"
                                            QueryIcon="Find"
                                            Text="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            x:Name="FilterBox"
                                            TextChanged="FilterBox_TextChanged" />

                            <!-- DataGrid -->
                            <controls:DataGrid Grid.Row="2"
                                               Margin="16"
                                               ItemsSource="{Binding FilteredPeople}"
                                               SelectedItem="{Binding SelectedPerson, Mode=TwoWay}"
                                               AutoGenerateColumns="False"
                                               GridLinesVisibility="None"
                                               HeadersVisibility="Column"
                                               AlternatingRowBackground="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                               CanUserReorderColumns="True"
                                               CanUserResizeColumns="True"
                                               CanUserSortColumns="True"
                                               IsReadOnly="True"
                                               SelectionMode="Single"
                                               HorizontalScrollBarVisibility="Auto"
                                               VerticalScrollBarVisibility="Auto">
                                <controls:DataGrid.Columns>
                                    <controls:DataGridTextColumn
                                        Header="{Binding Source={StaticResource Strings}, Path=PersonNameColumn}"
                                        Binding="{Binding Name}" Width="*" />
                                    <controls:DataGridTextColumn
                                        Header="{Binding Source={StaticResource Strings}, Path=PersonSurnameColumn}"
                                        Binding="{Binding Surname}" Width="*" />
                                    <controls:DataGridTextColumn
                                        Header="{Binding Source={StaticResource Strings}, Path=PersonCountryColumn}"
                                        Binding="{Binding Country}" Width="*" />
                                    <controls:DataGridTextColumn
                                        Header="{Binding Source={StaticResource Strings}, Path=PersonBirthDateColumn}"
                                        Binding="{Binding Birthdate}" Width="Auto" />
                                    <controls:DataGridTextColumn
                                        Header="{Binding Source={StaticResource Strings}, Path=PersonDeathDateColumn}"
                                        Binding="{Binding DeathDate}" Width="Auto" />
                                    <controls:DataGridTemplateColumn
                                        Header="{Binding Source={StaticResource Strings}, Path=ActionsColumn}"
                                        Width="Auto">
                                        <controls:DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <Button Content="&#xE3C9;"
                                                            ToolTipService.ToolTip="{Binding Source={StaticResource Strings}, Path=EditPersonButton}"
                                                            Command="{Binding DataContext.OpenEditCommand, ElementName=PageRoot}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource AdminGridActionButtonStyle}" />
                                                    <Button ToolTipService.ToolTip="{Binding Source={StaticResource Strings}, Path=DescriptionButton}"
                                                            Command="{Binding DataContext.OpenDescriptionCommand, ElementName=PageRoot}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource AdminGridActionButtonStyle}">
                                                        <FontIcon Glyph="&#xE873;" FontFamily="{StaticResource MaterialIconsFontFamily}" />
                                                    </Button>
                                                    <Button Content="&#xE872;"
                                                            ToolTipService.ToolTip="{Binding Source={StaticResource Strings}, Path=DeletePersonButton}"
                                                            Command="{Binding DataContext.DeleteCommand, ElementName=PageRoot}"
                                                            CommandParameter="{Binding}"
                                                            Foreground="{ThemeResource SystemErrorTextColor}"
                                                            Style="{StaticResource AdminGridActionButtonStyle}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </controls:DataGridTemplateColumn.CellTemplate>
                                    </controls:DataGridTemplateColumn>
                                </controls:DataGrid.Columns>
                            </controls:DataGrid>

                            <Grid Grid.Row="3"
                                  Margin="16,0,16,16"
                                  ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Content="{Binding Source={StaticResource Strings}, Path=PreviousPageButton}"
                                        Command="{Binding PreviousPageCommand}"
                                        IsEnabled="{Binding CanGoPrevious}" />
                                <Button Grid.Column="1"
                                        Content="{Binding Source={StaticResource Strings}, Path=NextPageButton}"
                                        Command="{Binding NextPageCommand}"
                                        IsEnabled="{Binding CanGoNext}" />
                                <TextBlock Grid.Column="2"
                                           VerticalAlignment="Center"
                                           Text="{Binding PageSummary}" />
                                <TextBlock Grid.Column="3"
                                           VerticalAlignment="Center"
                                           Text="{Binding Source={StaticResource Strings}, Path=SoftwareAttributesPageSizeLabel}" />
                                <ComboBox Grid.Column="4"
                                          Width="96"
                                          ItemsSource="{Binding PageSizeOptions}"
                                          SelectedItem="{Binding PageSize, Mode=TwoWay}"
                                          SelectionChanged="PageSizeCombo_SelectionChanged" />
                            </Grid>
                        </Grid>

                        <!-- Edit Panel -->
                        <Border Grid.Column="1"
                                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}"
                                Width="420"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="1,0,0,0">
                            <Grid RowSpacing="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Edit header -->
                                <Grid Grid.Row="0" Padding="16,12"
                                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                      BorderThickness="0,0,0,1">
                                    <TextBlock Text="{Binding EditPanelTitle}"
                                               FontSize="18" FontWeight="SemiBold" />
                                </Grid>

                                <!-- Edit form -->
                                <ScrollViewer Grid.Row="1" Padding="16"
                                              VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="12">
                                        <!-- Name -->
                                        <TextBox Header="{Binding Source={StaticResource Strings}, Path=PersonNameLabel}"
                                                 Text="{Binding PersonName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <!-- Surname -->
                                        <TextBox Header="{Binding Source={StaticResource Strings}, Path=PersonSurnameLabel}"
                                                 Text="{Binding Surname, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <!-- Alias -->
                                        <TextBox Header="{Binding Source={StaticResource Strings}, Path=PersonAliasLabel}"
                                                 Text="{Binding Alias, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <!-- Display Name -->
                                        <TextBox Header="{Binding Source={StaticResource Strings}, Path=PersonDisplayNameLabel}"
                                                 Text="{Binding DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <!-- Country of Birth -->
                                        <ComboBox Header="{Binding Source={StaticResource Strings}, Path=PersonCountryLabel}"
                                                  ItemsSource="{Binding Countries}"
                                                  SelectedItem="{Binding SelectedCountry, Mode=TwoWay}"
                                                  DisplayMemberPath="Name"
                                                  HorizontalAlignment="Stretch" />

                                        <!-- Birth Date -->
                                        <CalendarDatePicker Header="{Binding Source={StaticResource Strings}, Path=PersonBirthDateLabel}"
                                                            Date="{Binding BirthDate, Mode=TwoWay}"
                                                            HorizontalAlignment="Stretch" />
                                        <ComboBox Header="{Binding Source={StaticResource Strings}, Path=DatePrecisionLabel}"
                                                  SelectedIndex="{Binding BirthDatePrecision, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="{Binding Source={StaticResource Strings}, Path=DatePrecisionFull}" />
                                            <ComboBoxItem Content="{Binding Source={StaticResource Strings}, Path=DatePrecisionMonthYear}" />
                                            <ComboBoxItem Content="{Binding Source={StaticResource Strings}, Path=DatePrecisionYearOnly}" />
                                        </ComboBox>

                                        <!-- Death Date -->
                                        <CalendarDatePicker Header="{Binding Source={StaticResource Strings}, Path=PersonDeathDateLabel}"
                                                            Date="{Binding DeathDate, Mode=TwoWay}"
                                                            HorizontalAlignment="Stretch" />
                                        <ComboBox Header="{Binding Source={StaticResource Strings}, Path=DatePrecisionLabel}"
                                                  SelectedIndex="{Binding DeathDatePrecision, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="{Binding Source={StaticResource Strings}, Path=DatePrecisionFull}" />
                                            <ComboBoxItem Content="{Binding Source={StaticResource Strings}, Path=DatePrecisionMonthYear}" />
                                            <ComboBoxItem Content="{Binding Source={StaticResource Strings}, Path=DatePrecisionYearOnly}" />
                                        </ComboBox>

                                        <!-- Webpage -->
                                        <TextBox Header="{Binding Source={StaticResource Strings}, Path=PersonWebpageLabel}"
                                                 Text="{Binding Webpage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <!-- Twitter -->
                                        <TextBox Header="{Binding Source={StaticResource Strings}, Path=PersonTwitterLabel}"
                                                 Text="{Binding Twitter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <!-- Facebook -->
                                        <TextBox Header="{Binding Source={StaticResource Strings}, Path=PersonFacebookLabel}"
                                                 Text="{Binding Facebook, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- Edit footer -->
                                <Grid Grid.Row="2" Padding="16,12"
                                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                      BorderThickness="0,1,0,0" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Content="{Binding Source={StaticResource Strings}, Path=CancelButton}"
                                            Command="{Binding CancelEditCommand}"
                                            HorizontalAlignment="Stretch" />
                                    <Button Grid.Column="1"
                                            Content="{Binding Source={StaticResource Strings}, Path=SaveButton}"
                                            Command="{Binding SaveCommand}"
                                            HorizontalAlignment="Stretch"
                                            Style="{ThemeResource AccentButtonStyle}" />
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Description Panel -->
                        <Border Grid.Column="1"
                                Visibility="{Binding IsEditingDescription, Converter={StaticResource BoolToVisibilityConverter}}"
                                Width="500"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="1,0,0,0">
                            <Grid RowSpacing="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Description header -->
                                <Grid Grid.Row="0"
                                      Padding="16,12"
                                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                      BorderThickness="0,0,0,1">
                                    <TextBlock Text="{Binding Source={StaticResource Strings}, Path=DescriptionDialogTitle}"
                                               FontSize="18"
                                               FontWeight="SemiBold" />
                                </Grid>

                                <!-- Language selector -->
                                <StackPanel Grid.Row="1"
                                            Padding="16,8"
                                            Spacing="4"
                                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                            BorderThickness="0,0,0,1">
                                    <TextBlock Text="{Binding Source={StaticResource Strings}, Path=LanguageLabel}"
                                               FontWeight="SemiBold" />
                                    <ComboBox ItemsSource="{Binding AvailableLanguages}"
                                              SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch"
                                              DisplayMemberPath="DisplayName" />
                                </StackPanel>

                                <!-- Existing translations list -->
                                <StackPanel Grid.Row="2"
                                            Padding="16,8"
                                            Spacing="4"
                                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                            BorderThickness="0,0,0,1">
                                    <TextBlock Text="{Binding Source={StaticResource Strings}, Path=ExistingTranslationsLabel}"
                                               FontWeight="SemiBold" />
                                    <ItemsRepeater ItemsSource="{Binding ExistingTranslations}">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Spacing="4" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Language}"
                                                               VerticalAlignment="Center" />
                                                    <Button Grid.Column="1"
                                                            Content="&#xE3C9;"
                                                            FontFamily="{StaticResource MaterialIconsFontFamily}"
                                                            Command="{Binding DataContext.EditTranslationCommand, ElementName=PageRoot}"
                                                            CommandParameter="{Binding}"
                                                            Padding="4,2"
                                                            Style="{ThemeResource TextBlockButtonStyle}" />
                                                    <Button Grid.Column="2"
                                                            Content="&#xE872;"
                                                            FontFamily="{StaticResource MaterialIconsFontFamily}"
                                                            Command="{Binding DataContext.DeleteTranslationCommand, ElementName=PageRoot}"
                                                            CommandParameter="{Binding}"
                                                            Padding="4,2"
                                                            Style="{ThemeResource TextBlockButtonStyle}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </StackPanel>

                                <!-- Description editor -->
                                <Grid Grid.Row="3"
                                      Margin="16"
                                      RowSpacing="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0"
                                          RowSpacing="6">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0"
                                                   Text="{Binding Source={StaticResource Strings}, Path=MarkdownSourceLabel}"
                                                   FontWeight="SemiBold" />
                                        <Border Grid.Row="1"
                                                MinHeight="180"
                                                Padding="1"
                                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                            <TextBox Text="{Binding DescriptionMarkdown, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     PlaceholderText="{Binding Source={StaticResource Strings}, Path=DescriptionMarkdownPlaceholder}"
                                                     VerticalAlignment="Stretch"
                                                     HorizontalAlignment="Stretch"
                                                     BorderThickness="0"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                        </Border>
                                    </Grid>

                                    <Grid Grid.Row="1"
                                          RowSpacing="6">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0"
                                                   Text="{Binding Source={StaticResource Strings}, Path=MarkdownPreviewLabel}"
                                                   FontWeight="SemiBold" />
                                        <Border Grid.Row="1"
                                                MinHeight="180"
                                                Padding="12"
                                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <local:MessageMarkdownView Markdown="{Binding DescriptionMarkdown}" />
                                            </ScrollViewer>
                                        </Border>
                                    </Grid>
                                </Grid>

                                <!-- Description footer -->
                                <Grid Grid.Row="4"
                                      Padding="16,12"
                                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                      BorderThickness="0,1,0,0"
                                      ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Content="{Binding Source={StaticResource Strings}, Path=CancelButton}"
                                            Command="{Binding CancelDescriptionCommand}"
                                            HorizontalAlignment="Stretch" />
                                    <Button Grid.Column="1"
                                            Content="{Binding Source={StaticResource Strings}, Path=SaveButton}"
                                            Command="{Binding SaveDescriptionCommand}"
                                            IsEnabled="{Binding CanSaveDescription}"
                                            HorizontalAlignment="Stretch"
                                            Style="{ThemeResource AccentButtonStyle}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
