<?xml version="1.0"
      encoding="utf-8"?>

<Page x:Class="Marechai.App.Presentation.Views.Admin.AdminSoundSynthVideosPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Name="PageRoot"
      NavigationCacheMode="Required"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,0,0,1"
              Padding="16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Content="&#xE5C4;"
                    FontFamily="{StaticResource MaterialIconsFontFamily}"
                    Command="{Binding GoBackCommand}"
                    Style="{ThemeResource TextBlockButtonStyle}"
                    Padding="8,4"
                    VerticalAlignment="Center"
                    Margin="0,0,12,0" />
            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center">
                <TextBlock FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextControlForeground}">
                    <Run Text="{Binding Source={StaticResource Strings}, Path=SoundSynthVideosTitle}" />
                    <Run Text=" - " />
                    <Run Text="{Binding SoundSynthName}" />
                </TextBlock>
                <TextBlock Text="{Binding Source={StaticResource Strings}, Path=SoundSynthVideosSubtitle}"
                           FontSize="12"
                           Foreground="{ThemeResource SystemBaseMediumColor}"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">

            <StackPanel Visibility="{Binding IsAdmin, Converter={StaticResource InvertBoolToVisibilityConverter}}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Padding="24"
                        Spacing="16"
                        MaxWidth="400">
                <InfoBar IsOpen="True"
                         Severity="Warning"
                         Title="{Binding Source={StaticResource Strings}, Path=SoundSynthVideosMgmtAccessDeniedTitle}"
                         Message="{Binding Source={StaticResource Strings}, Path=SoundSynthVideosMgmtAccessDeniedMessage}"
                         IsClosable="False" />
            </StackPanel>

            <Grid Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <CommandBar Grid.Row="0"
                            DefaultLabelPosition="Right">
                    <AppBarButton Icon="Refresh"
                                  Label="{Binding Source={StaticResource Strings}, Path=RefreshButton}"
                                  Command="{Binding LoadVideosCommand}" />
                </CommandBar>

                <ScrollViewer Grid.Row="1"
                              Grid.RowSpan="2"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="16"
                                Spacing="16">

                        <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Padding="32"
                                    Spacing="16">
                            <ProgressRing IsActive="True"
                                          IsIndeterminate="True"
                                          Height="64"
                                          Width="64"
                                          Foreground="{ThemeResource SystemAccentColor}" />
                            <TextBlock Text="{Binding Source={StaticResource Strings}, Path=LoadingText}"
                                       FontSize="14"
                                       TextAlignment="Center"
                                       Foreground="{ThemeResource SystemBaseMediumColor}" />
                        </StackPanel>

                        <InfoBar IsOpen="{Binding HasError}"
                                 Severity="Error"
                                 Title="{Binding Source={StaticResource Strings}, Path=ErrorTitle}"
                                 Message="{Binding ErrorMessage}"
                                 IsClosable="False" />

                        <InfoBar IsOpen="{Binding HasStatusMessage}"
                                 Severity="{Binding StatusSeverity}"
                                 Message="{Binding StatusMessage}"
                                 IsClosable="False" />

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{Binding Source={StaticResource Strings}, Path=SoundSynthVideosLinkSectionTitle}"
                                           FontSize="16"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Source={StaticResource Strings}, Path=SoundSynthVideosLinkSectionSubtitle}"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource SystemBaseMediumColor}" />

                                <TextBox Header="{Binding Source={StaticResource Strings}, Path=SoundSynthVideosUrlInputLabel}"
                                         Text="{Binding UrlInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="https://www.youtube.com/watch?v=..." />

                                <StackPanel Visibility="{Binding DetectedVideoId, Converter={StaticResource StringToVisibilityConverter}}"
                                            Spacing="4">
                                    <TextBlock Text="{Binding Source={StaticResource Strings}, Path=SoundSynthVideosDetectedIdLabel}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding DetectedVideoId}"
                                               Foreground="{ThemeResource SystemAccentColor}" />
                                </StackPanel>

                                <TextBox Header="{Binding Source={StaticResource Strings}, Path=TitleLabel}"
                                         Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="512" />

                                <Expander Header="{Binding Source={StaticResource Strings}, Path=SoundSynthVideosAdvancedSectionTitle}">
                                    <StackPanel Spacing="12"
                                                Padding="0,12,0,0">
                                        <TextBox Header="{Binding Source={StaticResource Strings}, Path=ProviderLabel}"
                                                 Text="{Binding Provider, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 MaxLength="32" />
                                        <TextBox Header="{Binding Source={StaticResource Strings}, Path=SoundSynthVideosManualIdLabel}"
                                                 Text="{Binding ManualVideoId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 MaxLength="128" />
                                        <TextBlock Text="{Binding Source={StaticResource Strings}, Path=SoundSynthVideosManualIdHelpText}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{ThemeResource SystemBaseMediumColor}" />
                                    </StackPanel>
                                </Expander>

                                <Button Content="{Binding Source={StaticResource Strings}, Path=SoundSynthVideosLinkButton}"
                                        Command="{Binding LinkVideoCommand}"
                                        Style="{ThemeResource AccentButtonStyle}"
                                        HorizontalAlignment="Left"
                                        IsEnabled="{Binding CanLinkVideo}" />
                            </StackPanel>
                        </Border>

                        <StackPanel Visibility="{Binding IsDataLoaded, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Spacing="12">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8">
                                <TextBlock Text="{Binding Source={StaticResource Strings}, Path=VideosLabel}"
                                           FontSize="16"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Videos.Count}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{ThemeResource SystemAccentColor}" />
                            </StackPanel>

                            <InfoBar IsOpen="True"
                                     Visibility="{Binding Videos.Count, Converter={StaticResource ZeroToVisibilityConverter}}"
                                     Severity="Informational"
                                     Message="{Binding Source={StaticResource Strings}, Path=SoundSynthVideosEmptyMessage}"
                                     IsClosable="False" />

                            <ItemsRepeater ItemsSource="{Binding Videos}">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout MinItemWidth="320"
                                                       MinItemHeight="360"
                                                       MinColumnSpacing="16"
                                                       MinRowSpacing="16"
                                                       ItemsStretch="Fill" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="12">
                                            <StackPanel Spacing="12">
                                                <Grid Height="160"
                                                      Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                      CornerRadius="6">
                                                    <Image Source="{Binding ThumbnailUrl}"
                                                           Stretch="UniformToFill"
                                                           Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    <StackPanel Visibility="{Binding HasThumbnail, Converter={StaticResource InvertBoolToVisibilityConverter}}"
                                                                VerticalAlignment="Center"
                                                                HorizontalAlignment="Center"
                                                                Spacing="8">
                                                        <FontIcon Glyph="&#xE04A;"
                                                                  FontFamily="{StaticResource MaterialIconsFontFamily}"
                                                                  FontSize="28"
                                                                  Foreground="{ThemeResource SystemAccentColor}" />
                                                        <TextBlock Text="{Binding Provider}"
                                                                   Foreground="{ThemeResource SystemBaseMediumColor}" />
                                                    </StackPanel>
                                                </Grid>

                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="{Binding Provider}"
                                                               FontSize="12"
                                                               Foreground="{ThemeResource SystemBaseMediumColor}" />
                                                    <TextBlock Text="{Binding VideoId}"
                                                               FontSize="12"
                                                               TextWrapping="WrapWholeWords"
                                                               Foreground="{ThemeResource TextControlForeground}" />
                                                </StackPanel>

                                                <TextBox Header="{Binding Source={StaticResource Strings}, Path=TitleLabel}"
                                                         Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         MaxLength="512" />

                                                <StackPanel Orientation="Horizontal"
                                                            Spacing="8">
                                                    <Button Content="{Binding Source={StaticResource Strings}, Path=SaveButton}"
                                                            Command="{Binding DataContext.SaveVideoTitleCommand, ElementName=PageRoot}"
                                                            CommandParameter="{Binding}"
                                                            Style="{ThemeResource AccentButtonStyle}" />
                                                    <Button Content="{Binding Source={StaticResource Strings}, Path=OpenVideoButton}"
                                                            Command="{Binding DataContext.OpenVideoCommand, ElementName=PageRoot}"
                                                            CommandParameter="{Binding}"
                                                            IsEnabled="{Binding CanOpenVideo}" />
                                                    <Button Content="{Binding Source={StaticResource Strings}, Path=DeleteButton}"
                                                            Command="{Binding DataContext.DeleteVideoCommand, ElementName=PageRoot}"
                                                            CommandParameter="{Binding}"
                                                            Foreground="{ThemeResource SystemErrorTextColor}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Page>
