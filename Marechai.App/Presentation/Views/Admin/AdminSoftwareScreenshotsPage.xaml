<?xml version="1.0"
      encoding="utf-8"?>

<Page x:Class="Marechai.App.Presentation.Views.Admin.AdminSoftwareScreenshotsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Name="PageRoot"
      NavigationCacheMode="Disabled"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,0,0,1"
              Padding="16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Content="&#xE72B;"
                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                    Command="{Binding GoBackCommand}"
                    Style="{ThemeResource TextBlockButtonStyle}"
                    Padding="8,4"
                    VerticalAlignment="Center"
                    Margin="0,0,12,0" />
            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center">
                <TextBlock Text="{Binding Source={StaticResource Strings}, Path=SoftwareScreenshotsTitle}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextControlForeground}" />
                <TextBlock Text="{Binding Source={StaticResource Strings}, Path=SoftwareScreenshotsSubtitle}"
                           FontSize="12"
                           Foreground="{ThemeResource SystemBaseMediumColor}"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="1">

            <!-- Access Denied -->
            <StackPanel Visibility="{Binding IsAdmin, Converter={StaticResource InvertBoolToVisibilityConverter}}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Padding="24"
                        Spacing="16"
                        MaxWidth="400">
                <InfoBar IsOpen="True"
                         Severity="Warning"
                         Title="{Binding Source={StaticResource Strings}, Path=AccessDeniedTitle}"
                         Message="{Binding Source={StaticResource Strings}, Path=AccessDeniedMessage}"
                         IsClosable="False" />
            </StackPanel>

            <!-- Content (admin only) -->
            <Grid Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}"
                  Canvas.ZIndex="0">

                <!-- Loading -->
                <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Padding="32"
                            Spacing="16">
                    <ProgressRing IsActive="True"
                                  IsIndeterminate="True"
                                  Height="64"
                                  Width="64"
                                  Foreground="{ThemeResource SystemAccentColor}" />
                    <TextBlock Text="{Binding Source={StaticResource Strings}, Path=LoadingText}"
                               FontSize="14"
                               TextAlignment="Center"
                               Foreground="{ThemeResource SystemBaseMediumColor}" />
                </StackPanel>

                <!-- Error -->
                <StackPanel Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Padding="24"
                            Spacing="16"
                            MaxWidth="400"
                            Canvas.ZIndex="100">
                    <InfoBar IsOpen="True"
                             Severity="Error"
                             Title="{Binding Source={StaticResource Strings}, Path=ErrorTitle}"
                             Message="{Binding ErrorMessage}"
                             IsClosable="False" />
                    <Button Content="{Binding Source={StaticResource Strings}, Path=RetryButton}"
                            Command="{Binding LoadCommand}"
                            HorizontalAlignment="Center"
                            Style="{ThemeResource AccentButtonStyle}" />
                </StackPanel>

                <!-- Uploading overlay -->
                <StackPanel Visibility="{Binding IsUploading, Converter={StaticResource BoolToVisibilityConverter}}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Padding="32"
                            Spacing="16"
                            Canvas.ZIndex="200">
                    <ProgressRing IsActive="True"
                                  IsIndeterminate="True"
                                  Height="64"
                                  Width="64"
                                  Foreground="{ThemeResource SystemAccentColor}" />
                    <TextBlock Text="{Binding Source={StaticResource Strings}, Path=UploadingScreenshotText}"
                               FontSize="14"
                               TextAlignment="Center"
                               Foreground="{ThemeResource SystemBaseMediumColor}" />
                </StackPanel>

                <!-- Screenshots grid -->
                <Grid Visibility="{Binding IsDataLoaded, Converter={StaticResource BoolToVisibilityConverter}}"
                      Canvas.ZIndex="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Command Bar -->
                    <CommandBar Grid.Row="0"
                                DefaultLabelPosition="Right">
                        <AppBarButton Icon="Refresh"
                                      Label="{Binding Source={StaticResource Strings}, Path=RefreshButton}"
                                      Command="{Binding LoadCommand}" />
                    </CommandBar>

                    <!-- Upload Section -->
                    <Border Grid.Row="1"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="16,12">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{Binding Source={StaticResource Strings}, Path=UploadScreenshotLabel}"
                                       FontSize="16"
                                       FontWeight="SemiBold" />

                            <!-- Software picker -->
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8">
                                <AutoSuggestBox PlaceholderText="{Binding Source={StaticResource Strings}, Path=SoftwareLabel}"
                                                Text="{Binding SoftwareSearchText, Mode=TwoWay}"
                                                ItemsSource="{Binding SoftwareSuggestions}"
                                                TextChanged="SoftwareAutoSuggestBox_TextChanged"
                                                SuggestionChosen="SoftwareAutoSuggestBox_SuggestionChosen"
                                                MinWidth="200" />

                                <AutoSuggestBox PlaceholderText="{Binding Source={StaticResource Strings}, Path=PlatformLabel}"
                                                Text="{Binding PlatformSearchText, Mode=TwoWay}"
                                                ItemsSource="{Binding PlatformSuggestions}"
                                                TextChanged="PlatformAutoSuggestBox_TextChanged"
                                                SuggestionChosen="PlatformAutoSuggestBox_SuggestionChosen"
                                                MinWidth="200" />

                                <AutoSuggestBox PlaceholderText="{Binding Source={StaticResource Strings}, Path=VersionLabel}"
                                                Text="{Binding VersionSearchText, Mode=TwoWay}"
                                                ItemsSource="{Binding VersionSuggestions}"
                                                TextChanged="VersionAutoSuggestBox_TextChanged"
                                                SuggestionChosen="VersionAutoSuggestBox_SuggestionChosen"
                                                MinWidth="200" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Spacing="8">
                                <TextBox Text="{Binding EditCaption, Mode=TwoWay}"
                                         PlaceholderText="{Binding Source={StaticResource Strings}, Path=CaptionLabel}"
                                         MinWidth="400" />
                                <Button Content="{Binding Source={StaticResource Strings}, Path=UploadScreenshotButton}"
                                        Command="{Binding UploadScreenshotCommand}"
                                        Style="{ThemeResource AccentButtonStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Edit panel -->
                    <Border Grid.Row="1"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="16,12"
                            Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{Binding Source={StaticResource Strings}, Path=EditScreenshotLabel}"
                                       FontSize="16"
                                       FontWeight="SemiBold" />

                            <TextBox Text="{Binding EditCaption, Mode=TwoWay}"
                                     PlaceholderText="{Binding Source={StaticResource Strings}, Path=CaptionLabel}"
                                     MinWidth="400" />

                            <StackPanel Orientation="Horizontal"
                                        Spacing="8">
                                <AutoSuggestBox PlaceholderText="{Binding Source={StaticResource Strings}, Path=PlatformLabel}"
                                                Text="{Binding PlatformSearchText, Mode=TwoWay}"
                                                ItemsSource="{Binding PlatformSuggestions}"
                                                TextChanged="PlatformAutoSuggestBox_TextChanged"
                                                SuggestionChosen="PlatformAutoSuggestBox_SuggestionChosen"
                                                MinWidth="200" />

                                <AutoSuggestBox PlaceholderText="{Binding Source={StaticResource Strings}, Path=VersionLabel}"
                                                Text="{Binding VersionSearchText, Mode=TwoWay}"
                                                ItemsSource="{Binding VersionSuggestions}"
                                                TextChanged="VersionAutoSuggestBox_TextChanged"
                                                SuggestionChosen="VersionAutoSuggestBox_SuggestionChosen"
                                                MinWidth="200" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Spacing="8">
                                <Button Content="{Binding Source={StaticResource Strings}, Path=SaveButton}"
                                        Command="{Binding SaveEditCommand}"
                                        Style="{ThemeResource AccentButtonStyle}" />
                                <Button Content="{Binding Source={StaticResource Strings}, Path=CancelButton}"
                                        Command="{Binding CancelEditCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Screenshot items grid -->
                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="16">
                        <ItemsRepeater ItemsSource="{Binding Screenshots}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="240"
                                                   MinItemHeight="280"
                                                   MinColumnSpacing="16"
                                                   MinRowSpacing="16"
                                                   ItemsStretch="Fill" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="12">
                                        <Grid RowSpacing="8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- Thumbnail -->
                                            <Image Grid.Row="0"
                                                   Source="{Binding ThumbnailSource}"
                                                   Stretch="Uniform"
                                                   MaxHeight="160"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />

                                            <!-- Software + Platform -->
                                            <TextBlock Grid.Row="1"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource SystemBaseMediumColor}"
                                                       HorizontalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding SoftwareName}" />
                                                <Run Text=" — " />
                                                <Run Text="{Binding PlatformName}" />
                                            </TextBlock>

                                            <!-- Caption -->
                                            <TextBlock Grid.Row="2"
                                                       Text="{Binding Caption}"
                                                       FontSize="11"
                                                       Foreground="{ThemeResource SystemBaseMediumColor}"
                                                       HorizontalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />

                                            <!-- Action buttons -->
                                            <StackPanel Grid.Row="3"
                                                        Orientation="Horizontal"
                                                        HorizontalAlignment="Center"
                                                        Spacing="8">
                                                <Button Content="{Binding Source={StaticResource Strings}, Path=ViewDetailsButton}"
                                                        Command="{Binding DataContext.ViewScreenshotCommand, ElementName=PageRoot}"
                                                        CommandParameter="{Binding}"
                                                        Style="{ThemeResource TextBlockButtonStyle}"
                                                        Padding="8,4" />
                                                <Button Content="{Binding Source={StaticResource Strings}, Path=EditButton}"
                                                        Command="{Binding DataContext.OpenEditCommand, ElementName=PageRoot}"
                                                        CommandParameter="{Binding}"
                                                        Style="{ThemeResource TextBlockButtonStyle}"
                                                        Padding="8,4" />
                                                <Button Content="{Binding Source={StaticResource Strings}, Path=DeleteButton}"
                                                        Command="{Binding DataContext.DeleteScreenshotCommand, ElementName=PageRoot}"
                                                        CommandParameter="{Binding}"
                                                        Foreground="{ThemeResource SystemErrorTextColor}"
                                                        Style="{ThemeResource TextBlockButtonStyle}"
                                                        Padding="8,4" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
