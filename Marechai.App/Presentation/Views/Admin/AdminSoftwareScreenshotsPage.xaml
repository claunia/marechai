<?xml version="1.0"
      encoding="utf-8"?>

<Page x:Class="Marechai.App.Presentation.Views.Admin.AdminSoftwareScreenshotsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:models="using:Marechai.App.Presentation.Models"
      x:Name="PageRoot"
      NavigationCacheMode="Disabled"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,0,0,1"
              Padding="16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Content="&#xE72B;"
                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                    Command="{Binding GoBackCommand}"
                    Style="{ThemeResource TextBlockButtonStyle}"
                    Padding="8,4"
                    VerticalAlignment="Center"
                    Margin="0,0,12,0" />
            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center">
                <TextBlock Text="{Binding PageTitle}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextControlForeground}" />
                <TextBlock Text="{Binding Source={StaticResource Strings}, Path=SoftwareScreenshotsSubtitle}"
                           FontSize="12"
                           Foreground="{ThemeResource SystemBaseMediumColor}"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="1">

            <!-- Access Denied -->
            <StackPanel Visibility="{Binding IsAdmin, Converter={StaticResource InvertBoolToVisibilityConverter}}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Padding="24"
                        Spacing="16"
                        MaxWidth="400">
                <InfoBar IsOpen="True"
                         Severity="Warning"
                         Title="{Binding Source={StaticResource Strings}, Path=AccessDeniedTitle}"
                         Message="{Binding Source={StaticResource Strings}, Path=AccessDeniedMessage}"
                         IsClosable="False" />
            </StackPanel>

            <!-- Content (admin only) -->
            <Grid Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}"
                  Canvas.ZIndex="0">

                <!-- Loading -->
                <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Padding="32"
                            Spacing="16">
                    <ProgressRing IsActive="True"
                                  IsIndeterminate="True"
                                  Height="64"
                                  Width="64"
                                  Foreground="{ThemeResource SystemAccentColor}" />
                    <TextBlock Text="{Binding Source={StaticResource Strings}, Path=LoadingText}"
                               FontSize="14"
                               TextAlignment="Center"
                               Foreground="{ThemeResource SystemBaseMediumColor}" />
                </StackPanel>

                <!-- Error -->
                <StackPanel Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Padding="24"
                            Spacing="16"
                            MaxWidth="400"
                            Canvas.ZIndex="100">
                    <InfoBar IsOpen="True"
                             Severity="Error"
                             Title="{Binding Source={StaticResource Strings}, Path=ErrorTitle}"
                             Message="{Binding ErrorMessage}"
                             IsClosable="False" />
                    <Button Content="{Binding Source={StaticResource Strings}, Path=RetryButton}"
                            Command="{Binding LoadCommand}"
                            HorizontalAlignment="Center"
                            Style="{ThemeResource AccentButtonStyle}" />
                </StackPanel>

                <!-- Screenshots grid -->
                <Grid Visibility="{Binding IsDataLoaded, Converter={StaticResource BoolToVisibilityConverter}}"
                      Canvas.ZIndex="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Command Bar -->
                    <CommandBar Grid.Row="0"
                                DefaultLabelPosition="Right">
                        <AppBarButton Icon="Refresh"
                                      Label="{Binding Source={StaticResource Strings}, Path=RefreshButton}"
                                      Command="{Binding LoadCommand}" />
                    </CommandBar>

                    <InfoBar Grid.Row="1"
                             Margin="16,12,16,0"
                             IsOpen="{Binding HasStatusMessage}"
                             Severity="{Binding StatusSeverity}"
                             Message="{Binding StatusMessage}"
                             IsClosable="False" />

                    <!-- Batch upload section -->
                    <Border Grid.Row="2"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="16,12">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{Binding Source={StaticResource Strings}, Path=SoftwareScreenshotsBatchSectionTitle}"
                                       FontSize="16"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Source={StaticResource Strings}, Path=SoftwareScreenshotsBatchSectionSubtitle}"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource SystemBaseMediumColor}" />

                            <!-- Software / Platform / Version pickers (determine batch scope) -->
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8">
                                <AutoSuggestBox PlaceholderText="{Binding Source={StaticResource Strings}, Path=PlatformLabel}"
                                                Text="{Binding PlatformSearchText, Mode=TwoWay}"
                                                ItemsSource="{Binding PlatformSuggestions}"
                                                TextChanged="PlatformAutoSuggestBox_TextChanged"
                                                SuggestionChosen="PlatformAutoSuggestBox_SuggestionChosen"
                                                MinWidth="200" />

                                <AutoSuggestBox PlaceholderText="{Binding Source={StaticResource Strings}, Path=VersionLabel}"
                                                Text="{Binding VersionSearchText, Mode=TwoWay}"
                                                ItemsSource="{Binding VersionSuggestions}"
                                                TextChanged="VersionAutoSuggestBox_TextChanged"
                                                SuggestionChosen="VersionAutoSuggestBox_SuggestionChosen"
                                                MinWidth="200" />

                                <TextBox Text="{Binding CanonicalGroupName, Mode=TwoWay}"
                                         PlaceholderText="{Binding Source={StaticResource Strings}, Path=GroupNameLabel}"
                                         MinWidth="200" />
                            </StackPanel>

                            <Grid ColumnSpacing="12"
                                  RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Column="1"
                                            Grid.Row="0"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <Button Content="{Binding Source={StaticResource Strings}, Path=SoftwareScreenshotsAddImagesButton}"
                                            Command="{Binding AddScreenshotsCommand}"
                                            Style="{ThemeResource AccentButtonStyle}"
                                            IsEnabled="{Binding CanAddMoreScreenshots}" />
                                    <Button Content="{Binding Source={StaticResource Strings}, Path=SoftwareScreenshotsClearStagedButton}"
                                            Command="{Binding ClearStagedScreenshotsCommand}"
                                            IsEnabled="{Binding CanClearStaged}" />
                                </StackPanel>

                                <TextBlock Grid.Column="0"
                                           Grid.Row="1"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource SystemBaseMediumColor}">
                                    <Run Text="{Binding StagedScreenshots.Count}" />
                                    <Run Text="/" />
                                    <Run Text="25" />
                                </TextBlock>

                                <StackPanel Grid.Column="1"
                                            Grid.Row="1"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            HorizontalAlignment="Right">
                                    <Button Content="{Binding Source={StaticResource Strings}, Path=SoftwareScreenshotsSubmitBatchButton}"
                                            Command="{Binding SubmitBatchCommand}"
                                            Style="{ThemeResource AccentButtonStyle}"
                                            IsEnabled="{Binding CanSubmitBatch}" />
                                </StackPanel>
                            </Grid>

                            <InfoBar IsOpen="{Binding ShowBatchProgress}"
                                     Severity="Informational"
                                     Title="{Binding Source={StaticResource Strings}, Path=SoftwareScreenshotsProcessingTitle}"
                                     Message="{Binding BatchProgressText}"
                                     IsClosable="False" />

                            <ProgressBar Visibility="{Binding ShowBatchProgress, Converter={StaticResource BoolToVisibilityConverter}}"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{Binding BatchProgressPercent}"
                                         Height="8" />

                            <InfoBar IsOpen="{Binding ShowBatchSummary}"
                                     Severity="{Binding StatusSeverity}"
                                     Message="{Binding StatusMessage}"
                                     IsClosable="False" />
                        </StackPanel>
                    </Border>

                    <!-- Edit panel -->
                    <Border Grid.Row="3"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="16,12"
                            Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{Binding Source={StaticResource Strings}, Path=EditScreenshotLabel}"
                                       FontSize="16"
                                       FontWeight="SemiBold" />

                            <TextBox Text="{Binding EditCaption, Mode=TwoWay}"
                                     PlaceholderText="{Binding Source={StaticResource Strings}, Path=CaptionLabel}"
                                     MinWidth="400" />

                            <StackPanel Orientation="Horizontal"
                                        Spacing="8">
                                <AutoSuggestBox PlaceholderText="{Binding Source={StaticResource Strings}, Path=PlatformLabel}"
                                                Text="{Binding PlatformSearchText, Mode=TwoWay}"
                                                ItemsSource="{Binding PlatformSuggestions}"
                                                TextChanged="PlatformAutoSuggestBox_TextChanged"
                                                SuggestionChosen="PlatformAutoSuggestBox_SuggestionChosen"
                                                MinWidth="200" />

                                <AutoSuggestBox PlaceholderText="{Binding Source={StaticResource Strings}, Path=VersionLabel}"
                                                Text="{Binding VersionSearchText, Mode=TwoWay}"
                                                ItemsSource="{Binding VersionSuggestions}"
                                                TextChanged="VersionAutoSuggestBox_TextChanged"
                                                SuggestionChosen="VersionAutoSuggestBox_SuggestionChosen"
                                                MinWidth="200" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Spacing="8">
                                <Button Content="{Binding Source={StaticResource Strings}, Path=SaveButton}"
                                        Command="{Binding SaveEditCommand}"
                                        Style="{ThemeResource AccentButtonStyle}" />
                                <Button Content="{Binding Source={StaticResource Strings}, Path=CancelButton}"
                                        Command="{Binding CancelEditCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Staged screenshots -->
                    <ScrollViewer Grid.Row="4"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="16,12,16,0"
                                  MaxHeight="420">
                        <StackPanel>
                            <InfoBar IsOpen="{Binding HasStagedScreenshots, Converter={StaticResource InvertBoolConverter}}"
                                     Severity="Informational"
                                     Message="{Binding Source={StaticResource Strings}, Path=SoftwareScreenshotsNoImagesStaged}"
                                     IsClosable="False" />

                            <ItemsRepeater ItemsSource="{Binding StagedScreenshots}"
                                           Visibility="{Binding HasStagedScreenshots, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout MinItemWidth="250"
                                                       MinItemHeight="320"
                                                       MinColumnSpacing="16"
                                                       MinRowSpacing="16"
                                                       ItemsStretch="Fill" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="models:AdminSoftwareScreenshotStagedItem">
                                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="12">
                                            <Grid RowSpacing="8">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>

                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{x:Bind FileName}"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <Button Grid.Column="1"
                                                            Content="&#xE711;"
                                                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                            Command="{Binding DataContext.RemoveStagedScreenshotCommand, ElementName=PageRoot}"
                                                            CommandParameter="{Binding}"
                                                            IsEnabled="{x:Bind CanRemove}"
                                                            Style="{ThemeResource TextBlockButtonStyle}"
                                                            Padding="4,0" />
                                                </Grid>

                                                <Border Grid.Row="1"
                                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                        CornerRadius="6"
                                                        Height="160">
                                                    <Grid>
                                                        <Image Source="{x:Bind ThumbnailImageSource}"
                                                               Stretch="Uniform"
                                                               Visibility="{x:Bind ShowThumbnail, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                        <ProgressRing IsActive="True"
                                                                      Width="32"
                                                                      Height="32"
                                                                      Visibility="{x:Bind ShowProgress, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                        <TextBlock Text="{Binding Source={StaticResource Strings}, Path=SoftwareScreenshotsPreviewUnavailable}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{ThemeResource SystemBaseMediumColor}"
                                                                   TextWrapping="Wrap"
                                                                   TextAlignment="Center"
                                                                   Visibility="{x:Bind ShowThumbnail, Converter={StaticResource InvertBoolToVisibilityConverter}}" />
                                                    </Grid>
                                                </Border>

                                                <StackPanel Grid.Row="2"
                                                            Spacing="2">
                                                    <TextBlock Text="{x:Bind StatusText}"
                                                               Foreground="{ThemeResource SystemBaseMediumColor}" />
                                                    <TextBlock Text="{x:Bind FileSizeText}"
                                                               Foreground="{ThemeResource SystemBaseMediumColor}" />
                                                    <TextBlock Text="{x:Bind DimensionsText}"
                                                               Foreground="{ThemeResource SystemBaseMediumColor}" />
                                                </StackPanel>

                                                <StackPanel Grid.Row="3"
                                                            Spacing="8">
                                                    <TextBox Text="{x:Bind Caption, Mode=TwoWay}"
                                                             PlaceholderText="{Binding Source={StaticResource Strings}, Path=CaptionLabel}"
                                                             IsEnabled="{x:Bind IsReady}" />
                                                    <ProgressBar Minimum="0"
                                                                 Maximum="100"
                                                                 Value="{x:Bind UploadPercent}"
                                                                 Visibility="{x:Bind ShowProgress, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    <TextBlock Text="{x:Bind ErrorText}"
                                                               Foreground="{ThemeResource SystemErrorTextColor}"
                                                               TextWrapping="Wrap"
                                                               Visibility="{x:Bind ShowError, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Screenshot items grid -->
                    <ScrollViewer Grid.Row="5"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="16">
                        <ItemsRepeater ItemsSource="{Binding Screenshots}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="240"
                                                   MinItemHeight="280"
                                                   MinColumnSpacing="16"
                                                   MinRowSpacing="16"
                                                   ItemsStretch="Fill" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="12">
                                        <Grid RowSpacing="8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- Thumbnail -->
                                            <Image Grid.Row="0"
                                                   Source="{Binding ThumbnailSource}"
                                                   Stretch="Uniform"
                                                   MaxHeight="160"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />

                                            <!-- Software + Platform -->
                                            <TextBlock Grid.Row="1"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource SystemBaseMediumColor}"
                                                       HorizontalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding SoftwareName}" />
                                                <Run Text=" — " />
                                                <Run Text="{Binding PlatformName}" />
                                            </TextBlock>

                                            <!-- Caption -->
                                            <TextBlock Grid.Row="2"
                                                       Text="{Binding Caption}"
                                                       FontSize="11"
                                                       Foreground="{ThemeResource SystemBaseMediumColor}"
                                                       HorizontalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />

                                            <!-- Action buttons -->
                                            <StackPanel Grid.Row="3"
                                                        Orientation="Horizontal"
                                                        HorizontalAlignment="Center"
                                                        Spacing="8">
                                                <Button Content="{Binding Source={StaticResource Strings}, Path=ViewDetailsButton}"
                                                        Command="{Binding DataContext.ViewScreenshotCommand, ElementName=PageRoot}"
                                                        CommandParameter="{Binding}"
                                                        Style="{ThemeResource TextBlockButtonStyle}"
                                                        Padding="8,4" />
                                                <Button Content="{Binding Source={StaticResource Strings}, Path=EditButton}"
                                                        Command="{Binding DataContext.OpenEditCommand, ElementName=PageRoot}"
                                                        CommandParameter="{Binding}"
                                                        Style="{ThemeResource TextBlockButtonStyle}"
                                                        Padding="8,4" />
                                                <Button Content="{Binding Source={StaticResource Strings}, Path=DeleteButton}"
                                                        Command="{Binding DataContext.DeleteScreenshotCommand, ElementName=PageRoot}"
                                                        CommandParameter="{Binding}"
                                                        Foreground="{ThemeResource SystemErrorTextColor}"
                                                        Style="{ThemeResource TextBlockButtonStyle}"
                                                        Padding="8,4" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
