<?xml version="1.0"
      encoding="utf-8"?>

<Page x:Class="Marechai.App.Presentation.Views.Admin.UsersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:loc="using:Marechai.App.Presentation.Converters"
      xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
      x:Name="PageRoot"
      NavigationCacheMode="Required"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header with Title -->
        <Grid Grid.Row="0"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,0,0,1"
              Padding="16,12">

            <!-- Page Title -->
            <StackPanel VerticalAlignment="Center">
                <TextBlock
                           Text="{Binding Source={StaticResource Strings}, Path=UserManagementTitle}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextControlForeground}" />
                <TextBlock
                           Text="{Binding Source={StaticResource Strings}, Path=UserManagementSubtitle}"
                           FontSize="12"
                           Foreground="{ThemeResource SystemBaseMediumColor}"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="1">

            <!-- Access Denied Message -->
            <StackPanel Visibility="{Binding IsUberadmin, Converter={StaticResource InvertBoolToVisibilityConverter}}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Padding="24"
                        Spacing="16"
                        MaxWidth="400">
                <InfoBar IsOpen="True"
                         Severity="Warning"
                         Title="{Binding Source={StaticResource Strings}, Path=UserMgmtAccessDeniedInfoBar_Title}"
                         Message="You must be an Uberadmin to access user management."
                         IsClosable="False" />
            </StackPanel>

            <!-- Content (only visible to Uberadmin) -->
            <Grid Visibility="{Binding IsUberadmin, Converter={StaticResource BoolToVisibilityConverter}}"
                  Canvas.ZIndex="0">

                <!-- Loading State -->
                <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Padding="32"
                            Spacing="16">
                    <ProgressRing IsActive="True"
                                  IsIndeterminate="True"
                                  Height="64"
                                  Width="64"
                                  Foreground="{ThemeResource SystemAccentColor}" />
                    <TextBlock
                               Text="{Binding Source={StaticResource Strings}, Path=LoadingText}"
                               FontSize="14"
                               TextAlignment="Center"
                               Foreground="{ThemeResource SystemBaseMediumColor}" />
                </StackPanel>

                <!-- Error State -->
                <StackPanel Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Padding="24"
                            Spacing="16"
                            MaxWidth="400"
                            Canvas.ZIndex="100">
                    <InfoBar IsOpen="True"
                             Severity="Error"
                             Title="{Binding Source={StaticResource Strings}, Path=ErrorLoadingUsersInfoBar_Title}"
                             Message="{Binding ErrorMessage}"
                             IsClosable="False" />
                    <Button Content="Retry"
                            Command="{Binding LoadUsersCommand}"
                            HorizontalAlignment="Center"
                            Style="{ThemeResource AccentButtonStyle}" />
                </StackPanel>

                <!-- Users DataGrid -->
                <Grid Visibility="{Binding IsDataLoaded, Converter={StaticResource BoolToVisibilityConverter}}"
                      Canvas.ZIndex="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <RowDefinition Height="*" /> <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Command Bar -->
                    <CommandBar Grid.Row="0"
                                DefaultLabelPosition="Right">
                        <AppBarButton Icon="Add"
                                      Label="{Binding Source={StaticResource Strings}, Path=AddUserButton}"
                                      Command="{Binding OpenAddUserDialogCommand}" />
                        <AppBarButton Icon="Refresh"
                                      Label="{Binding Source={StaticResource Strings}, Path=RefreshUsersButton}"
                                      Command="{Binding LoadUsersCommand}" />
                    </CommandBar>

                    <!-- DataGrid -->
                    <controls:DataGrid Grid.Row="1"
                                       Margin="16"
                                       ItemsSource="{Binding Users}"
                                       SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
                                       AutoGenerateColumns="False"
                                       GridLinesVisibility="None"
                                       HeadersVisibility="Column"
                                       AlternatingRowBackground="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                       CanUserReorderColumns="True"
                                       CanUserResizeColumns="True"
                                       CanUserSortColumns="True"
                                       IsReadOnly="True"
                                       SelectionMode="Single"
                                       HorizontalScrollBarVisibility="Auto"
                                       VerticalScrollBarVisibility="Auto">

                        <controls:DataGrid.Columns>
                            <controls:DataGridTextColumn
                                                         Header="{Binding Source={StaticResource Strings}, Path=EmailColumn_Header}"
                                                         Binding="{Binding Email}"
                                                         Width="2*" />

                            <controls:DataGridTextColumn
                                                         Header="{Binding Source={StaticResource Strings}, Path=UsernameColumn_Header}"
                                                         Binding="{Binding UserName}"
                                                         Width="*" />

                            <controls:DataGridTextColumn
                                                         Header="{Binding Source={StaticResource Strings}, Path=PhoneColumn_Header}"
                                                         Binding="{Binding PhoneNumber}"
                                                         Width="*" />

                            <controls:DataGridTextColumn
                                                         Header="{Binding Source={StaticResource Strings}, Path=RolesColumn_Header}"
                                                         Width="2*"
                                                         Binding="{Binding Roles, Converter={StaticResource RolesListConverter}}" />

                            <controls:DataGridTemplateColumn Text="{Binding Source={StaticResource Strings}, Path=ActionsColumn}"
                                                             Header="Actions"
                                                             Width="Auto">
                                <controls:DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="4">
                                            <Button Content="&#xE70F;"
                                                            ToolTipService.ToolTip="{Binding Source={StaticResource Strings}, Path=EditUserButton}"
                                                    Command="{Binding DataContext.OpenEditUserDialogCommand, ElementName=PageRoot}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource AdminGridActionButtonStyle}" />
                                            <Button Content="&#xE192;"
                                                            ToolTipService.ToolTip="{Binding Source={StaticResource Strings}, Path=ChangePasswordButton}"
                                                    Command="{Binding DataContext.OpenChangePasswordDialogCommand, ElementName=PageRoot}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource AdminGridActionButtonStyle}" />
                                            <Button Content="&#xE713;"
                                                            ToolTipService.ToolTip="{Binding Source={StaticResource Strings}, Path=ManageRolesButton}"
                                                    Command="{Binding DataContext.OpenManageRolesDialogCommand, ElementName=PageRoot}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource AdminGridActionButtonStyle}" />
                                            <Button Content="&#xE72E;"
                                                            ToolTipService.ToolTip="{Binding Source={StaticResource Strings}, Path=DisableTwoFactorButton}"
                                                    Command="{Binding DataContext.DisableUserTwoFactorCommand, ElementName=PageRoot}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding TwoFactorEnabled, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Style="{StaticResource AdminGridDestructiveActionButtonStyle}" />
                                            <Button Content="&#xE74D;"
                                                            ToolTipService.ToolTip="{Binding Source={StaticResource Strings}, Path=DeleteUserButton}"
                                                    Command="{Binding DataContext.DeleteUserCommand, ElementName=PageRoot}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource AdminGridDestructiveActionButtonStyle}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </controls:DataGridTemplateColumn.CellTemplate>
                            </controls:DataGridTemplateColumn>
                        </controls:DataGrid.Columns>
                    </controls:DataGrid>

                    <Grid Grid.Row="2"
                          Margin="16,0,16,16"
                          ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Content="Previous"
                                Command="{Binding PreviousPageCommand}"
                                IsEnabled="{Binding CanGoPrevious}" />
                        <Button Grid.Column="1"
                                Content="Next"
                                Command="{Binding NextPageCommand}"
                                IsEnabled="{Binding CanGoNext}" />
                        <TextBlock Grid.Column="2"
                                   VerticalAlignment="Center"
                                   Text="{Binding PageSummary}" />
                        <TextBlock Grid.Column="3"
                                   VerticalAlignment="Center"
                                   Text="{Binding Source={StaticResource Strings}, Path=SoftwareAttributesPageSizeLabel}" />
                        <ComboBox Grid.Column="4"
                                  Width="96"
                                  ItemsSource="{Binding PageSizeOptions}"
                                  SelectedItem="{Binding PageSize, Mode=TwoWay}"
                                  SelectionChanged="PageSizeCombo_SelectionChanged" />
                    </Grid>
                </Grid>

            </Grid>
        </Grid>
    </Grid>
</Page>
