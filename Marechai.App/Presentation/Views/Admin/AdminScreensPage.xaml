<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="Marechai.App.Presentation.Views.Admin.AdminScreensPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
      x:Name="PageRoot" NavigationCacheMode="Required"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid RowSpacing="0">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="16,12">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Source={StaticResource Strings}, Path=ScreenManagementTitle}"
                           FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource TextControlForeground}" />
                <TextBlock Text="{Binding Source={StaticResource Strings}, Path=ScreenManagementSubtitle}"
                           FontSize="12" Foreground="{ThemeResource SystemBaseMediumColor}" Margin="0,4,0,0" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1">
            <StackPanel Visibility="{Binding IsAdmin, Converter={StaticResource InvertBoolToVisibilityConverter}}"
                        VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24" Spacing="16" MaxWidth="400">
                <InfoBar IsOpen="True" Severity="Warning"
                         Title="{Binding Source={StaticResource Strings}, Path=ScreenMgmtAccessDeniedTitle}"
                         Message="{Binding Source={StaticResource Strings}, Path=ScreenMgmtAccessDeniedMessage}" IsClosable="False" />
            </StackPanel>
            <Grid Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}" Canvas.ZIndex="0">
                <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                            VerticalAlignment="Center" HorizontalAlignment="Center" Padding="32" Spacing="16">
                    <ProgressRing IsActive="True" IsIndeterminate="True" Height="64" Width="64" Foreground="{ThemeResource SystemAccentColor}" />
                    <TextBlock Text="{Binding Source={StaticResource Strings}, Path=LoadingText}" FontSize="14" TextAlignment="Center" Foreground="{ThemeResource SystemBaseMediumColor}" />
                </StackPanel>
                <StackPanel Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"
                            VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24" Spacing="16" MaxWidth="400" Canvas.ZIndex="100">
                    <InfoBar IsOpen="True" Severity="Error" Title="{Binding Source={StaticResource Strings}, Path=ErrorTitle}" Message="{Binding ErrorMessage}" IsClosable="False" />
                    <Button Content="{Binding Source={StaticResource Strings}, Path=RetryButton}" Command="{Binding LoadItemsCommand}" HorizontalAlignment="Center" Style="{ThemeResource AccentButtonStyle}" />
                </StackPanel>
                <Grid Visibility="{Binding IsDataLoaded, Converter={StaticResource BoolToVisibilityConverter}}" Canvas.ZIndex="1">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <CommandBar Grid.Row="0" DefaultLabelPosition="Right">
                                <AppBarButton Icon="Add" Label="{Binding Source={StaticResource Strings}, Path=AddScreenButton}" Command="{Binding OpenAddCommand}" />
                                <AppBarButton Icon="Refresh" Label="{Binding Source={StaticResource Strings}, Path=RefreshScreensButton}" Command="{Binding LoadItemsCommand}" />
                            </CommandBar>
                            <AutoSuggestBox Grid.Row="1" Margin="16,8,16,0"
                                            PlaceholderText="{Binding Source={StaticResource Strings}, Path=ScreenSearchPlaceholder}"
                                            QueryIcon="Find" Text="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            x:Name="FilterBox" TextChanged="FilterBox_TextChanged" />
                            <controls:DataGrid Grid.Row="2" Margin="16" ItemsSource="{Binding FilteredScreens}"
                                               SelectedItem="{Binding SelectedScreen, Mode=TwoWay}" AutoGenerateColumns="False"
                                               GridLinesVisibility="None" HeadersVisibility="Column"
                                               AlternatingRowBackground="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                               CanUserReorderColumns="True" CanUserResizeColumns="True" CanUserSortColumns="True"
                                               IsReadOnly="True" SelectionMode="Single"
                                               HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <controls:DataGrid.Columns>
                                    <controls:DataGridTextColumn Header="{Binding Source={StaticResource Strings}, Path=ScreenDiagonalColumn}" Binding="{Binding Diagonal}" Width="*" />
                                    <controls:DataGridTextColumn Header="{Binding Source={StaticResource Strings}, Path=ScreenTypeColumn}" Binding="{Binding Type}" Width="*" />
                                    <controls:DataGridTextColumn Header="{Binding Source={StaticResource Strings}, Path=ScreenSizeColumn}" Binding="{Binding Size}" Width="*" />
                                    <controls:DataGridTemplateColumn Header="{Binding Source={StaticResource Strings}, Path=ActionsColumn}" Width="Auto">
                                        <controls:DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <Button Content="&#xE3C9;"
                                                            ToolTipService.ToolTip="{Binding Source={StaticResource Strings}, Path=EditScreenButton}"
                                                            Command="{Binding DataContext.OpenEditCommand, ElementName=PageRoot}" CommandParameter="{Binding}"
                                                            Style="{StaticResource AdminGridActionButtonStyle}" />
                                                    <Button Content="&#xE872;"
                                                            ToolTipService.ToolTip="{Binding Source={StaticResource Strings}, Path=DeleteScreenButton}"
                                                            Command="{Binding DataContext.DeleteCommand, ElementName=PageRoot}" CommandParameter="{Binding}"
                                                            Style="{StaticResource AdminGridDestructiveActionButtonStyle}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </controls:DataGridTemplateColumn.CellTemplate>
                                    </controls:DataGridTemplateColumn>
                                </controls:DataGrid.Columns>
                            </controls:DataGrid>
                        </Grid>
                        <Border Grid.Column="1" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}"
                                Width="400" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
                            <Grid RowSpacing="0">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid Grid.Row="0" Padding="16,12" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                    <TextBlock Text="{Binding EditPanelTitle}" FontSize="18" FontWeight="SemiBold" />
                                </Grid>
                                <ScrollViewer Grid.Row="1" Padding="16" VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="12">
                                        <NumberBox Header="{Binding Source={StaticResource Strings}, Path=ScreenDiagonalLabel}"
                                                   Value="{Binding Diagonal, Mode=TwoWay}" SpinButtonPlacementMode="Compact"
                                                   Minimum="0.1" SmallChange="0.1" HorizontalAlignment="Stretch" />
                                        <TextBox Header="{Binding Source={StaticResource Strings}, Path=ScreenTypeLabel}"
                                                 Text="{Binding ScreenType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <NumberBox Header="{Binding Source={StaticResource Strings}, Path=ScreenWidthLabel}"
                                                   Value="{Binding Width, Mode=TwoWay}" SpinButtonPlacementMode="Compact"
                                                   Minimum="1" SmallChange="1" HorizontalAlignment="Stretch" />
                                        <NumberBox Header="{Binding Source={StaticResource Strings}, Path=ScreenHeightLabel}"
                                                   Value="{Binding Height, Mode=TwoWay}" SpinButtonPlacementMode="Compact"
                                                   Minimum="1" SmallChange="1" HorizontalAlignment="Stretch" />
                                        <NumberBox Header="{Binding Source={StaticResource Strings}, Path=ScreenEffectiveColorsLabel}"
                                                   Value="{Binding EffectiveColors, Mode=TwoWay}" SpinButtonPlacementMode="Compact"
                                                   Minimum="2" SmallChange="1" HorizontalAlignment="Stretch" />

                                        <!-- Native Resolution picker -->
                                        <AutoSuggestBox Header="{Binding Source={StaticResource Strings}, Path=ScreenNativeResolutionLabel}"
                                                        PlaceholderText="{Binding Source={StaticResource Strings}, Path=ResolutionSearchPlaceholder}"
                                                        Text="{Binding ResolutionFilterText, Mode=TwoWay}" QueryIcon="Find"
                                                        x:Name="ResolutionFilterBox" TextChanged="ResolutionFilterBox_TextChanged" />
                                        <ComboBox ItemsSource="{Binding FilteredResolutions}"
                                                  SelectedItem="{Binding SelectedResolution, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch"
                                                  PlaceholderText="{Binding Source={StaticResource Strings}, Path=ScreenNativeResolutionLabel}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock>
                                                        <Run Text="{Binding Width}" /><Run Text="x" /><Run Text="{Binding Height}" />
                                                        <Run Text=" " /><Run Text="{Binding Colors}" />
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <!-- Supported Resolutions -->
                                        <TextBlock Text="{Binding Source={StaticResource Strings}, Path=ScreenSupportedResolutionsHeader}"
                                                   FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0" />

                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox Grid.Column="0"
                                                      ItemsSource="{Binding AvailableSupportedResolutions}"
                                                      SelectedItem="{Binding SelectedSupportedResolution, Mode=TwoWay}"
                                                      PlaceholderText="{Binding Source={StaticResource Strings}, Path=ScreenAddResolutionPlaceholder}"
                                                      HorizontalAlignment="Stretch">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock>
                                                            <Run Text="{Binding Width}" /><Run Text="x" /><Run Text="{Binding Height}" />
                                                            <Run Text=" " /><Run Text="{Binding Colors}" />
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <Button Grid.Column="1" Content="+"
                                                    Command="{Binding AddSupportedResolutionCommand}"
                                                    VerticalAlignment="Bottom" Padding="10,6" />
                                        </Grid>

                                        <ItemsRepeater ItemsSource="{Binding ScreenResolutionDisplays}">
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2" ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding}" />
                                                        <Button Grid.Column="1"
                                                                Content="&#xE872;"
                                                            ToolTipService.ToolTip="{Binding Source={StaticResource Strings}, Path=DeleteScreenButton}"
                                                                Command="{Binding DataContext.RemoveSupportedResolutionCommand, ElementName=PageRoot}"
                                                                CommandParameter="{Binding}"
                                                                Foreground="{ThemeResource SystemErrorTextColor}"
                                                                Style="{StaticResource AdminGridActionButtonStyle}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </StackPanel>
                                </ScrollViewer>
                                <Grid Grid.Row="2" Padding="16,12" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="{Binding Source={StaticResource Strings}, Path=CancelButton}" Command="{Binding CancelEditCommand}" HorizontalAlignment="Stretch" />
                                    <Button Grid.Column="1" Content="{Binding Source={StaticResource Strings}, Path=SaveButton}" Command="{Binding SaveCommand}" HorizontalAlignment="Stretch" Style="{ThemeResource AccentButtonStyle}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
