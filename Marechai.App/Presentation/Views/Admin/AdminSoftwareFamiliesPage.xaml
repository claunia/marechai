<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="Marechai.App.Presentation.Views.Admin.AdminSoftwareFamiliesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
      x:Name="PageRoot"
      NavigationCacheMode="Required"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="16,12">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Source={StaticResource Strings}, Path=SoftwareFamilyManagementTitle}"
                           FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource TextControlForeground}" />
                <TextBlock Text="{Binding Source={StaticResource Strings}, Path=SoftwareFamilyManagementSubtitle}"
                           FontSize="12" Foreground="{ThemeResource SystemBaseMediumColor}" Margin="0,4,0,0" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <StackPanel Visibility="{Binding IsAdmin, Converter={StaticResource InvertBoolToVisibilityConverter}}"
                        VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24" Spacing="16" MaxWidth="400">
                <InfoBar IsOpen="True" Severity="Warning"
                         Title="{Binding Source={StaticResource Strings}, Path=AccessDeniedTitle}"
                         Message="{Binding Source={StaticResource Strings}, Path=AccessDeniedMessage}" IsClosable="False" />
            </StackPanel>

            <Grid Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}" Canvas.ZIndex="0">
                <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                            VerticalAlignment="Center" HorizontalAlignment="Center" Padding="32" Spacing="16">
                    <ProgressRing IsActive="True" IsIndeterminate="True" Height="64" Width="64" Foreground="{ThemeResource SystemAccentColor}" />
                    <TextBlock Text="{Binding Source={StaticResource Strings}, Path=LoadingText}"
                               FontSize="14" TextAlignment="Center" Foreground="{ThemeResource SystemBaseMediumColor}" />
                </StackPanel>

                <StackPanel Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"
                            VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24" Spacing="16" MaxWidth="400" Canvas.ZIndex="100">
                    <InfoBar IsOpen="True" Severity="Error" Title="{Binding Source={StaticResource Strings}, Path=ErrorTitle}"
                             Message="{Binding ErrorMessage}" IsClosable="False" />
                    <Button Content="{Binding Source={StaticResource Strings}, Path=RetryButton}"
                            Command="{Binding LoadCommand}" HorizontalAlignment="Center" Style="{ThemeResource AccentButtonStyle}" />
                </StackPanel>

                <Grid Visibility="{Binding IsDataLoaded, Converter={StaticResource BoolToVisibilityConverter}}" Canvas.ZIndex="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <CommandBar Grid.Row="0" DefaultLabelPosition="Right">
                                <AppBarButton Icon="Add" Label="{Binding Source={StaticResource Strings}, Path=AddButton}"
                                              Command="{Binding OpenAddCommand}" />
                                <AppBarButton Icon="Refresh" Label="{Binding Source={StaticResource Strings}, Path=RefreshButton}"
                                              Command="{Binding LoadCommand}" />
                            </CommandBar>

                            <AutoSuggestBox Grid.Row="1" Margin="16,8,16,0"
                                            PlaceholderText="{Binding Source={StaticResource Strings}, Path=SearchPlaceholder}"
                                            QueryIcon="Find" Text="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            x:Name="FilterBox" TextChanged="FilterBox_TextChanged" />

                            <controls:DataGrid Grid.Row="2" Margin="16"
                                               ItemsSource="{Binding FilteredFamilies}" SelectedItem="{Binding SelectedFamily, Mode=TwoWay}"
                                               AutoGenerateColumns="False" GridLinesVisibility="None" HeadersVisibility="Column"
                                               AlternatingRowBackground="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                               CanUserReorderColumns="True" CanUserResizeColumns="True" CanUserSortColumns="True"
                                               IsReadOnly="True" SelectionMode="Single"
                                               HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <controls:DataGrid.Columns>
                                    <controls:DataGridTextColumn Header="{Binding Source={StaticResource Strings}, Path=NameColumn_Header}"
                                                                 Binding="{Binding Name}" Width="*" />
                                    <controls:DataGridTextColumn Header="{Binding Source={StaticResource Strings}, Path=ParentColumn_Header}"
                                                                 Binding="{Binding Parent}" Width="*" />
                                    <controls:DataGridTextColumn Header="{Binding Source={StaticResource Strings}, Path=IntroducedColumn_Header}"
                                                                 Binding="{Binding Introduced, Converter={StaticResource DateOnlyConverter}}" Width="Auto" />
                                    <controls:DataGridTemplateColumn Header="{Binding Source={StaticResource Strings}, Path=ActionsColumn_Header}" Width="Auto">
                                        <controls:DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <Button Content="&#xE70F;"
                                                            ToolTipService.ToolTip="{Binding Source={StaticResource Strings}, Path=EditButton}"
                                                            Command="{Binding DataContext.OpenEditCommand, ElementName=PageRoot}" CommandParameter="{Binding}"
                                                            Style="{StaticResource AdminGridActionButtonStyle}" />
                                                    <Button Content="&#xE74D;"
                                                            ToolTipService.ToolTip="{Binding Source={StaticResource Strings}, Path=DeleteButton}"
                                                            Command="{Binding DataContext.DeleteCommand, ElementName=PageRoot}" CommandParameter="{Binding}"
                                                            Style="{StaticResource AdminGridDestructiveActionButtonStyle}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </controls:DataGridTemplateColumn.CellTemplate>
                                    </controls:DataGridTemplateColumn>
                                </controls:DataGrid.Columns>
                            </controls:DataGrid>
                        </Grid>

                        <Border Grid.Column="1" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}"
                                Width="420" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
                            <Grid RowSpacing="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Padding="16,12" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                    <TextBlock Text="{Binding EditPanelTitle}" FontSize="18" FontWeight="SemiBold" />
                                </Grid>

                                <ScrollViewer Grid.Row="1" Padding="16" VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="12">
                                        <TextBox Header="{Binding Source={StaticResource Strings}, Path=NameLabel}"
                                                 Text="{Binding FamilyName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <AutoSuggestBox Header="{Binding Source={StaticResource Strings}, Path=ParentLabel}"
                                                        PlaceholderText="{Binding Source={StaticResource Strings}, Path=SearchPlaceholder}"
                                                        Text="{Binding ParentSearchText, Mode=TwoWay}" QueryIcon="Find"
                                                        x:Name="ParentFilterBox" TextChanged="ParentFilterBox_TextChanged" />
                                        <ComboBox ItemsSource="{Binding ParentSuggestions}" SelectedItem="{Binding SelectedParent, Mode=TwoWay}"
                                                  DisplayMemberPath="Name" HorizontalAlignment="Stretch"
                                                  PlaceholderText="{Binding Source={StaticResource Strings}, Path=ParentLabel}" />

                                        <CalendarDatePicker Header="{Binding Source={StaticResource Strings}, Path=IntroducedLabel}"
                                                            Date="{Binding Introduced, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                                        <ComboBox Header="{Binding Source={StaticResource Strings}, Path=DatePrecisionLabel}"
                                                  SelectedIndex="{Binding IntroducedPrecision, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="{Binding Source={StaticResource Strings}, Path=DatePrecisionFull}" />
                                            <ComboBoxItem Content="{Binding Source={StaticResource Strings}, Path=DatePrecisionMonthYear}" />
                                            <ComboBoxItem Content="{Binding Source={StaticResource Strings}, Path=DatePrecisionYearOnly}" />
                                        </ComboBox>

                                        <!-- Companies section (edit only) -->
                                        <StackPanel Visibility="{Binding IsEditingExisting, Converter={StaticResource BoolToVisibilityConverter}}" Spacing="8">
                                            <TextBlock Text="{Binding Source={StaticResource Strings}, Path=CompaniesHeader}" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0" />
                                            <Grid ColumnSpacing="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ComboBox Grid.Column="0" ItemsSource="{Binding CompanySuggestions}"
                                                          SelectedItem="{Binding SelectedCompanyToAdd, Mode=TwoWay}"
                                                          DisplayMemberPath="Name" PlaceholderText="{Binding Source={StaticResource Strings}, Path=CompanyLabel}" HorizontalAlignment="Stretch" />
                                                <ComboBox Grid.Column="1" ItemsSource="{Binding Roles}"
                                                          SelectedItem="{Binding SelectedRoleToAdd, Mode=TwoWay}"
                                                          DisplayMemberPath="Name" PlaceholderText="{Binding Source={StaticResource Strings}, Path=RoleLabel}" HorizontalAlignment="Stretch" />
                                                <Button Grid.Column="2" Content="+" Command="{Binding AddCompanyCommand}" VerticalAlignment="Bottom" Padding="10,6" />
                                            </Grid>
                                            <ItemsRepeater ItemsSource="{Binding CompanyDisplays}">
                                                <ItemsRepeater.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,2" ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding}" />
                                                            <Button Grid.Column="1" Content="&#xE74D;"
                                                            ToolTipService.ToolTip="{Binding Source={StaticResource Strings}, Path=DeleteButton}"
                                                                    Command="{Binding DataContext.RemoveCompanyByDisplayCommand, ElementName=PageRoot}"
                                                                    CommandParameter="{Binding}" Foreground="{ThemeResource SystemErrorTextColor}"
                                                                    Style="{StaticResource AdminGridActionButtonStyle}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsRepeater.ItemTemplate>
                                            </ItemsRepeater>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>

                                <Grid Grid.Row="2" Padding="16,12" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="{Binding Source={StaticResource Strings}, Path=CancelButton}"
                                            Command="{Binding CancelEditCommand}" HorizontalAlignment="Stretch" />
                                    <Button Grid.Column="1" Content="{Binding Source={StaticResource Strings}, Path=SaveButton}"
                                            Command="{Binding SaveCommand}" HorizontalAlignment="Stretch" Style="{ThemeResource AccentButtonStyle}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
