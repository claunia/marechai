<?xml version="1.0"
      encoding="utf-8"?>

<Page x:Class="Marechai.App.Presentation.Views.SoftwareViewPage"
      x:Name="PageRoot"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:loc="using:Marechai.App.Presentation.Converters"
      xmlns:components="using:Marechai.App.Presentation.Components"
      xmlns:wctui="using:CommunityToolkit.WinUI.UI.Controls"
      NavigationCacheMode="Disabled"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header with Back Button -->
        <Grid Grid.Row="0"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,0,0,1"
              Padding="12,12,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" /> <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Command="{Binding GoBackCommand}"
                    Style="{ThemeResource AlternateButtonStyle}"
                    ToolTipService.ToolTip="Go back"
                    Padding="8"
                    MinWidth="44"
                    MinHeight="44"
                    VerticalAlignment="Center">
                <FontIcon Glyph="&#xE72B;"
                          FontSize="16" />
            </Button>

            <StackPanel Grid.Column="1"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center">
                <TextBlock Text="{Binding SoftwareName}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextControlForeground}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="1">

            <!-- Loading State -->
            <StackPanel Visibility="{Binding IsLoading}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Padding="32"
                        Spacing="16">
                <ProgressRing IsActive="True"
                              IsIndeterminate="True"
                              Height="64"
                              Width="64"
                              Foreground="{ThemeResource SystemAccentColor}" />
                <TextBlock
                           Text="{Binding Source={StaticResource Strings}, Path=LoadingText}"
                           FontSize="14"
                           TextAlignment="Center"
                           Foreground="{ThemeResource SystemBaseMediumColor}" />
            </StackPanel>

            <!-- Error State -->
            <StackPanel Visibility="{Binding HasError}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Padding="24"
                        Spacing="16"
                        MaxWidth="400">
                <InfoBar IsOpen="True"
                         Severity="Error"
                         Title="{Binding Source={StaticResource Strings}, Path=SoftwareErrorInfoBar_Title}"
                         Message="{Binding ErrorMessage}"
                         IsClosable="False" />
                <Button
                        Content="{Binding Source={StaticResource Strings}, Path=RetryButton}"
                        Command="{Binding LoadDataCommand}"
                        HorizontalAlignment="Center"
                        Style="{ThemeResource AccentButtonStyle}" />
            </StackPanel>

            <!-- Software Details -->
            <Grid Visibility="{Binding IsDataLoaded}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Padding="16,16,16,0"
                            Spacing="16">

                    <components:HeroHeader HeroTitle="{Binding SoftwareName}"
                                           HeroSubtitle="{Binding Family}" />

                    <!-- Type Badges -->
                    <wctui:WrapPanel Orientation="Horizontal"
                                     HorizontalSpacing="8"
                                     VerticalSpacing="8">
                        <Border Visibility="{Binding ShowSoftwareBadge}"
                                Style="{StaticResource ChipNeutralStyle}">
                            <TextBlock Text="{Binding Source={StaticResource Strings}, Path=SoftwareIsSoftwareLabel}"
                                       Style="{StaticResource ChipTextStyle}"
                                       Foreground="{ThemeResource ChipNeutralForegroundBrush}" />
                        </Border>
                        <Border Visibility="{Binding ShowOsBadge}"
                                Style="{StaticResource ChipInfoStyle}">
                            <TextBlock Text="{Binding Source={StaticResource Strings}, Path=SoftwareIsOSLabel}"
                                       Style="{StaticResource ChipTextStyle}"
                                       Foreground="{ThemeResource ChipInfoForegroundBrush}" />
                        </Border>
                        <Border Visibility="{Binding ShowGameBadge}"
                                Style="{StaticResource ChipSuccessStyle}">
                            <TextBlock Text="{Binding Source={StaticResource Strings}, Path=SoftwareIsGameLabel}"
                                       Style="{StaticResource ChipTextStyle}"
                                       Foreground="{ThemeResource ChipSuccessForegroundBrush}" />
                        </Border>
                        <Border Visibility="{Binding ShowDlcBadge}"
                                Style="{StaticResource ChipWarningStyle}">
                            <TextBlock Text="{Binding Source={StaticResource Strings}, Path=SoftwareIsDlcLabel}"
                                       Style="{StaticResource ChipTextStyle}"
                                       Foreground="{ThemeResource WarningForegroundColorDefaultBrush}" />
                        </Border>
                        <Border Visibility="{Binding ShowSystemSoftwareBadge}"
                                Style="{StaticResource ChipNeutralStyle}">
                            <TextBlock Text="{Binding Source={StaticResource Strings}, Path=SoftwareIsSystemSoftwareLabel}"
                                       Style="{StaticResource ChipTextStyle}"
                                       Foreground="{ThemeResource ChipNeutralForegroundBrush}" />
                        </Border>
                        <Border Visibility="{Binding ShowApplicationBadge}"
                                Style="{StaticResource ChipInfoStyle}">
                            <TextBlock Text="{Binding Source={StaticResource Strings}, Path=SoftwareIsApplicationLabel}"
                                       Style="{StaticResource ChipTextStyle}"
                                       Foreground="{ThemeResource ChipInfoForegroundBrush}" />
                        </Border>
                        <Border Visibility="{Binding ShowDevelopmentSoftwareBadge}"
                                Style="{StaticResource ChipInfoStyle}">
                            <TextBlock Text="{Binding Source={StaticResource Strings}, Path=SoftwareIsDevelopmentSoftwareLabel}"
                                       Style="{StaticResource ChipTextStyle}"
                                       Foreground="{ThemeResource ChipInfoForegroundBrush}" />
                        </Border>
                        <Border Visibility="{Binding ShowServerSoftwareBadge}"
                                Style="{StaticResource ChipNeutralStyle}">
                            <TextBlock Text="{Binding Source={StaticResource Strings}, Path=SoftwareIsServerSoftwareLabel}"
                                       Style="{StaticResource ChipTextStyle}"
                                       Foreground="{ThemeResource ChipNeutralForegroundBrush}" />
                        </Border>
                        <Border Visibility="{Binding ShowMiddlewareBadge}"
                                Style="{StaticResource ChipNeutralStyle}">
                            <TextBlock Text="{Binding Source={StaticResource Strings}, Path=SoftwareIsMiddlewareLabel}"
                                       Style="{StaticResource ChipTextStyle}"
                                       Foreground="{ThemeResource ChipNeutralForegroundBrush}" />
                        </Border>
                        <Border Visibility="{Binding ShowFirmwareBadge}"
                                Style="{StaticResource ChipWarningStyle}">
                            <TextBlock Text="{Binding Source={StaticResource Strings}, Path=SoftwareIsFirmwareLabel}"
                                       Style="{StaticResource ChipTextStyle}"
                                       Foreground="{ThemeResource WarningForegroundColorDefaultBrush}" />
                        </Border>
                        <Border Visibility="{Binding ShowEmbeddedSoftwareBadge}"
                                Style="{StaticResource ChipNeutralStyle}">
                            <TextBlock Text="{Binding Source={StaticResource Strings}, Path=SoftwareIsEmbeddedSoftwareLabel}"
                                       Style="{StaticResource ChipTextStyle}"
                                       Foreground="{ThemeResource ChipNeutralForegroundBrush}" />
                        </Border>
                    </wctui:WrapPanel>

                    <!-- Ranking Placements -->
                    <ItemsControl ItemsSource="{Binding RankingPlacements}"
                                  Visibility="{Binding RankingPlacements.Count, Converter={StaticResource CountToVisibilityConverter}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <wctui:WrapPanel Orientation="Horizontal"
                                                 HorizontalSpacing="8"
                                                 VerticalSpacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Padding="10,4"
                                        Command="{Binding DataContext.NavigateToRankingCommand, ElementName=PageRoot}"
                                        CommandParameter="{Binding}"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12">
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="6">
                                        <FontIcon Glyph="&#xE735;"
                                                  FontSize="12"
                                                  Foreground="{ThemeResource SystemAccentColor}" />
                                        <TextBlock FontSize="12">
                                            <Run Text="#" />
                                            <Run Text="{Binding Rank}" />
                                            <Run Text="{Binding DimensionName}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>

                <TabView Grid.Row="1"
                         Style="{StaticResource DetailTabViewStyle}">

                    <TabViewItem Style="{StaticResource DetailTabViewItemStyle}"
                                 Header="{Binding Source={StaticResource Strings}, Path=OverviewTabHeader}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Spacing="24"
                                        Padding="16,16,16,16">

                    <!-- Description -->
                    <StackPanel Visibility="{Binding ShowDescription}"
                                Spacing="8">
                        <TextBlock Text="{Binding Source={StaticResource Strings}, Path=DescriptionSectionTitle}"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                        <WebView2 x:Name="DescriptionWebView"
                                  MinHeight="200" />
                    </StackPanel>

                    <!-- Family -->
                    <StackPanel Visibility="{Binding ShowFamily}"
                                Spacing="8">
                        <TextBlock
                                   Text="{Binding Source={StaticResource Strings}, Path=SoftwareFamilyLabel}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource SystemBaseMediumColor}" />
                        <Border Style="{StaticResource MetadataCardStyle}">
                            <TextBlock Text="{Binding Family}"
                                       FontSize="14"
                                       Foreground="{ThemeResource TextControlForeground}" />
                        </Border>
                    </StackPanel>

                    <!-- Predecessor -->
                    <StackPanel Visibility="{Binding ShowPredecessor}"
                                Spacing="8"
                                Margin="24,0,0,0">
                        <TextBlock
                                   Text="Predecessor"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource SystemBaseMediumColor}" />
                        <Border Style="{StaticResource MetadataCardStyle}">
                            <HyperlinkButton Content="{Binding Predecessor}"
                                             Command="{Binding NavigateToPredecessorCommand}"
                                             Padding="0"
                                             FontSize="14" />
                        </Border>
                    </StackPanel>

                    <!-- Successor -->
                    <StackPanel Visibility="{Binding ShowSuccessor}"
                                Spacing="8"
                                Margin="24,0,0,0">
                        <TextBlock
                                   Text="Successor"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource SystemBaseMediumColor}" />
                        <Border Style="{StaticResource MetadataCardStyle}">
                            <HyperlinkButton Content="{Binding Successor}"
                                             Command="{Binding NavigateToSuccessorCommand}"
                                             Padding="0"
                                             FontSize="14" />
                        </Border>
                    </StackPanel>

                    <!-- Base Software -->
                    <StackPanel Visibility="{Binding ShowBaseSoftware}"
                                Spacing="8"
                                Margin="24,0,0,0">
                        <TextBlock
                                   Text="{Binding Source={StaticResource Strings}, Path=BaseSoftwareLabel}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource SystemBaseMediumColor}" />
                        <Border Style="{StaticResource MetadataCardStyle}">
                            <HyperlinkButton Content="{Binding BaseSoftware}"
                                             Command="{Binding NavigateToBaseSoftwareCommand}"
                                             Padding="0"
                                             FontSize="14" />
                        </Border>
                    </StackPanel>

                    <!-- Similar Software -->
                    <StackPanel Visibility="{Binding ShowSimilarSoftware}"
                                Spacing="12">
                        <TextBlock
                                   Text="{Binding Source={StaticResource Strings}, Path=SimilarSoftwareHeader}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextControlForeground}" />
                        <ItemsControl ItemsSource="{Binding SimilarSoftware}"
                                      HorizontalAlignment="Stretch">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical"
                                                Spacing="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Padding="0"
                                            Margin="0"
                                            HorizontalContentAlignment="Stretch"
                                            HorizontalAlignment="Stretch"
                                            Command="{Binding DataContext.NavigateToSimilarSoftwareCommand, ElementName=PageRoot}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent"
                                            BorderThickness="0">
                                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="16,8"
                                                HorizontalAlignment="Stretch">
                                            <TextBlock Text="{Binding SimilarSoftwareName}"
                                                       FontSize="14"
                                                       Foreground="{ThemeResource TextControlForeground}" />
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Companies -->
                    <StackPanel Visibility="{Binding ShowCompanies}"
                                Spacing="12">
                        <TextBlock
                                   Text="{Binding Source={StaticResource Strings}, Path=SoftwareCompaniesLabel}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextControlForeground}" />
                        <ItemsControl ItemsSource="{Binding Companies}"
                                      HorizontalAlignment="Stretch">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical"
                                                Spacing="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="16,8">
                                        <TextBlock Text="{Binding}"
                                                   FontSize="14"
                                                   Foreground="{ThemeResource TextControlForeground}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Credits -->
                    <StackPanel Visibility="{Binding ShowCredits}"
                                Spacing="12">
                        <TextBlock
                                   Text="{Binding Source={StaticResource Strings}, Path=SoftwareCreditsLabel}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextControlForeground}" />
                        <ItemsControl ItemsSource="{Binding CreditGroups}"
                                      HorizontalAlignment="Stretch">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical"
                                                Spacing="12" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding Role}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource SystemBaseMediumColor}" />
                                        <ItemsControl ItemsSource="{Binding People}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Vertical"
                                                                Spacing="4" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="8"
                                                            Padding="16,8">
                                                        <TextBlock Text="{Binding}"
                                                                   FontSize="14"
                                                                   Foreground="{ThemeResource TextControlForeground}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Genres -->
                    <StackPanel Visibility="{Binding ShowGenres}"
                                Spacing="12">
                        <TextBlock Text="Genres"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextControlForeground}" />
                        <ItemsControl ItemsSource="{Binding GenreGroups}"
                                      HorizontalAlignment="Stretch">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical"
                                                Spacing="12" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding TypeName}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource SystemBaseMediumColor}" />
                                        <ItemsControl ItemsSource="{Binding Genres}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <wctui:WrapPanel Orientation="Horizontal"
                                                                     HorizontalSpacing="8"
                                                                     VerticalSpacing="8" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{ThemeResource SystemAccentColor}"
                                                            CornerRadius="12"
                                                            Padding="12,4">
                                                        <TextBlock Text="{Binding}"
                                                                   FontSize="12"
                                                                   Foreground="White" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                            </StackPanel>
                        </ScrollViewer>
                    </TabViewItem>

                    <TabViewItem Style="{StaticResource DetailTabViewItemStyle}"
                                 Header="{Binding Source={StaticResource Strings}, Path=SpecificationsTabHeader}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Spacing="24"
                                        Padding="16,16,16,16">

                    <!-- Specifications -->
                    <StackPanel Visibility="{Binding ShowSpecs}"
                                Spacing="12">
                        <TextBlock Text="Specifications"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextControlForeground}" />
                        <ItemsControl ItemsSource="{Binding SpecGroups}"
                                      HorizontalAlignment="Stretch">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical"
                                                Spacing="12" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="{Binding PlatformName}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource SystemBaseMediumColor}" />
                                        <ItemsControl ItemsSource="{Binding Specs}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Vertical"
                                                                Spacing="4" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="8"
                                                            Padding="16,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding Key}"
                                                                       FontSize="13"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{ThemeResource SystemBaseMediumColor}"
                                                                       Margin="0,0,16,0" />
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding Value}"
                                                                       FontSize="13"
                                                                       Foreground="{ThemeResource TextControlForeground}"
                                                                       TextWrapping="Wrap" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Ratings -->
                    <StackPanel Visibility="{Binding ShowRatings}"
                                Spacing="12">
                        <TextBlock Text="Ratings"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextControlForeground}" />
                        <ItemsControl ItemsSource="{Binding Ratings}"
                                      HorizontalAlignment="Stretch">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <wctui:WrapPanel Orientation="Horizontal"
                                                     HorizontalSpacing="8"
                                                     VerticalSpacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ChipWarningStyle}">
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="4">
                                            <TextBlock Text="{Binding System}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{ThemeResource WarningForegroundColorDefaultBrush}" />
                                            <TextBlock Text=":"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource WarningForegroundColorDefaultBrush}" />
                                            <TextBlock Text="{Binding Rating}"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource WarningForegroundColorDefaultBrush}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                            </StackPanel>
                        </ScrollViewer>
                    </TabViewItem>

                    <TabViewItem Style="{StaticResource DetailTabViewItemStyle}"
                                 Header="{Binding Source={StaticResource Strings}, Path=ReleasesTabHeader}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Spacing="24"
                                        Padding="16,16,16,16">

                    <!-- Versions and Releases -->
                    <StackPanel Visibility="{Binding ShowVersions}"
                                Spacing="12">
                        <TextBlock
                                   Text="{Binding Source={StaticResource Strings}, Path=SoftwareVersionsLabel}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextControlForeground}" />
                        <ItemsControl ItemsSource="{Binding Versions}"
                                      HorizontalAlignment="Stretch">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical"
                                                Spacing="12" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource MetadataCardStyle}">
                                        <StackPanel Spacing="8">
                                            <!-- Version Header -->
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="8">
                                                <TextBlock Text="{Binding VersionString}"
                                                           FontSize="16"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource TextControlForeground}" />
                                                <TextBlock Text="{Binding PublicVersion}"
                                                           FontSize="14"
                                                           Foreground="{ThemeResource SystemBaseMediumColor}"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding PublicVersion, Converter={StaticResource NullToVisibilityConverter}}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Codename}"
                                                       FontSize="13"
                                                       FontStyle="Italic"
                                                       Foreground="{ThemeResource SystemBaseMediumColor}"
                                                       Visibility="{Binding Codename, Converter={StaticResource NullToVisibilityConverter}}" />

                                            <!-- Releases for this version -->
                                            <ItemsControl ItemsSource="{Binding Releases}"
                                                          HorizontalAlignment="Stretch">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Vertical"
                                                                    Spacing="4" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Padding="0"
                                                                Margin="0"
                                                                HorizontalContentAlignment="Stretch"
                                                                HorizontalAlignment="Stretch"
                                                                Command="{Binding DataContext.NavigateToReleaseCommand, ElementName=PageRoot}"
                                                                CommandParameter="{Binding}"
                                                                Background="Transparent"
                                                                BorderThickness="0">
                                                            <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="6"
                                                                    Padding="12,8">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Grid.Column="0"
                                                                                Orientation="Horizontal"
                                                                                Spacing="8">
                                                                        <TextBlock Text="{Binding Platform}"
                                                                                   FontSize="13"
                                                                                   Foreground="{ThemeResource TextControlForeground}" />
                                                                        <TextBlock Text="—"
                                                                                   FontSize="13"
                                                                                   Foreground="{ThemeResource SystemBaseMediumColor}" />
                                                                        <TextBlock Text="{Binding Publisher}"
                                                                                   FontSize="13"
                                                                                   Foreground="{ThemeResource SystemBaseMediumColor}" />
                                                                        <TextBlock Text="{Binding ReleaseDate}"
                                                                                   FontSize="13"
                                                                                   Foreground="{ThemeResource SystemBaseMediumColor}"
                                                                                   Visibility="{Binding ReleaseDate, Converter={StaticResource NullToVisibilityConverter}}" />
                                                                    </StackPanel>
                                                                    <FontIcon Grid.Column="1"
                                                                              Glyph="&#xE72A;"
                                                                              FontSize="14"
                                                                              Foreground="{ThemeResource SystemAccentColor}"
                                                                              VerticalAlignment="Center" />
                                                                </Grid>
                                                            </Border>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Visibility="{Binding ShowReleases}"
                                Spacing="12">
                        <TextBlock
                                   Text="{Binding Source={StaticResource Strings}, Path=Releases}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextControlForeground}" />
                        <ItemsControl ItemsSource="{Binding Releases}"
                                      HorizontalAlignment="Stretch">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical"
                                                Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Padding="0"
                                            Margin="0"
                                            HorizontalContentAlignment="Stretch"
                                            HorizontalAlignment="Stretch"
                                            Command="{Binding DataContext.NavigateToReleaseCommand, ElementName=PageRoot}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent"
                                            BorderThickness="0">
                                        <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="12,8">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource TextControlForeground}"
                                                           Visibility="{Binding Title, Converter={StaticResource NullToVisibilityConverter}}" />
                                                <wctui:WrapPanel Orientation="Horizontal"
                                                                 HorizontalSpacing="8"
                                                                 VerticalSpacing="4">
                                                    <TextBlock Text="{Binding Platform}"
                                                               FontSize="13"
                                                               Foreground="{ThemeResource TextControlForeground}"
                                                               Visibility="{Binding Platform, Converter={StaticResource NullToVisibilityConverter}}" />
                                                    <TextBlock Text="{Binding Regions}"
                                                               FontSize="13"
                                                               Foreground="{ThemeResource SystemBaseMediumColor}"
                                                               Visibility="{Binding Regions, Converter={StaticResource NullToVisibilityConverter}}" />
                                                    <TextBlock Text="{Binding Publisher}"
                                                               FontSize="13"
                                                               Foreground="{ThemeResource SystemBaseMediumColor}"
                                                               Visibility="{Binding Publisher, Converter={StaticResource NullToVisibilityConverter}}" />
                                                    <TextBlock Text="{Binding ReleaseDate}"
                                                               FontSize="13"
                                                               Foreground="{ThemeResource SystemBaseMediumColor}"
                                                               Visibility="{Binding ReleaseDate, Converter={StaticResource NullToVisibilityConverter}}" />
                                                </wctui:WrapPanel>
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                            </StackPanel>
                        </ScrollViewer>
                    </TabViewItem>

                    <TabViewItem Style="{StaticResource DetailTabViewItemStyle}"
                                 Header="{Binding Source={StaticResource Strings}, Path=MediaTabHeader}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Spacing="24"
                                        Padding="16,16,16,16">

                    <!-- Covers -->
                    <StackPanel Visibility="{Binding ShowCovers}"
                                Spacing="12">
                        <TextBlock Text="{Binding Source={StaticResource Strings}, Path=CoversLabel}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextControlForeground}" />

                        <ItemsControl ItemsSource="{Binding CoverGroups}"
                                      HorizontalAlignment="Stretch">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical"
                                                Spacing="16" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="8">
                                        <!-- Release group header -->
                                        <TextBlock Text="{Binding GroupLabel}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource SystemBaseMediumColor}" />

                                        <!-- Cover thumbnails grid -->
                                        <ItemsRepeater ItemsSource="{Binding Covers}">
                                            <ItemsRepeater.Layout>
                                                <UniformGridLayout MinItemWidth="200"
                                                                   MinItemHeight="180"
                                                                   MinColumnSpacing="12"
                                                                   MinRowSpacing="12"
                                                                   ItemsStretch="Fill" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Padding="0"
                                                            Margin="0"
                                                            HorizontalContentAlignment="Stretch"
                                                            VerticalContentAlignment="Stretch"
                                                            HorizontalAlignment="Stretch"
                                                            Command="{Binding DataContext.ViewCoverCommand, ElementName=PageRoot}"
                                                            CommandParameter="{Binding}"
                                                            Background="Transparent"
                                                            BorderThickness="0">
                                                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="8"
                                                                Padding="8">
                                                            <StackPanel Spacing="4">
                                                                <Image Source="{Binding ThumbnailSource}"
                                                                       Stretch="Uniform"
                                                                       MaxHeight="140"
                                                                       HorizontalAlignment="Center" />
                                                                <TextBlock Text="{Binding TypeName}"
                                                                           FontSize="12"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{ThemeResource SystemAccentColor}"
                                                                           HorizontalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding Caption}"
                                                                           FontSize="11"
                                                                           Foreground="{ThemeResource SystemBaseMediumColor}"
                                                                           HorizontalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Visibility="{Binding Caption, Converter={StaticResource NullToVisibilityConverter}}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Promo Art -->
                    <StackPanel Visibility="{Binding ShowPromoArt}"
                                Spacing="12">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding Source={StaticResource Strings}, Path=PromoArt}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextControlForeground}" />
                            <TextBlock Text="{Binding PromoArtCount}"
                                       FontSize="12"
                                       Foreground="{ThemeResource SystemBaseMediumColor}"
                                       Visibility="{Binding HasPromoArt, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding PromoArtGroups}"
                                      HorizontalAlignment="Stretch">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical"
                                                Spacing="16" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="{Binding GroupName}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TextControlForeground}" />

                                        <ItemsRepeater ItemsSource="{Binding Items}">
                                            <ItemsRepeater.Layout>
                                                <UniformGridLayout MinItemWidth="200"
                                                                   MinItemHeight="180"
                                                                   MinColumnSpacing="12"
                                                                   MinRowSpacing="12"
                                                                   ItemsStretch="Fill" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Padding="0"
                                                            Margin="0"
                                                            HorizontalContentAlignment="Stretch"
                                                            VerticalContentAlignment="Stretch"
                                                            HorizontalAlignment="Stretch"
                                                            Command="{Binding DataContext.ViewPromoArtDetailsCommand, ElementName=PageRoot}"
                                                            CommandParameter="{Binding PromoArtId}"
                                                            Background="Transparent"
                                                            BorderThickness="0">
                                                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="8"
                                                                Padding="8">
                                                            <StackPanel Spacing="4">
                                                                <Grid Height="140"
                                                                      Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                                                    <Image Source="{Binding ThumbnailImageSource}"
                                                                           Stretch="Uniform"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           Visibility="{Binding ThumbnailImageSource, Converter={StaticResource ObjectToVisibilityConverter}}" />
                                                                    <FontIcon Glyph="&#xE91B;"
                                                                              FontSize="24"
                                                                              Foreground="{ThemeResource SystemBaseMediumColor}"
                                                                              HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"
                                                                              Visibility="{Binding ThumbnailImageSource, Converter={StaticResource InverseObjectToVisibilityConverter}}" />
                                                                </Grid>
                                                                <TextBlock Text="{Binding Caption}"
                                                                           FontSize="11"
                                                                           Foreground="{ThemeResource SystemBaseMediumColor}"
                                                                           HorizontalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Visibility="{Binding HasCaption, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Screenshots -->
                    <StackPanel Visibility="{Binding ShowScreenshots}"
                                Spacing="12">
                        <TextBlock Text="{Binding Source={StaticResource Strings}, Path=ScreenshotsLabel}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextControlForeground}" />

                        <ItemsControl ItemsSource="{Binding ScreenshotGroups}"
                                      HorizontalAlignment="Stretch">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical"
                                                Spacing="16" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="8">
                                        <!-- Platform group header -->
                                        <TextBlock Text="{Binding PlatformName}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource SystemBaseMediumColor}" />

                                        <!-- Screenshot thumbnails grid -->
                                        <ItemsRepeater ItemsSource="{Binding Screenshots}">
                                            <ItemsRepeater.Layout>
                                                <UniformGridLayout MinItemWidth="200"
                                                                   MinItemHeight="180"
                                                                   MinColumnSpacing="12"
                                                                   MinRowSpacing="12"
                                                                   ItemsStretch="Fill" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Padding="0"
                                                            Margin="0"
                                                            HorizontalContentAlignment="Stretch"
                                                            VerticalContentAlignment="Stretch"
                                                            HorizontalAlignment="Stretch"
                                                            Command="{Binding DataContext.ViewScreenshotCommand, ElementName=PageRoot}"
                                                            CommandParameter="{Binding}"
                                                            Background="Transparent"
                                                            BorderThickness="0">
                                                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="8"
                                                                Padding="8">
                                                            <StackPanel Spacing="4">
                                                                <Image Source="{Binding ThumbnailSource}"
                                                                       Stretch="Uniform"
                                                                       MaxHeight="140"
                                                                       HorizontalAlignment="Center" />
                                                                <TextBlock Text="{Binding Caption}"
                                                                           FontSize="11"
                                                                           Foreground="{ThemeResource SystemBaseMediumColor}"
                                                                           HorizontalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Visibility="{Binding Caption, Converter={StaticResource NullToVisibilityConverter}}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Videos -->
                    <StackPanel Visibility="{Binding ShowVideos}"
                                Spacing="12">
                        <TextBlock Text="{Binding Source={StaticResource Strings}, Path=VideosLabel}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextControlForeground}" />
                        <ItemsControl ItemsSource="{Binding Videos}"
                                      HorizontalAlignment="Stretch">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical"
                                                Spacing="0"
                                                HorizontalAlignment="Stretch" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Padding="0"
                                            Margin="0,0,0,8"
                                            MinHeight="92"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Stretch"
                                            HorizontalAlignment="Stretch"
                                            Command="{Binding DataContext.OpenVideoCommand, ElementName=PageRoot}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent"
                                            BorderThickness="0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Grid MinHeight="92"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Stretch">
                                                    <Border x:Name="VideoShadowBorder"
                                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="8"
                                                            Padding="16,12"
                                                            Translation="0, 0, 4"
                                                            VerticalAlignment="Stretch">
                                                        <Border.Shadow>
                                                            <ThemeShadow />
                                                        </Border.Shadow>

                                                        <Grid ColumnSpacing="16">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="120" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <Grid Grid.Column="0"
                                                                  Height="68"
                                                                  CornerRadius="6"
                                                                  Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                                  VerticalAlignment="Center">
                                                                <Image Source="{Binding ThumbnailUrl}"
                                                                       Stretch="UniformToFill"
                                                                       Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                <FontIcon Glyph="&#xE768;"
                                                                          FontSize="26"
                                                                          Foreground="{ThemeResource SystemAccentColor}"
                                                                          HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"
                                                                          Visibility="{Binding HasThumbnail, Converter={StaticResource InvertBoolToVisibilityConverter}}" />
                                                            </Grid>

                                                            <StackPanel Grid.Column="1"
                                                                        Spacing="4"
                                                                        VerticalAlignment="Center"
                                                                        HorizontalAlignment="Stretch">
                                                                <TextBlock Text="{Binding DisplayTitle}"
                                                                           FontSize="15"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{ThemeResource TextControlForeground}"
                                                                           TextWrapping="WrapWholeWords"
                                                                           MaxLines="2"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding Provider}"
                                                                           FontSize="12"
                                                                           Foreground="{ThemeResource SystemBaseMediumColor}" />
                                                                <TextBlock Text="{Binding VideoId}"
                                                                           FontSize="11"
                                                                           Foreground="{ThemeResource SystemBaseMediumColor}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="2"
                                                                        Spacing="6"
                                                                        VerticalAlignment="Center">
                                                                <FontIcon Glyph="&#xE8A7;"
                                                                          FontSize="18"
                                                                          HorizontalAlignment="Center"
                                                                          Foreground="{ThemeResource SystemAccentColor}" />
                                                                <TextBlock Text="{Binding Source={StaticResource Strings}, Path=OpenVideoButton}"
                                                                           FontSize="11"
                                                                           Foreground="{ThemeResource SystemAccentColor}"
                                                                           HorizontalAlignment="Center" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>

                                                    <VisualStateManager.VisualStateGroups>
                                                        <VisualStateGroup x:Name="CommonStates">
                                                            <VisualState x:Name="Normal" />
                                                            <VisualState x:Name="PointerOver">
                                                                <VisualState.Setters>
                                                                    <Setter Target="VideoShadowBorder.Background"
                                                                            Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
                                                                    <Setter Target="VideoShadowBorder.Translation"
                                                                            Value="0, -2, 8" />
                                                                </VisualState.Setters>
                                                            </VisualState>
                                                            <VisualState x:Name="Pressed">
                                                                <VisualState.Setters>
                                                                    <Setter Target="VideoShadowBorder.Background"
                                                                            Value="{ThemeResource CardBackgroundFillColorTertiaryBrush}" />
                                                                    <Setter Target="VideoShadowBorder.Translation"
                                                                            Value="0, 0, 2" />
                                                                </VisualState.Setters>
                                                            </VisualState>
                                                        </VisualStateGroup>
                                                    </VisualStateManager.VisualStateGroups>
                                                </Grid>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                            </StackPanel>
                        </ScrollViewer>
                    </TabViewItem>

                    <TabViewItem Style="{StaticResource DetailTabViewItemStyle}"
                                 Header="{Binding Source={StaticResource Strings}, Path=ReviewsTabHeader}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Spacing="24"
                                        Padding="16,16,16,16">

                    <!-- Critic Reviews -->
                    <StackPanel Visibility="{Binding ShowCriticReviews}"
                                Spacing="12">
                        <TextBlock Text="{Binding Source={StaticResource Strings}, Path=CriticReviewsLabel}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextControlForeground}" />

                        <StackPanel Orientation="Horizontal"
                                    Spacing="8"
                                    Visibility="{Binding CriticReviewsOverallText, Converter={StaticResource StringToVisibilityConverter}}">
                            <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    CornerRadius="12"
                                    Padding="10,4">
                                <TextBlock Text="{Binding CriticReviewsOverallText}"
                                           FontSize="12"
                                           FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding CriticReviewsByPlatform}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <wctui:WrapPanel Orientation="Horizontal"
                                                     HorizontalSpacing="8"
                                                     VerticalSpacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            CornerRadius="12"
                                            Padding="10,4">
                                        <TextBlock Text="{Binding}"
                                                   FontSize="11" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding CriticReviews}"
                                      HorizontalAlignment="Stretch">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical"
                                                Spacing="0"
                                                HorizontalAlignment="Stretch" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="16,12"
                                            Margin="0,0,0,8">
                                        <StackPanel Spacing="6">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0"
                                                            Spacing="2">
                                                    <TextBlock Text="{Binding MagazineTitle}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="WrapWholeWords" />
                                                    <StackPanel Orientation="Horizontal"
                                                                Spacing="8">
                                                        <TextBlock Text="{Binding PlatformName}"
                                                                   FontSize="11"
                                                                   Foreground="{ThemeResource SystemBaseMediumColor}"
                                                                   Visibility="{Binding HasPlatformName, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                        <TextBlock Text="{Binding FormattedDate}"
                                                                   FontSize="11"
                                                                   Foreground="{ThemeResource SystemBaseMediumColor}"
                                                                   Visibility="{Binding HasFormattedDate, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    </StackPanel>
                                                </StackPanel>

                                                <Border Grid.Column="1"
                                                        Background="{Binding ScoreBrush}"
                                                        CornerRadius="10"
                                                        Padding="8,3"
                                                        VerticalAlignment="Top"
                                                        Visibility="{Binding HasScore, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding ScoreText}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="White" />
                                                </Border>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Source={StaticResource Strings}, Path=CriticReviewsUnscored}"
                                                           FontSize="11"
                                                           VerticalAlignment="Top"
                                                           Foreground="{ThemeResource SystemBaseMediumColor}"
                                                           Visibility="{Binding HasScore, Converter={StaticResource InvertBoolToVisibilityConverter}}" />
                                            </Grid>

                                            <TextBlock Text="{Binding OriginalScoreText}"
                                                       FontSize="11"
                                                       Foreground="{ThemeResource SystemBaseMediumColor}"
                                                       Visibility="{Binding HasOriginalScore, Converter={StaticResource BoolToVisibilityConverter}}" />

                                            <TextBlock Text="{Binding ReviewText}"
                                                       FontSize="12"
                                                       TextWrapping="WrapWholeWords"
                                                       MaxLines="4"
                                                       TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding HasReviewText, Converter={StaticResource BoolToVisibilityConverter}}" />

                                            <Button Padding="0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    HorizontalAlignment="Left"
                                                    Command="{Binding DataContext.OpenCriticReviewCommand, ElementName=PageRoot}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding HasReviewUrl, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="{Binding Source={StaticResource Strings}, Path=CriticReviewsFullReviewLink}"
                                                           FontSize="12"
                                                           Foreground="{ThemeResource SystemAccentColor}" />
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- User Reviews -->
                    <StackPanel Visibility="{Binding ShowUserReviews}"
                                Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{Binding Source={StaticResource Strings}, Path=UserReviewsLabel}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextControlForeground}"
                                       VerticalAlignment="Center" />

                            <Button Grid.Column="1"
                                    Content="{Binding ReviewActionLabel}"
                                    Click="OpenReviewDialog_Click"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>

                        <InfoBar IsOpen="{Binding HasReviewFeedbackMessage, Mode=OneWay}"
                                 Severity="{Binding ReviewFeedbackSeverity}"
                                 Message="{Binding ReviewFeedbackMessage}"
                                 IsClosable="True"
                                 CloseButtonClick="ReviewFeedback_CloseButtonClick" />

                        <StackPanel Orientation="Horizontal"
                                    Spacing="8"
                                    Visibility="{Binding UserReviewsOverallText, Converter={StaticResource StringToVisibilityConverter}}">
                            <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    CornerRadius="12"
                                    Padding="10,4">
                                <TextBlock Text="{Binding UserReviewsOverallText}"
                                           FontSize="12"
                                           FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>

                        <TextBlock Text="{Binding Source={StaticResource Strings}, Path=NoUserReviewsYetText}"
                                   FontSize="12"
                                   Foreground="{ThemeResource SystemBaseMediumColor}"
                                   Visibility="{Binding UserReviews.Count, Converter={StaticResource ZeroToVisibilityConverter}}" />

                        <ItemsControl ItemsSource="{Binding UserReviews}"
                                      HorizontalAlignment="Stretch">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical"
                                                Spacing="0"
                                                HorizontalAlignment="Stretch" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="16,12"
                                            Margin="0,0,0,8">
                                        <StackPanel Spacing="6">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Grid Grid.Column="0"
                                                      Width="28"
                                                      Height="28"
                                                      CornerRadius="14"
                                                      Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                      Visibility="{Binding ShowReviewerName, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding InitialLetter}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                    <Image Source="{Binding AvatarUrl}"
                                                           Visibility="{Binding HasAvatar, Converter={StaticResource BoolToVisibilityConverter}}"
                                                           Stretch="UniformToFill" />
                                                </Grid>

                                                <StackPanel Grid.Column="1"
                                                            Orientation="Horizontal"
                                                            Spacing="8">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Visibility="{Binding ShowReviewerName, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    <TextBlock Text="{Binding Source={StaticResource Strings}, Path=UserReviewsAnonymous}"
                                                               FontSize="13"
                                                               FontStyle="Italic"
                                                               Foreground="{ThemeResource SystemBaseMediumColor}"
                                                               Visibility="{Binding ShowReviewerName, Converter={StaticResource InvertBoolToVisibilityConverter}}" />
                                                    <TextBlock Text="{Binding RatingText}"
                                                               FontSize="12"
                                                               Foreground="{ThemeResource SystemAccentColor}"
                                                               Visibility="{Binding HasRating, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                </StackPanel>

                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding FormattedDate}"
                                                           FontSize="11"
                                                           Foreground="{ThemeResource SystemBaseMediumColor}"
                                                           VerticalAlignment="Top"
                                                           Visibility="{Binding HasFormattedDate, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            </Grid>

                                            <StackPanel Spacing="2"
                                                        Visibility="{Binding HasTheGood, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="{Binding Source={StaticResource Strings}, Path=UserReviewsTheGood}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="SeaGreen" />
                                                <TextBlock Text="{Binding TheGood}"
                                                           FontSize="12"
                                                           TextWrapping="WrapWholeWords" />
                                            </StackPanel>

                                            <StackPanel Spacing="2"
                                                        Visibility="{Binding HasTheBad, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="{Binding Source={StaticResource Strings}, Path=UserReviewsTheBad}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="IndianRed" />
                                                <TextBlock Text="{Binding TheBad}"
                                                           FontSize="12"
                                                           TextWrapping="WrapWholeWords" />
                                            </StackPanel>

                                            <StackPanel Spacing="2"
                                                        Visibility="{Binding HasTheUgly, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="{Binding Source={StaticResource Strings}, Path=UserReviewsTheUgly}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="DarkOrange" />
                                                <TextBlock Text="{Binding TheUgly}"
                                                           FontSize="12"
                                                           TextWrapping="WrapWholeWords" />
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="16">
                                                <StackPanel Orientation="Horizontal"
                                                            Spacing="4">
                                                    <Button Command="{Binding DataContext.UpvoteReviewCommand, ElementName=PageRoot}"
                                                            CommandParameter="{Binding}"
                                                            IsEnabled="{Binding CanVote}"
                                                            Opacity="{Binding UpvoteOpacity}"
                                                            Padding="4"
                                                            MinWidth="0"
                                                            Background="Transparent"
                                                            BorderThickness="0">
                                                        <FontIcon Glyph="&#xE8E1;"
                                                                  FontSize="12"
                                                                  Foreground="SeaGreen" />
                                                    </Button>
                                                    <TextBlock Text="{Binding ThumbsUp}"
                                                               FontSize="11"
                                                               Foreground="{ThemeResource SystemBaseMediumColor}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal"
                                                            Spacing="4">
                                                    <Button Command="{Binding DataContext.DownvoteReviewCommand, ElementName=PageRoot}"
                                                            CommandParameter="{Binding}"
                                                            IsEnabled="{Binding CanVote}"
                                                            Opacity="{Binding DownvoteOpacity}"
                                                            Padding="4"
                                                            MinWidth="0"
                                                            Background="Transparent"
                                                            BorderThickness="0">
                                                        <FontIcon Glyph="&#xE8E0;"
                                                                  FontSize="12"
                                                                  Foreground="IndianRed" />
                                                    </Button>
                                                    <TextBlock Text="{Binding ThumbsDown}"
                                                               FontSize="11"
                                                               Foreground="{ThemeResource SystemBaseMediumColor}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                                <Button Content="{Binding Source={StaticResource Strings}, Path=ReportReviewButton}"
                                                        Click="OpenReportReviewDialog_Click"
                                                        Visibility="{Binding CanReport, Converter={StaticResource BoolToVisibilityConverter}}"
                                                        IsEnabled="{Binding CanReport}"
                                                        Style="{ThemeResource AlternateButtonStyle}"
                                                        Padding="8,2"
                                                        MinWidth="0"
                                                        FontSize="11" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                            </StackPanel>
                        </ScrollViewer>
                    </TabViewItem>

                </TabView>

            </Grid>

        </Grid>

    </Grid>

</Page>
