<?xml version="1.0" encoding="utf-8"?>

<Page x:Class="Marechai.App.Presentation.Views.MessagesPage"
      x:Name="PageRoot"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,0,0,1"
              Padding="16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Messages"
                           FontSize="20"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding PageSummary}"
                           FontSize="12"
                           Foreground="{ThemeResource SystemBaseMediumColor}"
                           Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                <Button Content="Inbox"
                        Command="{Binding GoToInboxCommand}"
                        Style="{ThemeResource AccentButtonStyle}" />
                <Button Content="Sent"
                        Command="{Binding GoToSentCommand}" />
                <Button Content="Compose"
                        Command="{Binding OpenComposeCommand}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <StackPanel Visibility="{Binding IsLoading}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Padding="32"
                        Spacing="16">
                <ProgressRing IsActive="True"
                              IsIndeterminate="True"
                              Height="64"
                              Width="64" />
                <TextBlock Text="Loading messages..." />
            </StackPanel>

            <StackPanel Visibility="{Binding HasError}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Padding="24"
                        Spacing="16"
                        MaxWidth="400">
                <InfoBar IsOpen="True"
                         Severity="Error"
                         Title="Could not load messages"
                         Message="{Binding ErrorMessage}"
                         IsClosable="False" />
                <Button Content="Retry"
                        Command="{Binding RefreshCommand}"
                        HorizontalAlignment="Center"
                        Style="{ThemeResource AccentButtonStyle}" />
            </StackPanel>

            <Grid Visibility="{Binding IsDataLoaded}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Conversations}"
                                  Margin="12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Padding="0"
                                        Margin="0,0,0,8"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        HorizontalContentAlignment="Stretch"
                                        Command="{Binding DataContext.OpenConversationCommand, ElementName=PageRoot}"
                                        CommandParameter="{Binding}">
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="16,12">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{Binding Subject}"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding ParticipantsText}"
                                                           FontSize="12"
                                                           Foreground="{ThemeResource SystemBaseMediumColor}" />
                                                <TextBlock Text="{Binding PreviewText}"
                                                           TextWrapping="WrapWholeWords"
                                                           MaxLines="2" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1"
                                                        Spacing="8"
                                                        HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding TimestampText}"
                                                           FontSize="12"
                                                           Foreground="{ThemeResource SystemBaseMediumColor}"
                                                           HorizontalAlignment="Right" />
                                                <Border Background="{ThemeResource SystemAccentColor}"
                                                        CornerRadius="10"
                                                        Padding="8,2"
                                                        Visibility="{Binding IsUnread}">
                                                    <TextBlock Text="{Binding UnreadCount}"
                                                               Foreground="White"
                                                               FontSize="12" />
                                                </Border>
                                                <Button Content="Delete"
                                                        Click="DeleteConversationButton_OnClick"
                                                        HorizontalAlignment="Right" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="8"
                            Margin="12">
                    <Button Content="Previous"
                            Command="{Binding PreviousPageCommand}"
                            IsEnabled="{Binding CanGoPrevious}" />
                    <TextBlock Text="{Binding PageSummary}"
                               VerticalAlignment="Center" />
                    <Button Content="Next"
                            Command="{Binding NextPageCommand}"
                            IsEnabled="{Binding CanGoNext}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
