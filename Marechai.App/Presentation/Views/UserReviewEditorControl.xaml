<?xml version="1.0" encoding="utf-8"?>

<UserControl x:Class="Marechai.App.Presentation.Views.UserReviewEditorControl"
             x:Name="RootControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="12"
                    MinWidth="420"
                    MaxWidth="520">
            <InfoBar IsOpen="{Binding HasReviewDraftError, Mode=OneWay}"
                     Severity="Error"
                     Message="{Binding ReviewDraftErrorMessage}"
                     IsClosable="False" />

            <StackPanel Spacing="6">
                <TextBlock Text="{Binding Source={StaticResource Strings}, Path=ReviewRatingLabel}"
                           FontSize="13"
                           FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <ItemsControl ItemsSource="{Binding ReviewRatingStars}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"
                                            Spacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="28"
                                      Height="32">
                                    <TextBlock Text="★"
                                               FontSize="24"
                                               Foreground="#D4AF37"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding IsFilled, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <TextBlock Text="★"
                                               FontSize="24"
                                               Foreground="#D4AF37"
                                               Opacity="0.45"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding IsHalfFilled, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <TextBlock Text="☆"
                                               FontSize="24"
                                               Foreground="{ThemeResource SystemBaseMediumColor}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <Grid ColumnSpacing="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0"
                                                Opacity="0.01"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Command="{Binding DataContext.SetReviewDraftRatingCommand, ElementName=RootControl}"
                                                CommandParameter="{Binding LeftValue}" />
                                        <Button Grid.Column="1"
                                                Opacity="0.01"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Command="{Binding DataContext.SetReviewDraftRatingCommand, ElementName=RootControl}"
                                                CommandParameter="{Binding RightValue}" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding ReviewDraftRatingText}"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource SystemBaseMediumColor}" />

                    <Button Content="{Binding Source={StaticResource Strings}, Path=ReviewClearRatingButton}"
                            Command="{Binding ClearReviewDraftRatingCommand}"
                            Style="{ThemeResource AlternateButtonStyle}" />
                </StackPanel>
            </StackPanel>

            <TextBox Header="{Binding Source={StaticResource Strings}, Path=UserReviewsTheGood}"
                     Text="{Binding ReviewDraftTheGood, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MinHeight="96"
                     MaxLength="8192" />

            <TextBox Header="{Binding Source={StaticResource Strings}, Path=UserReviewsTheBad}"
                     Text="{Binding ReviewDraftTheBad, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MinHeight="96"
                     MaxLength="8192" />

            <TextBox Header="{Binding Source={StaticResource Strings}, Path=UserReviewsTheUgly}"
                     Text="{Binding ReviewDraftTheUgly, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MinHeight="96"
                     MaxLength="8192" />

            <CheckBox Content="{Binding Source={StaticResource Strings}, Path=ReviewAnonymousLabel}"
                      IsChecked="{Binding ReviewDraftIsAnonymous, Mode=TwoWay}" />
        </StackPanel>
    </ScrollViewer>

</UserControl>
