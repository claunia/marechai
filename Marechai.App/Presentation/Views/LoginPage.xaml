<?xml version="1.0"
      encoding="utf-8"?>

<Page x:Class="Marechai.App.Presentation.Views.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:loc="using:Marechai.App.Presentation.Converters"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:vm="using:Marechai.App.Presentation.ViewModels"
      xmlns:utu="using:Uno.Toolkit.UI"
      mc:Ignorable="d"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
      d:DataContext="{d:DesignInstance vm:LoginViewModel}">

    <Grid utu:SafeArea.Insets="VisibleBounds">
        <!-- Center content on screen -->
        <Grid HorizontalAlignment="Center"
              VerticalAlignment="Center"
              MaxWidth="480"
              Padding="32">

            <!-- Login Card with Mac OS 9 styling -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="2"
                    CornerRadius="8"
                    Padding="0"
                    Translation="0,0,16">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header with Mac OS 9 Title Bar Style -->
                    <Border Grid.Row="0"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            Padding="16,12"
                            CornerRadius="6,6,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" /> <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Icon -->
                            <FontIcon Grid.Column="0"
                                      Glyph="&#xE77B;"
                                      FontSize="24"
                                      Foreground="White"
                                      Margin="0,0,12,0"
                                      VerticalAlignment="Center" />

                            <!-- Title -->
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Source={StaticResource Strings}, Path=LoginPage_Title}"
                                       Style="{StaticResource TitleTextBlockStyle}"
                                       Foreground="White"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Login Form Content -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Padding="32"
                                    Spacing="24">

                            <!-- Welcome Message -->
                            <TextBlock
                                       Text="{Binding Source={StaticResource Strings}, Path=LoginPage_WelcomeMessage}"
                                       Style="{StaticResource BodyTextBlockStyle}"
                                       TextWrapping="Wrap"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center" />

                            <!-- Email Input -->
                            <StackPanel Spacing="8" Visibility="{Binding RequiresTwoFactor, Converter={StaticResource InvertBoolToVisibilityConverter}}">
                                <TextBlock
                                           Text="{Binding Source={StaticResource Strings}, Path=LoginPage_EmailLabel}"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBox x:Name="EmailTextBox"
                                         Text="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="{Binding Source={StaticResource Strings}, Path=LoginPage_EmailTextBox_Placeholder}"
                                         InputScope="EmailSmtpAddress"
                                         IsSpellCheckEnabled="False"
                                         AutomationProperties.Name="Email address"
                                         KeyDown="OnEmailKeyDown" />
                            </StackPanel>

                            <!-- Password Input -->
                            <StackPanel Spacing="8" Visibility="{Binding RequiresTwoFactor, Converter={StaticResource InvertBoolToVisibilityConverter}}">
                                <TextBlock
                                           Text="{Binding Source={StaticResource Strings}, Path=LoginPage_PasswordLabel}"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <PasswordBox x:Name="PasswordBox"
                                             Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="{Binding Source={StaticResource Strings}, Path=LoginPage_PasswordBox_Placeholder}"
                                             AutomationProperties.Name="Password"
                                             KeyDown="OnPasswordKeyDown" />
                            </StackPanel>

                            <!-- Error Message -->
                            <Border x:Name="ErrorBorder"
                                    Background="#FFF4E6"
                                    BorderBrush="#FFB84D"
                                    BorderThickness="2"
                                    CornerRadius="4"
                                    Padding="12"
                                    Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" /> <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Warning Icon -->
                                    <FontIcon Grid.Column="0"
                                              Glyph="&#xE7BA;"
                                              Foreground="#D97706"
                                              FontSize="20"
                                              Margin="0,0,8,0"
                                              VerticalAlignment="Top" />

                                    <!-- Error Text -->
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding ErrorMessage}"
                                               Foreground="#92400E"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center" />

                                    <!-- Close Button -->
                                    <Button Grid.Column="2"
                                            Command="{Binding ClearErrorCommand}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="8"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="Close error message">
                                        <FontIcon Glyph="&#xE711;"
                                                  FontSize="12"
                                                  Foreground="#92400E" />
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Login Button -->
                            <Button Content="{Binding Source={StaticResource Strings}, Path=LoginPage_LoginButton}" x:Name="LoginButton"
                                    Command="{Binding LoginCommand}"
                                    IsEnabled="{Binding IsLoggingIn, Converter={StaticResource InvertBoolConverter}}"
                                    HorizontalAlignment="Stretch"
                                    Padding="16,12"
                                    Style="{StaticResource AccentButtonStyle}"
                                    AutomationProperties.Name="Sign in button"
                                    Visibility="{Binding RequiresTwoFactor, Converter={StaticResource InvertBoolToVisibilityConverter}}">
                                <Button.Content>
                                    <Grid>
                                        <TextBlock
                                                   Text="{Binding Source={StaticResource Strings}, Path=LoginPage_LoginButtonText}"
                                                   Visibility="{Binding IsLoggingIn, Converter={StaticResource InvertBoolToVisibilityConverter}}" />
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    Spacing="8"
                                                    Visibility="{Binding IsLoggingIn, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <ProgressRing IsActive="True"
                                                          Width="20"
                                                          Height="20"
                                                          Foreground="White" />
                                            <TextBlock
                                                       Text="{Binding Source={StaticResource Strings}, Path=LoginPage_SigningInText}"
                                                       Foreground="White" />
                                        </StackPanel>
                                    </Grid>
                                </Button.Content>
                            </Button>

                            <!-- Two-factor Prompt -->
                            <StackPanel Spacing="12"
                                        Visibility="{Binding RequiresTwoFactor, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{Binding Source={StaticResource Strings}, Path=LoginPage_TwoFactorTitle}"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />

                                <!-- Method picker (only when more than one is available) -->
                                <ComboBox ItemsSource="{Binding AvailableMethods}"
                                          SelectedItem="{Binding SelectedProvider, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch"
                                          Visibility="{Binding HasMultipleMethods, Converter={StaticResource BoolToVisibilityConverter}}" />

                                <!-- Send email code -->
                                <Button Content="{Binding Source={StaticResource Strings}, Path=LoginPage_SendEmailCodeButton}"
                                        Command="{Binding SendEmailCodeCommand}"
                                        IsEnabled="{Binding IsLoggingIn, Converter={StaticResource InvertBoolConverter}}"
                                        HorizontalAlignment="Stretch"
                                        Visibility="{Binding ShowSendEmailButton, Converter={StaticResource BoolToVisibilityConverter}}" />

                                <!-- Code input + verify (authenticator/email) -->
                                <StackPanel Spacing="8"
                                            Visibility="{Binding RecoveryMode, Converter={StaticResource InvertBoolToVisibilityConverter}}">
                                    <TextBlock Text="{Binding Source={StaticResource Strings}, Path=LoginPage_VerificationCodeLabel}"
                                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBox Text="{Binding Code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="••••••"
                                             KeyDown="OnCodeKeyDown" />
                                    <Button Content="{Binding Source={StaticResource Strings}, Path=LoginPage_VerifyButton}"
                                            Command="{Binding VerifyCodeCommand}"
                                            IsEnabled="{Binding IsLoggingIn, Converter={StaticResource InvertBoolConverter}}"
                                            HorizontalAlignment="Stretch"
                                            Style="{StaticResource AccentButtonStyle}" />
                                    <HyperlinkButton Content="{Binding Source={StaticResource Strings}, Path=LoginPage_UseRecoveryCodeLink}"
                                                     Command="{Binding ToggleRecoveryModeCommand}"
                                                     HorizontalAlignment="Center" />
                                </StackPanel>

                                <!-- Recovery code input -->
                                <StackPanel Spacing="8"
                                            Visibility="{Binding RecoveryMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{Binding Source={StaticResource Strings}, Path=LoginPage_RecoveryCodeLabel}"
                                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBox Text="{Binding RecoveryCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             KeyDown="OnRecoveryKeyDown" />
                                    <Button Content="{Binding Source={StaticResource Strings}, Path=LoginPage_VerifyRecoveryButton}"
                                            Command="{Binding VerifyRecoveryCommand}"
                                            IsEnabled="{Binding IsLoggingIn, Converter={StaticResource InvertBoolConverter}}"
                                            HorizontalAlignment="Stretch"
                                            Style="{StaticResource AccentButtonStyle}" />
                                    <HyperlinkButton Content="{Binding Source={StaticResource Strings}, Path=LoginPage_BackToCodeLink}"
                                                     Command="{Binding ToggleRecoveryModeCommand}"
                                                     HorizontalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Additional Options -->
                            <StackPanel Spacing="8"
                                        HorizontalAlignment="Center">
                                <HyperlinkButton
                                                 Content="{Binding Source={StaticResource Strings}, Path=LoginPage_ForgotPasswordLink}"
                                                 HorizontalAlignment="Center"
                                                 Visibility="Collapsed" />

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            Spacing="4"
                                            Visibility="Collapsed">
                                    <TextBlock
                                               Text="{Binding Source={StaticResource Strings}, Path=LoginPage_NoAccountText}"
                                               VerticalAlignment="Center" />
                                    <HyperlinkButton
                                                     Content="{Binding Source={StaticResource Strings}, Path=LoginPage_SignUpLink}"
                                                     Padding="4,0" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>