<?xml version="1.0"
      encoding="utf-8"?>

<Page x:Class="Marechai.App.Presentation.Views.SoftwareCompilationViewPage"
      x:Name="PageRoot"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      NavigationCacheMode="Disabled"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,0,0,1"
              Padding="12,12,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Command="{Binding GoBackCommand}"
                    Style="{ThemeResource AlternateButtonStyle}"
                    ToolTipService.ToolTip="Go back"
                    Padding="8"
                    MinWidth="44"
                    MinHeight="44"
                    VerticalAlignment="Center">
                <FontIcon Glyph="&#xE72B;"
                          FontSize="16" />
            </Button>

            <StackPanel Grid.Column="1"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center">
                <TextBlock Text="{Binding CompilationName}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextControlForeground}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Padding="32"
                        Spacing="16">
                <ProgressRing IsActive="True"
                              IsIndeterminate="True"
                              Height="64"
                              Width="64"
                              Foreground="{ThemeResource SystemAccentColor}" />
                <TextBlock Text="{Binding Source={StaticResource Strings}, Path=LoadingText}"
                           FontSize="14"
                           TextAlignment="Center"
                           Foreground="{ThemeResource SystemBaseMediumColor}" />
            </StackPanel>

            <StackPanel Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Padding="24"
                        Spacing="16"
                        MaxWidth="400">
                <InfoBar IsOpen="True"
                         Severity="Error"
                         Title="{Binding Source={StaticResource Strings}, Path=SoftwareErrorInfoBar_Title}"
                         Message="{Binding ErrorMessage}"
                         IsClosable="False" />
                <Button Content="{Binding Source={StaticResource Strings}, Path=RetryButton}"
                        Command="{Binding LoadDataCommand}"
                        HorizontalAlignment="Center"
                        Style="{ThemeResource AccentButtonStyle}" />
            </StackPanel>

            <ScrollViewer Visibility="{Binding IsDataLoaded, Converter={StaticResource BoolToVisibilityConverter}}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Padding="16"
                            Spacing="24">

                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="20">
                        <StackPanel HorizontalAlignment="Center"
                                    Spacing="12">
                            <Image Source="{Binding CoverImageUrl}"
                                   Visibility="{Binding HasCover, Converter={StaticResource BoolToVisibilityConverter}}"
                                   Stretch="Uniform"
                                   MaxHeight="256"
                                   HorizontalAlignment="Center" />
                            <FontIcon Glyph="&#xE8B9;"
                                      Visibility="{Binding HasCover, Converter={StaticResource InvertBoolToVisibilityConverter}}"
                                      FontSize="72"
                                      HorizontalAlignment="Center"
                                      Foreground="{ThemeResource SystemAccentColor}" />
                            <TextBlock Text="{Binding CompilationName}"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"
                                       TextWrapping="WrapWholeWords" />
                            <Border Background="#9C27B0"
                                    CornerRadius="12"
                                    Padding="12,4"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Source={StaticResource Strings}, Path=Compilation}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="White" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <StackPanel Visibility="{Binding ShowBundledWith}"
                                Spacing="8">
                        <TextBlock Text="{Binding Source={StaticResource Strings}, Path=BundledWith}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextControlForeground}" />
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16,12">
                            <StackPanel Spacing="8">
                                <HyperlinkButton Content="{Binding BundledSoftwareName}"
                                                 Command="{Binding NavigateToBundledSoftwareCommand}"
                                                 Visibility="{Binding ShowBundledSoftware}"
                                                 HorizontalAlignment="Left"
                                                 Padding="0" />
                                <HyperlinkButton Content="{Binding BundledMachineName}"
                                                 Command="{Binding NavigateToBundledMachineCommand}"
                                                 Visibility="{Binding ShowBundledMachine}"
                                                 HorizontalAlignment="Left"
                                                 Padding="0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Visibility="{Binding ShowReleases}"
                                Spacing="12">
                        <TextBlock Text="{Binding Source={StaticResource Strings}, Path=Releases}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextControlForeground}" />
                        <ItemsControl ItemsSource="{Binding Releases}"
                                      HorizontalAlignment="Stretch">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical"
                                                Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.NavigateToReleaseCommand, ElementName=PageRoot}"
                                            CommandParameter="{Binding}"
                                            Padding="0"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch">
                                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="16,12">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{Binding PlatformDisplay}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource TextControlForeground}" />
                                                <TextBlock Text="{Binding ReleaseDateDisplay}"
                                                           Visibility="{Binding ReleaseDateDisplay, Converter={StaticResource NullToVisibilityConverter}}"
                                                           FontSize="12"
                                                           Foreground="{ThemeResource SystemBaseMediumColor}" />
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Visibility="{Binding ShowIncludedSoftware}"
                                Spacing="12">
                        <TextBlock Text="{Binding Source={StaticResource Strings}, Path=IncludedSoftware}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextControlForeground}" />

                        <ItemsControl ItemsSource="{Binding IncludedVersions}"
                                      HorizontalAlignment="Stretch">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical"
                                                Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="16,12">
                                        <TextBlock Text="{Binding DisplayText}"
                                                   FontSize="14"
                                                   Foreground="{ThemeResource TextControlForeground}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding IncludedSoftware}"
                                      HorizontalAlignment="Stretch">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical"
                                                Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.NavigateToIncludedSoftwareCommand, ElementName=PageRoot}"
                                            CommandParameter="{Binding}"
                                            Padding="0"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch">
                                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="16,12">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="14"
                                                       Foreground="{ThemeResource TextControlForeground}" />
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding IncludedCompilations}"
                                      HorizontalAlignment="Stretch">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical"
                                                Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.NavigateToIncludedCompilationCommand, ElementName=PageRoot}"
                                            CommandParameter="{Binding}"
                                            Padding="0"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch">
                                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="16,12">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="14"
                                                       Foreground="{ThemeResource TextControlForeground}" />
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
