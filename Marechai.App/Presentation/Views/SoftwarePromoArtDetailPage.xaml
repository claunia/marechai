<?xml version="1.0"
      encoding="utf-8"?>

<Page x:Class="Marechai.App.Presentation.Views.SoftwarePromoArtDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Name="PageRoot"
      NavigationCacheMode="Disabled"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,0,0,1"
              Padding="16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="&#xE72B;"
                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                    Command="{Binding GoBackCommand}"
                    Style="{ThemeResource TextBlockButtonStyle}"
                    Padding="8,4"
                    VerticalAlignment="Center"
                    Margin="0,0,12,0" />

            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center">
                <TextBlock Text="{Binding SoftwareName}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextControlForeground}"
                           TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal"
                            Spacing="8"
                            Visibility="{Binding HasGroupName, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding GroupName}"
                               FontSize="12"
                               Foreground="{ThemeResource SystemBaseMediumColor}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="4"
                        VerticalAlignment="Center">
                <Button Content="&#xE8B0;"
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        Click="ZoomIn_Click"
                        Style="{ThemeResource TextBlockButtonStyle}"
                        Padding="8,4"
                        ToolTipService.ToolTip="{Binding Source={StaticResource Strings}, Path=ZoomInLabel}" />
                <Button Content="&#xE71F;"
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        Click="ZoomOut_Click"
                        Style="{ThemeResource TextBlockButtonStyle}"
                        Padding="8,4"
                        ToolTipService.ToolTip="{Binding Source={StaticResource Strings}, Path=ZoomOutLabel}" />
                <Button Content="&#xE72C;"
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        Click="ZoomReset_Click"
                        Style="{ThemeResource TextBlockButtonStyle}"
                        Padding="8,4"
                        ToolTipService.ToolTip="{Binding Source={StaticResource Strings}, Path=ZoomResetLabel}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Padding="32"
                        Spacing="16">
                <ProgressRing IsActive="True"
                              IsIndeterminate="True"
                              Height="64"
                              Width="64"
                              Foreground="{ThemeResource SystemAccentColor}" />
                <TextBlock Text="{Binding Source={StaticResource Strings}, Path=LoadingPromoArtText}"
                           FontSize="14"
                           TextAlignment="Center"
                           Foreground="{ThemeResource SystemBaseMediumColor}" />
            </StackPanel>

            <StackPanel Visibility="{Binding ErrorOccurred, Converter={StaticResource BoolToVisibilityConverter}}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Padding="24"
                        Spacing="16"
                        MaxWidth="400">
                <InfoBar IsOpen="True"
                         Severity="Error"
                         Title="{Binding Source={StaticResource Strings}, Path=ErrorTitle}"
                         Message="{Binding ErrorMessage}"
                         IsClosable="False" />
            </StackPanel>

            <Grid Visibility="{Binding IsLoading, Converter={StaticResource InvertBoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{Binding Caption}"
                           FontSize="14"
                           Foreground="{ThemeResource SystemBaseMediumColor}"
                           HorizontalAlignment="Center"
                           Padding="16,8"
                           Visibility="{Binding HasCaption, Converter={StaticResource BoolToVisibilityConverter}}" />

                <ScrollViewer Grid.Row="1"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              ZoomMode="Disabled">
                    <Image x:Name="PromoArtImage"
                           Source="{Binding PromoArtSource}"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Page>
