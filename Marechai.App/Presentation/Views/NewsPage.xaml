<?xml version="1.0"
      encoding="utf-8"?>

<Page x:Class="Marechai.App.Presentation.Views.NewsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:loc="using:Marechai.App.Presentation.Converters"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
      NavigationCacheMode="Required"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid utu:SafeArea.Insets="VisibleBounds">
        <RefreshContainer x:Name="RefreshContainer"
                          RefreshRequested="RefreshContainer_RefreshRequested">
            <ScrollViewer>
                <Grid Padding="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <RowDefinition Height="Auto" /> <RowDefinition Height="Auto" /> <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Welcome Hero Section -->
                    <Border Grid.Row="0"
                            Style="{StaticResource HeroHeaderBorderStyle}">
                        <StackPanel Spacing="12">
                            <Image Source="ms-appx:///Assets/Icons/marechai_logo.svg"
                                   Height="60"
                                   HorizontalAlignment="Left" />
                            <TextBlock
                                       Text="{Binding Source={StaticResource Strings}, Path=WelcomeHeroTitle}"
                                       Style="{StaticResource HeroTitleTextStyle}" />
                            <TextBlock
                                       Text="{Binding Source={StaticResource Strings}, Path=WelcomeHeroLead}"
                                       Style="{StaticResource HeroSubtitleTextStyle}"
                                       Opacity="1" />
                            <controls:WrapPanel Orientation="Horizontal"
                                                HorizontalSpacing="8"
                                                VerticalSpacing="8">
                                <Button
                                        Content="{Binding Source={StaticResource Strings}, Path=BrowseComputersChip}"
                                        Command="{Binding NavigateToComputersCommand}"
                                        CornerRadius="16" />
                                <Button
                                        Content="{Binding Source={StaticResource Strings}, Path=BrowseConsolesChip}"
                                        Command="{Binding NavigateToConsolesCommand}"
                                        CornerRadius="16" />
                                <Button
                                        Content="{Binding Source={StaticResource Strings}, Path=BrowseSoftwareChip}"
                                        Command="{Binding NavigateToSoftwareCommand}"
                                        CornerRadius="16" />
                                <Button
                                        Content="{Binding Source={StaticResource Strings}, Path=AboutThisSiteChip}"
                                        Command="{Binding NavigateToAboutCommand}"
                                        CornerRadius="16" />
                            </controls:WrapPanel>
                            <controls:WrapPanel Orientation="Horizontal"
                                                HorizontalSpacing="8"
                                                VerticalSpacing="8">
                                <Button
                                        Content="{Binding Source={StaticResource Strings}, Path=LearnMoreButton}"
                                        Command="{Binding NavigateToAboutCommand}"
                                        Style="{ThemeResource AccentButtonStyle}" />
                                <Button
                                        Content="{Binding Source={StaticResource Strings}, Path=SignUpToContributeButton}"
                                        Command="{Binding NavigateToSignUpCommand}"
                                        Visibility="{Binding IsAuthenticated, Converter={StaticResource InvertBoolToVisibilityConverter}}" />
                            </controls:WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- News Title Section -->
                    <StackPanel Grid.Row="1"
                                Margin="0,0,0,16">
                        <TextBlock
                                   Text="{Binding Source={StaticResource Strings}, Path=LatestNewsTitle}"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="{ThemeResource SystemAccentColor}"
                                   Margin="0,0,0,8" />
                        <TextBlock
                                   Text="{Binding Source={StaticResource Strings}, Path=LatestNewsSubtitle}"
                                   FontSize="14"
                                   Foreground="{ThemeResource SystemBaseMediumColor}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Loading State -->
                    <StackPanel Grid.Row="3"
                                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Padding="32"
                                Spacing="16">
                        <ProgressRing IsActive="True"
                                      IsIndeterminate="True"
                                      Height="48"
                                      Width="48"
                                      Foreground="{ThemeResource SystemAccentColor}" />
                        <TextBlock
                                   Text="{Binding Source={StaticResource Strings}, Path=LoadingNewsText}"
                                   FontSize="16"
                                   TextAlignment="Center"
                                   Foreground="{ThemeResource SystemBaseMediumColor}" />
                    </StackPanel>

                    <!-- Error State -->
                    <StackPanel Grid.Row="3"
                                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"
                                VerticalAlignment="Center"
                                Spacing="16"
                                Padding="32">
                        <InfoBar IsOpen="True"
                                 Severity="Error"
                                 Title="{Binding Source={StaticResource Strings}, Path=ErrorLoadingNewsInfoBar_Title}"
                                 Message="{Binding ErrorMessage}"
                                 IsClosable="False" />
                        <Button
                                Content="{Binding Source={StaticResource Strings}, Path=RetryButton}"
                                Command="{Binding LoadNews}"
                                HorizontalAlignment="Center"
                                Style="{ThemeResource AccentButtonStyle}" />
                    </StackPanel>

                    <!-- News Feed -->
                    <ItemsControl Grid.Row="3"
                                  ItemsSource="{Binding NewsList}"
                                  Visibility="{Binding HasNewsItems, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ElevatedCardStyle}"
                                        Margin="0,0,0,12">

                                    <Grid RowSpacing="12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0"
                                                    Orientation="Horizontal"
                                                    Spacing="8"
                                                    VerticalAlignment="Center">
                                            <FontIcon Glyph="{Binding StatusGlyph}"
                                                      FontFamily="Segoe MDL2 Assets"
                                                      FontSize="14"
                                                      Foreground="{Binding StatusBrush}"
                                                      VerticalAlignment="Center" />
                                            <FontIcon Glyph="{Binding EntityGlyph}"
                                                      FontFamily="Segoe MDL2 Assets"
                                                      FontSize="14"
                                                      Foreground="{ThemeResource SystemBaseHighColor}"
                                                      VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding TimestampText}"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource SystemBaseMediumColor}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>

                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding DisplayText}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource SystemBaseHighColor}"
                                                   TextWrapping="WrapWholeWords" />

                                        <Grid Grid.Row="2"
                                              ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding ItemNameText}"
                                                       FontSize="14"
                                                       Foreground="{ThemeResource SystemBaseMediumHighColor}"
                                                       TextWrapping="WrapWholeWords"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding CanNavigateToItem, Converter={StaticResource InvertBoolToVisibilityConverter}}" />

                                            <Button Grid.Column="1"
                                                    Content="{Binding ItemNameText}"
                                                    Command="{Binding NavigateToItemCommand}"
                                                    CommandParameter="{Binding News}"
                                                    IsEnabled="{Binding CanNavigateToItem}"
                                                    Visibility="{Binding CanNavigateToItem, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Style="{ThemeResource AccentButtonStyle}" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical"
                                            Spacing="0" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>
        </RefreshContainer>
    </Grid>
</Page>
