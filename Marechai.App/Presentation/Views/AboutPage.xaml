<?xml version="1.0"
      encoding="utf-8"?>

<Page x:Class="Marechai.App.Presentation.Views.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:loc="using:Marechai.App.Presentation.Converters"
      xmlns:utu="using:Uno.Toolkit.UI"
      NavigationCacheMode="Required"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid utu:SafeArea.Insets="VisibleBounds">
        <ScrollViewer Padding="16">
            <StackPanel Spacing="16">

                <!-- Header -->
                <TextBlock Text="{Binding Source={StaticResource Strings}, Path=AboutPage_Title}"
                           Style="{ThemeResource TitleTextBlockStyle}" />

                <TextBlock x:Name="HeaderTitleText"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="0,0,0,8" />

                <!-- Sections are populated in code-behind (headers + rich-text bodies) -->
                <StackPanel x:Name="SectionsPanel"
                            Spacing="16" />

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
