<?xml version="1.0"
      encoding="utf-8"?>

<UserControl x:Class="Marechai.App.Presentation.Components.Admin.AdminSidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="using:Marechai.App.Presentation.Converters"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="280">
    <UserControl.Resources>
        <local:CollapseExpandIconConverter x:Key="CollapseExpandIconConverter" />
        <local:CollapseExpandTooltipConverter x:Key="CollapseExpandTooltipConverter" />
        <SolidColorBrush x:Key="AdminSidebarBackground"
                         Color="#6B1C1C" />
        <SolidColorBrush x:Key="AdminSidebarForeground"
                         Color="#F0F0F0" />
        <SolidColorBrush x:Key="AdminSidebarDivider"
                         Color="#8B3030" />
    </UserControl.Resources>

    <Grid Background="{StaticResource AdminSidebarBackground}"
          RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <RowDefinition Height="*" /> <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Sidebar Header with Collapse/Expand Button -->
        <Grid Grid.Row="0"
              Padding="8,8,8,8"
              BorderBrush="{StaticResource AdminSidebarDivider}"
              BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" /> <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar Title - Hidden when collapsed -->
            <TextBlock Grid.Column="0"
                       Text="{Binding AdminSidebarTitleText}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource AdminSidebarForeground}"
                       VerticalAlignment="Center"
                       Padding="4,0,0,0"
                       Visibility="{Binding SidebarContentVisible}" />

            <!-- Collapse/Expand Button - Always visible -->
            <Button Grid.Column="1"
                    Content="{Binding IsSidebarOpen, Converter={StaticResource CollapseExpandIconConverter}}"
                    Command="{Binding ToggleSidebarCommand}"
                    Background="Transparent"
                    Foreground="{StaticResource AdminSidebarForeground}"
                    Padding="8,8,8,8"
                    CornerRadius="4"
                    ToolTipService.ToolTip="{Binding IsSidebarOpen, Converter={StaticResource CollapseExpandTooltipConverter}}"
                    FontSize="14"
                    MinWidth="40"
                    MinHeight="40"
                    HorizontalAlignment="Center" />
        </Grid>

        <!-- Scrollable Navigation Items - Hidden when collapsed -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0"
                      Visibility="{Binding SidebarContentVisible}">
            <StackPanel Orientation="Vertical"
                        Spacing="0"
                        Padding="0">
                <!-- User Management -->
                <Button Content="{Binding UserManagementButtonText}"
                        Command="{Binding NavigateToUsersCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="16,10,16,10"
                        FontSize="13"
                        Background="Transparent"
                        Foreground="{StaticResource AdminSidebarForeground}"
                        BorderThickness="0"
                        CornerRadius="0" />

                <!-- Company Management -->
                <Button Content="{Binding CompanyManagementButtonText}"
                        Command="{Binding NavigateToAdminCompaniesCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="16,10,16,10"
                        FontSize="13"
                        Background="Transparent"
                        Foreground="{StaticResource AdminSidebarForeground}"
                        BorderThickness="0"
                        CornerRadius="0" />

                <!-- GPU Management -->
                <Button Content="{Binding GpuManagementButtonText}"
                        Command="{Binding NavigateToAdminGpusCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="16,10,16,10"
                        FontSize="13"
                        Background="Transparent"
                        Foreground="{StaticResource AdminSidebarForeground}"
                        BorderThickness="0"
                        CornerRadius="0" />

                <!-- Processor Management -->
                <Button Content="{Binding ProcessorManagementButtonText}"
                        Command="{Binding NavigateToAdminProcessorsCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="16,10,16,10"
                        FontSize="13"
                        Background="Transparent"
                        Foreground="{StaticResource AdminSidebarForeground}"
                        BorderThickness="0"
                        CornerRadius="0" />

                <!-- Instruction Set Management -->
                <Button Content="{Binding InstructionSetManagementButtonText}"
                        Command="{Binding NavigateToAdminInstructionSetsCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="16,10,16,10"
                        FontSize="13"
                        Background="Transparent"
                        Foreground="{StaticResource AdminSidebarForeground}"
                        BorderThickness="0"
                        CornerRadius="0" />

                <!-- ISA Extension Management -->
                <Button Content="{Binding ISExtensionManagementButtonText}"
                        Command="{Binding NavigateToAdminISExtensionsCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="16,10,16,10"
                        FontSize="13"
                        Background="Transparent"
                        Foreground="{StaticResource AdminSidebarForeground}"
                        BorderThickness="0"
                        CornerRadius="0" />

                <!-- Resolution Management -->
                <Button Content="{Binding ResolutionManagementButtonText}"
                        Command="{Binding NavigateToAdminResolutionsCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="16,10,16,10"
                        FontSize="13"
                        Background="Transparent"
                        Foreground="{StaticResource AdminSidebarForeground}"
                        BorderThickness="0"
                        CornerRadius="0" />

                <!-- Sound Synth Management -->
                <Button Content="{Binding SoundSynthManagementButtonText}"
                        Command="{Binding NavigateToAdminSoundSynthsCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="16,10,16,10"
                        FontSize="13"
                        Background="Transparent"
                        Foreground="{StaticResource AdminSidebarForeground}"
                        BorderThickness="0"
                        CornerRadius="0" />

                <!-- Screen Management -->
                <Button Content="{Binding ScreenManagementButtonText}"
                        Command="{Binding NavigateToAdminScreensCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="16,10,16,10"
                        FontSize="13"
                        Background="Transparent"
                        Foreground="{StaticResource AdminSidebarForeground}"
                        BorderThickness="0"
                        CornerRadius="0" />

                <!-- Machine Management -->
                <Button Content="{Binding MachineManagementButtonText}"
                        Command="{Binding NavigateToAdminMachinesCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="16,10,16,10"
                        FontSize="13"
                        Background="Transparent"
                        Foreground="{StaticResource AdminSidebarForeground}"
                        BorderThickness="0"
                        CornerRadius="0" />

                <!-- Machine Family Management -->
                <Button Content="{Binding MachineFamilyManagementButtonText}"
                        Command="{Binding NavigateToAdminMachineFamiliesCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="16,10,16,10"
                        FontSize="13"
                        Background="Transparent"
                        Foreground="{StaticResource AdminSidebarForeground}"
                        BorderThickness="0"
                        CornerRadius="0" />

                <!-- People Management -->
                <Button Content="{Binding PeopleManagementButtonText}"
                        Command="{Binding NavigateToAdminPeopleCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="16,10,16,10"
                        FontSize="13"
                        Background="Transparent"
                        Foreground="{StaticResource AdminSidebarForeground}"
                        BorderThickness="0"
                        CornerRadius="0" />

                <!-- Book Management -->
                <Button Content="{Binding BookManagementButtonText}"
                        Command="{Binding NavigateToAdminBooksCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="16,10,16,10"
                        FontSize="13"
                        Background="Transparent"
                        Foreground="{StaticResource AdminSidebarForeground}"
                        BorderThickness="0"
                        CornerRadius="0" />

                <!-- Document Management -->
                <Button Content="{Binding DocumentManagementButtonText}"
                        Command="{Binding NavigateToAdminDocumentsCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="16,10,16,10"
                        FontSize="13"
                        Background="Transparent"
                        Foreground="{StaticResource AdminSidebarForeground}"
                        BorderThickness="0"
                        CornerRadius="0" />

                <!-- Magazine Management -->
                <Button Content="{Binding MagazineManagementButtonText}"
                        Command="{Binding NavigateToAdminMagazinesCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="16,10,16,10"
                        FontSize="13"
                        Background="Transparent"
                        Foreground="{StaticResource AdminSidebarForeground}"
                        BorderThickness="0"
                        CornerRadius="0" />

                <!-- Software Management -->
                <Button Content="{Binding SoftwareAdminManagementButtonText}"
                        Command="{Binding NavigateToAdminSoftwareCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="16,10,16,10"
                        FontSize="13"
                        Background="Transparent"
                        Foreground="{StaticResource AdminSidebarForeground}"
                        BorderThickness="0"
                        CornerRadius="0" />

                <!-- Message Reports -->
                <Button Content="{Binding MessageReportsManagementButtonText}"
                        Command="{Binding NavigateToAdminMessageReportsCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="16,10,16,10"
                        FontSize="13"
                        Background="Transparent"
                        Foreground="{StaticResource AdminSidebarForeground}"
                        BorderThickness="0"
                        CornerRadius="0" />

                <!-- Software Release Management -->
                <Button Content="{Binding SoftwareReleaseManagementButtonText}"
                        Command="{Binding NavigateToAdminSoftwareReleasesCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="16,10,16,10"
                        FontSize="13"
                        Background="Transparent"
                        Foreground="{StaticResource AdminSidebarForeground}"
                        BorderThickness="0"
                        CornerRadius="0" />

                <!-- Software Screenshot Management -->
                <Button Content="{Binding SoftwareScreenshotManagementButtonText}"
                        Command="{Binding NavigateToAdminSoftwareScreenshotsCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="16,10,16,10"
                        FontSize="13"
                        Background="Transparent"
                        Foreground="{StaticResource AdminSidebarForeground}"
                        BorderThickness="0"
                        CornerRadius="0" />

                <!-- Software Platform Management -->
                <Button Content="{Binding SoftwarePlatformManagementButtonText}"
                        Command="{Binding NavigateToAdminSoftwarePlatformsCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="16,10,16,10"
                        FontSize="13"
                        Background="Transparent"
                        Foreground="{StaticResource AdminSidebarForeground}"
                        BorderThickness="0"
                        CornerRadius="0" />

                <!-- External Site Management -->
                <Button Content="{Binding ExternalSiteManagementButtonText}"
                        Command="{Binding NavigateToAdminExternalSitesCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="16,10,16,10"
                        FontSize="13"
                        Background="Transparent"
                        Foreground="{StaticResource AdminSidebarForeground}"
                        BorderThickness="0"
                        CornerRadius="0" />

                <!-- Software Family Management -->
                <Button Content="{Binding SoftwareFamilyManagementButtonText}"
                        Command="{Binding NavigateToAdminSoftwareFamiliesCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="16,10,16,10"
                        FontSize="13"
                        Background="Transparent"
                        Foreground="{StaticResource AdminSidebarForeground}"
                        BorderThickness="0"
                        CornerRadius="0" />

                <Button Content="{Binding WwpcImportsManagementButtonText}"
                        Command="{Binding NavigateToAdminWwpcImportsCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="16,10,16,10"
                        FontSize="13"
                        Background="Transparent"
                        Foreground="{StaticResource AdminSidebarForeground}"
                        BorderThickness="0"
                        CornerRadius="0" />
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Fixed Items - Hidden when collapsed -->
        <Grid Grid.Row="2"
              BorderBrush="{StaticResource AdminSidebarDivider}"
              BorderThickness="0,1,0,0"
              Padding="0"
              Visibility="{Binding IsSidebarOpen}">
            <StackPanel Orientation="Vertical"
                        Spacing="0">
                <!-- Back to Navigation -->
                <Button Content="{Binding BackToMainButtonText}"
                        Command="{Binding SwitchToMainSidebarCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="16,10,16,10"
                        FontSize="13"
                        Background="Transparent"
                        Foreground="{StaticResource AdminSidebarForeground}"
                        BorderThickness="0"
                        CornerRadius="0" />

                <!-- Login/Logout -->
                <Button Content="{Binding LoginLogoutButtonText}"
                        Command="{Binding LoginLogoutCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="16,10,16,10"
                        FontSize="13"
                        Background="Transparent"
                        Foreground="{StaticResource AdminSidebarForeground}"
                        BorderThickness="0"
                        CornerRadius="0" />

                <!-- Settings -->
                <Button Content="{Binding SettingsButtonText}"
                        Command="{Binding NavigateToSettingsCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="16,10,16,10"
                        FontSize="13"
                        Background="Transparent"
                        Foreground="{StaticResource AdminSidebarForeground}"
                        BorderThickness="0"
                        CornerRadius="0" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
