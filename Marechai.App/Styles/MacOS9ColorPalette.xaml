<ResourceDictionary x:Class="Marechai.App.Styles.MacOS9ColorPalette" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Mac OS 9 Platinum Theme — synced with Marechai/Theming/ThemeCatalog.cs MacOs9. -->
    <!-- Mac OS 8.5 — 9.2.2 (1998 — 2001) Appearance Manager defaults:
         Desktop #9999BB lavender (the iconic Platinum cool purple-gray)
         Window  #DDDDDD light gray pinstriped chrome
         Menu    #FFFFFF white menu bar
         Surface #FFFFFF white dialog / sheet body
         Accent  #3366CC royal blue (Apple Highlight Color default)
         Body    #000000 black text -->

    <!-- System Accent — Royal blue (Mac OS 9 default highlight colour, NOT iOS purple) -->
    <Color x:Key="SystemAccentColor">#3366CC</Color>
    <Color x:Key="SystemAccentColorLight1">#5C85D6</Color>
    <Color x:Key="SystemAccentColorLight2">#85A4E0</Color>
    <Color x:Key="SystemAccentColorLight3">#AEC3EA</Color>
    <Color x:Key="SystemAccentColorDark1">#2952A3</Color>
    <Color x:Key="SystemAccentColorDark2">#1F3D7A</Color>
    <Color x:Key="SystemAccentColorDark3">#142952</Color>

    <!-- Font Family — ChiKareGo (Charcoal-style bitmap recreation by Joachim Müller,
         Tepid Monkey Fonts). Used for headings & chrome; body falls through to system. -->
    <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/ChiKareGo.ttf#ChiKareGo</FontFamily>

    <!-- ALL TEXT - Black on white/lavender Platinum surfaces -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#000000" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#444466" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#444466" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#888899" />
    <SolidColorBrush x:Key="TextControlForeground" Color="#000000" />
    <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#000000" />
    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#000000" />
    <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#888899" />
    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#666677" />
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#666677" />
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#666677" />
    <SolidColorBrush x:Key="TextControlHeaderForeground" Color="#000000" />

    <!-- Button Text -->
    <SolidColorBrush x:Key="ButtonForeground" Color="#000000" />
    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#000000" />
    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#000000" />
    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#888899" />

    <!-- ComboBox Text -->
    <SolidColorBrush x:Key="ComboBoxForeground" Color="#000000" />
    <SolidColorBrush x:Key="ComboBoxForegroundPointerOver" Color="#000000" />
    <SolidColorBrush x:Key="ComboBoxForegroundPressed" Color="#000000" />
    <SolidColorBrush x:Key="ComboBoxForegroundFocused" Color="#000000" />
    <SolidColorBrush x:Key="ComboBoxForegroundDisabled" Color="#888899" />

    <!-- Navigation and List Text - White on lavender drawer, black on white surface -->
    <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#FFFFFF" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundPressed" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ListViewItemForeground" Color="#000000" />
    <SolidColorBrush x:Key="ListViewItemForegroundPointerOver" Color="#000000" />
    <SolidColorBrush x:Key="ListViewItemForegroundSelected" Color="#FFFFFF" />

    <!-- Icon Colors - White on lavender drawer -->
    <SolidColorBrush x:Key="IconElementForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="FontIconForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SymbolIconForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="GlyphBrush" Color="#FFFFFF" />

    <!-- System Control Foreground -->
    <SolidColorBrush x:Key="SystemControlForegroundBaseHighBrush" Color="#000000" />
    <SolidColorBrush x:Key="SystemControlForegroundBaseMediumBrush" Color="#000000" />
    <SolidColorBrush x:Key="SystemControlForegroundBaseMediumHighBrush" Color="#000000" />
    <SolidColorBrush x:Key="SystemControlForegroundBaseMediumLowBrush" Color="#444466" />
    <SolidColorBrush x:Key="SystemControlForegroundBaseLowBrush" Color="#888899" />

    <!-- System Colors -->
    <SolidColorBrush x:Key="SystemBaseMediumColor" Color="#000000" />
    <SolidColorBrush x:Key="SystemBaseHighColor" Color="#000000" />
    <SolidColorBrush x:Key="SystemBaseMediumHighColor" Color="#000000" />
    <SolidColorBrush x:Key="SystemBaseMediumLowColor" Color="#444466" />
    <SolidColorBrush x:Key="SystemBaseLowColor" Color="#888899" />

    <!-- Backgrounds - Lavender Platinum desktop, white surfaces -->
    <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#9999BB" />
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="#DDDDDD" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#DDDDDD" />
    <SolidColorBrush x:Key="SurfaceFillColorDefaultBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#DDDDDD" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#EEEEF4" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#DDDDDD" />
    <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="#CCCCDD" />
    <SolidColorBrush x:Key="SubtleFillColorTransparentBrush" Color="Transparent" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#EEEEF4" />
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#DDDDDD" />

    <!-- Button Backgrounds - Platinum 3D bevels -->
    <SolidColorBrush x:Key="ButtonBackground" Color="#DDDDDD" />
    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#EEEEF4" />
    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#B5CFEC" />
    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#CCCCDD" />

    <!-- TextBox Backgrounds - White input fields -->
    <SolidColorBrush x:Key="TextControlBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#EEEEF4" />

    <!-- ComboBox Backgrounds -->
    <SolidColorBrush x:Key="ComboBoxBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#EEEEF4" />
    <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#B5CFEC" />
    <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="#CCCCDD" />

    <!-- Navigation Backgrounds - Lavender desktop -->
    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#9999BB" />
    <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#9999BB" />

    <!-- List Backgrounds - White rows, royal-blue selection -->
    <SolidColorBrush x:Key="ListViewItemBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#B5CFEC" />
    <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#85A4E0" />
    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#3366CC" />
    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#5C85D6" />

    <!-- Borders - Mid-gray Platinum -->
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#888899" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#888899" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#CCCCDD" />
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#CCCCDD" />
    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#888899" />
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#666677" />
    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#3366CC" />
    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#888899" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#666677" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#3366CC" />

    <!-- Accent Colors - Royal blue primary, lavender secondary -->
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#3366CC" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#9999BB" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#888888" />

    <!-- Modernized UI: hero header + chip semantic colors -->
    <Color x:Key="HeroGradientStartColor">#3366CC</Color>
    <Color x:Key="HeroGradientEndColor">#9999BB</Color>
    <SolidColorBrush x:Key="HeroForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ChipInfoBackgroundBrush" Color="#5C85D6" />
    <SolidColorBrush x:Key="ChipInfoForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ChipSuccessBackgroundBrush" Color="#339933" />
    <SolidColorBrush x:Key="ChipSuccessForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ChipNeutralBackgroundBrush" Color="#DDDDDD" />
    <SolidColorBrush x:Key="ChipNeutralForegroundBrush" Color="#000000" />
    <SolidColorBrush x:Key="MediaGridItemBackgroundBrush" Color="#DDDDDD" />

</ResourceDictionary>
