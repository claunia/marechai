<ResourceDictionary x:Class="Marechai.App.Styles.SharedStyles"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
                    xmlns:components="using:Marechai.App.Presentation.Components">

    <!-- Structural styles for the modernized UI. Only ThemeResource references here,
         no literal colors — palettes override the semantic keys below. -->

    <FontFamily x:Key="MaterialIconsFontFamily">ms-appx:///Assets/Fonts/MaterialIcons-Regular.ttf#Material Icons</FontFamily>

    <!-- Fallback defaults for new semantic keys: a palette that does not override
         them still resolves to something reasonable. Every *ColorPalette.xaml
         overrides HeroGradientStartColor/EndColor/HeroForegroundBrush explicitly,
         these literal values only apply if a palette forgets to. -->
    <Color x:Key="HeroGradientStartColor">#7E57C2</Color>
    <Color x:Key="HeroGradientEndColor">#42A5F5</Color>
    <SolidColorBrush x:Key="HeroForegroundBrush" Color="White" />

    <StaticResource x:Key="ChipInfoBackgroundBrush" ResourceKey="AccentFillColorSecondaryBrush" />
    <SolidColorBrush x:Key="ChipInfoForegroundBrush" Color="White" />
    <StaticResource x:Key="ChipSuccessBackgroundBrush" ResourceKey="AccentFillColorTertiaryBrush" />
    <SolidColorBrush x:Key="ChipSuccessForegroundBrush" Color="White" />
    <StaticResource x:Key="ChipNeutralBackgroundBrush" ResourceKey="SubtleFillColorSecondaryBrush" />
    <StaticResource x:Key="ChipNeutralForegroundBrush" ResourceKey="TextFillColorPrimaryBrush" />

    <StaticResource x:Key="MediaGridItemBackgroundBrush" ResourceKey="CardBackgroundFillColorSecondaryBrush" />

    <!-- DataGrid cells can inherit an unreadable default foreground under some
         palettes/themes in Uno, which makes populated rows look empty. Force a
         readable baseline once here instead of duplicating it per admin page. -->
    <Style TargetType="controls:DataGrid">
        <Setter Property="Foreground" Value="{ThemeResource TextControlForeground}" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
    </Style>

    <!-- Hero header: gradient/flat banner with title + subtitle, used on landing
         and detail pages in place of bespoke per-page hardcoded gradients. -->
    <Style x:Key="HeroHeaderBorderStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="Margin" Value="0,0,0,16" />
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{ThemeResource HeroGradientStartColor}" Offset="0" />
                    <GradientStop Color="{ThemeResource HeroGradientEndColor}" Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HeroTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{ThemeResource HeroForegroundBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="HeroSubtitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource HeroForegroundBrush}" />
        <Setter Property="Opacity" Value="0.85" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Metadata card: replaces the repeated ad-hoc Border used for every field/collection item. -->
    <Style x:Key="MetadataCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16,12" />
    </Style>

    <!-- Same as above, with a shadow for use in non-interactive elevated cards (e.g. news feed). -->
    <Style x:Key="ElevatedCardStyle" TargetType="Border" BasedOn="{StaticResource MetadataCardStyle}">
        <Setter Property="Shadow">
            <Setter.Value>
                <ThemeShadow />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Borderless variant of MetadataCardStyle for pages that wrap field values directly
         in a StackPanel (background fill + rounded corners, no stroke) rather than a Border. -->
    <Style x:Key="MetadataPanelStyle" TargetType="StackPanel">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <!-- Shared control template for clickable cards (software/video/promo-art list items),
         replacing the ~60-line hand-rolled ControlTemplate+VisualStateManager duplicated per page. -->
    <ControlTemplate x:Key="InteractiveCardButtonTemplate" TargetType="Button">
        <Grid HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
            <Border x:Name="CardShadowBorder"
                    Style="{StaticResource MetadataCardStyle}"
                    Translation="0, 0, 4"
                    VerticalAlignment="Stretch">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
                <ContentPresenter Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}" />
            </Border>

            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="CardShadowBorder.Background"
                                    Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
                            <Setter Target="CardShadowBorder.Translation" Value="0, -2, 8" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="CardShadowBorder.Background"
                                    Value="{ThemeResource CardBackgroundFillColorTertiaryBrush}" />
                            <Setter Target="CardShadowBorder.Translation" Value="0, 0, 2" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </ControlTemplate>

    <!-- Chips / badges: semantic variants replacing hardcoded-hex Border badges. -->
    <Style x:Key="ChipBaseStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="12,4" />
    </Style>

    <Style x:Key="ChipInfoStyle" TargetType="Border" BasedOn="{StaticResource ChipBaseStyle}">
        <Setter Property="Background" Value="{ThemeResource ChipInfoBackgroundBrush}" />
    </Style>

    <Style x:Key="ChipSuccessStyle" TargetType="Border" BasedOn="{StaticResource ChipBaseStyle}">
        <Setter Property="Background" Value="{ThemeResource ChipSuccessBackgroundBrush}" />
    </Style>

    <Style x:Key="ChipWarningStyle" TargetType="Border" BasedOn="{StaticResource ChipBaseStyle}">
        <Setter Property="Background" Value="{ThemeResource WarningFillColorTertiaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource WarningBorderColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="ChipNeutralStyle" TargetType="Border" BasedOn="{StaticResource ChipBaseStyle}">
        <Setter Property="Background" Value="{ThemeResource ChipNeutralBackgroundBrush}" />
    </Style>

    <Style x:Key="ChipTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Compact icon-only buttons used in admin grid action columns. Keeping these
         centralized makes it easy to retune density/affordance without touching
         dozens of individual DataTemplates. -->
    <Style x:Key="AdminGridActionButtonStyle" TargetType="Button" BasedOn="{ThemeResource TextBlockButtonStyle}">
        <Setter Property="FontFamily" Value="{StaticResource MaterialIconsFontFamily}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="AdminGridDestructiveActionButtonStyle" TargetType="Button" BasedOn="{StaticResource AdminGridActionButtonStyle}">
        <Setter Property="Foreground" Value="{ThemeResource SystemErrorTextColor}" />
    </Style>


    <!-- Responsive media grid: covers / screenshots / promo art thumbnail grids. -->
    <UniformGridLayout x:Key="MediaUniformGridLayout"
                        MinItemWidth="200"
                        MinItemHeight="180"
                        MinColumnSpacing="12"
                        MinRowSpacing="12" />

    <Style x:Key="MediaGridCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource MediaGridItemBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <!-- Detail-page tabs, mirroring Blazor's MudTabs (all sections rendered upfront,
         lazy-mount is fine since WinUI TabView keeps inactive TabViewItem content alive).
         TabView (not Pivot) specifically because its tab strip natively scrolls/overflows
         on narrow viewports via TabWidthMode + an overflow dropdown — Pivot's header row
         has no such behavior in WinUI/Uno and silently clips long header sets instead. -->
    <Style x:Key="DetailTabViewStyle" TargetType="TabView">
        <Setter Property="IsAddTabButtonVisible" Value="False" />
        <Setter Property="TabWidthMode" Value="SizeToContent" />
        <Setter Property="CanReorderTabs" Value="False" />
        <Setter Property="CanDragTabs" Value="False" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="DetailTabViewItemStyle" TargetType="TabViewItem">
        <Setter Property="IsClosable" Value="False" />
    </Style>

    <!-- Letter/year browse-grid buttons (Computers/Software/Books/etc "browse by letter or year" pages),
         replacing a hardcoded skeuomorphic gray-gradient "keyboard key" style that ignored every palette. -->
    <!-- Letter/year browse-grid keycap. Drawn entirely with straight-line Path
         geometry (four trapezoid bevel facets + a flat top face), never a
         Border+CornerRadius — every CornerRadius-based attempt here hit a
         corner-clipping/chamfering rendering bug on this Uno.Sdk build.
         Implicit style (no x:Key): applies to every components:KeyButton. -->
    <Style TargetType="components:KeyButton">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextControlForeground}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="Margin" Value="4" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="MinWidth" Value="52" />
        <Setter Property="MinHeight" Value="52" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="components:KeyButton">
                    <Grid>
                        <!-- Stretch="Fill" on an individual Path scales THAT path's own
                             geometry bounding box to fill the element — it does not map
                             multiple paths into one shared coordinate space. With five
                             separate small-bbox Paths each doing that independently, every
                             one silently warped to cover the full tile, destroying the
                             bevel layout entirely. A Viewbox scales one fixed-size design
                             as a single rigid unit, so relative positions are preserved. -->
                        <Viewbox Stretch="Fill">
                            <Grid Width="100" Height="100">
                                <!-- Base footprint, the keycap's solid themed color -->
                                <Path x:Name="BaseFillPath"
                                      Data="M0,0 L100,0 L100,100 L0,100 Z"
                                      Fill="{TemplateBinding Background}" />

                                <!-- Bevel walls: translucent black/white overlays (not
                                     theme-tier brushes — those read as near-identical flat
                                     tones in most palettes). Achromatic overlays always
                                     read as light/shadow regardless of the base color. -->
                                <Path x:Name="BottomShadePath"
                                      Data="M0,100 L100,100 L86,86 L14,86 Z"
                                      Fill="Black"
                                      Opacity="0.30" />
                                <Path x:Name="RightShadePath"
                                      Data="M100,0 L100,100 L86,86 L86,14 Z"
                                      Fill="Black"
                                      Opacity="0.20" />
                                <Path x:Name="LeftLightPath"
                                      Data="M0,0 L14,14 L14,86 L0,100 Z"
                                      Fill="White"
                                      Opacity="0.10" />
                                <Path x:Name="TopLightPath"
                                      Data="M0,0 L100,0 L86,14 L14,14 Z"
                                      Fill="White"
                                      Opacity="0.18" />

                                <!-- Flat top face: undimmed base color, where the legend sits -->
                                <Path x:Name="TopFacePath"
                                      Data="M14,14 L86,14 L86,86 L14,86 Z"
                                      Fill="{TemplateBinding Background}" />
                                <!-- Outer edge stroke -->
                                <Path x:Name="OuterStrokePath"
                                      Data="M0,0 L100,0 L100,100 L0,100 Z"
                                      Stroke="{TemplateBinding BorderBrush}"
                                      StrokeThickness="2" />
                            </Grid>
                        </Viewbox>

                        <ContentPresenter x:Name="ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          TextWrapping="NoWrap" />

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="BaseFillPath.Fill" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
                                        <Setter Target="TopFacePath.Fill" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <!-- Flatten the bevel and darken the face to read as sunken -->
                                        <Setter Target="BaseFillPath.Fill" Value="{ThemeResource CardBackgroundFillColorTertiaryBrush}" />
                                        <Setter Target="TopFacePath.Fill" Value="{ThemeResource CardBackgroundFillColorTertiaryBrush}" />
                                        <Setter Target="TopLightPath.Opacity" Value="0.05" />
                                        <Setter Target="LeftLightPath.Opacity" Value="0.03" />
                                        <Setter Target="BottomShadePath.Opacity" Value="0.12" />
                                        <Setter Target="RightShadePath.Opacity" Value="0.08" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Opacity" Value="0.45" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Focused">
                                    <VisualState.Setters>
                                        <Setter Target="OuterStrokePath.Stroke" Value="{ThemeResource SystemAccentColor}" />
                                        <Setter Target="OuterStrokePath.StrokeThickness" Value="2" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unfocused" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
