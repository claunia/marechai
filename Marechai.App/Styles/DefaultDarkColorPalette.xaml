<ResourceDictionary x:Class="Marechai.App.Styles.DefaultDarkColorPalette" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Marechai default dark theme — synced with Marechai/Theming/ThemeCatalog.cs DefaultDark. -->

    <!-- System Accent — historical Marechai purple -->
    <Color x:Key="SystemAccentColor">#7E57C2</Color>
    <Color x:Key="SystemAccentColorLight1">#9575CD</Color>
    <Color x:Key="SystemAccentColorLight2">#B39DDB</Color>
    <Color x:Key="SystemAccentColorLight3">#D1C4E9</Color>
    <Color x:Key="SystemAccentColorDark1">#673AB7</Color>
    <Color x:Key="SystemAccentColorDark2">#5E35B1</Color>
    <Color x:Key="SystemAccentColorDark3">#512DA8</Color>

    <!-- Typography -->
    <FontFamily x:Key="ContentControlThemeFontFamily">XamlAutoFontFamily</FontFamily>

    <!-- Text -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#E0E0E0" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#A0A0A0" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#A0A0A0" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#6F6F6F" />
    <SolidColorBrush x:Key="TextControlForeground" Color="#E0E0E0" />
    <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#E0E0E0" />
    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#E0E0E0" />
    <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#6F6F6F" />
    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#A0A0A0" />
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#B8B8B8" />
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#B8B8B8" />
    <SolidColorBrush x:Key="TextControlHeaderForeground" Color="#7E57C2" />

    <!-- Button Text -->
    <SolidColorBrush x:Key="ButtonForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#A0A0A0" />

    <!-- ComboBox Text -->
    <SolidColorBrush x:Key="ComboBoxForeground" Color="#E0E0E0" />
    <SolidColorBrush x:Key="ComboBoxForegroundPointerOver" Color="#E0E0E0" />
    <SolidColorBrush x:Key="ComboBoxForegroundPressed" Color="#E0E0E0" />
    <SolidColorBrush x:Key="ComboBoxForegroundFocused" Color="#E0E0E0" />
    <SolidColorBrush x:Key="ComboBoxForegroundDisabled" Color="#6F6F6F" />

    <!-- Navigation and List Text -->
    <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#E0E0E0" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#FFFFFF" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundPressed" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ListViewItemForeground" Color="#E0E0E0" />
    <SolidColorBrush x:Key="ListViewItemForegroundPointerOver" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ListViewItemForegroundSelected" Color="#FFFFFF" />

    <!-- Icons -->
    <SolidColorBrush x:Key="IconElementForeground" Color="#E0E0E0" />
    <SolidColorBrush x:Key="FontIconForeground" Color="#E0E0E0" />
    <SolidColorBrush x:Key="SymbolIconForeground" Color="#E0E0E0" />
    <SolidColorBrush x:Key="GlyphBrush" Color="#E0E0E0" />

    <!-- System Control Foreground -->
    <SolidColorBrush x:Key="SystemControlForegroundBaseHighBrush" Color="#E0E0E0" />
    <SolidColorBrush x:Key="SystemControlForegroundBaseMediumBrush" Color="#E0E0E0" />
    <SolidColorBrush x:Key="SystemControlForegroundBaseMediumHighBrush" Color="#E0E0E0" />
    <SolidColorBrush x:Key="SystemControlForegroundBaseMediumLowBrush" Color="#A0A0A0" />
    <SolidColorBrush x:Key="SystemControlForegroundBaseLowBrush" Color="#6F6F6F" />

    <!-- System Colors -->
    <SolidColorBrush x:Key="SystemBaseMediumColor" Color="#E0E0E0" />
    <SolidColorBrush x:Key="SystemBaseHighColor" Color="#E0E0E0" />
    <SolidColorBrush x:Key="SystemBaseMediumHighColor" Color="#E0E0E0" />
    <SolidColorBrush x:Key="SystemBaseMediumLowColor" Color="#A0A0A0" />
    <SolidColorBrush x:Key="SystemBaseLowColor" Color="#6F6F6F" />

    <!-- Backgrounds -->
    <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#121212" />
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#1E1E2F" />
    <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="#1A1A2E" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#1E1E2F" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#16213E" />
    <SolidColorBrush x:Key="SurfaceFillColorDefaultBrush" Color="#1E1E2F" />
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#1A1A2E" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#16213E" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#24243A" />
    <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="#171722" />
    <SolidColorBrush x:Key="SubtleFillColorTransparentBrush" Color="Transparent" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#24243A" />
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#2B2B42" />

    <!-- Button Backgrounds -->
    <SolidColorBrush x:Key="ButtonBackground" Color="#7E57C2" />
    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#9575CD" />
    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#673AB7" />
    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#3A3A4D" />

    <!-- TextBox Backgrounds -->
    <SolidColorBrush x:Key="TextControlBackground" Color="#1A1A2E" />
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#1E1E2F" />
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#24243A" />
    <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#171722" />

    <!-- ComboBox Backgrounds -->
    <SolidColorBrush x:Key="ComboBoxBackground" Color="#1A1A2E" />
    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#1E1E2F" />
    <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#24243A" />
    <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="#24243A" />
    <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="#171722" />

    <!-- Navigation Backgrounds -->
    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#16213E" />
    <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="#1A1A2E" />
    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#16213E" />

    <!-- List Backgrounds -->
    <SolidColorBrush x:Key="ListViewItemBackground" Color="Transparent" />
    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#24243A" />
    <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#2B2B42" />
    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#7E57C2" />
    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#9575CD" />

    <!-- Borders -->
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#3D3D55" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#3D3D55" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#4B4B66" />
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#3D3D55" />
    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#3D3D55" />
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#7E57C2" />
    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#7E57C2" />
    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#3D3D55" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#7E57C2" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#7E57C2" />

    <!-- Accent Colors -->
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#7E57C2" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#42A5F5" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#9575CD" />

    <!-- Modernized UI: hero header + chip semantic colors -->
    <Color x:Key="HeroGradientStartColor">#7E57C2</Color>
    <Color x:Key="HeroGradientEndColor">#42A5F5</Color>
    <SolidColorBrush x:Key="HeroForegroundBrush" Color="White" />
    <SolidColorBrush x:Key="ChipInfoBackgroundBrush" Color="#42A5F5" />
    <SolidColorBrush x:Key="ChipInfoForegroundBrush" Color="White" />
    <SolidColorBrush x:Key="ChipSuccessBackgroundBrush" Color="#43A047" />
    <SolidColorBrush x:Key="ChipSuccessForegroundBrush" Color="White" />
    <SolidColorBrush x:Key="ChipNeutralBackgroundBrush" Color="#24243A" />
    <SolidColorBrush x:Key="ChipNeutralForegroundBrush" Color="#E0E0E0" />
    <SolidColorBrush x:Key="MediaGridItemBackgroundBrush" Color="#16213E" />

</ResourceDictionary>
