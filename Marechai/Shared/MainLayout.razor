@inherits LayoutComponentBase
@implements IDisposable
@using Marechai.Services
@using Marechai.Theming
@inject StringLocalizer<NavMenu> L
@inject ThemeStateService ThemeState
@inject ThemeFontLoader ThemeFontLoader
@inject AuthService AuthService

<MudThemeProvider Theme="@ThemeState.CurrentTheme.MudTheme" IsDarkMode="@ThemeState.CurrentTheme.IsDark"/>
<MudPopoverProvider/>
<MudDialogProvider/>
<MudSnackbarProvider/>

<MudLayout>
    <MudAppBar Elevation="4" Color="Color.Primary" Style="@(_isAdminMode ? "background-color: #4a1520 !important;" : "")">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="ToggleDrawer"/>
        <MudIcon Icon="@Icons.Material.Filled.Museum" Class="ml-2"/>
        <MudText Typo="Typo.h6" Class="ml-2">Marechai</MudText>
        <MudSpacer/>
        <MudHidden Breakpoint="Breakpoint.SmAndDown">
            <div class="mr-3" style="min-width:280px;max-width:480px;flex:0 1 auto;">
                <SearchBar/>
            </div>
        </MudHidden>
        <MudHidden Breakpoint="Breakpoint.SmAndDown" Invert="true">
            <SearchIcon/>
        </MudHidden>
        <AuthorizeView>
            <Authorized>
                <MudTooltip Text="@L["Messages"]">
                    <MudBadge Content="@_unreadMessageCount" Color="Color.Error" Overlap="true" Visible="@(_unreadMessageCount > 0)">
                        <MudIconButton Icon="@Icons.Material.Filled.Mail" Color="Color.Inherit"
                                       Href="/messages" aria-label="@L["Messages"]"/>
                    </MudBadge>
                </MudTooltip>
            </Authorized>
        </AuthorizeView>
        <LoginDisplay/>
        <MudHidden Breakpoint="Breakpoint.SmAndDown">
            <MudButton Href="/about" Color="Color.Inherit" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Info">@L["About"]</MudButton>
        </MudHidden>
        <MudHidden Breakpoint="Breakpoint.SmAndDown" Invert="true">
            <MudTooltip Text="@L["About"]">
                <MudIconButton Href="/about" Color="Color.Inherit" Icon="@Icons.Material.Filled.Info" aria-label="@L["About"]"/>
            </MudTooltip>
        </MudHidden>
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2" Variant="DrawerVariant.Responsive" Breakpoint="Breakpoint.Md" OpenMiniOnHover="true"
               Style="@(_isAdminMode ? "background-color: #3e1216 !important;" : "")">
        <MudDrawerHeader>
            <MudStack AlignItems="AlignItems.Center" Row="true" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.Museum" Size="Size.Large" Color="@(_isAdminMode ? Color.Error : Color.Primary)"/>
                <MudText Typo="Typo.h6" Color="@(_isAdminMode ? Color.Error : Color.Primary)">@(_isAdminMode ? L["Admin area"] : "Marechai")</MudText>
            </MudStack>
        </MudDrawerHeader>
        <MudDivider/>
        @if(_isAdminMode)
        {
            <AdminNavMenu OnSwitchToNormalMode="@(() => { _isAdminMode = false; StateHasChanged(); })"/>
        }
        else
        {
            <NavMenu OnSwitchToAdminMode="@(() => { _isAdminMode = true; StateHasChanged(); })"/>
        }
    </MudDrawer>
    <MudMainContent Class="pa-6 mt-16">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private bool _isAdminMode;
    private int  _unreadMessageCount;
    private System.Threading.Timer _messagePollTimer;
    private bool _themeInitialised;
    private string _appliedFontKey;

    [Inject] MessagingService MessagingService { get; set; }
    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState> AuthState { get; set; }

    protected override void OnInitialized()
    {
        ThemeState.Changed += HandleThemeChanged;
    }

    private void HandleThemeChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(firstRender)
        {
            _messagePollTimer = new System.Threading.Timer(async _ =>
            {
                try
                {
                    if(AuthState is null) return;

                    var auth = await AuthState;
                    if(auth?.User?.Identity?.IsAuthenticated != true)
                    {
                        if(_unreadMessageCount != 0)
                        {
                            _unreadMessageCount = 0;
                            await InvokeAsync(StateHasChanged);
                        }

                        return;
                    }

                    int count = await MessagingService.GetUnreadCountAsync();
                    if(count != _unreadMessageCount)
                    {
                        _unreadMessageCount = count;
                        await InvokeAsync(StateHasChanged);
                    }
                }
                catch
                {
                    // ignore polling errors
                }
            }, null, TimeSpan.Zero, TimeSpan.FromSeconds(60));
        }

        // Load the user's saved theme once auth state is available.
        if(!_themeInitialised && AuthState is not null)
        {
            _themeInitialised = true;

            try
            {
                var auth = await AuthState;

                if(auth?.User?.Identity?.IsAuthenticated == true)
                {
                    var profile = await AuthService.GetProfileAsync();

                    if(profile is not null && !string.IsNullOrWhiteSpace(profile.PreferredThemeId))
                        await ThemeState.SetByIdAsync(profile.PreferredThemeId);
                }
            }
            catch
            {
                // Failure to load profile leaves the default theme — non-fatal.
            }
        }

        // Sync the web-font links in <head> with the current theme. Idempotent: cheap when nothing changed.
        var fonts = ThemeState.CurrentTheme.WebFontUrls;
        var fontKey = fonts is null || fonts.Count == 0 ? "" : string.Join("\n", fonts);

        if(!string.Equals(fontKey, _appliedFontKey, StringComparison.Ordinal))
        {
            _appliedFontKey = fontKey;
            await ThemeFontLoader.ApplyAsync(fonts);
        }
    }

    public void Dispose()
    {
        _messagePollTimer?.Dispose();
        ThemeState.Changed -= HandleThemeChanged;
    }

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }
}