@inject StringLocalizer<NavMenu> L

<AuthorizeView Roles="Admin, UberAdmin">
    <Authorized>
        <MudNavMenu>
            <MudNavLink Icon="@Icons.Material.Filled.ArrowBack" OnClick="@(() => OnSwitchToNormalMode.InvokeAsync())">@L["Back to Navigation"]</MudNavLink>
            <MudDivider Class="my-2"/>
            <AuthorizeView Roles="UberAdmin" Context="uberAdminContext">
                <Authorized>
                    <MudNavLink Href="/admin/users" Icon="@Icons.Material.Filled.AdminPanelSettings">@L["User Management"]</MudNavLink>
                </Authorized>
            </AuthorizeView>
            <MudNavLink Href="/admin/review-reports" Icon="@Icons.Material.Filled.Flag">@L["Review Reports"]</MudNavLink>
            <MudNavLink Href="/admin/messages/reports" Icon="@Icons.Material.Filled.Report">@L["Message Reports"]</MudNavLink>
            <MudNavLink Href="/admin/companies" Icon="@Icons.Material.Filled.Business">@L["Company Management"]</MudNavLink>
            <MudNavLink Href="/admin/machines" Icon="@Icons.Material.Filled.Computer">@L["Machine Management"]</MudNavLink>
            <MudNavLink Href="/admin/machine-families" Icon="@Icons.Material.Filled.AccountTree">@L["Machine Family Management"]</MudNavLink>
            <MudNavLink Href="/admin/gpus" Icon="@Icons.Material.Filled.Memory">@L["GPU Management"]</MudNavLink>
            <MudNavLink Href="/admin/processors" Icon="@Icons.Material.Filled.DeveloperBoard">@L["Processor Management"]</MudNavLink>
            <MudNavLink Href="/admin/instruction-sets" Icon="@Icons.Material.Filled.Schema">@L["Instruction Set Management"]</MudNavLink>
            <MudNavLink Href="/admin/instruction-set-extensions" Icon="@Icons.Material.Filled.Extension">@L["Instruction Set Extension Management"]</MudNavLink>
            <MudNavLink Href="/admin/resolutions" Icon="@Icons.Material.Filled.AspectRatio">@L["Resolution Management"]</MudNavLink>
            <MudNavLink Href="/admin/screens" Icon="@Icons.Material.Filled.Monitor">@L["Screen Management"]</MudNavLink>
            <MudNavLink Href="/admin/sound-synths" Icon="@Icons.Material.Filled.MusicNote">@L["Sound Synth Management"]</MudNavLink>
            <MudNavLink Href="/admin/people" Icon="@Icons.Material.Filled.People">@L["People Management"]</MudNavLink>
            <MudNavLink Href="/admin/books" Icon="@Icons.Material.Filled.MenuBook">@L["Book Management"]</MudNavLink>
            <MudNavLink Href="/admin/documents" Icon="@Icons.Material.Filled.Article">@L["Document Management"]</MudNavLink>
            <MudNavLink Href="/admin/magazines" Icon="@Icons.Material.Filled.AutoStories">@L["Magazine Management"]</MudNavLink>
            <MudDivider Class="my-2"/>
            <MudNavLink Href="/admin/software" Icon="@Icons.Material.Filled.Apps">@L["Software Management"]</MudNavLink>
            <MudNavLink Href="/admin/software-families" Icon="@Icons.Material.Filled.FolderSpecial">@L["Software Family Management"]</MudNavLink>
            <MudNavLink Href="/admin/software-platforms" Icon="@Icons.Material.Filled.Devices">@L["Software Platform Management"]</MudNavLink>
            <MudNavLink Href="/admin/software/releases" Icon="@Icons.Material.Filled.Album">@L["Software Release Management"]</MudNavLink>
            <MudNavLink Href="/admin/software-attributes" Icon="@Icons.Material.Filled.Tune">@L["Software Attributes Management"]</MudNavLink>
        </MudNavMenu>
    </Authorized>
</AuthorizeView>

@code {
    [Parameter]
    public EventCallback OnSwitchToNormalMode { get; set; }
}
