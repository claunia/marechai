@using System.Threading
@using Marechai.ApiClient.Models
@using Marechai.Data
@using Marechai.Helpers
@using Marechai.Services
@inject SearchService SearchService
@inject NavigationManager Nav
@inject StringLocalizer<NavMenu> L

<MudAutocomplete T="SearchResultDto"
                 @bind-Value="_selected"
                 @bind-Value:after="OnSelected"
                 @bind-Text="_lastQuery"
                 SearchFunc="@SearchAsync"
                 ToStringFunc="@(r => r?.DisplayName ?? string.Empty)"
                 ResetValueOnEmptyText="false"
                 CoerceText="false"
                 CoerceValue="false"
                 Strict="false"
                 DebounceInterval="200"
                 MinCharacters="3"
                 Placeholder="@L["Search\u2026"]"
                 Dense="true"
                 Margin="Margin.Dense"
                 Variant="Variant.Outlined"
                 Adornment="Adornment.End"
                 AdornmentIcon="@Icons.Material.Filled.Search"
                 AdornmentColor="Color.Default"
                 OnAdornmentClick="OnAdornmentClick"
                 OnKeyDown="OnKeyDown"
                 PopoverClass="search-popover-fullwidth"
                 Style="background-color: rgba(255,255,255,0.15); border-radius: 4px;"
                 @ref="_autocomplete">
    <ItemTemplate Context="item">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Style="width:100%;">
            <MudIcon Icon="@IconFor((SearchEntityType)item.EntityType.GetValueOrDefault())"
                     Size="Size.Small"
                     Color="Color.Primary"/>
            <MudStack Spacing="0" Style="flex-grow:1;min-width:0;">
                <MudText Typo="Typo.body2" Style="font-weight:500;text-overflow:ellipsis;overflow:hidden;white-space:nowrap;">
                    @item.DisplayName
                </MudText>
                @if(!string.IsNullOrWhiteSpace(item.AltName))
                {
                    <MudText Typo="Typo.caption" Style="text-overflow:ellipsis;overflow:hidden;white-space:nowrap;">
                        @item.AltName
                    </MudText>
                }
            </MudStack>
            <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">
                @CategoryLabel((SearchEntityType)item.EntityType.GetValueOrDefault())
            </MudChip>
            @if(item.Year.HasValue)
            {
                <MudText Typo="Typo.caption" Color="Color.Default">@item.Year</MudText>
            }
        </MudStack>
    </ItemTemplate>
    <NoItemsTemplate>
        <MudStack Spacing="1" Class="pa-2">
            <MudText Typo="Typo.caption" Color="Color.Default">@L["No results found."]</MudText>
            <MudDivider Class="my-1"/>
            <MudText Typo="Typo.caption" Style="font-weight:500;">@L["Tip: prefix to filter by category"]</MudText>
            <MudText Typo="Typo.caption" Color="Color.Default">
                c/ @L["Companies"] &nbsp; m/ @L["Computers"] &nbsp; cn/ @L["Consoles"] &nbsp; sm/ @L["Smartphones"]<br/>
                pda/ @L["PDAs"] &nbsp; tablet/ @L["Tablets"] &nbsp; b/ @L["Books"] &nbsp; d/ @L["Documents"] &nbsp; mg/ @L["Magazines"] &nbsp; g/ @L["GPUs"]<br/>
                p/ @L["Processors"] &nbsp; s/ @L["Sound synthesizers"] &nbsp; pe/ @L["People"]<br/>
                sw/ @L["Software"] &nbsp; cl/ @L["Software Compilations"]
            </MudText>
            <MudDivider Class="my-1"/>
            <MudLink Href="/search/advanced" Underline="Underline.Hover">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <MudIcon Icon="@Icons.Material.Filled.Tune" Size="Size.Small"/>
                    <MudText Typo="Typo.caption">@L["Advanced Search"]</MudText>
                </MudStack>
            </MudLink>
        </MudStack>
    </NoItemsTemplate>
</MudAutocomplete>

@code {
    SearchResultDto _selected;
    string _lastQuery = string.Empty;
    MudAutocomplete<SearchResultDto> _autocomplete;

    Task<IEnumerable<SearchResultDto>> SearchAsync(string value, CancellationToken ct)
        => SearchAsyncCore(value, ct);

    async Task<IEnumerable<SearchResultDto>> SearchAsyncCore(string value, CancellationToken ct)
    {
        if(string.IsNullOrWhiteSpace(value) || value.Length < 3) return Array.Empty<SearchResultDto>();

        (string stripped, SearchEntityType? type) = SearchPrefixParser.Parse(value);
        if(stripped.Length < 3) return Array.Empty<SearchResultDto>();

        return await SearchService.AutocompleteAsync(stripped, type.HasValue ? (int)type.Value : null);
    }

    void OnSelected()
    {
        if(_selected == null) return;
        Nav.NavigateTo(SearchUrlBuilder.For(_selected));
    }

    void OnAdornmentClick()
    {
        // Adornment search icon → go to results page with the current query.
        if(string.IsNullOrWhiteSpace(_lastQuery)) Nav.NavigateTo("/search/advanced");
        else Nav.NavigateTo($"/search?q={Uri.EscapeDataString(_lastQuery)}");
    }

    void OnKeyDown(KeyboardEventArgs e)
    {
        if(e.Key == "Enter" && !string.IsNullOrWhiteSpace(_lastQuery))
            Nav.NavigateTo($"/search?q={Uri.EscapeDataString(_lastQuery)}");
    }

    string CategoryLabel(SearchEntityType type) => type switch
    {
        SearchEntityType.Company             => L["Company"],
        SearchEntityType.Computer            => L["Computer"],
        SearchEntityType.Console             => L["Console"],
        SearchEntityType.Smartphone          => L["Smartphone"],
        SearchEntityType.Pda                 => L["PDA"],
        SearchEntityType.Tablet              => L["Tablet"],
        SearchEntityType.Book                => L["Book"],
        SearchEntityType.Document            => L["Document"],
        SearchEntityType.Magazine            => L["Magazine"],
        SearchEntityType.Gpu                 => L["GPU"],
        SearchEntityType.Processor           => L["Processor"],
        SearchEntityType.SoundSynth          => L["Sound Synthesizer"],
        SearchEntityType.Person              => L["Person"],
        SearchEntityType.Software            => L["Software"],
        SearchEntityType.SoftwareCompilation => L["Compilation"],
        _                                    => string.Empty
    };

    static string IconFor(SearchEntityType type) => SearchIcons.For(type);
}
