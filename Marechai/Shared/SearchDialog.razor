@using Marechai.Services
@inject StringLocalizer<NavMenu> L

<MudDialog>
    <DialogContent>
        <SearchBar/>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">@L["Close"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; }
    void Close() => MudDialog.Close();
}
