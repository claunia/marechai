@inject StringLocalizer<NavMenu> L

<MudNavMenu>
    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Newspaper">@L["News"]</MudNavLink>
    <MudNavLink Href="/companies" Icon="@Icons.Material.Filled.Business">@L["Companies"]</MudNavLink>
    <MudNavLink Href="/computers" Icon="@Icons.Material.Filled.Computer">@L["Computers"]</MudNavLink>
    <MudNavLink Href="/consoles" Icon="@Icons.Material.Filled.SportsEsports">@L["Consoles"]</MudNavLink>
    <MudNavLink Href="/pdas" Icon="@Icons.Material.Filled.Devices">@L["PDAs"]</MudNavLink>
    <MudNavLink Href="/smartphones" Icon="@Icons.Material.Filled.Smartphone">@L["Smartphones"]</MudNavLink>
    <MudNavLink Href="/tablets" Icon="@Icons.Material.Filled.Tablet">@L["Tablets"]</MudNavLink>
    <MudNavLink Href="/books" Icon="@Icons.Material.Filled.Book">@L["Books"]</MudNavLink>
    <MudNavLink Href="/documents" Icon="@Icons.Material.Filled.Article">@L["Documents"]</MudNavLink>
    <MudNavLink Href="/magazines" Icon="@Icons.Material.Filled.MenuBook">@L["Magazines"]</MudNavLink>
    <MudNavLink Href="/gpus" Icon="@Icons.Material.Filled.Tv">@L["GPUs"]</MudNavLink>
    <MudNavLink Href="/processors" Icon="@Icons.Material.Filled.Memory">@L["Processors"]</MudNavLink>
    <MudNavLink Href="/soundsynths" Icon="@Icons.Material.Filled.MusicNote">@L["Sound synthesizers"]</MudNavLink>
    <MudNavLink Href="/people" Icon="@Icons.Material.Filled.People">@L["People"]</MudNavLink>
    <MudNavGroup Title="@L["Software"]" Icon="@Icons.Material.Filled.Apps" Expanded="false">
        <MudNavLink Href="/software" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Apps">@L["Browse software"]</MudNavLink>
        <MudNavLink Href="/software/rankings" Icon="@Icons.Material.Filled.EmojiEvents">@L["Rankings"]</MudNavLink>
    </MudNavGroup>
    <AuthorizeView>
        <Authorized>
            <MudDivider Class="my-2"/>
            <MudNavLink Href="/account/profile" Icon="@Icons.Material.Filled.Person">@L["Profile"]</MudNavLink>
            <MudNavLink Href="/account/change-password" Icon="@Icons.Material.Filled.Lock">@L["Change Password"]</MudNavLink>
        </Authorized>
    </AuthorizeView>
    <AuthorizeView Roles="Admin, UberAdmin">
        <Authorized>
            <MudDivider Class="my-2"/>
            <MudNavLink Icon="@Icons.Material.Filled.AdminPanelSettings" OnClick="@(() => OnSwitchToAdminMode.InvokeAsync())">@L["Administration"]</MudNavLink>
        </Authorized>
    </AuthorizeView>
</MudNavMenu>

@code {
    [Parameter]
    public EventCallback OnSwitchToAdminMode { get; set; }
}