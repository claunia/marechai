@page "/smartphones/all"
@page "/smartphones/year/{Year:int}"
@page "/smartphones/{StartingCharacter}"
@using Marechai.ApiClient.Models
@inherits OwningComponentBase<SmartphonesService>
@inject IStringLocalizer<SmartphonesService> L

@if(_smartphones is null)
{
    <div class="d-flex justify-center pa-8">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true"/>
    </div>

    return;
}
<MudPaper Class="pa-6 mb-6" Elevation="0" Style="background: linear-gradient(135deg, #7e57c2 0%, #42a5f5 100%); border-radius: 16px;">
    <MudText Typo="Typo.h5" Style="color: white;">@L["Search results:"]</MudText>
    @if(_character.HasValue)
    {
        <MudText Typo="Typo.h6" Style="color: rgba(255,255,255,0.85);">@string.Format(L["Smartphones starting with {0}"], _character)</MudText>
    }
    else if(Year.HasValue)
    {
        <MudText Typo="Typo.h6" Style="color: rgba(255,255,255,0.85);">@string.Format(L["Smartphones introduced in {0}"], Year)</MudText>
    }
</MudPaper>

@if(_smartphones?.Count > 0)
{
    <MudText Typo="Typo.body2" Class="mb-2">@string.Format(L["{0} smartphones found in the database."], _smartphones.Count)</MudText>
    <MudList T="MachineDto" Dense="true">
        @foreach(MachineDto smartphone in _smartphones)
        {
            <MudListItem T="MachineDto" Href="@($"/machine/{smartphone.Id}")" Icon="@Icons.Material.Filled.Smartphone">
                @smartphone.Company @smartphone.Name
            </MudListItem>
        }
    </MudList>
}
else
{
    @if(_character.HasValue)
    {
        <MudAlert Severity="Severity.Info">@L["There are no smartphones found in the database that start with this letter."]</MudAlert>
    }
    else if(Year.HasValue)
    {
        <MudAlert Severity="Severity.Info">@L["There are no smartphones found introduced this year."]</MudAlert>
    }
}
