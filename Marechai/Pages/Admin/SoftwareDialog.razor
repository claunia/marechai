    /// <summary>
    ///     Localised label for a <see cref="Marechai.Data.SoftwareGenreType" /> enum value.
    ///     Mirrors <c>SoftwareSuggestionDialog.FormatGenreTypeKey</c> so the resx keys
    ///     match across the contributor and admin surfaces.
    /// </summary>
    static string FormatGenreTypeKey(Marechai.Data.SoftwareGenreType t) => t switch
    {
        Marechai.Data.SoftwareGenreType.Genre       => "Genre",
        Marechai.Data.SoftwareGenreType.Perspective => "Perspective",
        Marechai.Data.SoftwareGenreType.Gameplay    => "Gameplay",
        Marechai.Data.SoftwareGenreType.Setting     => "Setting",
        Marechai.Data.SoftwareGenreType.Category    => "Category",
        _                                           => t.ToString()
    };

    int CountActiveGenresOfType(int gtInt)
    {
        int existing = (_genreRows ?? new()).Count(g => (g.Type ?? 0) == gtInt);
        int pending  = _pendingGenreAdds.Count(p => p.Type == gtInt);
        return existing + pending;
    }

    bool HasGenreOpsOfType(int gtInt) =>
        _pendingGenreAdds.Any(p => p.Type == gtInt) ||
        (_genreRows ?? new()).Any(g => (g.Type ?? 0) == gtInt);

    /// <summary>
    ///     Type-filtered autocomplete source. Excludes ids already linked (existing rows)
    ///     and ids already queued in <c>_pendingGenreAdds</c> so the same genre cannot be
    ///     added twice. Awaits <see cref="_genresLoadTask" /> so the popover gets populated
    ///     even when the user opens it before <c>OnInitializedAsync</c>'s catalog load
    ///     completes.
    /// </summary>
    async Task<IEnumerable<SoftwareGenreDto>> SearchGenresOfType(int type, string value, CancellationToken ct)
    {
        var assigned = new HashSet<int>();
        if(_genreRows is not null)
            foreach(SoftwareGenreDto g in _genreRows)
                if(g.Id.HasValue) assigned.Add(g.Id.Value);
        foreach(PendingGenreAdd p in _pendingGenreAdds)
            assigned.Add(p.GenreId);

        List<SoftwareGenreDto> allGenres = await _genresLoadTask;

        IEnumerable<SoftwareGenreDto> r = allGenres
                                          .Where(x => x.Id.HasValue && !assigned.Contains(x.Id.Value))
                                          .Where(x => (x.Type ?? 0) == type);
        if(!string.IsNullOrWhiteSpace(value))
            r = r.Where(x => x.Name?.Contains(value, StringComparison.OrdinalIgnoreCase) ?? false);
        return r;
    }

    async Task AddGenreClick(int gtInt)
    {
        if(!_pickGenreByType.TryGetValue(gtInt, out SoftwareGenreDto picked) || picked is null || !picked.Id.HasValue)
            return;

        if(IsNew)
        {
            // Create mode: buffer in memory, parent admin page flushes after CreateAsync.
            if(_pendingGenreAdds.Any(p => p.GenreId == picked.Id.Value)) return;
            _pendingGenreAdds.Add(new PendingGenreAdd(picked.Id.Value, picked.Type ?? 0,
                                                      picked.Name ?? $"#{picked.Id}"));
            _pickGenreByType[gtInt] = null;
            _genreMessage = null;
            return;
        }

        // Edit mode: persist immediately.
        (bool ok, string err) = await SoftwareService.AddGenreLinkAsync((ulong)SoftwareId, picked.Id.Value);
        if(ok)
        {
            _genreRows              = await SoftwareService.GetGenresAsync(SoftwareId);
            _pickGenreByType[gtInt] = null;
            _genreMessage           = null;
        }
        else
        {
            _genreMessage         = err ?? L["Failed to add genre."];
            _genreMessageSeverity = Severity.Error;
        }
    }

    async Task RemoveExistingGenre(SoftwareGenreDto g)
    {
        if(!g.Id.HasValue) return;

        // Existing rows only appear in EDIT mode (create mode has _genreRows empty), so
        // this always hits the server.
        (bool ok, string err) = await SoftwareService.RemoveGenreLinkAsync((ulong)SoftwareId, g.Id.Value);
        if(ok)
        {
            _genreRows    = await SoftwareService.GetGenresAsync(SoftwareId);
            _genreMessage = null;
        }
        else
        {
            _genreMessage         = err ?? L["Failed to remove genre."];
            _genreMessageSeverity = Severity.Error;
        }
    }

    void RemovePendingGenre(int genreId)
    {
        _pendingGenreAdds.RemoveAll(p => p.GenreId == genreId);
        _genreMessage = null;
    }

