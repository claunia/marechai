@using Marechai.ApiClient.Models
@using Marechai.Services
@using System.Threading

@inject IStringLocalizer<SoftwareService> L

<MudDialog>
    <DialogContent>
        <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pa-4">
            @* Tab 1 - Basic Info *@
            <MudTabPanel Text="@L["Basic Info"]" Icon="@Icons.Material.Filled.Info">
                <MudTextField @bind-Value="Name"
                              Label="@L["Name"]"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="@L["Name is required."]"
                              Class="mb-4"/>

                <MudAutocomplete T="SoftwareFamilyDto"
                                 Label="@L["Family"]"
                                 @bind-Value="_selectedFamily"
                                 SearchFunc="SearchFamilies"
                                 ToStringFunc="@(f => f?.Name ?? string.Empty)"
                                 Variant="Variant.Outlined"
                                 Clearable="true"
                                 MinCharacters="0"
                                 Class="mb-4"/>

                <MudAutocomplete T="SoftwareDto"
                                 Label="@L["Predecessor"]"
                                 @bind-Value="_selectedPredecessor"
                                 SearchFunc="SearchPredecessors"
                                 ToStringFunc="@(s => s?.Name ?? string.Empty)"
                                 Variant="Variant.Outlined"
                                 Clearable="true"
                                 MinCharacters="0"
                                 MaxItems="50"
                                 Class="mb-4"/>

                <MudSelect T="Marechai.Data.SoftwareRelationshipType"
                           @bind-Value="RelationshipType"
                           Label="@L["Relationship to predecessor"]"
                           Variant="Variant.Outlined"
                           Disabled="@(_selectedPredecessor is null)"
                           Class="mb-4">
                    <MudSelectItem T="Marechai.Data.SoftwareRelationshipType" Value="Marechai.Data.SoftwareRelationshipType.Sequel">@L["Sequel"]</MudSelectItem>
                    <MudSelectItem T="Marechai.Data.SoftwareRelationshipType" Value="Marechai.Data.SoftwareRelationshipType.Fork">@L["Fork"]</MudSelectItem>
                    <MudSelectItem T="Marechai.Data.SoftwareRelationshipType" Value="Marechai.Data.SoftwareRelationshipType.Remake">@L["Remake"]</MudSelectItem>
                    <MudSelectItem T="Marechai.Data.SoftwareRelationshipType" Value="Marechai.Data.SoftwareRelationshipType.Remaster">@L["Remaster"]</MudSelectItem>
                    <MudSelectItem T="Marechai.Data.SoftwareRelationshipType" Value="Marechai.Data.SoftwareRelationshipType.Port">@L["Port"]</MudSelectItem>
                </MudSelect>

                <MudSelect T="Marechai.Data.SoftwareKind" @bind-Value="Kind" Label="@L["Kind"]" Variant="Variant.Outlined" Class="mb-4">
                    <MudSelectItem T="Marechai.Data.SoftwareKind" Value="Marechai.Data.SoftwareKind.Software">@L["Software"]</MudSelectItem>
                    <MudSelectItem T="Marechai.Data.SoftwareKind" Value="Marechai.Data.SoftwareKind.OperatingSystem">@L["Operating System"]</MudSelectItem>
                    <MudSelectItem T="Marechai.Data.SoftwareKind" Value="Marechai.Data.SoftwareKind.Game">@L["Game"]</MudSelectItem>
                    <MudSelectItem T="Marechai.Data.SoftwareKind" Value="Marechai.Data.SoftwareKind.Dlc">@L["DLC / Addon"]</MudSelectItem>
                    <MudSelectItem T="Marechai.Data.SoftwareKind" Value="Marechai.Data.SoftwareKind.SystemSoftware">@L["System software"]</MudSelectItem>
                    <MudSelectItem T="Marechai.Data.SoftwareKind" Value="Marechai.Data.SoftwareKind.Application">@L["Application"]</MudSelectItem>
                    <MudSelectItem T="Marechai.Data.SoftwareKind" Value="Marechai.Data.SoftwareKind.DevelopmentSoftware">@L["Development software"]</MudSelectItem>
                    <MudSelectItem T="Marechai.Data.SoftwareKind" Value="Marechai.Data.SoftwareKind.ServerSoftware">@L["Server software"]</MudSelectItem>
                    <MudSelectItem T="Marechai.Data.SoftwareKind" Value="Marechai.Data.SoftwareKind.Middleware">@L["Middleware"]</MudSelectItem>
                    <MudSelectItem T="Marechai.Data.SoftwareKind" Value="Marechai.Data.SoftwareKind.Firmware">@L["Firmware"]</MudSelectItem>
                    <MudSelectItem T="Marechai.Data.SoftwareKind" Value="Marechai.Data.SoftwareKind.EmbeddedSoftware">@L["Embedded software"]</MudSelectItem>
                </MudSelect>

                <MudAutocomplete T="SoftwareDto"
                                 Label="@L["Base Software"]"
                                 @bind-Value="_selectedBaseSoftware"
                                 SearchFunc="SearchBaseSoftware"
                                 ToStringFunc="@(s => s?.Name ?? string.Empty)"
                                 Variant="Variant.Outlined"
                                 Clearable="true"
                                 MinCharacters="0"
                                 MaxItems="50"
                                 Class="mb-4"/>

                @if(!string.IsNullOrWhiteSpace(_validationError))
                {
                    <MudAlert Severity="Severity.Error" Class="mt-2">@_validationError</MudAlert>
                }
            </MudTabPanel>

            @* Tab 2 - Genres (available in BOTH create and edit modes; create-mode adds
                are buffered in _pendingGenreAdds and flushed by the parent admin page
                after CreateAsync returns the new software id). One MudExpansionPanel per
                SoftwareGenreType — Genre / Perspective / Gameplay / Setting / Category —
                each with a type-filtered MudAutocomplete, mirroring SoftwareSuggestionDialog. *@
            <MudTabPanel Text="@L["Genres"]" Icon="@Icons.Material.Filled.Category">
                <MudExpansionPanels MultiExpansion="true">
                    @foreach(Marechai.Data.SoftwareGenreType gt in Enum.GetValues<Marechai.Data.SoftwareGenreType>())
                    {
                        int gtInt = (int)gt;
                        <MudExpansionPanel Text="@($"{L[FormatGenreTypeKey(gt)]} ({CountActiveGenresOfType(gtInt)})")"
                                           Expanded="@HasGenreOpsOfType(gtInt)">
                            @* Existing rows (edit mode only — _genreRows is empty in create mode). *@
                            @foreach(SoftwareGenreDto g in (_genreRows ?? new()).Where(g => (g.Type ?? 0) == gtInt))
                            {
                                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-1">
                                    <MudText>@(g.Name ?? $"#{g.Id}")</MudText>
                                    @if(g.Id.HasValue)
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                                       OnClick="@(() => RemoveExistingGenre(g))"/>
                                    }
                                </MudStack>
                            }

                            @* Pending adds (create mode buffer). Bold "+ name" with a Remove button. *@
                            @foreach(PendingGenreAdd p in _pendingGenreAdds.Where(p => p.Type == gtInt))
                            {
                                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-1">
                                    <MudText><strong>+ @p.Name</strong></MudText>
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Default"
                                                   OnClick="@(() => RemovePendingGenre(p.GenreId))"/>
                                </MudStack>
                            }

                            @* Picker row. *@
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-2">
                                <MudAutocomplete T="SoftwareGenreDto"
                                                 Value="@(_pickGenreByType.TryGetValue(gtInt, out var picked) ? picked : null)"
                                                 ValueChanged="@(g => { _pickGenreByType[gtInt] = g; })"
                                                 SearchFunc="@((value, ct) => SearchGenresOfType(gtInt, value, ct))"
                                                 Clearable="true"
                                                 MinCharacters="0"
                                                 MaxItems="null"
                                                 ToStringFunc="@(g => g?.Name ?? string.Empty)"
                                                 Style="flex: 1;"/>
                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                           OnClick="@(() => AddGenreClick(gtInt))"
                                           Disabled="@(!_pickGenreByType.TryGetValue(gtInt, out var pp) || pp is null)">@L["Add"]</MudButton>
                            </MudStack>
                        </MudExpansionPanel>
                    }
                </MudExpansionPanels>

                @if(!string.IsNullOrWhiteSpace(_genreMessage))
                {
                    <MudAlert Severity="@_genreMessageSeverity" Class="mt-2" ShowCloseIcon="true"
                              CloseIconClicked="() => _genreMessage = null">@_genreMessage</MudAlert>
                }
            </MudTabPanel>

            @* Tab - Alternative Titles (available in BOTH create and edit modes; create-mode
                adds are buffered in _pendingAlternativeTitleAdds and flushed by the parent
                admin page after CreateAsync returns the new software id, mirroring the
                Genres tab). Each row stores a Title plus an optional English comment that
                gets auto-translated by the background TranslationWorker. *@
            <MudTabPanel Text="@L["Alternative Titles"]" Icon="@Icons.Material.Filled.Translate">
                @* Existing rows (edit mode only — _alternativeTitleRows is empty in create mode). *@
                @foreach(SoftwareAlternativeTitleDto t in _alternativeTitleRows ?? new())
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-1">
                        <MudText>
                            @t.Title
                            @if(!string.IsNullOrWhiteSpace(t.Comment))
                            {
                                <MudText Typo="Typo.caption" Class="ml-2">(@t.Comment)</MudText>
                            }
                        </MudText>
                        @if(t.Id.HasValue)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                           OnClick="@(() => RemoveExistingAlternativeTitle(t))"/>
                        }
                    </MudStack>
                }

                @* Pending adds (create mode buffer). Bold "+ Title (Comment)" with a Remove button. *@
                @foreach(PendingAlternativeTitleAdd p in _pendingAlternativeTitleAdds)
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-1">
                        <MudText>
                            <strong>+ @p.Title</strong>
                            @if(!string.IsNullOrWhiteSpace(p.Comment))
                            {
                                <MudText Typo="Typo.caption" Class="ml-2">(@p.Comment)</MudText>
                            }
                        </MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Default"
                                       OnClick="@(() => RemovePendingAlternativeTitle(p))"/>
                    </MudStack>
                }

                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-2">
                    <MudTextField @bind-Value="_newAlternativeTitle"
                                  Label="@L["Title"]"
                                  Variant="Variant.Outlined"
                                  Style="flex: 1;"/>
                    <MudTextField @bind-Value="_newAlternativeTitleComment"
                                  Label="@L["Comment"]"
                                  Variant="Variant.Outlined"
                                  Style="flex: 1;"/>
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                               OnClick="AddAlternativeTitleClick"
                               Disabled="@string.IsNullOrWhiteSpace(_newAlternativeTitle)">@L["Add"]</MudButton>
                </MudStack>

                @if(!string.IsNullOrWhiteSpace(_alternativeTitleMessage))
                {
                    <MudAlert Severity="@_alternativeTitleMessageSeverity" Class="mt-2" ShowCloseIcon="true"
                              CloseIconClicked="() => _alternativeTitleMessage = null">@_alternativeTitleMessage</MudAlert>
                }
            </MudTabPanel>

            @* Tab - External IDs (edit mode only — the Software row must already exist
                before an external id can be registered against it). *@
            @if(!IsNew)
            {
                <MudTabPanel Text="@L["External IDs"]" Icon="@Icons.Material.Filled.Link">
                    @foreach(SoftwareExternalIdDto e in _externalIdRows ?? new())
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-1">
                            <MudText>@e.ExternalSiteName: @e.ExternalId</MudText>
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                           OnClick="@(() => RemoveExternalId(e))"/>
                        </MudStack>
                    }

                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-2">
                        <MudSelect T="ExternalSiteDto" @bind-Value="_selectedExternalSite" Label="@L["Site"]"
                                   Variant="Variant.Outlined" Style="flex: 1;" ToStringFunc="@(s => s?.Name)">
                            @foreach(ExternalSiteDto s in _allExternalSites ?? new())
                            {
                                <MudSelectItem T="ExternalSiteDto" Value="@s">@s.Name</MudSelectItem>
                            }
                        </MudSelect>
                        <MudTextField @bind-Value="_newExternalId"
                                      Label="@L["ID"]"
                                      Variant="Variant.Outlined"
                                      Style="flex: 1;"/>
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                   OnClick="AddExternalIdClick"
                                   Disabled="@(_selectedExternalSite is null || string.IsNullOrWhiteSpace(_newExternalId))">@L["Add"]</MudButton>
                    </MudStack>

                    @if(!string.IsNullOrWhiteSpace(_externalIdMessage))
                    {
                        <MudAlert Severity="@_externalIdMessageSeverity" Class="mt-2" ShowCloseIcon="true"
                                  CloseIconClicked="() => _externalIdMessage = null">@_externalIdMessage</MudAlert>
                    }
                </MudTabPanel>
            }

            @* Tab 3 - Company Roles (available in BOTH create and edit modes; create-mode
                adds are buffered in _pendingCompanyAdds and flushed by the parent admin
                page after CreateAsync returns the new software id, mirroring the Genres tab). *@
            <MudTabPanel Text="@L["Companies"]" Icon="@Icons.Material.Filled.Business">
                @if(_companyRoles is { Count: > 0 })
                {
                    <MudList T="SoftwareCompanyRoleDto" Dense="true">
                        @foreach(SoftwareCompanyRoleDto role in _companyRoles)
                        {
                            <MudListItem T="SoftwareCompanyRoleDto">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                    <MudText>@($"{role.Company} ({role.Role})")</MudText>
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Size="Size.Small"
                                                   Color="Color.Error"
                                                   OnClick="() => RemoveCompanyRole(role)"/>
                                </MudStack>
                            </MudListItem>
                        }
                    </MudList>
                }

                @* Pending adds (create mode buffer). Bold "+ Name (Role)" with a Remove button. *@
                @foreach(PendingCompanyAdd p in _pendingCompanyAdds)
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-1">
                        <MudText><strong>+ @($"{p.CompanyName} ({p.RoleName})")</strong></MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Default"
                                       OnClick="@(() => RemovePendingCompanyRole(p.CompanyId, p.RoleId))"/>
                    </MudStack>
                }

                <MudPaper Class="pa-4 mt-2" Elevation="1">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudAutocomplete T="CompanyDto"
                                         Label="@L["Search Company"]"
                                         @bind-Value="_selectedCompany"
                                         SearchFunc="SearchCompanies"
                                         ToStringFunc="@(c => c?.Name ?? string.Empty)"
                                         Variant="Variant.Outlined"
                                         Clearable="true"
                                         MinCharacters="0"
                                         MaxItems="50"
                                         Style="flex: 1;"/>
                        <MudSelect T="SoftwareRoleDto"
                                   @bind-Value="_selectedRole"
                                   Label="@L["Role"]"
                                   ToStringFunc="@(r => r?.Name ?? string.Empty)"
                                   Variant="Variant.Outlined"
                                   Style="max-width: 200px;">
                            @if(_allRoles is not null)
                            {
                                @foreach(SoftwareRoleDto role in _allRoles)
                                {
                                    <MudSelectItem T="SoftwareRoleDto" Value="role">@role.Name</MudSelectItem>
                                }
                            }
                        </MudSelect>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   OnClick="AddCompanyRole"
                                   Disabled="@(_selectedCompany is null || _selectedRole is null)">
                            @L["Add"]
                        </MudButton>
                    </MudStack>
                </MudPaper>

                @if(!string.IsNullOrWhiteSpace(_companyRoleMessage))
                {
                    <MudAlert Severity="@_companyRoleMessageSeverity" Class="mt-2" ShowCloseIcon="true"
                              CloseIconClicked="() => _companyRoleMessage = null">@_companyRoleMessage</MudAlert>
                }
            </MudTabPanel>
        </MudTabs>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">@L["Save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    string                        _validationError;
    SoftwareFamilyDto             _selectedFamily;
    // Pre-load tasks for the catalog lookups behind the autocompletes. Held as
    // Task<List<…>> rather than the materialised lists so SearchFunc handlers
    // can `await` the in-flight load — without this the popover that opens on
    // first focus fires before OnInitializedAsync's await finishes and the
    // dropdown ends up empty until the user types (Issue: "all mudautocomplete
    // are empty until you start searching"). The MudAutocomplete popover
    // re-renders once the awaited task resolves, so the user sees the full
    // list as soon as the network round-trip lands.
    Task<List<SoftwareFamilyDto>> _familiesLoadTask = Task.FromResult(new List<SoftwareFamilyDto>());
    Task<List<SoftwareGenreDto>>  _genresLoadTask   = Task.FromResult(new List<SoftwareGenreDto>());
    Task<List<CompanyDto>>        _companiesLoadTask = Task.FromResult(new List<CompanyDto>());
    SoftwareDto                   _selectedPredecessor;
    SoftwareDto                   _selectedBaseSoftware;
    CompanyDto                    _selectedCompany;
    SoftwareRoleDto               _selectedRole;
    List<SoftwareRoleDto>         _allRoles;
    List<SoftwareCompanyRoleDto>  _companyRoles;
    string                        _companyRoleMessage;
    Severity                       _companyRoleMessageSeverity;

    // Pending company-role pairs queued during CREATE-mode editing. Empty in EDIT mode
    // (the dialog persists Add/Remove immediately). Flushed by the parent admin page
    // via SoftwareService.AddCompanyRoleAsync after CreateAsync returns the new id,
    // mirroring the _pendingGenreAdds pattern below. SoftwareCompanyRole has a
    // 3-column composite primary key (SoftwareId + CompanyId + RoleId), so the same
    // company under a different role is a distinct pair.
    List<PendingCompanyAdd>       _pendingCompanyAdds = new();

    /// <summary>
    ///     In-memory create-mode buffer for a company/role pick that can't be POSTed yet
    ///     because the parent Software row doesn't exist. Display fields are captured up
    ///     front so the pending-row render doesn't need to re-resolve names.
    /// </summary>
    sealed record PendingCompanyAdd(int CompanyId, string RoleId, string CompanyName, string RoleName);

    // ── Genres tab state ──
    List<SoftwareGenreDto>            _genreRows;          // existing rows (edit mode); empty in create.
    Dictionary<int, SoftwareGenreDto> _pickGenreByType = new();
    List<PendingGenreAdd>             _pendingGenreAdds = new();
    string                            _genreMessage;
    Severity                          _genreMessageSeverity;

    /// <summary>
    ///     In-memory create-mode buffer: a genre the user picked but which can't be POSTed
    ///     yet because the parent Software row doesn't exist. Flushed by the parent admin
    ///     page after CreateAsync returns the new id.
    /// </summary>
    sealed record PendingGenreAdd(int GenreId, int Type, string Name);

    // ── Alternative Titles tab state ──
    List<SoftwareAlternativeTitleDto> _alternativeTitleRows; // existing rows (edit mode); empty in create.
    List<PendingAlternativeTitleAdd>  _pendingAlternativeTitleAdds = new();
    string                            _newAlternativeTitle;
    string                            _newAlternativeTitleComment;
    string                            _alternativeTitleMessage;
    Severity                          _alternativeTitleMessageSeverity;

    /// <summary>
    ///     In-memory create-mode buffer for an alternative title that can't be POSTed yet
    ///     because the parent Software row doesn't exist. Flushed by the parent admin page
    ///     after CreateAsync returns the new id, mirroring the _pendingGenreAdds pattern.
    /// </summary>
    sealed record PendingAlternativeTitleAdd(string Title, string Comment);

    // ── External IDs tab state (edit mode only) ──
    List<SoftwareExternalIdDto> _externalIdRows;
    List<ExternalSiteDto>       _allExternalSites;
    ExternalSiteDto              _selectedExternalSite;
    string                       _newExternalId;
    string                       _externalIdMessage;
    Severity                     _externalIdMessageSeverity;

    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public bool IsNew { get; set; }
    [Parameter] public int SoftwareId { get; set; }
    [Parameter] public string Name { get; set; } = string.Empty;
    [Parameter] public int? FamilyId { get; set; }
    [Parameter] public int? PredecessorId { get; set; }
    [Parameter] public string PredecessorName { get; set; }
    [Parameter] public Marechai.Data.SoftwareRelationshipType RelationshipType { get; set; }
    [Parameter] public int? BaseSoftwareId { get; set; }
    [Parameter] public string BaseSoftwareName { get; set; }
    [Parameter] public Marechai.Data.SoftwareKind Kind { get; set; }

    [Inject] SoftwareService SoftwareService { get; set; } = null!;
    [Inject] ExternalSitesService ExternalSitesService { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        // Kick off all catalog loads as memoised Task fields; SearchFunc handlers below
        // `await` these tasks instead of touching materialised lists, eliminating the
        // race where the popover opens before the loads complete and shows an empty
        // list.
        _familiesLoadTask = SoftwareService.GetAllFamiliesAsync();
        // `includeUnused: true` so the admin picker also shows freshly-seeded genres
        // that have zero linked software yet (e.g. the `SoftwareGenreType.Category`
        // rows from AddSoftwareGenreCategoriesSeed). The public landing-page callers
        // keep the default (false) and continue to see only used genres.
        _genresLoadTask = SoftwareService.GetAllGenresAsync(includeUnused: true);

        List<SoftwareFamilyDto> families = await _familiesLoadTask;

        if(FamilyId is not null && families is not null) _selectedFamily = families.Find(f => f.Id == FamilyId);

        if(PredecessorId is not null)
        {
            _selectedPredecessor = new SoftwareDto
            {
                Id   = PredecessorId,
                Name = PredecessorName ?? string.Empty
            };
        }

        if(BaseSoftwareId is not null)
        {
            _selectedBaseSoftware = new SoftwareDto
            {
                Id   = BaseSoftwareId,
                Name = BaseSoftwareName ?? string.Empty
            };
        }

        // Catalog loads for the Companies tab run in BOTH modes — create mode still needs
        // the picker dropdowns populated so the user can queue pending pairs. Existing
        // junction rows (_companyRoles) only exist in edit mode.
        _companiesLoadTask = SoftwareService.GetAllCompaniesAsync();
        _allRoles          = await SoftwareService.GetSoftwareRolesAsync();
        if(!IsNew) _companyRoles = await SoftwareService.GetCompanyRolesAsync(SoftwareId);

        // _genreRows is the edit-mode "currently linked" set; create-mode starts empty
        // and is buffered via _pendingGenreAdds. _genresLoadTask covers the catalog
        // dropdown for both modes.
        _genreRows = IsNew
                         ? new List<SoftwareGenreDto>()
                         : await SoftwareService.GetGenresAsync(SoftwareId);

        // _alternativeTitleRows is the edit-mode "currently stored" set; create-mode starts
        // empty and is buffered via _pendingAlternativeTitleAdds.
        _alternativeTitleRows = IsNew
                                     ? new List<SoftwareAlternativeTitleDto>()
                                     : await SoftwareService.GetAlternativeTitlesAsync(SoftwareId);

        if(!IsNew)
        {
            _allExternalSites = await ExternalSitesService.GetAllAsync();
            _externalIdRows   = await SoftwareService.GetExternalIdsAsync(SoftwareId);
        }
    }

    async Task<IEnumerable<SoftwareFamilyDto>> SearchFamilies(string value, CancellationToken ct)
    {
        List<SoftwareFamilyDto> all = await _familiesLoadTask;

        if(string.IsNullOrWhiteSpace(value)) return all;

        return all.Where(f => f.Name?.Contains(value, StringComparison.OrdinalIgnoreCase) ?? false);
    }

    async Task<IEnumerable<SoftwareDto>> SearchPredecessors(string value, CancellationToken ct)
    {
        // Server-side picker variant returns up to 50 rows alphabetically when `value`
        // is empty, so the dropdown shows a browseable initial list on first focus
        // instead of an empty popover.
        List<SoftwareDto> results = await SoftwareService.SearchSoftwareForPickerAsync(value, 50, ct);

        // Exclude current software from results to prevent self-reference.
        if(!IsNew && SoftwareId > 0) results = results.Where(s => s.Id != SoftwareId).ToList();

        return RankByRelevance(value, results, s => s.Name);
    }

    async Task<IEnumerable<SoftwareDto>> SearchBaseSoftware(string value, CancellationToken ct)
    {
        // See SearchPredecessors for the picker-vs-search rationale.
        List<SoftwareDto> results = await SoftwareService.SearchSoftwareForPickerAsync(value, 50, ct);

        // Exclude current software from results to prevent self-reference.
        if(!IsNew && SoftwareId > 0) results = results.Where(s => s.Id != SoftwareId).ToList();

        return RankByRelevance(value, results, s => s.Name);
    }

    async Task<IEnumerable<CompanyDto>> SearchCompanies(string value, CancellationToken ct)
    {
        List<CompanyDto> all = await _companiesLoadTask;

        if(string.IsNullOrWhiteSpace(value)) return all;

        string query = value.Trim();

        return RankByRelevance(query, all.Where(c => c.Name?.Contains(query, StringComparison.OrdinalIgnoreCase) ?? false), c => c.Name);
    }

    static IEnumerable<T> RankByRelevance<T>(string query, IEnumerable<T> candidates, Func<T, string> nameSelector)
    {
        if(string.IsNullOrWhiteSpace(query)) return candidates;

        string trimmed = query.Trim();

        return candidates.Select(c => (Item: c, Name: nameSelector(c), Score: ScoreNameMatch(trimmed, nameSelector(c))))
                         .OrderByDescending(x => x.Score)
                         .ThenBy(x => x.Name?.Length ?? int.MaxValue)
                         .ThenBy(x => x.Name, StringComparer.OrdinalIgnoreCase)
                         .Select(x => x.Item);
    }

    static double ScoreNameMatch(string query, string candidate)
    {
        if(string.IsNullOrEmpty(candidate)) return 0d;

        double score = 0d;

        if(string.Equals(candidate, query, StringComparison.OrdinalIgnoreCase)) score += 2.0d;
        else if(candidate.StartsWith(query, StringComparison.OrdinalIgnoreCase)) score += 1.0d;
        else if(candidate.Contains(query, StringComparison.OrdinalIgnoreCase)) score += 0.5d;

        // Jaro-Winkler against the whole candidate AND each token; take the best.
        double bestJw = JaroWinkler.Similarity(query, candidate);

        foreach(string token in candidate.Split([' ', '-', '/', '.', ','], StringSplitOptions.RemoveEmptyEntries))
        {
            double jw = JaroWinkler.Similarity(query, token);
            if(jw > bestJw) bestJw = jw;
        }

        score += bestJw;

        // Length-ratio bias: candidates closer in length to the query rank higher.
        double ratio = (double)query.Length / Math.Max(candidate.Length, 1);
        if(ratio < 0.1d) ratio = 0.1d;
        score *= 0.5d + 0.5d * ratio;

        return score;
    }

    async Task AddCompanyRole()
    {
        if(_selectedCompany is null || _selectedRole is null) return;
        if(!_selectedCompany.Id.HasValue || string.IsNullOrEmpty(_selectedRole.Id)) return;

        int    companyId   = _selectedCompany.Id.Value;
        string roleId      = _selectedRole.Id;
        string companyName = _selectedCompany.Name ?? $"#{companyId}";
        string roleName    = _selectedRole.Name    ?? roleId;

        if(IsNew)
        {
            // Create mode: buffer in memory. Composite-key dedup against pending pairs
            // \u2014 same company under a different role is allowed (matches the underlying
            // SoftwareCompanyRole 3-column PK and the SoftwareCompaniesSuggestionDialog
            // convention). Silently no-op on duplicate, matching the AddGenreClick pattern.
            if(_pendingCompanyAdds.Any(p => p.CompanyId == companyId &&
                                            string.Equals(p.RoleId, roleId, StringComparison.Ordinal)))
                return;

            _pendingCompanyAdds.Add(new PendingCompanyAdd(companyId, roleId, companyName, roleName));
            _selectedCompany    = null;
            _selectedRole       = null;
            _companyRoleMessage = null;
            return;
        }

        // Edit mode: persist immediately.
        var dto = new SoftwareCompanyRoleDto
        {
            SoftwareId = SoftwareId,
            CompanyId  = companyId,
            RoleId     = roleId
        };

        (bool succeeded, string error) = await SoftwareService.AddCompanyRoleAsync(dto);

        if(succeeded)
        {
            _companyRoles           = await SoftwareService.GetCompanyRolesAsync(SoftwareId);
            _selectedCompany        = null;
            _selectedRole           = null;
            _companyRoleMessage     = null;
        }
        else
        {
            _companyRoleMessage         = error;
            _companyRoleMessageSeverity = Severity.Error;
        }
    }

    void RemovePendingCompanyRole(int companyId, string roleId)
    {
        _pendingCompanyAdds.RemoveAll(p => p.CompanyId == companyId &&
                                           string.Equals(p.RoleId, roleId, StringComparison.Ordinal));
        _companyRoleMessage = null;
    }

    async Task RemoveCompanyRole(SoftwareCompanyRoleDto role)
    {
        (bool succeeded, string error) = await SoftwareService.RemoveCompanyRoleAsync(
            role.SoftwareId ?? 0,
            role.CompanyId  ?? 0,
            role.RoleId     ?? string.Empty);

        if(succeeded)
        {
            _companyRoles       = await SoftwareService.GetCompanyRolesAsync(SoftwareId);
            _companyRoleMessage = null;
        }
        else
        {
            _companyRoleMessage         = error;
            _companyRoleMessageSeverity = Severity.Error;
        }
    }

