    void Submit()
    {
        if(string.IsNullOrWhiteSpace(Name))
        {
            _validationError = L["Name is required."];
            return;
        }

        MudDialog.Close(DialogResult.Ok(new SoftwareDialogResult
        {
            Name              = Name,
            FamilyId          = _selectedFamily?.Id,
            PredecessorId     = _selectedPredecessor?.Id,
            RelationshipType  = RelationshipType,
            BaseSoftwareId    = _selectedBaseSoftware?.Id,
            Kind              = Kind,
            PendingGenreIds   = _pendingGenreAdds.Select(p => p.GenreId).ToList(),
            PendingCompanyRoles = _pendingCompanyAdds
                                  .Select(p => new PendingCompanyRole(p.CompanyId, p.RoleId))
                                  .ToList(),
            PendingAlternativeTitles = _pendingAlternativeTitleAdds
                                        .Select(p => new PendingAlternativeTitle(p.Title, p.Comment))
                                        .ToList()
        }));
    }
