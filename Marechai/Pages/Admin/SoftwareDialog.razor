    async Task AddAlternativeTitleClick()
    {
        if(string.IsNullOrWhiteSpace(_newAlternativeTitle)) return;

        string title   = _newAlternativeTitle.Trim();
        string comment = string.IsNullOrWhiteSpace(_newAlternativeTitleComment)
                             ? null
                             : _newAlternativeTitleComment.Trim();

        if(IsNew)
        {
            // Create mode: buffer in memory, parent admin page flushes after CreateAsync.
            _pendingAlternativeTitleAdds.Add(new PendingAlternativeTitleAdd(title, comment));
            _newAlternativeTitle        = null;
            _newAlternativeTitleComment = null;
            _alternativeTitleMessage    = null;
            return;
        }

        // Edit mode: persist immediately.
        (bool ok, SoftwareAlternativeTitleDto _, string err) =
            await SoftwareService.AddAlternativeTitleAsync((ulong)SoftwareId, title, comment);

        if(ok)
        {
            _alternativeTitleRows       = await SoftwareService.GetAlternativeTitlesAsync(SoftwareId);
            _newAlternativeTitle        = null;
            _newAlternativeTitleComment = null;
            _alternativeTitleMessage    = null;
        }
        else
        {
            _alternativeTitleMessage         = err ?? L["Failed to add alternative title."];
            _alternativeTitleMessageSeverity = Severity.Error;
        }
    }

    async Task RemoveExistingAlternativeTitle(SoftwareAlternativeTitleDto t)
    {
        if(!t.Id.HasValue) return;

        // Existing rows only appear in EDIT mode (create mode has _alternativeTitleRows
        // empty), so this always hits the server.
        (bool ok, string err) = await SoftwareService.RemoveAlternativeTitleAsync(t.Id.Value);

        if(ok)
        {
            _alternativeTitleRows    = await SoftwareService.GetAlternativeTitlesAsync(SoftwareId);
            _alternativeTitleMessage = null;
        }
        else
        {
            _alternativeTitleMessage         = err ?? L["Failed to remove alternative title."];
            _alternativeTitleMessageSeverity = Severity.Error;
        }
    }

    void RemovePendingAlternativeTitle(PendingAlternativeTitleAdd p)
    {
        _pendingAlternativeTitleAdds.Remove(p);
        _alternativeTitleMessage = null;
    }

    async Task AddExternalIdClick()
    {
        if(_selectedExternalSite?.Id is null || string.IsNullOrWhiteSpace(_newExternalId)) return;

        (bool ok, SoftwareExternalIdDto _, string err) =
