@using Marechai.ApiClient.Models
@using Marechai.Services
@using Marechai.Helpers
@inject SoftwareReleasesService SoftwareReleasesService
@inject SoftwareVersionsService SoftwareVersionsService
@inject SoftwareService SoftwareService
@inject SoftwarePlatformsService SoftwarePlatformsService
@inject IStringLocalizer<SoftwareReleasesService> L
@inject IJSRuntime JsRuntime

<MudDialog>
    <DialogContent>
        @if(!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="() => _errorMessage = null">@_errorMessage</MudAlert>
        }

        @switch(_state)
        {
            case BulkCreateState.Upload:
                <MudStack Spacing="4">
                    <MudText Typo="Typo.body1">@L["Download a CSV prefilled with this software's known versions, edit it offline, and upload it to bulk-create releases."]</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Info">@L["Bulk creation will atomically create one release per row. Any sub-step failure rolls back the release."]</MudText>

                    <MudStack Row="true" Spacing="2">
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Download"
                                   OnClick="DownloadTemplate">
                            @L["Download Template"]
                        </MudButton>
                    </MudStack>

                    <MudFileUpload T="IBrowserFile"
                                   Accept=".csv"
                                   FilesChanged="OnCsvFileSelected"
                                   MaximumFileCount="1">
                        <CustomContent>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Upload"
                                       Disabled="_isProcessing"
                                       OnClick="@context.OpenFilePickerAsync">
                                @(_isProcessing ? L["Processing..."] : L["Upload CSV"])
                            </MudButton>
                        </CustomContent>
                    </MudFileUpload>

                    @if(_isProcessing)
                    {
                        <MudProgressLinear Indeterminate="true" Color="Color.Primary"/>
                    }
                </MudStack>
                break;

            case BulkCreateState.Preview:
                <MudStack Spacing="3">
                    <MudAlert Severity="Severity.Info" Dense="true">
                        @string.Format(L["{0} rows parsed. {1} auto-rejected (publisher missing/unmatched, version missing/mismatched, or unmatched region/language). Selected rows will be REJECTED — unselected rows will be imported."],
                            _importRows.Count,
                            _selectedItems.Count)
                    </MudAlert>

                    <MudDataGrid T="SoftwareReleaseBulkCreateRow"
                                 Items="_importRows"
                                 MultiSelection="true"
                                 @bind-SelectedItems="_selectedItems"
                                 Dense="true"
                                 Hover="true"
                                 Striped="true"
                                 FixedHeader="true"
                                 Height="400px">
                        <Columns>
                            <SelectColumn T="SoftwareReleaseBulkCreateRow"/>
                            <TemplateColumn Title="@L["Title"]">
                                <CellTemplate>
                                    @(context.Item.Title ?? "")
                                    @if(context.Item.ValidationError is not null)
                                    {
                                        <MudTooltip Text="@context.Item.ValidationError"><MudIcon Icon="@Icons.Material.Filled.Error" Size="Size.Small" Color="Color.Error" Class="ml-1"/></MudTooltip>
                                    }
                                </CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="@L["Version"]">
                                <CellTemplate>
                                    @{
                                        string verBgColor = context.Item.VersionMatch switch
                                        {
                                            VersionMatchType.Exact => "#c8e6c9",
                                            _                      => "#ffcdd2"
                                        };
                                    }
                                    <div style="@($"background-color: {verBgColor}; color: black; padding: 4px 8px; border-radius: 4px;")">
                                        @if(string.IsNullOrWhiteSpace(context.Item.VersionInput))
                                        {
                                            <em>@L["(empty)"]</em>
                                        }
                                        else
                                        {
                                            @context.Item.VersionDisplay
                                        }
                                    </div>
                                </CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="@L["Platform"]">
                                <CellTemplate>
                                    @if(string.IsNullOrWhiteSpace(context.Item.PlatformInput))
                                    {
                                        @:&nbsp;
                                    }
                                    else
                                    {
                                        string platBgColor = context.Item.PlatformMatch switch
                                        {
                                            PlatformMatchType.Exact   => "#c8e6c9",
                                            PlatformMatchType.Partial => "#fff9c4",
                                            PlatformMatchType.New     => "#bbdefb",
                                            _                         => ""
                                        };

                                        <div style="@(string.IsNullOrEmpty(platBgColor) ? "" : $"background-color: {platBgColor}; color: black; padding: 4px 8px; border-radius: 4px;")">
                                            @if(context.Item.PlatformMatch == PlatformMatchType.Partial && context.Item.MatchedPlatforms.Count > 1)
                                            {
                                                <MudSelect T="SoftwarePlatformDto"
                                                           Value="context.Item.SelectedPlatform"
                                                           ValueChanged="(p) => OnPlatformSelected(context.Item, p)"
                                                           Dense="true"
                                                           Margin="Margin.Dense"
                                                           Variant="Variant.Text"
                                                           ToStringFunc="@(p => p?.Name ?? "")">
                                                    @foreach(SoftwarePlatformDto plat in context.Item.MatchedPlatforms)
                                                    {
                                                        <MudSelectItem T="SoftwarePlatformDto" Value="plat">@plat.Name</MudSelectItem>
                                                    }
                                                </MudSelect>
                                            }
                                            else if(context.Item.PlatformMatch == PlatformMatchType.New)
                                            {
                                                @(context.Item.PlatformInput)
                                                <span>*</span>
                                            }
                                            else
                                            {
                                                @context.Item.PlatformDisplay
                                            }
                                        </div>
                                    }
                                </CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="@L["Region"]">
                                <CellTemplate>
                                    @if(string.IsNullOrWhiteSpace(context.Item.RegionInput))
                                    {
                                        @:&nbsp;
                                    }
                                    else
                                    {
                                        string regBgColor = context.Item.RegionMatch switch
                                        {
                                            CompanyMatchType.Exact   => "#c8e6c9",
                                            CompanyMatchType.Partial => "#fff9c4",
                                            _                        => "#ffcdd2"
                                        };

                                        <div style="@($"background-color: {regBgColor}; color: black; padding: 4px 8px; border-radius: 4px;")">
                                            @if(context.Item.RegionMatch == CompanyMatchType.Partial && context.Item.MatchedRegions.Count > 1)
                                            {
                                                <MudSelect T="UnM49Dto"
                                                           Value="context.Item.SelectedRegion"
                                                           ValueChanged="(r) => OnRegionSelected(context.Item, r)"
                                                           Dense="true"
                                                           Margin="Margin.Dense"
                                                           Variant="Variant.Text"
                                                           ToStringFunc="@(r => r?.Name ?? "")">
                                                    @foreach(UnM49Dto reg in context.Item.MatchedRegions)
                                                    {
                                                        <MudSelectItem T="UnM49Dto" Value="reg">@reg.Name</MudSelectItem>
                                                    }
                                                </MudSelect>
                                            }
                                            else
                                            {
                                                @context.Item.RegionDisplay
                                            }
                                        </div>
                                    }
                                </CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="@L["Language"]">
                                <CellTemplate>
                                    @if(string.IsNullOrWhiteSpace(context.Item.LanguageInput))
                                    {
                                        @:&nbsp;
                                    }
                                    else
                                    {
                                        string langBgColor = context.Item.LanguageMatch switch
                                        {
                                            CompanyMatchType.Exact   => "#c8e6c9",
                                            CompanyMatchType.Partial => "#fff9c4",
                                            _                        => "#ffcdd2"
                                        };

                                        <div style="@($"background-color: {langBgColor}; color: black; padding: 4px 8px; border-radius: 4px;")">
                                            @if(context.Item.LanguageMatch == CompanyMatchType.Partial && context.Item.MatchedLanguages.Count > 1)
                                            {
                                                <MudSelect T="Iso639Dto"
                                                           Value="context.Item.SelectedLanguage"
                                                           ValueChanged="(l) => OnLanguageSelected(context.Item, l)"
                                                           Dense="true"
                                                           Margin="Margin.Dense"
                                                           Variant="Variant.Text"
                                                           ToStringFunc="@(l => l?.ReferenceName ?? "")">
                                                    @foreach(Iso639Dto lang in context.Item.MatchedLanguages)
                                                    {
                                                        <MudSelectItem T="Iso639Dto" Value="lang">@lang.ReferenceName</MudSelectItem>
                                                    }
                                                </MudSelect>
                                            }
                                            else
                                            {
                                                @context.Item.LanguageDisplay
                                            }
                                        </div>
                                    }
                                </CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="@L["Publisher"]">
                                <CellTemplate>
                                    @{
                                        string pubBgColor = context.Item.PublisherMatch switch
                                        {
                                            CompanyMatchType.Exact   => "#c8e6c9",
                                            CompanyMatchType.Partial => "#fff9c4",
                                            _                        => "#ffcdd2"
                                        };
                                    }
                                    <div style="@($"background-color: {pubBgColor}; color: black; padding: 4px 8px; border-radius: 4px;")">
                                        @if(context.Item.PublisherMatch == CompanyMatchType.Partial && context.Item.MatchedPublishers.Count > 1)
                                        {
                                            <MudSelect T="CompanyDto"
                                                       Value="context.Item.SelectedPublisher"
                                                       ValueChanged="(c) => OnPublisherSelected(context.Item, c)"
                                                       Dense="true"
                                                       Margin="Margin.Dense"
                                                       Variant="Variant.Text"
                                                       ToStringFunc="@(c => c?.Name ?? "")">
                                                @foreach(CompanyDto company in context.Item.MatchedPublishers)
                                                {
                                                    <MudSelectItem T="CompanyDto" Value="company">@company.Name</MudSelectItem>
                                                }
                                            </MudSelect>
                                        }
                                        else if(string.IsNullOrWhiteSpace(context.Item.PublisherInput))
                                        {
                                            <em>@L["(empty)"]</em>
                                        }
                                        else
                                        {
                                            @context.Item.PublisherDisplay
                                        }
                                    </div>
                                </CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="@L["Release date"]">
                                <CellTemplate>
                                    @if(context.Item.ReleaseYear is not null)
                                    {
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                            <MudText Typo="Typo.body2">@FormatImportDate(context.Item.ReleaseYear, context.Item.ReleaseMonth, context.Item.ReleaseDay)</MudText>
                                            <MudChip T="string" Size="Size.Small"
                                                     Color="@(context.Item.ReleaseDatePrecision == 0 ? Color.Success : context.Item.ReleaseDatePrecision == 1 ? Color.Warning : Color.Info)"
                                                     Style="white-space: normal; height: auto; overflow: visible; text-overflow: unset; padding: 2px 8px; font-size: 0.7rem;">
                                                @(context.Item.ReleaseDatePrecision switch
                                                {
                                                    0 => L["Full date"],
                                                    1 => L["Month and year only"],
                                                    2 => L["Year only"],
                                                    _ => ""
                                                })
                                            </MudChip>
                                        </MudStack>
                                    }
                                    else
                                    {
                                        <MudTooltip Text="@L["No release date provided. Release will be created with NULL date."]">
                                            <div style="background-color: #fff9c4; color: black; padding: 4px 8px; border-radius: 4px;">
                                                <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small" Color="Color.Warning" Class="mr-1"/>
                                                <em>@L["(no date)"]</em>
                                            </div>
                                        </MudTooltip>
                                    }
                                </CellTemplate>
                            </TemplateColumn>
                        </Columns>
                    </MudDataGrid>

                    @if(_importRows.Any(r => r.PlatformMatch == PlatformMatchType.New && !string.IsNullOrWhiteSpace(r.PlatformInput)))
                    {
                        <MudText Typo="Typo.caption" Color="Color.Info">
                            @L["* A new platform will be created with this name during import."]
                        </MudText>
                    }
                </MudStack>
                break;

            case BulkCreateState.Importing:
                <MudStack Spacing="3">
                    <MudText Typo="Typo.body1">@string.Format(L["Importing {0} of {1}..."], _importedCount + _failedCount, _totalToImport)</MudText>
                    <MudProgressLinear Value="_progressPercent" Color="Color.Primary" Rounded="true" Size="Size.Large">
                        <ChildContent>
                            <MudText Typo="Typo.body2" Style="color: white;">
                                @($"{_progressPercent:F0}%")
                            </MudText>
                        </ChildContent>
                    </MudProgressLinear>

                    @if(_importRows.Count > 0)
                    {
                        <MudDataGrid T="SoftwareReleaseBulkCreateRow"
                                     Items="_importRows"
                                     Dense="true"
                                     Hover="true"
                                     FixedHeader="true"
                                     Height="300px">
                            <Columns>
                                <TemplateColumn Title="@L["Title"]">
                                    <CellTemplate>
                                        @(context.Item.Title ?? "")
                                        @if(context.Item.ImportError is not null)
                                        {
                                            <MudTooltip Text="@context.Item.ImportError"><MudIcon Icon="@Icons.Material.Filled.Error" Size="Size.Small" Color="Color.Error" Class="ml-1"/></MudTooltip>
                                        }
                                    </CellTemplate>
                                </TemplateColumn>
                                <TemplateColumn Title="@L["Version"]">
                                    <CellTemplate>
                                        @context.Item.VersionDisplay
                                    </CellTemplate>
                                </TemplateColumn>
                                <TemplateColumn Title="@L["Publisher"]">
                                    <CellTemplate>
                                        @context.Item.PublisherDisplay
                                    </CellTemplate>
                                </TemplateColumn>
                            </Columns>
                        </MudDataGrid>
                    }
                </MudStack>
                break;

            case BulkCreateState.Complete:
                <MudStack Spacing="3">
                    <MudAlert Severity="Severity.Success" Dense="true">
                        @string.Format(L["Bulk creation complete. {0} imported, {1} rejected, {2} failed."], _importedCount, _rejectedCount, _failedCount)
                    </MudAlert>

                    @if(_importRows.Count > 0)
                    {
                        <MudText Typo="Typo.body2">@L["The following items were not imported:"]</MudText>

                        <MudDataGrid T="SoftwareReleaseBulkCreateRow"
                                     Items="_importRows"
                                     Dense="true"
                                     Hover="true"
                                     FixedHeader="true"
                                     Height="300px">
                            <Columns>
                                <PropertyColumn Property="x => x.Title" Title="@L["Title"]"/>
                                <TemplateColumn Title="@L["Version"]">
                                    <CellTemplate>
                                        @(context.Item.VersionInput ?? "")
                                    </CellTemplate>
                                </TemplateColumn>
                                <TemplateColumn Title="@L["Publisher"]">
                                    <CellTemplate>
                                        @(context.Item.PublisherInput ?? "")
                                    </CellTemplate>
                                </TemplateColumn>
                                <TemplateColumn Title="@L["Status"]">
                                    <CellTemplate>
                                        @if(context.Item.ImportError is not null)
                                        {
                                            <MudChip T="string" Color="Color.Error" Size="Size.Small"
                                                     Style="white-space: normal; height: auto; overflow: visible; text-overflow: unset; padding: 8px 16px;">
                                                @context.Item.ImportError
                                            </MudChip>
                                        }
                                        else if(context.Item.ValidationError is not null)
                                        {
                                            <MudChip T="string" Color="Color.Warning" Size="Size.Small"
                                                     Style="white-space: normal; height: auto; overflow: visible; text-overflow: unset; padding: 8px 16px;">
                                                @context.Item.ValidationError
                                            </MudChip>
                                        }
                                        else
                                        {
                                            <MudChip T="string" Color="Color.Default" Size="Size.Small">@L["Rejected"]</MudChip>
                                        }
                                    </CellTemplate>
                                </TemplateColumn>
                            </Columns>
                        </MudDataGrid>

                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Download"
                                   OnClick="DownloadFailures">
                            @L["Download failures"]
                        </MudButton>
                    }
                </MudStack>
                break;
        }
    </DialogContent>
    <DialogActions>
        @switch(_state)
        {
            case BulkCreateState.Upload:
                <MudButton OnClick="Cancel">@L["Cancel"]</MudButton>
                break;
            case BulkCreateState.Preview:
                <MudButton OnClick="Cancel">@L["Cancel"]</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="StartImport"
                           Disabled="_importRows.All(r => _selectedItems.Contains(r))">
                    @L["Import"]
                </MudButton>
                break;
            case BulkCreateState.Importing:
                break;
            case BulkCreateState.Complete:
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Close">@L["Close"]</MudButton>
                break;
        }
    </DialogActions>
</MudDialog>

@code {
    static readonly string[] CsvHeaders =
    [
        "Version", "Title", "Platform", "Region", "Language", "Publisher",
        "ReleaseYear", "ReleaseMonth", "ReleaseDay"
    ];

    const double JaroExactThreshold   = 0.99;
    const double JaroPartialThreshold = 0.85;

    [Parameter] public int SoftwareId { get; set; }

    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    string                                                  _errorMessage;
    bool                                                    _isProcessing;
    BulkCreateState                                         _state = BulkCreateState.Upload;
    List<SoftwareVersionDto>                                _versions = [];
    Dictionary<string, SoftwareVersionDto>                  _versionExactMap;
    List<UnM49Dto>                                          _allRegions;
    List<Iso639Dto>                                         _allLanguages;
    List<SoftwarePlatformDto>                               _allPlatforms;
    List<CompanyDto>                                        _allPublishers;
    List<SoftwareReleaseBulkCreateRow>                      _importRows = [];
    HashSet<SoftwareReleaseBulkCreateRow>                   _selectedItems = [];
    int                                                     _importedCount;
    int                                                     _rejectedCount;
    int                                                     _failedCount;
    int                                                     _totalToImport;
    double                                                  _progressPercent;

    protected override async Task OnInitializedAsync()
    {
        _versions = await SoftwareVersionsService.GetBySoftwareAsync(SoftwareId) ?? [];
    }

    void Cancel() => MudDialog.Cancel();
    void Close()  => MudDialog.Close(DialogResult.Ok(true));

    async Task DownloadTemplate()
    {
        var rows = new List<Dictionary<string, string>>();

        foreach(SoftwareVersionDto version in _versions)
        {
            var dict = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
            {
                ["Version"]      = version.VersionString ?? "",
                ["Title"]        = "",
                ["Platform"]     = "",
                ["Region"]       = "",
                ["Language"]     = "",
                ["Publisher"]    = "",
                ["ReleaseYear"]  = "",
                ["ReleaseMonth"] = "",
                ["ReleaseDay"]   = ""
            };

            rows.Add(dict);
        }

        string csv = rows.Count > 0
                         ? CsvParser.Generate(CsvHeaders, rows)
                         : CsvParser.GenerateTemplate(CsvHeaders);

        byte[] bytes  = System.Text.Encoding.UTF8.GetBytes(csv);
        string base64 = Convert.ToBase64String(bytes);

        await JsRuntime.InvokeVoidAsync("downloadFileFromBytes", $"software_{SoftwareId}_bulk_create_releases_template.csv", "text/csv", base64);
    }

    async Task OnCsvFileSelected(IBrowserFile file)
    {
        if(file is null) return;

        _isProcessing = true;
        _errorMessage = null;
        StateHasChanged();

        try
        {
            await using var stream = file.OpenReadStream(10 * 1024 * 1024);
            using var       reader = new System.IO.StreamReader(stream);
            string          csvContent = await reader.ReadToEndAsync();

            List<Dictionary<string, string>> rows = CsvParser.Parse(csvContent);

            if(rows.Count == 0)
            {
                _errorMessage = L["The CSV file is empty or has no data rows."];
                _isProcessing = false;
                StateHasChanged();

                return;
            }

            // Reload versions in case they changed since the dialog opened
            _versions      = await SoftwareVersionsService.GetBySoftwareAsync(SoftwareId) ?? [];
            _allRegions    = await SoftwareReleasesService.GetAllUnM49Async()  ?? [];
            _allLanguages  = await SoftwareReleasesService.GetAllLanguagesAsync() ?? [];
            _allPlatforms  = await SoftwareService.GetPlatformsAsync()        ?? [];
            _allPublishers = await SoftwareReleasesService.GetAllCompaniesAsync() ?? [];

            BuildVersionMap();
            _importRows = ParseRows(rows);
            PreSelectRejections();

            _state = BulkCreateState.Preview;
        }
        catch(Exception ex)
        {
            _errorMessage = string.Format(L["Error reading CSV: {0}"], ex.Message);
        }
        finally
        {
            _isProcessing = false;
            StateHasChanged();
        }
    }

    void BuildVersionMap()
    {
        _versionExactMap = new Dictionary<string, SoftwareVersionDto>(StringComparer.OrdinalIgnoreCase);

        foreach(SoftwareVersionDto version in _versions)
        {
            if(string.IsNullOrWhiteSpace(version.VersionString))
                continue;

            // Last write wins — duplicates would only happen on data corruption
            _versionExactMap[version.VersionString.Trim()] = version;
        }
    }

    List<SoftwareReleaseBulkCreateRow> ParseRows(List<Dictionary<string, string>> rows)
    {
        var result = new List<SoftwareReleaseBulkCreateRow>();

        foreach(Dictionary<string, string> row in rows)
        {
            var importRow = new SoftwareReleaseBulkCreateRow
            {
                VersionInput   = GetValueOrNull(row, "Version"),
                Title          = GetValueOrNull(row, "Title"),
                PlatformInput  = GetValueOrNull(row, "Platform"),
                RegionInput    = GetValueOrNull(row, "Region"),
                LanguageInput  = GetValueOrNull(row, "Language"),
                PublisherInput = GetValueOrNull(row, "Publisher")
            };

            if(TryParseInt(row, "ReleaseYear", out int relYear))
                importRow.ReleaseYear = relYear;

            if(TryParseInt(row, "ReleaseMonth", out int relMonth))
                importRow.ReleaseMonth = relMonth;

            if(TryParseInt(row, "ReleaseDay", out int relDay))
                importRow.ReleaseDay = relDay;

            MatchVersion(importRow);
            MatchPlatform(importRow);
            MatchRegion(importRow);
            MatchLanguage(importRow);
            MatchPublisher(importRow);

            result.Add(importRow);
        }

        return result;
    }

    void MatchVersion(SoftwareReleaseBulkCreateRow row)
    {
        if(string.IsNullOrWhiteSpace(row.VersionInput))
        {
            row.VersionMatch    = VersionMatchType.None;
            row.ValidationError = L["Version is required."];

            return;
        }

        string input = row.VersionInput.Trim();

        if(_versionExactMap is not null &&
           _versionExactMap.TryGetValue(input, out SoftwareVersionDto match))
        {
            row.VersionMatch   = VersionMatchType.Exact;
            row.MatchedVersion = match;

            return;
        }

        row.VersionMatch    = VersionMatchType.None;
        row.ValidationError ??= L["Version does not match an existing version of this software."];
    }

    void MatchPublisher(SoftwareReleaseBulkCreateRow row)
    {
        if(string.IsNullOrWhiteSpace(row.PublisherInput))
        {
            row.PublisherMatch  = CompanyMatchType.None;
            row.ValidationError ??= L["Publisher is required."];

            return;
        }

        if(_allPublishers is null)
        {
            row.PublisherMatch  = CompanyMatchType.None;
            row.ValidationError ??= L["No matching publisher."];

            return;
        }

        string input = row.PublisherInput.Trim();

        // Try exact match first
        CompanyDto exact = _allPublishers.Find(c =>
            string.Equals(c.Name, input, StringComparison.OrdinalIgnoreCase));

        if(exact is not null)
        {
            row.PublisherMatch    = CompanyMatchType.Exact;
            row.MatchedPublishers = [exact];
            row.SelectedPublisher = exact;

            return;
        }

        List<(CompanyDto item, double score)> matches =
            JaroWinkler.FindMatches<CompanyDto>(input, _allPublishers, c => c.Name, JaroPartialThreshold);

        if(matches.Count > 0)
        {
            if(matches.Count == 1 && matches[0].score >= JaroExactThreshold)
            {
                row.PublisherMatch    = CompanyMatchType.Exact;
                row.MatchedPublishers = [matches[0].item];
                row.SelectedPublisher = matches[0].item;
            }
            else
            {
                row.PublisherMatch    = CompanyMatchType.Partial;
                row.MatchedPublishers = matches.ConvertAll(m => m.item);
                row.SelectedPublisher = row.MatchedPublishers[0];
            }

            return;
        }

        row.PublisherMatch  = CompanyMatchType.None;
        row.ValidationError ??= L["No matching publisher."];
    }

    void MatchRegion(SoftwareReleaseBulkCreateRow row)
    {
        if(string.IsNullOrWhiteSpace(row.RegionInput))
        {
            row.RegionMatch = CompanyMatchType.None;

            return;
        }

        if(_allRegions is null)
        {
            row.RegionMatch = CompanyMatchType.None;

            return;
        }

        string input = row.RegionInput.Trim();

        UnM49Dto exact = _allRegions.Find(r =>
            string.Equals(r.Name, input, StringComparison.OrdinalIgnoreCase));

        if(exact is not null)
        {
            row.RegionMatch    = CompanyMatchType.Exact;
            row.MatchedRegions = [exact];
            row.SelectedRegion = exact;

            return;
        }

        List<(UnM49Dto item, double score)> matches =
            JaroWinkler.FindMatches<UnM49Dto>(input, _allRegions, r => r.Name, JaroPartialThreshold);

        if(matches.Count > 0)
        {
            if(matches.Count == 1 && matches[0].score >= JaroExactThreshold)
            {
                row.RegionMatch    = CompanyMatchType.Exact;
                row.MatchedRegions = [matches[0].item];
                row.SelectedRegion = matches[0].item;
            }
            else
            {
                row.RegionMatch    = CompanyMatchType.Partial;
                row.MatchedRegions = matches.ConvertAll(m => m.item);
                row.SelectedRegion = row.MatchedRegions[0];
            }

            return;
        }

        row.RegionMatch = CompanyMatchType.None;
    }

    void MatchLanguage(SoftwareReleaseBulkCreateRow row)
    {
        if(string.IsNullOrWhiteSpace(row.LanguageInput))
        {
            row.LanguageMatch = CompanyMatchType.None;

            return;
        }

        if(_allLanguages is null)
        {
            row.LanguageMatch = CompanyMatchType.None;

            return;
        }

        string input = row.LanguageInput.Trim();

        // Try 3-letter code first
        Iso639Dto codeMatch = _allLanguages.Find(l =>
            string.Equals(l.Id, input, StringComparison.OrdinalIgnoreCase));

        if(codeMatch is not null)
        {
            row.LanguageMatch    = CompanyMatchType.Exact;
            row.MatchedLanguages = [codeMatch];
            row.SelectedLanguage = codeMatch;

            return;
        }

        // Try 2-letter code (Part1) — only for languages that have one
        Iso639Dto part1Match = _allLanguages.Find(l =>
            !string.IsNullOrWhiteSpace(l.Part1) &&
            string.Equals(l.Part1, input, StringComparison.OrdinalIgnoreCase));

        if(part1Match is not null)
        {
            row.LanguageMatch    = CompanyMatchType.Exact;
            row.MatchedLanguages = [part1Match];
            row.SelectedLanguage = part1Match;

            return;
        }

        // Try exact match against ReferenceName
        Iso639Dto nameExact = _allLanguages.Find(l =>
            string.Equals(l.ReferenceName, input, StringComparison.OrdinalIgnoreCase));

        if(nameExact is not null)
        {
            row.LanguageMatch    = CompanyMatchType.Exact;
            row.MatchedLanguages = [nameExact];
            row.SelectedLanguage = nameExact;

            return;
        }

        // Fall back to Jaro on ReferenceName
        List<(Iso639Dto item, double score)> matches =
            JaroWinkler.FindMatches<Iso639Dto>(input, _allLanguages, l => l.ReferenceName, JaroPartialThreshold);

        if(matches.Count > 0)
        {
            if(matches.Count == 1 && matches[0].score >= JaroExactThreshold)
            {
                row.LanguageMatch    = CompanyMatchType.Exact;
                row.MatchedLanguages = [matches[0].item];
                row.SelectedLanguage = matches[0].item;
            }
            else
            {
                row.LanguageMatch    = CompanyMatchType.Partial;
                row.MatchedLanguages = matches.ConvertAll(m => m.item);
                row.SelectedLanguage = row.MatchedLanguages[0];
            }

            return;
        }

        row.LanguageMatch = CompanyMatchType.None;
    }

    void MatchPlatform(SoftwareReleaseBulkCreateRow row)
    {
        if(string.IsNullOrWhiteSpace(row.PlatformInput))
        {
            // Empty platform is OK — release simply has no platform
            row.PlatformMatch = PlatformMatchType.New;

            return;
        }

        if(_allPlatforms is null)
        {
            row.PlatformMatch = PlatformMatchType.New;

            return;
        }

        string input = row.PlatformInput.Trim();

        SoftwarePlatformDto exact = _allPlatforms.Find(p =>
            string.Equals(p.Name, input, StringComparison.OrdinalIgnoreCase));

        if(exact is not null)
        {
            row.PlatformMatch    = PlatformMatchType.Exact;
            row.MatchedPlatforms = [exact];
            row.SelectedPlatform = exact;

            return;
        }

        List<(SoftwarePlatformDto item, double score)> matches =
            JaroWinkler.FindMatches<SoftwarePlatformDto>(input, _allPlatforms, p => p.Name, JaroPartialThreshold);

        if(matches.Count > 0)
        {
            if(matches.Count == 1 && matches[0].score >= JaroExactThreshold)
            {
                row.PlatformMatch    = PlatformMatchType.Exact;
                row.MatchedPlatforms = [matches[0].item];
                row.SelectedPlatform = matches[0].item;
            }
            else
            {
                row.PlatformMatch    = PlatformMatchType.Partial;
                row.MatchedPlatforms = matches.ConvertAll(m => m.item);
                row.SelectedPlatform = row.MatchedPlatforms[0];
            }

            return;
        }

        // No match — will create new
        row.PlatformMatch = PlatformMatchType.New;
    }

    void PreSelectRejections()
    {
        _selectedItems = [];

        foreach(SoftwareReleaseBulkCreateRow row in _importRows)
        {
            if(row.ValidationError is not null)
            {
                _selectedItems.Add(row);

                continue;
            }

            if(row.VersionMatch == VersionMatchType.None)
            {
                _selectedItems.Add(row);

                continue;
            }

            if(row.PublisherMatch == CompanyMatchType.None)
            {
                _selectedItems.Add(row);

                continue;
            }

            if(!string.IsNullOrWhiteSpace(row.RegionInput) && row.RegionMatch == CompanyMatchType.None)
            {
                _selectedItems.Add(row);

                continue;
            }

            if(!string.IsNullOrWhiteSpace(row.LanguageInput) && row.LanguageMatch == CompanyMatchType.None)
                _selectedItems.Add(row);
        }
    }

    void OnPublisherSelected(SoftwareReleaseBulkCreateRow row, CompanyDto company)          => row.SelectedPublisher = company;
    void OnRegionSelected(SoftwareReleaseBulkCreateRow row, UnM49Dto region)                => row.SelectedRegion    = region;
    void OnLanguageSelected(SoftwareReleaseBulkCreateRow row, Iso639Dto language)           => row.SelectedLanguage  = language;
    void OnPlatformSelected(SoftwareReleaseBulkCreateRow row, SoftwarePlatformDto platform) => row.SelectedPlatform  = platform;

    async Task StartImport()
    {
        List<SoftwareReleaseBulkCreateRow> toImport = _importRows.Where(r => !_selectedItems.Contains(r)).ToList();
        List<SoftwareReleaseBulkCreateRow> rejected = _importRows.Where(r => _selectedItems.Contains(r)).ToList();

        _rejectedCount   = rejected.Count;
        _importedCount   = 0;
        _failedCount     = 0;
        _totalToImport   = toImport.Count;
        _progressPercent = 0;
        _state           = BulkCreateState.Importing;

        // Keep only rejected/failed in _importRows for display during import
        _importRows = [..rejected];
        StateHasChanged();

        var createdPlatforms = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);

        foreach(SoftwareReleaseBulkCreateRow row in toImport)
        {
            // Resolve platform: existing match, create new, or none
            int? platformId = null;

            if(!string.IsNullOrWhiteSpace(row.PlatformInput))
            {
                if(row.PlatformMatch == PlatformMatchType.New)
                {
                    string platName = row.PlatformInput.Trim();

                    if(createdPlatforms.TryGetValue(platName, out int existingPlatId))
                    {
                        platformId = existingPlatId;
                    }
                    else
                    {
                        var platDto = new SoftwarePlatformDto { Name = platName };
                        (int? newPlatId, string platError) = await SoftwarePlatformsService.CreateAsync(platDto);

                        if(newPlatId is not null)
                        {
                            platformId                 = newPlatId.Value;
                            createdPlatforms[platName] = newPlatId.Value;
                        }
                        else
                        {
                            _failedCount++;
                            row.ImportError = string.Format(L["Failed to create platform '{0}': {1}"], platName, platError ?? L["Unknown error"]);
                            _importRows.Add(row);
                            await UpdateProgress();

                            continue;
                        }
                    }
                }
                else
                {
                    platformId = row.SelectedPlatform?.Id;
                }
            }

            // Step 1: create release
            var dto = new SoftwareReleaseDto
            {
                Title                = row.Title,
                IsCompilation        = false,
                SoftwareId           = SoftwareId,
                SoftwareVersionId    = row.MatchedVersion?.Id,
                PlatformId           = platformId,
                PublisherId          = row.SelectedPublisher?.Id,
                ReleaseDate          = row.ReleaseDate.HasValue ? new DateTimeOffset(row.ReleaseDate.Value) : null,
                ReleaseDatePrecision = row.ReleaseDatePrecision
            };

            (int? releaseId, string err) = await SoftwareReleasesService.CreateAsync(dto);

            if(releaseId is null)
            {
                _failedCount++;
                row.ImportError = err ?? L["Unknown error"];
                _importRows.Add(row);
                await UpdateProgress();

                continue;
            }

            // Step 2: attach region (atomic — rollback release on failure)
            if(row.SelectedRegion?.Id is { } regionId)
            {
                (bool ok, string regErr) = await SoftwareReleasesService.AddRegionToReleaseAsync(releaseId.Value, regionId);

                if(!ok)
                {
                    string rollbackError = await TryRollbackRelease(releaseId.Value);

                    _failedCount++;
                    row.ImportError = rollbackError is null
                                          ? string.Format(L["Region attach failed (release rolled back): {0}"], regErr ?? L["Unknown error"])
                                          : string.Format(L["Release attach failed AND rollback failed: {0}. Release id {1} may be orphaned."], regErr ?? L["Unknown error"], releaseId.Value);
                    _importRows.Add(row);
                    await UpdateProgress();

                    continue;
                }
            }

            // Step 3: attach language (atomic — rollback release on failure)
            if(!string.IsNullOrWhiteSpace(row.SelectedLanguage?.Id))
            {
                (bool ok, string langErr) = await SoftwareReleasesService.AddLanguageToReleaseAsync(releaseId.Value, row.SelectedLanguage.Id);

                if(!ok)
                {
                    string rollbackError = await TryRollbackRelease(releaseId.Value);

                    _failedCount++;
                    row.ImportError = rollbackError is null
                                          ? string.Format(L["Language attach failed (release rolled back): {0}"], langErr ?? L["Unknown error"])
                                          : string.Format(L["Release attach failed AND rollback failed: {0}. Release id {1} may be orphaned."], langErr ?? L["Unknown error"], releaseId.Value);
                    _importRows.Add(row);
                    await UpdateProgress();

                    continue;
                }
            }

            _importedCount++;
            await UpdateProgress();
        }

        _state = BulkCreateState.Complete;
        StateHasChanged();
    }

    async Task<string> TryRollbackRelease(int releaseId)
    {
        (bool deleted, string deleteErr) = await SoftwareReleasesService.DeleteAsync(releaseId);

        return deleted ? null : (deleteErr ?? "delete failed");
    }

    async Task UpdateProgress()
    {
        _progressPercent = _totalToImport > 0
                               ? (double)(_importedCount + _failedCount) / _totalToImport * 100
                               : 100;

        StateHasChanged();
        await Task.Delay(1);
    }

    async Task DownloadFailures()
    {
        var rows = new List<Dictionary<string, string>>();

        foreach(SoftwareReleaseBulkCreateRow row in _importRows)
        {
            var dict = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
            {
                ["Version"]      = row.VersionInput   ?? "",
                ["Title"]        = row.Title          ?? "",
                ["Platform"]     = row.PlatformInput  ?? "",
                ["Region"]       = row.RegionInput    ?? "",
                ["Language"]     = row.LanguageInput  ?? "",
                ["Publisher"]    = row.PublisherInput ?? "",
                ["ReleaseYear"]  = row.ReleaseYear?.ToString()  ?? "",
                ["ReleaseMonth"] = row.ReleaseMonth?.ToString() ?? "",
                ["ReleaseDay"]   = row.ReleaseDay?.ToString()   ?? ""
            };

            rows.Add(dict);
        }

        string csv    = CsvParser.Generate(CsvHeaders, rows);
        byte[] bytes  = System.Text.Encoding.UTF8.GetBytes(csv);
        string base64 = Convert.ToBase64String(bytes);

        await JsRuntime.InvokeVoidAsync("downloadFileFromBytes", $"software_{SoftwareId}_bulk_create_releases_failures.csv", "text/csv", base64);
    }

    static string FormatImportDate(int? year, int? month, int? day)
    {
        if(year is null)
            return "";

        if(month is null)
            return year.Value.ToString();

        if(day is null)
            return $"{month.Value:D2}/{year.Value}";

        return $"{day.Value:D2}/{month.Value:D2}/{year.Value}";
    }

    static string GetValueOrNull(Dictionary<string, string> row, string key)
    {
        if(!row.TryGetValue(key, out string val))
            return null;

        string trimmed = val?.Trim() ?? "";

        return string.IsNullOrEmpty(trimmed) ? null : trimmed;
    }

    static bool TryParseInt(Dictionary<string, string> row, string key, out int result)
    {
        result = 0;
        string val = GetValueOrNull(row, key);

        return val is not null && int.TryParse(val, out result);
    }

    enum BulkCreateState
    {
        Upload,
        Preview,
        Importing,
        Complete
    }
}
