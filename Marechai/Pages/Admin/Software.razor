@page "/admin/software"
@attribute [Authorize(Roles = "Admin, UberAdmin")]
@using Marechai.ApiClient.Models
@using Marechai.Services
@inject SoftwareService SoftwareService
@inject IStringLocalizer<SoftwareService> L
@inject IDialogService DialogService
@inject NavigationManager NavigationManager

<MudPaper Class="pa-6 mb-6" Elevation="0" Style="background: linear-gradient(135deg, #827717 0%, #c0ca33 100%); border-radius: 16px;">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
        <MudIcon Icon="@Icons.Material.Filled.Apps" Size="Size.Large" Style="color: white;"/>
        <MudText Typo="Typo.h4" Style="color: white;">@L["Software Management"]</MudText>
    </MudStack>
    <MudText Typo="Typo.subtitle1" Style="color: rgba(255,255,255,0.85);" Class="mt-2">@L["Manage software entries and versions."]</MudText>
</MudPaper>

@if(!string.IsNullOrWhiteSpace(_errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="() => _errorMessage = null">@_errorMessage</MudAlert>
}

@if(!string.IsNullOrWhiteSpace(_successMessage))
{
    <MudAlert Severity="Severity.Success" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="() => _successMessage = null">@_successMessage</MudAlert>
}

@if(_isLoading)
{
    <div class="d-flex justify-center pa-8">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large"/>
    </div>
    return;
}

<MudPaper Elevation="2" Class="rounded-lg">
    <MudToolBar Dense="true">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenAddDialog">@L["Add Software"]</MudButton>
        <MudSpacer/>
        <MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="LoadDataAsync"/>
    </MudToolBar>

    <MudDataGrid Items="_softwareList" Dense="true" Hover="true" Striped="true" Filterable="true" QuickFilter="QuickFilter">
        <Columns>
            <PropertyColumn Property="x => x.Name" Title="@L["Name"]"/>
            <PropertyColumn Property="x => x.Family" Title="@L["Family"]"/>
            <TemplateColumn Title="@L["OS"]" Sortable="true">
                <CellTemplate>
                    @(context.Item.IsOperatingSystem == true ? "✓" : "✗")
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="@L["Game"]" Sortable="true">
                <CellTemplate>
                    @(context.Item.IsGame == true ? "✓" : "✗")
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="@L["Actions"]" Sortable="false">
                <CellTemplate>
                    <MudStack Row="true" Spacing="1">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => OpenEditDialog(context.Item)" Title="@L["Edit"]"/>
                        <MudIconButton Icon="@Icons.Material.Filled.Description" Size="Size.Small" OnClick="() => OpenDescriptionsDialog(context.Item)" Title="@L["Descriptions"]"/>
                        <MudIconButton Icon="@Icons.Material.Filled.ListAlt" Size="Size.Small" OnClick="() => NavigateToVersions(context.Item)" Title="@L["Versions"]"/>
                        <MudIconButton Icon="@Icons.Material.Filled.Screenshot" Size="Size.Small" OnClick="() => NavigateToScreenshots(context.Item)" Title="@L["Screenshots"]"/>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => ConfirmDelete(context.Item)" Title="@L["Delete"]"/>
                    </MudStack>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </MudDataGrid>
</MudPaper>
