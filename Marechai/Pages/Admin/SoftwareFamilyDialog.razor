@using Marechai.ApiClient.Models
@using Marechai.Services
@using System.Threading

@inject IStringLocalizer<SoftwareFamiliesService> L

<MudDialog>
    <DialogContent>
        <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4">
            @* Tab 1 - Basic Info *@
            <MudTabPanel Text="@L["Basic Info"]" Icon="@Icons.Material.Filled.Info">
                <MudTextField @bind-Value="Name"
                              Label="@L["Name"]"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="@L["Name is required."]"
                              Class="mb-4"/>

                <MudAutocomplete T="SoftwareFamilyDto"
                                 Label="@L["Parent family"]"
                                 @bind-Value="_selectedParent"
                                 SearchFunc="SearchParents"
                                 ToStringFunc="@(f => f?.Name ?? string.Empty)"
                                 Variant="Variant.Outlined"
                                 Clearable="true"
                                 Class="mb-4"/>

                <MudDatePicker @bind-Date="Introduced"
                               Label="@L["Introduced"]"
                               Variant="Variant.Outlined"
                               Clearable="true"
                               Class="mb-4"/>

        <MudSelect T="int" @bind-Value="IntroducedPrecision"
                   Label="@L["Date precision"]"
                   Variant="Variant.Outlined"
                   Class="mb-4">
            <MudSelectItem T="int" Value="0">@L["Full date"]</MudSelectItem>
            <MudSelectItem T="int" Value="1">@L["Month and year only"]</MudSelectItem>
            <MudSelectItem T="int" Value="2">@L["Year only"]</MudSelectItem>
        </MudSelect>

                @if(!string.IsNullOrWhiteSpace(_validationError))
                {
                    <MudAlert Severity="Severity.Error" Class="mt-2">@_validationError</MudAlert>
                }
            </MudTabPanel>

            @* Tab 2 - Company Roles *@
            @if(!IsNew)
            {
                <MudTabPanel Text="@L["Companies"]" Icon="@Icons.Material.Filled.Business">
                    @if(_companyRoles is { Count: > 0 })
                    {
                        <MudList T="CompanyBySoftwareFamilyDto" Dense="true">
                            @foreach(CompanyBySoftwareFamilyDto role in _companyRoles)
                            {
                                <MudListItem T="CompanyBySoftwareFamilyDto">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                        <MudText>@($"{role.Company} ({role.Role})")</MudText>
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                       Size="Size.Small"
                                                       Color="Color.Error"
                                                       OnClick="() => RemoveCompanyRole(role)"/>
                                    </MudStack>
                                </MudListItem>
                            }
                        </MudList>
                    }

                    <MudPaper Class="pa-4 mt-2" Elevation="1">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudAutocomplete T="CompanyDto"
                                             Label="@L["Search Company"]"
                                             @bind-Value="_selectedCompany"
                                             SearchFunc="SearchCompanies"
                                             ToStringFunc="@(c => c?.Name ?? string.Empty)"
                                             Variant="Variant.Outlined"
                                             Clearable="true"
                                             Style="flex: 1;"/>
                            <MudSelect T="SoftwareRoleDto"
                                       @bind-Value="_selectedRole"
                                       Label="@L["Role"]"
                                       ToStringFunc="@(r => r?.Name ?? string.Empty)"
                                       Variant="Variant.Outlined"
                                       Style="max-width: 200px;">
                                @if(_allRoles is not null)
                                {
                                    @foreach(SoftwareRoleDto role in _allRoles)
                                    {
                                        <MudSelectItem T="SoftwareRoleDto" Value="role">@role.Name</MudSelectItem>
                                    }
                                }
                            </MudSelect>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       OnClick="AddCompanyRole"
                                       Disabled="@(_selectedCompany is null || _selectedRole is null)">
                                @L["Add"]
                            </MudButton>
                        </MudStack>
                    </MudPaper>

                    @if(!string.IsNullOrWhiteSpace(_companyRoleMessage))
                    {
                        <MudAlert Severity="@_companyRoleMessageSeverity" Class="mt-2" ShowCloseIcon="true"
                                  CloseIconClicked="() => _companyRoleMessage = null">@_companyRoleMessage</MudAlert>
                    }
                </MudTabPanel>
            }
        </MudTabs>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">@L["Save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    string                            _validationError;
    SoftwareFamilyDto                 _selectedParent;
    List<SoftwareFamilyDto>           _allFamilies;
    CompanyDto                        _selectedCompany;
    List<CompanyDto>                  _allCompanies;
    SoftwareRoleDto                   _selectedRole;
    List<SoftwareRoleDto>             _allRoles;
    List<CompanyBySoftwareFamilyDto>  _companyRoles;
    string                            _companyRoleMessage;
    Severity                           _companyRoleMessageSeverity;

    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public bool IsNew { get; set; }
    [Parameter] public int FamilyId { get; set; }
    [Parameter] public string Name { get; set; } = string.Empty;
    [Parameter] public int? ParentId { get; set; }
    [Parameter] public DateTime? Introduced { get; set; }
    [Parameter] public int       IntroducedPrecision { get; set; }

    [Inject] SoftwareFamiliesService SoftwareFamiliesService { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        _allFamilies = await SoftwareFamiliesService.GetAllAsync();

        if(ParentId is not null && _allFamilies is not null)
            _selectedParent = _allFamilies.Find(f => f.Id == ParentId);

        if(!IsNew)
        {
            _allCompanies = await SoftwareFamiliesService.GetAllCompaniesAsync();
            _allRoles     = await SoftwareFamiliesService.GetSoftwareRolesAsync();
            _companyRoles = await SoftwareFamiliesService.GetCompanyRolesAsync(FamilyId);
        }
    }

    Task<IEnumerable<SoftwareFamilyDto>> SearchParents(string value, CancellationToken ct)
    {
        IEnumerable<SoftwareFamilyDto> results = _allFamilies ?? [];

        if(!string.IsNullOrWhiteSpace(value))
        {
            results = _allFamilies?
                         .Where(f => f.Name?.Contains(value, StringComparison.OrdinalIgnoreCase) ?? false) ??
                      [];
        }

        return Task.FromResult(results);
    }

    Task<IEnumerable<CompanyDto>> SearchCompanies(string value, CancellationToken ct)
    {
        IEnumerable<CompanyDto> results = _allCompanies ?? [];

        if(!string.IsNullOrWhiteSpace(value))
        {
            results = _allCompanies?
                         .Where(c => c.Name?.Contains(value, StringComparison.OrdinalIgnoreCase) ?? false) ??
                      [];
        }

        return Task.FromResult(results);
    }

    async Task AddCompanyRole()
    {
        if(_selectedCompany is null || _selectedRole is null) return;

        var dto = new CompanyBySoftwareFamilyDto
        {
            SoftwareFamilyId = FamilyId,
            CompanyId        = _selectedCompany.Id,
            RoleId           = _selectedRole.Id
        };

        (int? id, string error) = await SoftwareFamiliesService.AddCompanyRoleAsync(dto);

        if(id is not null)
        {
            _companyRoles       = await SoftwareFamiliesService.GetCompanyRolesAsync(FamilyId);
            _selectedCompany    = null;
            _selectedRole       = null;
            _companyRoleMessage = null;
        }
        else
        {
            _companyRoleMessage         = error;
            _companyRoleMessageSeverity = Severity.Error;
        }
    }

    async Task RemoveCompanyRole(CompanyBySoftwareFamilyDto role)
    {
        (bool succeeded, string error) = await SoftwareFamiliesService.RemoveCompanyRoleAsync(role.Id ?? 0);

        if(succeeded)
        {
            _companyRoles       = await SoftwareFamiliesService.GetCompanyRolesAsync(FamilyId);
            _companyRoleMessage = null;
        }
        else
        {
            _companyRoleMessage         = error;
            _companyRoleMessageSeverity = Severity.Error;
        }
    }

    void Cancel() => MudDialog.Cancel();

    void Submit()
    {
        if(string.IsNullOrWhiteSpace(Name))
        {
            _validationError = L["Name is required."];
            return;
        }

        MudDialog.Close(DialogResult.Ok(new SoftwareFamilyDialogResult
        {
            Name       = Name,
            ParentId   = _selectedParent?.Id,
            Introduced = Introduced,
            IntroducedPrecision = IntroducedPrecision
        }));
    }
}
