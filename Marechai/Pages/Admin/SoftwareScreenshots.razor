@page "/admin/software/{SoftwareId:int}/screenshots"
@attribute [Authorize(Roles = "Admin, UberAdmin")]
@using System.Linq
@using Marechai.ApiClient.Models
@using Marechai.Services
@inject SoftwareService SoftwareService
@inject IStringLocalizer<SoftwareService> L
@inject IDialogService DialogService
@inject NavigationManager NavigationManager
@inject ApiAssetUrlProvider AssetUrls

<MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="@(() => NavigationManager.NavigateTo("/admin/software"))" Class="mb-4">@L["Back to Software"]</MudButton>

<MudPaper Class="pa-6 mb-6" Elevation="0" Style="background: linear-gradient(135deg, #e65100 0%, #ff8a65 100%); border-radius: 16px;">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
        <MudIcon Icon="@Icons.Material.Filled.Screenshot" Size="Size.Large" Style="color: white;"/>
        <MudText Typo="Typo.h4" Style="color: white;">@L["Software Screenshot Management"]</MudText>
    </MudStack>
    <MudText Typo="Typo.subtitle1" Style="color: rgba(255,255,255,0.85);" Class="mt-2">@(_softwareName ?? L["Manage software screenshots."])</MudText>
</MudPaper>

@if(!string.IsNullOrWhiteSpace(_errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="() => _errorMessage = null">@_errorMessage</MudAlert>
}

@if(!string.IsNullOrWhiteSpace(_successMessage))
{
    <MudAlert Severity="Severity.Success" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="() => _successMessage = null">@_successMessage</MudAlert>
}

@if(_isLoading)
{
    <div class="d-flex justify-center pa-8">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large"/>
    </div>
    return;
}

<MudPaper Elevation="2" Class="rounded-lg pa-4">
    <MudSelect T="SoftwarePlatformDto" @bind-Value="_selectedPlatform"
               Label="@L["Platform"]" Variant="Variant.Outlined" Dense="true"
               Clearable="true" Class="mb-3" Style="max-width: 300px;">
        @if(_platforms is not null)
        {
            @foreach(SoftwarePlatformDto platform in _platforms)
            {
                <MudSelectItem T="SoftwarePlatformDto" Value="platform">@platform.Name</MudSelectItem>
            }
        }
    </MudSelect>
    <MudToolBar Dense="true">
        <MudFileUpload T="IBrowserFile"
                       Accept=".jpg,.jpeg,.png,.webp,.tiff,.tif,.bmp"
                       FilesChanged="OnFileSelected"
                       MaximumFileCount="1">
            <CustomContent>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Upload"
                           OnClick="@context.OpenFilePickerAsync">
                    @L["Upload Screenshot"]
                </MudButton>
            </CustomContent>
        </MudFileUpload>
        <MudSpacer/>
        <MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="LoadDataAsync"/>
    </MudToolBar>

    @if(_screenshots is { Count: > 0 })
    {
        <MudGrid Class="mt-4">
            @foreach(SoftwareScreenshotDto screenshot in _screenshots)
            {
                @if(screenshot.Id.HasValue)
                {
                    <MudItem xs="12" sm="6" md="4" lg="3">
                        <MudCard>
                            <MudCardContent Class="pa-2 d-flex flex-column align-center">
                                <picture>
                                    <source srcset="@(AssetUrls.BaseUrl)/assets/photos/software-screenshots/jxl/hd/@(screenshot.Id.Value).jxl, @(AssetUrls.BaseUrl)/assets/photos/software-screenshots/jxl/1440p/@(screenshot.Id.Value).jxl 2x, @(AssetUrls.BaseUrl)/assets/photos/software-screenshots/jxl/4k/@(screenshot.Id.Value).jxl 3x" type="image/jxl">
                                    <source srcset="@(AssetUrls.BaseUrl)/assets/photos/software-screenshots/avif/hd/@(screenshot.Id.Value).avif, @(AssetUrls.BaseUrl)/assets/photos/software-screenshots/avif/1440p/@(screenshot.Id.Value).avif 2x, @(AssetUrls.BaseUrl)/assets/photos/software-screenshots/avif/4k/@(screenshot.Id.Value).avif 3x" type="image/avif">
                                    <source srcset="@(AssetUrls.BaseUrl)/assets/photos/software-screenshots/webp/hd/@(screenshot.Id.Value).webp, @(AssetUrls.BaseUrl)/assets/photos/software-screenshots/webp/1440p/@(screenshot.Id.Value).webp 2x, @(AssetUrls.BaseUrl)/assets/photos/software-screenshots/webp/4k/@(screenshot.Id.Value).webp 3x" type="image/webp">
                                    <img alt="@(screenshot.Caption ?? screenshot.Id.Value.ToString())"
                                         src="@(AssetUrls.BaseUrl)/assets/photos/software-screenshots/jpeg/hd/@(screenshot.Id.Value).jpg"
                                         srcset="@(AssetUrls.BaseUrl)/assets/photos/software-screenshots/jpeg/hd/@(screenshot.Id.Value).jpg, @(AssetUrls.BaseUrl)/assets/photos/software-screenshots/jpeg/1440p/@(screenshot.Id.Value).jpg 2x, @(AssetUrls.BaseUrl)/assets/photos/software-screenshots/jpeg/4k/@(screenshot.Id.Value).jpg 3x"
                                         style="width: 100%; max-height: 150px; object-fit: contain; border-radius: 4px;"/>
                                </picture>
                                <MudSelect T="SoftwarePlatformDto"
                                           Value="@(_platforms?.FirstOrDefault(p => p.Id == screenshot.SoftwarePlatformId))"
                                           ValueChanged="@(p => OnScreenshotPlatformChanged(screenshot, p))"
                                           Label="@L["Platform"]" Variant="Variant.Outlined" Dense="true"
                                           Clearable="true" Class="mt-2" Style="max-width: 250px;">
                                    @if(_platforms is not null)
                                    {
                                        @foreach(SoftwarePlatformDto platform in _platforms)
                                        {
                                            <MudSelectItem T="SoftwarePlatformDto" Value="platform">@platform.Name</MudSelectItem>
                                        }
                                    }
                                </MudSelect>
                            </MudCardContent>
                            <MudCardActions>
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Size="Size.Small"
                                               Color="Color.Error"
                                               OnClick="() => ConfirmDeleteScreenshot(screenshot.Id.Value)"
                                               title="@L["Delete"]"/>
                            </MudCardActions>
                        </MudCard>
                    </MudItem>
                }
            }
        </MudGrid>
    }
    else
    {
        <MudText Typo="Typo.body1" Class="pa-4 text-center" Color="Color.Default">@L["No screenshots yet."]</MudText>
    }
</MudPaper>
