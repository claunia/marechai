@page "/admin/software/variants/{VariantId:int}/subvariants"
@attribute [Authorize(Roles = "Admin, UberAdmin")]
@using Marechai.ApiClient.Models
@using Marechai.Services
@inject SoftwareSubvariantsService SoftwareSubvariantsService
@inject SoftwareVariantsService SoftwareVariantsService
@inject IStringLocalizer<SoftwareSubvariantsService> L
@inject IDialogService DialogService
@inject NavigationManager NavigationManager

<MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="GoBack" Class="mb-4">@L["Back to Variants"]</MudButton>

<MudPaper Class="pa-6 mb-6" Elevation="0" Style="background: linear-gradient(135deg, #6a1b9a 0%, #ce93d8 100%); border-radius: 16px;">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
        <MudIcon Icon="@Icons.Material.Filled.Subtitles" Size="Size.Large" Style="color: white;"/>
        <MudText Typo="Typo.h4" Style="color: white;">@L["Software Subvariant Management"]</MudText>
    </MudStack>
    <MudText Typo="Typo.subtitle1" Style="color: rgba(255,255,255,0.85);" Class="mt-2">@(_variantName ?? L["Manage software subvariants."])</MudText>
</MudPaper>

@if(!string.IsNullOrWhiteSpace(_errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="() => _errorMessage = null">@_errorMessage</MudAlert>
}

@if(!string.IsNullOrWhiteSpace(_successMessage))
{
    <MudAlert Severity="Severity.Success" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="() => _successMessage = null">@_successMessage</MudAlert>
}

@if(_isLoading)
{
    <div class="d-flex justify-center pa-8">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large"/>
    </div>
    return;
}

<MudPaper Elevation="2" Class="rounded-lg">
    <MudToolBar Dense="true">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenAddDialog">@L["Add Subvariant"]</MudButton>
        <MudSpacer/>
        <MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="LoadDataAsync"/>
    </MudToolBar>

    <MudDataGrid Items="_subvariants" Dense="true" Hover="true" Striped="true" Filterable="true">
        <Columns>
            <PropertyColumn Property="x => x.Name" Title="@L["Name"]"/>
            <TemplateColumn Title="@L["Actions"]" Sortable="false">
                <CellTemplate>
                    <MudStack Row="true" Spacing="1">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => OpenEditDialog(context.Item)" Title="@L["Edit"]"/>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => ConfirmDelete(context.Item)" Title="@L["Delete"]"/>
                    </MudStack>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </MudDataGrid>
</MudPaper>
