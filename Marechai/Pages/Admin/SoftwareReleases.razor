@page "/admin/software/versions/{VersionId:int}/releases"
@page "/admin/software/{SoftwareId:int}/releases"
@page "/admin/software/releases"
@attribute [Authorize(Roles = "Admin, UberAdmin")]
@using Marechai.ApiClient.Models
@using Marechai.Services
@inject SoftwareReleasesService SoftwareReleasesService
@inject SoftwareVersionsService SoftwareVersionsService
@inject IStringLocalizer<SoftwareReleasesService> L
@inject IDialogService DialogService
@inject NavigationManager NavigationManager

<MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="GoBack" Class="mb-4">@L["Back to Versions"]</MudButton>

<MudPaper Class="pa-6 mb-6" Elevation="0" Style="background: linear-gradient(135deg, #1b5e20 0%, #66bb6a 100%); border-radius: 16px;">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
        <MudIcon Icon="@Icons.Material.Filled.Album" Size="Size.Large" Style="color: white;"/>
        <MudText Typo="Typo.h4" Style="color: white;">@L["Software Release Management"]</MudText>
    </MudStack>
    <MudText Typo="Typo.subtitle1" Style="color: rgba(255,255,255,0.85);" Class="mt-2">@(_versionName ?? L["Manage software releases."])</MudText>
</MudPaper>

@if(!string.IsNullOrWhiteSpace(_errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="() => _errorMessage = null">@_errorMessage</MudAlert>
}

@if(!string.IsNullOrWhiteSpace(_successMessage))
{
    <MudAlert Severity="Severity.Success" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="() => _successMessage = null">@_successMessage</MudAlert>
}

<MudPaper Elevation="2" Class="rounded-lg">
    <MudToolBar Dense="true">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenAddDialog">@L["Add Release"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Upload" OnClick="OpenImportDialog" Class="ml-2">@L["Import CSV"]</MudButton>
        <MudSpacer/>
        <MudTextField T="string" ValueChanged="OnSearch" Placeholder="@L["Search by title, software, platform, publisher..."]"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      IconSize="Size.Medium" Class="mt-0" DebounceInterval="300" Immediate="true"/>
        <MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="async () => await _dataGrid.ReloadServerData()"/>
    </MudToolBar>

    <MudDataGrid @ref="_dataGrid" T="SoftwareReleaseDto" ServerData="ServerReload" Dense="true" Hover="true" Striped="true" Filterable="true" RowsPerPage="25">
        <Columns>
            <PropertyColumn Property="x => x.Title" Title="@L["Title"]"/>
            @if(!_isVersionContext && !_isSoftwareContext)
            {
                <PropertyColumn Property="x => x.Software" Title="@L["Software"]"/>
            }
            <PropertyColumn Property="x => x.Platform" Title="@L["Platform"]"/>
            <TemplateColumn Title="@L["Regions"]" Filterable="false">
                <CellTemplate>
                    @if(context.Item.Regions is not null)
                    {
                        @string.Join(", ", context.Item.Regions.Select(r => r.RegionName))
                    }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="@L["Languages"]" Filterable="false">
                <CellTemplate>
                    @if(context.Item.Languages is not null)
                    {
                        @string.Join(", ", context.Item.Languages.Select(l => l.Language))
                    }
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.Publisher" Title="@L["Publisher"]"/>
            <PropertyColumn Property="x => x.ReleaseDate" Title="@L["Release date"]">
                <CellTemplate>
                    @FormatDate(context.Item.ReleaseDate)
                </CellTemplate>
            </PropertyColumn>
            <TemplateColumn Title="@L["Actions"]" Sortable="false" Filterable="false">
                <CellTemplate>
                    <MudStack Row="true" Spacing="1">
                        <MudTooltip Text="@L["Edit"]"><MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => OpenEditDialog(context.Item)"/></MudTooltip>

                        <MudTooltip Text="@L["Delete"]"><MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => ConfirmDelete(context.Item)"/></MudTooltip>

                    </MudStack>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <PagerContent>
            <MudDataGridPager T="SoftwareReleaseDto"/>
        </PagerContent>
    </MudDataGrid>
</MudPaper>
