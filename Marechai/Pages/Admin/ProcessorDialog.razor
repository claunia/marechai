@using Marechai.ApiClient.Models
@using Marechai.Services
@using System.Threading

@inject IStringLocalizer<ProcessorsService> L

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.h6" Class="mb-2">@L["Basic information"]</MudText>

        <MudTextField @bind-Value="Name"
                      Label="@L["Name"]"
                      Variant="Variant.Outlined"
                      Required="true"
                      RequiredError="@L["Name is required."]"
                      Class="mb-4"/>

        <MudAutocomplete T="CompanyDto"
                         Label="@L["Search Company"]"
                         @bind-Value="_selectedCompany"
                         SearchFunc="SearchCompanies"
                         ToStringFunc="@(c => c?.Name ?? string.Empty)"
                         Variant="Variant.Outlined"
                         Clearable="true"
                         Class="mb-4"/>

        <MudTextField @bind-Value="ModelCode"
                      Label="@L["Model code"]"
                      Variant="Variant.Outlined"
                      Class="mb-4"/>

        <MudDatePicker @bind-Date="Introduced"
                       Label="@L["Introduction date"]"
                       Variant="Variant.Outlined"
                       Clearable="true"
                       Class="mb-4"/>

        <MudSelect T="int" @bind-Value="IntroducedPrecision"
                   Label="@L["Date precision"]"
                   Variant="Variant.Outlined"
                   Class="mb-4">
            <MudSelectItem T="int" Value="0">@L["Full date"]</MudSelectItem>
            <MudSelectItem T="int" Value="1">@L["Month and year only"]</MudSelectItem>
            <MudSelectItem T="int" Value="2">@L["Year only"]</MudSelectItem>
        </MudSelect>

        <MudSelect T="int?" @bind-Value="InstructionSetId"
                   Label="@L["Instruction set"]"
                   Variant="Variant.Outlined"
                   Clearable="true"
                   Class="mb-4">
            @if(_allInstructionSets is not null)
            {
                @foreach(InstructionSetDto isa in _allInstructionSets)
                {
                    <MudSelectItem T="int?" Value="isa.Id">@isa.Name</MudSelectItem>
                }
            }
        </MudSelect>

        <MudDivider Class="my-4"/>
        <MudText Typo="Typo.h6" Class="mb-2">@L["Performance"]</MudText>

        <MudNumericField T="double?" @bind-Value="Speed"
                         Label="@L["Speed (MHz)"]"
                         Variant="Variant.Outlined"
                         Clearable="true"
                         Class="mb-4"/>

        <MudStack Row="true" Spacing="2" Class="mb-4">
            <MudNumericField T="int?" @bind-Value="Cores"
                             Label="@L["Cores"]"
                             Variant="Variant.Outlined"
                             Clearable="true"
                             Style="flex: 1;"/>
            <MudNumericField T="int?" @bind-Value="ThreadsPerCore"
                             Label="@L["Threads per core"]"
                             Variant="Variant.Outlined"
                             Clearable="true"
                             Style="flex: 1;"/>
        </MudStack>

        <MudDivider Class="my-4"/>
        <MudText Typo="Typo.h6" Class="mb-2">@L["Bus"]</MudText>

        <MudStack Row="true" Spacing="2" Class="mb-4">
            <MudNumericField T="int?" @bind-Value="DataBus"
                             Label="@L["Data bus (bits)"]"
                             Variant="Variant.Outlined"
                             Clearable="true"
                             Style="flex: 1;"/>
            <MudNumericField T="int?" @bind-Value="AddressBus"
                             Label="@L["Address bus (bits)"]"
                             Variant="Variant.Outlined"
                             Clearable="true"
                             Style="flex: 1;"/>
        </MudStack>

        <MudDivider Class="my-4"/>
        <MudText Typo="Typo.h6" Class="mb-2">@L["Manufacturing"]</MudText>

        <MudTextField @bind-Value="Package"
                      Label="@L["Package"]"
                      Variant="Variant.Outlined"
                      Class="mb-4"/>

        <MudStack Row="true" Spacing="2" Class="mb-4">
            <MudTextField @bind-Value="Process"
                          Label="@L["Process"]"
                          Variant="Variant.Outlined"
                          Style="flex: 1;"/>
            <MudNumericField T="float?" @bind-Value="ProcessNm"
                             Label="@L["Process (nm)"]"
                             Variant="Variant.Outlined"
                             Clearable="true"
                             Style="flex: 1;"/>
        </MudStack>

        <MudStack Row="true" Spacing="2" Class="mb-4">
            <MudNumericField T="float?" @bind-Value="DieSize"
                             Label="@L["Die size (mm²)"]"
                             Variant="Variant.Outlined"
                             Clearable="true"
                             Style="flex: 1;"/>
            <MudNumericField T="long?" @bind-Value="Transistors"
                             Label="@L["Transistors"]"
                             Variant="Variant.Outlined"
                             Clearable="true"
                             Style="flex: 1;"/>
        </MudStack>

        <MudDivider Class="my-4"/>
        <MudText Typo="Typo.h6" Class="mb-2">@L["Registers"]</MudText>

        <MudStack Row="true" Spacing="2" Class="mb-4">
            <MudNumericField T="int?" @bind-Value="Gprs"
                             Label="@L["GPRs"]"
                             Variant="Variant.Outlined"
                             Clearable="true"
                             Style="flex: 1;"/>
            <MudNumericField T="int?" @bind-Value="GprSize"
                             Label="@L["GPR size (bits)"]"
                             Variant="Variant.Outlined"
                             Clearable="true"
                             Style="flex: 1;"/>
        </MudStack>

        <MudStack Row="true" Spacing="2" Class="mb-4">
            <MudNumericField T="int?" @bind-Value="Fprs"
                             Label="@L["FPRs"]"
                             Variant="Variant.Outlined"
                             Clearable="true"
                             Style="flex: 1;"/>
            <MudNumericField T="int?" @bind-Value="FprSize"
                             Label="@L["FPR size (bits)"]"
                             Variant="Variant.Outlined"
                             Clearable="true"
                             Style="flex: 1;"/>
        </MudStack>

        <MudStack Row="true" Spacing="2" Class="mb-4">
            <MudNumericField T="int?" @bind-Value="SimdRegisters"
                             Label="@L["SIMD registers"]"
                             Variant="Variant.Outlined"
                             Clearable="true"
                             Style="flex: 1;"/>
            <MudNumericField T="int?" @bind-Value="SimdSize"
                             Label="@L["SIMD size (bits)"]"
                             Variant="Variant.Outlined"
                             Clearable="true"
                             Style="flex: 1;"/>
        </MudStack>

        <MudDivider Class="my-4"/>
        <MudText Typo="Typo.h6" Class="mb-2">@L["Cache"]</MudText>

        <MudStack Row="true" Spacing="2" Class="mb-4">
            <MudNumericField T="float?" @bind-Value="L1Instruction"
                             Label="@L["L1 instruction (KiB)"]"
                             Variant="Variant.Outlined"
                             Clearable="true"
                             Style="flex: 1;"/>
            <MudNumericField T="float?" @bind-Value="L1Data"
                             Label="@L["L1 data (KiB)"]"
                             Variant="Variant.Outlined"
                             Clearable="true"
                             Style="flex: 1;"/>
        </MudStack>

        <MudStack Row="true" Spacing="2" Class="mb-4">
            <MudNumericField T="float?" @bind-Value="L2"
                             Label="@L["L2 (KiB)"]"
                             Variant="Variant.Outlined"
                             Clearable="true"
                             Style="flex: 1;"/>
            <MudNumericField T="float?" @bind-Value="L3"
                             Label="@L["L3 (KiB)"]"
                             Variant="Variant.Outlined"
                             Clearable="true"
                             Style="flex: 1;"/>
        </MudStack>

        @if(!string.IsNullOrWhiteSpace(_validationError))
        {
            <MudAlert Severity="Severity.Error" Class="mt-2">@_validationError</MudAlert>
        }

        @if(!IsNew)
        {
            <MudDivider Class="my-4"/>
            <MudText Typo="Typo.h6" Class="mb-2">@L["Instruction set extensions"]</MudText>

            @if(_processorExtensions is { Count: > 0 })
            {
                <MudList T="InstructionSetExtensionByProcessorDto" Dense="true">
                    @foreach(InstructionSetExtensionByProcessorDto ext in _processorExtensions)
                    {
                        <MudListItem T="InstructionSetExtensionByProcessorDto">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                <MudText>@(ext.Extensions ?? ext.ExtensionId?.ToString())</MudText>
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => RemoveExtension(ext)"/>
                            </MudStack>
                        </MudListItem>
                    }
                </MudList>
            }

            <MudPaper Class="pa-4 mt-2" Elevation="1">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudAutocomplete T="InstructionSetExtensionDto"
                                     Label="@L["Search Instruction Set Extension"]"
                                     @bind-Value="_selectedExtension"
                                     SearchFunc="SearchExtensions"
                                     ToStringFunc="@(e => e?.Extension ?? string.Empty)"
                                     Variant="Variant.Outlined"
                                     Clearable="true"
                                     Style="flex: 1;"/>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Small"
                               OnClick="AddExtension"
                               Disabled="@(_selectedExtension is null)">@L["Add Extension"]</MudButton>
                </MudStack>
            </MudPaper>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">@L["Save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    CompanyDto?                    _selectedCompany;
    InstructionSetExtensionDto?    _selectedExtension;
    string?                        _validationError;

    List<CompanyDto>?                            _allCompanies;
    List<InstructionSetDto>?                     _allInstructionSets;
    List<InstructionSetExtensionDto>?            _allExtensions;
    List<InstructionSetExtensionByProcessorDto>? _processorExtensions;

    [CascadingParameter]
    IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public bool      IsNew            { get; set; }
    [Parameter] public int       ProcessorId      { get; set; }
    [Parameter] public string    Name             { get; set; } = string.Empty;
    [Parameter] public int?      CompanyId        { get; set; }
    [Parameter] public string?   ModelCode        { get; set; }
    [Parameter] public DateTime? Introduced       { get; set; }
    [Parameter] public int       IntroducedPrecision { get; set; }
    [Parameter] public int?      InstructionSetId { get; set; }
    [Parameter] public double?   Speed            { get; set; }
    [Parameter] public string?   Package          { get; set; }
    [Parameter] public string?   Process          { get; set; }
    [Parameter] public float?    ProcessNm        { get; set; }
    [Parameter] public float?    DieSize          { get; set; }
    [Parameter] public long?     Transistors      { get; set; }
    [Parameter] public int?      Cores            { get; set; }
    [Parameter] public int?      ThreadsPerCore   { get; set; }
    [Parameter] public int?      DataBus          { get; set; }
    [Parameter] public int?      AddressBus       { get; set; }
    [Parameter] public int?      Gprs             { get; set; }
    [Parameter] public int?      GprSize          { get; set; }
    [Parameter] public int?      Fprs             { get; set; }
    [Parameter] public int?      FprSize          { get; set; }
    [Parameter] public int?      SimdRegisters    { get; set; }
    [Parameter] public int?      SimdSize         { get; set; }
    [Parameter] public float?    L1Instruction    { get; set; }
    [Parameter] public float?    L1Data           { get; set; }
    [Parameter] public float?    L2               { get; set; }
    [Parameter] public float?    L3               { get; set; }

    [Inject] ProcessorsService             ProcessorsService             { get; set; } = null!;
    [Inject] InstructionSetsService          InstructionSetsService          { get; set; } = null!;
    [Inject] InstructionSetExtensionsService InstructionSetExtensionsService { get; set; } = null!;
    [Inject] IDialogService                 DialogService                   { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        _allCompanies       = await ProcessorsService.GetCompaniesAsync();
        _allInstructionSets = await InstructionSetsService.GetAllAsync();
        _allExtensions      = await InstructionSetExtensionsService.GetAllAsync();

        if(CompanyId is not null && _allCompanies is not null)
            _selectedCompany = _allCompanies.Find(c => c.Id == CompanyId);

        if(!IsNew)
            _processorExtensions = await ProcessorsService.GetExtensionsByProcessorAsync(ProcessorId);
    }

    Task<IEnumerable<CompanyDto>> SearchCompanies(string? value, CancellationToken ct)
    {
        IEnumerable<CompanyDto> results = _allCompanies ?? [];

        if(!string.IsNullOrWhiteSpace(value))
            results = _allCompanies?.Where(c => c.Name?.Contains(value, StringComparison.OrdinalIgnoreCase) ?? false) ?? [];

        return Task.FromResult(results);
    }

    Task<IEnumerable<InstructionSetExtensionDto>> SearchExtensions(string? value, CancellationToken ct)
    {
        HashSet<int?> assignedIds = _processorExtensions?.Select(e => e.ExtensionId).ToHashSet() ?? [];

        IEnumerable<InstructionSetExtensionDto> available = (_allExtensions ?? []).Where(e => !assignedIds.Contains(e.Id));

        if(!string.IsNullOrWhiteSpace(value))
            available = available.Where(e => e.Extension?.Contains(value, StringComparison.OrdinalIgnoreCase) ?? false);

        return Task.FromResult(available);
    }

    async Task AddExtension()
    {
        if(_selectedExtension is null) return;

        var dto = new InstructionSetExtensionByProcessorDto
        {
            ProcessorId = ProcessorId,
            ExtensionId = _selectedExtension.Id
        };

        (long? id, string? error) = await ProcessorsService.AddExtensionToProcessorAsync(dto);

        if(id is not null)
        {
            _processorExtensions = await ProcessorsService.GetExtensionsByProcessorAsync(ProcessorId);
            _selectedExtension   = null;
            StateHasChanged();
        }
        else
        {
            _validationError = error ?? L["Failed to add extension."];
        }
    }

    async Task RemoveExtension(InstructionSetExtensionByProcessorDto ext)
    {
        if(ext.Id is null) return;

        DialogParameters<DeleteConfirmDialog> parameters = new()
        {
            {
                x => x.ContentText,
                string.Format(L["Are you sure you want to remove extension '{0}'? This action cannot be undone."],
                              ext.Extensions ?? ext.ExtensionId?.ToString())
            }
        };

        IDialogReference dialog = await DialogService.ShowAsync<DeleteConfirmDialog>(L["Remove Extension"], parameters,
                                                                                     new DialogOptions
                                                                                     {
                                                                                         MaxWidth  = MaxWidth.ExtraSmall,
                                                                                         FullWidth = true
                                                                                     });

        DialogResult? result = await dialog.Result;

        if(result is { Canceled: false })
        {
            (bool succeeded, string? error) = await ProcessorsService.RemoveExtensionFromProcessorAsync(ext.Id.Value);

            if(succeeded)
            {
                _processorExtensions = await ProcessorsService.GetExtensionsByProcessorAsync(ProcessorId);
                StateHasChanged();
            }
            else
            {
                _validationError = error ?? L["Failed to remove extension."];
            }
        }
    }

    void Cancel() => MudDialog.Cancel();

    void Submit()
    {
        if(string.IsNullOrWhiteSpace(Name))
        {
            _validationError = L["Name is required."];

            return;
        }

        MudDialog.Close(DialogResult.Ok(new ProcessorDialogResult
        {
            Name             = Name,
            CompanyId        = _selectedCompany?.Id,
            ModelCode        = ModelCode,
            Introduced       = Introduced,
            IntroducedPrecision = IntroducedPrecision,
            InstructionSetId = InstructionSetId,
            Speed            = Speed,
            Package          = Package,
            Process          = Process,
            ProcessNm        = ProcessNm,
            DieSize          = DieSize,
            Transistors      = Transistors,
            Cores            = Cores,
            ThreadsPerCore   = ThreadsPerCore,
            DataBus          = DataBus,
            AddressBus       = AddressBus,
            Gprs             = Gprs,
            GprSize          = GprSize,
            Fprs             = Fprs,
            FprSize          = FprSize,
            SimdRegisters    = SimdRegisters,
            SimdSize         = SimdSize,
            L1Instruction    = L1Instruction,
            L1Data           = L1Data,
            L2               = L2,
            L3               = L3
        }));
    }
}
