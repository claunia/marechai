@using Marechai.ApiClient.Models
@using Marechai.Services
@using Marechai.Helpers
@inject MachinesService MachinesService
@inject MachineFamiliesService MachineFamiliesService
@inject IStringLocalizer<MachinesService> L
@inject IJSRuntime JsRuntime

<style>
    .black-select-text .mud-input-slot,
    .black-select-text .mud-select-input,
    .black-select-text input,
    .black-select-text .mud-input {
        color: black !important;
    }
</style>

<MudDialog>
    <DialogContent>
        @if(!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="() => _errorMessage = null">@_errorMessage</MudAlert>
        }

        @switch(_state)
        {
            case ImportState.Upload:
                <MudStack Spacing="4">
                    <MudText Typo="Typo.body1">@L["Upload a CSV file to import machines in bulk. Download the template first to see the expected format."]</MudText>

                    <MudStack Row="true" Spacing="2">
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Download"
                                   OnClick="DownloadTemplate">
                            @L["Download Template"]
                        </MudButton>
                    </MudStack>

                    <MudFileUpload T="IBrowserFile"
                                   Accept=".csv"
                                   FilesChanged="OnCsvFileSelected"
                                   MaximumFileCount="1">
                        <ActivatorContent>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Upload"
                                       Disabled="_isProcessing">
                                @(_isProcessing ? L["Processing..."] : L["Upload CSV"])
                            </MudButton>
                        </ActivatorContent>
                    </MudFileUpload>

                    @if(_isProcessing)
                    {
                        <MudProgressLinear Indeterminate="true" Color="Color.Primary"/>
                    }
                </MudStack>
                break;

            case ImportState.Preview:
                <MudStack Spacing="3">
                    <MudAlert Severity="Severity.Info" Dense="true">
                        @string.Format(L["{0} rows parsed. {1} auto-rejected. Selected rows will be REJECTED — unselected rows will be imported."], _importRows.Count, _autoRejectedCount)
                    </MudAlert>

                    <div style="overflow-x: auto;">
                        <MudDataGrid T="MachineImportRow"
                                     Items="_importRows"
                                     MultiSelection="true"
                                     @bind-SelectedItems="_selectedItems"
                                     Dense="true"
                                     Hover="true"
                                     Striped="true"
                                     FixedHeader="true"
                                     Height="600px">
                            <Columns>
                                <SelectColumn T="MachineImportRow"/>

                                @* Name column with duplicate detection *@
                                <TemplateColumn Title="@L["Name"]">
                                    <CellTemplate>
                                        @{
                                            string nameBgColor = context.Item.DuplicateType switch
                                            {
                                                MachineNameDuplicateType.ExactDuplicate  => "#ffcdd2",
                                                MachineNameDuplicateType.SoundexDuplicate => "#ffe0b2",
                                                _                                        => ""
                                            };
                                        }
                                        <div style="@(string.IsNullOrEmpty(nameBgColor) ? "" : $"background-color: {nameBgColor}; color: black;") padding: 4px 8px; border-radius: 4px;">
                                            @if(context.Item.DuplicateType == MachineNameDuplicateType.ExactDuplicate)
                                            {
                                                <MudTooltip Text="@L["Exact duplicate — will be rejected"]">
                                                    <MudIcon Icon="@Icons.Material.Filled.Error" Size="Size.Small" Color="Color.Error" Class="mr-1"/>
                                                </MudTooltip>
                                            }
                                            else if(context.Item.DuplicateType == MachineNameDuplicateType.SoundexDuplicate)
                                            {
                                                <MudTooltip Text="@L["Possible duplicate (similar name)"]">
                                                    <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small" Color="Color.Warning" Class="mr-1"/>
                                                </MudTooltip>
                                            }
                                            @context.Item.Name
                                            @if(context.Item.DuplicateType == MachineNameDuplicateType.ExactDuplicate)
                                            {
                                                <br/>
                                                <MudText Typo="Typo.caption" Style="color: #b71c1c;">@string.Format(L["Exact duplicate of \"{0}\""], context.Item.DuplicateMatchedName)</MudText>
                                            }
                                            else if(context.Item.DuplicateType == MachineNameDuplicateType.SoundexDuplicate)
                                            {
                                                <br/>
                                                <MudText Typo="Typo.caption" Style="color: #e65100;">@string.Format(L["Similar to: {0}"], context.Item.DuplicateMatchedName)</MudText>
                                            }
                                            @if(context.Item.ValidationError is not null)
                                            {
                                                <MudTooltip Text="@context.Item.ValidationError">
                                                    <MudIcon Icon="@Icons.Material.Filled.Error" Size="Size.Small" Color="Color.Error" Class="ml-1"/>
                                                </MudTooltip>
                                            }
                                        </div>
                                    </CellTemplate>
                                </TemplateColumn>

                                @* Company column *@
                                <TemplateColumn Title="@L["Company"]">
                                    <CellTemplate>
                                        @{
                                            string companyBgColor = context.Item.CompanyMatch switch
                                            {
                                                CompanyMatchType.Exact   => "#c8e6c9",
                                                CompanyMatchType.Partial => "#fff9c4",
                                                _                       => "#ffcdd2"
                                            };
                                        }
                                        <div style="background-color: @companyBgColor; color: black; padding: 4px 8px; border-radius: 4px;">
                                            @if(context.Item.CompanyMatch == CompanyMatchType.Partial && context.Item.MatchedCompanies.Count > 1)
                                            {
                                                <MudSelect T="CompanyDto"
                                                           Value="context.Item.SelectedCompany"
                                                           ValueChanged="(c) => context.Item.SelectedCompany = c"
                                                           Dense="true"
                                                           Margin="Margin.Dense"
                                                           Variant="Variant.Text"
                                                           ToStringFunc="@(c => c?.Name ?? "")">
                                                    @foreach(CompanyDto company in context.Item.MatchedCompanies)
                                                    {
                                                        <MudSelectItem T="CompanyDto" Value="company">@company.Name</MudSelectItem>
                                                    }
                                                </MudSelect>
                                            }
                                            else
                                            {
                                                @context.Item.CompanyDisplay
                                            }
                                        </div>
                                    </CellTemplate>
                                </TemplateColumn>

                                @* Type column *@
                                <TemplateColumn Title="@L["Type"]">
                                    <CellTemplate>
                                        @if(!string.IsNullOrWhiteSpace(context.Item.TypeInput))
                                        {
                                            string typeBgColor = context.Item.TypeMatch switch
                                            {
                                                MachineTypeMatchType.Exact   => "#c8e6c9",
                                                MachineTypeMatchType.Partial => "#fff9c4",
                                                _                           => "#ffcdd2"
                                            };
                                            <div style="background-color: @typeBgColor; color: black; padding: 4px 8px; border-radius: 4px;">
                                                @context.Item.TypeDisplay
                                            </div>
                                        }
                                    </CellTemplate>
                                </TemplateColumn>

                                <PropertyColumn Property="x => x.Model" Title="@L["Model"]"/>

                                @* Family column *@
                                <TemplateColumn Title="@L["Family"]" CellStyle="min-width: 300px;">
                                    <CellTemplate>
                                        @if(!string.IsNullOrWhiteSpace(context.Item.FamilyInput))
                                        {
                                            string familyBgColor = context.Item.FamilyMatch switch
                                            {
                                                MachineFamilyMatchType.Exact   => "#c8e6c9",
                                                MachineFamilyMatchType.Partial => "#fff9c4",
                                                MachineFamilyMatchType.New     => "#bbdefb",
                                                _                             => "#ffcdd2"
                                            };
                                            <div style="background-color: @familyBgColor; color: black; padding: 4px 8px; border-radius: 4px;">
                                                @if(context.Item.FamilyMatch is MachineFamilyMatchType.New or MachineFamilyMatchType.Partial && context.Item.MatchedFamilies.Count > 0)
                                                {
                                                    <MudSelect T="MachineFamilyDto"
                                                               Value="context.Item.SelectedFamily"
                                                               ValueChanged="(f) => OnFamilySelected(context.Item, f)"
                                                               Dense="true"
                                                               Margin="Margin.Dense"
                                                               Variant="Variant.Text"
                                                               Class="black-select-text"
                                                               ToStringFunc="@(f => f == CreateNewFamilySentinel ? $"➕ Create new: {context.Item.FamilyInput}" : f?.Name ?? "")">
                                                        <MudSelectItem T="MachineFamilyDto" Value="CreateNewFamilySentinel">@($"➕ Create new: {context.Item.FamilyInput}")</MudSelectItem>
                                                        @foreach(MachineFamilyDto family in context.Item.MatchedFamilies)
                                                        {
                                                            <MudSelectItem T="MachineFamilyDto" Value="family">@family.Name</MudSelectItem>
                                                        }
                                                    </MudSelect>
                                                }
                                                else if(context.Item.FamilyMatch == MachineFamilyMatchType.New)
                                                {
                                                    @($"➕ {context.Item.FamilyInput}")
                                                }
                                                else
                                                {
                                                    @context.Item.FamilyDisplay
                                                }
                                            </div>
                                        }
                                    </CellTemplate>
                                </TemplateColumn>

                                @* Introduced column *@
                                <TemplateColumn Title="@L["Introduced"]">
                                    <CellTemplate>
                                        @if(context.Item.IsPrototype)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Warning"
                                                     Style="white-space: normal; height: auto; overflow: visible; text-overflow: unset; padding: 2px 8px; font-size: 0.7rem;">
                                                @L["Prototype"]
                                            </MudChip>
                                        }
                                        else if(context.Item.IntroducedYear is not null)
                                        {
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                                <MudText Typo="Typo.body2">@FormatImportDate(context.Item)</MudText>
                                                <MudChip T="string" Size="Size.Small"
                                                         Color="@(context.Item.IntroducedPrecision == 0 ? Color.Success : context.Item.IntroducedPrecision == 1 ? Color.Warning : Color.Info)"
                                                         Style="white-space: normal; height: auto; overflow: visible; text-overflow: unset; padding: 2px 8px; font-size: 0.7rem;">
                                                    @(context.Item.IntroducedPrecision switch
                                                    {
                                                        0 => L["Full date"],
                                                        1 => L["Month and year only"],
                                                        2 => L["Year only"],
                                                        _ => ""
                                                    })
                                                </MudChip>
                                            </MudStack>
                                        }
                                    </CellTemplate>
                                </TemplateColumn>

                                @* GPU column *@
                                <TemplateColumn Title="@L["GPU"]">
                                    <CellTemplate>
                                        @if(!string.IsNullOrWhiteSpace(context.Item.GpuInput))
                                        {
                                            string gpuBgColor = context.Item.GpuMatch switch
                                            {
                                                GpuMatchType.Exact   => "#c8e6c9",
                                                GpuMatchType.Partial => "#fff9c4",
                                                _                    => "#ffcdd2"
                                            };
                                            <div style="background-color: @gpuBgColor; color: black; padding: 4px 8px; border-radius: 4px;">
                                                @if(context.Item.GpuMatch == GpuMatchType.Partial && context.Item.MatchedGpus.Count > 1)
                                                {
                                                    <MudSelect T="GpuDto"
                                                               Value="context.Item.SelectedGpu"
                                                               ValueChanged="(g) => context.Item.SelectedGpu = g"
                                                               Dense="true"
                                                               Margin="Margin.Dense"
                                                               Variant="Variant.Text"
                                                               ToStringFunc="@(g => g?.Name ?? "")">
                                                        @foreach(GpuDto gpu in context.Item.MatchedGpus)
                                                        {
                                                            <MudSelectItem T="GpuDto" Value="gpu">@gpu.Name</MudSelectItem>
                                                        }
                                                    </MudSelect>
                                                }
                                                else
                                                {
                                                    @context.Item.GpuDisplay
                                                }
                                            </div>
                                        }
                                    </CellTemplate>
                                </TemplateColumn>

                                @* Processor column *@
                                <TemplateColumn Title="@L["Processor"]">
                                    <CellTemplate>
                                        @if(!string.IsNullOrWhiteSpace(context.Item.ProcessorInput))
                                        {
                                            string procBgColor = context.Item.ProcessorMatch switch
                                            {
                                                ProcessorMatchType.Exact   => "#c8e6c9",
                                                ProcessorMatchType.Partial => "#fff9c4",
                                                _                         => "#ffcdd2"
                                            };
                                            <div style="background-color: @procBgColor; color: black; padding: 4px 8px; border-radius: 4px;">
                                                @if(context.Item.ProcessorMatch == ProcessorMatchType.Partial && context.Item.MatchedProcessors.Count > 1)
                                                {
                                                    <MudSelect T="ProcessorDto"
                                                               Value="context.Item.SelectedProcessor"
                                                               ValueChanged="(p) => context.Item.SelectedProcessor = p"
                                                               Dense="true"
                                                               Margin="Margin.Dense"
                                                               Variant="Variant.Text"
                                                               ToStringFunc="@(p => p?.Name ?? "")">
                                                        @foreach(ProcessorDto proc in context.Item.MatchedProcessors)
                                                        {
                                                            <MudSelectItem T="ProcessorDto" Value="proc">@proc.Name</MudSelectItem>
                                                        }
                                                    </MudSelect>
                                                }
                                                else
                                                {
                                                    @context.Item.ProcessorDisplay
                                                }
                                            </div>
                                        }
                                    </CellTemplate>
                                </TemplateColumn>

                                @* Processor speed column *@
                                <TemplateColumn Title="@L["CPU Speed"]">
                                    <CellTemplate>
                                        @(context.Item.ProcessorSpeed?.ToString("F1") ?? "")
                                    </CellTemplate>
                                </TemplateColumn>

                                @* Sound synth column *@
                                <TemplateColumn Title="@L["Sound synth"]">
                                    <CellTemplate>
                                        @if(!string.IsNullOrWhiteSpace(context.Item.SoundSynthInput))
                                        {
                                            string sndBgColor = context.Item.SoundSynthMatch switch
                                            {
                                                SoundSynthMatchType.Exact   => "#c8e6c9",
                                                SoundSynthMatchType.Partial => "#fff9c4",
                                                _                          => "#ffcdd2"
                                            };
                                            <div style="background-color: @sndBgColor; color: black; padding: 4px 8px; border-radius: 4px;">
                                                @if(context.Item.SoundSynthMatch == SoundSynthMatchType.Partial && context.Item.MatchedSoundSynths.Count > 1)
                                                {
                                                    <MudSelect T="SoundSynthDto"
                                                               Value="context.Item.SelectedSoundSynth"
                                                               ValueChanged="(s) => context.Item.SelectedSoundSynth = s"
                                                               Dense="true"
                                                               Margin="Margin.Dense"
                                                               Variant="Variant.Text"
                                                               ToStringFunc="@(s => s?.Name ?? "")">
                                                        @foreach(SoundSynthDto synth in context.Item.MatchedSoundSynths)
                                                        {
                                                            <MudSelectItem T="SoundSynthDto" Value="synth">@synth.Name</MudSelectItem>
                                                        }
                                                    </MudSelect>
                                                }
                                                else
                                                {
                                                    @context.Item.SoundSynthDisplay
                                                }
                                            </div>
                                        }
                                    </CellTemplate>
                                </TemplateColumn>

                                @* Software platform column *@
                                <TemplateColumn Title="@L["Software platform"]">
                                    <CellTemplate>
                                        @if(!string.IsNullOrWhiteSpace(context.Item.SoftwarePlatformInput))
                                        {
                                            string platBgColor = context.Item.SoftwarePlatformMatch switch
                                            {
                                                SoftwarePlatformMatchType.Exact   => "#c8e6c9",
                                                SoftwarePlatformMatchType.Partial => "#fff9c4",
                                                _                                => "#ffcdd2"
                                            };
                                            <div style="background-color: @platBgColor; color: black; padding: 4px 8px; border-radius: 4px;">
                                                @if(context.Item.SoftwarePlatformMatch == SoftwarePlatformMatchType.Partial && context.Item.MatchedSoftwarePlatforms.Count > 1)
                                                {
                                                    <MudSelect T="SoftwarePlatformDto"
                                                               Value="context.Item.SelectedSoftwarePlatform"
                                                               ValueChanged="(sp) => context.Item.SelectedSoftwarePlatform = sp"
                                                               Dense="true"
                                                               Margin="Margin.Dense"
                                                               Variant="Variant.Text"
                                                               ToStringFunc="@(sp => sp?.Name ?? "")">
                                                        @foreach(SoftwarePlatformDto plat in context.Item.MatchedSoftwarePlatforms)
                                                        {
                                                            <MudSelectItem T="SoftwarePlatformDto" Value="plat">@plat.Name</MudSelectItem>
                                                        }
                                                    </MudSelect>
                                                }
                                                else
                                                {
                                                    @context.Item.SoftwarePlatformDisplay
                                                }
                                            </div>
                                        }
                                    </CellTemplate>
                                </TemplateColumn>

                                @* Memory columns (condensed) *@
                                <TemplateColumn Title="@L["Work memory"]">
                                    <CellTemplate>
                                        @if(context.Item.HasWorkMemory)
                                        {
                                            <div style="@(!context.Item.WorkMemoryTypeValid ? "background-color: #ffcdd2; color: black; " : "")padding: 4px 8px; border-radius: 4px;"
                                                 title="@($"Type: {context.Item.WorkMemoryTypeInput ?? "Unknown"}, Size: {context.Item.WorkMemorySize?.ToString() ?? "—"}, Speed: {context.Item.WorkMemorySpeed?.ToString("F1") ?? "—"}")">
                                                @(context.Item.WorkMemoryTypeInput ?? "Unknown") / @(context.Item.WorkMemorySize?.ToString() ?? "—")
                                            </div>
                                        }
                                    </CellTemplate>
                                </TemplateColumn>

                                <TemplateColumn Title="@L["Video memory"]">
                                    <CellTemplate>
                                        @if(context.Item.HasVideoMemory)
                                        {
                                            <div style="@(!context.Item.VideoMemoryTypeValid ? "background-color: #ffcdd2; color: black; " : "")padding: 4px 8px; border-radius: 4px;"
                                                 title="@($"Type: {context.Item.VideoMemoryTypeInput ?? "Unknown"}, Size: {context.Item.VideoMemorySize?.ToString() ?? "—"}, Speed: {context.Item.VideoMemorySpeed?.ToString("F1") ?? "—"}")">
                                                @(context.Item.VideoMemoryTypeInput ?? "Unknown") / @(context.Item.VideoMemorySize?.ToString() ?? "—")
                                            </div>
                                        }
                                    </CellTemplate>
                                </TemplateColumn>

                                <TemplateColumn Title="@L["Sound memory"]">
                                    <CellTemplate>
                                        @if(context.Item.HasSoundMemory)
                                        {
                                            <div style="@(!context.Item.SoundMemoryTypeValid ? "background-color: #ffcdd2; color: black; " : "")padding: 4px 8px; border-radius: 4px;"
                                                 title="@($"Type: {context.Item.SoundMemoryTypeInput ?? "Unknown"}, Size: {context.Item.SoundMemorySize?.ToString() ?? "—"}, Speed: {context.Item.SoundMemorySpeed?.ToString("F1") ?? "—"}")">
                                                @(context.Item.SoundMemoryTypeInput ?? "Unknown") / @(context.Item.SoundMemorySize?.ToString() ?? "—")
                                            </div>
                                        }
                                    </CellTemplate>
                                </TemplateColumn>

                                <TemplateColumn Title="@L["Unified memory"]">
                                    <CellTemplate>
                                        @if(context.Item.HasUnifiedMemory)
                                        {
                                            <div style="@(!context.Item.UnifiedMemoryTypeValid ? "background-color: #ffcdd2; color: black; " : "")padding: 4px 8px; border-radius: 4px;"
                                                 title="@($"Type: {context.Item.UnifiedMemoryTypeInput ?? "Unknown"}, Size: {context.Item.UnifiedMemorySize?.ToString() ?? "—"}, Speed: {context.Item.UnifiedMemorySpeed?.ToString("F1") ?? "—"}")">
                                                @(context.Item.UnifiedMemoryTypeInput ?? "Unknown") / @(context.Item.UnifiedMemorySize?.ToString() ?? "—")
                                            </div>
                                        }
                                    </CellTemplate>
                                </TemplateColumn>

                                <TemplateColumn Title="@L["Firmware memory"]">
                                    <CellTemplate>
                                        @if(context.Item.HasFirmwareMemory)
                                        {
                                            <div style="@(!context.Item.FirmwareMemoryTypeValid ? "background-color: #ffcdd2; color: black; " : "")padding: 4px 8px; border-radius: 4px;"
                                                 title="@($"Type: {context.Item.FirmwareMemoryTypeInput ?? "Unknown"}, Size: {context.Item.FirmwareMemorySize?.ToString() ?? "—"}, Speed: {context.Item.FirmwareMemorySpeed?.ToString("F1") ?? "—"}")">
                                                @(context.Item.FirmwareMemoryTypeInput ?? "Unknown") / @(context.Item.FirmwareMemorySize?.ToString() ?? "—")
                                            </div>
                                        }
                                    </CellTemplate>
                                </TemplateColumn>
                            </Columns>
                        </MudDataGrid>
                    </div>
                </MudStack>
                break;

            case ImportState.Importing:
                <MudStack Spacing="3">
                    <MudText Typo="Typo.body1">@string.Format(L["Importing {0} of {1}..."], _importedCount + _failedCount, _totalToImport)</MudText>
                    <MudProgressLinear Value="_progressPercent" Color="Color.Primary" Rounded="true" Size="Size.Large">
                        <ChildContent>
                            <MudText Typo="Typo.body2" Style="color: white;">
                                @($"{_progressPercent:F0}%")
                            </MudText>
                        </ChildContent>
                    </MudProgressLinear>

                    @if(_importRows.Count > 0)
                    {
                        <MudDataGrid T="MachineImportRow"
                                     Items="_importRows"
                                     Dense="true"
                                     Hover="true"
                                     FixedHeader="true"
                                     Height="500px">
                            <Columns>
                                <TemplateColumn Title="@L["Name"]">
                                    <CellTemplate>
                                        @context.Item.Name
                                        @if(context.Item.ImportError is not null)
                                        {
                                            <MudTooltip Text="@context.Item.ImportError"><MudIcon Icon="@Icons.Material.Filled.Error" Size="Size.Small" Color="Color.Error" Class="ml-1"/></MudTooltip>
                                        }
                                    </CellTemplate>
                                </TemplateColumn>
                                <TemplateColumn Title="@L["Company"]">
                                    <CellTemplate>
                                        @context.Item.CompanyDisplay
                                    </CellTemplate>
                                </TemplateColumn>
                                <TemplateColumn Title="@L["Type"]">
                                    <CellTemplate>
                                        @context.Item.TypeDisplay
                                    </CellTemplate>
                                </TemplateColumn>
                            </Columns>
                        </MudDataGrid>
                    }
                </MudStack>
                break;

            case ImportState.Complete:
                <MudStack Spacing="3">
                    <MudAlert Severity="Severity.Success" Dense="true">
                        @string.Format(L["Import complete. {0} imported, {1} rejected, {2} failed."], _importedCount, _rejectedCount, _failedCount)
                    </MudAlert>

                    @if(_importRows.Count > 0)
                    {
                        <MudText Typo="Typo.body2">@L["The following items were not imported:"]</MudText>

                        <MudDataGrid T="MachineImportRow"
                                     Items="_importRows"
                                     Dense="true"
                                     Hover="true"
                                     FixedHeader="true"
                                     Height="500px">
                            <Columns>
                                <PropertyColumn Property="x => x.Name" Title="@L["Name"]"/>
                                <TemplateColumn Title="@L["Company"]">
                                    <CellTemplate>
                                        @(context.Item.CompanyInput ?? "")
                                    </CellTemplate>
                                </TemplateColumn>
                                <TemplateColumn Title="@L["Type"]">
                                    <CellTemplate>
                                        @(context.Item.TypeInput ?? "")
                                    </CellTemplate>
                                </TemplateColumn>
                                <TemplateColumn Title="@L["Status"]">
                                    <CellTemplate>
                                        @if(context.Item.ImportError is not null)
                                        {
                                            <MudChip T="string" Color="Color.Error" Size="Size.Small"
                                                     Style="white-space: normal; height: auto; overflow: visible; text-overflow: unset; padding: 8px 16px;">
                                                @context.Item.ImportError
                                            </MudChip>
                                        }
                                        else if(context.Item.ValidationError is not null)
                                        {
                                            <MudChip T="string" Color="Color.Warning" Size="Size.Small"
                                                     Style="white-space: normal; height: auto; overflow: visible; text-overflow: unset; padding: 8px 16px;">
                                                @context.Item.ValidationError
                                            </MudChip>
                                        }
                                        else
                                        {
                                            <MudChip T="string" Color="Color.Default" Size="Size.Small">@L["Rejected"]</MudChip>
                                        }
                                    </CellTemplate>
                                </TemplateColumn>
                            </Columns>
                        </MudDataGrid>

                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Download"
                                   OnClick="DownloadRejected">
                            @L["Download Rejected"]
                        </MudButton>
                    }
                </MudStack>
                break;
        }
    </DialogContent>
    <DialogActions>
        @switch(_state)
        {
            case ImportState.Upload:
                <MudButton OnClick="Cancel">@L["Cancel"]</MudButton>
                break;
            case ImportState.Preview:
                <MudButton OnClick="Cancel">@L["Cancel"]</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="StartImport"
                           Disabled="_importRows.All(r => _selectedItems.Contains(r))">
                    @L["Import"]
                </MudButton>
                break;
            case ImportState.Importing:
                break;
            case ImportState.Complete:
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Close">@L["Close"]</MudButton>
                break;
        }
    </DialogActions>
</MudDialog>

@code {
    static readonly string[] CsvHeaders =
    [
        "Name", "Company", "Type", "Model", "Family",
        "IntroducedYear", "IntroducedMonth", "IntroducedDay",
        "Gpu", "Processor", "ProcessorSpeed", "SoundSynth", "SoftwarePlatform",
        "WorkMemoryType", "WorkMemorySize", "WorkMemorySpeed",
        "VideoMemoryType", "VideoMemorySize", "VideoMemorySpeed",
        "SoundMemoryType", "SoundMemorySize", "SoundMemorySpeed",
        "UnifiedMemoryType", "UnifiedMemorySize", "UnifiedMemorySpeed",
        "FirmwareMemoryType", "FirmwareMemorySize", "FirmwareMemorySpeed"
    ];

    // Machine type words for Soundex matching
    static readonly Dictionary<string, int> TypeWords = new(StringComparer.OrdinalIgnoreCase)
    {
        { "Computer", 1 },
        { "Console", 2 },
        { "Smartphone", 3 }
    };

    // MemoryType enum names for case-insensitive matching
    static readonly string[] MemoryTypeNames = Enum.GetNames<Marechai.Data.MemoryType>();

    // Sentinel MachineFamilyDto used in dropdown to represent "Create new family"
    static readonly MachineFamilyDto CreateNewFamilySentinel = new() { Id = -1, Name = "➕ Create new" };

