    async Task DownloadTemplate()
    {
        string csv    = CsvParser.GenerateTemplate(CsvHeaders);
        byte[] bytes  = System.Text.Encoding.UTF8.GetBytes(csv);
        string base64 = Convert.ToBase64String(bytes);

        await JsRuntime.InvokeVoidAsync("downloadFileFromBytes", "machine_import_template.csv", "text/csv", base64);
    }

    async Task OnCsvFileSelected(IBrowserFile file)
    {
        if(file is null) return;

        _isProcessing = true;
        _errorMessage = null;
        StateHasChanged();

        try
        {
            using var stream = file.OpenReadStream(10 * 1024 * 1024);
            using var reader = new System.IO.StreamReader(stream);
            string csvContent = await reader.ReadToEndAsync();

            List<Dictionary<string, string>> rows = CsvParser.Parse(csvContent);

            if(rows.Count == 0)
            {
                _errorMessage = L["The CSV file is empty or has no data rows."];
                _isProcessing = false;
                StateHasChanged();

                return;
            }

            // Pre-fetch all reference data
            _allCompanies         = await MachinesService.GetCompaniesAsync();
            _allFamilies          = await MachinesService.GetFamiliesAsync();
            _allGpus              = await MachinesService.GetAllGpusAsync();
            _allProcessors        = await MachinesService.GetAllProcessorsAsync();
            _allSoundSynths       = await MachinesService.GetAllSoundSynthsAsync();
            _allSoftwarePlatforms = await MachinesService.GetAllSoftwarePlatformsAsync();
            _existingMachines     = await MachinesService.GetAllAsync();

            BuildTypeSoundexMap();
            _importRows = ParseRows(rows);
            PreSelectRejections();

            _state = ImportState.Preview;
        }
        catch(Exception ex)
        {
            _errorMessage = string.Format(L["Error reading CSV: {0}"], ex.Message);
        }
        finally
        {
            _isProcessing = false;
            StateHasChanged();
        }
    }

    void BuildTypeSoundexMap()
    {
        // Type matching still uses Soundex — only 3 fixed words, Jaro-Winkler not needed
        _typeSoundexMap = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);

        foreach(KeyValuePair<string, int> kvp in TypeWords)
        {
            string code = Soundex.Generate(kvp.Key);
            _typeSoundexMap.TryAdd(code, kvp.Value);
        }
    }

    List<MachineImportRow> ParseRows(List<Dictionary<string, string>> rows)
    {
        var result = new List<MachineImportRow>();

        foreach(Dictionary<string, string> row in rows)
        {
            var importRow = new MachineImportRow
            {
                Name                    = GetValue(row, "Name"),
                CompanyInput            = GetValueOrNull(row, "Company"),
                TypeInput               = GetValueOrNull(row, "Type"),
                Model                   = GetValueOrNull(row, "Model"),
                FamilyInput             = GetValueOrNull(row, "Family"),
                GpuInput                = GetValueOrNull(row, "Gpu"),
                ProcessorInput          = GetValueOrNull(row, "Processor"),
                SoundSynthInput         = GetValueOrNull(row, "SoundSynth"),
                SoftwarePlatformInput   = GetValueOrNull(row, "SoftwarePlatform"),
                WorkMemoryTypeInput     = GetValueOrNull(row, "WorkMemoryType"),
                VideoMemoryTypeInput    = GetValueOrNull(row, "VideoMemoryType"),
                SoundMemoryTypeInput    = GetValueOrNull(row, "SoundMemoryType"),
                UnifiedMemoryTypeInput  = GetValueOrNull(row, "UnifiedMemoryType"),
                FirmwareMemoryTypeInput = GetValueOrNull(row, "FirmwareMemoryType")
            };

            // Parse numeric fields
            if(TryParseInt(row, "IntroducedYear", out int year))
                importRow.IntroducedYear = year;

            if(TryParseInt(row, "IntroducedMonth", out int month))
                importRow.IntroducedMonth = month;

            if(TryParseInt(row, "IntroducedDay", out int day))
                importRow.IntroducedDay = day;

            if(TryParseDouble(row, "ProcessorSpeed", out double procSpeed))
                importRow.ProcessorSpeed = procSpeed;

            if(TryParseLong(row, "WorkMemorySize", out long workMemSize))
                importRow.WorkMemorySize = workMemSize;

            if(TryParseDouble(row, "WorkMemorySpeed", out double workMemSpeed))
                importRow.WorkMemorySpeed = workMemSpeed;

            if(TryParseLong(row, "VideoMemorySize", out long videoMemSize))
                importRow.VideoMemorySize = videoMemSize;

            if(TryParseDouble(row, "VideoMemorySpeed", out double videoMemSpeed))
                importRow.VideoMemorySpeed = videoMemSpeed;

            if(TryParseLong(row, "SoundMemorySize", out long soundMemSize))
                importRow.SoundMemorySize = soundMemSize;

            if(TryParseDouble(row, "SoundMemorySpeed", out double soundMemSpeed))
                importRow.SoundMemorySpeed = soundMemSpeed;

            if(TryParseLong(row, "UnifiedMemorySize", out long unifiedMemSize))
                importRow.UnifiedMemorySize = unifiedMemSize;

            if(TryParseDouble(row, "UnifiedMemorySpeed", out double unifiedMemSpeed))
                importRow.UnifiedMemorySpeed = unifiedMemSpeed;

            if(TryParseLong(row, "FirmwareMemorySize", out long firmwareMemSize))
                importRow.FirmwareMemorySize = firmwareMemSize;

            if(TryParseDouble(row, "FirmwareMemorySpeed", out double firmwareMemSpeed))
                importRow.FirmwareMemorySpeed = firmwareMemSpeed;

            // Validate required fields
            if(string.IsNullOrWhiteSpace(importRow.Name))
                importRow.ValidationError = L["Name is required."];
            else if(string.IsNullOrWhiteSpace(importRow.CompanyInput))
                importRow.ValidationError = L["Company is required."];
            else if(string.IsNullOrWhiteSpace(importRow.TypeInput))
                importRow.ValidationError = L["Type is required."];

            // Match entities
            MatchCompany(importRow);
            MatchType(importRow);
            MatchFamily(importRow);
            MatchGpu(importRow);
            MatchProcessor(importRow);
            MatchSoundSynth(importRow);
            MatchSoftwarePlatform(importRow);

            // Validate memory types
            ValidateMemoryType(importRow.WorkMemoryTypeInput, out bool workValid, out int workTypeVal);
            importRow.WorkMemoryTypeValid = workValid;
            importRow.WorkMemoryTypeValue = workTypeVal;

            ValidateMemoryType(importRow.VideoMemoryTypeInput, out bool videoValid, out int videoTypeVal);
            importRow.VideoMemoryTypeValid = videoValid;
            importRow.VideoMemoryTypeValue = videoTypeVal;

            ValidateMemoryType(importRow.SoundMemoryTypeInput, out bool soundValid, out int soundTypeVal);
            importRow.SoundMemoryTypeValid = soundValid;
            importRow.SoundMemoryTypeValue = soundTypeVal;

            ValidateMemoryType(importRow.UnifiedMemoryTypeInput, out bool unifiedValid, out int unifiedTypeVal);
            importRow.UnifiedMemoryTypeValid = unifiedValid;
            importRow.UnifiedMemoryTypeValue = unifiedTypeVal;

            ValidateMemoryType(importRow.FirmwareMemoryTypeInput, out bool firmwareValid, out int firmwareTypeVal);
            importRow.FirmwareMemoryTypeValid = firmwareValid;
            importRow.FirmwareMemoryTypeValue = firmwareTypeVal;

            // Check duplicates against existing machines
            CheckDuplicate(importRow);

            result.Add(importRow);
        }

        return result;
    }

    void MatchCompany(MachineImportRow row)
    {
        if(string.IsNullOrWhiteSpace(row.CompanyInput))
        {
            row.CompanyMatch = CompanyMatchType.None;

            return;
        }

        if(_allCompanies is null)
        {
            row.CompanyMatch = CompanyMatchType.None;

            return;
        }

        CompanyDto exact = _allCompanies.Find(c =>
            string.Equals(c.Name, row.CompanyInput, StringComparison.OrdinalIgnoreCase));

        if(exact is not null)
        {
            row.CompanyMatch     = CompanyMatchType.Exact;
            row.MatchedCompanies = [exact];
            row.SelectedCompany  = exact;

            return;
        }

        // Jaro-Winkler fuzzy match
        var jwMatches = JaroWinkler.FindMatches(row.CompanyInput, _allCompanies, c => c.Name, 0.85);

        if(jwMatches.Count > 0)
        {
            row.CompanyMatch     = CompanyMatchType.Partial;
            row.MatchedCompanies = [..jwMatches.Select(m => m.item)];
            row.SelectedCompany  = row.MatchedCompanies[0];

            return;
        }

        row.CompanyMatch = CompanyMatchType.None;
    }

    void MatchType(MachineImportRow row)
    {
        if(string.IsNullOrWhiteSpace(row.TypeInput))
        {
            row.TypeMatch = MachineTypeMatchType.None;

            return;
        }

        // Try exact match first
        foreach(KeyValuePair<string, int> kvp in TypeWords)
        {
            if(string.Equals(kvp.Key, row.TypeInput, StringComparison.OrdinalIgnoreCase))
            {
                row.TypeMatch   = MachineTypeMatchType.Exact;
                row.MatchedType = kvp.Value;

                return;
            }
        }

        // Try Soundex match
        string inputSoundex = Soundex.Generate(row.TypeInput);

        if(_typeSoundexMap is not null &&
           _typeSoundexMap.TryGetValue(inputSoundex, out int typeValue))
        {
            row.TypeMatch   = MachineTypeMatchType.Partial;
            row.MatchedType = typeValue;

            return;
        }

        row.TypeMatch = MachineTypeMatchType.None;
    }

    void MatchFamily(MachineImportRow row)
    {
        if(string.IsNullOrWhiteSpace(row.FamilyInput))
        {
            row.FamilyMatch = MachineFamilyMatchType.None;

            return;
        }

        if(_allFamilies is null)
        {
            row.FamilyMatch = MachineFamilyMatchType.None;

            return;
        }

        MachineFamilyDto exact = _allFamilies.Find(f =>
            string.Equals(f.Name, row.FamilyInput, StringComparison.OrdinalIgnoreCase));

        if(exact is not null)
        {
            row.FamilyMatch     = MachineFamilyMatchType.Exact;
            row.MatchedFamilies = [exact];
            row.SelectedFamily  = exact;

            return;
        }

        // Jaro-Winkler fuzzy match
        var jwMatches = JaroWinkler.FindMatches(row.FamilyInput, _allFamilies, f => f.Name, 0.85);

        if(jwMatches.Count > 0)
        {
            // Default to "Create new" but keep JW matches available in dropdown
            row.FamilyMatch     = MachineFamilyMatchType.New;
            row.MatchedFamilies = [..jwMatches.Select(m => m.item)];
            row.SelectedFamily  = CreateNewFamilySentinel;

            return;
        }

        row.FamilyMatch = MachineFamilyMatchType.New;
    }

