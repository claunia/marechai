        // Contains match (handles e.g. "framebuffer" matching "DB_FRAMEBUFFER")
        var containsMatches = _allGpus.Where(g =>
            g.Name is not null &&
            (g.Name.Contains(row.GpuInput, StringComparison.OrdinalIgnoreCase) ||
             row.GpuInput.Contains(g.Name, StringComparison.OrdinalIgnoreCase))).ToList();

        if(containsMatches.Count > 0)
        {
            row.GpuMatch    = GpuMatchType.Partial;
            row.MatchedGpus = [..containsMatches.OrderBy(g => g.Name)];
            row.SelectedGpu = row.MatchedGpus[0];

            return;
