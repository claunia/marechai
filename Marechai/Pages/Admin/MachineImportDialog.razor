    static void ValidateMemoryType(string input, out bool valid, out int typeValue)
    {
        typeValue = 0; // Unknown

        if(string.IsNullOrWhiteSpace(input))
        {
            valid = true; // Empty = Unknown, valid

            return;
        }

        if(Enum.TryParse<Marechai.Data.MemoryType>(input, true, out Marechai.Data.MemoryType parsed))
        {
            valid     = true;
            typeValue = (int)parsed;

            return;
        }

        valid = false;
    }

    void CheckDuplicate(MachineImportRow row)
    {
        if(string.IsNullOrWhiteSpace(row.Name) || _existingMachines is null)
        {
            row.DuplicateType = MachineNameDuplicateType.None;

            return;
        }

        // Check exact duplicate
        MachineDto exactMatch = _existingMachines.Find(m => string.Equals(m.Name, row.Name, StringComparison.OrdinalIgnoreCase));

        if(exactMatch is not null)
        {
            row.DuplicateType       = MachineNameDuplicateType.ExactDuplicate;
            row.DuplicateMatchedName = exactMatch.Name;

            return;
        }

        // Jaro-Winkler similarity check for possible duplicates
        // Filter out model variants: names that share the same base text but differ in numbers/suffixes
        // (e.g. "Power Macintosh 5400/120" vs "Power Macintosh 5300/100 LC")
        var jwMatches = JaroWinkler.FindMatches(row.Name, _existingMachines, m => m.Name, 0.90);

        if(jwMatches.Count > 0)
        {
            string inputLetters = LettersOnly(row.Name);

            // Keep only matches where the letter-only skeletons are genuinely different
            // If letter skeletons are very similar (JW >= 0.90), they're model variants → skip
            var filtered = jwMatches.Where(m =>
            {
                string matchLetters = LettersOnly(m.item.Name);

                return JaroWinkler.Similarity(inputLetters, matchLetters) < 0.90;
            }).ToList();

            if(filtered.Count > 0)
            {
                row.DuplicateType        = MachineNameDuplicateType.SoundexDuplicate;
                row.DuplicateMatchedName = string.Join(", ", filtered.Select(m => m.item.Name).Take(3));

                return;
            }
        }

        row.DuplicateType = MachineNameDuplicateType.None;
    }

    static string LettersOnly(string input)
    {
        if(string.IsNullOrWhiteSpace(input))
            return "";

        return new string(input.Where(char.IsLetter).ToArray());
    }

    void OnFamilySelected(MachineImportRow row, MachineFamilyDto family)
    {
        row.SelectedFamily = family;

        if(family == CreateNewFamilySentinel || family is null)
            row.FamilyMatch = MachineFamilyMatchType.New;
        else
            row.FamilyMatch = MachineFamilyMatchType.Partial;
    }

    void PreSelectRejections()
    {
        _selectedItems = [];

        foreach(MachineImportRow row in _importRows)
        {
            bool shouldReject = false;

            // Validation error
            if(row.ValidationError is not null)
                shouldReject = true;

            // No company match when company was specified
            if(row.CompanyMatch == CompanyMatchType.None && !string.IsNullOrWhiteSpace(row.CompanyInput))
                shouldReject = true;

            // No type match
            if(row.TypeMatch == MachineTypeMatchType.None && !string.IsNullOrWhiteSpace(row.TypeInput))
                shouldReject = true;

            // Red GPU (non-empty, no match)
            if(row.GpuMatch == GpuMatchType.None && !string.IsNullOrWhiteSpace(row.GpuInput))
                shouldReject = true;

            // Red Processor (non-empty, no match)
            if(row.ProcessorMatch == ProcessorMatchType.None && !string.IsNullOrWhiteSpace(row.ProcessorInput))
                shouldReject = true;

            // Red SoundSynth (non-empty, no match)
            if(row.SoundSynthMatch == SoundSynthMatchType.None && !string.IsNullOrWhiteSpace(row.SoundSynthInput))
                shouldReject = true;

            // Red SoftwarePlatform (non-empty, no match)
            if(row.SoftwarePlatformMatch == SoftwarePlatformMatchType.None &&
               !string.IsNullOrWhiteSpace(row.SoftwarePlatformInput))
                shouldReject = true;

            // Invalid memory types
            if(!row.WorkMemoryTypeValid || !row.VideoMemoryTypeValid || !row.SoundMemoryTypeValid ||
               !row.UnifiedMemoryTypeValid || !row.FirmwareMemoryTypeValid)
                shouldReject = true;

            // Exact duplicate name
            if(row.DuplicateType == MachineNameDuplicateType.ExactDuplicate)
                shouldReject = true;

            if(shouldReject)
                _selectedItems.Add(row);
        }

        _autoRejectedCount = _selectedItems.Count;
    }

    async Task StartImport()
    {
        var toImport = _importRows.Where(r => !_selectedItems.Contains(r)).ToList();
        var rejected = _importRows.Where(r => _selectedItems.Contains(r)).ToList();

        _rejectedCount    = rejected.Count;
        _importedCount    = 0;
        _failedCount      = 0;
        _totalToImport    = toImport.Count;
        _progressPercent  = 0;
        _createdFamilies  = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
        _state            = ImportState.Importing;

        _importRows = [..rejected];
        StateHasChanged();

        foreach(MachineImportRow row in toImport)
        {
            string importError = await ImportSingleMachine(row);

            if(importError is null)
            {
                _importedCount++;
            }
            else
            {
                _failedCount++;
                row.ImportError = importError;
                _importRows.Add(row);
            }

            _progressPercent = (double)(_importedCount + _failedCount) / _totalToImport * 100;
            StateHasChanged();
            await Task.Delay(1);
        }

        _state = ImportState.Complete;
        StateHasChanged();
    }

    async Task<string> ImportSingleMachine(MachineImportRow row)
    {
        // Step 0: Create family if needed
        int? familyId = null;

        if(row.FamilyMatch == MachineFamilyMatchType.New && !string.IsNullOrWhiteSpace(row.FamilyInput))
        {
            // Check if we already created this family in a previous row
            if(_createdFamilies.TryGetValue(row.FamilyInput, out int existingFamilyId))
            {
                familyId = existingFamilyId;
            }
            else
            {
                var familyDto = new MachineFamilyDto
                {
                    Name      = row.FamilyInput,
                    CompanyId = row.SelectedCompany?.Id
                };

                (long? newFamilyId, string familyError) = await MachineFamiliesService.CreateAsync(familyDto);

                if(newFamilyId is null)
                    return string.Format(L["Failed to create family '{0}': {1}"], row.FamilyInput, familyError);

                familyId = (int)newFamilyId.Value;
                _createdFamilies[row.FamilyInput] = familyId.Value;
            }
        }
        else if(row.FamilyMatch is MachineFamilyMatchType.Exact or MachineFamilyMatchType.Partial &&
                row.SelectedFamily is not null && row.SelectedFamily != CreateNewFamilySentinel)
        {
            familyId = row.SelectedFamily.Id;
        }

        // Step 1: Create the machine
        var dto = new MachineDto
        {
            Name                = row.Name,
            Model               = row.Model,
            CompanyId           = row.SelectedCompany?.Id,
            Type                = row.MatchedType,
            Prototype           = row.IsPrototype,
            Introduced          = row.IntroducedDate.HasValue ? new DateTimeOffset(row.IntroducedDate.Value, TimeSpan.Zero) : null,
            IntroducedPrecision = row.IntroducedPrecision,
            FamilyId            = familyId
        };

        (long? machineId, string createError) = await MachinesService.CreateAsync(dto);

        if(machineId is null)
            return createError ?? L["Failed to create machine"];

        int id = (int)machineId.Value;

        // Step 2: Create junction records with rollback on failure
        var createdGpuIds       = new List<long>();
        var createdProcessorIds = new List<long>();
        var createdSoundIds     = new List<long>();
        var createdMemoryIds    = new List<long>();
        var createdPlatformIds  = new List<long>();

        try
        {
            // GPU
            if(row.SelectedGpu is not null)
            {
                var gpuDto = new GpuByMachineDto { GpuId = row.SelectedGpu.Id, MachineId = id };
                (long? gpuJunctionId, string gpuError) = await MachinesService.AddGpuToMachineAsync(gpuDto);

                if(gpuJunctionId is null)
                    throw new InvalidOperationException(gpuError ?? L["Failed to add GPU"]);

                createdGpuIds.Add(gpuJunctionId.Value);
            }

            // Processor
            if(row.SelectedProcessor is not null)
            {
                var procDto = new ProcessorByMachineDto
                {
                    ProcessorId = row.SelectedProcessor.Id,
                    MachineId   = id,
                    Speed       = row.ProcessorSpeed.HasValue ? (float)row.ProcessorSpeed.Value : null
                };

                (long? procJunctionId, string procError) = await MachinesService.AddProcessorToMachineAsync(procDto);

                if(procJunctionId is null)
                    throw new InvalidOperationException(procError ?? L["Failed to add Processor"]);

                createdProcessorIds.Add(procJunctionId.Value);
            }

            // Sound synth
            if(row.SelectedSoundSynth is not null)
            {
                var sndDto = new SoundSynthByMachineDto
                {
                    SoundSynthId = row.SelectedSoundSynth.Id,
                    MachineId    = id
                };

                (long? sndJunctionId, string sndError) = await MachinesService.AddSoundSynthToMachineAsync(sndDto);

                if(sndJunctionId is null)
                    throw new InvalidOperationException(sndError ?? L["Failed to add Sound Synth"]);

                createdSoundIds.Add(sndJunctionId.Value);
            }

            // Memory — Work
            if(row.HasWorkMemory)
            {
                var memDto = new MemoryByMachineDto
                {
                    MachineId = id,
                    Type      = row.WorkMemoryTypeValue,
                    Usage     = 3, // Work
                    Size      = row.WorkMemorySize,
                    Speed     = row.WorkMemorySpeed
                };

                (long? memId, string memError) = await MachinesService.AddMemoryToMachineAsync(memDto);

                if(memId is null)
                    throw new InvalidOperationException(memError ?? L["Failed to add Work memory"]);

                createdMemoryIds.Add(memId.Value);
            }

            // Memory — Video
            if(row.HasVideoMemory)
            {
                var memDto = new MemoryByMachineDto
                {
                    MachineId = id,
                    Type      = row.VideoMemoryTypeValue,
                    Usage     = 4, // Video
                    Size      = row.VideoMemorySize,
                    Speed     = row.VideoMemorySpeed
                };

                (long? memId, string memError) = await MachinesService.AddMemoryToMachineAsync(memDto);

                if(memId is null)
                    throw new InvalidOperationException(memError ?? L["Failed to add Video memory"]);

                createdMemoryIds.Add(memId.Value);
            }

            // Memory — Sound
            if(row.HasSoundMemory)
            {
                var memDto = new MemoryByMachineDto
                {
                    MachineId = id,
                    Type      = row.SoundMemoryTypeValue,
                    Usage     = 5, // Sound
                    Size      = row.SoundMemorySize,
                    Speed     = row.SoundMemorySpeed
                };

                (long? memId, string memError) = await MachinesService.AddMemoryToMachineAsync(memDto);

                if(memId is null)
                    throw new InvalidOperationException(memError ?? L["Failed to add Sound memory"]);

                createdMemoryIds.Add(memId.Value);
            }

            // Memory — Unified
            if(row.HasUnifiedMemory)
            {
                var memDto = new MemoryByMachineDto
                {
                    MachineId = id,
                    Type      = row.UnifiedMemoryTypeValue,
                    Usage     = 10, // Unified
                    Size      = row.UnifiedMemorySize,
                    Speed     = row.UnifiedMemorySpeed
                };

                (long? memId, string memError) = await MachinesService.AddMemoryToMachineAsync(memDto);

                if(memId is null)
                    throw new InvalidOperationException(memError ?? L["Failed to add Unified memory"]);

                createdMemoryIds.Add(memId.Value);
            }

            // Memory — Firmware
            if(row.HasFirmwareMemory)
            {
                var memDto = new MemoryByMachineDto
                {
                    MachineId = id,
                    Type      = row.FirmwareMemoryTypeValue,
                    Usage     = 2, // Firmware
                    Size      = row.FirmwareMemorySize,
                    Speed     = row.FirmwareMemorySpeed
                };

                (long? memId, string memError) = await MachinesService.AddMemoryToMachineAsync(memDto);

                if(memId is null)
                    throw new InvalidOperationException(memError ?? L["Failed to add Firmware memory"]);

                createdMemoryIds.Add(memId.Value);
            }

            // Software platform
            if(row.SelectedSoftwarePlatform is not null)
            {
                var platDto = new SoftwarePlatformByMachineDto
                {
                    SoftwarePlatformId = row.SelectedSoftwarePlatform.Id,
                    MachineId          = id
                };

                (long? platJunctionId, string platError) =
                    await MachinesService.AddSoftwarePlatformToMachineAsync(platDto);

                if(platJunctionId is null)
                    throw new InvalidOperationException(platError ?? L["Failed to add Software Platform"]);

                createdPlatformIds.Add(platJunctionId.Value);
            }

            return null; // Success
        }
        catch(Exception ex)
        {
            // Rollback all created junctions
            foreach(long jid in createdPlatformIds)
                await MachinesService.RemoveSoftwarePlatformFromMachineAsync(jid);

            foreach(long jid in createdMemoryIds)
                await MachinesService.RemoveMemoryFromMachineAsync(jid);

            foreach(long jid in createdSoundIds)
                await MachinesService.RemoveSoundSynthFromMachineAsync(jid);

            foreach(long jid in createdProcessorIds)
                await MachinesService.RemoveProcessorFromMachineAsync(jid);

            foreach(long jid in createdGpuIds)
                await MachinesService.RemoveGpuFromMachineAsync(jid);

            // Delete the machine
            await MachinesService.DeleteAsync(id);

            return ex.Message;
        }
    }

    async Task DownloadRejected()
    {
        var rows = new List<Dictionary<string, string>>();

        foreach(MachineImportRow row in _importRows)
        {
            var dict = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
            {
                ["Name"]               = row.Name,
                ["Company"]            = row.CompanyInput ?? "",
                ["Type"]               = row.TypeInput ?? "",
                ["Model"]              = row.Model ?? "",
                ["Family"]             = row.FamilyInput ?? "",
                ["IntroducedYear"]     = row.IntroducedYear?.ToString() ?? "",
                ["IntroducedMonth"]    = row.IntroducedMonth?.ToString() ?? "",
                ["IntroducedDay"]      = row.IntroducedDay?.ToString() ?? "",
                ["Gpu"]                = row.GpuInput ?? "",
                ["Processor"]          = row.ProcessorInput ?? "",
                ["ProcessorSpeed"]     = row.ProcessorSpeed?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "",
                ["SoundSynth"]         = row.SoundSynthInput ?? "",
                ["SoftwarePlatform"]   = row.SoftwarePlatformInput ?? "",
                ["WorkMemoryType"]     = row.WorkMemoryTypeInput ?? "",
                ["WorkMemorySize"]     = row.WorkMemorySize?.ToString() ?? "",
                ["WorkMemorySpeed"]    = row.WorkMemorySpeed?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "",
                ["VideoMemoryType"]    = row.VideoMemoryTypeInput ?? "",
                ["VideoMemorySize"]    = row.VideoMemorySize?.ToString() ?? "",
                ["VideoMemorySpeed"]   = row.VideoMemorySpeed?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "",
                ["SoundMemoryType"]    = row.SoundMemoryTypeInput ?? "",
                ["SoundMemorySize"]    = row.SoundMemorySize?.ToString() ?? "",
                ["SoundMemorySpeed"]   = row.SoundMemorySpeed?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "",
                ["UnifiedMemoryType"]  = row.UnifiedMemoryTypeInput ?? "",
                ["UnifiedMemorySize"]  = row.UnifiedMemorySize?.ToString() ?? "",
                ["UnifiedMemorySpeed"] = row.UnifiedMemorySpeed?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "",
                ["FirmwareMemoryType"]  = row.FirmwareMemoryTypeInput ?? "",
                ["FirmwareMemorySize"]  = row.FirmwareMemorySize?.ToString() ?? "",
                ["FirmwareMemorySpeed"] = row.FirmwareMemorySpeed?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? ""
            };

            rows.Add(dict);
        }

        string csv    = CsvParser.Generate(CsvHeaders, rows);
        byte[] bytes  = System.Text.Encoding.UTF8.GetBytes(csv);
        string base64 = Convert.ToBase64String(bytes);

        await JsRuntime.InvokeVoidAsync("downloadFileFromBytes", "machine_import_rejected.csv", "text/csv", base64);
    }

    static string FormatImportDate(MachineImportRow row)
    {
        if(row.IntroducedYear is null)
            return "";

        if(row.IntroducedMonth is null)
            return row.IntroducedYear.Value.ToString();

        if(row.IntroducedDay is null)
            return $"{row.IntroducedMonth.Value:D2}/{row.IntroducedYear.Value}";

        return $"{row.IntroducedDay.Value:D2}/{row.IntroducedMonth.Value:D2}/{row.IntroducedYear.Value}";
    }

    static string GetValue(Dictionary<string, string> row, string key) =>
        row.TryGetValue(key, out string val) ? val?.Trim() ?? "" : "";

    static string GetValueOrNull(Dictionary<string, string> row, string key)
    {
        if(!row.TryGetValue(key, out string val))
            return null;

        string trimmed = val?.Trim() ?? "";

        return string.IsNullOrEmpty(trimmed) ? null : trimmed;
    }

    static bool TryParseInt(Dictionary<string, string> row, string key, out int result)
    {
        result = 0;
        string val = GetValueOrNull(row, key);

        return val is not null && int.TryParse(val, out result);
    }

    static bool TryParseDouble(Dictionary<string, string> row, string key, out double result)
    {
        result = 0;
        string val = GetValueOrNull(row, key);

        return val is not null && double.TryParse(val, System.Globalization.NumberStyles.Float,
                                                   System.Globalization.CultureInfo.InvariantCulture, out result);
    }

    static bool TryParseLong(Dictionary<string, string> row, string key, out long result)
    {
        result = 0;
        string val = GetValueOrNull(row, key);

        return val is not null && long.TryParse(val, out result);
    }

    enum ImportState
    {
        Upload,
        Preview,
        Importing,
        Complete
    }
