@using MudBlazor
@using Marechai.Services

@inject IStringLocalizer<UsersService> L

<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="Email"
                      Label="@L["Email"]"
                      Variant="Variant.Outlined"
                      InputType="InputType.Email"
                      Required="true"
                      RequiredError="@L["Email is required."]"
                      Class="mb-4"/>

        <MudTextField @bind-Value="UserName"
                      Label="@L["Username"]"
                      Variant="Variant.Outlined"
                      Required="true"
                      RequiredError="@L["Username is required."]"
                      Class="mb-4"/>

        <MudTextField @bind-Value="PhoneNumber"
                      Label="@L["Phone Number"]"
                      Variant="Variant.Outlined"
                      Class="mb-4"/>

        @if(IsNew)
        {
            <MudTextField @bind-Value="_password"
                          Label="@L["Password"]"
                          Variant="Variant.Outlined"
                          InputType="InputType.Password"
                          Required="true"
                          RequiredError="@L["Password is required."]"
                          Class="mb-4"/>

            <MudTextField @bind-Value="_confirmPassword"
                          Label="@L["Confirm Password"]"
                          Variant="Variant.Outlined"
                          InputType="InputType.Password"
                          Required="true"
                          RequiredError="@L["Password confirmation is required."]"
                          Class="mb-4"/>
        }

        @if(!string.IsNullOrWhiteSpace(_validationError))
        {
            <MudAlert Severity="Severity.Error" Class="mt-2">@_validationError</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">@L["Save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    string? _confirmPassword;
    string? _password;
    string? _validationError;

    [CascadingParameter]
    IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public bool IsNew { get; set; }

    [Parameter]
    public string Email { get; set; } = string.Empty;

    [Parameter]
    public string UserName { get; set; } = string.Empty;

    [Parameter]
    public string? PhoneNumber { get; set; }

    void Cancel() => MudDialog.Cancel();

    void Submit()
    {
        if(string.IsNullOrWhiteSpace(Email) || string.IsNullOrWhiteSpace(UserName))
        {
            _validationError = L["Email and username are required."];

            return;
        }

        if(IsNew)
        {
            if(string.IsNullOrWhiteSpace(_password))
            {
                _validationError = L["Password is required for new users."];

                return;
            }

            if(_password != _confirmPassword)
            {
                _validationError = L["Passwords do not match."];

                return;
            }
        }

        MudDialog.Close(DialogResult.Ok(new UserDialogResult
        {
            Email       = Email,
            UserName    = UserName,
            PhoneNumber = PhoneNumber,
            Password    = _password
        }));
    }
}
