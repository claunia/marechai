@page "/admin/machines"
@attribute [Authorize(Roles = "Admin, UberAdmin")]
@using Marechai.ApiClient.Models
@using Marechai.Services
@inject MachinesService MachinesService
@inject IStringLocalizer<MachinesService> L
@inject IDialogService DialogService

<MudPaper Class="pa-6 mb-6" Elevation="0" Style="background: linear-gradient(135deg, #c62828 0%, #ef5350 100%); border-radius: 16px;">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
        <MudIcon Icon="@Icons.Material.Filled.Computer" Size="Size.Large" Style="color: white;"/>
        <MudText Typo="Typo.h4" Style="color: white;">@L["Machine Management"]</MudText>
    </MudStack>
    <MudText Typo="Typo.subtitle1" Style="color: rgba(255,255,255,0.85);" Class="mt-2">@L["Manage machines, their specifications, and associated components."]</MudText>
</MudPaper>

@if(!string.IsNullOrWhiteSpace(_errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="() => _errorMessage = null">@_errorMessage</MudAlert>
}

@if(!string.IsNullOrWhiteSpace(_successMessage))
{
    <MudAlert Severity="Severity.Success" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="() => _successMessage = null">@_successMessage</MudAlert>
}

@if(_isLoading)
{
    <div class="d-flex justify-center pa-8">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large"/>
    </div>
    return;
}

<MudPaper Elevation="2" Class="rounded-lg">
    <MudToolBar Dense="true">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenAddMachineDialog">@L["Add Machine"]</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Upload" OnClick="OpenImportDialog" Class="ml-2">@L["Import CSV"]</MudButton>
        <MudSpacer/>
        <MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="LoadMachinesAsync"/>
    </MudToolBar>

    <MudDataGrid Items="_machines" Dense="true" Hover="true" Striped="true" Filterable="true" QuickFilter="QuickFilter">
        <Columns>
            <PropertyColumn Property="x => x.Name" Title="@L["Name"]"/>
            <PropertyColumn Property="x => x.Company" Title="@L["Company"]"/>
            <PropertyColumn Property="x => x.Model" Title="@L["Model"]"/>
            <TemplateColumn Title="@L["Type"]" Sortable="true">
                <CellTemplate>
                    @FormatType(context.Item.Type)
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="@L["Prototype"]" Sortable="true">
                <CellTemplate>
                    @if(context.Item.Prototype == true)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Science" Color="Color.Warning" Size="Size.Small"/>
                    }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="@L["Introduction date"]" Sortable="true">
                <CellTemplate>
                    @FormatDate(context.Item.Introduced)
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.Family" Title="@L["Family"]"/>
            <TemplateColumn Title="@L["Actions"]" Sortable="false">
                <CellTemplate>
                    <MudStack Row="true" Spacing="1">
                        <MudIconButton Icon="@Icons.Material.Filled.PhotoLibrary" Size="Size.Small" Color="Color.Info" Href="@($"/admin/machines/{context.Item.Id}/photos")" Title="@L["Photos"]"/>
                        <MudIconButton Icon="@Icons.Material.Filled.Description" Size="Size.Small" OnClick="() => OpenDescriptionsDialog(context.Item)" Title="@L["Descriptions"]"/>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => OpenEditMachineDialog(context.Item)" Title="@L["Edit Machine"]"/>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => ConfirmDeleteMachine(context.Item)" Title="@L["Delete Machine"]"/>
                    </MudStack>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </MudDataGrid>
</MudPaper>
