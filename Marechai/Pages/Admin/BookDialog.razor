    // --- Cover actions ---

    async Task OnCoverFileSelected(IBrowserFile? file)
    {
        if(file is null) return;

        _isUploadingCover = true;
        _coverMessage     = null;
        StateHasChanged();

        try
        {
            using var stream = file.OpenReadStream(50 * 1024 * 1024); // 50MB limit
            using var ms     = new System.IO.MemoryStream();
            await stream.CopyToAsync(ms);
            ms.Position = 0;

            string contentType = System.IO.Path.GetExtension(file.Name)?.ToLowerInvariant() switch
            {
                ".jpg" or ".jpeg" => "image/jpeg",
                ".png"            => "image/png",
                ".webp"           => "image/webp",
                ".tiff" or ".tif" => "image/tiff",
                ".bmp"            => "image/bmp",
                _                 => "application/octet-stream"
            };

            var multipartBody = new Microsoft.Kiota.Abstractions.MultipartBody();
            multipartBody.AddOrReplacePart("file", contentType, ms, file.Name);

            BookDto? result = await BooksService.UploadCoverAsync(BookId, multipartBody);

            if(result is not null)
            {
                _hasCover             = true;
                _coverMessage         = L["Cover uploaded successfully."];
                _coverMessageSeverity = Severity.Success;
            }
            else
            {
                _coverMessage         = L["Failed to upload cover."];
                _coverMessageSeverity = Severity.Error;
            }
        }
        catch(Exception ex)
        {
            _coverMessage         = ex.Message;
            _coverMessageSeverity = Severity.Error;
        }
        finally
        {
            _isUploadingCover = false;
            StateHasChanged();
        }
    }

    async Task DeleteCover()
    {
        (bool succeeded, string? error) = await BooksService.DeleteCoverAsync(BookId);

        if(succeeded)
        {
            _hasCover             = false;
            _coverMessage         = L["Cover deleted."];
            _coverMessageSeverity = Severity.Success;
            StateHasChanged();
        }
        else
        {
            _coverMessage         = error;
            _coverMessageSeverity = Severity.Error;
        }
    }

    // --- Dialog actions ---

    void Cancel() => MudDialog.Cancel();

    void Submit()
    {
        if(string.IsNullOrWhiteSpace(Title))
        {
            _validationError = L["Title is required."];

            return;
        }

        MudDialog.Close(DialogResult.Ok(new BookDialogResult
        {
            Title       = Title,
            NativeTitle = NativeTitle,
            SortTitle   = SortTitle,
            Isbn        = Isbn,
            Edition     = Edition,
            Pages       = Pages,
            CountryId   = _selectedCountry?.Id,
            Published   = Published,
            PublishedPrecision = PublishedPrecision,
            PreviousId  = _selectedPreviousBook?.Id,
            SourceId    = _selectedSourceBook?.Id
        }));
    }
