@using Marechai.ApiClient.Models
@using Marechai.Services
@using System.Threading

@inject IStringLocalizer<MagazinesService> L

<MudDialog>
    <DialogContent>
        <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pa-4">
            @* Tab 1 - Basic Info *@
            <MudTabPanel Text="@L["Basic Info"]" Icon="@Icons.Material.Filled.Info">
                <MudTextField @bind-Value="Title"
                              Label="@L["Title"]"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="@L["Title is required."]"
                              Class="mb-4"/>

                <MudTextField @bind-Value="NativeTitle"
                              Label="@L["Native title"]"
                              Variant="Variant.Outlined"
                              Class="mb-4"/>

                <MudTextField @bind-Value="SortTitle"
                              Label="@L["Sort title"]"
                              Variant="Variant.Outlined"
                              Class="mb-4"/>

                <MudTextField @bind-Value="Issn"
                              Label="@L["ISSN"]"
                              Variant="Variant.Outlined"
                              Class="mb-4"/>

                <MudDatePicker @bind-Date="Published"
                               Label="@L["Published"]"
                               Variant="Variant.Outlined"
                               Clearable="true"
                               Class="mb-4"/>

        <MudSelect T="int" @bind-Value="PublishedPrecision"
                   Label="@L["Date precision"]"
                   Variant="Variant.Outlined"
                   Class="mb-4">
            <MudSelectItem T="int" Value="0">@L["Full date"]</MudSelectItem>
            <MudSelectItem T="int" Value="1">@L["Month and year only"]</MudSelectItem>
            <MudSelectItem T="int" Value="2">@L["Year only"]</MudSelectItem>
        </MudSelect>

                <MudDatePicker @bind-Date="FirstPublication"
                               Label="@L["First publication"]"
                               Variant="Variant.Outlined"
                               Clearable="true"
                               Class="mb-4"/>

                <MudSelect T="int" @bind-Value="FirstPublicationPrecision"
                           Label="@L["Date precision"]"
                           Variant="Variant.Outlined"
                           Class="mb-4">
                    <MudSelectItem T="int" Value="0">@L["Full date"]</MudSelectItem>
                    <MudSelectItem T="int" Value="1">@L["Month and year only"]</MudSelectItem>
                    <MudSelectItem T="int" Value="2">@L["Year only"]</MudSelectItem>
                </MudSelect>

                <MudAutocomplete T="Iso31661NumericDto"
                                 Label="@L["Country"]"
                                 @bind-Value="_selectedCountry"
                                 SearchFunc="SearchCountries"
                                 ToStringFunc="@(c => c?.Name ?? string.Empty)"
                                 Variant="Variant.Outlined"
                                 Clearable="true"
                                 Class="mb-4"/>
            </MudTabPanel>

            @* Tab 2 - Synopsis (only for existing magazines) *@
            @if(!IsNew)
            {
                <MudTabPanel Text="@L["Synopsis"]" Icon="@Icons.Material.Filled.Description">
                    <MudSelect T="string" @bind-Value="_selectedLanguage"
                               Label="@L["Language"]"
                               Variant="Variant.Outlined"
                               Class="mb-4">
                        <MudSelectItem T="string" Value="@("eng")">English</MudSelectItem>
                        <MudSelectItem T="string" Value="@("spa")">Español</MudSelectItem>
                        <MudSelectItem T="string" Value="@("deu")">Deutsch</MudSelectItem>
                        <MudSelectItem T="string" Value="@("fra")">Français</MudSelectItem>
                        <MudSelectItem T="string" Value="@("por")">Português</MudSelectItem>
                        <MudSelectItem T="string" Value="@("lat")">Latin</MudSelectItem>
                    </MudSelect>

                    @if(TranslationService.IsAvailable)
                    {
                        <MudButton StartIcon="@Icons.Material.Filled.Translate"
                                   Variant="Variant.Outlined"
                                   Color="Color.Secondary"
                                   Class="mb-4"
                                   OnClick="TranslateSynopsisFromEnglish"
                                   Disabled="@(_isTranslatingSynopsis || string.IsNullOrWhiteSpace(_selectedLanguage) || _selectedLanguage == "eng" || !TranslationService.IsLanguageSupported(_selectedLanguage) || _existingSynopses?.Exists(s => s.LanguageCode == "eng") != true)">
                            @if(_isTranslatingSynopsis)
                            {
                                <MudProgressLinear Color="Color.Secondary" Value="@(_translationTotal > 0 ? _translationCurrent * 100.0 / _translationTotal : 0)" Class="mr-2" Style="width: 100px; align-self: center;"/>
                                <text>Translating @_translationCurrent / @_translationTotal...</text>
                            }
                            else
                            {
                                <text>Translate from English</text>
                            }
                        </MudButton>
                    }

                    <MudText Typo="Typo.subtitle2" Class="mb-2">@L["Synopsis text (Markdown)"]</MudText>
                    <MarkdownEditor @bind-Value="_synopsisText"
                                    @ref="_synopsisEditor"
                                    @key="_synopsisEditorKey"
                                    SpellChecker="false"
                                    MinHeight="200px"
                                    MaxHeight="400px"
                                    Placeholder="Enter synopsis in Markdown..."/>

                    <MudStack Row="true" Spacing="2" Class="mb-4 mt-4">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                   OnClick="SaveSynopsis"
                                   Disabled="@(string.IsNullOrWhiteSpace(_selectedLanguage) || string.IsNullOrWhiteSpace(_synopsisText))">
                            @L["Save Synopsis"]
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                                   OnClick="DeleteSynopsis"
                                   Disabled="@(string.IsNullOrWhiteSpace(_selectedLanguage) || !_existingSynopses.Any(s => s.LanguageCode == _selectedLanguage))">
                            @L["Delete Synopsis"]
                        </MudButton>
                    </MudStack>

                    @if(!string.IsNullOrWhiteSpace(_synopsisMessage))
                    {
                        <MudAlert Severity="@_synopsisMessageSeverity" Class="mb-4" ShowCloseIcon="true"
                                  CloseIconClicked="() => _synopsisMessage = null">@_synopsisMessage</MudAlert>
                    }

                    @if(_existingSynopses.Count > 0)
                    {
                        <MudText Typo="Typo.subtitle2" Class="mb-2">@L["Existing synopses:"]</MudText>
                        <MudList T="DocumentSynopsisDto" Dense="true">
                            @foreach(DocumentSynopsisDto synopsis in _existingSynopses)
                            {
                                <MudListItem T="DocumentSynopsisDto">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                        <MudText><strong>@GetLanguageName(synopsis.LanguageCode)</strong>: @TruncateSynopsis(synopsis.Text)</MudText>
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                                       OnClick="() => EditSynopsis(synopsis)"/>
                                    </MudStack>
                                </MudListItem>
                            }
                        </MudList>
                    }
                </MudTabPanel>

                @* Tab 3 - People *@
                <MudTabPanel Text="@L["People"]" Icon="@Icons.Material.Filled.People">
                    @if(_magazinePeople is { Count: > 0 })
                    {
                        <MudList T="PersonByMagazineDto" Dense="true">
                            @foreach(PersonByMagazineDto person in _magazinePeople)
                            {
                                <MudListItem T="PersonByMagazineDto">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                        <MudText>@FormatPerson(person)</MudText>
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                                       OnClick="() => RemovePerson(person)"/>
                                    </MudStack>
                                </MudListItem>
                            }
                        </MudList>
                    }

                    <MudPaper Class="pa-4 mt-2" Elevation="1">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudAutocomplete T="PersonDto"
                                             Label="@L["Search Person"]"
                                             @bind-Value="_selectedPerson"
                                             SearchFunc="SearchPeople"
                                             ToStringFunc="@(p => p is null ? string.Empty : FormatPersonDto(p))"
                                             Variant="Variant.Outlined"
                                             Clearable="true"
                                             Style="flex: 1;"/>
                            <MudSelect T="DocumentRoleDto"
                                       @bind-Value="_selectedPersonRole"
                                       Label="@L["Role"]"
                                       ToStringFunc="@(r => r?.Name ?? string.Empty)"
                                       Variant="Variant.Outlined"
                                       Style="max-width: 200px;">
                                @if(_allRoles is not null)
                                {
                                    @foreach(DocumentRoleDto role in _allRoles)
                                    {
                                        <MudSelectItem T="DocumentRoleDto" Value="role">@role.Name</MudSelectItem>
                                    }
                                }
                            </MudSelect>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                       OnClick="AddPerson"
                                       Disabled="@(_selectedPerson is null || _selectedPersonRole is null)">
                                @L["Add"]
                            </MudButton>
                        </MudStack>
                    </MudPaper>
                </MudTabPanel>

                @* Tab 4 - Companies *@
                <MudTabPanel Text="@L["Companies"]" Icon="@Icons.Material.Filled.Business">
                    @if(_magazineCompanies is { Count: > 0 })
                    {
                        <MudList T="CompanyByMagazineDto" Dense="true">
                            @foreach(CompanyByMagazineDto company in _magazineCompanies)
                            {
                                <MudListItem T="CompanyByMagazineDto">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                        <MudText>@FormatCompany(company)</MudText>
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                                       OnClick="() => RemoveCompany(company)"/>
                                    </MudStack>
                                </MudListItem>
                            }
                        </MudList>
                    }

                    <MudPaper Class="pa-4 mt-2" Elevation="1">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudAutocomplete T="CompanyDto"
                                             Label="@L["Search Company"]"
                                             @bind-Value="_selectedCompany"
                                             SearchFunc="SearchCompanies"
                                             ToStringFunc="@(c => c?.Name ?? string.Empty)"
                                             Variant="Variant.Outlined"
                                             Clearable="true"
                                             Style="flex: 1;"/>
                            <MudSelect T="DocumentRoleDto"
                                       @bind-Value="_selectedCompanyRole"
                                       Label="@L["Role"]"
                                       ToStringFunc="@(r => r?.Name ?? string.Empty)"
                                       Variant="Variant.Outlined"
                                       Style="max-width: 200px;">
                                @if(_allRoles is not null)
                                {
                                    @foreach(DocumentRoleDto role in _allRoles)
                                    {
                                        <MudSelectItem T="DocumentRoleDto" Value="role">@role.Name</MudSelectItem>
                                    }
                                }
                            </MudSelect>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                       OnClick="AddCompany"
                                       Disabled="@(_selectedCompany is null || _selectedCompanyRole is null)">
                                @L["Add"]
                            </MudButton>
                        </MudStack>
                    </MudPaper>
                </MudTabPanel>

                @* Tab 5 - Machines *@
                <MudTabPanel Text="@L["Machines"]" Icon="@Icons.Material.Filled.Computer">
                    @if(_magazineMachines is { Count: > 0 })
                    {
                        <MudList T="MagazineByMachineDto" Dense="true">
                            @foreach(MagazineByMachineDto machine in _magazineMachines)
                            {
                                <MudListItem T="MagazineByMachineDto">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                        <MudText>@(machine.Machine ?? $"Machine #{machine.MachineId}")</MudText>
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                                       OnClick="() => RemoveMachine(machine)"/>
                                    </MudStack>
                                </MudListItem>
                            }
                        </MudList>
                    }

                    <MudPaper Class="pa-4 mt-2" Elevation="1">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudAutocomplete T="MachineDto"
                                             Label="@L["Search Machine"]"
                                             @bind-Value="_selectedMachine"
                                             SearchFunc="SearchMachines"
                                             ToStringFunc="@(m => m?.Name ?? string.Empty)"
                                             Variant="Variant.Outlined"
                                             Clearable="true"
                                             Style="flex: 1;"/>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                       OnClick="AddMachine"
                                       Disabled="@(_selectedMachine is null)">
                                @L["Add"]
                            </MudButton>
                        </MudStack>
                    </MudPaper>
                </MudTabPanel>

                @* Tab 6 - Machine Families *@
                <MudTabPanel Text="@L["Machine Families"]" Icon="@Icons.Material.Filled.AccountTree">
                    @if(_magazineMachineFamilies is { Count: > 0 })
                    {
                        <MudList T="MagazineByMachineFamilyDto" Dense="true">
                            @foreach(MagazineByMachineFamilyDto family in _magazineMachineFamilies)
                            {
                                <MudListItem T="MagazineByMachineFamilyDto">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                        <MudText>@(family.MachineFamily ?? $"Family #{family.MachineFamilyId}")</MudText>
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                                       OnClick="() => RemoveMachineFamily(family)"/>
                                    </MudStack>
                                </MudListItem>
                            }
                        </MudList>
                    }

                    <MudPaper Class="pa-4 mt-2" Elevation="1">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudAutocomplete T="MachineFamilyDto"
                                             Label="@L["Search Machine Family"]"
                                             @bind-Value="_selectedMachineFamily"
                                             SearchFunc="SearchMachineFamilies"
                                             ToStringFunc="@(f => f?.Name ?? string.Empty)"
                                             Variant="Variant.Outlined"
                                             Clearable="true"
                                             Style="flex: 1;"/>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                       OnClick="AddMachineFamily"
                                       Disabled="@(_selectedMachineFamily is null)">
                                @L["Add"]
                            </MudButton>
                        </MudStack>
                    </MudPaper>
                </MudTabPanel>
            }
        </MudTabs>

        @if(!string.IsNullOrWhiteSpace(_validationError))
        {
            <MudAlert Severity="Severity.Error" Class="mt-2">@_validationError</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">@L["Save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    string  _validationError;

    // Country picker
    Iso31661NumericDto       _selectedCountry;
    List<Iso31661NumericDto> _allCountries;

    // Synopsis state
    string                    _selectedLanguage;
    string                     _synopsisText     = string.Empty;
    List<DocumentSynopsisDto>  _existingSynopses = [];
    string                    _synopsisMessage;
    Severity                   _synopsisMessageSeverity = Severity.Info;
    MarkdownEditor             _synopsisEditor;
    int                        _synopsisEditorKey;
    bool                       _isTranslatingSynopsis;
    int                        _translationCurrent;
    int                        _translationTotal;

    // People junction
    List<PersonByMagazineDto> _magazinePeople;
    PersonDto                 _selectedPerson;
    DocumentRoleDto           _selectedPersonRole;
    List<PersonDto>           _allPeople;

    // Companies junction
    List<CompanyByMagazineDto> _magazineCompanies;
    CompanyDto                 _selectedCompany;
    DocumentRoleDto            _selectedCompanyRole;
    List<CompanyDto>           _allCompanies;

    // Roles
    List<DocumentRoleDto> _allRoles;

    // Machines junction
    List<MagazineByMachineDto> _magazineMachines;
    MachineDto                 _selectedMachine;
    List<MachineDto>           _allMachines;

    // Machine Families junction
    List<MagazineByMachineFamilyDto> _magazineMachineFamilies;
    MachineFamilyDto                 _selectedMachineFamily;
    List<MachineFamilyDto>           _allMachineFamilies;

    [CascadingParameter]
    IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public bool      IsNew            { get; set; }
    [Parameter] public long      MagazineId       { get; set; }
    [Parameter] public string    Title            { get; set; } = string.Empty;
    [Parameter] public string   NativeTitle      { get; set; }
    [Parameter] public string   SortTitle        { get; set; }
    [Parameter] public string   Issn             { get; set; }
    [Parameter] public int?      CountryId        { get; set; }
    [Parameter] public DateTime? Published        { get; set; }
    [Parameter] public int       PublishedPrecision { get; set; }
    [Parameter] public DateTime? FirstPublication { get; set; }
    [Parameter] public int       FirstPublicationPrecision { get; set; }

    [Inject] MagazinesService MagazinesService { get; set; } = null!;
    [Inject] TranslationService TranslationService { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        // Load countries for picker
        _allCountries = await MagazinesService.GetCountriesAsync();

        // Pre-select country
        if(CountryId is not null && _allCountries is not null)
            _selectedCountry = _allCountries.Find(c => c.Id == CountryId);

        // Load junction data for existing magazines
        if(!IsNew)
        {
            _allRoles           = await MagazinesService.GetDocumentRolesAsync();
            _allPeople          = await MagazinesService.GetAllPeopleAsync();
            _allCompanies       = await MagazinesService.GetAllCompaniesAsync();
            _allMachines        = await MagazinesService.GetAllMachinesAsync();
            _allMachineFamilies = await MagazinesService.GetAllMachineFamiliesAsync();

            _magazinePeople          = await MagazinesService.GetPeopleByMagazineAsync(MagazineId);
            _magazineCompanies       = await MagazinesService.GetCompaniesByMagazineAsync(MagazineId);
            _magazineMachines        = await MagazinesService.GetMachinesByMagazineAsync(MagazineId);
            _magazineMachineFamilies = await MagazinesService.GetMachineFamiliesByMagazineAsync(MagazineId);
            _existingSynopses        = await MagazinesService.GetSynopsesAsync(MagazineId);
        }
    }

    // --- Search functions ---

    Task<IEnumerable<Iso31661NumericDto>> SearchCountries(string value, CancellationToken ct)
    {
        IEnumerable<Iso31661NumericDto> results = _allCountries ?? [];

        if(!string.IsNullOrWhiteSpace(value))
            results = _allCountries?.Where(c => c.Name?.Contains(value, StringComparison.OrdinalIgnoreCase) ?? false) ?? [];

        return Task.FromResult(results);
    }

    Task<IEnumerable<PersonDto>> SearchPeople(string value, CancellationToken ct)
    {
        IEnumerable<PersonDto> results = _allPeople ?? [];

        if(!string.IsNullOrWhiteSpace(value))
        {
            results = _allPeople?.Where(p =>
                (p.Name?.Contains(value, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (p.Surname?.Contains(value, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (p.DisplayName?.Contains(value, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (p.Alias?.Contains(value, StringComparison.OrdinalIgnoreCase) ?? false)) ?? [];
        }

        return Task.FromResult(results);
    }

    Task<IEnumerable<CompanyDto>> SearchCompanies(string value, CancellationToken ct)
    {
        IEnumerable<CompanyDto> results = _allCompanies ?? [];

        if(!string.IsNullOrWhiteSpace(value))
            results = _allCompanies?.Where(c => c.Name?.Contains(value, StringComparison.OrdinalIgnoreCase) ?? false) ?? [];

        return Task.FromResult(results);
    }

    Task<IEnumerable<MachineDto>> SearchMachines(string value, CancellationToken ct)
    {
        IEnumerable<MachineDto> results = _allMachines ?? [];

        if(!string.IsNullOrWhiteSpace(value))
            results = _allMachines?.Where(m => m.Name?.Contains(value, StringComparison.OrdinalIgnoreCase) ?? false) ?? [];

        return Task.FromResult(results);
    }

    Task<IEnumerable<MachineFamilyDto>> SearchMachineFamilies(string value, CancellationToken ct)
    {
        IEnumerable<MachineFamilyDto> results = _allMachineFamilies ?? [];

        if(!string.IsNullOrWhiteSpace(value))
            results = _allMachineFamilies?.Where(f => f.Name?.Contains(value, StringComparison.OrdinalIgnoreCase) ?? false) ?? [];

        return Task.FromResult(results);
    }

    // --- Format helpers ---

    static string FormatPersonDto(PersonDto p)
    {
        if(!string.IsNullOrWhiteSpace(p.DisplayName)) return p.DisplayName;
        if(!string.IsNullOrWhiteSpace(p.Alias))       return p.Alias;

        return string.IsNullOrWhiteSpace(p.Surname) ? p.Name ?? string.Empty : $"{p.Name} {p.Surname}";
    }

    static string FormatPerson(PersonByMagazineDto p)
    {
        string name = p.DisplayName ?? p.Alias ?? $"{p.Name} {p.Surname}".Trim();

        return string.IsNullOrWhiteSpace(p.Role) ? name : $"{name} ({p.Role})";
    }

    static string FormatCompany(CompanyByMagazineDto c) =>
        string.IsNullOrWhiteSpace(c.Role) ? c.Company ?? string.Empty : $"{c.Company} ({c.Role})";

    static string GetLanguageName(string code) => code switch
    {
        "eng" => "English",
        "spa" => "Español",
        "deu" => "Deutsch",
        "fra" => "Français",
        "por" => "Português",
        "lat" => "Latin",
        _     => code ?? "?"
    };

    static string TruncateSynopsis(string text) =>
        string.IsNullOrWhiteSpace(text)
            ? string.Empty
            : text.Length > 100 ? text[..100] + "..." : text;

    // --- Synopsis actions ---

    void EditSynopsis(DocumentSynopsisDto synopsis)
    {
        _selectedLanguage = synopsis.LanguageCode;
        _synopsisText     = synopsis.Text ?? string.Empty;
        _synopsisEditorKey++;
    }

    async Task SaveSynopsis()
    {
        if(string.IsNullOrWhiteSpace(_selectedLanguage) || string.IsNullOrWhiteSpace(_synopsisText))
            return;

        var dto = new DocumentSynopsisDto
        {
            LanguageCode = _selectedLanguage,
            Text         = _synopsisText
        };

        (long? id, string error) = await MagazinesService.UpsertSynopsisAsync(MagazineId, dto);

        if(id is not null)
        {
            _synopsisMessage         = L["Synopsis saved."];
            _synopsisMessageSeverity = Severity.Success;
            _existingSynopses        = await MagazinesService.GetSynopsesAsync(MagazineId);
            StateHasChanged();
        }
        else
        {
            _synopsisMessage         = error;
            _synopsisMessageSeverity = Severity.Error;
        }
    }

    async Task DeleteSynopsis()
    {
        if(string.IsNullOrWhiteSpace(_selectedLanguage))
            return;

        (bool succeeded, string error) = await MagazinesService.DeleteSynopsisAsync(MagazineId, _selectedLanguage);

        if(succeeded)
        {
            _synopsisMessage         = L["Synopsis deleted."];
            _synopsisMessageSeverity = Severity.Success;
            _synopsisText            = string.Empty;
            _synopsisEditorKey++;
            _existingSynopses        = await MagazinesService.GetSynopsesAsync(MagazineId);
            StateHasChanged();
        }
        else
        {
            _synopsisMessage         = error;
            _synopsisMessageSeverity = Severity.Error;
        }
    }

    async Task TranslateSynopsisFromEnglish()
    {
        _isTranslatingSynopsis = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            string englishMarkdown = _existingSynopses?.Find(s => s.LanguageCode == "eng")?.Text;

            if(string.IsNullOrWhiteSpace(englishMarkdown))
            {
                _synopsisMessage         = "No English synopsis found to translate from.";
                _synopsisMessageSeverity = Severity.Error;

                return;
            }

            (string translatedText, string error) = await TranslationService.TranslateAsync(englishMarkdown, _selectedLanguage!,
                new Progress<(int current, int total)>(p =>
                {
                    _translationCurrent = p.current;
                    _translationTotal   = p.total;
                    InvokeAsync(StateHasChanged);
                }));

            if(translatedText is not null)
            {
                _synopsisText            = translatedText;
                _synopsisEditorKey++;
                _synopsisMessage         = "Translation completed. Please review before saving.";
                _synopsisMessageSeverity = Severity.Success;
            }
            else
            {
                _synopsisMessage         = error ?? "Translation failed.";
                _synopsisMessageSeverity = Severity.Error;
            }
        }
        finally
        {
            _isTranslatingSynopsis = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    // --- People junction actions ---

    async Task AddPerson()
    {
        if(_selectedPerson is null || _selectedPersonRole is null)
            return;

        var dto = new PersonByMagazineDto
        {
            PersonId   = (int?)_selectedPerson.Id,
            MagazineId = MagazineId,
            RoleId     = _selectedPersonRole.Id
        };

        (long? id, string error) = await MagazinesService.AddPersonToMagazineAsync(dto);

        if(id is not null)
        {
            _magazinePeople     = await MagazinesService.GetPeopleByMagazineAsync(MagazineId);
            _selectedPerson     = null;
            _selectedPersonRole = null;
            StateHasChanged();
        }
    }

    async Task RemovePerson(PersonByMagazineDto person)
    {
        if(person.Id is null) return;

        (bool succeeded, string error) = await MagazinesService.RemovePersonFromMagazineAsync(person.Id.Value);

        if(succeeded)
        {
            _magazinePeople = await MagazinesService.GetPeopleByMagazineAsync(MagazineId);
            StateHasChanged();
        }
    }

    // --- Companies junction actions ---

    async Task AddCompany()
    {
        if(_selectedCompany is null || _selectedCompanyRole is null)
            return;

        var dto = new CompanyByMagazineDto
        {
            CompanyId  = (int?)_selectedCompany.Id,
            MagazineId = MagazineId,
            RoleId     = _selectedCompanyRole.Id
        };

        (long? id, string error) = await MagazinesService.AddCompanyToMagazineAsync(dto);

        if(id is not null)
        {
            _magazineCompanies   = await MagazinesService.GetCompaniesByMagazineAsync(MagazineId);
            _selectedCompany     = null;
            _selectedCompanyRole = null;
            StateHasChanged();
        }
    }

    async Task RemoveCompany(CompanyByMagazineDto company)
    {
        if(company.Id is null) return;

        (bool succeeded, string error) = await MagazinesService.RemoveCompanyFromMagazineAsync(company.Id.Value);

        if(succeeded)
        {
            _magazineCompanies = await MagazinesService.GetCompaniesByMagazineAsync(MagazineId);
            StateHasChanged();
        }
    }

