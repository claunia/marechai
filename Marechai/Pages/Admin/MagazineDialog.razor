            MachineId  = (int?)_selectedMachine.Id
        };

        (long? id, string error) = await MagazinesService.AddMachineToMagazineAsync(dto);

        if(id is not null)
        {
            _magazineMachines = await MagazinesService.GetMachinesByMagazineAsync(MagazineId);
            _selectedMachine  = null;
            StateHasChanged();
