@page "/admin/old-dos-imports"
@attribute [Authorize(Roles = "Admin, UberAdmin")]
@using System.Linq
@using System.Threading
@using Marechai.ApiClient.Models
@using Marechai.Data
@inject OldDosImportsService Service
@inject IDialogService       DialogService
@inject ISnackbar            Snackbar
@inject IStringLocalizer<OldDosImportsQueue> L

<MudPaper Class="pa-6 mb-6" Elevation="0"
          Style="background: linear-gradient(135deg, #6a1b9a 0%, #ab47bc 100%); border-radius: 16px;">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
        <MudIcon Icon="@Icons.Material.Filled.Inventory2" Style="color: white; font-size: 48px;"/>
        <MudStack Spacing="1">
            <MudText Typo="Typo.h4" Style="color: white; font-weight: 700;">@L["old-dos.ru imports"]</MudText>
            <MudText Typo="Typo.body2" Style="color: rgba(255,255,255,0.85);">
                @L["Review pending software pulled from old-dos.ru after the OpenAI enrichment passes."]
            </MudText>
        </MudStack>
    </MudStack>
</MudPaper>

<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="mb-4">
    <MudSelect T="OldDosSoftwareStatus?" Value="@_statusFilter" ValueChanged="@(async v => { _statusFilter = v; _hasError = false; await ReloadAsync(); })"
               Label="@L["Status"]" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width: 220px;" Clearable="true" Disabled="_hasError">
        <MudSelectItem T="OldDosSoftwareStatus?" Value="@((OldDosSoftwareStatus?)null)">@L["Ready or skipped"]</MudSelectItem>
        <MudSelectItem T="OldDosSoftwareStatus?" Value="@((OldDosSoftwareStatus?)OldDosSoftwareStatus.ReadyForReview)">@L["Ready for review"]</MudSelectItem>
        <MudSelectItem T="OldDosSoftwareStatus?" Value="@((OldDosSoftwareStatus?)OldDosSoftwareStatus.Skipped)">@L["Skipped"]</MudSelectItem>
        <MudSelectItem T="OldDosSoftwareStatus?" Value="@((OldDosSoftwareStatus?)OldDosSoftwareStatus.Accepted)">@L["Accepted"]</MudSelectItem>
        <MudSelectItem T="OldDosSoftwareStatus?" Value="@((OldDosSoftwareStatus?)OldDosSoftwareStatus.Discarded)">@L["Discarded"]</MudSelectItem>
        <MudSelectItem T="OldDosSoftwareStatus?" Value="@((OldDosSoftwareStatus?)OldDosSoftwareStatus.Crawled)">@L["Crawled (needs translation)"]</MudSelectItem>
        <MudSelectItem T="OldDosSoftwareStatus?" Value="@((OldDosSoftwareStatus?)OldDosSoftwareStatus.Translated)">@L["Translated (needs description)"]</MudSelectItem>
        <MudSelectItem T="OldDosSoftwareStatus?" Value="@((OldDosSoftwareStatus?)OldDosSoftwareStatus.Described)">@L["Described (needs categorization)"]</MudSelectItem>
        <MudSelectItem T="OldDosSoftwareStatus?" Value="@((OldDosSoftwareStatus?)OldDosSoftwareStatus.Categorized)">@L["Categorized (auto-promotes to Ready)"]</MudSelectItem>
    </MudSelect>

    <MudCheckBox T="bool" Value="@_hasError" ValueChanged="@(async v => { _hasError = v; await ReloadAsync(); })"
                 Label="@L["Has enrichment error"]" Color="Color.Error"/>

    <MudTextField T="string" Value="@_search" ValueChanged="@(async v => { _search = v; await ReloadAsync(); })"
                  Placeholder="@L["Search by name…"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Style="min-width: 300px;"
                  DebounceInterval="300" Immediate="true"/>

    <MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="ReloadAsync" Color="Color.Primary"
                   aria-label="@L["Refresh"]"/>
</MudStack>

<MudDataGrid @ref="_dataGrid" T="OldDosPendingListItemDto" ServerData="ServerReload"
             Dense="true" Hover="true" Striped="true" RowsPerPage="25" SortMode="SortMode.Single">
    <Columns>
        <TemplateColumn Title="@L["Name"]" SortBy="@(new Func<OldDosPendingListItemDto, object>(x => x.Name))">
            <CellTemplate>
                <MudStack Row="false" Spacing="0">
                    <MudText Typo="Typo.body2">@context.Item.Name</MudText>
                    @if(!string.IsNullOrWhiteSpace(context.Item.RussianCategoryPath))
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@context.Item.RussianCategoryPath</MudText>
                    }
                </MudStack>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@L["Developer (raw)"]" SortBy="@(new Func<OldDosPendingListItemDto, object>(x => x.DeveloperName))">
            <CellTemplate>@(string.IsNullOrEmpty(context.Item.DeveloperName) ? "—" : context.Item.DeveloperName)</CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@L["OS"]" SortBy="@(new Func<OldDosPendingListItemDto, object>(x => x.OsName))">
            <CellTemplate>@(string.IsNullOrEmpty(context.Item.OsName) ? "—" : context.Item.OsName)</CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.VersionCount" Title="@L["Versions"]"/>
        <TemplateColumn Title="@L["Status"]" SortBy="@(new Func<OldDosPendingListItemDto, object>(x => x.Status))">
            <CellTemplate>
                <MudChip T="string" Size="Size.Small" Color="@StatusColor(StatusOf(context.Item))" Variant="Variant.Filled">
                    @StatusLabel(StatusOf(context.Item))
                </MudChip>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@L["Crawled"]" SortBy="@(new Func<OldDosPendingListItemDto, object>(x => x.CrawledOn))">
            <CellTemplate>@(context.Item.CrawledOn?.LocalDateTime.ToString("g"))</CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@L["Error"]" Sortable="false">
            <CellTemplate>
                @if(!string.IsNullOrEmpty(context.Item.LastError))
                {
                    <MudTooltip Text="@context.Item.LastError">
                        <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Color="Color.Error" Size="Size.Small"/>
                    </MudTooltip>
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="" Sortable="false">
            <CellTemplate>
                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                    @if(StatusOf(context.Item) is OldDosSoftwareStatus.ReadyForReview or OldDosSoftwareStatus.Skipped)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Visibility"
                                   OnClick="@(() => OpenReviewAsync(context.Item.Id ?? 0))">@L["Review"]</MudButton>
                    }
                    else if(!string.IsNullOrEmpty(context.Item.SourceUrl))
                    {
                        <MudLink Href="@AbsoluteOldDosUrl(context.Item.SourceUrl)" Target="_blank" Color="Color.Default">@L["Open on old-dos"]</MudLink>
                    }

                    @* Reject (discard) available for any status except the terminal ones — i.e. it works
                       on still-Crawled / still-Translated / still-Described / Categorized / ReadyForReview /
                       Skipped rows. The server-side DiscardAsync also refuses already-Accepted rows. *@
                    @if(StatusOf(context.Item) is not OldDosSoftwareStatus.Discarded and not OldDosSoftwareStatus.Accepted)
                    {
                        <MudTooltip Text="@L["Reject this entry"]">
                            <MudIconButton Icon="@Icons.Material.Filled.Block" Color="Color.Error" Size="Size.Small"
                                           OnClick="@(() => RejectAsync(context.Item))"
                                           aria-label="@L["Reject"]"/>
                        </MudTooltip>
                    }
                </MudStack>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <NoRecordsContent>
        <MudText>@L["No pending old-dos imports."]</MudText>
    </NoRecordsContent>
    <PagerContent>
        <MudDataGridPager T="OldDosPendingListItemDto"/>
    </PagerContent>
</MudDataGrid>

@code
{
    MudDataGrid<OldDosPendingListItemDto> _dataGrid;
    OldDosSoftwareStatus?                  _statusFilter = OldDosSoftwareStatus.ReadyForReview;
    string                                 _search;
    bool                                   _hasError;

    async Task<GridData<OldDosPendingListItemDto>> ServerReload(GridState<OldDosPendingListItemDto> state,
                                                                CancellationToken cancellationToken)
    {
        int skip = state.Page * state.PageSize;
        int take = state.PageSize;

        // Map the MudDataGrid SortDefinition (which carries the column's bound
        // property name) into the lowercase sort-key set the controller accepts.
        string sortBy         = null;
        bool   sortDescending = false;
        SortDefinition<OldDosPendingListItemDto> sort = state.SortDefinitions.FirstOrDefault();
        if(sort is not null)
        {
            sortBy         = sort.SortBy;
            sortDescending = sort.Descending;
        }

        // Filter values are page-level state; the controller validates and clamps
        // them. Fetch page + total count in parallel to keep round-trips tight.
        OldDosSoftwareStatus? effectiveStatus = _hasError ? null : _statusFilter;

        Task<List<OldDosPendingListItemDto>> pageTask =
            Service.GetPendingAsync(skip, take, effectiveStatus, _search, _hasError, sortBy, sortDescending);

        Task<int> countTask =
            Service.GetPendingCountAsync(effectiveStatus, _search, _hasError);

        await Task.WhenAll(pageTask, countTask);

        return new GridData<OldDosPendingListItemDto>
        {
            Items      = pageTask.Result,
            TotalItems = countTask.Result
        };
    }

    async Task ReloadAsync()
    {
        if(_dataGrid is not null) await _dataGrid.ReloadServerData();
    }

    async Task OpenReviewAsync(long id)
    {
        var parameters = new DialogParameters
        {
            ["InitialId"] = id
        };
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            FullWidth        = true,
            MaxWidth         = MaxWidth.ExtraLarge
        };
        IDialogReference dlg = await DialogService.ShowAsync<OldDosImportReviewDialog>(L["Review old-dos import"], parameters, options);
        await dlg.Result;
        await ReloadAsync();
    }

    /// <summary>
    ///     Reject an old-dos import straight from the queue without opening the review dialog.
    ///     Often the raw name alone is enough to know the entry is junk (test rips, ad-ware, etc.),
    ///     even for items still in the early enrichment phases (Crawled / Translated / Described).
    ///     The server-side discard endpoint accepts any status except <c>Accepted</c>.
    /// </summary>
    async Task RejectAsync(OldDosPendingListItemDto item)
    {
        DialogParameters<DeleteConfirmDialog> parameters = new()
        {
            {
                x => x.ContentText,
                string.Format(
                    L["Are you sure you want to reject '{0}'? It will be marked as discarded and removed from the queue."]
                       .Value,
                    item.Name)
            }
        };

        IDialogReference dialog =
            await DialogService.ShowAsync<DeleteConfirmDialog>(L["Reject old-dos import"], parameters,
                                                               new DialogOptions
                                                               {
                                                                   MaxWidth  = MaxWidth.ExtraSmall,
                                                                   FullWidth = true
                                                               });

        DialogResult result = await dialog.Result;
        if(result is null or { Canceled: true }) return;

        bool ok = await Service.DiscardAsync(item.Id ?? 0);
        if(ok)
        {
            Snackbar.Add(string.Format(L["Rejected '{0}'."].Value, item.Name), Severity.Success);
            await ReloadAsync();
        }
        else
        {
            Snackbar.Add(L["Failed to reject entry."], Severity.Error);
        }
    }

    static OldDosSoftwareStatus StatusOf(OldDosPendingListItemDto i) =>
        i.Status.HasValue ? (OldDosSoftwareStatus)i.Status.Value : OldDosSoftwareStatus.Crawled;

    string StatusLabel(OldDosSoftwareStatus status) => status switch
    {
        OldDosSoftwareStatus.Crawled        => L["Crawled"],
        OldDosSoftwareStatus.Translated     => L["Translated"],
        OldDosSoftwareStatus.Described      => L["Described"],
        OldDosSoftwareStatus.Categorized    => L["Categorized"],
        OldDosSoftwareStatus.ReadyForReview => L["Ready"],
        OldDosSoftwareStatus.Accepted       => L["Accepted"],
        OldDosSoftwareStatus.Skipped        => L["Skipped"],
        OldDosSoftwareStatus.Discarded      => L["Discarded"],
        _                                   => "—"
    };

    Color StatusColor(OldDosSoftwareStatus status) => status switch
    {
        OldDosSoftwareStatus.ReadyForReview => Color.Primary,
        OldDosSoftwareStatus.Skipped        => Color.Warning,
        OldDosSoftwareStatus.Accepted       => Color.Success,
        OldDosSoftwareStatus.Discarded      => Color.Error,
        _                                   => Color.Default
    };

    /// <summary>old-dos.ru `SourceUrl` is stored host-relative (e.g. <c>/index.php?…</c>); prefix the host
    /// so the link opens the upstream page instead of resolving against the current admin host.</summary>
    static string AbsoluteOldDosUrl(string url)
    {
        if(string.IsNullOrWhiteSpace(url)) return url;
        if(url.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
           url.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
            return url;
        return "https://old-dos.ru" + (url.StartsWith('/') ? url : "/" + url);
    }
}
