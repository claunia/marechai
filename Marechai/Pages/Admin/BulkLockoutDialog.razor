@using MudBlazor

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-4">Update lockout setting for <strong>@UserCount user(s)</strong></MudText>

        <MudRadioGroup T="bool" @bind-Value="_enable">
            <MudRadio Value="true" Color="Color.Warning">Enable lockout</MudRadio>
            <MudRadio Value="false" Color="Color.Success">Disable lockout</MudRadio>
        </MudRadioGroup>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">Apply</MudButton>
    </DialogActions>
</MudDialog>

@code {
    bool _enable = true;

    [CascadingParameter]
    IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public int UserCount { get; set; }

    void Cancel() => MudDialog.Cancel();
    void Submit() => MudDialog.Close(DialogResult.Ok(_enable));
}
