@using Marechai.ApiClient.Models
@using Marechai.Data
@using Marechai.Helpers
@using Marechai.Services
@using System.Threading
@using Humanizer

@inject IStringLocalizer<SoftwareReleasesService> L

<MudDialog>
    <DialogContent>
        <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pa-4">
            @* Tab 1 - Basic Info *@
            <MudTabPanel Text="@L["Basic Info"]" Icon="@Icons.Material.Filled.Info">
                <MudTextField @bind-Value="Title"
                              Label="@L["Title"]"
                              Variant="Variant.Outlined"
                              Class="mb-4"
                              HelperText="@L["Optional. Used as the display name for compilation releases."]"/>

                <MudAutocomplete T="SoftwareCompilationDto"
                                 Label="@L["Compilation (optional)"]"
                                 Value="_selectedCompilation"
                                 ValueChanged="OnCompilationChanged"
                                 SearchFunc="SearchCompilations"
                                 ToStringFunc="@(c => c?.Name ?? string.Empty)"
                                 Variant="Variant.Outlined"
                                 Disabled="@(!IsNew)"
                                 Clearable="true"
                                 Class="mb-4"
                                 HelperText="@L["Set this if the release is a compilation rather than a single piece of software."]"/>

                @if(!_isCompilation)
                {
                    @if(IsSoftwareSelectionLocked)
                    {
                        <MudTextField T="string"
                                      Value="SoftwareName"
                                      Label="@L["Software"]"
                                      Variant="Variant.Outlined"
                                      ReadOnly="true"
                                      Class="mb-4"/>
                    }
                    else
                    {
                        <MudAutocomplete T="SoftwareDto"
                                         Label="@L["Software"]"
                                         Value="_selectedSoftware"
                                         ValueChanged="OnSoftwareChanged"
                                         SearchFunc="SearchSoftware"
                                         ToStringFunc="@(s => s?.Name ?? string.Empty)"
                                         Variant="Variant.Outlined"
                                         Clearable="true"
                                         Class="mb-4"
                                         Required="true"/>
                    }

                    @if(ShouldShowVersionPicker)
                    {
                        <MudAutocomplete T="SoftwareVersionDto"
                                         Label="@L["Version (optional)"]"
                                         @bind-Value="_selectedVersion"
                                         SearchFunc="SearchVersionsForSoftware"
                                         ToStringFunc="@(v => v is null ? string.Empty : $"{v.VersionString}{(string.IsNullOrEmpty(v.PublicVersion) ? "" : $" ({v.PublicVersion})")}")"
                                         Variant="Variant.Outlined"
                                         Clearable="true"
                                         Class="mb-4"/>
                    }
                }

                <MudAutocomplete T="SoftwarePlatformDto"
                                 Label="@L["Platform"]"
                                 @bind-Value="_selectedPlatform"
                                 SearchFunc="SearchPlatforms"
                                 ToStringFunc="@(p => p?.Name ?? string.Empty)"
                                 Variant="Variant.Outlined"
                                 Clearable="true"
                                 MaxItems="null"
                                 Class="mb-4"/>

                <MudText Typo="Typo.subtitle1" Class="mb-2">@L["Regions"]</MudText>
                <MudAutocomplete T="UnM49Dto"
                                 Label="@L["Add region"]"
                                 @bind-Value="_selectedRegionToAdd"
                                 SearchFunc="SearchRegions"
                                 ToStringFunc="@(r => r is null ? string.Empty : $"{r.Name} ({r.Type})")"
                                 Variant="Variant.Outlined"
                                 Clearable="true"
                                 Class="mb-2"/>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                           OnClick="AddRegion" Disabled="@(_selectedRegionToAdd is null)"
                           Class="mb-2">
                    @L["Add"]
                </MudButton>
                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mb-4">
                    @if(_releaseRegions is not null)
                    {
                        @foreach(var region in _releaseRegions)
                        {
                            <MudChip T="string" OnClose="@(async () => await RemoveRegion(region))" Color="Color.Secondary">
                                @region.RegionName
                            </MudChip>
                        }
                    }
                </MudStack>

                <MudText Typo="Typo.subtitle1" Class="mb-2">@L["Languages"]</MudText>
                <MudAutocomplete T="Iso639Dto"
                                 Label="@L["Add language"]"
                                 @bind-Value="_selectedLanguageToAdd"
                                 SearchFunc="SearchLanguages"
                                 ToStringFunc="@(l => l is null ? string.Empty : $"{l.ReferenceName} ({l.Id})")"
                                 Variant="Variant.Outlined"
                                 Clearable="true"
                                 Class="mb-2"/>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                           OnClick="AddLanguage" Disabled="@(_selectedLanguageToAdd is null)"
                           Class="mb-2">
                    @L["Add"]
                </MudButton>
                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mb-4">
                    @if(_releaseLanguages is not null)
                    {
                        @foreach(var lang in _releaseLanguages)
                        {
                            <MudChip T="string" OnClose="@(async () => await RemoveLanguage(lang))" Color="Color.Info">
                                @lang.Language
                            </MudChip>
                        }
                    }
                </MudStack>

                <MudAutocomplete T="CompanyDto"
                                 Label="@L["Publisher"]"
                                 @bind-Value="_selectedPublisher"
                                 SearchFunc="SearchCompanies"
                                 ToStringFunc="@(c => c?.Name ?? string.Empty)"
                                 Variant="Variant.Outlined"
                                 Clearable="true"
                                 Class="mb-4"/>

                <MudDatePicker @bind-Date="ReleaseDate"
                               Label="@L["Release date"]"
                               Variant="Variant.Outlined"
                               Clearable="true"
                               Class="mb-4"/>

        <MudSelect T="int" @bind-Value="ReleaseDatePrecision"
                   Label="@L["Date precision"]"
                   Variant="Variant.Outlined"
                   Class="mb-4">
            <MudSelectItem T="int" Value="0">@L["Full date"]</MudSelectItem>
            <MudSelectItem T="int" Value="1">@L["Month and year only"]</MudSelectItem>
            <MudSelectItem T="int" Value="2">@L["Year only"]</MudSelectItem>
        </MudSelect>

                @if(!string.IsNullOrWhiteSpace(_validationError))
                {
                    <MudAlert Severity="Severity.Error" Class="mt-2">@_validationError</MudAlert>
                }
            </MudTabPanel>

            @* Tab 2 - Barcodes *@
            @if(!IsNew)
            {
                <MudTabPanel Text="@L["Barcodes"]" Icon="@Icons.Material.Filled.QrCode">
                    @if(_barcodes is { Count: > 0 })
                    {
                        <MudList T="SoftwareBarcodeDto" Dense="true">
                            @foreach(SoftwareBarcodeDto barcode in _barcodes)
                            {
                                <MudListItem T="SoftwareBarcodeDto">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                        <MudText>@(((BarcodeType)(barcode.Type ?? 0)).Humanize()) — @barcode.Code</MudText>
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                       Size="Size.Small"
                                                       Color="Color.Error"
                                                       OnClick="() => RemoveBarcode(barcode)"/>
                                    </MudStack>
                                </MudListItem>
                            }
                        </MudList>
                    }

                    <MudPaper Class="pa-4 mt-2" Elevation="1">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudSelect T="int"
                                       @bind-Value="_newBarcodeType"
                                       Label="@L["Barcode type"]"
                                       Variant="Variant.Outlined"
                                       Style="min-width: 160px;">
                                @foreach(BarcodeType bt in Enum.GetValues<BarcodeType>())
                                {
                                    int val = (int)bt;
                                    <MudSelectItem T="int" Value="val">@bt.Humanize()</MudSelectItem>
                                }
                            </MudSelect>
                            <MudTextField @bind-Value="_newBarcodeCode"
                                          Label="@L["Barcode"]"
                                          Variant="Variant.Outlined"
                                          Style="flex: 1;"/>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       OnClick="AddBarcode"
                                       Disabled="@(string.IsNullOrWhiteSpace(_newBarcodeCode))">
                                @L["Add"]
                            </MudButton>
                        </MudStack>
                    </MudPaper>
                </MudTabPanel>

                @* Tab 3 - Product Codes *@
                <MudTabPanel Text="@L["Product Codes"]" Icon="@Icons.Material.Filled.Tag">
                    @if(_productCodes is { Count: > 0 })
                    {
                        <MudList T="SoftwareProductCodeDto" Dense="true">
                            @foreach(SoftwareProductCodeDto code in _productCodes)
                            {
                                <MudListItem T="SoftwareProductCodeDto">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                        <MudText>@(((ProductCodeIssuer)(code.Issuer ?? 0)).Humanize()) — @(code.Code)</MudText>
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                       Size="Size.Small"
                                                       Color="Color.Error"
                                                       OnClick="() => RemoveProductCode(code)"/>
                                    </MudStack>
                                </MudListItem>
                            }
                        </MudList>
                    }

                    <MudPaper Class="pa-4 mt-2" Elevation="1">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudSelect T="int"
                                       @bind-Value="_newProductCodeIssuer"
                                       Label="@L["Issuer"]"
                                       Variant="Variant.Outlined"
                                       Style="min-width: 160px;">
                                @foreach(ProductCodeIssuer pci in Enum.GetValues<ProductCodeIssuer>())
                                {
                                    int val = (int)pci;
                                    <MudSelectItem T="int" Value="val">@pci.Humanize()</MudSelectItem>
                                }
                            </MudSelect>
                            <MudTextField @bind-Value="_newProductCode"
                                          Label="@L["Product code"]"
                                          Variant="Variant.Outlined"
                                          Style="flex: 1;"/>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       OnClick="AddProductCode"
                                       Disabled="@(string.IsNullOrWhiteSpace(_newProductCode))">
                                @L["Add"]
                            </MudButton>
                        </MudStack>
                    </MudPaper>
                </MudTabPanel>

                @* Tab 4 - Minimum GPUs *@
                <MudTabPanel Text="@L["Minimum GPUs"]" Icon="@Icons.Material.Filled.Memory">
                    @if(_minimumGpus is { Count: > 0 })
                    {
                        <MudList T="GpuBySoftwareReleaseDto" Dense="true">
                            @foreach(GpuBySoftwareReleaseDto gpu in _minimumGpus)
                            {
                                <MudListItem T="GpuBySoftwareReleaseDto">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                        <MudText>@gpu.Gpu</MudText>
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                       Size="Size.Small"
                                                       Color="Color.Error"
                                                       OnClick="() => RemoveMinimumGpu(gpu)"/>
                                    </MudStack>
                                </MudListItem>
                            }
                        </MudList>
                    }

                    <MudPaper Class="pa-4 mt-2" Elevation="1">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudAutocomplete T="GpuDto"
                                             Label="@L["Search GPU"]"
                                             @bind-Value="_selectedMinGpu"
                                             SearchFunc="SearchGpus"
                                             ToStringFunc="@(g => g?.Name ?? string.Empty)"
                                             Variant="Variant.Outlined"
                                             Clearable="true"
                                             Style="flex: 1;"/>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       OnClick="AddMinimumGpu"
                                       Disabled="@(_selectedMinGpu is null)">
                                @L["Add"]
                            </MudButton>
                        </MudStack>
                    </MudPaper>
                </MudTabPanel>

                @* Tab 5 - Recommended GPUs *@
                <MudTabPanel Text="@L["Recommended GPUs"]" Icon="@Icons.Material.Filled.Memory">
                    @if(_recommendedGpus is { Count: > 0 })
                    {
                        <MudList T="GpuBySoftwareReleaseDto" Dense="true">
                            @foreach(GpuBySoftwareReleaseDto gpu in _recommendedGpus)
                            {
                                <MudListItem T="GpuBySoftwareReleaseDto">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                        <MudText>@gpu.Gpu</MudText>
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                       Size="Size.Small"
                                                       Color="Color.Error"
                                                       OnClick="() => RemoveRecommendedGpu(gpu)"/>
                                    </MudStack>
                                </MudListItem>
                            }
                        </MudList>
                    }

                    <MudPaper Class="pa-4 mt-2" Elevation="1">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudAutocomplete T="GpuDto"
                                             Label="@L["Search GPU"]"
                                             @bind-Value="_selectedRecGpu"
                                             SearchFunc="SearchGpus"
                                             ToStringFunc="@(g => g?.Name ?? string.Empty)"
                                             Variant="Variant.Outlined"
                                             Clearable="true"
                                             Style="flex: 1;"/>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       OnClick="AddRecommendedGpu"
                                       Disabled="@(_selectedRecGpu is null)">
                                @L["Add"]
                            </MudButton>
                        </MudStack>
                    </MudPaper>
                </MudTabPanel>

                @* Tab 6 - Sound Synths *@
                <MudTabPanel Text="@L["Sound Synths"]" Icon="@Icons.Material.Filled.MusicNote">
                    @if(_soundSynths is { Count: > 0 })
                    {
                        <MudList T="SoundSynthBySoftwareReleaseDto" Dense="true">
                            @foreach(SoundSynthBySoftwareReleaseDto synth in _soundSynths)
                            {
                                <MudListItem T="SoundSynthBySoftwareReleaseDto">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                        <MudText>@synth.SoundSynth</MudText>
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                       Size="Size.Small"
                                                       Color="Color.Error"
                                                       OnClick="() => RemoveSoundSynth(synth)"/>
                                    </MudStack>
                                </MudListItem>
                            }
                        </MudList>
                    }

                    <MudPaper Class="pa-4 mt-2" Elevation="1">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudAutocomplete T="SoundSynthDto"
                                             Label="@L["Search Sound Synth"]"
                                             @bind-Value="_selectedSoundSynth"
                                             SearchFunc="SearchSoundSynths"
                                             ToStringFunc="@(s => s?.Name ?? string.Empty)"
                                             Variant="Variant.Outlined"
                                             Clearable="true"
                                             Style="flex: 1;"/>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       OnClick="AddSoundSynth"
                                       Disabled="@(_selectedSoundSynth is null)">
                                @L["Add"]
                            </MudButton>
                        </MudStack>
                    </MudPaper>
                </MudTabPanel>

            }
        </MudTabs>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">@L["Save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    string                                  _validationError = null;
    SoftwarePlatformDto                     _selectedPlatform;
    List<SoftwarePlatformDto>               _allPlatforms;
    UnM49Dto                                _selectedRegionToAdd;
    List<UnM49Dto>                          _allUnM49;
    List<UnM49BySoftwareReleaseDto>         _releaseRegions;
    Iso639Dto                               _selectedLanguageToAdd;
    List<Iso639Dto>                         _allLanguages;
    List<LanguageBySoftwareReleaseDto>      _releaseLanguages;
    CompanyDto                              _selectedPublisher;
    List<CompanyDto>                        _allCompanies;
    List<SoftwareBarcodeDto>                _barcodes;
    string                                  _newBarcodeCode;
    int                                      _newBarcodeType;

    List<SoftwareProductCodeDto>            _productCodes;
    string                                  _newProductCode;
    int                                      _newProductCodeIssuer;
    List<GpuBySoftwareReleaseDto>           _minimumGpus;
    GpuDto                                  _selectedMinGpu;
    List<GpuBySoftwareReleaseDto>           _recommendedGpus;
    GpuDto                                  _selectedRecGpu;
    List<GpuDto>                            _allGpus;
    List<SoundSynthBySoftwareReleaseDto>    _soundSynths;
    SoundSynthDto                           _selectedSoundSynth;
    List<SoundSynthDto>                     _allSoundSynths;

    SoftwareCompilationDto                              _selectedCompilation;
    bool                                                 _isCompilation => _selectedCompilation is not null;

    List<SoftwareDto>                                   _allSoftwareForPicker;

    SoftwareDto                                         _selectedSoftware;
    SoftwareVersionDto                                  _selectedVersion;
    List<SoftwareVersionDto>                            _allVersionsForSelectedSoftware;

    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public bool IsNew { get; set; }
    [Parameter] public int ReleaseId { get; set; }
    [Parameter] public int ParentVersionId { get; set; }
    [Parameter] public int? PlatformId { get; set; }

    [Parameter] public int? PublisherId { get; set; }
    [Parameter] public DateTime? ReleaseDate { get; set; }
    [Parameter] public int       ReleaseDatePrecision { get; set; }
    [Parameter] public string Title { get; set; }
    [Parameter] public int? SoftwareCompilationId { get; set; }
    [Parameter] public string SoftwareCompilationName { get; set; }
    [Parameter] public bool LockSoftwareSelection { get; set; }
    [Parameter] public int? SoftwareId { get; set; }
    [Parameter] public string SoftwareName { get; set; }
    [Parameter] public int? SoftwareVersionId { get; set; }

    [Inject] SoftwareReleasesService SoftwareReleasesService { get; set; } = null!;
    [Inject] SoftwareCompilationsService SoftwareCompilationsService { get; set; } = null!;

    bool IsSoftwareSelectionLocked => LockSoftwareSelection && !_isCompilation && SoftwareId is not null;
    bool ShouldShowVersionPicker => !_isCompilation && (_selectedSoftware is not null || IsSoftwareSelectionLocked);

    protected override async Task OnInitializedAsync()
    {
        if(SoftwareCompilationId is not null)
        {
            _selectedCompilation = await SoftwareCompilationsService.GetAsync(SoftwareCompilationId.Value) ??
                                    new SoftwareCompilationDto { Id = SoftwareCompilationId, Name = SoftwareCompilationName };
        }

        bool shouldLoadSoftwarePicker = _isCompilation || !IsSoftwareSelectionLocked;

        // Load independent reference data in parallel to reduce dialog startup latency.
        Task<List<SoftwarePlatformDto>> referencePlatformsTask = SoftwareReleasesService.GetAllPlatformsAsync();
        Task<List<UnM49Dto>> referenceRegionsTask = SoftwareReleasesService.GetAllUnM49Async();
        Task<List<Iso639Dto>> referenceLanguagesTask = SoftwareReleasesService.GetAllLanguagesAsync();
        Task<List<CompanyDto>> referenceCompaniesTask = SoftwareReleasesService.GetAllCompaniesAsync();
        Task<List<GpuDto>> referenceGpusTask = SoftwareReleasesService.GetAllGpusAsync();
        Task<List<SoundSynthDto>> referenceSoundSynthsTask = SoftwareReleasesService.GetAllSoundSynthsAsync();
        Task<List<SoftwareDto>> referenceSoftwareTask = shouldLoadSoftwarePicker
                                                            ? SoftwareReleasesService.GetAllSoftwareForPickerAsync()
                                                            : Task.FromResult(new List<SoftwareDto>());

        await Task.WhenAll(referencePlatformsTask,
                           referenceRegionsTask,
                           referenceLanguagesTask,
                           referenceCompaniesTask,
                           referenceGpusTask,
                           referenceSoundSynthsTask,
                           referenceSoftwareTask);

        _allPlatforms         = referencePlatformsTask.Result;
        _allUnM49             = referenceRegionsTask.Result;
        _allLanguages         = referenceLanguagesTask.Result;
        _allCompanies         = referenceCompaniesTask.Result;
        _allGpus              = referenceGpusTask.Result;
        _allSoundSynths       = referenceSoundSynthsTask.Result;
        _allSoftwareForPicker = referenceSoftwareTask.Result;

        if(PlatformId is not null && _allPlatforms is not null)
            _selectedPlatform = _allPlatforms.Find(p => p.Id == PlatformId);

        if(!IsNew && ReleaseId > 0)
        {
            Task<List<UnM49BySoftwareReleaseDto>> releaseRegionsTask = SoftwareReleasesService.GetReleaseRegionsAsync(ReleaseId);
            Task<List<LanguageBySoftwareReleaseDto>> releaseLanguagesTask = SoftwareReleasesService.GetReleaseLanguagesAsync(ReleaseId);
            Task<List<SoftwareBarcodeDto>> barcodesTask = SoftwareReleasesService.GetBarcodesAsync(ReleaseId);
            Task<List<SoftwareProductCodeDto>> productCodesTask = SoftwareReleasesService.GetProductCodesAsync(ReleaseId);
            Task<List<GpuBySoftwareReleaseDto>> minimumGpusTask = SoftwareReleasesService.GetMinimumGpusAsync(ReleaseId);
            Task<List<GpuBySoftwareReleaseDto>> recommendedGpusTask = SoftwareReleasesService.GetRecommendedGpusAsync(ReleaseId);
            Task<List<SoundSynthBySoftwareReleaseDto>> soundSynthsTask = SoftwareReleasesService.GetSoundSynthsAsync(ReleaseId);

            await Task.WhenAll(releaseRegionsTask,
                               releaseLanguagesTask,
                               barcodesTask,
                               productCodesTask,
                               minimumGpusTask,
                               recommendedGpusTask,
                               soundSynthsTask);

            _releaseRegions   = releaseRegionsTask.Result;
            _releaseLanguages = releaseLanguagesTask.Result;
            _barcodes         = barcodesTask.Result;
            _productCodes     = productCodesTask.Result;
            _minimumGpus      = minimumGpusTask.Result;
            _recommendedGpus  = recommendedGpusTask.Result;
            _soundSynths      = soundSynthsTask.Result;
        }
        else
        {
            _releaseRegions   = [];
            _releaseLanguages = [];
            _barcodes         = [];
            _productCodes     = [];
            _minimumGpus      = [];
            _recommendedGpus  = [];
            _soundSynths      = [];
        }

        if(PublisherId is not null && _allCompanies is not null)
            _selectedPublisher = _allCompanies.Find(c => c.Id == PublisherId);

        // Pre-select software and version for non-compilation releases.
        if(!_isCompilation && SoftwareId is not null)
        {
            if(!IsSoftwareSelectionLocked && _allSoftwareForPicker is not null)
                _selectedSoftware = _allSoftwareForPicker.Find(s => s.Id == SoftwareId);

            await LoadVersionsForSoftwareAsync(SoftwareId.Value);

            if(SoftwareVersionId is not null)
                _selectedVersion = _allVersionsForSelectedSoftware.Find(v => v.Id == SoftwareVersionId);
        }
    }

    Task<IEnumerable<SoftwarePlatformDto>> SearchPlatforms(string value, CancellationToken ct)
    {
        IEnumerable<SoftwarePlatformDto> results = _allPlatforms ?? [];

        if(string.IsNullOrWhiteSpace(value))
            return Task.FromResult(results);

        List<(SoftwarePlatformDto item, double score)> matches =
            JaroWinkler.FindMatches(value, results, p => p.Name, 0.0);

        return Task.FromResult<IEnumerable<SoftwarePlatformDto>>(matches.Select(m => m.item));
    }

    Task<IEnumerable<UnM49Dto>> SearchRegions(string value, CancellationToken ct)
    {
        var assignedIds = new HashSet<int?>(_releaseRegions?.Select(r => r.UnM49Id) ?? []);
        IEnumerable<UnM49Dto> results = (_allUnM49 ?? []).Where(r => !assignedIds.Contains(r.Id));
        if(!string.IsNullOrWhiteSpace(value))
            results = results.Where(r => r.Name?.Contains(value, StringComparison.OrdinalIgnoreCase) ?? false);
        return Task.FromResult(results);
    }

    async Task AddRegion()
    {
        if(_selectedRegionToAdd?.Id is null) return;

        if(ReleaseId > 0)
        {
            await SoftwareReleasesService.AddRegionToReleaseAsync(ReleaseId, _selectedRegionToAdd.Id ?? 0);
            _releaseRegions = await SoftwareReleasesService.GetReleaseRegionsAsync(ReleaseId);
        }
        else
        {
            _releaseRegions ??= [];
            _releaseRegions.Add(new UnM49BySoftwareReleaseDto
            {
                UnM49Id    = _selectedRegionToAdd.Id,
                RegionName = _selectedRegionToAdd.Name
            });
        }

        _selectedRegionToAdd = null;
        StateHasChanged();
    }

    async Task RemoveRegion(UnM49BySoftwareReleaseDto region)
    {
        if(ReleaseId <= 0)
        {
            _releaseRegions?.Remove(region);
            StateHasChanged();

            return;
        }

        await SoftwareReleasesService.RemoveRegionFromReleaseAsync(ReleaseId, region.UnM49Id ?? 0);
        _releaseRegions = await SoftwareReleasesService.GetReleaseRegionsAsync(ReleaseId);
        StateHasChanged();
    }

    Task<IEnumerable<Iso639Dto>> SearchLanguages(string value, CancellationToken ct)
    {
        var assignedCodes = new HashSet<string>(_releaseLanguages?.Select(l => l.LanguageCode) ?? []);
        IEnumerable<Iso639Dto> results = (_allLanguages ?? []).Where(l => !assignedCodes.Contains(l.Id));
        if(!string.IsNullOrWhiteSpace(value))
            results = results.Where(l => l.ReferenceName?.Contains(value, StringComparison.OrdinalIgnoreCase) ?? false);
        return Task.FromResult(results);
    }

    async Task AddLanguage()
    {
        if(_selectedLanguageToAdd?.Id is null) return;

        if(ReleaseId > 0)
        {
            await SoftwareReleasesService.AddLanguageToReleaseAsync(ReleaseId, _selectedLanguageToAdd.Id);
            _releaseLanguages = await SoftwareReleasesService.GetReleaseLanguagesAsync(ReleaseId);
        }
        else
        {
            _releaseLanguages ??= [];
            _releaseLanguages.Add(new LanguageBySoftwareReleaseDto
            {
                LanguageCode = _selectedLanguageToAdd.Id,
                Language     = _selectedLanguageToAdd.ReferenceName
            });
        }

        _selectedLanguageToAdd = null;
        StateHasChanged();
    }

    async Task RemoveLanguage(LanguageBySoftwareReleaseDto lang)
    {
        if(ReleaseId <= 0)
        {
            _releaseLanguages?.Remove(lang);
            StateHasChanged();

            return;
        }

        if(lang.LanguageCode is null) return;

        await SoftwareReleasesService.RemoveLanguageFromReleaseAsync(ReleaseId, lang.LanguageCode);
        _releaseLanguages = await SoftwareReleasesService.GetReleaseLanguagesAsync(ReleaseId);
        StateHasChanged();
    }

