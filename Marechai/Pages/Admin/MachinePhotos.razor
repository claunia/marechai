@page "/admin/machines/{MachineId:int}/photos"
@attribute [Authorize(Roles = "Admin, UberAdmin")]
@using Marechai.ApiClient.Models
@inject MachinePhotosService MachinePhotosService
@inject MachinesService MachinesService
@inject IStringLocalizer<MachinePhotosService> L
@inject IDialogService DialogService
@inject NavigationManager NavigationManager
@inject ApiAssetUrlProvider AssetUrls

<MudPaper Class="pa-6 mb-6" Elevation="0" Style="background: linear-gradient(135deg, #f57f17 0%, #ffca28 100%); border-radius: 16px;">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
        <MudIcon Icon="@Icons.Material.Filled.PhotoLibrary" Size="Size.Large" Style="color: white;"/>
        <MudText Typo="Typo.h4" Style="color: white;">@L["Machine Photos"]</MudText>
    </MudStack>
    <MudText Typo="Typo.subtitle1" Style="color: rgba(255,255,255,0.85);" Class="mt-2">
        @if(!string.IsNullOrWhiteSpace(_machineName))
        {
            @string.Format(L["Manage photos for machine '{0}'."], _machineName)
        }
        else
        {
            @L["Manage photos for this machine."]
        }
    </MudText>
</MudPaper>

<MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" Class="mb-4"
           OnClick="@(() => NavigationManager.NavigateTo("/admin/machines"))">
    @L["Back to machines"]
</MudButton>

@if(!string.IsNullOrWhiteSpace(_errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="() => _errorMessage = null">@_errorMessage</MudAlert>
}

@if(!string.IsNullOrWhiteSpace(_successMessage))
{
    <MudAlert Severity="Severity.Success" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="() => _successMessage = null">@_successMessage</MudAlert>
}

@if(_isLoading)
{
    <div class="d-flex justify-center pa-8">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large"/>
    </div>
    return;
}

@* ── Photos Grid ── *@
<MudPaper Elevation="2" Class="rounded-lg">
    <MudToolBar Dense="true">
        <MudText Typo="Typo.h6">@L["Photos"]</MudText>
        @if(_photos is not null)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Class="ml-2">@_photos.Count</MudChip>
        }
        <MudSpacer/>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.CloudUpload"
                   OnClick="OpenUploadDialog" Class="mr-2">
            @L["Upload photos"]
        </MudButton>
        <MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="LoadPhotosAsync"/>
    </MudToolBar>

    @if(_photos is null || _photos.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Class="ma-4">@L["No photos found for this machine."]</MudAlert>
    }
    else
    {
        <MudGrid Class="pa-4">
            @foreach(MachinePhotoDto photo in _photos)
            {
                <MudItem xs="12" sm="6" md="4" lg="3">
                    <MudCard Elevation="1" Class="rounded-lg">
                        <MudCardContent Class="pa-2 d-flex justify-center">
                            <picture>
                                <source srcset="@(AssetUrls.BaseUrl)/assets/photos/machines/thumbs/avif/4k/@(photo.Id).avif" type="image/avif">
                                <source srcset="@(AssetUrls.BaseUrl)/assets/photos/machines/thumbs/webp/4k/@(photo.Id).webp" type="image/webp">
                                <img alt="" height="auto" src="@(AssetUrls.BaseUrl)/assets/photos/machines/thumbs/jpeg/4k/@(photo.Id).jpg"
                                     srcset="@(AssetUrls.BaseUrl)/assets/photos/machines/thumbs/jpeg/4k/@(photo.Id).jpg"
                                     style="max-height: 256px; max-width: 100%; border-radius: 8px;" width="auto"/>
                            </picture>
                        </MudCardContent>
                        <MudCardContent Class="pa-2">
                            @if(!string.IsNullOrWhiteSpace(photo.CameraManufacturer) || !string.IsNullOrWhiteSpace(photo.CameraModel))
                            {
                                <MudText Typo="Typo.body2" Class="text-truncate">
                                    <MudIcon Icon="@Icons.Material.Filled.CameraAlt" Size="Size.Small" Class="mr-1"/>
                                    @($"{photo.CameraManufacturer} {photo.CameraModel}".Trim())
                                </MudText>
                            }
                            @if(!string.IsNullOrWhiteSpace(photo.LicenseName))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@photo.LicenseName</MudText>
                            }
                            @if(photo.UploadDate is not null)
                            {
                                <MudText Typo="Typo.caption">@photo.UploadDate.Value.Date.ToShortDateString()</MudText>
                            }
                        </MudCardContent>
                        <MudCardActions>
                            <MudButton Href="@($"/machines/photo/{photo.Id}")" Target="_blank" Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.ZoomIn">@L["Details"]</MudButton>
                            <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Delete"
                                       OnClick="() => ConfirmDeletePhoto(photo)">@L["Delete"]</MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
</MudPaper>
