@page "/admin/companies/{CompanyId:int}/logos"
@attribute [Authorize(Roles = "Admin, UberAdmin")]
@using Marechai.ApiClient.Models
@inject CompaniesService CompaniesService
@inject CompanyLogosService CompanyLogosService
@inject IDialogService DialogService
@inject NavigationManager NavigationManager
@inject ApiAssetUrlProvider AssetUrls

<MudPaper Class="pa-6 mb-6" Elevation="0" Style="background: linear-gradient(135deg, #7e57c2 0%, #42a5f5 100%); border-radius: 16px;">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" OnClick="GoBack" Style="color: white;"/>
        <MudIcon Icon="@Icons.Material.Filled.Image" Size="Size.Large" Style="color: white;"/>
        <MudText Typo="Typo.h4" Style="color: white;">Logos — @(_companyName ?? "Loading...")</MudText>
    </MudStack>
</MudPaper>

@if(!string.IsNullOrWhiteSpace(_errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="() => _errorMessage = null">@_errorMessage</MudAlert>
}

@if(!string.IsNullOrWhiteSpace(_successMessage))
{
    <MudAlert Severity="Severity.Success" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="() => _successMessage = null">@_successMessage</MudAlert>
}

@if(_isLoading)
{
    <div class="d-flex justify-center pa-8">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large"/>
    </div>

    return;
}

<MudPaper Elevation="2" Class="rounded-lg pa-4">
    <MudToolBar Dense="true" Class="mb-4">
        <MudFileUpload T="IBrowserFile"
                       FilesChanged="OnFileSelected"
                       Accept=".svg"
                       MaximumFileCount="1">
            <CustomContent>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Upload"
                           Disabled="_isUploading"
                           OnClick="@context.OpenFilePickerAsync">
                    @(_isUploading ? "Uploading..." : "Upload SVG")
                </MudButton>
            </CustomContent>
        </MudFileUpload>
        <MudSpacer/>
        <MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="LoadLogosAsync"/>
    </MudToolBar>

    @if(_logos is { Count: > 0 })
    {
        <MudGrid>
            @foreach(CompanyLogoDto logo in _logos)
            {
                <MudItem xs="12" sm="6" md="4" lg="3">
                    <MudCard Elevation="2">
                        <div style="display: flex; justify-content: center; align-items: center; padding: 16px; min-height: 180px; background: #f5f5f5;">
                            <picture>
                                <source srcset="@(AssetUrls.BaseUrl)/assets/logos/@(logo.Guid).svg" type="image/svg+xml">
                                <source srcset="@(AssetUrls.BaseUrl)/assets/logos/webp/1x/@(logo.Guid).webp,
                                                @(AssetUrls.BaseUrl)/assets/logos/webp/2x/@(logo.Guid).webp 2x,
                                                @(AssetUrls.BaseUrl)/assets/logos/webp/3x/@(logo.Guid).webp 3x" type="image/webp">
                                <img alt="Logo" src="@(AssetUrls.BaseUrl)/assets/logos/png/1x/@(logo.Guid).png"
                                     srcset="@(AssetUrls.BaseUrl)/assets/logos/png/1x/@(logo.Guid).png,
                                             @(AssetUrls.BaseUrl)/assets/logos/png/2x/@(logo.Guid).png 2x,
                                             @(AssetUrls.BaseUrl)/assets/logos/png/3x/@(logo.Guid).png 3x"
                                     style="max-height: 150px; max-width: 100%;"/>
                            </picture>
                        </div>
                        <MudCardContent>
                            <MudText Typo="Typo.body2" Align="Align.Center">@(logo.Year?.ToString() ?? "Year unknown")</MudText>
                        </MudCardContent>
                        <MudCardActions Style="justify-content: center;">
                            <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.CalendarMonth" OnClick="() => OpenChangeYearDialog(logo)">Year</MudButton>
                            <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="() => ConfirmDeleteLogo(logo)">Delete</MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
    else
    {
        <MudText Typo="Typo.body1" Align="Align.Center" Class="pa-8" Style="color: rgba(0,0,0,0.5);">No logos uploaded yet.</MudText>
    }
</MudPaper>
