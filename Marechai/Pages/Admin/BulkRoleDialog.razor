@using MudBlazor
@using Marechai.Services
@inject UsersService UsersService
@inject IStringLocalizer<UsersService> L

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-4">@((MarkupString)string.Format(L["Apply role operation to {0} user(s)"], $"<strong>{UserCount}</strong>"))</MudText>

        <MudRadioGroup T="bool" @bind-Value="_isAdd">
            <MudRadio Value="true" Color="Color.Primary">@L["Add role"]</MudRadio>
            <MudRadio Value="false" Color="Color.Secondary">@L["Remove role"]</MudRadio>
        </MudRadioGroup>

        <MudSelect T="string" @bind-Value="_selectedRole" Label="@L["Select role"]" Variant="Variant.Outlined" Dense="true" Class="mt-4">
            @foreach(string role in AvailableRoles)
            {
                <MudSelectItem T="string" Value="role">@role</MudSelectItem>
            }
        </MudSelect>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit"
                   Disabled="string.IsNullOrWhiteSpace(_selectedRole)">@L["Apply"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    bool    _isAdd        = true;
    string _selectedRole;

    [CascadingParameter]
    IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public int UserCount { get; set; }

    [Parameter]
    public List<string> AvailableRoles { get; set; } = [];

    protected override void OnInitialized() => _selectedRole = AvailableRoles.FirstOrDefault();

    void Cancel() => MudDialog.Cancel();

    void Submit() => MudDialog.Close(DialogResult.Ok(new BulkRoleDialogResult(_selectedRole!, _isAdd)));
}
