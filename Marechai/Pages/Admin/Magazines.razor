@page "/admin/magazines"
@attribute [Authorize(Roles = "Admin, UberAdmin")]
@using Marechai.ApiClient.Models
@using Marechai.Services
@inject MagazinesService MagazinesService
@inject IStringLocalizer<MagazinesService> L
@inject IDialogService DialogService

<MudPaper Class="pa-6 mb-6" Elevation="0" Style="background: linear-gradient(135deg, #ff6f00 0%, #ffa000 100%); border-radius: 16px;">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
        <MudIcon Icon="@Icons.Material.Filled.AutoStories" Size="Size.Large" Style="color: white;"/>
        <MudText Typo="Typo.h4" Style="color: white;">@L["Magazine Management"]</MudText>
    </MudStack>
    <MudText Typo="Typo.subtitle1" Style="color: rgba(255,255,255,0.85);" Class="mt-2">@L["Manage magazines related to computing history."]</MudText>
</MudPaper>

@if(!string.IsNullOrWhiteSpace(_errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="() => _errorMessage = null">@_errorMessage</MudAlert>
}

@if(!string.IsNullOrWhiteSpace(_successMessage))
{
    <MudAlert Severity="Severity.Success" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="() => _successMessage = null">@_successMessage</MudAlert>
}

@if(_isLoading)
{
    <div class="d-flex justify-center pa-8">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large"/>
    </div>
    return;
}

<MudPaper Elevation="2" Class="rounded-lg">
    <MudToolBar Dense="true">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenAddMagazineDialog">@L["Add Magazine"]</MudButton>
        <MudSpacer/>
        <MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="LoadMagazinesAsync"/>
    </MudToolBar>

    <MudDataGrid Items="_magazines" Dense="true" Hover="true" Striped="true" Filterable="true" QuickFilter="QuickFilter">
        <Columns>
            <PropertyColumn Property="x => x.Title" Title="@L["Title"]"/>
            <PropertyColumn Property="x => x.Issn" Title="@L["ISSN"]"/>
            <TemplateColumn Title="@L["First publication"]" Sortable="true">
                <CellTemplate>
                    @FormatDate(context.Item.FirstPublication)
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="@L["Published"]" Sortable="true">
                <CellTemplate>
                    @FormatDate(context.Item.Published)
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.Country" Title="@L["Country"]"/>
            <TemplateColumn Title="@L["Actions"]" Sortable="false">
                <CellTemplate>
                    <MudStack Row="true" Spacing="1">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => OpenEditMagazineDialog(context.Item)" Title="@L["Edit Magazine"]"/>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => ConfirmDeleteMagazine(context.Item)" Title="@L["Delete Magazine"]"/>
                    </MudStack>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </MudDataGrid>
</MudPaper>
