@using Marechai.ApiClient.Models
@using Marechai.Services
@using Marechai.Helpers
@inject MagazinesService MagazinesService
@inject IStringLocalizer<MagazinesService> L
@inject IJSRuntime JsRuntime

<MudDialog>
    <DialogContent>
        @if(!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="() => _errorMessage = null">@_errorMessage</MudAlert>
        }

        @switch(_state)
        {
            case ImportState.Upload:
                <MudStack Spacing="4">
                    <MudText Typo="Typo.body1">@L["Upload a CSV file to import magazine issues in bulk. Download the template first to see the expected format."]</MudText>

                    <MudStack Row="true" Spacing="2">
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Download"
                                   OnClick="DownloadTemplate">
                            @L["Download Template"]
                        </MudButton>
                    </MudStack>

                    <MudFileUpload T="IBrowserFile"
                                   Accept=".csv"
                                   FilesChanged="OnCsvFileSelected"
                                   MaximumFileCount="1">
                        <CustomContent>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Upload"
                                       Disabled="_isProcessing"
                                       OnClick="@context.OpenFilePickerAsync">
                                @(_isProcessing ? L["Processing..."] : L["Upload CSV"])
                            </MudButton>
                        </CustomContent>
                    </MudFileUpload>

                    @if(_isProcessing)
                    {
                        <MudProgressLinear Indeterminate="true" Color="Color.Primary"/>
                    }
                </MudStack>
                break;

            case ImportState.Preview:
                <MudStack Spacing="3">
                    <MudAlert Severity="Severity.Info" Dense="true">
                        @string.Format(L["{0} rows parsed. {1} auto-rejected (duplicate or validation error). Selected rows will be REJECTED — unselected rows will be imported."], _importRows.Count, _importRows.Count(r => r.IsDuplicate || r.ValidationError is not null))
                    </MudAlert>

                    <MudDataGrid T="MagazineIssueImportRow"
                                 Items="_importRows"
                                 MultiSelection="true"
                                 @bind-SelectedItems="_selectedItems"
                                 Dense="true"
                                 Hover="true"
                                 Striped="true"
                                 FixedHeader="true"
                                 Height="400px">
                        <Columns>
                            <SelectColumn T="MagazineIssueImportRow"/>
                            <TemplateColumn Title="@L["Issue Number"]">
                                <CellTemplate>
                                    <div style="@(context.Item.IsDuplicate ? "background-color: #ffe0b2; padding: 4px 8px; border-radius: 4px;" : "")">
                                        @if(context.Item.IsDuplicate)
                                        {
                                            <MudTooltip Text="@L["Duplicate issue"]"><MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small" Color="Color.Warning" Class="mr-1"/></MudTooltip>

                                        }
                                        @(context.Item.IssueNumber?.ToString() ?? "")
                                        @if(context.Item.ValidationError is not null)
                                        {
                                            <MudTooltip Text="@context.Item.ValidationError"><MudIcon Icon="@Icons.Material.Filled.Error" Size="Size.Small" Color="Color.Error" Class="ml-1"/></MudTooltip>

                                        }
                                    </div>
                                </CellTemplate>
                            </TemplateColumn>
                            <PropertyColumn Property="x => x.Caption" Title="@L["Caption"]"/>
                            <PropertyColumn Property="x => x.NativeCaption" Title="@L["Native caption"]"/>
                            <TemplateColumn Title="@L["Published"]">
                                <CellTemplate>
                                    @if(context.Item.PublishedYear is not null)
                                    {
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                            <MudText Typo="Typo.body2">@FormatImportDate(context.Item.PublishedYear, context.Item.PublishedMonth, context.Item.PublishedDay)</MudText>
                                            <MudChip T="string" Size="Size.Small"
                                                     Color="@(context.Item.PublishedPrecision == 0 ? Color.Success : context.Item.PublishedPrecision == 1 ? Color.Warning : Color.Info)"
                                                     Style="white-space: normal; height: auto; overflow: visible; text-overflow: unset; padding: 2px 8px; font-size: 0.7rem;">
                                                @(context.Item.PublishedPrecision switch
                                                {
                                                    0 => L["Full date"],
                                                    1 => L["Month and year only"],
                                                    2 => L["Year only"],
                                                    _ => ""
                                                })
                                            </MudChip>
                                        </MudStack>
                                    }
                                </CellTemplate>
                            </TemplateColumn>
                            <PropertyColumn Property="x => x.ProductCode" Title="@L["Product code"]"/>
                            <PropertyColumn Property="x => x.Pages" Title="@L["Pages"]"/>
                            <TemplateColumn Title="@L["Internet Archive link"]" Sortable="false" Filterable="false">
                                <CellTemplate>
                                    @if(!string.IsNullOrWhiteSpace(context.Item.InternetArchiveUrl))
                                    {
                                        <MudTooltip Text="@context.Item.InternetArchiveUrl">
                                            <MudIcon Icon="@Icons.Material.Filled.Link" Size="Size.Small" Color="Color.Primary"/>
                                        </MudTooltip>
                                    }
                                </CellTemplate>
                            </TemplateColumn>
                        </Columns>
                    </MudDataGrid>
                </MudStack>
                break;

            case ImportState.Importing:
                <MudStack Spacing="3">
                    <MudText Typo="Typo.body1">@string.Format(L["Importing {0} of {1}..."], _importedCount + _failedCount, _totalToImport)</MudText>
                    <MudProgressLinear Value="_progressPercent" Color="Color.Primary" Rounded="true" Size="Size.Large">
                        <ChildContent>
                            <MudText Typo="Typo.body2" Style="color: white;">
                                @($"{_progressPercent:F0}%")
                            </MudText>
                        </ChildContent>
                    </MudProgressLinear>

                    @if(_importRows.Count > 0)
                    {
                        <MudDataGrid T="MagazineIssueImportRow"
                                     Items="_importRows"
                                     Dense="true"
                                     Hover="true"
                                     FixedHeader="true"
                                     Height="300px">
                            <Columns>
                                <TemplateColumn Title="@L["Issue Number"]">
                                    <CellTemplate>
                                        @(context.Item.IssueNumber?.ToString() ?? "")
                                        @if(context.Item.ImportError is not null)
                                        {
                                            <MudTooltip Text="@context.Item.ImportError"><MudIcon Icon="@Icons.Material.Filled.Error" Size="Size.Small" Color="Color.Error" Class="ml-1"/></MudTooltip>

                                        }
                                    </CellTemplate>
                                </TemplateColumn>
                                <PropertyColumn Property="x => x.Caption" Title="@L["Caption"]"/>
                            </Columns>
                        </MudDataGrid>
                    }
                </MudStack>
                break;

            case ImportState.Complete:
                <MudStack Spacing="3">
                    <MudAlert Severity="Severity.Success" Dense="true">
                        @string.Format(L["Import complete. {0} imported, {1} rejected, {2} failed."], _importedCount, _rejectedCount, _failedCount)
                    </MudAlert>

                    @if(_importRows.Count > 0)
                    {
                        <MudText Typo="Typo.body2">@L["The following items were not imported:"]</MudText>

                        <MudDataGrid T="MagazineIssueImportRow"
                                     Items="_importRows"
                                     Dense="true"
                                     Hover="true"
                                     FixedHeader="true"
                                     Height="300px">
                            <Columns>
                                <TemplateColumn Title="@L["Issue Number"]">
                                    <CellTemplate>
                                        @(context.Item.IssueNumber?.ToString() ?? "")
                                    </CellTemplate>
                                </TemplateColumn>
                                <PropertyColumn Property="x => x.Caption" Title="@L["Caption"]"/>
                                <TemplateColumn Title="@L["Published"]">
                                    <CellTemplate>
                                        @FormatImportDate(context.Item.PublishedYear, context.Item.PublishedMonth, context.Item.PublishedDay)
                                    </CellTemplate>
                                </TemplateColumn>
                                <TemplateColumn Title="@L["Status"]">
                                    <CellTemplate>
                                        @if(context.Item.ImportError is not null)
                                        {
                                            <MudChip T="string" Color="Color.Error" Size="Size.Small"
                                                     Style="white-space: normal; height: auto; overflow: visible; text-overflow: unset; padding: 8px 16px;">
                                                @context.Item.ImportError
                                            </MudChip>
                                        }
                                        else if(context.Item.ValidationError is not null)
                                        {
                                            <MudChip T="string" Color="Color.Warning" Size="Size.Small"
                                                     Style="white-space: normal; height: auto; overflow: visible; text-overflow: unset; padding: 8px 16px;">
                                                @context.Item.ValidationError
                                            </MudChip>
                                        }
                                        else if(context.Item.IsDuplicate)
                                        {
                                            <MudChip T="string" Color="Color.Warning" Size="Size.Small">@L["Duplicate issue"]</MudChip>
                                        }
                                        else
                                        {
                                            <MudChip T="string" Color="Color.Default" Size="Size.Small">@L["Rejected"]</MudChip>
                                        }
                                    </CellTemplate>
                                </TemplateColumn>
                            </Columns>
                        </MudDataGrid>

                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Download"
                                   OnClick="DownloadRejected">
                            @L["Download Rejected"]
                        </MudButton>
                    }
                </MudStack>
                break;
        }
    </DialogContent>
    <DialogActions>
        @switch(_state)
        {
            case ImportState.Upload:
                <MudButton OnClick="Cancel">@L["Cancel"]</MudButton>
                break;
            case ImportState.Preview:
                <MudButton OnClick="Cancel">@L["Cancel"]</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="StartImport"
                           Disabled="_importRows.All(r => _selectedItems.Contains(r))">
                    @L["Import"]
                </MudButton>
                break;
            case ImportState.Importing:
                break;
            case ImportState.Complete:
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Close">@L["Close"]</MudButton>
                break;
        }
    </DialogActions>
</MudDialog>

@code {
    static readonly string[] CsvHeaders =
    [
        "Caption", "NativeCaption", "IssueNumber",
        "PublishedYear", "PublishedMonth", "PublishedDay",
        "ProductCode", "Pages", "InternetArchiveUrl"
    ];

    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public long MagazineId { get; set; }

    string                            _errorMessage;
    bool                              _isProcessing;
    ImportState                       _state          = ImportState.Upload;
    List<MagazineIssueImportRow>      _importRows     = [];
    HashSet<MagazineIssueImportRow>   _selectedItems  = [];
    List<MagazineIssueDto>            _existingIssues;
    int                               _importedCount;
    int                               _rejectedCount;
    int                               _failedCount;
    int                               _totalToImport;
    double                            _progressPercent;

    void Cancel() => MudDialog.Cancel();
    void Close() => MudDialog.Close(DialogResult.Ok(true));

    async Task DownloadTemplate()
    {
        string csv    = CsvParser.GenerateTemplate(CsvHeaders);
        byte[] bytes  = System.Text.Encoding.UTF8.GetBytes(csv);
        string base64 = Convert.ToBase64String(bytes);

        await JsRuntime.InvokeVoidAsync("downloadFileFromBytes", "magazine_issue_import_template.csv", "text/csv", base64);
    }

    async Task OnCsvFileSelected(IBrowserFile file)
    {
        if(file is null) return;

        _isProcessing = true;
        _errorMessage = null;
        StateHasChanged();

        try
        {
            using var stream = file.OpenReadStream(10 * 1024 * 1024);
            using var reader = new System.IO.StreamReader(stream);
            string    csvContent = await reader.ReadToEndAsync();

            List<Dictionary<string, string>> rows = CsvParser.Parse(csvContent);

            if(rows.Count == 0)
            {
                _errorMessage = L["The CSV file is empty or has no data rows."];
                _isProcessing = false;
                StateHasChanged();

                return;
            }

            _existingIssues = await MagazinesService.GetIssuesByMagazineAsync(MagazineId);

            _importRows = ParseRows(rows);
            PreSelectRejections();

            _state = ImportState.Preview;
        }
        catch(Exception ex)
        {
            _errorMessage = string.Format(L["Error reading CSV: {0}"], ex.Message);
        }
        finally
        {
            _isProcessing = false;
            StateHasChanged();
        }
    }

    List<MagazineIssueImportRow> ParseRows(List<Dictionary<string, string>> rows)
    {
        var result = new List<MagazineIssueImportRow>();

        foreach(Dictionary<string, string> row in rows)
        {
            var importRow = new MagazineIssueImportRow
            {
                Caption            = GetValueOrNull(row, "Caption"),
                NativeCaption      = GetValueOrNull(row, "NativeCaption"),
                ProductCode        = GetValueOrNull(row, "ProductCode"),
                InternetArchiveUrl = GetValueOrNull(row, "InternetArchiveUrl")
            };

            if(TryParseInt(row, "IssueNumber", out int issueNumber))
                importRow.IssueNumber = issueNumber;

            if(TryParseInt(row, "PublishedYear", out int pubYear))
                importRow.PublishedYear = pubYear;

            if(TryParseInt(row, "PublishedMonth", out int pubMonth))
                importRow.PublishedMonth = pubMonth;

            if(TryParseInt(row, "PublishedDay", out int pubDay))
                importRow.PublishedDay = pubDay;

            if(TryParseShort(row, "Pages", out short pages))
                importRow.Pages = pages;

            // Validate: at minimum need a caption, an issue number, or a published year
            if(string.IsNullOrWhiteSpace(importRow.Caption) &&
               importRow.IssueNumber is null              &&
               importRow.PublishedYear is null)
            {
                importRow.ValidationError =
                    L["Caption, issue number, or published year is required."];
            }

            // Composite duplicate detection: (PublishedYear, PublishedMonth, PublishedDay, IssueNumber)
            // Match if all 4 components are equal AND at least one of (IssueNumber, PublishedYear) is non-null
            // on the import row. This prevents an all-null key from matching every existing all-null record.
            if(_existingIssues is not null &&
               (importRow.IssueNumber.HasValue || importRow.PublishedYear.HasValue))
            {
                int? existingYear  = importRow.PublishedYear;
                int? existingMonth = importRow.PublishedMonth;
                int? existingDay   = importRow.PublishedDay;

                bool dup = _existingIssues.Any(existing =>
                {
                    // PublishedPrecision: 0 = full date, 1 = month+year, 2 = year only
                    int prec    = existing.PublishedPrecision ?? 0;
                    int? eYear  = existing.Published?.Year;
                    int? eMonth = prec == 2          ? null : existing.Published?.Month;
                    int? eDay   = prec == 2 || prec == 1 ? null : existing.Published?.Day;

                    return eYear  == existingYear   &&
                           eMonth == existingMonth  &&
                           eDay   == existingDay    &&
                           NormalizeIssueNumber(existing.IssueNumber) == importRow.IssueNumber;
                });

                if(dup)
                    importRow.IsDuplicate = true;
            }

            result.Add(importRow);
        }

        return result;
    }

    static int? NormalizeIssueNumber(int? value) => value is null or < 0 ? null : value;

    void PreSelectRejections()
    {
        _selectedItems = [];

        foreach(MagazineIssueImportRow row in _importRows)
        {
            if(row.IsDuplicate || row.ValidationError is not null)
                _selectedItems.Add(row);
        }
    }

    async Task StartImport()
    {
        var toImport = _importRows.Where(r => !_selectedItems.Contains(r)).ToList();
        var rejected = _importRows.Where(r =>  _selectedItems.Contains(r)).ToList();

        _rejectedCount   = rejected.Count;
        _importedCount   = 0;
        _failedCount     = 0;
        _totalToImport   = toImport.Count;
        _progressPercent = 0;
        _state           = ImportState.Importing;

        // Keep only rejected/failed in _importRows for display during import
        _importRows = [..rejected];
        StateHasChanged();

        foreach(MagazineIssueImportRow row in toImport)
        {
            var dto = new MagazineIssueDto
            {
                MagazineId         = MagazineId,
                Caption            = row.Caption,
                NativeCaption      = row.NativeCaption,
                Published          = row.PublishedDate.HasValue
                                         ? new DateTimeOffset(row.PublishedDate.Value, TimeSpan.Zero)
                                         : null,
                PublishedPrecision = row.PublishedPrecision,
                ProductCode        = row.ProductCode,
                Pages              = row.Pages,
                IssueNumber        = row.IssueNumber,
                InternetArchiveUrl = row.InternetArchiveUrl
            };

            (long? id, string error) = await MagazinesService.CreateIssueAsync(dto);

            if(id is not null)
            {
                _importedCount++;
            }
            else
            {
                _failedCount++;
                row.ImportError = error ?? L["Unknown error"];
                _importRows.Add(row);
            }

            _progressPercent = (double)(_importedCount + _failedCount) / _totalToImport * 100;
            StateHasChanged();
            await Task.Delay(1); // Allow UI to update
        }

        _state = ImportState.Complete;
        StateHasChanged();
    }

    async Task DownloadRejected()
    {
        var rows = new List<Dictionary<string, string>>();

        foreach(MagazineIssueImportRow row in _importRows)
        {
            var dict = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
            {
                ["Caption"]            = row.Caption ?? "",
                ["NativeCaption"]      = row.NativeCaption ?? "",
                ["IssueNumber"]        = row.IssueNumber?.ToString() ?? "",
                ["PublishedYear"]      = row.PublishedYear?.ToString() ?? "",
                ["PublishedMonth"]     = row.PublishedMonth?.ToString() ?? "",
                ["PublishedDay"]       = row.PublishedDay?.ToString() ?? "",
                ["ProductCode"]        = row.ProductCode ?? "",
                ["Pages"]              = row.Pages?.ToString() ?? "",
                ["InternetArchiveUrl"] = row.InternetArchiveUrl ?? ""
            };

            rows.Add(dict);
        }

        string csv    = CsvParser.Generate(CsvHeaders, rows);
        byte[] bytes  = System.Text.Encoding.UTF8.GetBytes(csv);
        string base64 = Convert.ToBase64String(bytes);

        await JsRuntime.InvokeVoidAsync("downloadFileFromBytes", "magazine_issue_import_rejected.csv", "text/csv", base64);
    }

    static string FormatImportDate(int? year, int? month, int? day)
    {
        if(year is null)
            return "";

        if(month is null)
            return year.Value.ToString();

        if(day is null)
            return $"{month.Value:D2}/{year.Value}";

        return $"{day.Value:D2}/{month.Value:D2}/{year.Value}";
    }

    static string GetValueOrNull(Dictionary<string, string> row, string key)
    {
        if(!row.TryGetValue(key, out string val))
            return null;

        string trimmed = val?.Trim() ?? "";

        return string.IsNullOrEmpty(trimmed) ? null : trimmed;
    }

    static bool TryParseInt(Dictionary<string, string> row, string key, out int result)
    {
        result = 0;
        string val = GetValueOrNull(row, key);

        return val is not null && int.TryParse(val, out result);
    }

    static bool TryParseShort(Dictionary<string, string> row, string key, out short result)
    {
        result = 0;
        string val = GetValueOrNull(row, key);

        return val is not null && short.TryParse(val, out result);
    }

    enum ImportState
    {
        Upload,
        Preview,
        Importing,
        Complete
    }
}
