@using Marechai.ApiClient.Models
@using Marechai.Services
@using System.Threading
@using Microsoft.AspNetCore.Components.Forms

@inject IStringLocalizer<PeopleService> L

<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="Name"
                      Label="@L["Name"]"
                      Variant="Variant.Outlined"
                      Required="true"
                      RequiredError="@L["Name is required."]"
                      Class="mb-4"/>

        <MudTextField @bind-Value="Surname"
                      Label="@L["Surname"]"
                      Variant="Variant.Outlined"
                      Class="mb-4"/>

        <MudTextField @bind-Value="Alias"
                      Label="@L["Alias"]"
                      Variant="Variant.Outlined"
                      Class="mb-4"/>

        <MudTextField @bind-Value="DisplayName"
                      Label="@L["Display name"]"
                      Variant="Variant.Outlined"
                      Class="mb-4"/>

        <MudAutocomplete T="Iso31661NumericDto"
                         Label="@L["Country of birth"]"
                         @bind-Value="_selectedCountry"
                         SearchFunc="SearchCountries"
                         ToStringFunc="@(c => c?.Name ?? string.Empty)"
                         Variant="Variant.Outlined"
                         Clearable="true"
                         Class="mb-4"/>

        <MudDatePicker @bind-Date="BirthDate"
                       Label="@L["Birth date"]"
                       Variant="Variant.Outlined"
                       Clearable="true"
                       Class="mb-4"/>

        <MudSelect T="int" @bind-Value="BirthDatePrecision"
                   Label="@L["Date precision"]"
                   Variant="Variant.Outlined"
                   Class="mb-4">
            <MudSelectItem T="int" Value="0">@L["Full date"]</MudSelectItem>
            <MudSelectItem T="int" Value="1">@L["Month and year only"]</MudSelectItem>
            <MudSelectItem T="int" Value="2">@L["Year only"]</MudSelectItem>
        </MudSelect>

        <MudDatePicker @bind-Date="DeathDate"
                       Label="@L["Death date"]"
                       Variant="Variant.Outlined"
                       Clearable="true"
                       Class="mb-4"/>

        <MudSelect T="int" @bind-Value="DeathDatePrecision"
                   Label="@L["Date precision"]"
                   Variant="Variant.Outlined"
                   Class="mb-4">
            <MudSelectItem T="int" Value="0">@L["Full date"]</MudSelectItem>
            <MudSelectItem T="int" Value="1">@L["Month and year only"]</MudSelectItem>
            <MudSelectItem T="int" Value="2">@L["Year only"]</MudSelectItem>
        </MudSelect>

        <MudTextField @bind-Value="Webpage"
                      Label="@L["Webpage"]"
                      Variant="Variant.Outlined"
                      Class="mb-4"/>

        <MudTextField @bind-Value="Twitter"
                      Label="@L["Twitter"]"
                      Variant="Variant.Outlined"
                      Class="mb-4"/>

        <MudTextField @bind-Value="Facebook"
                      Label="@L["Facebook"]"
                      Variant="Variant.Outlined"
                      Class="mb-4"/>

        @if(!IsNew)
        {
            <MudPaper Outlined="true" Class="pa-3 mb-4">
                <MudText Typo="Typo.subtitle2" Class="mb-2">@L["Photo"]</MudText>

                @if(_hasPhoto)
                {
                    <MudText Typo="Typo.body2" Class="mb-2">@L["This person has a photo."]</MudText>
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                               OnClick="DeletePhoto" Class="mb-3">
                        @L["Delete Photo"]
                    </MudButton>
                }
                else
                {
                    <MudText Typo="Typo.body2" Class="mb-2">@L["No photo."]</MudText>
                }

                <MudFileUpload T="IBrowserFile" Accept=".jpg,.jpeg,.png,.webp,.tiff,.tif,.bmp"
                               FilesChanged="OnPhotoFileSelected" MaximumFileCount="1">
                    <CustomContent>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.CloudUpload"
                                   Disabled="_isUploadingPhoto"
                                   OnClick="@context.OpenFilePickerAsync">
                            @L["Upload Photo"]
                        </MudButton>
                    </CustomContent>
                </MudFileUpload>

                @if(_isUploadingPhoto)
                {
                    <MudProgressLinear Indeterminate="true" Class="mt-2"/>
                }

                @if(!string.IsNullOrWhiteSpace(_photoMessage))
                {
                    <MudAlert Severity="@_photoMessageSeverity" Class="mt-2" ShowCloseIcon="true"
                              CloseIconClicked="() => _photoMessage = null">@_photoMessage</MudAlert>
                }
            </MudPaper>
        }

        @if(!string.IsNullOrWhiteSpace(_validationError))
        {
            <MudAlert Severity="Severity.Error" Class="mt-2">@_validationError</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">@L["Save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    Iso31661NumericDto _selectedCountry;
    string             _validationError;

    List<Iso31661NumericDto> _allCountries;

    [CascadingParameter]
    IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public bool      IsNew       { get; set; }
    [Parameter] public int       PersonId    { get; set; }
    [Parameter] public string    Name        { get; set; } = string.Empty;
    [Parameter] public string   Surname     { get; set; }
    [Parameter] public string   Alias       { get; set; }
    [Parameter] public string   DisplayName { get; set; }
    [Parameter] public int?      CountryId   { get; set; }
    [Parameter] public DateTime? BirthDate   { get; set; }
    [Parameter] public int       BirthDatePrecision { get; set; }
    [Parameter] public DateTime? DeathDate   { get; set; }
    [Parameter] public int       DeathDatePrecision { get; set; }
    [Parameter] public string   Webpage     { get; set; }
    [Parameter] public string   Twitter     { get; set; }
    [Parameter] public string   Facebook    { get; set; }
    [Parameter] public bool     HasPhoto    { get; set; }

    // Photo state
    bool     _hasPhoto;
    bool     _isUploadingPhoto;
    string  _photoMessage;
    Severity _photoMessageSeverity = Severity.Info;

    [Inject] PeopleService PeopleService { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        _hasPhoto     = HasPhoto;
        _allCountries = await PeopleService.GetCountriesAsync();

        if(CountryId is not null && _allCountries is not null)
        {
            _selectedCountry = _allCountries.Find(c => c.Id == CountryId);

            if(_selectedCountry is null)
            {
                // Fallback: list endpoint may not have matched — try to find by scanning
                _selectedCountry = _allCountries.FirstOrDefault(c => c.Id == CountryId);
            }
        }
    }

    Task<IEnumerable<Iso31661NumericDto>> SearchCountries(string value, CancellationToken ct)
    {
        IEnumerable<Iso31661NumericDto> results = _allCountries ?? [];

        if(!string.IsNullOrWhiteSpace(value))
            results = _allCountries?.Where(c => c.Name?.Contains(value, StringComparison.OrdinalIgnoreCase) ?? false) ?? [];

        return Task.FromResult(results);
    }

    async Task OnPhotoFileSelected(IBrowserFile file)
    {
        if(file is null) return;

        _isUploadingPhoto = true;
        _photoMessage     = null;
        StateHasChanged();

        try
        {
            using var stream = file.OpenReadStream(50 * 1024 * 1024); // 50MB limit
            using var ms     = new System.IO.MemoryStream();
            await stream.CopyToAsync(ms);
            ms.Position = 0;

            string contentType = System.IO.Path.GetExtension(file.Name)?.ToLowerInvariant() switch
            {
                ".jpg" or ".jpeg" => "image/jpeg",
                ".png"            => "image/png",
                ".webp"           => "image/webp",
                ".tiff" or ".tif" => "image/tiff",
                ".bmp"            => "image/bmp",
                _                 => "application/octet-stream"
            };

            var multipartBody = new Microsoft.Kiota.Abstractions.MultipartBody();
            multipartBody.AddOrReplacePart("file", contentType, ms, file.Name);

            PersonDto result = await PeopleService.UploadPhotoAsync(PersonId, multipartBody);

            if(result is not null)
            {
                _hasPhoto             = true;
                _photoMessage         = L["Photo uploaded successfully."];
                _photoMessageSeverity = Severity.Success;
            }
            else
            {
                _photoMessage         = L["Failed to upload photo."];
                _photoMessageSeverity = Severity.Error;
            }
        }
        catch(Exception ex)
        {
            _photoMessage         = ex.Message;
            _photoMessageSeverity = Severity.Error;
        }
        finally
        {
            _isUploadingPhoto = false;
            StateHasChanged();
        }
    }

    async Task DeletePhoto()
    {
        (bool succeeded, string error) = await PeopleService.DeletePhotoAsync(PersonId);

        if(succeeded)
        {
            _hasPhoto             = false;
            _photoMessage         = L["Photo deleted."];
            _photoMessageSeverity = Severity.Success;
            StateHasChanged();
        }
        else
        {
            _photoMessage         = error;
            _photoMessageSeverity = Severity.Error;
        }
    }

    void Cancel() => MudDialog.Cancel();

    void Submit()
    {
        if(string.IsNullOrWhiteSpace(Name))
        {
            _validationError = L["Name is required."];

            return;
        }

        MudDialog.Close(DialogResult.Ok(new PersonDialogResult
        {
            Name        = Name,
            Surname     = Surname,
            Alias       = Alias,
            DisplayName = DisplayName,
            CountryId   = _selectedCountry?.Id,
            BirthDate   = BirthDate,
            BirthDatePrecision = BirthDatePrecision,
            DeathDate   = DeathDate,
            DeathDatePrecision = DeathDatePrecision,
            Webpage     = Webpage,
            Twitter     = Twitter,
            Facebook    = Facebook
        }));
    }
}
