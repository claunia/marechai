@using Marechai.ApiClient.Models
@using Marechai.Services
@using System.Threading

@inject IStringLocalizer<SoftwareSubvariantsService> L

<MudDialog>
    <DialogContent>
        <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4">
            @* Tab 1 - Basic Info *@
            <MudTabPanel Text="@L["Basic Info"]" Icon="@Icons.Material.Filled.Info">
                <MudTextField @bind-Value="Name"
                              Label="@L["Name"]"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="@L["Name is required."]"
                              Class="mb-4"/>

                @if(!string.IsNullOrWhiteSpace(_validationError))
                {
                    <MudAlert Severity="Severity.Error" Class="mt-2">@_validationError</MudAlert>
                }
            </MudTabPanel>

            @* Tab 2 - Languages *@
            @if(!IsNew)
            {
                <MudTabPanel Text="@L["Languages"]" Icon="@Icons.Material.Filled.Language">
                    @if(_languages is { Count: > 0 })
                    {
                        <MudList T="SoftwareSubvariantLanguageDto" Dense="true">
                            @foreach(SoftwareSubvariantLanguageDto lang in _languages)
                            {
                                <MudListItem T="SoftwareSubvariantLanguageDto">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                        <MudText>@($"{lang.Language} ({lang.LanguageCode})")</MudText>
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                       Size="Size.Small"
                                                       Color="Color.Error"
                                                       OnClick="() => RemoveLanguage(lang)"/>
                                    </MudStack>
                                </MudListItem>
                            }
                        </MudList>
                    }

                    <MudPaper Class="pa-4 mt-2" Elevation="1">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudTextField @bind-Value="_newLanguageCode"
                                          Label="@L["Language code (ISO 639)"]"
                                          Variant="Variant.Outlined"
                                          Style="flex: 1;"/>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       OnClick="AddLanguage"
                                       Disabled="@(string.IsNullOrWhiteSpace(_newLanguageCode))">
                                @L["Add"]
                            </MudButton>
                        </MudStack>
                    </MudPaper>

                    @if(!string.IsNullOrWhiteSpace(_languageMessage))
                    {
                        <MudAlert Severity="@_languageMessageSeverity" Class="mt-2" ShowCloseIcon="true"
                                  CloseIconClicked="() => _languageMessage = null">@_languageMessage</MudAlert>
                    }
                </MudTabPanel>
            }
        </MudTabs>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">@L["Save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    string?                                 _validationError;
    List<SoftwareSubvariantLanguageDto>?    _languages;
    string?                                 _newLanguageCode;
    string?                                 _languageMessage;
    Severity                                _languageMessageSeverity;

    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public bool IsNew { get; set; }
    [Parameter] public int SubvariantId { get; set; }
    [Parameter] public int ParentVariantId { get; set; }
    [Parameter] public string Name { get; set; } = string.Empty;

    [Inject] SoftwareSubvariantsService SoftwareSubvariantsService { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        if(!IsNew) _languages = await SoftwareSubvariantsService.GetLanguagesAsync(SubvariantId);
    }

    async Task AddLanguage()
    {
        if(string.IsNullOrWhiteSpace(_newLanguageCode)) return;

        var dto = new SoftwareSubvariantLanguageDto
        {
            SubvariantId = SubvariantId,
            LanguageCode = _newLanguageCode.Trim()
        };

        (bool succeeded, string? error) = await SoftwareSubvariantsService.AddLanguageAsync(dto);

        if(succeeded)
        {
            _languages       = await SoftwareSubvariantsService.GetLanguagesAsync(SubvariantId);
            _newLanguageCode = null;
            _languageMessage = null;
        }
        else
        {
            _languageMessage         = error;
            _languageMessageSeverity = Severity.Error;
        }
    }

    async Task RemoveLanguage(SoftwareSubvariantLanguageDto lang)
    {
        (bool succeeded, string? error) =
            await SoftwareSubvariantsService.RemoveLanguageAsync(lang.SubvariantId ?? 0,
                                                                  lang.LanguageCode ?? string.Empty);

        if(succeeded)
        {
            _languages       = await SoftwareSubvariantsService.GetLanguagesAsync(SubvariantId);
            _languageMessage = null;
        }
        else
        {
            _languageMessage         = error;
            _languageMessageSeverity = Severity.Error;
        }
    }

    void Cancel() => MudDialog.Cancel();

    void Submit()
    {
        if(string.IsNullOrWhiteSpace(Name))
        {
            _validationError = L["Name is required."];
            return;
        }

        MudDialog.Close(DialogResult.Ok(new SoftwareSubvariantDialogResult { Name = Name }));
    }
}
