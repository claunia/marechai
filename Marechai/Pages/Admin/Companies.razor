@page "/admin/companies"
@attribute [Authorize(Roles = "Admin, UberAdmin")]
@using Marechai.ApiClient.Models
@inject CompaniesService CompaniesService
@inject IDialogService DialogService
@inject NavigationManager NavigationManager

<MudPaper Class="pa-6 mb-6" Elevation="0" Style="background: linear-gradient(135deg, #7e57c2 0%, #42a5f5 100%); border-radius: 16px;">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
        <MudIcon Icon="@Icons.Material.Filled.Business" Size="Size.Large" Style="color: white;"/>
        <MudText Typo="Typo.h4" Style="color: white;">Company Management</MudText>
    </MudStack>
    <MudText Typo="Typo.subtitle1" Style="color: rgba(255,255,255,0.85);" Class="mt-2">Manage companies, descriptions, logos, and associated people.</MudText>
</MudPaper>

@if(!string.IsNullOrWhiteSpace(_errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="() => _errorMessage = null">@_errorMessage</MudAlert>
}

@if(!string.IsNullOrWhiteSpace(_successMessage))
{
    <MudAlert Severity="Severity.Success" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="() => _successMessage = null">@_successMessage</MudAlert>
}

@if(_isLoading)
{
    <div class="d-flex justify-center pa-8">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large"/>
    </div>

    return;
}

<MudPaper Elevation="2" Class="rounded-lg">
    <MudToolBar Dense="true">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenAddCompanyDialog">Add Company</MudButton>
        <MudSpacer/>
        <MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="LoadCompaniesAsync"/>
    </MudToolBar>

    <MudDataGrid Items="_companies" Dense="true" Hover="true" Striped="true" Filterable="true" QuickFilter="QuickFilter">
        <Columns>
            <PropertyColumn Property="x => x.Name" Title="Name"/>
            <PropertyColumn Property="x => x.LegalName" Title="Legal Name"/>
            <PropertyColumn Property="x => x.Country" Title="Country"/>
            <TemplateColumn Title="Status" Sortable="true" Filterable="true">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.Item.Status)" Variant="Variant.Outlined">@GetStatusText(context.Item.Status)</MudChip>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Founded" Sortable="true">
                <CellTemplate>
                    @FormatDate(context.Item.Founded, context.Item.FoundedDayIsUnknown, context.Item.FoundedMonthIsUnknown)
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Actions" Sortable="false">
                <CellTemplate>
                    <MudStack Row="true" Spacing="1">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => OpenEditCompanyDialog(context.Item)" Title="Edit"/>
                        <MudIconButton Icon="@Icons.Material.Filled.Description" Size="Size.Small" OnClick="() => OpenDescriptionsDialog(context.Item)" Title="Descriptions"/>
                        <MudIconButton Icon="@Icons.Material.Filled.Image" Size="Size.Small" OnClick="() => NavigateToLogos(context.Item)" Title="Logos"/>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => ConfirmDeleteCompany(context.Item)" Title="Delete"/>
                    </MudStack>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </MudDataGrid>
</MudPaper>
