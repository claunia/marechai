@page "/admin/companies"
@attribute [Authorize(Roles = "Admin, UberAdmin")]
@using Marechai.ApiClient.Models
@using Marechai.Services
@inject CompaniesService CompaniesService
@inject IStringLocalizer<CompaniesService> L
@inject IDialogService DialogService
@inject NavigationManager NavigationManager

<MudPaper Class="pa-6 mb-6" Elevation="0" Style="background: linear-gradient(135deg, #7e57c2 0%, #42a5f5 100%); border-radius: 16px;">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
        <MudIcon Icon="@Icons.Material.Filled.Business" Size="Size.Large" Style="color: white;"/>
        <MudText Typo="Typo.h4" Style="color: white;">@L["Company Management"]</MudText>
    </MudStack>
    <MudText Typo="Typo.subtitle1" Style="color: rgba(255,255,255,0.85);" Class="mt-2">@L["Manage companies, descriptions, logos, and associated people."]</MudText>
</MudPaper>

@if(!string.IsNullOrWhiteSpace(_errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="() => _errorMessage = null">@_errorMessage</MudAlert>
}

@if(!string.IsNullOrWhiteSpace(_successMessage))
{
    <MudAlert Severity="Severity.Success" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="() => _successMessage = null">@_successMessage</MudAlert>
}

<MudPaper Elevation="2" Class="rounded-lg">
    <MudToolBar Dense="true">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenAddCompanyDialog">@L["Add Company"]</MudButton>
        <MudSpacer/>
        <MudTextField T="string" ValueChanged="OnSearch" Placeholder="@L["Search by name..."]"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      IconSize="Size.Medium" Class="mt-0" DebounceInterval="300" Immediate="true"/>
        <MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="async () => await _dataGrid.ReloadServerData()"/>
    </MudToolBar>

    <MudDataGrid @ref="_dataGrid" T="CompanyDto" ServerData="ServerReload" Dense="true" Hover="true" Striped="true" RowsPerPage="25">
        <Columns>
            <PropertyColumn Property="x => x.Name" Title="@L["Name"]"/>
            <PropertyColumn Property="x => x.LegalName" Title="@L["Legal name"]"/>
            <PropertyColumn Property="x => x.Country" Title="@L["Country"]"/>
            <TemplateColumn Title="@L["Status"]" Sortable="false">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.Item.Status)" Variant="Variant.Outlined">@GetStatusText(context.Item.Status)</MudChip>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="@L["Founded"]" Sortable="false">
                <CellTemplate>
                    @FormatDate(context.Item.Founded, context.Item.FoundedPrecision)
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="@L["Actions"]" Sortable="false">
                <CellTemplate>
                    <MudStack Row="true" Spacing="1">
                        <MudTooltip Text="@L["Edit"]"><MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => OpenEditCompanyDialog(context.Item)"/></MudTooltip>

                        <MudTooltip Text="@L["Descriptions"]"><MudIconButton Icon="@Icons.Material.Filled.Description" Size="Size.Small" OnClick="() => OpenDescriptionsDialog(context.Item)"/></MudTooltip>

                        <MudTooltip Text="@L["Logos"]"><MudIconButton Icon="@Icons.Material.Filled.Image" Size="Size.Small" OnClick="() => NavigateToLogos(context.Item)"/></MudTooltip>

                        <MudTooltip Text="@L["Delete"]"><MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => ConfirmDeleteCompany(context.Item)"/></MudTooltip>

                    </MudStack>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <PagerContent>
            <MudDataGridPager T="CompanyDto"/>
        </PagerContent>
    </MudDataGrid>
</MudPaper>
