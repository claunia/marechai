@using Marechai.ApiClient.Models
@using Marechai.Services
@using System.Threading

@inject IStringLocalizer<MachinesService> L

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.h6" Class="mb-2">@L["General"]</MudText>

        <MudTextField @bind-Value="Name"
                      Label="@L["Name"]"
                      Variant="Variant.Outlined"
                      Required="true"
                      RequiredError="@L["Name is required."]"
                      Class="mb-4"/>

        <MudTextField @bind-Value="Model"
                      Label="@L["Model"]"
                      Variant="Variant.Outlined"
                      Class="mb-4"/>

        <MudSelect T="int" @bind-Value="Type"
                   Label="@L["Type"]"
                   Variant="Variant.Outlined"
                   Class="mb-4">
            <MudSelectItem T="int" Value="0">@L["Unknown"]</MudSelectItem>
            <MudSelectItem T="int" Value="1">@L["Computer"]</MudSelectItem>
            <MudSelectItem T="int" Value="2">@L["Console"]</MudSelectItem>
        </MudSelect>

        <MudDatePicker @bind-Date="Introduced"
                       Label="@L["Introduction date"]"
                       Variant="Variant.Outlined"
                       Clearable="true"
                       Class="mb-4"/>

        <MudAutocomplete T="CompanyDto"
                         Label="@L["Search Company"]"
                         @bind-Value="_selectedCompany"
                         SearchFunc="SearchCompanies"
                         ToStringFunc="@(c => c?.Name ?? string.Empty)"
                         Variant="Variant.Outlined"
                         Clearable="true"
                         Class="mb-4"/>

        <MudAutocomplete T="MachineFamilyDto"
                         Label="@L["Search Family"]"
                         @bind-Value="_selectedFamily"
                         SearchFunc="SearchFamilies"
                         ToStringFunc="@(f => f?.Name ?? string.Empty)"
                         Variant="Variant.Outlined"
                         Clearable="true"
                         Class="mb-4"/>

        @if(!string.IsNullOrWhiteSpace(_validationError))
        {
            <MudAlert Severity="Severity.Error" Class="mt-2">@_validationError</MudAlert>
        }

        @* Junction sections — only shown when editing an existing machine *@
        @if(!IsNew)
        {
            @* GPUs *@
            <MudDivider Class="my-4"/>
            <MudText Typo="Typo.h6" Class="mb-2">@L["GPUs"]</MudText>

            @if(_machineGpus is { Count: > 0 })
            {
                <MudList T="GpuByMachineDto" Dense="true">
                    @foreach(GpuByMachineDto gpu in _machineGpus)
                    {
                        <MudListItem T="GpuByMachineDto">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                <MudText>@FormatGpu(gpu)</MudText>
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => RemoveGpu(gpu)"/>
                            </MudStack>
                        </MudListItem>
                    }
                </MudList>
            }

            <MudPaper Class="pa-4 mt-2" Elevation="1">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudAutocomplete T="GpuDto"
                                     Label="@L["Search GPU"]"
                                     @bind-Value="_selectedGpu"
                                     SearchFunc="SearchGpus"
                                     ToStringFunc="@(g => g is null ? string.Empty : $"{g.Name} ({g.Company})")"
                                     Variant="Variant.Outlined"
                                     Clearable="true"
                                     Style="flex: 1;"/>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                               OnClick="AddGpu" Disabled="@(_selectedGpu is null)">@L["Add GPU"]</MudButton>
                </MudStack>
            </MudPaper>

            @* Processors *@
            <MudDivider Class="my-4"/>
            <MudText Typo="Typo.h6" Class="mb-2">@L["Processors"]</MudText>

            @if(_machineProcessors is { Count: > 0 })
            {
                <MudList T="ProcessorByMachineDto" Dense="true">
                    @foreach(ProcessorByMachineDto proc in _machineProcessors)
                    {
                        <MudListItem T="ProcessorByMachineDto">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                <MudText>@FormatProcessor(proc)</MudText>
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => RemoveProcessor(proc)"/>
                            </MudStack>
                        </MudListItem>
                    }
                </MudList>
            }

            <MudPaper Class="pa-4 mt-2" Elevation="1">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudAutocomplete T="ProcessorDto"
                                     Label="@L["Search Processor"]"
                                     @bind-Value="_selectedProcessor"
                                     SearchFunc="SearchProcessors"
                                     ToStringFunc="@(p => p is null ? string.Empty : $"{p.Name} ({p.Company})")"
                                     Variant="Variant.Outlined"
                                     Clearable="true"
                                     Style="flex: 1;"/>
                    <MudNumericField T="float?" @bind-Value="_processorSpeed"
                                     Label="@L["Speed (MHz)"]"
                                     Variant="Variant.Outlined"
                                     Clearable="true"
                                     Style="max-width: 150px;"/>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                               OnClick="AddProcessor" Disabled="@(_selectedProcessor is null)">@L["Add Processor"]</MudButton>
                </MudStack>
            </MudPaper>

            @* Sound Synthesizers *@
            <MudDivider Class="my-4"/>
            <MudText Typo="Typo.h6" Class="mb-2">@L["Sound Synthesizers"]</MudText>

            @if(_machineSoundSynths is { Count: > 0 })
            {
                <MudList T="SoundSynthByMachineDto" Dense="true">
                    @foreach(SoundSynthByMachineDto synth in _machineSoundSynths)
                    {
                        <MudListItem T="SoundSynthByMachineDto">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                <MudText>@FormatSoundSynth(synth)</MudText>
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => RemoveSoundSynth(synth)"/>
                            </MudStack>
                        </MudListItem>
                    }
                </MudList>
            }

            <MudPaper Class="pa-4 mt-2" Elevation="1">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudAutocomplete T="SoundSynthDto"
                                     Label="@L["Search Sound Synth"]"
                                     @bind-Value="_selectedSoundSynth"
                                     SearchFunc="SearchSoundSynths"
                                     ToStringFunc="@(s => s is null ? string.Empty : $"{s.Name} ({s.Company})")"
                                     Variant="Variant.Outlined"
                                     Clearable="true"
                                     Style="flex: 1;"/>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                               OnClick="AddSoundSynth" Disabled="@(_selectedSoundSynth is null)">@L["Add Sound Synth"]</MudButton>
                </MudStack>
            </MudPaper>

            @* Screens *@
            <MudDivider Class="my-4"/>
            <MudText Typo="Typo.h6" Class="mb-2">@L["Screens"]</MudText>

            @if(_machineScreens is { Count: > 0 })
            {
                <MudList T="ScreenByMachineDto" Dense="true">
                    @foreach(ScreenByMachineDto screen in _machineScreens)
                    {
                        <MudListItem T="ScreenByMachineDto">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                <MudText>@FormatScreen(screen)</MudText>
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => RemoveScreen(screen)"/>
                            </MudStack>
                        </MudListItem>
                    }
                </MudList>
            }

            <MudPaper Class="pa-4 mt-2" Elevation="1">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudAutocomplete T="ScreenDto"
                                     Label="@L["Search Screen"]"
                                     @bind-Value="_selectedScreen"
                                     SearchFunc="SearchScreens"
                                     ToStringFunc="@(s => s is null ? string.Empty : FormatScreenDto(s))"
                                     Variant="Variant.Outlined"
                                     Clearable="true"
                                     Style="flex: 1;"/>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                               OnClick="AddScreen" Disabled="@(_selectedScreen is null)">@L["Add Screen"]</MudButton>
                </MudStack>
            </MudPaper>

            @* Memory *@
            <MudDivider Class="my-4"/>
            <MudText Typo="Typo.h6" Class="mb-2">@L["Memory"]</MudText>

            @if(_machineMemory is { Count: > 0 })
            {
                <MudList T="MemoryByMachineDto" Dense="true">
                    @foreach(MemoryByMachineDto mem in _machineMemory)
                    {
                        <MudListItem T="MemoryByMachineDto">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                <MudText>@FormatMemory(mem)</MudText>
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => RemoveMemory(mem)"/>
                            </MudStack>
                        </MudListItem>
                    }
                </MudList>
            }

            <MudPaper Class="pa-4 mt-2" Elevation="1">
                <MudStack Spacing="2">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudSelect T="int" @bind-Value="_memoryType"
                                   Label="@L["Memory Type"]"
                                   Variant="Variant.Outlined"
                                   Style="flex: 1;">
                            @for(int i = 0; i < MemoryTypeNames.Length; i++)
                            {
                                int val = i;
                                <MudSelectItem T="int" Value="val">@MemoryTypeNames[val]</MudSelectItem>
                            }
                        </MudSelect>
                        <MudSelect T="int" @bind-Value="_memoryUsage"
                                   Label="@L["Memory Usage"]"
                                   Variant="Variant.Outlined"
                                   Style="flex: 1;">
                            @for(int i = 0; i < MemoryUsageNames.Length; i++)
                            {
                                int val = i;
                                <MudSelectItem T="int" Value="val">@MemoryUsageNames[val]</MudSelectItem>
                            }
                        </MudSelect>
                    </MudStack>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudNumericField T="long?" @bind-Value="_memorySize"
                                         Label="@L["Size (bytes)"]"
                                         Variant="Variant.Outlined"
                                         Clearable="true"
                                         Style="flex: 1;"/>
                        <MudNumericField T="double?" @bind-Value="_memorySpeed"
                                         Label="@L["Speed (MHz) memory"]"
                                         Variant="Variant.Outlined"
                                         Clearable="true"
                                         Style="flex: 1;"/>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                   OnClick="AddMemory">@L["Add Memory"]</MudButton>
                    </MudStack>
                </MudStack>
            </MudPaper>

            @* Storage *@
            <MudDivider Class="my-4"/>
            <MudText Typo="Typo.h6" Class="mb-2">@L["Storage"]</MudText>

            @if(_machineStorage is { Count: > 0 })
            {
                <MudList T="StorageByMachineDto" Dense="true">
                    @foreach(StorageByMachineDto stor in _machineStorage)
                    {
                        <MudListItem T="StorageByMachineDto">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                <MudText>@FormatStorage(stor)</MudText>
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => RemoveStorage(stor)"/>
                            </MudStack>
                        </MudListItem>
                    }
                </MudList>
            }

            <MudPaper Class="pa-4 mt-2" Elevation="1">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudAutocomplete T="int" @bind-Value="_storageType"
                                     Label="@L["Storage Type"]"
                                     SearchFunc="SearchStorageTypes"
                                     ToStringFunc="@(i => i >= -1 && i < StorageTypeNames.Length - 1 ? StorageTypeNames[i + 1] : L["Unknown"])"
                                     Variant="Variant.Outlined"
                                     Style="flex: 1;"/>
                    <MudSelect T="int" @bind-Value="_storageInterface"
                               Label="@L["Storage Interface"]"
                               Variant="Variant.Outlined"
                               Style="flex: 1;">
                        @for(int i = 0; i < StorageInterfaceNames.Length; i++)
                        {
                            int val = i;
                            <MudSelectItem T="int" Value="val">@StorageInterfaceNames[val]</MudSelectItem>
                        }
                    </MudSelect>
                    <MudNumericField T="long?" @bind-Value="_storageCapacity"
                                     Label="@L["Capacity (bytes)"]"
                                     Variant="Variant.Outlined"
                                     Clearable="true"
                                     Style="max-width: 180px;"/>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                               OnClick="AddStorage">@L["Add Storage"]</MudButton>
                </MudStack>
            </MudPaper>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">@L["Save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    CompanyDto?       _selectedCompany;
    MachineFamilyDto? _selectedFamily;
    string?           _validationError;

    // Picker lists
    List<CompanyDto>?       _allCompanies;
    List<MachineFamilyDto>? _allFamilies;
    List<GpuDto>?           _allGpus;
    List<ProcessorDto>?     _allProcessors;
    List<SoundSynthDto>?    _allSoundSynths;
    List<ScreenDto>?        _allScreens;

    // Junction lists
    List<GpuByMachineDto>?        _machineGpus;
    List<ProcessorByMachineDto>?  _machineProcessors;
    List<SoundSynthByMachineDto>? _machineSoundSynths;
    List<ScreenByMachineDto>?     _machineScreens;
    List<MemoryByMachineDto>?     _machineMemory;
    List<StorageByMachineDto>?    _machineStorage;

    // Junction picker state
    GpuDto?        _selectedGpu;
    ProcessorDto?  _selectedProcessor;
    float?         _processorSpeed;
    SoundSynthDto? _selectedSoundSynth;
    ScreenDto?     _selectedScreen;

    // Memory inline creation state
    int     _memoryType;
    int     _memoryUsage;
    long?   _memorySize;
    double? _memorySpeed;

    // Storage inline creation state
    int   _storageType;
    int   _storageInterface;
    long? _storageCapacity;

    [CascadingParameter]
    IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public bool      IsNew      { get; set; }
    [Parameter] public int       MachineId  { get; set; }
    [Parameter] public string    Name       { get; set; } = string.Empty;
    [Parameter] public string?   Model      { get; set; }
    [Parameter] public int?      CompanyId  { get; set; }
    [Parameter] public int       Type       { get; set; }
    [Parameter] public DateTime? Introduced { get; set; }
    [Parameter] public int?      FamilyId   { get; set; }

    [Inject] MachinesService MachinesService { get; set; } = null!;
    [Inject] IDialogService  DialogService   { get; set; } = null!;

    // Enum display names
    static readonly string[] MemoryTypeNames =
    [
        "Unknown", "DRAM", "FPM", "EDO", "VRAM", "SDRAM", "DDR", "DDR2", "DDR3", "DDR4",
        "RDRAM", "SGRAM", "PSRAM", "SRAM", "ROM", "OTP ROM", "PROM", "EPROM", "EEPROM",
        "Flash", "NOR Flash", "NAND Flash", "HCM", "FeRAM", "PCM", "MRAM", "ReRAM",
        "3D XPoint", "XDR", "XDR2", "HBM", "HBM2", "GDDR5", "Bubble"
    ];

    static readonly string[] MemoryUsageNames =
    [
        "Unknown", "Bootloader", "Firmware", "Work", "Video", "Sound", "Wavetable",
        "Storage Buffer", "Save", "Configuration", "Unified"
    ];

    static readonly string[] StorageTypeNames =
    [
        "Empty", "Unknown", "Compact Cassette", "3.5\" Floppy DD", "3.5\" Floppy HD",
        "5.25\" Floppy DD", "5.25\" Floppy HD", "5.25\" Floppy QD", "5.25\" Floppy SD",
        "8\" Floppy DD", "8\" Floppy SD", "3\" Floppy", "3.5\" Floppy ED",
        "Hard Disk Drive", "CD-ROM", "CD-R", "CD-RW", "DVD-ROM", "DVD-R", "DVD-RW",
        "DVD+R", "DVD+RW", "DVD-RAM", "DVD-R DL", "DVD+R DL", "BD-ROM", "BD-R",
        "BD-RE", "BD-R XL", "BD-RE XL", "HD DVD-ROM", "HD DVD-R", "HD DVD-RW",
        "UDO", "UDO2", "MiniDisc", "LaserDisc", "MO 3.5\"", "MO 5.25\"",
        "ZIP 100", "ZIP 250", "ZIP 750", "JAZ 1 GB", "JAZ 2 GB",
        "LS-120", "LS-240", "ORB 2.2 GB",
        "CompactFlash I", "CompactFlash II", "SmartMedia", "MMC", "SD", "miniSD",
        "microSD", "Memory Stick", "Memory Stick Duo", "Memory Stick PRO",
        "Memory Stick PRO Duo", "xD-Picture Card", "RS-MMC",
        "MMCmobile", "MMCplus", "SDHC", "SDXC", "microSDHC", "microSDXC",
        "USB Flash Drive", "SSD",
        "PCE HuCard", "PCE CD-ROM²", "FC Cartridge", "SFC Cartridge",
        "N64 Cartridge", "GB Cartridge", "GBA Cartridge", "GBC Cartridge",
        "NDS Cartridge", "3DS Cartridge", "GameCube GOD", "Wii Disc",
        "Wii U Disc", "Switch Cartridge",
        "SMS Cartridge", "MD Cartridge", "Saturn CD", "DC GD-ROM",
        "GG Cartridge", "32X Cartridge",
        "Atari 2600 Cart", "Atari 5200 Cart", "Atari 7800 Cart",
        "Lynx Cartridge", "Jaguar Cartridge",
        "Neo Geo Cart", "Neo Geo CD", "WonderSwan Cart",
        "PS1 CD", "PS2 DVD", "PS3 BD", "PSP UMD", "PS Vita Card",
        "Xbox DVD", "Xbox 360 DVD", "Xbox One BD",
        "Cassette Tape", "Paper Tape", "Microdrive",
        "QIC", "DLT", "DDS", "LTO", "AIT",
        "8mm Tape", "VHS", "Betamax",
        "PCM Digital Audio Tape",
        "3.5\" Floppy QD", "2.5\" Floppy",
        "SyQuest 44 MB", "SyQuest 88 MB", "SyQuest 200 MB", "SyQuest EZ 135",
        "SyQuest EZ 230", "SyQuest SparQ",
        "Bernoulli Disk", "Bernoulli Disk II",
        "Clik!", "REV", "RDX",
        "8\" Floppy HD", "3.5\" Floptical",
        "HiFD", "UHD144",
        "MO 2.5\"", "MO 8\"", "MO 12\"", "MO 14\"",
        "WORM 5.25\"", "WORM 12\"", "WORM 14\"",
        "PD", "GD-ROM",
        "UMD", "EVD", "FVD", "HVD", "CBHD", "DMD",
        "EC Tape", "IBM 3480", "IBM 3490", "IBM 3590",
        "StorageTek T9840", "StorageTek T9940", "StorageTek T10000",
        "Magstar", "Magstar MP",
        "Punched Card"
    ];

    static readonly string[] StorageInterfaceNames =
    [
        "Unknown", "ACSI", "ATA", "SCSI", "USB", "FireWire", "SATA", "SAS",
        "PCIe", "M.2", "SD/MMC", "CF", "IDE", "Parallel SCSI", "Fibre Channel",
        "Serial Attached SCSI", "Floppy", "Proprietary", "Memory Mapped",
        "NVMe", "SATA Express"
    ];

    protected override async Task OnInitializedAsync()
    {
        _allCompanies = await MachinesService.GetCompaniesAsync();
        _allFamilies  = await MachinesService.GetFamiliesAsync();

        if(CompanyId is not null && _allCompanies is not null)
            _selectedCompany = _allCompanies.Find(c => c.Id == CompanyId);

        if(FamilyId is not null && _allFamilies is not null)
        {
            _selectedFamily = _allFamilies.Find(f => f.Id == FamilyId);

            // Fallback: if family not found in list, fetch it individually and add to list
            if(_selectedFamily is null)
            {
                MachineFamilyDto? family = await MachinesService.GetFamilyByIdAsync(FamilyId.Value);

                if(family is not null)
                {
                    _allFamilies.Add(family);
                    _selectedFamily = family;
                }
            }
        }

        if(!IsNew)
        {
            _allGpus        = await MachinesService.GetAllGpusAsync();
            _allProcessors  = await MachinesService.GetAllProcessorsAsync();
            _allSoundSynths = await MachinesService.GetAllSoundSynthsAsync();
            _allScreens     = await MachinesService.GetAllScreensAsync();

            _machineGpus        = await MachinesService.GetGpusByMachineAsync(MachineId);
            _machineProcessors  = await MachinesService.GetProcessorsByMachineAsync(MachineId);
            _machineSoundSynths = await MachinesService.GetSoundSynthsByMachineAsync(MachineId);
            _machineScreens     = await MachinesService.GetScreensByMachineAsync(MachineId);
            _machineMemory      = await MachinesService.GetMemoryByMachineAsync(MachineId);
            _machineStorage     = await MachinesService.GetStorageByMachineAsync(MachineId);
        }
    }

    // Search functions
    Task<IEnumerable<CompanyDto>> SearchCompanies(string? value, CancellationToken ct)
    {
        IEnumerable<CompanyDto> results = _allCompanies ?? [];

        if(!string.IsNullOrWhiteSpace(value))
            results = _allCompanies?.Where(c => c.Name?.Contains(value, StringComparison.OrdinalIgnoreCase) ?? false) ?? [];

        return Task.FromResult(results);
    }

    Task<IEnumerable<MachineFamilyDto>> SearchFamilies(string? value, CancellationToken ct)
    {
        IEnumerable<MachineFamilyDto> results = _allFamilies ?? [];

        if(!string.IsNullOrWhiteSpace(value))
            results = _allFamilies?.Where(f => f.Name?.Contains(value, StringComparison.OrdinalIgnoreCase) ?? false) ?? [];

        return Task.FromResult(results);
    }

    Task<IEnumerable<GpuDto>> SearchGpus(string? value, CancellationToken ct)
    {
        HashSet<int?> assignedIds = _machineGpus?.Select(g => g.GpuId).ToHashSet() ?? [];
        IEnumerable<GpuDto> available = (_allGpus ?? []).Where(g => !assignedIds.Contains(g.Id));

        if(!string.IsNullOrWhiteSpace(value))
            available = available.Where(g => ($"{g.Name} ({g.Company})").Contains(value, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult(available);
    }

    Task<IEnumerable<ProcessorDto>> SearchProcessors(string? value, CancellationToken ct)
    {
        IEnumerable<ProcessorDto> results = _allProcessors ?? [];

        if(!string.IsNullOrWhiteSpace(value))
            results = results.Where(p => ($"{p.Name} ({p.Company})").Contains(value, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult(results);
    }

    Task<IEnumerable<SoundSynthDto>> SearchSoundSynths(string? value, CancellationToken ct)
    {
        HashSet<int?> assignedIds = _machineSoundSynths?.Select(s => s.SoundSynthId).ToHashSet() ?? [];
        IEnumerable<SoundSynthDto> available = (_allSoundSynths ?? []).Where(s => !assignedIds.Contains(s.Id));

        if(!string.IsNullOrWhiteSpace(value))
            available = available.Where(s => ($"{s.Name} ({s.Company})").Contains(value, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult(available);
    }

    Task<IEnumerable<ScreenDto>> SearchScreens(string? value, CancellationToken ct)
    {
        HashSet<int?> assignedIds = _machineScreens?.Select(s => s.ScreenId).ToHashSet() ?? [];
        IEnumerable<ScreenDto> available = (_allScreens ?? []).Where(s => !assignedIds.Contains(s.Id));

        if(!string.IsNullOrWhiteSpace(value))
            available = available.Where(s => FormatScreenDto(s).Contains(value, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult(available);
    }

    Task<IEnumerable<int>> SearchStorageTypes(string? value, CancellationToken ct)
    {
        // Generate indices from -1 (Empty) to StorageTypeNames.Length - 2
        IEnumerable<int> indices = Enumerable.Range(-1, StorageTypeNames.Length);

        if(!string.IsNullOrWhiteSpace(value))
            indices = indices.Where(i => StorageTypeNames[i + 1].Contains(value, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult(indices);
    }

    // Format functions
    static string FormatGpu(GpuByMachineDto gpu) => $"{gpu.Name} ({gpu.Company})";

    static string FormatProcessor(ProcessorByMachineDto proc) =>
        proc.Speed is not null and > 0 ? $"{proc.Name} ({proc.Company}) @ {proc.Speed} MHz" : $"{proc.Name} ({proc.Company})";

    static string FormatSoundSynth(SoundSynthByMachineDto synth) => $"{synth.Name} ({synth.Company})";

    string FormatScreen(ScreenByMachineDto screen)
    {
        ScreenDto? s = screen.Screen?.ScreenDto;

        return s is null ? $"Screen #{screen.ScreenId}" : FormatScreenDto(s);
    }

    static string FormatScreenDto(ScreenDto s) =>
        string.IsNullOrWhiteSpace(s.Type) ? $"{s.Diagonal}\"" : $"{s.Diagonal}\" {s.Type}";

    string FormatMemory(MemoryByMachineDto mem)
    {
        string type  = mem.Type is >= 0 and < 34 ? MemoryTypeNames[mem.Type.Value] : L["Unknown"];
        string usage = mem.Usage is >= 0 and < 11 ? MemoryUsageNames[mem.Usage.Value] : L["Unknown"];
        string size  = mem.Size.HasValue ? FormatBytes(mem.Size.Value) : L["Unknown"];

        return $"{size} {type} ({usage})";
    }

    string FormatStorage(StorageByMachineDto stor)
    {
        string type = stor.Type is >= -1 ? StorageTypeNames[Math.Min(stor.Type.Value + 1, StorageTypeNames.Length - 1)] : L["Unknown"];
        string iface = stor.Interface is >= 0 and < 21 ? StorageInterfaceNames[stor.Interface.Value] : L["Unknown"];
        string capacity = stor.Capacity.HasValue ? FormatBytes(stor.Capacity.Value) : "";

        return string.IsNullOrEmpty(capacity) ? $"{type} ({iface})" : $"{type} ({iface}) - {capacity}";
    }

    static string FormatBytes(long bytes) => bytes switch
    {
        >= 1073741824 => $"{bytes / 1073741824.0:F1} GiB",
        >= 1048576    => $"{bytes / 1048576.0:F1} MiB",
        >= 1024       => $"{bytes / 1024.0:F1} KiB",
        _             => $"{bytes} bytes"
    };

