    void Cancel() => MudDialog.Cancel();

    void Submit()
    {
        if(string.IsNullOrWhiteSpace(Name))
        {
            _validationError = L["Name is required."];

            return;
        }

        MudDialog.Close(DialogResult.Ok(new MachineDialogResult
        {
            Name       = Name,
            Model      = Model,
            CompanyId  = _selectedCompany?.Id,
            Type       = Type,
            Introduced = Introduced,
            IntroducedPrecision = IntroducedPrecision,
            FamilyId   = _selectedFamily?.Id
        }));
    }
