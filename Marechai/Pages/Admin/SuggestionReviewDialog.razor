@using Marechai.ApiClient.Models
@using Marechai.Data
@using Marechai.Pages.Suggestions
@using Marechai.Suggestions
@inject SuggestionsService Service
@inject ISnackbar          Snackbar
@inject IStringLocalizer<SuggestionsQueue> L

@*
    Admin-side review dialog. Loads the live diff for the suggestion via /suggestions/{id}/diff,
    renders SuggestionDiffPanel with checkboxes per field, and posts the review back when the
    admin clicks Accept Selected or Reject All.
*@

<MudDialog>
    <DialogContent>
        @if(!_loaded)
        {
            <MudProgressLinear Indeterminate="true"/>
        }
        else if(_diff is null)
        {
            <MudAlert Severity="Severity.Error">@L["Failed to load suggestion details."]</MudAlert>
        }
        else
        {
            <MudStack Spacing="2" Class="mb-3">
                @if(_diff.EntityMissing == true)
                {
                    <MudAlert Severity="Severity.Warning">@L["The targeted entity has been deleted. Accepting will close the suggestion as stale."]</MudAlert>
                }
                @if(!Suggestion.EntityId.HasValue)
                {
                    <MudAlert Severity="Severity.Info">@L["This is a brand-new entity suggestion. Name must be accepted to create it."]</MudAlert>
                }
                <MudText Typo="Typo.body2">
                    @if(!Suggestion.EntityId.HasValue)
                    {
                        <strong>@L["New {0}:", EntityTypeLabel]</strong>
                        <text> </text>
                        <text>@(Suggestion.EntityDisplayName ?? "—")</text>
                    }
                    else
                    {
                        <strong>@L["Entity"]:</strong>
                        <text> </text>
                        @($"{EntityTypeLabel} #{Suggestion.EntityId}")
                        @if(!string.IsNullOrWhiteSpace(Suggestion.EntityDisplayName))
                        {
                            <text> — @Suggestion.EntityDisplayName</text>
                        }
                    }
                    @if(!string.IsNullOrEmpty(_diff?.EntitySecondaryLabel))
                    {
                        <text> @_diff.EntitySecondaryLabel</text>
                    }
                </MudText>
                @if(!string.IsNullOrWhiteSpace(Suggestion.UserComment))
                {
                    <MudPaper Outlined="true" Class="pa-2">
                        <MudText Typo="Typo.body2"><strong>@L["User comment:"]</strong></MudText>
                        <MudText Typo="Typo.body2">@Suggestion.UserComment</MudText>
                    </MudPaper>
                }
            </MudStack>

            <SuggestionDiffPanel Suggestion="@Suggestion"
                                 CurrentValuesJson="@_diff.CurrentValuesJson"
                                 CurrentLabels="@_currentLabels"
                                 SuggestedLabels="@_suggestedLabels"
                                 RequireFields="@_requireFields"
                                 AcceptedFieldNames="@_accepted"
                                 AcceptedFieldNamesChanged="OnAcceptedChanged"
                                 ReadOnly="@((SuggestionStatus?)Suggestion.Status != SuggestionStatus.Pending)"/>

            @if((SuggestionStatus?)Suggestion.Status == SuggestionStatus.Pending)
            {
                <MudTextField T="string"
                              @bind-Value="_adminComment"
                              Label="@L["Reviewer comment (optional — included in the message back to the user)"]"
                              Lines="3"
                              MaxLength="2000"
                              Variant="Variant.Outlined"
                              Class="mt-3"/>
            }
            else if(!string.IsNullOrWhiteSpace(Suggestion.AdminReviewComment))
            {
                <MudPaper Outlined="true" Class="pa-2 mt-3">
                    <MudText Typo="Typo.body2"><strong>@L["Reviewer comment:"]</strong></MudText>
                    <MudText Typo="Typo.body2" Style="white-space: pre-wrap;">@Suggestion.AdminReviewComment</MudText>
                </MudPaper>
            }
        }

        @if(!string.IsNullOrEmpty(_error))
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["Cancel"]</MudButton>
        @if((SuggestionStatus?)Suggestion.Status == SuggestionStatus.Pending)
        {
            <MudButton Color="Color.Error" Variant="Variant.Outlined"
                       OnClick="RejectAll" Disabled="@_submitting">
                @L["Reject all"]
            </MudButton>
            <MudButton Color="Color.Primary" Variant="Variant.Filled"
                       OnClick="AcceptSelected" Disabled="@(_submitting || _accepted.Count == 0)">
                @if(_submitting)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true"/>
                }
                else
                {
                    @($"{L["Accept selected"].Value} ({_accepted.Count})")
                }
            </MudButton>
        }
    </DialogActions>
</MudDialog>

@code
{
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; }
    [Parameter] public SuggestionDto Suggestion { get; set; }

    SuggestionDiffDto _diff;
    HashSet<string>   _accepted = new(StringComparer.Ordinal);
    bool              _loaded;
    bool              _submitting;
    string            _error;
    string            _adminComment;
    Dictionary<string, string> _currentLabels;
    Dictionary<string, string> _suggestedLabels;
    string[]          _requireFields;

    string EntityTypeLabel =>
        Suggestion.EntityType.HasValue
            ? ((SuggestionEntityType)Suggestion.EntityType.Value).ToString()
            : string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _diff   = await Service.GetDiffAsync(Suggestion.Id ?? 0);
        _currentLabels   = ToStringMap(_diff?.CurrentLabels?.AdditionalData);
        _suggestedLabels = ToStringMap(_diff?.SuggestedLabels?.AdditionalData);

        // For brand-new entity suggestions, force the metadata-declared primary field (e.g.
        // "name" on Company) into the accepted set: it MUST be checked or the server will
        // refuse to create the entity, so the admin shouldn't be able to uncheck it.
        if(!Suggestion.EntityId.HasValue && Suggestion.EntityType.HasValue)
        {
            SuggestionMetadata md = SuggestionMetadataRegistry.Get((SuggestionEntityType)Suggestion.EntityType.Value);
            if(md?.PrimaryFieldName is not null)
                _requireFields = new[] { md.PrimaryFieldName };
        }

        _loaded = true;
    }

    /// <summary>
    ///     Kiota deserialises the per-field FK label maps into an <see cref="IAdditionalDataHolder" />
    ///     wrapper (each value boxed as <see cref="System.Text.Json.JsonElement" />). Convert to
    ///     a plain <c>Dictionary&lt;string, string&gt;</c> for the diff panel.
    /// </summary>
    static Dictionary<string, string> ToStringMap(IDictionary<string, object> source)
    {
        if(source is null || source.Count == 0) return null;
        var result = new Dictionary<string, string>(StringComparer.Ordinal);
        foreach(KeyValuePair<string, object> kv in source)
        {
            if(kv.Value is null) continue;
            string s = kv.Value switch
            {
                string str                                                  => str,
                System.Text.Json.JsonElement je when je.ValueKind == System.Text.Json.JsonValueKind.String => je.GetString(),
                System.Text.Json.JsonElement je                             => je.ToString(),
                _                                                           => kv.Value.ToString()
            };
            if(!string.IsNullOrEmpty(s)) result[kv.Key] = s;
        }
        return result.Count == 0 ? null : result;
    }

    void OnAcceptedChanged(HashSet<string> updated)
    {
        // The HashSet is shared by reference with the child, so _accepted is already updated.
        // We just need StateHasChanged so the Accept Selected button re-evaluates Disabled / count.
        _accepted = updated ?? new HashSet<string>(StringComparer.Ordinal);
        StateHasChanged();
    }

    void Cancel() => MudDialog.Cancel();

    async Task AcceptSelected()
    {
        await SubmitAsync(_accepted);
    }

    async Task RejectAll()
    {
        await SubmitAsync(new HashSet<string>(StringComparer.Ordinal));
    }

    async Task SubmitAsync(HashSet<string> accepted)
    {
        _submitting = true;
        _error      = null;
        try
        {
            var review = new SuggestionReviewDto
            {
                AcceptedFieldNames = accepted.ToList(),
                AdminComment       = string.IsNullOrWhiteSpace(_adminComment) ? null : _adminComment.Trim()
            };

            var (updated, error) = await Service.ReviewAsync(Suggestion.Id ?? 0, review);

            if(updated is null)
            {
                _error = string.IsNullOrWhiteSpace(error) ? L["Failed to submit review."].Value : error;
                return;
            }

            Snackbar.Add(L["Suggestion reviewed."], Severity.Success);
            MudDialog.Close(DialogResult.Ok(updated));
        }
        finally
        {
            _submitting = false;
        }
    }
}
