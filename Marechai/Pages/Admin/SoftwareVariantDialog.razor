@using Marechai.ApiClient.Models
@using Marechai.Services
@using System.Threading

@inject IStringLocalizer<SoftwareVariantsService> L

<MudDialog>
    <DialogContent>
        <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4">
            @* Tab 1 - Basic Info *@
            <MudTabPanel Text="@L["Basic Info"]" Icon="@Icons.Material.Filled.Info">
                <MudTextField @bind-Value="Name"
                              Label="@L["Name"]"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="@L["Name is required."]"
                              Class="mb-4"/>

                @if(!string.IsNullOrWhiteSpace(_validationError))
                {
                    <MudAlert Severity="Severity.Error" Class="mt-2">@_validationError</MudAlert>
                }
            </MudTabPanel>

            @* Tab 2 - Languages *@
            @if(!IsNew)
            {
                <MudTabPanel Text="@L["Languages"]" Icon="@Icons.Material.Filled.Language">
                    @if(_languages is { Count: > 0 })
                    {
                        <MudList T="SoftwareVariantLanguageDto" Dense="true">
                            @foreach(SoftwareVariantLanguageDto lang in _languages)
                            {
                                <MudListItem T="SoftwareVariantLanguageDto">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                        <MudText>@($"{lang.Language} ({lang.LanguageCode})")</MudText>
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                       Size="Size.Small"
                                                       Color="Color.Error"
                                                       OnClick="() => RemoveLanguage(lang)"/>
                                    </MudStack>
                                </MudListItem>
                            }
                        </MudList>
                    }

                    <MudPaper Class="pa-4 mt-2" Elevation="1">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudTextField @bind-Value="_newLanguageCode"
                                          Label="@L["Language code (ISO 639)"]"
                                          Variant="Variant.Outlined"
                                          Style="flex: 1;"/>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       OnClick="AddLanguage"
                                       Disabled="@(string.IsNullOrWhiteSpace(_newLanguageCode))">
                                @L["Add"]
                            </MudButton>
                        </MudStack>
                    </MudPaper>

                    @if(!string.IsNullOrWhiteSpace(_languageMessage))
                    {
                        <MudAlert Severity="@_languageMessageSeverity" Class="mt-2" ShowCloseIcon="true"
                                  CloseIconClicked="() => _languageMessage = null">@_languageMessage</MudAlert>
                    }
                </MudTabPanel>

                @* Tab 3 - Company Roles *@
                <MudTabPanel Text="@L["Companies"]" Icon="@Icons.Material.Filled.Business">
                    @if(_companyRoles is { Count: > 0 })
                    {
                        <MudList T="CompanyBySoftwareVariantDto" Dense="true">
                            @foreach(CompanyBySoftwareVariantDto role in _companyRoles)
                            {
                                <MudListItem T="CompanyBySoftwareVariantDto">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                        <MudText>@($"{role.Company} ({role.Role})")</MudText>
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                       Size="Size.Small"
                                                       Color="Color.Error"
                                                       OnClick="() => RemoveCompanyRole(role)"/>
                                    </MudStack>
                                </MudListItem>
                            }
                        </MudList>
                    }

                    <MudPaper Class="pa-4 mt-2" Elevation="1">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudAutocomplete T="CompanyDto"
                                             Label="@L["Search Company"]"
                                             @bind-Value="_selectedCompany"
                                             SearchFunc="SearchCompanies"
                                             ToStringFunc="@(c => c?.Name ?? string.Empty)"
                                             Variant="Variant.Outlined"
                                             Clearable="true"
                                             Style="flex: 1;"/>
                            <MudSelect T="SoftwareRoleDto"
                                       @bind-Value="_selectedRole"
                                       Label="@L["Role"]"
                                       ToStringFunc="@(r => r?.Name ?? string.Empty)"
                                       Variant="Variant.Outlined"
                                       Style="max-width: 200px;">
                                @if(_allRoles is not null)
                                {
                                    @foreach(SoftwareRoleDto role in _allRoles)
                                    {
                                        <MudSelectItem T="SoftwareRoleDto" Value="role">@role.Name</MudSelectItem>
                                    }
                                }
                            </MudSelect>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       OnClick="AddCompanyRole"
                                       Disabled="@(_selectedCompany is null || _selectedRole is null)">
                                @L["Add"]
                            </MudButton>
                        </MudStack>
                    </MudPaper>

                    @if(!string.IsNullOrWhiteSpace(_companyRoleMessage))
                    {
                        <MudAlert Severity="@_companyRoleMessageSeverity" Class="mt-2" ShowCloseIcon="true"
                                  CloseIconClicked="() => _companyRoleMessage = null">@_companyRoleMessage</MudAlert>
                    }
                </MudTabPanel>
            }
        </MudTabs>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">@L["Save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    string?                              _validationError;
    List<SoftwareVariantLanguageDto>?    _languages;
    string?                              _newLanguageCode;
    string?                              _languageMessage;
    Severity                             _languageMessageSeverity;
    CompanyDto?                          _selectedCompany;
    List<CompanyDto>?                    _allCompanies;
    SoftwareRoleDto?                     _selectedRole;
    List<SoftwareRoleDto>?               _allRoles;
    List<CompanyBySoftwareVariantDto>?   _companyRoles;
    string?                              _companyRoleMessage;
    Severity                             _companyRoleMessageSeverity;

    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public bool IsNew { get; set; }
    [Parameter] public int VariantId { get; set; }
    [Parameter] public int ParentSoftwareId { get; set; }
    [Parameter] public string Name { get; set; } = string.Empty;

    [Inject] SoftwareVariantsService SoftwareVariantsService { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        if(!IsNew)
        {
            _languages    = await SoftwareVariantsService.GetLanguagesAsync(VariantId);
            _allCompanies = await SoftwareVariantsService.GetAllCompaniesAsync();
            _allRoles     = await SoftwareVariantsService.GetSoftwareRolesAsync();
            _companyRoles = await SoftwareVariantsService.GetCompanyRolesAsync(VariantId);
        }
    }

    Task<IEnumerable<CompanyDto>> SearchCompanies(string? value, CancellationToken ct)
    {
        IEnumerable<CompanyDto> results = _allCompanies ?? [];

        if(!string.IsNullOrWhiteSpace(value))
        {
            results = _allCompanies?
                         .Where(c => c.Name?.Contains(value, StringComparison.OrdinalIgnoreCase) ?? false) ??
                      [];
        }

        return Task.FromResult(results);
    }

    async Task AddLanguage()
    {
        if(string.IsNullOrWhiteSpace(_newLanguageCode)) return;

        var dto = new SoftwareVariantLanguageDto
        {
            VariantId    = VariantId,
            LanguageCode = _newLanguageCode.Trim()
        };

        (bool succeeded, string? error) = await SoftwareVariantsService.AddLanguageAsync(dto);

        if(succeeded)
        {
            _languages        = await SoftwareVariantsService.GetLanguagesAsync(VariantId);
            _newLanguageCode  = null;
            _languageMessage  = null;
        }
        else
        {
            _languageMessage         = error;
            _languageMessageSeverity = Severity.Error;
        }
    }

    async Task RemoveLanguage(SoftwareVariantLanguageDto lang)
    {
        (bool succeeded, string? error) =
            await SoftwareVariantsService.RemoveLanguageAsync(lang.VariantId ?? 0, lang.LanguageCode ?? string.Empty);

        if(succeeded)
        {
            _languages       = await SoftwareVariantsService.GetLanguagesAsync(VariantId);
            _languageMessage = null;
        }
        else
        {
            _languageMessage         = error;
            _languageMessageSeverity = Severity.Error;
        }
    }

    async Task AddCompanyRole()
    {
        if(_selectedCompany is null || _selectedRole is null) return;

        var dto = new CompanyBySoftwareVariantDto
        {
            SoftwareVariantId = VariantId,
            CompanyId         = _selectedCompany.Id,
            RoleId            = _selectedRole.Id
        };

        (int? id, string? error) = await SoftwareVariantsService.AddCompanyRoleAsync(dto);

        if(id is not null)
        {
            _companyRoles       = await SoftwareVariantsService.GetCompanyRolesAsync(VariantId);
            _selectedCompany    = null;
            _selectedRole       = null;
            _companyRoleMessage = null;
        }
        else
        {
            _companyRoleMessage         = error;
            _companyRoleMessageSeverity = Severity.Error;
        }
    }

    async Task RemoveCompanyRole(CompanyBySoftwareVariantDto role)
    {
        (bool succeeded, string? error) = await SoftwareVariantsService.RemoveCompanyRoleAsync(role.Id ?? 0);

        if(succeeded)
        {
            _companyRoles       = await SoftwareVariantsService.GetCompanyRolesAsync(VariantId);
            _companyRoleMessage = null;
        }
        else
        {
            _companyRoleMessage         = error;
            _companyRoleMessageSeverity = Severity.Error;
        }
    }

    void Cancel() => MudDialog.Cancel();

    void Submit()
    {
        if(string.IsNullOrWhiteSpace(Name))
        {
            _validationError = L["Name is required."];
            return;
        }

        MudDialog.Close(DialogResult.Ok(new SoftwareVariantDialogResult { Name = Name }));
    }
}
