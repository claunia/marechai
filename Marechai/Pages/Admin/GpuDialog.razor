@using Marechai.ApiClient.Models
@using Marechai.Services
@using System.Threading

@inject IStringLocalizer<GpusService> L

<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="Name"
                      Label="@L["Name"]"
                      Variant="Variant.Outlined"
                      Required="true"
                      RequiredError="@L["Name is required."]"
                      Class="mb-4"/>

        <MudAutocomplete T="CompanyDto"
                         Label="@L["Search Company"]"
                         @bind-Value="_selectedCompany"
                         SearchFunc="SearchCompanies"
                         ToStringFunc="@(c => c?.Name ?? string.Empty)"
                         Variant="Variant.Outlined"
                         Clearable="true"
                         Class="mb-4"/>

        <MudTextField @bind-Value="ModelCode"
                      Label="@L["Model code"]"
                      Variant="Variant.Outlined"
                      Class="mb-4"/>

        <MudDatePicker @bind-Date="Introduced"
                       Label="@L["Introduction date"]"
                       Variant="Variant.Outlined"
                       Clearable="true"
                       Class="mb-4"/>

        <MudSelect T="int" @bind-Value="IntroducedPrecision"
                   Label="@L["Date precision"]"
                   Variant="Variant.Outlined"
                   Class="mb-4">
            <MudSelectItem T="int" Value="0">@L["Full date"]</MudSelectItem>
            <MudSelectItem T="int" Value="1">@L["Month and year only"]</MudSelectItem>
            <MudSelectItem T="int" Value="2">@L["Year only"]</MudSelectItem>
        </MudSelect>

        <MudTextField @bind-Value="Package"
                      Label="@L["Package"]"
                      Variant="Variant.Outlined"
                      Class="mb-4"/>

        <MudTextField @bind-Value="Process"
                      Label="@L["Process"]"
                      Variant="Variant.Outlined"
                      Class="mb-4"/>

        <MudNumericField T="float?" @bind-Value="ProcessNm"
                         Label="@L["Process (nm)"]"
                         Variant="Variant.Outlined"
                         Clearable="true"
                         Class="mb-4"/>

        <MudNumericField T="float?" @bind-Value="DieSize"
                         Label="@L["Die size (mm²)"]"
                         Variant="Variant.Outlined"
                         Clearable="true"
                         Class="mb-4"/>

        <MudNumericField T="long?" @bind-Value="Transistors"
                         Label="@L["Transistors"]"
                         Variant="Variant.Outlined"
                         Clearable="true"
                         Class="mb-4"/>

        @if(!string.IsNullOrWhiteSpace(_validationError))
        {
            <MudAlert Severity="Severity.Error" Class="mt-2">@_validationError</MudAlert>
        }

        @if(!IsNew)
        {
            <MudDivider Class="my-4"/>
            <MudText Typo="Typo.h6" Class="mb-2">@L["Supported resolutions"]</MudText>

            @if(_gpuResolutions is { Count: > 0 })
            {
                <MudList T="ResolutionByGpuDto" Dense="true">
                    @foreach(ResolutionByGpuDto res in _gpuResolutions)
                    {
                        <MudListItem T="ResolutionByGpuDto">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                <MudText>@FormatResolution(res)</MudText>
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => RemoveResolution(res)"/>
                            </MudStack>
                        </MudListItem>
                    }
                </MudList>
            }

            <MudPaper Class="pa-4 mt-2" Elevation="1">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudAutocomplete T="ResolutionDto"
                                     Label="@L["Search Resolution"]"
                                     @bind-Value="_selectedResolution"
                                     SearchFunc="SearchResolutions"
                                     ToStringFunc="@(r => r is null ? string.Empty : FormatResolutionDto(r))"
                                     Variant="Variant.Outlined"
                                     Clearable="true"
                                     Style="flex: 1;"/>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Small"
                               OnClick="AddResolution"
                               Disabled="@(_selectedResolution is null)">@L["Add Resolution"]</MudButton>
                </MudStack>
            </MudPaper>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">@L["Save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    CompanyDto?        _selectedCompany;
    ResolutionDto?     _selectedResolution;
    string?            _validationError;

    List<CompanyDto>?          _allCompanies;
    List<ResolutionDto>?       _allResolutions;
    List<ResolutionByGpuDto>?  _gpuResolutions;

    [CascadingParameter]
    IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public bool      IsNew       { get; set; }
    [Parameter] public int       GpuId       { get; set; }
    [Parameter] public string    Name        { get; set; } = string.Empty;
    [Parameter] public int?      CompanyId   { get; set; }
    [Parameter] public string?   ModelCode   { get; set; }
    [Parameter] public DateTime? Introduced  { get; set; }
    [Parameter] public int       IntroducedPrecision { get; set; }
    [Parameter] public string?   Package     { get; set; }
    [Parameter] public string?   Process     { get; set; }
    [Parameter] public float?    ProcessNm   { get; set; }
    [Parameter] public float?    DieSize     { get; set; }
    [Parameter] public long?     Transistors { get; set; }

    [Inject] GpusService    GpusService    { get; set; } = null!;
    [Inject] IDialogService DialogService  { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        _allCompanies   = await GpusService.GetCompaniesAsync();
        _allResolutions = await GpusService.GetAllResolutionsAsync();

        if(CompanyId is not null && _allCompanies is not null)
            _selectedCompany = _allCompanies.Find(c => c.Id == CompanyId);

        if(!IsNew)
            _gpuResolutions = await GpusService.GetResolutionsByGpuAsync(GpuId);
    }

    Task<IEnumerable<CompanyDto>> SearchCompanies(string? value, CancellationToken ct)
    {
        IEnumerable<CompanyDto> results = _allCompanies ?? [];

        if(!string.IsNullOrWhiteSpace(value))
            results = _allCompanies?.Where(c => c.Name?.Contains(value, StringComparison.OrdinalIgnoreCase) ?? false) ?? [];

        return Task.FromResult(results);
    }

    Task<IEnumerable<ResolutionDto>> SearchResolutions(string? value, CancellationToken ct)
    {
        HashSet<int?> assignedIds = _gpuResolutions?.Select(r => r.ResolutionId).ToHashSet() ?? [];

        IEnumerable<ResolutionDto> available = (_allResolutions ?? []).Where(r => !assignedIds.Contains(r.Id));

        if(!string.IsNullOrWhiteSpace(value))
            available = available.Where(r => FormatResolutionDto(r).Contains(value, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult(available);
    }

    string FormatResolution(ResolutionByGpuDto res)
    {
        // Kiota composed type deserialization is broken for nested DTOs — look up from pre-loaded list
        ResolutionDto? r = _allResolutions?.Find(x => x.Id == res.ResolutionId);

        if(r is null)
            return $"{res.ResolutionId}";

        return FormatResolutionDto(r);
    }

    string FormatResolutionDto(ResolutionDto r)
    {
        string dims = $"{r.Width}×{r.Height}";

        if(r.Chars == true)
            return $"{dims} {string.Format(L["{0} characters"], r.Colors)}";

        if(r.Grayscale == true)
            return $"{dims} {string.Format(L["{0} grays"], r.Colors)}";

        if(r.Palette is not null and > 0)
            return $"{dims} {string.Format(L["{0} colors from {1} palette"], r.Colors, r.Palette)}";

        return $"{dims} {string.Format(L["{0} colors"], r.Colors)}";
    }

    async Task AddResolution()
    {
        if(_selectedResolution is null) return;

        var dto = new ResolutionByGpuDto
        {
            GpuId        = GpuId,
            ResolutionId = _selectedResolution.Id
        };

        (long? id, string? error) = await GpusService.AddResolutionToGpuAsync(dto);

        if(id is not null)
        {
            _gpuResolutions    = await GpusService.GetResolutionsByGpuAsync(GpuId);
            _selectedResolution = null;
            StateHasChanged();
        }
        else
        {
            _validationError = error ?? "Failed to add resolution.";
        }
    }

    async Task RemoveResolution(ResolutionByGpuDto res)
    {
        if(res.Id is null) return;

        DialogParameters<DeleteConfirmDialog> parameters = new()
        {
            {
                x => x.ContentText,
                $"{L["Are you sure you want to delete GPU '{0}'? This action cannot be undone.", FormatResolution(res)]}"
            }
        };

        IDialogReference dialog = await DialogService.ShowAsync<DeleteConfirmDialog>(L["Delete GPU"], parameters,
                                                                                     new DialogOptions
                                                                                     {
                                                                                         MaxWidth  = MaxWidth.ExtraSmall,
                                                                                         FullWidth = true
                                                                                     });

        DialogResult? result = await dialog.Result;

        if(result is { Canceled: false })
        {
            (bool succeeded, string? error) = await GpusService.RemoveResolutionFromGpuAsync(res.Id.Value);

            if(succeeded)
            {
                _gpuResolutions = await GpusService.GetResolutionsByGpuAsync(GpuId);
                StateHasChanged();
            }
            else
            {
                _validationError = error ?? "Failed to remove resolution.";
            }
        }
    }

    void Cancel() => MudDialog.Cancel();

    void Submit()
    {
        if(string.IsNullOrWhiteSpace(Name))
        {
            _validationError = L["Name is required."];

            return;
        }

        MudDialog.Close(DialogResult.Ok(new GpuDialogResult
        {
            Name        = Name,
            CompanyId   = _selectedCompany?.Id,
            ModelCode   = ModelCode,
            Introduced  = Introduced,
            IntroducedPrecision = IntroducedPrecision,
            Package     = Package,
            Process     = Process,
            ProcessNm   = ProcessNm,
            DieSize     = DieSize,
            Transistors = Transistors
        }));
    }
}
