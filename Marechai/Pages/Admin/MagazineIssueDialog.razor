@using Marechai.ApiClient.Models
@using Marechai.Services
@using Microsoft.AspNetCore.Components.Forms

@inject IStringLocalizer<MagazinesService> L
@inject MagazinesService Service

<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="Caption"
                      Label="@L["Caption"]"
                      Variant="Variant.Outlined"
                      Required="true"
                      RequiredError="@L["Caption is required."]"
                      Class="mb-4"/>

        <MudTextField @bind-Value="NativeCaption"
                      Label="@L["Native caption"]"
                      Variant="Variant.Outlined"
                      Class="mb-4"/>

        <MudNumericField T="uint?" @bind-Value="IssueNumber"
                         Label="@L["Issue Number"]"
                         Variant="Variant.Outlined"
                         Min="1u"
                         Clearable="true"
                         Class="mb-4"/>

        <MudDatePicker @bind-Date="Published"
                       Label="@L["Published"]"
                       Variant="Variant.Outlined"
                       Clearable="true"
                       Class="mb-4"/>

        <MudSelect T="int" @bind-Value="PublishedPrecision"
                   Label="@L["Date precision"]"
                   Variant="Variant.Outlined"
                   Class="mb-4">
            <MudSelectItem T="int" Value="0">@L["Full date"]</MudSelectItem>
            <MudSelectItem T="int" Value="1">@L["Month and year only"]</MudSelectItem>
            <MudSelectItem T="int" Value="2">@L["Year only"]</MudSelectItem>
        </MudSelect>

        <MudTextField @bind-Value="ProductCode"
                      Label="@L["Product code"]"
                      Variant="Variant.Outlined"
                      MaxLength="18"
                      Class="mb-4"/>

        <MudNumericField T="short?" @bind-Value="Pages"
                         Label="@L["Pages"]"
                         Variant="Variant.Outlined"
                         Min="(short)1"
                         Clearable="true"
                         Class="mb-4"/>

        <MudTextField @bind-Value="InternetArchiveUrl"
                      Label="@L["Internet Archive link"]"
                      Variant="Variant.Outlined"
                      MaxLength="2048"
                      InputType="InputType.Url"
                      Placeholder="https://archive.org/details/..."
                      Class="mb-4"/>

        @if(IsEdit)
        {
            <MudDivider Class="my-4"/>
            <MudText Typo="Typo.h6" Class="mb-2">@L["Cover"]</MudText>

            @if(_hasCover)
            {
                <MudText Typo="Typo.body2" Class="mb-2">@L["This issue has a cover image."]</MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                           OnClick="DeleteCover" Class="mb-4">
                    @L["Delete Cover"]
                </MudButton>
            }
            else
            {
                <MudText Typo="Typo.body2" Class="mb-2">@L["No cover image."]</MudText>
            }

            <MudFileUpload T="IBrowserFile" Accept=".jpg,.jpeg,.png,.webp,.tiff,.tif,.bmp"
                           FilesChanged="OnCoverFileSelected" MaximumFileCount="1">
                <CustomContent Context="ctx">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.CloudUpload"
                               Disabled="_isUploadingCover"
                               OnClick="@ctx.OpenFilePickerAsync">
                        @L["Upload Cover"]
                    </MudButton>
                </CustomContent>
            </MudFileUpload>

            @if(_isUploadingCover)
            {
                <MudProgressLinear Indeterminate="true" Class="mt-2"/>
            }

            @if(!string.IsNullOrWhiteSpace(_coverMessage))
            {
                <MudAlert Severity="@_coverMessageSeverity" Class="mt-2" ShowCloseIcon="true"
                          CloseIconClicked="() => _coverMessage = null">@_coverMessage</MudAlert>
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">@L["Save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public long      MagazineId         { get; set; }
    [Parameter] public string    Caption            { get; set; }
    [Parameter] public string    NativeCaption      { get; set; }
    [Parameter] public DateTime? Published          { get; set; }
    [Parameter] public int       PublishedPrecision { get; set; }
    [Parameter] public string    ProductCode        { get; set; }
    [Parameter] public short?    Pages              { get; set; }
    [Parameter] public uint?     IssueNumber        { get; set; }
    [Parameter] public string    InternetArchiveUrl { get; set; }
    [Parameter] public bool      IsEdit             { get; set; }
    [Parameter] public long      IssueId            { get; set; }
    [Parameter] public bool      HasCover           { get; set; }

    bool     _hasCover;
    bool     _isUploadingCover;
    string   _coverMessage;
    Severity _coverMessageSeverity = Severity.Info;

    protected override void OnInitialized() => _hasCover = HasCover;

    void Cancel() => MudDialog.Cancel();

    void Submit()
    {
        if(string.IsNullOrWhiteSpace(Caption))
            return;

        MudDialog.Close(DialogResult.Ok(new MagazineIssueDialogResult
        {
            MagazineId         = MagazineId,
            Caption            = Caption,
            NativeCaption      = NativeCaption,
            Published          = Published,
            PublishedPrecision = PublishedPrecision,
            ProductCode        = ProductCode,
            Pages              = Pages,
            IssueNumber        = IssueNumber,
            InternetArchiveUrl = string.IsNullOrWhiteSpace(InternetArchiveUrl) ? null : InternetArchiveUrl.Trim()
        }));
    }

    async Task OnCoverFileSelected(IBrowserFile file)
    {
        if(file is null) return;

        _isUploadingCover = true;
        _coverMessage     = null;
        StateHasChanged();

        try
        {
            using var stream = file.OpenReadStream(50 * 1024 * 1024); // 50MB limit
            using var ms     = new System.IO.MemoryStream();
            await stream.CopyToAsync(ms);
            ms.Position = 0;

            string contentType = System.IO.Path.GetExtension(file.Name)?.ToLowerInvariant() switch
            {
                ".jpg" or ".jpeg" => "image/jpeg",
                ".png"            => "image/png",
                ".webp"           => "image/webp",
                ".tiff" or ".tif" => "image/tiff",
                ".bmp"            => "image/bmp",
                _                 => "application/octet-stream"
            };

            var multipartBody = new Microsoft.Kiota.Abstractions.MultipartBody();
            multipartBody.AddOrReplacePart("file", contentType, ms, file.Name);

            MagazineIssueDto result = await Service.UploadIssueCoverAsync(IssueId, multipartBody);

            if(result is not null)
            {
                _hasCover             = true;
                _coverMessage         = L["Cover uploaded successfully."];
                _coverMessageSeverity = Severity.Success;
            }
            else
            {
                _coverMessage         = L["Failed to upload cover."];
                _coverMessageSeverity = Severity.Error;
            }
        }
        catch(Exception ex)
        {
            _coverMessage         = ex.Message;
            _coverMessageSeverity = Severity.Error;
        }
        finally
        {
            _isUploadingCover = false;
            StateHasChanged();
        }
    }

    async Task DeleteCover()
    {
        (bool succeeded, string error) = await Service.DeleteIssueCoverAsync(IssueId);

        if(succeeded)
        {
            _hasCover             = false;
            _coverMessage         = L["Cover deleted."];
            _coverMessageSeverity = Severity.Success;
            StateHasChanged();
        }
        else
        {
            _coverMessage         = error;
            _coverMessageSeverity = Severity.Error;
        }
    }
}
