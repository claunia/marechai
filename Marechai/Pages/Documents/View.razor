@page "/document/{Id:long}"
@using Marechai.ApiClient.Models
@using Marechai.Helpers
@inherits OwningComponentBase<DocumentsService>
@inject IStringLocalizer<DocumentsService> L
@inject ApiAssetUrlProvider                AssetUrls
@inject CollectionService                  CollectionSvc
@inject IDialogService                     DialogService
@inject SuggestionsService                 Suggestions

@if(!_loaded)
{
    <div class="d-flex justify-center pa-8">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large"/>
    </div>

    return;
}

@if(_document is null)
{
    <MudAlert Severity="Severity.Warning">@L["Document not found."]</MudAlert>

    return;
}

@* ── Hero Header ── *@
<MudPaper Class="pa-6 mb-6" Elevation="0" Style="background: linear-gradient(135deg, #7e57c2 0%, #42a5f5 100%); border-radius: 16px;">
    <MudStack AlignItems="AlignItems.Center" Spacing="3">
        <MudIcon Icon="@Icons.Material.Filled.Article" Size="Size.Large" Style="color: white;"/>
        <MudText Typo="Typo.h4" Align="Align.Center" Style="color: white; font-weight: 700;">@_document.Title</MudText>
        <AuthorizeView>
            <Authorized>
                <MudButton Variant="Variant.Filled"
                           Color="@(_isCollected ? Color.Success : Color.Default)"
                           StartIcon="@(_isCollected ? Icons.Material.Filled.Bookmark : Icons.Material.Outlined.BookmarkBorder)"
                           OnClick="ToggleCollectionAsync"
                           Disabled="_togglingCollection"
                           Size="Size.Small">
                    @(_isCollected ? L["In Collection"] : L["Add to Collection"])
                </MudButton>
            </Authorized>
        </AuthorizeView>
    </MudStack>
</MudPaper>

@* ── General Information Card ── *@
<MudCard Elevation="2" Class="mb-4 rounded-lg">
    <MudCardContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.Info" Color="Color.Primary"/>
                <MudText Typo="Typo.h6">@L["General"]</MudText>
            </MudStack>
            <AuthorizeView>
                <Authorized>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                   Title="@L["Suggest changes"]"
                                   OnClick="OpenDocumentSuggestionDialogAsync"/>
                </Authorized>
            </AuthorizeView>
        </MudStack>
        <MudSimpleTable Elevation="0" Dense="true">
            <tbody>
            <tr>
                <td style="width: 33%; text-align: right;"><strong>@L["Title"]</strong></td>
                <td>@_document.Title</td>
            </tr>
            @if(!string.IsNullOrEmpty(_document.NativeTitle))
            {
                <tr>
                    <td style="width: 33%; text-align: right;"><strong>@L["Native title"]</strong></td>
                    <td>@_document.NativeTitle</td>
                </tr>
            }
            @if(_document.Published.HasValue)
            {
                <tr>
                    <td style="width: 33%; text-align: right;"><strong>@L["Published"]</strong></td>
                    <td>@(((_document.PublishedPrecision ?? 0) == 2 ? _document.Published.Value.Year.ToString() : (_document.PublishedPrecision ?? 0) == 1 ? _document.Published.Value.ToString("MMMM yyyy") : _document.Published.Value.DateTime.ToLongDateString()))</td>
                </tr>
            }
            @if(!string.IsNullOrEmpty(_document.Country))
            {
                <tr>
                    <td style="width: 33%; text-align: right;"><strong>@L["Country"]</strong></td>
                    <td>
                        @if(_document.CountryId.HasValue)
                        {
                            <picture>
                                <source srcset="@(AssetUrls.BaseUrl)/assets/flags/countries/@($"{_document.CountryId:D3}").svg" type="image/svg+xml">
                                <source srcset="@(AssetUrls.BaseUrl)/assets/flags/countries/webp/1x/@($"{_document.CountryId:D3}").webp" type="image/webp">
                                <img alt="" height="32" src="@(AssetUrls.BaseUrl)/assets/flags/countries/png/1x/@($"{_document.CountryId:D3}").png"/>
                            </picture>
                        }
                        @L[_document.Country]
                    </td>
                </tr>
            }
            @if(!string.IsNullOrEmpty(_document.InternetArchiveUrl))
            {
                <tr>
                    <td style="width: 33%; text-align: right;"><strong>@L["Internet Archive link"]</strong></td>
                    <td>
                        <MudLink Href="@_document.InternetArchiveUrl" Target="_blank" Underline="Underline.Always">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudIcon Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small"/>
                                <span>@L["View on Internet Archive"]</span>
                            </MudStack>
                        </MudLink>
                    </td>
                </tr>
            }
            </tbody>
        </MudSimpleTable>
    </MudCardContent>
</MudCard>

@* ── Synopsis Card ── *@
@if(!_hasAnyDescription)
{
    <MudCard Elevation="2" Class="mb-4 rounded-lg">
        <MudCardContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Description" Color="Color.Primary"/>
                    <MudText Typo="Typo.h6">@L["Synopsis"]</MudText>
                </MudStack>
            </MudStack>
            <AuthorizeView>
                <Authorized>
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-2">
                        @L["We do not have a synopsis for this document, you could collaborate by suggesting one"]
                    </MudAlert>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.AddComment"
                               OnClick="OpenDescriptionPickerAsync">
                        @L["Suggest synopsis"]
                    </MudButton>
                </Authorized>
                <NotAuthorized>
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                        @L["We do not have a synopsis for this document, you could collaborate by suggesting one"]
                    </MudAlert>
                </NotAuthorized>
            </AuthorizeView>
        </MudCardContent>
    </MudCard>
}
else
{
    @if(_descriptionFellBack)
    {
        <AuthorizeView>
            <Authorized>
                <MudAlert Severity="Severity.Info"
                          Variant="Variant.Outlined"
                          Class="mb-3">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="3" Style="width: 100%;">
                        <MudText>
                            @L["We do not have a synopsis in your language, you could collaborate by translating the English synopsis we show below"]
                        </MudText>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Translate"
                                   OnClick="OpenDescriptionPickerAsync">
                            @L["Suggest translation"]
                        </MudButton>
                    </MudStack>
                </MudAlert>
            </Authorized>
        </AuthorizeView>
    }

    <MudCard Elevation="2" Class="mb-4 rounded-lg">
        <MudCardContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Description" Color="Color.Primary"/>
                    <MudText Typo="Typo.h6">@L["Synopsis"]</MudText>
                </MudStack>
                <AuthorizeView>
                    <Authorized>
                        <MudTooltip Text="@L["Suggest changes"]">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Size="Size.Small"
                                           Color="Color.Secondary"
                                           OnClick="OpenDescriptionPickerAsync"
                                           aria-label="@L["Suggest changes"]"/>
                        </MudTooltip>
                    </Authorized>
                </AuthorizeView>
            </MudStack>
            <div class="markdown-body">@SafeMarkdownRenderer.Render(_synopsis?.Text ?? string.Empty)</div>
        </MudCardContent>
    </MudCard>
}

@* ── People Card ── *@
<MudExpansionPanels Elevation="2" Class="mb-4 rounded-lg">
    <MudExpansionPanel Disabled="@(_people.Count == 0)">
        <TitleContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.People" Color="Color.Primary"/>
                <MudText Typo="Typo.h6">@L["People"]</MudText>
                <MudChip T="string" Size="Size.Small" Color="@(_people.Count > 0 ? Color.Success : Color.Error)">@_people.Count</MudChip>
            </MudStack>
        </TitleContent>
        <ChildContent>
            <MudList T="PersonByDocumentDto" Dense="true">
                @foreach(PersonByDocumentDto person in _people)
                {
                    <MudListItem T="PersonByDocumentDto" Icon="@Icons.Material.Filled.Person">
                        @(person.DisplayName ?? person.Alias ?? $"{person.Name} {person.Surname}".Trim())
                        @if(!string.IsNullOrEmpty(person.Role))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="ml-2" Style="display: inline;">— @person.Role</MudText>
                        }
                    </MudListItem>
                }
            </MudList>
        </ChildContent>
    </MudExpansionPanel>
</MudExpansionPanels>

@* ── Companies Card ── *@
<MudExpansionPanels Elevation="2" Class="mb-4 rounded-lg">
    <MudExpansionPanel Disabled="@(_companies.Count == 0)">
        <TitleContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.Business" Color="Color.Primary"/>
                <MudText Typo="Typo.h6">@L["Companies"]</MudText>
                <MudChip T="string" Size="Size.Small" Color="@(_companies.Count > 0 ? Color.Success : Color.Error)">@_companies.Count</MudChip>
            </MudStack>
        </TitleContent>
        <ChildContent>
            <MudList T="CompanyByDocumentDto" Dense="true">
                @foreach(CompanyByDocumentDto company in _companies)
                {
                    <MudListItem T="CompanyByDocumentDto" Href="@($"/company/{company.CompanyId}")" Icon="@Icons.Material.Filled.Business">
                        @company.Company
                        @if(!string.IsNullOrEmpty(company.Role))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="ml-2" Style="display: inline;">— @company.Role</MudText>
                        }
                    </MudListItem>
                }
            </MudList>
        </ChildContent>
    </MudExpansionPanel>
</MudExpansionPanels>

@* ── Machines Card ── *@
<MudExpansionPanels Elevation="2" Class="mb-4 rounded-lg">
    <MudExpansionPanel Disabled="@(_machines.Count == 0)">
        <TitleContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.Computer" Color="Color.Primary"/>
                <MudText Typo="Typo.h6">@L["Machines"]</MudText>
                <MudChip T="string" Size="Size.Small" Color="@(_machines.Count > 0 ? Color.Success : Color.Error)">@_machines.Count</MudChip>
            </MudStack>
        </TitleContent>
        <ChildContent>
            <MudList T="DocumentByMachineDto" Dense="true">
                @foreach(DocumentByMachineDto machine in _machines)
                {
                    <MudListItem T="DocumentByMachineDto" Href="@($"/machine/{machine.MachineId}")" Icon="@Icons.Material.Filled.Computer">
                        @machine.Machine
                    </MudListItem>
                }
            </MudList>
        </ChildContent>
    </MudExpansionPanel>
</MudExpansionPanels>

@* ── Machine Families Card ── *@
<MudExpansionPanels Elevation="2" Class="mb-4 rounded-lg">
    <MudExpansionPanel Disabled="@(_machineFamilies.Count == 0)">
        <TitleContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.DevicesOther" Color="Color.Primary"/>
                <MudText Typo="Typo.h6">@L["Machine families"]</MudText>
                <MudChip T="string" Size="Size.Small" Color="@(_machineFamilies.Count > 0 ? Color.Success : Color.Error)">@_machineFamilies.Count</MudChip>
            </MudStack>
        </TitleContent>
        <ChildContent>
            <MudList T="DocumentByMachineFamilyDto" Dense="true">
                @foreach(DocumentByMachineFamilyDto family in _machineFamilies)
                {
                    <MudListItem T="DocumentByMachineFamilyDto" Icon="@Icons.Material.Filled.DevicesOther">
                        @family.MachineFamily
                    </MudListItem>
                }
            </MudList>
        </ChildContent>
    </MudExpansionPanel>
</MudExpansionPanels>
