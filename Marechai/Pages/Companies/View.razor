@* ── Description Card ── *@
@if(!_hasAnyDescription)
{
    <MudCard Elevation="2" Class="mb-4 rounded-lg">
        <MudCardContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Description" Color="Color.Primary"/>
                    <MudText Typo="Typo.h6">@L["Description"]</MudText>
                </MudStack>
            </MudStack>
            <AuthorizeView>
                <Authorized>
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-2">
                        @L["We do not have a description for this company, you could collaborate by suggesting one"]
                    </MudAlert>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.AddComment"
                               OnClick="OpenDescriptionPickerAsync">
                        @L["Suggest description"]
                    </MudButton>
                </Authorized>
                <NotAuthorized>
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                        @L["We do not have a description for this company, you could collaborate by suggesting one"]
                    </MudAlert>
                </NotAuthorized>
            </AuthorizeView>
        </MudCardContent>
    </MudCard>
}
else
{
    @if(_descriptionFellBack)
    {
        <AuthorizeView>
            <Authorized>
                <MudAlert Severity="Severity.Info"
                          Variant="Variant.Outlined"
                          Class="mb-3">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="3" Style="width: 100%;">
                        <MudText>
                            @L["We do not have a description in your language, you could collaborate by translating the English description we show below"]
                        </MudText>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Translate"
                                   OnClick="OpenDescriptionPickerAsync">
                            @L["Suggest translation"]
                        </MudButton>
                    </MudStack>
                </MudAlert>
            </Authorized>
        </AuthorizeView>
    }

    <MudCard Elevation="2" Class="mb-4 rounded-lg">
        <MudCardContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Description" Color="Color.Primary"/>
                    <MudText Typo="Typo.h6">@L["Description"]</MudText>
                </MudStack>
                <AuthorizeView>
                    <Authorized>
                        <MudTooltip Text="@L["Suggest changes"]">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Size="Size.Small"
                                           Color="Color.Secondary"
                                           OnClick="OpenDescriptionPickerAsync"
                                           aria-label="@L["Suggest changes"]"/>
                        </MudTooltip>
                    </Authorized>
                </AuthorizeView>
            </MudStack>
            <div style="color: var(--mud-palette-text-primary); overflow-wrap: break-word; word-break: break-word;">
                <style>
                    .company-description {
                        color: inherit;
                        line-height: 1.7;
                    }
                    .company-description h1 {
                        font-size: 1.75rem;
                        font-weight: 700;
                        margin: 2rem 0 1rem;
                        line-height: 1.3;
                    }
                    .company-description h2 {
                        font-size: 1.5rem;
                        font-weight: 600;
                        margin: 2rem 0 1rem;
                        line-height: 1.3;
                    }
                    .company-description h3 {
                        font-size: 1.25rem;
                        font-weight: 600;
                        margin: 1.5rem 0 0.75rem;
                        line-height: 1.3;
                    }
                    .company-description h4, .company-description h5, .company-description h6 {
                        font-size: 1.1rem;
                        font-weight: 600;
                        margin: 1.25rem 0 0.6rem;
                        line-height: 1.3;
                    }
                    .company-description p {
                        margin: 1rem 0;
                        line-height: 1.8;
                    }
                    .company-description ul, .company-description ol {
                        margin: 1rem 0;
                        padding-left: 1.75rem;
                    }
                    .company-description li {
                        margin: 0.6rem 0;
                        line-height: 1.7;
                    }
                    .company-description strong {
                        font-weight: 700;
                    }
                    .company-description img {
                        max-width: 100%;
                        height: auto;
                    }
                    .company-description pre {
                        overflow-x: auto;
                        max-width: 100%;
                        background: var(--mud-palette-surface);
                        padding: 1rem;
                        border-radius: 4px;
                    }
                    .company-description code {
                        background: var(--mud-palette-surface);
                        padding: 0.125rem 0.25rem;
                        border-radius: 3px;
                        font-size: 0.875em;
                    }
                    .company-description blockquote {
                        border-left: 4px solid var(--mud-palette-primary);
                        margin: 0.75rem 0;
                        padding: 0.5rem 1rem;
                        opacity: 0.85;
                    }
                    .company-description table {
                        border-collapse: collapse;
                        margin: 0.75rem 0;
                        width: 100%;
                    }
                    .company-description th, .company-description td {
                        border: 1px solid var(--mud-palette-lines-default);
                        padding: 0.5rem;
                    }
                    .company-description hr {
                        border: none;
                        border-top: 1px solid var(--mud-palette-lines-default);
                        margin: 1rem 0;
                    }
                </style>
                <div class="company-description" style="padding: 8px;">
                    @((MarkupString)_description)
                </div>
            </div>
        </MudCardContent>
    </MudCard>
}
