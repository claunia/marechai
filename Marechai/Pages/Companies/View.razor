@* ── People Card ── *@
@if(_people.Count > 0)
{
<MudExpansionPanels Elevation="2" Class="mb-4 rounded-lg">
    <MudExpansionPanel>
        <TitleContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.People" Color="Color.Primary"/>
                <MudText Typo="Typo.h6">@L["People"]</MudText>
                <MudChip T="string" Size="Size.Small" Color="Color.Success">@_people.Count</MudChip>
            </MudStack>
        </TitleContent>
        <ChildContent>
            <MudList T="PersonByCompanyDto" Dense="true">
                @foreach(PersonByCompanyDto person in _people)
                {
                    <MudListItem T="PersonByCompanyDto" Href="@($"/person/{person.PersonId}")" Icon="@Icons.Material.Filled.Person">
                        @(person.DisplayName ?? person.Alias ?? $"{person.Name} {person.Surname}")
                    </MudListItem>
                }
            </MudList>
