@* ── Documents Card ── *@
@if(_documents.Count > 0)
{
<MudExpansionPanels Elevation="2" Class="mb-4 rounded-lg">
    <MudExpansionPanel>
        <TitleContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.Article" Color="Color.Primary"/>
                <MudText Typo="Typo.h6">@L["Documents"]</MudText>
                <MudChip T="string" Size="Size.Small" Color="Color.Success">@_documents.Count</MudChip>
            </MudStack>
        </TitleContent>
        <ChildContent>
            <MudList T="DocumentDto" Dense="true">
                @foreach(DocumentDto document in _documents)
                {
                    <MudListItem T="DocumentDto" Href="@($"/document/{document.Id}")" Icon="@Icons.Material.Filled.Article">
                        @document.Title
                    </MudListItem>
                }
            </MudList>
        </ChildContent>
    </MudExpansionPanel>
</MudExpansionPanels>
}

@* ── Magazines Card ── *@
@if(_magazines.Count > 0)
{
<MudExpansionPanels Elevation="2" Class="mb-4 rounded-lg">
    <MudExpansionPanel>
        <TitleContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.Newspaper" Color="Color.Primary"/>
                <MudText Typo="Typo.h6">@L["Magazines"]</MudText>
                <MudChip T="string" Size="Size.Small" Color="Color.Success">@_magazines.Count</MudChip>
            </MudStack>
        </TitleContent>
        <ChildContent>
            <MudList T="MagazineDto" Dense="true">
                @foreach(MagazineDto magazine in _magazines)
                {
                    <MudListItem T="MagazineDto" Href="@($"/magazine/{magazine.Id}")" Icon="@Icons.Material.Filled.Newspaper">
                        @magazine.Title
                    </MudListItem>
                }
            </MudList>
        </ChildContent>
    </MudExpansionPanel>
</MudExpansionPanels>
