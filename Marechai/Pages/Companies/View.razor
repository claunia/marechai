@page "/company/{Id:int}"
@using Marechai.ApiClient.Models
@using Marechai.Data
@inherits OwningComponentBase<CompaniesService>
@inject IStringLocalizer<CompaniesService> L
@inject CompanyLogosService                CompanyLogosService
@inject IWebHostEnvironment                Host

@if(!_loaded)
{
    <div class="d-flex justify-center pa-8">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true"/>
    </div>

    return;
}

@if(_company is null)
{
    <MudAlert Severity="Severity.Warning">@L["Company not found."]</MudAlert>

    return;
}
<MudContainer MaxWidth="MaxWidth.Large">
    <div class="d-flex justify-center mb-4">
        @if(_company.LastLogo != null && File.Exists(Path.Combine(Host.WebRootPath, "assets/logos", _company.LastLogo + ".svg")))
        {
            <picture>
                <source srcset="/assets/logos/@(_company.LastLogo).svg" type="image/svg+xml">
                <source srcset="/assets/logos/webp/1x/@(_company.LastLogo).webp,
/assets/logos/webp/2x/@(_company.LastLogo).webp 2x,
/assets/logos/webp/3x/@(_company.LastLogo).webp 3x" type="image/webp">
                <img alt="" height="auto" src="/assets/logos/png/1x/@(_company.LastLogo).png"
                     srcset="/assets/logos/png/1x/@(_company.LastLogo).png,
                         /assets/logos/png/2x/@(_company.LastLogo).png 2x,
                         /assets/logos/png/3x/@(_company.LastLogo).png 3x" style="max-height: 256px; max-width: 256px"
                     width="auto"/>
            </picture>
        }
    </div>
    <MudGrid>
        @if(_logos != null && _logos.Count > 1)
        {
            <MudItem xs="12" md="4">
                <MudCarousel TData="object" @bind-SelectedIndex="@_selectedIndex" ShowArrows="true" ShowBullets="true" Style="height: 320px;">
                    @foreach(CompanyLogoDto logo in _logos.Where(logo => File.Exists(Path.Combine(Host.WebRootPath, "assets/logos", logo.Guid + ".svg"))))
                    {
                        <MudCarouselItem>
                            <div style="width: 256px; height: 256px; margin: auto;">
                                <picture>
                                    <source srcset="/assets/logos/@(logo.Guid).svg" type="image/svg+xml">
                                    <source srcset="/assets/logos/webp/1x/@(logo.Guid).webp,
    /assets/logos/webp/1x/@(logo.Guid).webp 2x,
    /assets/logos/webp/1x/@(logo.Guid).webp 3x" type="image/webp">
                                    <img alt="" height="auto"
                                         src="/assets/logos/png/1x/@(logo.Guid).png"
                                         srcset="/assets/logos/png/1x/@(logo.Guid).png,
                             /assets/logos/png/1x/@(logo.Guid).png 2x,
                             /assets/logos/png/1x/@(logo.Guid).webp 3x" style="max-height: 256px; max-width: 256px"
                                         width="auto"/>
                                </picture>
                            </div>
                            @if(logo.Year.HasValue)
                            {
                                <MudText Align="Align.Center">@(string.Format(L["in use since {0}"], logo.Year))</MudText>
                            }
                        </MudCarouselItem>
                    }
                </MudCarousel>
            </MudItem>
        }
        <MudItem xs="12" md="8">
            <MudSimpleTable Elevation="0" Dense="true">
                <tbody>
                <tr>
                    <td colspan="2" style="text-align: center;">
                        <MudText Typo="Typo.h6">@_company.Name</MudText>
                    </td>
                </tr>
                @if(_company.Founded.HasValue)
                {
                    <tr>
                        <td style="width: 33%; text-align: right;"><strong>@L["Founded"]</strong></td>
                        @if(_company.FoundedMonthIsUnknown == true)
                        {
                            <td>@_company.Founded.Value.Year.</td>
                        }
                        else if(_company.FoundedDayIsUnknown == true)
                        {
                            <td>@($"{_company.Founded.Value:Y}").</td>
                        }
                        else
                        {
                            <td>@_company.Founded.Value.DateTime.ToLongDateString().</td>
                        }
                    </tr>
                }
                @if(!string.IsNullOrEmpty(_company.LegalName))
                {
                    <tr>
                        <td style="width: 33%; text-align: right;"><strong>@L["Legal name"]</strong></td>
                        <td>@_company.LegalName</td>
                    </tr>
                }
                <tr>
                    <td style="width: 33%; text-align: right;"><strong>@L["Country"]</strong></td>
                    <td>
                        @if(_company.Country != null)
                        {
                            <a href="/companies/country/@_company.CountryId">
                                @if(File.Exists(Path.Combine(Host.WebRootPath, "assets/flags/countries", $"{_company.CountryId:D3}.svg")))
                                {
                                    <picture>
                                        <source srcset="/assets/flags/countries/@($"{_company.CountryId:D3}").svg"
                                                type="image/svg+xml">
                                        <source srcset="/assets/flags/countries/webp/1x/@($"{_company.CountryId:D3}").webp,
        /assets/flags/countries/webp/1x/@($"{_company.CountryId:D3}").webp 2x,
        /assets/flags/countries/webp/1x/@($"{_company.CountryId:D3}").webp 3x" type="image/webp">
                                        <img alt="" height="32"
                                             src="/assets/flags/countries/png/1x/@($"{_company.CountryId:D3}").png"
                                             srcset="/assets/flags/countries/png/1x/@($"{_company.CountryId:D3}").png,
                                 /assets/flags/countries/png/1x/@($"{_company.CountryId:D3}").png 2x,
                                 /assets/flags/countries/png/1x/@($"{_company.CountryId:D3}").webp 3x"/>
                                    </picture>
                                }
                                @L[_company.Country]
                            </a>
                        }
                        else
                        {
                            @L["Unknown (country)"]
                        }
                    </td>
                </tr>
                <tr>
                    <td style="width: 33%; text-align: right;"><strong>@L["Status"]</strong></td>
                    @switch(_company.Status)
                    {
                        case (int)CompanyStatus.Unknown:
                            <td>@L["Current company status is unknown."]</td>

                            break;
                        case (int)CompanyStatus.Active:
                            <td>@L["Company is active."]</td>

                            break;
                        case (int)CompanyStatus.Sold:
                            if(_company.Sold != null)
                            {
                                if(_soldTo != null)
                                {
                                    <td>
                                        <a href="/company/@_soldTo.Id">
                                            @string.Format(L["Company sold to {0} on {1}."],
                                                           _soldTo.Name,
                                                           _company.SoldMonthIsUnknown == true
                                                               ? $"{_company.Sold.Value.Year}"
                                                               : _company.SoldDayIsUnknown == true
                                                                   ? $"{_company.Sold.Value:Y}"
                                                                   : _company.SoldMonthIsUnknown == true
                                                                       ? $"{_company.Sold.Value.Year}"
                                                                       : _company.SoldDayIsUnknown == true
                                                                           ? $"{_company.Sold.Value:Y}"
                                                                           : _company.Sold.Value.DateTime.ToLongDateString())
                                        </a>
                                    </td>
                                }
                                else
                                {
                                    <td>@string.Format(L["Company sold on {0} to an unknown company."],
                                                       _company.SoldMonthIsUnknown == true
                                                           ? $"{_company.Sold.Value.Year}"
                                                           : _company.SoldDayIsUnknown == true
                                                               ? $"{_company.Sold.Value:Y}"
                                                               : _company.Sold.Value.DateTime.ToLongDateString())</td>
                                }
                            }
                            else
                            {
                                if(_soldTo != null)
                                {
                                    <td>
                                        <a href="/company/@_soldTo.Id">
                                            @string.Format(L["Company sold to {0} on an unknown date."], _soldTo.Name)
                                        </a>
                                    </td>
                                }
                                else
                                {
                                    <td>@L["Company was sold to an unknown company on an unknown date."]</td>
                                }
                            }

                            break;
                        case (int)CompanyStatus.Merged:
                            if(_company.Sold != null)
                            {
                                if(_soldTo != null)
                                {
                                    <td>
                                        <a href="/company/@_soldTo.Id">@string.Format(L["Company merged on {0} to form {1}."],
                                                                                      _company.SoldMonthIsUnknown == true
                                                                                          ? $"{_company.Sold.Value.Year}"
                                                                                          : _company.SoldDayIsUnknown == true
                                                                                              ? $"{_company.Sold.Value:Y}"
                                                                                              : _company.Sold.Value.DateTime.ToLongDateString(),
                                                                                      _soldTo.Name)</a>
                                    </td>
                                }
                                else
                                {
                                    <td>@string.Format(L["Company merged on {0} to form an unknown company."],
                                                       _company.SoldMonthIsUnknown == true
                                                           ? $"{_company.Sold.Value.Year}"
                                                           : _company.SoldDayIsUnknown == true
                                                               ? $"{_company.Sold.Value:Y}"
                                                               : _company.Sold.Value.DateTime.ToLongDateString())</td>
                                }
                            }
                            else
                            {
                                if(_soldTo != null)
                                {
                                    <td>
                                        <a href="/company/@_soldTo.Id">@string.Format(L["Company merged on an unknown date to form {0}."], _soldTo.Name)</a>
                                    </td>
                                }
                                else
                                {
                                    <td>@L["Company merged to form an unknown company on an unknown date."]</td>
                                }
                            }

                            break;
                        case (int)CompanyStatus.Bankrupt:
                            if(_company.Sold != null)
                            {
                                <td>@string.Format(L["Company declared bankruptcy on {0}."],
                                                   _company.SoldMonthIsUnknown == true
                                                       ? $"{_company.Sold.Value.Year}"
                                                       : _company.SoldDayIsUnknown == true
                                                           ? $"{_company.Sold.Value:Y}"
                                                           : _company.Sold.Value.DateTime.ToLongDateString())</td>
                            }
                            else
                            {
                                <td>@L["Company declared bankruptcy on an unknown date."]</td>
                            }

                            break;
                        case (int)CompanyStatus.Defunct:
                            if(_company.Sold != null)
                            {
                                <td>@string.Format(L["Company ceased operations on {0}."],
                                                   _company.SoldMonthIsUnknown == true
                                                       ? $"{_company.Sold.Value.Year}"
                                                       : _company.SoldDayIsUnknown == true
                                                           ? $"{_company.Sold.Value:Y}"
                                                           : _company.Sold.Value.DateTime.ToLongDateString())</td>
                            }
                            else
                            {
                                <td>@L["Company ceased operations on an unknown date."]</td>
                            }

                            break;
                        case (int)CompanyStatus.Renamed:
                            if(_company.Sold != null)
                            {
                                if(_soldTo != null)
                                {
                                    <td>
                                        <a href="/company/@_soldTo.Id">@string.Format(L["Company renamed to {0} on {1}."],
                                                                                      _soldTo.Name,
                                                                                      _company.SoldMonthIsUnknown == true
                                                                                          ? $"{_company.Sold.Value.Year}"
                                                                                          : _company.SoldDayIsUnknown == true
                                                                                              ? $"{_company.Sold.Value:Y}"
                                                                                              : _company.Sold.Value.DateTime.ToLongDateString())</a>
                                    </td>
                                }
                                else
                                {
                                    <td>@string.Format(L["Company was renamed on {0} to an unknown name."],
                                                       _company.SoldMonthIsUnknown == true
                                                           ? $"{_company.Sold.Value.Year}"
                                                           : _company.SoldDayIsUnknown == true
                                                               ? $"{_company.Sold.Value:Y}"
                                                               : _company.Sold.Value.DateTime.ToLongDateString())</td>
                                }
                            }
                            else
                            {
                                if(_soldTo != null)
                                {
                                    <td>
                                        <a href="/company/@_soldTo.Id">
                                            @string.Format(L["Company renamed to {0} on an unknown date."], _soldTo.Name)
                                        </a>
                                    </td>
                                }
                                else
                                {
                                    <td>@L["Company renamed to an unknown name on an unknown date."]</td>
                                }
                            }

                            break;
                        default:
                            throw new ArgumentOutOfRangeException();
                    }
                </tr>
                <tr>
                    <td style="width: 33%; text-align: right;"><strong>@L["Address"]</strong></td>
                    <td>
                        @_company.Address
                        <br>
                        @if(_company.City != _company.Province)
                        {
                            @_company.City
                            <br>
                        }
                        @_company.PostalCode @_company.Province
                    </td>
                </tr>
                @if(!string.IsNullOrEmpty(_company.Website) || !string.IsNullOrEmpty(_company.Twitter) || !string.IsNullOrEmpty(_company.Facebook))
                {
                    <tr>
                        <td style="width: 33%; text-align: right;"><strong>@L["Links"]</strong></td>
                        <td>
                            <MudStack Spacing="1">
                                @if(!string.IsNullOrEmpty(_company.Website))
                                {
                                    <MudLink Href="@_company.Website" Target="_blank">@L["Website"]</MudLink>
                                }
                                @if(!string.IsNullOrEmpty(_company.Twitter))
                                {
                                    <MudLink Href="@($"https://www.twitter.com/{_company.Twitter}")" Target="_blank">Twitter</MudLink>
                                }
                                @if(!string.IsNullOrEmpty(_company.Facebook))
                                {
                                    <MudLink Href="@($"https://www.facebook.com/{_company.Facebook}")" Target="_blank">Facebook</MudLink>
                                }
                            </MudStack>
                        </td>
                    </tr>
                }
                </tbody>
            </MudSimpleTable>
        </MudItem>
    </MudGrid>
    <MudExpansionPanels Class="mt-4">
        @if(_computers.Count > 0)
        {
            <MudExpansionPanel>
                <TitleContent>
                    <div class="d-flex align-center gap-2">
                        <MudChip T="string" Color="Color.Success" Size="Size.Small">@_computers.Count</MudChip>
                        <MudText>@L["computers known."]</MudText>
                    </div>
                </TitleContent>
                <ChildContent>
                    <MudList T="MachineDto" Dense="true">
                        @foreach(MachineDto computer in _computers)
                        {
                            <MudListItem T="MachineDto" Href="@($"/machine/{computer.Id}")" Icon="@Icons.Material.Filled.Computer">
                                @computer.Name
                            </MudListItem>
                        }
                    </MudList>
                </ChildContent>
                </MudExpansionPanel>
            }
            else
            {
                <MudExpansionPanel Disabled="true">
                    <TitleContent>
                        <div class="d-flex align-center gap-2">
                            <MudChip T="string" Color="Color.Error" Size="Size.Small">0</MudChip>
                            <MudText>@L["computers known."]</MudText>
                        </div>
                    </TitleContent>
                </MudExpansionPanel>
            }
            @if(_consoles.Count > 0)
            {
                <MudExpansionPanel>
                    <TitleContent>
                        <div class="d-flex align-center gap-2">
                            <MudChip T="string" Color="Color.Success" Size="Size.Small">@_consoles.Count</MudChip>
                            <MudText>@L["videogame consoles known."]</MudText>
                        </div>
                    </TitleContent>
                    <ChildContent>
                        <MudList T="MachineDto" Dense="true">
                            @foreach(MachineDto console in _consoles)
                            {
                                <MudListItem T="MachineDto" Href="@($"/machine/{console.Id}")" Icon="@Icons.Material.Filled.SportsEsports">
                                    @console.Name
                                </MudListItem>
                            }
                        </MudList>
                    </ChildContent>
                </MudExpansionPanel>
            }
            else
            {
                <MudExpansionPanel Disabled="true">
                    <TitleContent>
                        <div class="d-flex align-center gap-2">
                            <MudChip T="string" Color="Color.Error" Size="Size.Small">0</MudChip>
                            <MudText>@L["videogame consoles known."]</MudText>
                        </div>
                    </TitleContent>
                </MudExpansionPanel>
            }
    </MudExpansionPanels>
    @if(_description != null)
    {
        <MudDivider Class="my-4"/>
        <MudPaper Elevation="0" Class="pa-4">
            @((MarkupString)_description)
        </MudPaper>
    }
</MudContainer>