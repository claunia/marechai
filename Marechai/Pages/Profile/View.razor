@page "/profile/{Username}"
@using Marechai.ApiClient.Models
@inherits OwningComponentBase<ProfileService>
@inject IStringLocalizer<ProfileService> L
@inject CollectionService                CollectionSvc
@inject AuthenticationStateProvider       AuthStateProvider

@if(!_loaded)
{
    <div class="d-flex justify-center pa-8">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large"/>
    </div>

    return;
}

@if(_profile is null)
{
    <MudAlert Severity="Severity.Warning">@L["User not found."]</MudAlert>

    return;
}

@* ── Hero Header ── *@
<MudPaper Class="pa-6 mb-6" Elevation="0"
          Style="background: linear-gradient(135deg, #1a237e 0%, #42a5f5 100%); border-radius: 16px;">
    <MudStack AlignItems="AlignItems.Center" Spacing="3">
        @if(!string.IsNullOrWhiteSpace(_profile.AvatarUrl))
        {
            <MudAvatar Size="Size.Large" Style="width: 128px; height: 128px; border: 3px solid white;">
                <MudImage Src="@_profile.AvatarUrl" Alt="@DisplayName"/>
            </MudAvatar>
        }
        else
        {
            <MudAvatar Size="Size.Large" Style="width: 128px; height: 128px; border: 3px solid white; background: rgba(255,255,255,0.2);">
                <MudIcon Icon="@Icons.Material.Filled.Person" Style="color: white; font-size: 64px;"/>
            </MudAvatar>
        }
        <MudText Typo="Typo.h4" Align="Align.Center" Style="color: white; font-weight: 700;">
            @DisplayName
        </MudText>
        @if(!string.IsNullOrWhiteSpace(_profile.DisplayName))
        {
            <MudText Typo="Typo.subtitle1" Align="Align.Center" Style="color: rgba(255,255,255,0.8);">
                @@@_profile.UserName
            </MudText>
        }
        @if(!string.IsNullOrWhiteSpace(_profile.Location))
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MudIcon Icon="@Icons.Material.Filled.LocationOn" Style="color: rgba(255,255,255,0.8); font-size: 18px;"/>
                <MudText Typo="Typo.body2" Style="color: rgba(255,255,255,0.8);">@_profile.Location</MudText>
            </MudStack>
        }
        @if(_summary is not null && (_summary.BookCount > 0 || _summary.DocumentCount > 0 || _summary.MachineCount > 0 || _summary.SoftwareReleaseCount > 0 || _summary.MagazineIssueCount > 0))
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap" Justify="Justify.Center">
                @if(_summary.BookCount > 0)
                {
                    <MudChip T="string" Color="Color.Default" Size="Size.Small" Icon="@Icons.Material.Filled.MenuBook"
                             Style="color: white; background: rgba(255,255,255,0.2);">
                        @_summary.BookCount @L["Books"]
                    </MudChip>
                }
                @if(_summary.DocumentCount > 0)
                {
                    <MudChip T="string" Color="Color.Default" Size="Size.Small" Icon="@Icons.Material.Filled.Article"
                             Style="color: white; background: rgba(255,255,255,0.2);">
                        @_summary.DocumentCount @L["Documents"]
                    </MudChip>
                }
                @if(_summary.MagazineIssueCount > 0)
                {
                    <MudChip T="string" Color="Color.Default" Size="Size.Small" Icon="@Icons.Material.Filled.Bookmarks"
                             Style="color: white; background: rgba(255,255,255,0.2);">
                        @_summary.MagazineIssueCount @L["Magazine Issues"]
                    </MudChip>
                }
                @if(_collectedComputers?.Count > 0)
                {
                    <MudChip T="string" Color="Color.Default" Size="Size.Small" Icon="@Icons.Material.Filled.Computer"
                             Style="color: white; background: rgba(255,255,255,0.2);">
                        @_collectedComputers.Count @L["Computers"]
                    </MudChip>
                }
                @if(_collectedConsoles?.Count > 0)
                {
                    <MudChip T="string" Color="Color.Default" Size="Size.Small" Icon="@Icons.Material.Filled.SportsEsports"
                             Style="color: white; background: rgba(255,255,255,0.2);">
                        @_collectedConsoles.Count @L["Consoles"]
                    </MudChip>
                }
                @if(_summary.SoftwareReleaseCount > 0)
                {
                    <MudChip T="string" Color="Color.Default" Size="Size.Small" Icon="@Icons.Material.Filled.Apps"
                             Style="color: white; background: rgba(255,255,255,0.2);">
                        @_summary.SoftwareReleaseCount @L["Software"]
                    </MudChip>
                }
            </MudStack>
        }
    </MudStack>
</MudPaper>

<MudGrid Justify="Justify.Center">
    <MudItem xs="12" md="8" lg="6">
        @* ── Bio Card ── *@
        @if(!string.IsNullOrWhiteSpace(_profile.Bio))
        {
            <MudCard Elevation="2" Class="mb-4 rounded-lg">
                <MudCardContent>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                        <MudIcon Icon="@Icons.Material.Filled.Info" Color="Color.Primary"/>
                        <MudText Typo="Typo.h6">@L["About"]</MudText>
                    </MudStack>
                    <MudText Typo="Typo.body1" Style="white-space: pre-wrap;">@_profile.Bio</MudText>
                </MudCardContent>
            </MudCard>
        }

        @* ── Links & Social Card ── *@
        @if(HasLinks)
        {
            <MudCard Elevation="2" Class="mb-4 rounded-lg">
                <MudCardContent>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                        <MudIcon Icon="@Icons.Material.Filled.Link" Color="Color.Primary"/>
                        <MudText Typo="Typo.h6">@L["Links"]</MudText>
                    </MudStack>
                    <MudStack Spacing="2">
                        @if(!string.IsNullOrWhiteSpace(_profile.Website))
                        {
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudIcon Icon="@Icons.Material.Filled.Language" Color="Color.Default"/>
                                <MudLink Href="@_profile.Website" Target="_blank" Typo="Typo.body1">@_profile.Website</MudLink>
                            </MudStack>
                        }
                        @if(!string.IsNullOrWhiteSpace(_profile.GitHub))
                        {
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudIcon Icon="@Icons.Custom.Brands.GitHub" Color="Color.Default"/>
                                <MudLink Href="@($"https://github.com/{_profile.GitHub}")" Target="_blank" Typo="Typo.body1">@_profile.GitHub</MudLink>
                            </MudStack>
                        }
                        @if(!string.IsNullOrWhiteSpace(_profile.Twitter))
                        {
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudIcon Icon="@Icons.Custom.Brands.X" Color="Color.Default"/>
                                <MudLink Href="@($"https://x.com/{_profile.Twitter}")" Target="_blank" Typo="Typo.body1">@@@_profile.Twitter</MudLink>
                            </MudStack>
                        }
                        @if(!string.IsNullOrWhiteSpace(_profile.Mastodon))
                        {
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudIcon Icon="@Icons.Material.Filled.Forum" Color="Color.Default"/>
                                <MudText Typo="Typo.body1">@_profile.Mastodon</MudText>
                            </MudStack>
                        }
                        @if(!string.IsNullOrWhiteSpace(_profile.Facebook))
                        {
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudIcon Icon="@Icons.Custom.Brands.Facebook" Color="Color.Default"/>
                                <MudLink Href="@($"https://facebook.com/{_profile.Facebook}")" Target="_blank" Typo="Typo.body1">@_profile.Facebook</MudLink>
                            </MudStack>
                        }
                        @if(!string.IsNullOrWhiteSpace(_profile.LinkedIn))
                        {
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudIcon Icon="@Icons.Custom.Brands.LinkedIn" Color="Color.Default"/>
                                <MudLink Href="@($"https://linkedin.com/in/{_profile.LinkedIn}")" Target="_blank" Typo="Typo.body1">@_profile.LinkedIn</MudLink>
                            </MudStack>
                        }
                    </MudStack>
                </MudCardContent>
            </MudCard>
        }

        @* ── Collection Section ── *@
        @if(_collectedBooks?.Count > 0)
        {
            <MudExpansionPanels Class="mb-4">
                <MudExpansionPanel>
                    <TitleContent>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudIcon Icon="@Icons.Material.Filled.MenuBook" Color="Color.Primary"/>
                            <MudText Typo="Typo.h6">@L["Books"]</MudText>
                            <MudChip T="string" Color="Color.Primary" Size="Size.Small">@_collectedBooks.Count</MudChip>
                        </MudStack>
                    </TitleContent>
                    <ChildContent>
                        <MudList T="CollectedBookDto" Dense="true">
                            @foreach(CollectedBookDto book in _collectedBooks)
                            {
                                <MudListItem T="CollectedBookDto" Href="@($"/book/{book.BookId}")">
                                    <MudText Typo="Typo.body1">@book.Title</MudText>
                                </MudListItem>
                            }
                        </MudList>
                    </ChildContent>
                </MudExpansionPanel>
            </MudExpansionPanels>
        }

        @if(_collectedDocuments?.Count > 0)
        {
            <MudExpansionPanels Class="mb-4">
                <MudExpansionPanel>
                    <TitleContent>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudIcon Icon="@Icons.Material.Filled.Article" Color="Color.Primary"/>
                            <MudText Typo="Typo.h6">@L["Documents"]</MudText>
                            <MudChip T="string" Color="Color.Primary" Size="Size.Small">@_collectedDocuments.Count</MudChip>
                        </MudStack>
                    </TitleContent>
                    <ChildContent>
                        <MudList T="CollectedDocumentDto" Dense="true">
                            @foreach(CollectedDocumentDto doc in _collectedDocuments)
                            {
                                <MudListItem T="CollectedDocumentDto" Href="@($"/document/{doc.DocumentId}")">
                                    <MudText Typo="Typo.body1">@doc.Title</MudText>
                                </MudListItem>
                            }
                        </MudList>
                    </ChildContent>
                </MudExpansionPanel>
            </MudExpansionPanels>
        }

        @if(_collectedMagazineIssues?.Count > 0)
        {
            <MudExpansionPanels Class="mb-4">
                <MudExpansionPanel>
                    <TitleContent>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudIcon Icon="@Icons.Material.Filled.Bookmarks" Color="Color.Primary"/>
                            <MudText Typo="Typo.h6">@L["Magazine Issues"]</MudText>
                            <MudChip T="string" Color="Color.Primary" Size="Size.Small">@_collectedMagazineIssues.Count</MudChip>
                        </MudStack>
                    </TitleContent>
                    <ChildContent>
                        <MudList T="CollectedMagazineIssueDto" Dense="true">
                            @foreach(CollectedMagazineIssueDto issue in _collectedMagazineIssues)
                            {
                                <MudListItem T="CollectedMagazineIssueDto" Href="@($"/magazine/issue/{issue.MagazineIssueId}")">
                                    <MudText Typo="Typo.body1">
                                        @if(!string.IsNullOrWhiteSpace(issue.MagazineTitle))
                                        {
                                            <text>@issue.MagazineTitle &mdash; </text>
                                        }
                                        @issue.Caption
                                        @if(issue.IssueNumber.HasValue)
                                        {
                                            <text> (#@issue.IssueNumber.Value)</text>
                                        }
                                    </MudText>
                                </MudListItem>
                            }
                        </MudList>
                    </ChildContent>
                </MudExpansionPanel>
            </MudExpansionPanels>
        }

        @if(_collectedComputers?.Count > 0)
        {
            <MudExpansionPanels Class="mb-4">
                <MudExpansionPanel>
                    <TitleContent>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudIcon Icon="@Icons.Material.Filled.Computer" Color="Color.Primary"/>
                            <MudText Typo="Typo.h6">@L["Computers"]</MudText>
                            <MudChip T="string" Color="Color.Primary" Size="Size.Small">@_collectedComputers.Count</MudChip>
                        </MudStack>
                    </TitleContent>
                    <ChildContent>
                        <MudList T="CollectedMachineDto" Dense="true">
                            @foreach(CollectedMachineDto machine in _collectedComputers)
                            {
                                <MudListItem T="CollectedMachineDto" Href="@($"/machine/{machine.MachineId}")">
                                    <MudText Typo="Typo.body1">
                                        @(machine.CompanyName is not null ? $"{machine.CompanyName} {machine.Name}" : machine.Name)
                                    </MudText>
                                </MudListItem>
                            }
                        </MudList>
                    </ChildContent>
                </MudExpansionPanel>
            </MudExpansionPanels>
        }

        @if(_collectedConsoles?.Count > 0)
        {
            <MudExpansionPanels Class="mb-4">
                <MudExpansionPanel>
                    <TitleContent>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudIcon Icon="@Icons.Material.Filled.SportsEsports" Color="Color.Primary"/>
                            <MudText Typo="Typo.h6">@L["Consoles"]</MudText>
                            <MudChip T="string" Color="Color.Primary" Size="Size.Small">@_collectedConsoles.Count</MudChip>
                        </MudStack>
                    </TitleContent>
                    <ChildContent>
                        <MudList T="CollectedMachineDto" Dense="true">
                            @foreach(CollectedMachineDto machine in _collectedConsoles)
                            {
                                <MudListItem T="CollectedMachineDto" Href="@($"/machine/{machine.MachineId}")">
                                    <MudText Typo="Typo.body1">
                                        @(machine.CompanyName is not null ? $"{machine.CompanyName} {machine.Name}" : machine.Name)
                                    </MudText>
                                </MudListItem>
                            }
                        </MudList>
                    </ChildContent>
                </MudExpansionPanel>
            </MudExpansionPanels>
        }

        @if(_collectedSmartphones?.Count > 0)
        {
            <MudExpansionPanels Class="mb-4">
                <MudExpansionPanel>
                    <TitleContent>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudIcon Icon="@Icons.Material.Filled.Smartphone" Color="Color.Primary"/>
                            <MudText Typo="Typo.h6">@L["Smartphones"]</MudText>
                            <MudChip T="string" Color="Color.Primary" Size="Size.Small">@_collectedSmartphones.Count</MudChip>
                        </MudStack>
                    </TitleContent>
                    <ChildContent>
                        <MudList T="CollectedMachineDto" Dense="true">
                            @foreach(CollectedMachineDto machine in _collectedSmartphones)
                            {
                                <MudListItem T="CollectedMachineDto" Href="@($"/machine/{machine.MachineId}")">
                                    <MudText Typo="Typo.body1">
                                        @(machine.CompanyName is not null ? $"{machine.CompanyName} {machine.Name}" : machine.Name)
                                    </MudText>
                                </MudListItem>
                            }
                        </MudList>
                    </ChildContent>
                </MudExpansionPanel>
            </MudExpansionPanels>
        }

        @if(_collectedReleases?.Count > 0)
        {
            <MudExpansionPanels Class="mb-4">
                <MudExpansionPanel>
                    <TitleContent>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudIcon Icon="@Icons.Material.Filled.Apps" Color="Color.Primary"/>
                            <MudText Typo="Typo.h6">@L["Software"]</MudText>
                            <MudChip T="string" Color="Color.Primary" Size="Size.Small">@_collectedReleases.Count</MudChip>
                        </MudStack>
                    </TitleContent>
                    <ChildContent>
                        <MudList T="CollectedSoftwareReleaseDto" Dense="true">
                            @foreach(CollectedSoftwareReleaseDto release in _collectedReleases)
                            {
                                <MudListItem T="CollectedSoftwareReleaseDto" Href="@($"/software/release/{release.SoftwareReleaseId}")">
                                    <MudText Typo="Typo.body1">
                                        @release.SoftwareName
                                        @if(!string.IsNullOrEmpty(release.Version))
                                        {
                                            <text> @release.Version</text>
                                        }
                                        @if(!string.IsNullOrEmpty(release.Platform))
                                        {
                                            <text> (@release.Platform)</text>
                                        }
                                    </MudText>
                                </MudListItem>
                            }
                        </MudList>
                    </ChildContent>
                </MudExpansionPanel>
            </MudExpansionPanels>
        }

        @* ── Reviews Section ── *@
        @if(_userReviews?.Count > 0)
        {
            <MudExpansionPanels Class="mb-4">
                <MudExpansionPanel>
                    <TitleContent>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudIcon Icon="@Icons.Material.Filled.RateReview" Color="Color.Primary"/>
                            <MudText Typo="Typo.h6">@L["Reviews"]</MudText>
                            <MudChip T="string" Color="Color.Primary" Size="Size.Small">@_userReviews.Count</MudChip>
                        </MudStack>
                    </TitleContent>
                    <ChildContent>
                        @foreach(SoftwareUserReviewDto review in _userReviews)
                        {
                            <MudPaper Class="pa-3 mb-2" Elevation="1" Style="border-radius: 8px;">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                        <MudLink Href="@($"/software/{review.SoftwareId}")">@review.SoftwareName</MudLink>
                                        @if(review.Rating.HasValue)
                                        {
                                            <HalfStarRating ReadOnly="true" Value="@review.Rating.Value" Size="Size.Small"/>
                                        }
                                        @if(review.IsAnonymous.GetValueOrDefault() && _isAdmin)
                                        {
                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning">@L["Anonymous"]</MudChip>
                                        }
                                    </MudStack>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@review.CreatedOn?.DateTime.ToString("d")</MudText>
                                </MudStack>

                                @if(!string.IsNullOrWhiteSpace(review.TheGood))
                                {
                                    <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="1" Class="mb-1">
                                        <MudIcon Icon="@Icons.Material.Filled.ThumbUp" Color="Color.Success" Size="Size.Small"/>
                                        <MudText Typo="Typo.body2" Style="white-space: pre-wrap;">@review.TheGood</MudText>
                                    </MudStack>
                                }
                                @if(!string.IsNullOrWhiteSpace(review.TheBad))
                                {
                                    <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="1" Class="mb-1">
                                        <MudIcon Icon="@Icons.Material.Filled.ThumbDown" Color="Color.Error" Size="Size.Small"/>
                                        <MudText Typo="Typo.body2" Style="white-space: pre-wrap;">@review.TheBad</MudText>
                                    </MudStack>
                                }
                                @if(!string.IsNullOrWhiteSpace(review.TheUgly))
                                {
                                    <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="1" Class="mb-1">
                                        <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" Size="Size.Small"/>
                                        <MudText Typo="Typo.body2" Style="white-space: pre-wrap;">@review.TheUgly</MudText>
                                    </MudStack>
                                }

                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-1">
                                    <MudIcon Icon="@Icons.Material.Filled.ThumbUp" Size="Size.Small" Color="Color.Default"/>
                                    <MudText Typo="Typo.caption">@review.ThumbsUp</MudText>
                                    <MudIcon Icon="@Icons.Material.Filled.ThumbDown" Size="Size.Small" Color="Color.Default"/>
                                    <MudText Typo="Typo.caption">@review.ThumbsDown</MudText>
                                </MudStack>
                            </MudPaper>
                        }
                    </ChildContent>
                </MudExpansionPanel>
            </MudExpansionPanels>
        }
    </MudItem>
</MudGrid>
