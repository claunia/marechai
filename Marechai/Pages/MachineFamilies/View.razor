@page "/machine-family/{Id:int}"
@using Marechai.ApiClient.Models
@using Marechai.Data
@inherits OwningComponentBase<MachineFamiliesService>
@inject IStringLocalizer<MachineFamiliesService> L

@if(!_loaded)
{
    <div class="d-flex justify-center pa-8">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large"/>
    </div>

    return;
}

@if(_family is null)
{
    <MudAlert Severity="Severity.Warning">@L["Machine family not found."]</MudAlert>

    return;
}

<EntityMetaTags Title="@_family.Name"
                Description="@string.Format(L["Seo description"], _family.Name)"
                CanonicalPath="@($"/machine-family/{Id}")"
                Breadcrumbs="@(new (string, string?)[] { ("Companies", "/companies"), (_family.Name, null) })" />

@* ── Hero Header ── *@
<MudPaper Class="pa-6 mb-6" Elevation="0" Style="background: linear-gradient(135deg, #283593 0%, #5c6bc0 100%); border-radius: 16px;">
    <MudStack AlignItems="AlignItems.Center" Spacing="3">
        <MudIcon Icon="@Icons.Material.Filled.AccountTree" Size="Size.Large" Style="color: white;"/>
        <MudText Typo="Typo.h3" Align="Align.Center" Style="color: white; font-weight: 700;">@_family.Name</MudText>
        @if(!string.IsNullOrEmpty(_family.Company))
        {
            <MudChip T="string" Size="Size.Small" Style="color: white; border-color: rgba(255,255,255,0.5);" Variant="Variant.Outlined"
                     Href="@($"/company/{_family.CompanyId}")">
                @_family.Company
            </MudChip>
        }
    </MudStack>
</MudPaper>

@* ── Computers Card ── *@
@if(_computers.Count > 0)
{
<MudExpansionPanels Elevation="2" Class="mb-4 rounded-lg">
    <MudExpansionPanel>
        <TitleContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.Computer" Color="Color.Primary"/>
                <MudText Typo="Typo.h6">@L["Computers"]</MudText>
                <MudChip T="string" Size="Size.Small" Color="Color.Success">@_computers.Count</MudChip>
            </MudStack>
        </TitleContent>
        <ChildContent>
            <MudList T="MachineDto" Dense="true">
                @foreach(MachineDto computer in _computers)
                {
                    <MudListItem T="MachineDto" Href="@($"/machine/{computer.Id}")" Icon="@Icons.Material.Filled.Computer">
                        @computer.Name
                    </MudListItem>
                }
            </MudList>
        </ChildContent>
    </MudExpansionPanel>
</MudExpansionPanels>
}

