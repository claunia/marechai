@page "/gpus"
@using Marechai.ApiClient.Models
@inherits OwningComponentBase<GpusService>
@inject IStringLocalizer<GpusService> L
@inject IDialogService                 DialogService

@if(!_initialized)
{
    <div class="d-flex justify-center pa-8">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large"/>
    </div>

    return;
}

@* ── Hero Header ── *@
<MudPaper Class="pa-6 mb-6" Elevation="0" Style="background: linear-gradient(135deg, #7e57c2 0%, #42a5f5 100%); border-radius: 16px;">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
            <MudIcon Icon="@Icons.Material.Filled.Tv" Size="Size.Large" Style="color: white;"/>
            <MudText Typo="Typo.h4" Style="color: white;">@L["Graphics Processing Units"]</MudText>
        </MudStack>
        <AuthorizeView>
            <Authorized>
                <MudTooltip Text="@L["Suggest a new GPU to be added to the catalogue."]">
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Inherit"
                               StartIcon="@Icons.Material.Filled.AddCircle"
                               OnClick="OpenSuggestNewGpuDialog"
                               Style="color: white; border-color: rgba(255,255,255,0.7);">
                        @L["Suggest new GPU"]
                    </MudButton>
                </MudTooltip>
            </Authorized>
        </AuthorizeView>
    </MudStack>
    <MudChip T="string" Color="Color.Dark" Variant="Variant.Filled" Class="mt-2" Style="color: white; white-space: normal; height: auto; overflow: visible; text-overflow: unset; padding: 8px 16px;">@string.Format(L["{0} GPUs found in the database."], _total)</MudChip>
</MudPaper>

@if(_total > 0)
{
    <div id="@_scrollerId" style="height: 70vh; overflow-y: auto;">
        <Virtualize Items="_gpus" Context="gpu" ItemSize="88">
            @{
                bool isSpecial = gpu.Name is "DB_FRAMEBUFFER" or "DB_SOFTWARE" or "DB_NONE";
                string displayName = gpu.Name switch
                {
                    "DB_FRAMEBUFFER" => L["Framebuffer"],
                    "DB_SOFTWARE"    => L["Software"],
                    "DB_NONE"        => L["None"],
                    _                => gpu.Name ?? string.Empty
                };
            }
            <a href="/gpu/@gpu.Id" style="text-decoration: none; color: inherit;">
                <MudCard Elevation="1" Class="mb-2 rounded-lg" Style="cursor: pointer;">
                    <MudCardContent>
                        <div class="d-flex align-center gap-3">
                            @if(isSpecial)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.ScreenshotMonitor" Color="Color.Secondary"/>
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Filled.DeveloperBoard" Color="Color.Primary"/>
                            }
                            <div>
                                <MudText Typo="Typo.body1" Style="font-weight: 500;">@displayName</MudText>
                                @if(!string.IsNullOrEmpty(gpu.Company))
                                {
                                    <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary);">@gpu.Company</MudText>
                                }
                            </div>
                        </div>
                    </MudCardContent>
                </MudCard>
            </a>
        </Virtualize>
        <div id="@_sentinelId" style="height: 1px;"></div>
        @if(_loadingMore)
        {
            <div class="d-flex justify-center pa-3">
                <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true"/>
            </div>
        }
    </div>
}
else
{
    <MudAlert Severity="Severity.Info">@L["No GPUs found"]</MudAlert>
}

