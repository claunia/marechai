@page "/gpu/{Id:int}"
@using Marechai.ApiClient.Models
@using Marechai.Data
@inherits OwningComponentBase<GpusService>
@inject IStringLocalizer<GpusService> L
@inject GpuPhotosService GpuPhotosService
@inject ApiAssetUrlProvider AssetUrls

@if(!_loaded)
{
    <div class="d-flex justify-center pa-8">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large"/>
    </div>

    return;
}

@if(_gpu is null)
{
    <MudAlert Severity="Severity.Warning">@L["No GPUs found"]</MudAlert>

    return;
}

@* ── Hero Header ── *@
<MudPaper Class="pa-6 mb-6" Elevation="0" Style="background: linear-gradient(135deg, #7e57c2 0%, #42a5f5 100%); border-radius: 16px;">
    <MudStack AlignItems="AlignItems.Center" Spacing="3">
        <MudIcon Icon="@Icons.Material.Filled.DeveloperBoard" Size="Size.Large" Style="color: white;"/>
        <MudText Typo="Typo.h3" Align="Align.Center" Style="color: white; font-weight: 700;">@_displayName</MudText>
        @if(!string.IsNullOrEmpty(_gpu.Company))
        {
            <MudText Typo="Typo.subtitle1" Align="Align.Center" Style="color: rgba(255,255,255,0.85);">@_gpu.Company</MudText>
        }
    </MudStack>
</MudPaper>

@* ── Tabbed content (sticky frosted-glass tab bar; icon+label desktop, icon-only mobile) ── *@
<style>
    /* Rounded="true" sets overflow:hidden on .mud-tabs which breaks position:sticky on the tabbar.
       Force overflow:visible so the tabbar can stick to the page viewport. */
    .sticky-tabs.mud-tabs,
    .sticky-tabs .mud-tabs-panels {
        overflow: visible !important;
    }

    .sticky-tabs .mud-tabs-tabbar {
        position: sticky;
        /* MudAppBar (mt-16 = 64px) is fixed at top:0; offset the tabbar so it docks just below. */
        top: 64px;
        z-index: 5;
        /* Frosted-glass: white tint over a strong backdrop blur. Layered so it reads as
           "icy translucent" in both light and dark themes. */
        background-color: color-mix(in srgb, white 35%, var(--mud-palette-surface) 65%) !important;
        background-image: linear-gradient(rgba(255, 255, 255, 0.18), rgba(255, 255, 255, 0.06));
        backdrop-filter: blur(20px) saturate(180%) brightness(110%);
        -webkit-backdrop-filter: blur(20px) saturate(180%) brightness(110%);
        border-radius: 12px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.18);
        /* Visual breathing room between tab bar and content below. */
        margin-bottom: 20px;
    }

    /* MudTabPanel renders text directly next to the icon component, with no .mud-typography wrapper.
       Use font-size:0 to collapse the bare text node on mobile, then null the icon-text margin so
       the icon stays centered. SVG icons are unaffected by font-size. */
    @@media (max-width: 599.98px) {
        .sticky-tabs .mud-tab {
            font-size: 0 !important;
            min-width: 56px !important;
            padding: 6px 10px !important;
        }
        .sticky-tabs .mud-tab .mud-tab-icon-text {
            margin-right: 0 !important;
            margin-inline-end: 0 !important;
        }
    }
</style>

@* Sentinel rows (DB_NONE id=-1, DB_FRAMEBUFFER id=-2) have no specs/machines/
   media, so skip the entire tab block and render the description card alone. *@
@if(!_isSentinel)
{
<MudTabs Rounded="true"
         ApplyEffectsToContainer="true"
         KeepPanelsAlive="true"
         Centered="true"
         Color="Color.Primary"
         SliderColor="Color.Primary"
         Class="sticky-tabs mb-4"
         ActivePanelIndex="@_activeTabIndex"
         ActivePanelIndexChanged="OnTabChanged">

@* ── SPECIFICATIONS TAB ── *@
<MudTabPanel Text="@L["Specifications"]" Icon="@Icons.Material.Filled.Tune" ToolTip="@L["Specifications"]">

@* ── General Information Card ── *@
<MudCard Elevation="2" Class="mb-4 rounded-lg">
    <MudCardContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
            <MudIcon Icon="@Icons.Material.Filled.Info" Color="Color.Primary"/>
            <MudText Typo="Typo.h6">@L["Details"]</MudText>
        </MudStack>
        <MudSimpleTable Elevation="0" Dense="true">
            <tbody>
            @if(_gpu.ModelCode != null && _gpu.ModelCode != _gpu.Name)
            {
                <tr><td style="width: 33%; text-align: right;"><strong>@L["Model"]</strong></td><td>@_gpu.ModelCode</td></tr>
            }
            @if(_gpu.CompanyId.HasValue)
            {
                <tr><td style="width: 33%; text-align: right;"><strong>@L["Manufacturer"]</strong></td><td><MudLink Href="@($"/company/{_gpu.CompanyId}")">@_gpu.Company</MudLink></td></tr>
            }
            @if(_gpu.Introduced != null)
            {
                <tr><td style="width: 33%; text-align: right;"><strong>@L["Introduction date"]</strong></td><td>@($"{_gpu.Introduced:yyyy}")</td></tr>
            }
            @if(_gpu.Package != null)
            {
                <tr><td style="width: 33%; text-align: right;"><strong>@L["Package"]</strong></td><td>@_gpu.Package</td></tr>
            }
            @if(_gpu.Process != null || _gpu.ProcessNm > 0)
            {
                <tr>
                    <td style="width: 33%; text-align: right;"><strong>@L["Manufacturing process"]</strong></td>
                    <td>
                        @if(_gpu.Process != null && _gpu.ProcessNm > 0)
                        { @(_gpu.ProcessNm > 100 ? string.Format(L["{0} @{1}µm"], _gpu.Process, _gpu.ProcessNm / 100) : string.Format(L["{0} @{1}nm"], _gpu.Process, _gpu.ProcessNm)) }
                        else if(_gpu.ProcessNm > 0)
                        { @(_gpu.ProcessNm > 100 ? string.Format(L["{0}µm"], _gpu.ProcessNm / 100) : string.Format(L["{0}nm"], _gpu.ProcessNm)) }
                        else
                        { @_gpu.Process }
                    </td>
                </tr>
            }
            @if(_gpu.DieSize > 0)
            {
                <tr><td style="width: 33%; text-align: right;"><strong>@L["Die size"]</strong></td><td>@string.Format(L["{0} mm²"], _gpu.DieSize)</td></tr>
            }
            @if(_gpu.Transistors > 0)
            {
                <tr><td style="width: 33%; text-align: right;"><strong>@L["Transistors"]</strong></td><td>@_gpu.Transistors</td></tr>
            }
            </tbody>
        </MudSimpleTable>
    </MudCardContent>
</MudCard>

@* ── Description Card ── *@
@if(!string.IsNullOrWhiteSpace(_description))
{
    <MudCard Elevation="2" Class="mb-4 rounded-lg">
        <MudCardContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                <MudIcon Icon="@Icons.Material.Filled.Description" Color="Color.Primary"/>
                <MudText Typo="Typo.h6">@L["Description"]</MudText>
            </MudStack>
            <div style="color: var(--mud-palette-text-primary); overflow-wrap: break-word;">
                <style>
                    .gpu-description { line-height: 1.7; color: inherit; }
                    .gpu-description h1 { font-size: 1.75rem; margin: 2rem 0 1rem; line-height: 1.3; }
                    .gpu-description h2 { font-size: 1.5rem; margin: 2rem 0 1rem; line-height: 1.3; }
                    .gpu-description h3 { font-size: 1.25rem; margin: 1.5rem 0 0.75rem; line-height: 1.3; }
                    .gpu-description p { margin: 1rem 0; line-height: 1.8; }
                    .gpu-description ul, .gpu-description ol { margin: 1rem 0; padding-left: 1.75rem; }
                    .gpu-description li { margin: 0.6rem 0; line-height: 1.7; }
                    .gpu-description pre { background: var(--mud-palette-surface); padding: 1rem; overflow-x: auto; }
                    .gpu-description code { background: var(--mud-palette-surface); padding: 0.125rem 0.25rem; }
                    .gpu-description blockquote { border-left: 4px solid var(--mud-palette-primary); padding: 0.5rem 1rem; }
                    .gpu-description table { border-collapse: collapse; width: 100%; }
                    .gpu-description th, .gpu-description td { border: 1px solid var(--mud-palette-lines-default); padding: 0.5rem; }
                </style>
                <div class="gpu-description" style="padding: 8px;">
                    @((MarkupString)_description)
                </div>
            </div>
        </MudCardContent>
    </MudCard>
}

@* ── Resolutions Card ── *@
@if(_resolutions.Count > 0)
{
<MudExpansionPanels Elevation="2" Class="mb-4 rounded-lg">
    <MudExpansionPanel>
        <TitleContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.AspectRatio" Color="Color.Primary"/>
                <MudText Typo="Typo.h6">@L["Supported resolutions"]</MudText>
                <MudChip T="string" Size="Size.Small" Color="@(_resolutions.Count > 0 ? Color.Success : Color.Error)">@_resolutions.Count</MudChip>
            </MudStack>
        </TitleContent>
        <ChildContent>
            <MudSimpleTable Elevation="0" Dense="true">
                <thead>
                <tr>
                    <th>@L["Width"]</th>
                    <th>@L["Height"]</th>
                    <th>@L["Colors"]</th>
                    <th>@L["Palette"]</th>
                    <th>@L["Chars"]</th>
                    <th>@L["Grayscale"]</th>
                </tr>
                </thead>
                <tbody>
                @foreach(ResolutionDto res in _resolutions)
                {
                    <tr>
                        <td>@res.Width</td>
                        <td>@res.Height</td>
                        <td>@(res.Colors > 0 ? res.Colors : null)</td>
                        <td>@(res.Palette > 0 ? res.Palette : null)</td>
                        <td>@(res.Chars == true ? "✓" : null)</td>
                        <td>@(res.Grayscale == true ? "✓" : null)</td>
                    </tr>
                }
                </tbody>
            </MudSimpleTable>
        </ChildContent>
    </MudExpansionPanel>
</MudExpansionPanels>
}

</MudTabPanel>

@* ── MACHINES TAB (only when at least one of Computers/Consoles/Smartphones has entries) ── *@
@if(_computers.Count > 0 || _consoles.Count > 0 || _smartphones.Count > 0)
{
<MudTabPanel Text="@L["Machines"]" Icon="@Icons.Material.Filled.Devices" ToolTip="@L["Machines"]">

@* ── Computers Card ── *@
@if(_computers.Count > 0)
{
<MudExpansionPanels Elevation="2" Class="mb-4 rounded-lg">
    <MudExpansionPanel>
        <TitleContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.Computer" Color="Color.Primary"/>
                <MudText Typo="Typo.h6">@L["Computers"]</MudText>
                <MudChip T="string" Size="Size.Small" Color="@(_computers.Count > 0 ? Color.Success : Color.Error)">@_computers.Count</MudChip>
            </MudStack>
        </TitleContent>
        <ChildContent>
            <MudList T="MachineDto" Dense="true">
                @foreach(MachineDto computer in _computers)
                {
                    <MudListItem T="MachineDto" Href="@($"/machine/{computer.Id}")" Icon="@Icons.Material.Filled.Computer">
                        @computer.Company @computer.Name
                    </MudListItem>
                }
            </MudList>
        </ChildContent>
    </MudExpansionPanel>
</MudExpansionPanels>
}

@* ── Consoles Card ── *@
@if(_consoles.Count > 0)
{
<MudExpansionPanels Elevation="2" Class="mb-4 rounded-lg">
    <MudExpansionPanel>
        <TitleContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.SportsEsports" Color="Color.Primary"/>
                <MudText Typo="Typo.h6">@L["Consoles"]</MudText>
                <MudChip T="string" Size="Size.Small" Color="@(_consoles.Count > 0 ? Color.Success : Color.Error)">@_consoles.Count</MudChip>
            </MudStack>
        </TitleContent>
        <ChildContent>
            <MudList T="MachineDto" Dense="true">
                @foreach(MachineDto console in _consoles)
                {
                    <MudListItem T="MachineDto" Href="@($"/machine/{console.Id}")" Icon="@Icons.Material.Filled.SportsEsports">
                        @console.Company @console.Name
                    </MudListItem>
                }
            </MudList>
        </ChildContent>
    </MudExpansionPanel>
</MudExpansionPanels>
}

@* ── Smartphones Card ── *@
@if(_smartphones.Count > 0)
{
<MudExpansionPanels Elevation="2" Class="mb-4 rounded-lg">
    <MudExpansionPanel>
        <TitleContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.Smartphone" Color="Color.Primary"/>
                <MudText Typo="Typo.h6">@L["Smartphones"]</MudText>
                <MudChip T="string" Size="Size.Small" Color="@(_smartphones.Count > 0 ? Color.Success : Color.Error)">@_smartphones.Count</MudChip>
            </MudStack>
        </TitleContent>
        <ChildContent>
            <MudList T="MachineDto" Dense="true">
                @foreach(MachineDto smartphone in _smartphones)
                {
                    <MudListItem T="MachineDto" Href="@($"/machine/{smartphone.Id}")" Icon="@Icons.Material.Filled.Smartphone">
                        @smartphone.Company @smartphone.Name
                    </MudListItem>
                }
            </MudList>
        </ChildContent>
    </MudExpansionPanel>
</MudExpansionPanels>
}

</MudTabPanel>
}

@* ── MEDIA TAB ── *@
<MudTabPanel Text="@L["Media tab"]" Icon="@Icons.Material.Filled.PhotoLibrary" ToolTip="@L["Media tab"]">

@* ── Photos Card ── *@
@if(_photos.Count > 0)
{
    <MudCard Elevation="2" Class="mb-4 rounded-lg">
        <MudCardContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                <MudIcon Icon="@Icons.Material.Filled.PhotoLibrary" Color="Color.Primary"/>
                <MudText Typo="Typo.h6">@L["Photos"]</MudText>
                <MudChip T="string" Size="Size.Small" Color="Color.Secondary">@_photos.Count</MudChip>
            </MudStack>
            <MudGrid>
                @foreach(Guid photo in _photos)
                {
                    <MudItem xs="6" sm="4" md="3">
                        <MudCard Elevation="1" Class="rounded-lg">
                            <MudCardContent Class="pa-2 d-flex justify-center" Style="cursor: pointer;" @onclick="() => _lightbox.Show(_photos, photo)">
                                <picture>
                                    <source srcset="@(AssetUrls.BaseUrl)/assets/photos/gpus/thumbs/jxl/hd/@(photo).jxl, @(AssetUrls.BaseUrl)/assets/photos/gpus/thumbs/jxl/1440p/@(photo).jxl 2x, @(AssetUrls.BaseUrl)/assets/photos/gpus/thumbs/jxl/4k/@(photo).jxl 3x" type="image/jxl">
                                    <source srcset="@(AssetUrls.BaseUrl)/assets/photos/gpus/thumbs/avif/hd/@(photo).avif, @(AssetUrls.BaseUrl)/assets/photos/gpus/thumbs/avif/1440p/@(photo).avif 2x, @(AssetUrls.BaseUrl)/assets/photos/gpus/thumbs/avif/4k/@(photo).avif 3x" type="image/avif">
                                    <source srcset="@(AssetUrls.BaseUrl)/assets/photos/gpus/thumbs/heif/hd/@(photo).heic, @(AssetUrls.BaseUrl)/assets/photos/gpus/thumbs/heif/1440p/@(photo).heic 2x, @(AssetUrls.BaseUrl)/assets/photos/gpus/thumbs/heif/4k/@(photo).heic 3x" type="image/heic">
                                    <source srcset="@(AssetUrls.BaseUrl)/assets/photos/gpus/thumbs/webp/hd/@(photo).webp, @(AssetUrls.BaseUrl)/assets/photos/gpus/thumbs/webp/1440p/@(photo).webp 2x, @(AssetUrls.BaseUrl)/assets/photos/gpus/thumbs/webp/4k/@(photo).webp 3x" type="image/webp">
                                    <img alt="" height="auto" src="@(AssetUrls.BaseUrl)/assets/photos/gpus/thumbs/jpeg/hd/@(photo).jpg"
                                         srcset="@(AssetUrls.BaseUrl)/assets/photos/gpus/thumbs/jpeg/hd/@(photo).jpg, @(AssetUrls.BaseUrl)/assets/photos/gpus/thumbs/jpeg/1440p/@(photo).jpg 2x, @(AssetUrls.BaseUrl)/assets/photos/gpus/thumbs/jpeg/4k/@(photo).jpg 3x"
                                         style="max-height: 256px; max-width: 100%; border-radius: 8px;" width="auto"/>
                                </picture>
                            </MudCardContent>
                            <MudCardActions Class="justify-center">
                                <MudButton Href="@($"/gpus/photo/{photo}")" Target="_blank" Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.ZoomIn">@L["Details"]</MudButton>
                            </MudCardActions>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
        </MudCardContent>
    </MudCard>
}

@* ── Videos Card ── *@
@if(_videos is { Count: > 0 })
{
    <MudCard Elevation="2" Class="mb-4 rounded-lg">
        <MudCardContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                <MudIcon Icon="@Icons.Material.Filled.VideoLibrary" Color="Color.Primary"/>
                <MudText Typo="Typo.h6">@L["Videos"]</MudText>
                <MudChip T="string" Size="Size.Small" Color="Color.Secondary">@_videos.Count</MudChip>
            </MudStack>
            <MudGrid Spacing="3">
                @foreach(GpuVideoDto video in _videos)
                {
                    <MudItem xs="12" sm="6">
                        <MudCard Elevation="1" Class="rounded-lg">
                            @if(string.Equals(video.Provider, "YouTube", StringComparison.OrdinalIgnoreCase))
                            {
                                <div style="position: relative; width: 100%; padding-bottom: 56.25%; border-radius: 8px 8px 0 0; overflow: hidden;">
                                    <iframe src="@($"https://www.youtube-nocookie.com/embed/{video.VideoId}")"
                                            style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: 0;"
                                            title="@(video.Title ?? "Video")"
                                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                            allowfullscreen
                                            loading="lazy"
                                            referrerpolicy="no-referrer-when-downgrade"></iframe>
                                </div>
                            }
                            @if(!string.IsNullOrWhiteSpace(video.Title))
                            {
                                <MudCardContent>
                                    <MudText Typo="Typo.body2">@video.Title</MudText>
                                </MudCardContent>
                            }
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
        </MudCardContent>
    </MudCard>
}

</MudTabPanel>

</MudTabs>
}
else if(!string.IsNullOrWhiteSpace(_description))
{
    @* Sentinel branch: render only the description card (markup mirrors the
       Description Card inside the Specifications tab above). *@
    <MudCard Elevation="2" Class="mb-4 rounded-lg">
        <MudCardContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                <MudIcon Icon="@Icons.Material.Filled.Description" Color="Color.Primary"/>
                <MudText Typo="Typo.h6">@L["Description"]</MudText>
            </MudStack>
            <div style="color: var(--mud-palette-text-primary); overflow-wrap: break-word; word-break: break-word;">
                @* Same .gpu-description rules as the Description Card inside the
                   Specifications tab — duplicated here because the non-sentinel
                   branch is hidden on /gpu/-1 and /gpu/-2 so its <style> block
                   never enters the DOM. *@
                <style>
                    .gpu-description { line-height: 1.7; color: inherit; }
                    .gpu-description h1 { font-size: 1.75rem; margin: 2rem 0 1rem; line-height: 1.3; }
                    .gpu-description h2 { font-size: 1.5rem; margin: 2rem 0 1rem; line-height: 1.3; }
                    .gpu-description h3 { font-size: 1.25rem; margin: 1.5rem 0 0.75rem; line-height: 1.3; }
                    .gpu-description p { margin: 1rem 0; line-height: 1.8; }
                    .gpu-description ul, .gpu-description ol { margin: 1rem 0; padding-left: 1.75rem; }
                    .gpu-description li { margin: 0.6rem 0; line-height: 1.7; }
                    .gpu-description pre { background: var(--mud-palette-surface); padding: 1rem; overflow-x: auto; }
                    .gpu-description code { background: var(--mud-palette-surface); padding: 0.125rem 0.25rem; }
                    .gpu-description blockquote { border-left: 4px solid var(--mud-palette-primary); padding: 0.5rem 1rem; }
                    .gpu-description table { border-collapse: collapse; width: 100%; }
                    .gpu-description th, .gpu-description td { border: 1px solid var(--mud-palette-lines-default); padding: 0.5rem; }
                </style>
                <div class="gpu-description" style="padding: 8px;">
                    @((MarkupString)_description)
                </div>
            </div>
        </MudCardContent>
    </MudCard>
}

<PhotoLightbox @ref="_lightbox" BaseUrl="@AssetUrls.BaseUrl" Category="gpus"/>
