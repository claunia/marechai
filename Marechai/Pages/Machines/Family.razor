@page "/machines/family/{Id:int}"
@using Marechai.ApiClient.Models
@inherits OwningComponentBase<MachineFamiliesService>
@inject IStringLocalizer<MachineFamiliesService> L

@if(!_loaded)
{
    <div class="d-flex justify-center pa-8">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large"/>
    </div>

    return;
}

@if(_family is null)
{
    <MudAlert Severity="Severity.Warning">@L["Machine family not found in database"]</MudAlert>

    return;
}

<EntityMetaTags Title="@_family.Name"
               Description="@string.Format("Browse machines in the {0} family from the Marechai computing history catalogue.", _family.Name)"
               CanonicalPath="@($"/machines/family/{Id}")"
               OgType="website"
               Breadcrumbs="@(new (string, string?)[] { (L["Machines"], "/computers"), (_family.Name, null) })" />

<MudPaper Class="pa-6 mb-6" Elevation="0" Style="background: linear-gradient(135deg, #7e57c2 0%, #42a5f5 100%); border-radius: 16px;">
    <MudText Typo="Typo.h5" Style="color: white;">@_family.Name</MudText>
    @if(!string.IsNullOrEmpty(_family.Company))
    {
        <MudText Typo="Typo.h6" Style="color: rgba(255,255,255,0.85);">
            @if(_family.CompanyId.HasValue)
            {
                <MudLink Href="@($"/company/{_family.CompanyId}")" Style="color: rgba(255,255,255,0.95);">@_family.Company</MudLink>
            }
            else
            {
                @_family.Company
            }
        </MudText>
    }
</MudPaper>

@if(_machines is { Count: > 0 })
{
    <MudText Typo="Typo.body2" Class="mb-2">@string.Format(L["{0} machines found in this family."], _machines.Count)</MudText>
    <MudList T="MachineDto" Dense="true">
        @foreach(MachineDto machine in _machines)
        {
            <MudListItem T="MachineDto" Href="@($"/machine/{machine.Id}")" Icon="@Icons.Material.Filled.Computer">
                @machine.Name
            </MudListItem>
        }
    </MudList>
}
else
{
    <MudAlert Severity="Severity.Info">@L["There are no machines in this family."]</MudAlert>
}
