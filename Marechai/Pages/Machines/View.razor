@* ── Storage Card ── *@
@if(_machine.Storage.Count > 0)
{
    <MudCard Elevation="2" Class="mb-4 rounded-lg">
        <MudCardContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                <MudIcon Icon="@Icons.Material.Filled.SaveAlt" Color="Color.Primary"/>
                <MudText Typo="Typo.h6">@L["Storage"]</MudText>
                <MudChip T="string" Size="Size.Small" Color="Color.Secondary">@_machine.Storage.Count</MudChip>
            </MudStack>
            <MudStack Spacing="2">
                @foreach(StorageDto storage in _machine.Storage)
                {
                    string capString = null;
                    if(storage.Capacity != null)
                    {
                        if(storage.Type == (int)StorageType.CompactCassette)
                        { capString = string.Format(L["{0} bps"], storage.Capacity); }
                        else if(storage.Capacity > 1073741824)
                        { capString = string.Format(L["{0} GiB"], storage.Capacity / 1073741824); }
                        else if(storage.Capacity > 1048576)
                        { capString = string.Format(L["{0} MiB"], storage.Capacity / 1048576); }
                        else if(storage.Capacity > 1024)
                        { capString = string.Format(L["{0} KiB"], storage.Capacity / 1024); }
                        else if(storage.Capacity > 0)
                        { capString = string.Format(L["{0} bytes"], storage.Capacity); }
                    }

                    <MudPaper Elevation="0" Class="pa-3 rounded-lg" Style="border: 1px solid var(--mud-palette-lines-default);">
                        <MudText Typo="Typo.body1">
                            @if(storage.Interface != (int)StorageInterface.Unknown)
                            {
                                if(storage.Type == (int)StorageType.Empty)
                                { @string.Format(L["Available {0} interface."], ((StorageInterface)(storage.Interface ?? 0)).Humanize()) }
                                else if(capString != null)
                                { @string.Format(L["{0} connected thru a {1} interface with a nominal capacity of {2}"], ((StorageType)(storage.Type ?? 0)).Humanize(), ((StorageInterface)(storage.Interface ?? 0)).Humanize(), capString) }
                                else
                                { @string.Format(L["{0} connected thru a {1} interface"], ((StorageType)(storage.Type ?? 0)).Humanize(), ((StorageInterface)(storage.Interface ?? 0)).Humanize()) }
                            }
                            else
                            {
                                if(capString != null)
                                { @string.Format(L["{0} with a nominal capacity of {1}"], ((StorageType)(storage.Type ?? 0)).Humanize(), capString) }
                                else
                                { @(((StorageType)(storage.Type ?? 0)).Humanize()) }
                            }
                        </MudText>
                    </MudPaper>
                }
            </MudStack>
        </MudCardContent>
    </MudCard>
}

</MudTabPanel>

@* ── SOFTWARE TAB (only when machine has software entries) ── *@
@if(_softwareTotal > 0)
{
<MudTabPanel Text="@L["Software"]" Icon="@Icons.Material.Filled.Apps" ToolTip="@L["Software"]">

<MudCard Elevation="2" Class="mb-4 rounded-lg">
    <MudCardContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
            <MudIcon Icon="@Icons.Material.Filled.Apps" Color="Color.Primary"/>
            <MudText Typo="Typo.h6">@L["Software"]</MudText>
            <MudChip T="string" Size="Size.Small" Color="Color.Secondary">@_softwareTotal</MudChip>
            <MudSpacer/>
            <MudTextField T="string" ValueChanged="OnSoftwareSearch"
                          Placeholder="@L["Search software..."]"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          IconSize="Size.Medium" Class="mt-0" DebounceInterval="300" Immediate="true"
                          style="max-width: 300px;"/>
        </MudStack>
        @if(_softwareLoading)
        {
            <MudProgressLinear Indeterminate="true" Class="mb-2"/>
        }
        <MudList T="SoftwareDto" Dense="true">
            @foreach(SoftwareDto sw in _softwareItems)
            {
                <MudListItem T="SoftwareDto" Href="@($"/software/{sw.Id}")">
                    <div class="d-flex align-center gap-3">
                        @if(sw.FrontCoverId.HasValue)
                        {
                            <div class="sw-cover-thumb sw-cover-thumb-md">
                                <picture>
                                    <source srcset="@(AssetUrls.BaseUrl)/assets/photos/software-covers/avif/4k/@(sw.FrontCoverId).avif" type="image/avif">
                                    <source srcset="@(AssetUrls.BaseUrl)/assets/photos/software-covers/webp/4k/@(sw.FrontCoverId).webp" type="image/webp">
                                    <img alt="@sw.Name"
                                         src="@(AssetUrls.BaseUrl)/assets/photos/software-covers/jpeg/4k/@(sw.FrontCoverId).jpg"
                                         srcset="@(AssetUrls.BaseUrl)/assets/photos/software-covers/jpeg/4k/@(sw.FrontCoverId).jpg"/>
                                </picture>
                            </div>
                        }
                        else
                        {
                            <div class="sw-cover-thumb sw-cover-thumb-md">
                                <MudIcon Icon="@Icons.Material.Filled.Apps" Size="Size.Large" Color="Color.Default"/>
                            </div>
                        }
                        <div>
                            <MudText Typo="Typo.body1">@sw.Name</MudText>
                            @if(!string.IsNullOrEmpty(sw.Family))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@sw.Family</MudText>
                            }
                        </div>
                        @switch((Marechai.Data.SoftwareKind)(sw.Kind ?? 0))
                        {
                            case Marechai.Data.SoftwareKind.OperatingSystem:
                                <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">@L["OS"]</MudChip>
                                break;
                            case Marechai.Data.SoftwareKind.Game:
                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">@L["Game"]</MudChip>
                                break;
                            case Marechai.Data.SoftwareKind.Dlc:
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">@L["DLC / Addon"]</MudChip>
                                break;
                            case Marechai.Data.SoftwareKind.SystemSoftware:
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Style="color: #455A64; border-color: #455A64;">@L["System software"]</MudChip>
                                break;
                            case Marechai.Data.SoftwareKind.Application:
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Style="color: #1976D2; border-color: #1976D2;">@L["Application"]</MudChip>
                                break;
                            case Marechai.Data.SoftwareKind.DevelopmentSoftware:
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Style="color: #3F51B5; border-color: #3F51B5;">@L["Development software"]</MudChip>
                                break;
                            case Marechai.Data.SoftwareKind.ServerSoftware:
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Style="color: #795548; border-color: #795548;">@L["Server software"]</MudChip>
                                break;
                            case Marechai.Data.SoftwareKind.Middleware:
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Style="color: #00BCD4; border-color: #00BCD4;">@L["Middleware"]</MudChip>
                                break;
                            case Marechai.Data.SoftwareKind.Firmware:
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Style="color: #827717; border-color: #CDDC39;">@L["Firmware"]</MudChip>
                                break;
                            case Marechai.Data.SoftwareKind.EmbeddedSoftware:
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Style="color: #009688; border-color: #009688;">@L["Embedded software"]</MudChip>
                                break;
                            default:
                                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">@L["Software"]</MudChip>
                                break;
                        }
                    </div>
                </MudListItem>
            }
        </MudList>
        @if(_softwareTotal > _softwarePageSize)
        {
            <MudStack Row="true" Justify="Justify.Center" Class="mt-3">
                <MudPagination Count="@((int)Math.Ceiling((double)_softwareTotal / _softwarePageSize))"
                               Selected="_softwarePage"
                               SelectedChanged="OnSoftwarePageChanged"
                               ShowFirstButton="true" ShowLastButton="true"
                               BoundaryCount="1" MiddleCount="3"/>
            </MudStack>
        }
    </MudCardContent>
</MudCard>

</MudTabPanel>
}

