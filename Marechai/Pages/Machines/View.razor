                            </MudCardContent>
                            <MudCardActions Class="justify-center">
                                <MudButton Href="@($"/machines/photo/{photo}")" Target="_blank" Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.ZoomIn">@L["Details"]</MudButton>
                            </MudCardActions>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
        </MudCardContent>
    </MudCard>
}
else
{
    @* No photos yet — show empty-state hint with an AuthorizeView-gated upload button.
       NO MudCard wrapper per the design: the absence-of-photos message is intentionally
       slim so it doesn't compete visually with the populated cards on other machines.
       The button label is device-specific (computer/console/smartphone) via DeviceKind. *@
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="mb-4 pa-3"
              Style="background: var(--mud-palette-background-grey); border-radius: 8px;">
        <MudIcon Icon="@Icons.Material.Filled.PhotoLibrary" Color="Color.Default"/>
        <MudText Typo="Typo.body1" Style="flex: 1;">@NoPhotosHint</MudText>
        <AuthorizeView>
            <Authorized>
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.AddPhotoAlternate"
                           OnClick="OpenSuggestPhotosDialog">
                    @SuggestPhotosLabel
                </MudButton>
            </Authorized>
        </AuthorizeView>
    </MudStack>
}

@* ── Promo Art Card ── *@
<MudCard Elevation="2" Class="mb-4 rounded-lg">
    <MudCardContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.Campaign" Color="Color.Primary"/>
                <MudText Typo="Typo.h6">@L["Promo Art"]</MudText>
                @if(_promoArt.Count > 0)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Secondary">@_promoArt.Count</MudChip>
                }
            </MudStack>
            @if(_promoArt.Count > 0)
            {
                <AuthorizeView>
                    <Authorized>
                        <MudTooltip Text="@L["Suggest more promo art"]">
                            <MudIconButton Icon="@Icons.Material.Filled.AddPhotoAlternate"
                                           Color="Color.Primary" Size="Size.Small"
                                           OnClick="OpenSuggestPromoArtDialog"/>
                        </MudTooltip>
                    </Authorized>
                </AuthorizeView>
            }
        </MudStack>

        @if(_promoArt.Count == 0)
        {
            <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="py-3">
                <MudText Typo="Typo.body2" Align="Align.Center">
                    @L["No promo art for this machine yet — help us by uploading some."]
                </MudText>
                <AuthorizeView>
                    <Authorized>
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.AddPhotoAlternate"
                                   OnClick="OpenSuggestPromoArtDialog">
                            @L["Suggest promo art"]
                        </MudButton>
                    </Authorized>
                </AuthorizeView>
            </MudStack>
        }
        else
        {
            @foreach(var group in _promoArtByGroup)
            {
                <MudText Typo="Typo.subtitle1" Class="mt-3 mb-2"><strong>@group.Key</strong></MudText>
                <MudGrid>
                    @foreach(MachinePromoArtDto promo in group.Value)
                    {
                        <MudItem xs="12" sm="6" md="4" lg="3">
                            <MudCard Elevation="1" Class="rounded-lg" Style="cursor: pointer;"
                                     @onclick="() => _fullscreenPromo = promo">
                                <MudCardContent Class="pa-2">
                                    <picture>
                                        <source srcset="@(AssetUrls.BaseUrl)/assets/photos/machine-promo-art/avif/4k/@(promo.Id).avif" type="image/avif">
                                        <source srcset="@(AssetUrls.BaseUrl)/assets/photos/machine-promo-art/webp/4k/@(promo.Id).webp" type="image/webp">
                                        <img alt="@(promo.Caption ?? promo.GroupName)"
                                             src="@(AssetUrls.BaseUrl)/assets/photos/machine-promo-art/jpeg/4k/@(promo.Id).jpg"
                                             srcset="@(AssetUrls.BaseUrl)/assets/photos/machine-promo-art/jpeg/4k/@(promo.Id).jpg"
                                             style="width: 100%; height: auto; border-radius: 4px;"/>
                                    </picture>
                                    @if(!string.IsNullOrEmpty(promo.Caption))
                                    {
                                        <MudText Typo="Typo.caption" Align="Align.Center" Class="mt-1">@promo.Caption</MudText>
                                    }
                                </MudCardContent>
                            </MudCard>
                        </MudItem>
                    }
                </MudGrid>
            }
        }
    </MudCardContent>
</MudCard>

@if(_fullscreenPromo is not null)
{
    var promo = _fullscreenPromo;
    <MudOverlay Visible="true" DarkBackground="true" ZIndex="9999" OnClick="() => _fullscreenPromo = null">
        <div class="d-flex flex-column align-center justify-center" style="width: 100vw; height: 100vh;">
            <picture>
                <source srcset="@(AssetUrls.BaseUrl)/assets/photos/machine-promo-art/avif/4k/@(promo.Id).avif" type="image/avif">
                <source srcset="@(AssetUrls.BaseUrl)/assets/photos/machine-promo-art/webp/4k/@(promo.Id).webp" type="image/webp">
                <img alt="@(promo.Caption ?? promo.GroupName)"
                     src="@(AssetUrls.BaseUrl)/assets/photos/machine-promo-art/jpeg/4k/@(promo.Id).jpg"
                     style="max-width: 95vw; max-height: 90vh; object-fit: contain;"/>
            </picture>
            @if(!string.IsNullOrEmpty(promo.GroupName))
            {
                <MudText Typo="Typo.subtitle1" Style="color: white;" Class="mt-2">@promo.GroupName</MudText>
            }
            @if(!string.IsNullOrEmpty(promo.Caption))
            {
                <MudText Typo="Typo.body2" Style="color: rgba(255,255,255,0.8);" Class="mt-1">@promo.Caption</MudText>
            }
        </div>
    </MudOverlay>
}

@* ── Videos Card ──
   Conditional always-visible: when count > 0, the populated card renders with a `+`
   AddCircle button overlay (auth-only) so collaborators can suggest more videos. When
   empty, the card is HIDDEN from anonymous visitors (keeps the public page minimal);
   authenticated visitors see a slim empty-state hint with a Suggest button.
   Add-only convention: collaborators can ONLY add videos, never edit/remove existing
   ones — the icon is `+` (AddCircle), NOT pencil. *@
@if(_videos is { Count: > 0 })
{
    <MudCard Elevation="2" Class="mb-4 rounded-lg">
        <MudCardContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.VideoLibrary" Color="Color.Primary"/>
                    <MudText Typo="Typo.h6">@L["Videos"]</MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Secondary">@_videos.Count</MudChip>
                </MudStack>
                <AuthorizeView>
                    <Authorized>
                        <MudTooltip Text="@L["Suggest more videos"]">
                            <MudIconButton Icon="@Icons.Material.Filled.AddCircle"
                                           Color="Color.Primary" Size="Size.Small"
                                           OnClick="OpenSuggestVideoDialog"/>
                        </MudTooltip>
                    </Authorized>
                </AuthorizeView>
            </MudStack>
            <MudGrid Spacing="3">
                @foreach(MachineVideoDto video in _videos)
                {
                    <MudItem xs="12" sm="6">
                        <MudCard Elevation="1" Class="rounded-lg">
                            @if(string.Equals(video.Provider, "YouTube", StringComparison.OrdinalIgnoreCase))
                            {
                                <div style="position: relative; width: 100%; padding-bottom: 56.25%; border-radius: 8px 8px 0 0; overflow: hidden;">
                                    <iframe src="@($"https://www.youtube-nocookie.com/embed/{video.VideoId}")"
                                            style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: 0;"
                                            title="@(video.Title ?? "Video")"
                                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                            allowfullscreen
                                            loading="lazy"
                                            referrerpolicy="no-referrer-when-downgrade"></iframe>
                                </div>
                            }
                            @if(!string.IsNullOrWhiteSpace(video.Title))
                            {
                                <MudCardContent>
                                    <MudText Typo="Typo.body2">@video.Title</MudText>
                                </MudCardContent>
                            }
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
        </MudCardContent>
    </MudCard>
}
else
{
    <AuthorizeView>
        <Authorized>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="mb-4 pa-3"
                      Style="background: var(--mud-palette-background-grey); border-radius: 8px;">
                <MudIcon Icon="@Icons.Material.Filled.VideoLibrary" Color="Color.Default"/>
                <MudText Typo="Typo.body1" Style="flex: 1;">@NoVideosHint</MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.AddCircle"
                           OnClick="OpenSuggestVideoDialog">
                    @L["Suggest a YouTube video"]
                </MudButton>
            </MudStack>
        </Authorized>
    </AuthorizeView>
}

</MudTabPanel>

</MudTabs>

<PhotoLightbox @ref="_lightbox" BaseUrl="@AssetUrls.BaseUrl" Category="machines"/>

<img alt="" src="@($"{AssetUrls.BaseUrl}/assets/photos/computers/{_machine.Id}.jpg")">
