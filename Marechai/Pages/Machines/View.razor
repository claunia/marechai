@page "/machine/{Id:int}"
@using Marechai.ApiClient.Models
@using Humanizer
@using Marechai.Data
@using Marechai.Pages.Suggestions
@inherits OwningComponentBase<MachinesService>
@inject IStringLocalizer<MachinesService> L
@inject ApiAssetUrlProvider               AssetUrls
@inject MachinePhotosService              MachinePhotosService
@inject MachinePromoArtService            MachinePromoArtService
@inject CollectionService                 CollectionSvc
@inject IDialogService                    DialogService
@inject SuggestionsService                Suggestions

@if(!_loaded)
{
    <div class="d-flex justify-center pa-8">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large"/>
    </div>

    return;
}

@if(_machine is null)
{
    <MudAlert Severity="Severity.Warning">@L["Machine not found in database"]</MudAlert>

    return;
}

@{
    var _seoParent = _machine.Type switch
    {
        (int)Marechai.Data.MachineType.Console    => ("Consoles",    "/consoles"),
        (int)Marechai.Data.MachineType.Smartphone => ("Smartphones", "/smartphones"),
        (int)Marechai.Data.MachineType.Pda        => ("PDAs",        "/pdas"),
        (int)Marechai.Data.MachineType.Tablet     => ("Tablets",     "/tablets"),
        _                                          => ("Computers",   "/computers")
    };
}

<EntityMetaTags Title="@_machine.Name"
                Description="@string.Format(L["Seo description"], _machine.Name)"
                CanonicalPath="@($"/machine/{Id}")"
                Breadcrumbs="@(new (string, string?)[] { (_seoParent.Item1, _seoParent.Item2), (_machine.Name, null) })" />

@* ── Hero Header ── *@
<MudPaper Class="pa-6 mb-6" Elevation="0" Style="background: linear-gradient(135deg, #7e57c2 0%, #42a5f5 100%); border-radius: 16px;">
    <MudStack AlignItems="AlignItems.Center" Spacing="3">
        @if(_machine.CompanyLogo != null)
        {
            <MudLink Href="@($"/company/{_machine.CompanyId}")">
                <picture>
                    <source srcset="@(AssetUrls.BaseUrl)/assets/logos/@(_machine.CompanyLogo).svg" type="image/svg+xml">
                    <source srcset="@(AssetUrls.BaseUrl)/assets/logos/webp/1x/@(_machine.CompanyLogo).webp,
    @(AssetUrls.BaseUrl)/assets/logos/webp/2x/@(_machine.CompanyLogo).webp 2x,
    @(AssetUrls.BaseUrl)/assets/logos/webp/3x/@(_machine.CompanyLogo).webp 3x" type="image/webp">
                    <img alt="@_machine.Company" height="auto" src="@(AssetUrls.BaseUrl)/assets/logos/png/1x/@(_machine.CompanyLogo).png"
                         srcset="@(AssetUrls.BaseUrl)/assets/logos/png/1x/@(_machine.CompanyLogo).png,
                             @(AssetUrls.BaseUrl)/assets/logos/png/2x/@(_machine.CompanyLogo).png 2x,
                             @(AssetUrls.BaseUrl)/assets/logos/png/3x/@(_machine.CompanyLogo).png 3x"
                         style="max-height: 128px; max-width: 200px; filter: drop-shadow(0 0 4px rgba(255,255,255,0.9)) drop-shadow(0 0 8px rgba(255,255,255,0.6));" width="auto"/>
                </picture>
            </MudLink>
        }
        else
        {
            <MudLink Href="@($"/company/{_machine.CompanyId}")" Style="color: white; text-decoration: none;">
                <MudText Typo="Typo.h3" Style="color: white; font-weight: 700;">@_machine.Company</MudText>
            </MudLink>
        }
        @if(_machine.Prototype == true)
        {
            <MudChip T="string" Color="Color.Warning" Variant="Variant.Filled">@L["PROTOTYPE"]</MudChip>
        }
        <MudText Typo="Typo.h4" Align="Align.Center" Style="color: white;">@_machine.Name</MudText>
        <AuthorizeView>
            <Authorized>
                <MudButton Variant="Variant.Filled"
                           Color="@(_isCollected ? Color.Success : Color.Default)"
                           StartIcon="@(_isCollected ? Icons.Material.Filled.Bookmark : Icons.Material.Outlined.BookmarkBorder)"
                           OnClick="ToggleCollectionAsync"
                           Disabled="_togglingCollection"
                           Size="Size.Small">
                    @(_isCollected ? L["In Collection"] : L["Add to Collection"])
                </MudButton>
            </Authorized>
        </AuthorizeView>
    </MudStack>
</MudPaper>

@* ── Tabbed content (sticky frosted-glass tab bar; icon+label desktop, icon-only mobile) ── *@
<style>
    /* Rounded="true" sets overflow:hidden on .mud-tabs which breaks position:sticky on the tabbar.
       Force overflow:visible so the tabbar can stick to the page viewport. */
    .sticky-tabs.mud-tabs,
    .sticky-tabs .mud-tabs-panels {
        overflow: visible !important;
    }

    .sticky-tabs .mud-tabs-tabbar {
        position: sticky;
        /* MudAppBar (mt-16 = 64px) is fixed at top:0; offset the tabbar so it docks just below. */
        top: 64px;
        z-index: 5;
        /* Frosted-glass: white tint over a strong backdrop blur. Layered so it reads as
           "icy translucent" in both light and dark themes. */
        background-color: color-mix(in srgb, white 35%, var(--mud-palette-surface) 65%) !important;
        background-image: linear-gradient(rgba(255, 255, 255, 0.18), rgba(255, 255, 255, 0.06));
        backdrop-filter: blur(20px) saturate(180%) brightness(110%);
        -webkit-backdrop-filter: blur(20px) saturate(180%) brightness(110%);
        border-radius: 12px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.18);
        /* Visual breathing room between tab bar and content below. */
        margin-bottom: 20px;
    }

    /* MudTabPanel renders text directly next to the icon component, with no .mud-typography wrapper.
       Use font-size:0 to collapse the bare text node on mobile, then null the icon-text margin so
       the icon stays centered. SVG icons are unaffected by font-size. */
    @@media (max-width: 599.98px) {
        .sticky-tabs .mud-tab {
            font-size: 0 !important;
            min-width: 56px !important;
            padding: 6px 10px !important;
        }
        .sticky-tabs .mud-tab .mud-tab-icon-text {
            margin-right: 0 !important;
            margin-inline-end: 0 !important;
        }
    }
</style>

<MudTabs Rounded="true"
         ApplyEffectsToContainer="true"
         KeepPanelsAlive="true"
         Centered="true"
         Color="Color.Primary"
         SliderColor="Color.Primary"
         Class="sticky-tabs mb-4"
         ActivePanelIndex="@_activeTabIndex"
         ActivePanelIndexChanged="OnTabChanged">

@* ── SPECIFICATIONS TAB ── *@
<MudTabPanel Text="@L["Specifications"]" Icon="@Icons.Material.Filled.Tune" ToolTip="@L["Specifications"]">

@* ── General Information Card ── *@
<MudCard Elevation="2" Class="mb-4 rounded-lg">
    <MudCardContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.Info" Color="Color.Primary"/>
                <MudText Typo="Typo.h6">@L["General"]</MudText>
            </MudStack>
            <AuthorizeView>
                <Authorized>
                    <MudTooltip Text="@L["Suggest changes"]">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Secondary"
                                       OnClick="OpenMachineSuggestionDialog"
                                       aria-label="@L["Suggest changes"]"/>
                    </MudTooltip>
                </Authorized>
            </AuthorizeView>
        </MudStack>
        <MudSimpleTable Elevation="0" Dense="true">
            <tbody>
            @if(_machine.Introduced.HasValue && _machine.Prototype != true)
            {
                <tr>
                    <td style="width: 33%; text-align: right;"><strong>@L["Introduction date"]</strong></td>
                    <td>
                        @if(_machine.Type == (int)MachineType.Computer)
                        {
                            <MudLink Href="@($"/computers/year/{_machine.Introduced.Value.Year}")">@(((_machine.IntroducedPrecision ?? 0) == 2 ? _machine.Introduced.Value.Year.ToString() : (_machine.IntroducedPrecision ?? 0) == 1 ? _machine.Introduced.Value.ToString("MMMM yyyy") : _machine.Introduced.Value.DateTime.ToLongDateString()))</MudLink>
                        }
                        else if(_machine.Type == (int)MachineType.Console)
                        {
                            <MudLink Href="@($"/consoles/year/{_machine.Introduced.Value.Year}")">@(((_machine.IntroducedPrecision ?? 0) == 2 ? _machine.Introduced.Value.Year.ToString() : (_machine.IntroducedPrecision ?? 0) == 1 ? _machine.Introduced.Value.ToString("MMMM yyyy") : _machine.Introduced.Value.DateTime.ToLongDateString()))</MudLink>
                        }
                        else if(_machine.Type == (int)MachineType.Smartphone)
                        {
                            <MudLink Href="@($"/smartphones/year/{_machine.Introduced.Value.Year}")">@(((_machine.IntroducedPrecision ?? 0) == 2 ? _machine.Introduced.Value.Year.ToString() : (_machine.IntroducedPrecision ?? 0) == 1 ? _machine.Introduced.Value.ToString("MMMM yyyy") : _machine.Introduced.Value.DateTime.ToLongDateString()))</MudLink>
                        }
                        else if(_machine.Type == (int)MachineType.Pda)
                        {
                            <MudLink Href="@($"/pdas/year/{_machine.Introduced.Value.Year}")">@(((_machine.IntroducedPrecision ?? 0) == 2 ? _machine.Introduced.Value.Year.ToString() : (_machine.IntroducedPrecision ?? 0) == 1 ? _machine.Introduced.Value.ToString("MMMM yyyy") : _machine.Introduced.Value.DateTime.ToLongDateString()))</MudLink>
                        }
                        else if(_machine.Type == (int)MachineType.Tablet)
                        {
                            <MudLink Href="@($"/tablets/year/{_machine.Introduced.Value.Year}")">@(((_machine.IntroducedPrecision ?? 0) == 2 ? _machine.Introduced.Value.Year.ToString() : (_machine.IntroducedPrecision ?? 0) == 1 ? _machine.Introduced.Value.ToString("MMMM yyyy") : _machine.Introduced.Value.DateTime.ToLongDateString()))</MudLink>
                        }
                        else
                        {
                            @(((_machine.IntroducedPrecision ?? 0) == 2 ? _machine.Introduced.Value.Year.ToString() : (_machine.IntroducedPrecision ?? 0) == 1 ? _machine.Introduced.Value.ToString("MMMM yyyy") : _machine.Introduced.Value.DateTime.ToLongDateString()))
                        }
                    </td>
                </tr>
            }
            @if(_machine.FamilyId != null)
            {
                <tr>
                    <td style="width: 33%; text-align: right;"><strong>@L["Family"]</strong></td>
                    <td><MudLink Href="@($"/machines/family/{_machine.FamilyId}")">@_machine.FamilyName</MudLink></td>
                </tr>
            }
            @if(_machine.Model != null)
            {
                <tr>
                    <td style="width: 33%; text-align: right;"><strong>@L["Model"]</strong></td>
                    <td>@_machine.Model</td>
                </tr>
            }
            </tbody>
        </MudSimpleTable>
    </MudCardContent>
</MudCard>

@* ── Description Card ── *@
@{
    string _noDescriptionKey = (MachineType)_machine.Type switch
    {
        MachineType.Console    => "We do not have a description for this console, you could collaborate by suggesting one",
        MachineType.Smartphone => "We do not have a description for this smartphone, you could collaborate by suggesting one",
        MachineType.Pda        => "We do not have a description for this PDA, you could collaborate by suggesting one",
        MachineType.Tablet     => "We do not have a description for this tablet, you could collaborate by suggesting one",
        _                      => "We do not have a description for this computer, you could collaborate by suggesting one"
    };
}
@if(!_hasAnyDescription)
{
    <MudCard Elevation="2" Class="mb-4 rounded-lg">
        <MudCardContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Description" Color="Color.Primary"/>
                    <MudText Typo="Typo.h6">@L["Description"]</MudText>
                </MudStack>
            </MudStack>
            <AuthorizeView>
                <Authorized>
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-2">
                        @L[_noDescriptionKey]
                    </MudAlert>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.AddComment"
                               OnClick="OpenDescriptionPickerAsync">
                        @L["Suggest description"]
                    </MudButton>
                </Authorized>
                <NotAuthorized>
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                        @L[_noDescriptionKey]
                    </MudAlert>
                </NotAuthorized>
            </AuthorizeView>
        </MudCardContent>
    </MudCard>
}
else
{
    @if(_descriptionFellBack)
    {
        <AuthorizeView>
            <Authorized>
                <MudAlert Severity="Severity.Info"
                          Variant="Variant.Outlined"
                          Class="mb-3">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="3" Style="width: 100%;">
                        <MudText>
                            @L["We do not have a description in your language, you could collaborate by translating the English description we show below"]
                        </MudText>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Translate"
                                   OnClick="OpenDescriptionPickerAsync">
                            @L["Suggest translation"]
                        </MudButton>
                    </MudStack>
                </MudAlert>
            </Authorized>
        </AuthorizeView>
    }

    <MudCard Elevation="2" Class="mb-4 rounded-lg">
        <MudCardContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Description" Color="Color.Primary"/>
                    <MudText Typo="Typo.h6">@L["Description"]</MudText>
                </MudStack>
                <AuthorizeView>
                    <Authorized>
                        <MudTooltip Text="@L["Suggest changes"]">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Size="Size.Small"
                                           Color="Color.Secondary"
                                           OnClick="OpenDescriptionPickerAsync"
                                           aria-label="@L["Suggest changes"]"/>
                        </MudTooltip>
                    </Authorized>
                </AuthorizeView>
            </MudStack>
            <div style="color: var(--mud-palette-text-primary); overflow-wrap: break-word; word-break: break-word;">
                <style>
                    .machine-description {
                        color: inherit;
                        line-height: 1.7;
                    }
                    .machine-description h1 {
                        font-size: 1.75rem;
                        font-weight: 700;
                        margin: 2rem 0 1rem;
                        line-height: 1.3;
                    }
                    .machine-description h2 {
                        font-size: 1.5rem;
                        font-weight: 600;
                        margin: 2rem 0 1rem;
                        line-height: 1.3;
                    }
                    .machine-description h3 {
                        font-size: 1.25rem;
                        font-weight: 600;
                        margin: 1.5rem 0 0.75rem;
                        line-height: 1.3;
                    }
                    .machine-description h4, .machine-description h5, .machine-description h6 {
                        font-size: 1.1rem;
                        font-weight: 600;
                        margin: 1.25rem 0 0.6rem;
                        line-height: 1.3;
                    }
                    .machine-description p {
                        margin: 1rem 0;
                        line-height: 1.8;
                    }
                    .machine-description ul, .machine-description ol {
                        margin: 1rem 0;
                        padding-left: 1.75rem;
                    }
                    .machine-description li {
                        margin: 0.6rem 0;
                        line-height: 1.7;
                    }
                    .machine-description strong {
                        font-weight: 700;
                    }
                    .machine-description img {
                        max-width: 100%;
                        height: auto;
                    }
                    .machine-description pre {
                        overflow-x: auto;
                        max-width: 100%;
                        background: var(--mud-palette-surface);
                        padding: 1rem;
                        border-radius: 4px;
                    }
                    .machine-description code {
                        background: var(--mud-palette-surface);
                        padding: 0.125rem 0.25rem;
                        border-radius: 3px;
                        font-size: 0.875em;
                    }
                    .machine-description blockquote {
                        border-left: 4px solid var(--mud-palette-primary);
                        margin: 0.75rem 0;
                        padding: 0.5rem 1rem;
                        opacity: 0.85;
                    }
                    .machine-description table {
                        border-collapse: collapse;
                        margin: 0.75rem 0;
                        width: 100%;
                    }
                    .machine-description th, .machine-description td {
                        border: 1px solid var(--mud-palette-lines-default);
                        padding: 0.5rem;
                    }
                    .machine-description hr {
                        border: none;
                        border-top: 1px solid var(--mud-palette-lines-default);
                        margin: 1rem 0;
                    }
                </style>
                <div class="machine-description" style="padding: 8px;">
                    @((MarkupString)_description)
                </div>
            </div>
        </MudCardContent>
    </MudCard>
}

@* ── Processors Card ── *@
@if(_machine.Processors.Count > 0)
{
    <MudCard Elevation="2" Class="mb-4 rounded-lg">
        <MudCardContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                <MudIcon Icon="@Icons.Material.Filled.Memory" Color="Color.Primary"/>
                <MudText Typo="Typo.h6">@L["Processors"]</MudText>
                <MudChip T="string" Size="Size.Small" Color="Color.Secondary">@_machine.Processors.Count</MudChip>
            </MudStack>
            <MudExpansionPanels MultiExpansion="true">
                @foreach(ProcessorDto processor in _machine.Processors)
                {
                    <MudExpansionPanel>
                        <TitleContent>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudIcon Icon="@Icons.Material.Filled.DeveloperBoard" Size="Size.Small" Color="Color.Secondary"/>
                                <MudLink Href="@($"/processor/{processor.Id}")" Style="color: inherit;" Typo="Typo.body1">
                                    @if(processor.Speed > 0)
                                    {
                                        @(processor.GprSize > 0
                                            ? string.Format(L["{0} @{1}MHz ({2} bits)"], processor.Name, processor.Speed, processor.GprSize)
                                            : string.Format(L["{0} @{1}MHz"], processor.Name, processor.Speed))
                                    }
                                    else
                                    {
                                        @processor.Name
                                    }
                                </MudLink>
                            </MudStack>
                        </TitleContent>
                        <ChildContent>
                            <MudSimpleTable Elevation="0" Dense="true">
                                <tbody>
                                @if(processor.ModelCode != null && processor.ModelCode != processor.Name)
                                {
                                    <tr>
                                        <td style="width: 33%; text-align: right;">@L["Model"]</td>
                                        <td>@processor.ModelCode</td>
                                    </tr>
                                }
                                <tr>
                                    <td style="width: 33%; text-align: right;">@L["Manufacturer"]</td>
                                    <td><MudLink Href="@($"/company/{processor.CompanyId}")">@processor.Company</MudLink></td>
                                </tr>
                                @if(processor.Introduced != null)
                                {
                                    <tr>
                                        <td style="width: 33%; text-align: right;">@L["Introduction date"]</td>
                                        <td>@($"{processor.Introduced:yyyy}")</td>
                                    </tr>
                                }
                                @if(processor.InstructionSet != null)
                                {
                                    <tr>
                                        <td style="width: 33%; text-align: right;">@L["Instruction set"]</td>
                                        <td>@processor.InstructionSet</td>
                                    </tr>
                                }
                                @if(processor.Speed > 0)
                                {
                                    <tr>
                                        <td style="width: 33%; text-align: right;">@L["Nominal speed"]</td>
                                        <td>@string.Format(L["{0} MHz"], processor.Speed)</td>
                                    </tr>
                                }
                                @if(processor.Gprs > 0 || processor.Fprs > 0 || processor.SimdRegisters > 0)
                                {
                                    <tr>
                                        <td style="width: 33%; text-align: right;">@L["Registers"]</td>
                                        <td>
                                            <MudStack Spacing="1">
                                                @if(processor.Gprs > 0)
                                                {
                                                    <MudText Typo="Typo.body2">
                                                        @if(processor.FprSize > 0 && processor.Fprs == 0 && processor.SimdSize > 0 && processor.SimdRegisters == 0)
                                                        {
                                                            @(string.Format(L["{0} general purpose registers of {1} bits that can be used as floating point registers of {2} bits and SIMD registers of {3} bits."], processor.Gprs, processor.GprSize, processor.FprSize, processor.SimdSize))
                                                        }
                                                        else if(processor.FprSize > 0 && processor.Fprs == 0)
                                                        {
                                                            @(string.Format(L["{0} general purpose registers of {1} bits that can be used as floating point registers of {2} bits."], processor.Gprs, processor.GprSize, processor.FprSize))
                                                        }
                                                        else if(processor.FprSize == 0 && processor.SimdSize > 0 && processor.SimdRegisters == 0)
                                                        {
                                                            @(string.Format(L["{0} general purpose registers of {1} bits that can be used as SIMD registers of {2} bits."], processor.Gprs, processor.GprSize, processor.SimdSize))
                                                        }
                                                        else
                                                        {
                                                            @(string.Format(L["{0} general purpose registers of {1} bits."], processor.Gprs, processor.GprSize))
                                                        }
                                                    </MudText>
                                                }
                                                @if(processor.Fprs > 0)
                                                {
                                                    <MudText Typo="Typo.body2">
                                                        @if(processor.SimdSize > 0 && processor.SimdRegisters == 0)
                                                        {
                                                            @(string.Format(L["{0} floating point registers of {1} bits that can be used as SIMD registers of {2} bits."], processor.Fprs, processor.FprSize, processor.SimdSize))
                                                        }
                                                        else
                                                        {
                                                            @(string.Format(L["{0} floating point registers of {1} bits."], processor.Fprs, processor.FprSize))
                                                        }
                                                    </MudText>
                                                }
                                                @if(processor.SimdRegisters > 0)
                                                {
                                                    <MudText Typo="Typo.body2">
                                                        <MudTooltip Text="@L["Single instruction, multiple data"]">
                                                            @string.Format(L["{0} SIMD registers of {1} bits."], processor.SimdRegisters, processor.SimdSize)
                                                        </MudTooltip>
                                                    </MudText>
                                                }
                                            </MudStack>
                                        </td>
                                    </tr>
                                }
                                @if(processor.Cores > 1)
                                {
                                    <tr>
                                        <td style="width: 33%; text-align: right;">@L["Multi-core"]</td>
                                        <td>@string.Format(L["{0} cores."], processor.Cores)</td>
                                    </tr>
                                }
                                @if(processor.ThreadsPerCore > 1)
                                {
                                    <tr>
                                        <td style="width: 33%; text-align: right;"><MudTooltip Text="@L["Simultaneous multithreading"]">SMT</MudTooltip></td>
                                        <td>@string.Format(processor.Cores > 1 ? L["{0} threads per core."] : L["{0} threads."], processor.ThreadsPerCore)</td>
                                    </tr>
                                }
                                @if(processor.DataBus > 0 || processor.AddressBus > 0)
                                {
                                    <tr>
                                        <td style="width: 33%; text-align: right;">@L["Bus"]</td>
                                        <td>
                                            <MudStack Spacing="0">
                                                @if(processor.DataBus > 0)
                                                {
                                                    <MudText Typo="Typo.body2">@string.Format(L["{0}-bit data."], processor.DataBus)</MudText>
                                                }
                                                @if(processor.AddressBus > 0)
                                                {
                                                    <MudText Typo="Typo.body2">@string.Format(L["{0}-bit address."], processor.AddressBus)</MudText>
                                                }
                                            </MudStack>
                                        </td>
                                    </tr>
                                }
                                @if(processor.L1Instruction > 0 || processor.L1Data > 0 || processor.L2 > 0 || processor.L3 > 0)
                                {
                                    <tr>
                                        <td style="width: 33%; text-align: right;">@L["Cache"]</td>
                                        <td>
                                            <MudStack Spacing="0">
                                                @if(processor.L1Instruction > 0)
                                                {
                                                    <MudText Typo="Typo.body2">@string.Format(processor.L1Data < 0 ? L["{0}KiB combined instruction-data L1"] : L["{0}KiB instruction L1"], processor.L1Instruction)</MudText>
                                                }
                                                @if(processor.L1Data > 0)
                                                {
                                                    <MudText Typo="Typo.body2">@string.Format(L["{0}KiB data L1"], processor.L1Data)</MudText>
                                                }
                                                @if(processor.L2 > 0)
                                                {
                                                    <MudText Typo="Typo.body2">@string.Format(L["{0}KiB L2"], processor.L2)</MudText>
                                                }
                                                @if(processor.L3 > 0)
                                                {
                                                    <MudText Typo="Typo.body2">@string.Format(L["{0}KiB L3"], processor.L3)</MudText>
                                                }
                                            </MudStack>
                                        </td>
                                    </tr>
                                }
                                @if(processor.Package != null)
                                {
                                    <tr>
                                        <td style="width: 33%; text-align: right;">@L["Package"]</td>
                                        <td>@processor.Package</td>
                                    </tr>
                                }
                                @if(processor.Process != null || processor.ProcessNm > 0)
                                {
                                    <tr>
                                        <td style="width: 33%; text-align: right;">@L["Manufacturing process"]</td>
                                        <td>
                                            @if(processor.Process != null && processor.ProcessNm > 0)
                                            {
                                                @(processor.ProcessNm > 100
                                                    ? string.Format(L["{0} @{1}µm"], processor.Process, processor.ProcessNm / 100)
                                                    : string.Format(L["{0} @{1}nm"], processor.Process, processor.ProcessNm))
                                            }
                                            else if(processor.ProcessNm > 0)
                                            {
                                                @(processor.ProcessNm > 100
                                                    ? string.Format(L["{0}µm"], processor.ProcessNm / 100)
                                                    : string.Format(L["{0}nm"], processor.ProcessNm))
                                            }
                                            else
                                            {
                                                @processor.Process
                                            }
                                        </td>
                                    </tr>
                                }
                                @if(processor.DieSize > 0)
                                {
                                    <tr>
                                        <td style="width: 33%; text-align: right;">@L["Die size"]</td>
                                        <td>@string.Format(L["{0} mm²"], processor.DieSize)</td>
                                    </tr>
                                }
                                @if(processor.Transistors > 0)
                                {
                                    <tr>
                                        <td style="width: 33%; text-align: right;">@L["Transistors"]</td>
                                        <td>@processor.Transistors</td>
                                    </tr>
                                }
                                </tbody>
                            </MudSimpleTable>
                        </ChildContent>
                    </MudExpansionPanel>
                }
            </MudExpansionPanels>
        </MudCardContent>
    </MudCard>
}

@* ── Memory Card ── *@
@if(_machine.Memory != null && _machine.Memory.Count > 0)
{
    <MudCard Elevation="2" Class="mb-4 rounded-lg">
        <MudCardContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                <MudIcon Icon="@Icons.Material.Filled.Storage" Color="Color.Primary"/>
                <MudText Typo="Typo.h6">@L["Memory"]</MudText>
                <MudChip T="string" Size="Size.Small" Color="Color.Secondary">@_machine.Memory.Count</MudChip>
            </MudStack>
            <MudStack Spacing="2">
                @foreach(MemoryDto memory in _machine.Memory)
                {
                    string memValue;
                    if(memory.Size > 1073741824) { memValue = string.Format(L["{0} GiB"], memory.Size / 1073741824); }
                    else if(memory.Size > 1048576) { memValue = string.Format(L["{0} MiB"], memory.Size / 1048576); }
                    else if(memory.Size > 1024) { memValue = string.Format(L["{0} KiB"], memory.Size / 1024); }
                    else if(memory.Size > 0) { memValue = string.Format(L["{0} bytes"], memory.Size); }
                    else { memValue = L["Unknown size"]; }

                    string speedValue;
                    if(memory.Speed > 1000000000) { speedValue = string.Format(L["{0} GHz"], memory.Speed / 1000000000); }
                    else if(memory.Speed > 1000000) { speedValue = string.Format(L["{0} MHz"], memory.Speed / 1000000); }
                    else if(memory.Speed > 1000) { speedValue = string.Format(L["{0} KHz"], memory.Speed / 1000); }
                    else if(memory.Speed > 0) { speedValue = string.Format(L["{0} Hz"], memory.Speed); }
                    else { speedValue = L["unknown speed"]; }

                    <MudPaper Elevation="0" Class="pa-3 rounded-lg" Style="border: 1px solid var(--mud-palette-lines-default);">
                        <MudText Typo="Typo.body1">@string.Format(L["{0} of {1} memory ({2} at {3})"], memValue, ((MemoryUsage)(memory.Usage ?? 0)).Humanize(), ((MemoryType)(memory.Type ?? 0)).Humanize(), speedValue)</MudText>
                    </MudPaper>
                }
            </MudStack>
        </MudCardContent>
    </MudCard>
}

