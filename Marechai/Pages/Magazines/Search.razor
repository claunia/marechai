@page "/magazines/all"
@page "/magazines/year/{Year:int}"
@page "/magazines/{StartingCharacter}"
@using Marechai.ApiClient.Models
@inherits OwningComponentBase<MagazinesService>
@inject IStringLocalizer<MagazinesService> L

@if(!_initialized)
{
    <div class="d-flex justify-center pa-8">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true"/>
    </div>

    return;
}

<EntityMetaTags Title="@L["Browse magazines"]"
               Description="Search and browse computing magazines by title, year or letter."
               CanonicalPath="/magazines/all"
               OgType="website"
               Breadcrumbs="@(new (string, string?)[] { (L["Magazines"], "/magazines"), (L["Browse"], null) })" />

<MudPaper Class="pa-6 mb-6" Elevation="0" Style="background: linear-gradient(135deg, #7e57c2 0%, #42a5f5 100%); border-radius: 16px;">
    <MudText Typo="Typo.h5" Style="color: white;">@L["Search results:"]</MudText>
    @if(_character.HasValue)
    {
        <MudText Typo="Typo.h6" Style="color: rgba(255,255,255,0.85);">@string.Format(L["Magazines starting with {0}"], _character)</MudText>
    }
    else if(Year.HasValue)
    {
        <MudText Typo="Typo.h6" Style="color: rgba(255,255,255,0.85);">@string.Format(L["Magazines published in {0}"], Year)</MudText>
    }
</MudPaper>

@if(_total > 0)
{
    <MudText Typo="Typo.body2" Class="mb-2">@string.Format(L["{0} magazines found in the database."], _total)</MudText>
    <div id="@_scrollerId" style="height: calc(100dvh - 220px); min-height: 360px; overflow-y: auto;">
        <MudList T="MagazineDto" Dense="true">
            <Virtualize Items="_magazines" Context="magazine" ItemSize="64">
                <MudListItem T="MagazineDto" Href="@($"/magazine/{magazine.Id}")" Icon="@Icons.Material.Filled.MenuBook">
                    <div>
                        <MudText Typo="Typo.body1">@magazine.Title</MudText>
                        @if(magazine.FirstPublication.HasValue)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@magazine.FirstPublication.Value.Year</MudText>
                        }
                    </div>
                </MudListItem>
            </Virtualize>
        </MudList>
        <div id="@_sentinelId" style="height: 1px;"></div>
        @if(_loadingMore)
        {
            <div class="d-flex justify-center pa-3">
                <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true"/>
            </div>
        }
    </div>
}
else
{
    @if(_character.HasValue)
    {
        <MudAlert Severity="Severity.Info">@L["There are no magazines found in the database that start with this letter."]</MudAlert>
    }
    else if(Year.HasValue)
    {
        <MudAlert Severity="Severity.Info">@L["There are no magazines found published this year."]</MudAlert>
    }
}
