@page "/magazine/{Id:long}"
@using Marechai.ApiClient.Models
@using Marechai.Helpers
@inherits OwningComponentBase<MagazinesService>
@inject IStringLocalizer<MagazinesService> L
@inject ApiAssetUrlProvider                AssetUrls
@inject NavigationManager                  Nav
@inject IDialogService                     DialogService
@inject SuggestionsService                 Suggestions

@if(!_loaded)
{
    <div class="d-flex justify-center pa-8">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large"/>
    </div>

    return;
}

@if(_magazine is null)
{
    <MudAlert Severity="Severity.Warning">@L["Magazine not found."]</MudAlert>

    return;
}

<EntityMetaTags Title="@_magazine.Title"
                Description="@string.Format(L["Seo description"], _magazine.Title)"
                CanonicalPath="@($"/magazine/{Id}")"
                Breadcrumbs="@(new (string, string?)[] { ("Magazines", "/magazines"), (_magazine.Title, null) })" />

@* ── Hero Header ── *@
<MudPaper Class="pa-6 mb-6" Elevation="0" Style="background: linear-gradient(135deg, #7e57c2 0%, #42a5f5 100%); border-radius: 16px;">
    <MudStack AlignItems="AlignItems.Center" Spacing="3">
        <MudIcon Icon="@Icons.Material.Filled.MenuBook" Size="Size.Large" Style="color: white;"/>
        <MudText Typo="Typo.h4" Align="Align.Center" Style="color: white; font-weight: 700;">@_magazine.Title</MudText>
    </MudStack>
</MudPaper>

@* ── General Information Card ── *@
<MudCard Elevation="2" Class="mb-4 rounded-lg">
    <MudCardContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.Info" Color="Color.Primary"/>
                <MudText Typo="Typo.h6">@L["General"]</MudText>
            </MudStack>
            <AuthorizeView>
                <Authorized>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                   Title="@L["Suggest changes"]"
                                   OnClick="OpenMagazineSuggestionDialogAsync"/>
                </Authorized>
            </AuthorizeView>
        </MudStack>
        <MudSimpleTable Elevation="0" Dense="true">
            <tbody>
            <tr>
                <td style="width: 33%; text-align: right;"><strong>@L["Title"]</strong></td>
                <td>@_magazine.Title</td>
            </tr>
            @if(!string.IsNullOrEmpty(_magazine.NativeTitle))
            {
                <tr>
                    <td style="width: 33%; text-align: right;"><strong>@L["Native title"]</strong></td>
                    <td>@_magazine.NativeTitle</td>
                </tr>
            }
            @if(!string.IsNullOrEmpty(_magazine.Issn))
            {
                <tr>
                    <td style="width: 33%; text-align: right;"><strong>@L["ISSN"]</strong></td>
                    <td>@_magazine.Issn</td>
                </tr>
            }
            @if(_magazine.FirstPublication.HasValue)
            {
                <tr>
                    <td style="width: 33%; text-align: right;"><strong>@L["First publication"]</strong></td>
                    <td>@(((_magazine.FirstPublicationPrecision ?? 0) == 2 ? _magazine.FirstPublication.Value.Year.ToString() : (_magazine.FirstPublicationPrecision ?? 0) == 1 ? _magazine.FirstPublication.Value.ToString("MMMM yyyy") : _magazine.FirstPublication.Value.DateTime.ToLongDateString()))</td>
                </tr>
            }
            @if(_magazine.Published.HasValue)
            {
                <tr>
                    <td style="width: 33%; text-align: right;"><strong>@L["Published"]</strong></td>
                    <td>@(((_magazine.PublishedPrecision ?? 0) == 2 ? _magazine.Published.Value.Year.ToString() : (_magazine.PublishedPrecision ?? 0) == 1 ? _magazine.Published.Value.ToString("MMMM yyyy") : _magazine.Published.Value.DateTime.ToLongDateString()))</td>
                </tr>
            }
            @if(!string.IsNullOrEmpty(_magazine.Country))
            {
                <tr>
                    <td style="width: 33%; text-align: right;"><strong>@L["Country"]</strong></td>
                    <td>
                        @if(_magazine.CountryId.HasValue)
                        {
                            <picture>
                                <source srcset="@(AssetUrls.BaseUrl)/assets/flags/countries/@($"{_magazine.CountryId:D3}").svg" type="image/svg+xml">
                                <source srcset="@(AssetUrls.BaseUrl)/assets/flags/countries/webp/1x/@($"{_magazine.CountryId:D3}").webp" type="image/webp">
                                <img alt="" height="32" src="@(AssetUrls.BaseUrl)/assets/flags/countries/png/1x/@($"{_magazine.CountryId:D3}").png"/>
                            </picture>
                        }
                        @L[_magazine.Country]
                    </td>
                </tr>
            }
            </tbody>
        </MudSimpleTable>
    </MudCardContent>
</MudCard>

@* ── Synopsis Card ── *@
@if(!_hasAnyDescription)
{
    <MudCard Elevation="2" Class="mb-4 rounded-lg">
        <MudCardContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Description" Color="Color.Primary"/>
                    <MudText Typo="Typo.h6">@L["Synopsis"]</MudText>
                </MudStack>
            </MudStack>
            <AuthorizeView>
                <Authorized>
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-2">
                        @L["We do not have a synopsis for this magazine, you could collaborate by suggesting one"]
                    </MudAlert>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.AddComment"
                               OnClick="OpenDescriptionPickerAsync">
                        @L["Suggest synopsis"]
                    </MudButton>
                </Authorized>
                <NotAuthorized>
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                        @L["We do not have a synopsis for this magazine, you could collaborate by suggesting one"]
                    </MudAlert>
                </NotAuthorized>
            </AuthorizeView>
        </MudCardContent>
    </MudCard>
}
else
{
    @if(_descriptionFellBack)
    {
        <AuthorizeView>
            <Authorized>
                <MudAlert Severity="Severity.Info"
                          Variant="Variant.Outlined"
                          Class="mb-3">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="3" Style="width: 100%;">
                        <MudText>
                            @L["We do not have a synopsis in your language, you could collaborate by translating the English synopsis we show below"]
                        </MudText>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Translate"
                                   OnClick="OpenDescriptionPickerAsync">
                            @L["Suggest translation"]
                        </MudButton>
                    </MudStack>
                </MudAlert>
            </Authorized>
        </AuthorizeView>
    }

    <MudCard Elevation="2" Class="mb-4 rounded-lg">
        <MudCardContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Description" Color="Color.Primary"/>
                    <MudText Typo="Typo.h6">@L["Synopsis"]</MudText>
                </MudStack>
                <AuthorizeView>
                    <Authorized>
                        <MudTooltip Text="@L["Suggest changes"]">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Size="Size.Small"
                                           Color="Color.Secondary"
                                           OnClick="OpenDescriptionPickerAsync"
                                           aria-label="@L["Suggest changes"]"/>
                        </MudTooltip>
                    </Authorized>
                </AuthorizeView>
            </MudStack>
            <div class="markdown-body">@SafeMarkdownRenderer.Render(_synopsis?.Text ?? string.Empty)</div>
        </MudCardContent>
    </MudCard>
}

@* ── Issues by Year Pills ── *@
@* Card always visible (not gated on count > 0) so the AuthorizeView "Suggest new
   issue" button is always discoverable, even on empty magazines. *@
<MudCard Elevation="2" Class="mb-4 rounded-lg">
    <MudCardContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Color="Color.Primary"/>
                <MudText Typo="Typo.h6">@L["Issues"]</MudText>
            </MudStack>
            <AuthorizeView>
                <Authorized>
                    <MudIconButton Icon="@Icons.Material.Filled.AddCircle" Size="Size.Small" Color="Color.Primary"
                                   Title="@L["Suggest new magazine issue"]"
                                   OnClick="OpenSuggestNewIssueDialog"/>
                </Authorized>
            </AuthorizeView>
        </MudStack>
        @if(_issueYears is { Count: > 0 })
        {
            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                @foreach(int? year in _issueYears)
                {
                    if(year.HasValue)
                    {
                        int y = year.Value;
                        <MudChip T="string"
                                 Color="Color.Primary"
                                 Variant="Variant.Outlined"
                                 OnClick="@(() => Nav.NavigateTo($"/magazine/{Id}/year/{y}"))">
                            @y
                        </MudChip>
                    }
                    else
                    {
                        <MudChip T="string"
                                 Color="Color.Default"
                                 Variant="Variant.Outlined"
                                 OnClick="@(() => Nav.NavigateTo($"/magazine/{Id}/year/others"))">
                            @L["Others"]
                        </MudChip>
                    }
                }
            </MudStack>
        }
        else
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">@L["No issues recorded yet."]</MudText>
        }
    </MudCardContent>
</MudCard>

@* ── Companies Card ── *@
<MudExpansionPanels Elevation="2" Class="mb-4 rounded-lg">
    <MudExpansionPanel Disabled="@(_companies.Count == 0)">
        <TitleContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.Business" Color="Color.Primary"/>
                <MudText Typo="Typo.h6">@L["Companies"]</MudText>
                <MudChip T="string" Size="Size.Small" Color="@(_companies.Count > 0 ? Color.Success : Color.Error)">@_companies.Count</MudChip>
            </MudStack>
        </TitleContent>
        <ChildContent>
            <MudList T="CompanyByMagazineDto" Dense="true">
                @foreach(CompanyByMagazineDto company in _companies)
                {
                    <MudListItem T="CompanyByMagazineDto" Href="@($"/company/{company.CompanyId}")" Icon="@Icons.Material.Filled.Business">
                        @company.Company
                        @if(!string.IsNullOrEmpty(company.Role))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="ml-2" Style="display: inline;">— @company.Role</MudText>
                        }
                    </MudListItem>
                }
            </MudList>
        </ChildContent>
    </MudExpansionPanel>
</MudExpansionPanels>
