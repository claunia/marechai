@page "/books/all"
@page "/books/year/{Year:int}"
@page "/books/{StartingCharacter}"
@using Marechai.ApiClient.Models
@inherits OwningComponentBase<BooksService>
@inject IStringLocalizer<BooksService> L
@inject ApiAssetUrlProvider            Assets

@if(_books is null)
{
    <div class="d-flex justify-center pa-8">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true"/>
    </div>

    return;
}

<MudPaper Class="pa-6 mb-6" Elevation="0" Style="background: linear-gradient(135deg, #7e57c2 0%, #42a5f5 100%); border-radius: 16px;">
    <MudText Typo="Typo.h5" Style="color: white;">@L["Search results:"]</MudText>
    @if(_character.HasValue)
    {
        <MudText Typo="Typo.h6" Style="color: rgba(255,255,255,0.85);">@string.Format(L["Books starting with {0}"], _character)</MudText>
    }
    else if(Year.HasValue)
    {
        <MudText Typo="Typo.h6" Style="color: rgba(255,255,255,0.85);">@string.Format(L["Books published in {0}"], Year)</MudText>
    }
</MudPaper>

@if(_books?.Count > 0)
{
    <MudText Typo="Typo.body2" Class="mb-2">@string.Format(L["{0} books found in the database."], _books.Count)</MudText>
    <MudList T="BookDto" Dense="true">
        @foreach(BookDto book in _books)
        {
            <MudListItem T="BookDto" Href="@($"/book/{book.Id}")" Icon="@Icons.Material.Filled.Book">
                <div class="d-flex align-center gap-3">
                    @if(book.CoverGuid.HasValue)
                    {
                        <picture>
                            <source srcset="@(Assets.BaseUrl)/assets/photos/book-covers/jxl/hd/@(book.CoverGuid).jxl, @(Assets.BaseUrl)/assets/photos/book-covers/jxl/1440p/@(book.CoverGuid).jxl 2x, @(Assets.BaseUrl)/assets/photos/book-covers/jxl/4k/@(book.CoverGuid).jxl 3x" type="image/jxl">
                            <source srcset="@(Assets.BaseUrl)/assets/photos/book-covers/avif/hd/@(book.CoverGuid).avif, @(Assets.BaseUrl)/assets/photos/book-covers/avif/1440p/@(book.CoverGuid).avif 2x, @(Assets.BaseUrl)/assets/photos/book-covers/avif/4k/@(book.CoverGuid).avif 3x" type="image/avif">
                            <source srcset="@(Assets.BaseUrl)/assets/photos/book-covers/heif/hd/@(book.CoverGuid).heic, @(Assets.BaseUrl)/assets/photos/book-covers/heif/1440p/@(book.CoverGuid).heic 2x, @(Assets.BaseUrl)/assets/photos/book-covers/heif/4k/@(book.CoverGuid).heic 3x" type="image/heic">
                            <source srcset="@(Assets.BaseUrl)/assets/photos/book-covers/webp/hd/@(book.CoverGuid).webp, @(Assets.BaseUrl)/assets/photos/book-covers/webp/1440p/@(book.CoverGuid).webp 2x, @(Assets.BaseUrl)/assets/photos/book-covers/webp/4k/@(book.CoverGuid).webp 3x" type="image/webp">
                            <source srcset="@(Assets.BaseUrl)/assets/photos/book-covers/jp2k/hd/@(book.CoverGuid).jp2, @(Assets.BaseUrl)/assets/photos/book-covers/jp2k/1440p/@(book.CoverGuid).jp2 2x, @(Assets.BaseUrl)/assets/photos/book-covers/jp2k/4k/@(book.CoverGuid).jp2 3x" type="image/jp2">
                            <img alt="@book.Title" height="48"
                                 src="@(Assets.BaseUrl)/assets/photos/book-covers/jpeg/hd/@(book.CoverGuid).jpg"
                                 srcset="@(Assets.BaseUrl)/assets/photos/book-covers/jpeg/hd/@(book.CoverGuid).jpg, @(Assets.BaseUrl)/assets/photos/book-covers/jpeg/1440p/@(book.CoverGuid).jpg 2x, @(Assets.BaseUrl)/assets/photos/book-covers/jpeg/4k/@(book.CoverGuid).jpg 3x"
                                 style="object-fit: contain; border-radius: 4px;"/>
                        </picture>
                    }
                    <div>
                        <MudText Typo="Typo.body1">@book.Title</MudText>
                        @if(book.Published.HasValue)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@book.Published.Value.Year</MudText>
                        }
                    </div>
                </div>
            </MudListItem>
        }
    </MudList>
}
else
{
    @if(_character.HasValue)
    {
        <MudAlert Severity="Severity.Info">@L["There are no books found in the database that start with this letter."]</MudAlert>
    }
    else if(Year.HasValue)
    {
        <MudAlert Severity="Severity.Info">@L["There are no books found published this year."]</MudAlert>
    }
}
