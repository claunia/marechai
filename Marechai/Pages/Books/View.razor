@page "/book/{Id:long}"
@using Marechai.ApiClient.Models
@using Marechai.Helpers
@inherits OwningComponentBase<BooksService>
@inject IStringLocalizer<BooksService> L
@inject ApiAssetUrlProvider            AssetUrls
@inject CollectionService              CollectionSvc

@if(!_loaded)
{
    <div class="d-flex justify-center pa-8">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large"/>
    </div>

    return;
}

@if(_book is null)
{
    <MudAlert Severity="Severity.Warning">@L["Book not found."]</MudAlert>

    return;
}

@* ── Hero Header ── *@
<MudPaper Class="pa-6 mb-6" Elevation="0" Style="background: linear-gradient(135deg, #7e57c2 0%, #42a5f5 100%); border-radius: 16px;">
    <MudStack AlignItems="AlignItems.Center" Spacing="3">
        @if(_book.CoverGuid.HasValue)
        {
            <picture>
                <source srcset="@(AssetUrls.BaseUrl)/assets/photos/book-covers/jxl/hd/@(_book.CoverGuid).jxl, @(AssetUrls.BaseUrl)/assets/photos/book-covers/jxl/1440p/@(_book.CoverGuid).jxl 2x, @(AssetUrls.BaseUrl)/assets/photos/book-covers/jxl/4k/@(_book.CoverGuid).jxl 3x" type="image/jxl">
                <source srcset="@(AssetUrls.BaseUrl)/assets/photos/book-covers/avif/hd/@(_book.CoverGuid).avif, @(AssetUrls.BaseUrl)/assets/photos/book-covers/avif/1440p/@(_book.CoverGuid).avif 2x, @(AssetUrls.BaseUrl)/assets/photos/book-covers/avif/4k/@(_book.CoverGuid).avif 3x" type="image/avif">
                <source srcset="@(AssetUrls.BaseUrl)/assets/photos/book-covers/heif/hd/@(_book.CoverGuid).heic, @(AssetUrls.BaseUrl)/assets/photos/book-covers/heif/1440p/@(_book.CoverGuid).heic 2x, @(AssetUrls.BaseUrl)/assets/photos/book-covers/heif/4k/@(_book.CoverGuid).heic 3x" type="image/heic">
                <source srcset="@(AssetUrls.BaseUrl)/assets/photos/book-covers/webp/hd/@(_book.CoverGuid).webp, @(AssetUrls.BaseUrl)/assets/photos/book-covers/webp/1440p/@(_book.CoverGuid).webp 2x, @(AssetUrls.BaseUrl)/assets/photos/book-covers/webp/4k/@(_book.CoverGuid).webp 3x" type="image/webp">
                <img alt="@_book.Title" height="200"
                     src="@(AssetUrls.BaseUrl)/assets/photos/book-covers/jpeg/hd/@(_book.CoverGuid).jpg"
                     srcset="@(AssetUrls.BaseUrl)/assets/photos/book-covers/jpeg/hd/@(_book.CoverGuid).jpg, @(AssetUrls.BaseUrl)/assets/photos/book-covers/jpeg/1440p/@(_book.CoverGuid).jpg 2x, @(AssetUrls.BaseUrl)/assets/photos/book-covers/jpeg/4k/@(_book.CoverGuid).jpg 3x"
                     style="object-fit: contain; border-radius: 4px; filter: drop-shadow(0 4px 8px rgba(0,0,0,0.3));" />
            </picture>
        }
        else
        {
            <MudIcon Icon="@Icons.Material.Filled.Book" Size="Size.Large" Style="color: white;"/>
        }
        <MudText Typo="Typo.h4" Align="Align.Center" Style="color: white; font-weight: 700;">@_book.Title</MudText>
        <AuthorizeView>
            <Authorized>
                <MudButton Variant="Variant.Filled"
                           Color="@(_isCollected ? Color.Success : Color.Default)"
                           StartIcon="@(_isCollected ? Icons.Material.Filled.Bookmark : Icons.Material.Outlined.BookmarkBorder)"
                           OnClick="ToggleCollectionAsync"
                           Disabled="_togglingCollection"
                           Size="Size.Small">
                    @(_isCollected ? L["In Collection"] : L["Add to Collection"])
                </MudButton>
            </Authorized>
        </AuthorizeView>
    </MudStack>
</MudPaper>

@* ── General Information Card ── *@
<MudCard Elevation="2" Class="mb-4 rounded-lg">
    <MudCardContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
            <MudIcon Icon="@Icons.Material.Filled.Info" Color="Color.Primary"/>
            <MudText Typo="Typo.h6">@L["General"]</MudText>
        </MudStack>
        <MudSimpleTable Elevation="0" Dense="true">
            <tbody>
            <tr>
                <td style="width: 33%; text-align: right;"><strong>@L["Title"]</strong></td>
                <td>@_book.Title</td>
            </tr>
            @if(!string.IsNullOrEmpty(_book.NativeTitle))
            {
                <tr>
                    <td style="width: 33%; text-align: right;"><strong>@L["Native title"]</strong></td>
                    <td>@_book.NativeTitle</td>
                </tr>
            }
            @if(!string.IsNullOrEmpty(_book.Isbn))
            {
                <tr>
                    <td style="width: 33%; text-align: right;"><strong>@L["ISBN"]</strong></td>
                    <td>@_book.Isbn</td>
                </tr>
            }
            @if(_book.Pages.HasValue)
            {
                <tr>
                    <td style="width: 33%; text-align: right;"><strong>@L["Pages"]</strong></td>
                    <td>@_book.Pages</td>
                </tr>
            }
            @if(_book.Edition.HasValue)
            {
                <tr>
                    <td style="width: 33%; text-align: right;"><strong>@L["Edition"]</strong></td>
                    <td>@_book.Edition</td>
                </tr>
            }
            @if(_book.Published.HasValue)
            {
                <tr>
                    <td style="width: 33%; text-align: right;"><strong>@L["Published"]</strong></td>
                    <td>@(((_book.PublishedPrecision ?? 0) == 2 ? _book.Published.Value.Year.ToString() : (_book.PublishedPrecision ?? 0) == 1 ? _book.Published.Value.ToString("MMMM yyyy") : _book.Published.Value.DateTime.ToLongDateString()))</td>
                </tr>
            }
            @if(!string.IsNullOrEmpty(_book.Country))
            {
                <tr>
                    <td style="width: 33%; text-align: right;"><strong>@L["Country"]</strong></td>
                    <td>
                        @if(_book.CountryId.HasValue)
                        {
                            <picture>
                                <source srcset="@(AssetUrls.BaseUrl)/assets/flags/countries/@($"{_book.CountryId:D3}").svg" type="image/svg+xml">
                                <source srcset="@(AssetUrls.BaseUrl)/assets/flags/countries/webp/1x/@($"{_book.CountryId:D3}").webp" type="image/webp">
                                <img alt="" height="32" src="@(AssetUrls.BaseUrl)/assets/flags/countries/png/1x/@($"{_book.CountryId:D3}").png"/>
                            </picture>
                        }
                        @L[_book.Country]
                    </td>
                </tr>
            }
            @if(!string.IsNullOrEmpty(_book.InternetArchiveUrl))
            {
                <tr>
                    <td style="width: 33%; text-align: right;"><strong>@L["Internet Archive link"]</strong></td>
                    <td>
                        <MudLink Href="@_book.InternetArchiveUrl" Target="_blank" Underline="Underline.Always">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudIcon Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small"/>
                                <span>@L["View on Internet Archive"]</span>
                            </MudStack>
                        </MudLink>
                    </td>
                </tr>
            }
            </tbody>
        </MudSimpleTable>
    </MudCardContent>
</MudCard>

@* ── Cover Card ── *@
@if(_book.CoverGuid.HasValue)
{
    <MudCard Elevation="2" Class="mb-4 rounded-lg">
        <MudCardContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                <MudIcon Icon="@Icons.Material.Filled.Image" Color="Color.Primary"/>
                <MudText Typo="Typo.h6">@L["Cover"]</MudText>
            </MudStack>
            <div class="d-flex justify-center" style="cursor: pointer;" @onclick="() => _lightbox.Show(new List<Guid> { _book.CoverGuid.Value }, _book.CoverGuid.Value)">
                <picture>
                    <source srcset="@(AssetUrls.BaseUrl)/assets/photos/book-covers/jxl/4k/@(_book.CoverGuid).jxl" type="image/jxl">
                    <source srcset="@(AssetUrls.BaseUrl)/assets/photos/book-covers/avif/4k/@(_book.CoverGuid).avif" type="image/avif">
                    <source srcset="@(AssetUrls.BaseUrl)/assets/photos/book-covers/heif/4k/@(_book.CoverGuid).heic" type="image/heic">
                    <source srcset="@(AssetUrls.BaseUrl)/assets/photos/book-covers/webp/4k/@(_book.CoverGuid).webp" type="image/webp">
                    <img alt="@_book.Title" src="@(AssetUrls.BaseUrl)/assets/photos/book-covers/jpeg/4k/@(_book.CoverGuid).jpg"
                         style="max-height: 600px; max-width: 100%; object-fit: contain; border-radius: 4px;"/>
                </picture>
            </div>
        </MudCardContent>
    </MudCard>
}

@* ── Synopsis Card ── *@
@if(!string.IsNullOrWhiteSpace(_synopsis?.Text))
{
    <MudCard Elevation="2" Class="mb-4 rounded-lg">
        <MudCardContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                <MudIcon Icon="@Icons.Material.Filled.Description" Color="Color.Primary"/>
                <MudText Typo="Typo.h6">@L["Synopsis"]</MudText>
            </MudStack>
            <div class="markdown-body">@SafeMarkdownRenderer.Render(_synopsis.Text)</div>
        </MudCardContent>
    </MudCard>
}

@* ── People Card ── *@
@if(_people.Count > 0)
{
<MudExpansionPanels Elevation="2" Class="mb-4 rounded-lg">
    <MudExpansionPanel>
        <TitleContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.People" Color="Color.Primary"/>
                <MudText Typo="Typo.h6">@L["People"]</MudText>
                <MudChip T="string" Size="Size.Small" Color="@(_people.Count > 0 ? Color.Success : Color.Error)">@_people.Count</MudChip>
            </MudStack>
        </TitleContent>
        <ChildContent>
            <MudList T="PersonByBookDto" Dense="true">
                @foreach(PersonByBookDto person in _people)
                {
                    <MudListItem T="PersonByBookDto" Href="@($"/person/{person.PersonId}")" Icon="@Icons.Material.Filled.Person">
                        @(person.DisplayName ?? person.Alias ?? $"{person.Name} {person.Surname}".Trim())
                        @if(!string.IsNullOrEmpty(person.Role))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="ml-2" Style="display: inline;">— @person.Role</MudText>
                        }
                    </MudListItem>
                }
            </MudList>
        </ChildContent>
    </MudExpansionPanel>
</MudExpansionPanels>
}

@* ── Companies Card ── *@
@if(_companies.Count > 0)
{
<MudExpansionPanels Elevation="2" Class="mb-4 rounded-lg">
    <MudExpansionPanel>
        <TitleContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.Business" Color="Color.Primary"/>
                <MudText Typo="Typo.h6">@L["Companies"]</MudText>
                <MudChip T="string" Size="Size.Small" Color="@(_companies.Count > 0 ? Color.Success : Color.Error)">@_companies.Count</MudChip>
            </MudStack>
        </TitleContent>
        <ChildContent>
            <MudList T="CompanyByBookDto" Dense="true">
                @foreach(CompanyByBookDto company in _companies)
                {
                    <MudListItem T="CompanyByBookDto" Href="@($"/company/{company.CompanyId}")" Icon="@Icons.Material.Filled.Business">
                        @company.Company
                        @if(!string.IsNullOrEmpty(company.Role))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="ml-2" Style="display: inline;">— @company.Role</MudText>
                        }
                    </MudListItem>
                }
            </MudList>
        </ChildContent>
    </MudExpansionPanel>
</MudExpansionPanels>
}

@* ── Machines Card ── *@
@if(_machines.Count > 0)
{
<MudExpansionPanels Elevation="2" Class="mb-4 rounded-lg">
    <MudExpansionPanel>
        <TitleContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.Computer" Color="Color.Primary"/>
                <MudText Typo="Typo.h6">@L["Machines"]</MudText>
                <MudChip T="string" Size="Size.Small" Color="@(_machines.Count > 0 ? Color.Success : Color.Error)">@_machines.Count</MudChip>
            </MudStack>
        </TitleContent>
        <ChildContent>
            <MudList T="BookByMachineDto" Dense="true">
                @foreach(BookByMachineDto machine in _machines)
                {
                    <MudListItem T="BookByMachineDto" Href="@($"/machine/{machine.MachineId}")" Icon="@Icons.Material.Filled.Computer">
                        @machine.Machine
                    </MudListItem>
                }
            </MudList>
        </ChildContent>
    </MudExpansionPanel>
</MudExpansionPanels>
}

@* ── Machine Families Card ── *@
@if(_machineFamilies.Count > 0)
{
<MudExpansionPanels Elevation="2" Class="mb-4 rounded-lg">
    <MudExpansionPanel>
        <TitleContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.DevicesOther" Color="Color.Primary"/>
                <MudText Typo="Typo.h6">@L["Machine families"]</MudText>
                <MudChip T="string" Size="Size.Small" Color="@(_machineFamilies.Count > 0 ? Color.Success : Color.Error)">@_machineFamilies.Count</MudChip>
            </MudStack>
        </TitleContent>
        <ChildContent>
            <MudList T="BookByMachineFamilyDto" Dense="true">
                @foreach(BookByMachineFamilyDto family in _machineFamilies)
                {
                    <MudListItem T="BookByMachineFamilyDto" Icon="@Icons.Material.Filled.DevicesOther">
                        @family.MachineFamily
                    </MudListItem>
                }
            </MudList>
        </ChildContent>
    </MudExpansionPanel>
</MudExpansionPanels>
}

@* ── Previous Edition / Source Book ── *@
@if(_previousBook != null)
{
    <MudCard Elevation="2" Class="mb-4 rounded-lg">
        <MudCardContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Color="Color.Primary"/>
                <MudText Typo="Typo.h6">@L["Previous edition"]</MudText>
            </MudStack>
            <MudButton Href="@($"/book/{_previousBook.Id}")" Variant="Variant.Outlined" Color="Color.Primary" Class="mt-2"
                       StartIcon="@Icons.Material.Filled.Book">
                @_previousBook.Title
            </MudButton>
        </MudCardContent>
    </MudCard>
}

@if(_sourceBook != null)
{
    <MudCard Elevation="2" Class="mb-4 rounded-lg">
        <MudCardContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.Source" Color="Color.Primary"/>
                <MudText Typo="Typo.h6">@L["Source book"]</MudText>
            </MudStack>
            <MudButton Href="@($"/book/{_sourceBook.Id}")" Variant="Variant.Outlined" Color="Color.Primary" Class="mt-2"
                       StartIcon="@Icons.Material.Filled.Book">
                @_sourceBook.Title
            </MudButton>
        </MudCardContent>
    </MudCard>
}

<PhotoLightbox @ref="_lightbox" BaseUrl="@AssetUrls.BaseUrl" Category="book-covers"/>
