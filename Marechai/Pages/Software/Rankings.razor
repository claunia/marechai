@page "/software/rankings"
@using Marechai.ApiClient.Models
@inherits OwningComponentBase<SoftwareService>
@inject IStringLocalizer<SoftwareService> L
@inject NavigationManager                 Navigation

<EntityMetaTags Title="@L["Rankings"]"
               Description="Software rankings by Marechai score: overall, gameplay, genre, platform and more."
               CanonicalPath="/software/rankings"
               OgType="website"
               Breadcrumbs="@(new (string, string?)[] { (L["Software"], "/software"), (L["Rankings"], null) })" />

<MudPaper Class="pa-6 mb-4" Elevation="0"
          Style="background: linear-gradient(135deg, #ff8a65 0%, #ffb74d 100%); border-radius: 16px;">
    <div class="d-flex justify-space-between align-center gap-4 flex-wrap">
        <div class="d-flex align-center gap-3">
            <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Size="Size.Large" Style="color: white;"/>
            <div>
                <MudText Typo="Typo.h5" Style="color: white;">@L["Rankings"]</MudText>
                <MudText Typo="Typo.body2" Style="color: rgba(255,255,255,0.85);">@L["Ranked by Marechai score"]</MudText>
            </div>
        </div>
    </div>
</MudPaper>

@if(_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4"/>
}
else if(_status is { IsComputing: true } && (_overall.Count + _gameplay.Count + _genres.Count + _settings.Count + _categories.Count + _platforms.Count) == 0)
{
    <MudAlert Severity="Severity.Info" Class="mt-4">
        @L["Rankings are being computed for the first time, please check back in a few minutes."]
    </MudAlert>
}
else if((_overall.Count + _gameplay.Count + _genres.Count + _settings.Count + _categories.Count + _platforms.Count) == 0)
{
    <MudAlert Severity="Severity.Info" Class="mt-4">
        @L["No rankings available yet."]
    </MudAlert>
}
else
{
    @if(_status?.LastComputedAt is { } lastUtc)
    {
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2 d-block">
            @string.Format(L["Last computed: {0}"], lastUtc.ToLocalTime().ToString("g"))
        </MudText>
    }

    @* ── Overall top-250 promoted to a direct card link (always a single entry). ── *@
    @if(_overall.Count > 0)
    {
        RankingIndexEntryDto overall = _overall[0];
        <MudPaper Class="pa-4 mb-4 d-flex align-center gap-3" Elevation="2"
                  Style="cursor: pointer; transition: box-shadow .15s ease-in-out;"
                  @onclick="@(() => Navigation.NavigateTo($"/software/rankings/{overall.Id}"))">
            <MudIcon Icon="@Icons.Material.Filled.Star" Color="Color.Warning" Size="Size.Large"/>
            <div style="flex: 1; min-width: 0;">
                <MudText Typo="Typo.h6">@L["Top 250 software of all time"]</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @string.Format(L["{0} entries"], overall.EntryCount)
                </MudText>
            </div>
            <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Color="Color.Default"/>
        </MudPaper>
    }

    <MudExpansionPanels MultiExpansion="true" Elevation="1" Class="mb-4">
        @if(_gameplay.Count > 0)
        {
            <MudExpansionPanel>
                <TitleContent>
                    <div class="d-flex align-center gap-2">
                        <MudIcon Icon="@Icons.Material.Filled.SportsEsports" Size="Size.Small"/>
                        <MudText>@L["By gameplay"]</MudText>
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled" Class="ml-2">
                            @_gameplay.Count
                        </MudChip>
                    </div>
                </TitleContent>
                <ChildContent>
                    <MudList T="RankingIndexEntryDto" Dense="true">
                        @foreach(RankingIndexEntryDto r in _gameplay)
                        {
                            <MudListItem T="RankingIndexEntryDto" Href="@($"/software/rankings/{r.Id}")">
                                <div class="d-flex align-center justify-space-between gap-2" style="width: 100%;">
                                    <MudText>@r.DimensionName</MudText>
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                                        @string.Format(L["{0} entries"], r.EntryCount)
                                    </MudChip>
                                </div>
                            </MudListItem>
                        }
                    </MudList>
                </ChildContent>
            </MudExpansionPanel>
        }
        @if(_genres.Count > 0)
        {
            <MudExpansionPanel>
                <TitleContent>
                    <div class="d-flex align-center gap-2">
                        <MudIcon Icon="@Icons.Material.Filled.Category" Size="Size.Small"/>
                        <MudText>@L["By genre"]</MudText>
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled" Class="ml-2">
                            @_genres.Count
                        </MudChip>
                    </div>
                </TitleContent>
                <ChildContent>
                    <MudList T="RankingIndexEntryDto" Dense="true">
                        @foreach(RankingIndexEntryDto r in _genres)
                        {
                            <MudListItem T="RankingIndexEntryDto" Href="@($"/software/rankings/{r.Id}")">
                                <div class="d-flex align-center justify-space-between gap-2" style="width: 100%;">
                                    <MudText>@r.DimensionName</MudText>
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                                        @string.Format(L["{0} entries"], r.EntryCount)
                                    </MudChip>
                                </div>
                            </MudListItem>
                        }
                    </MudList>
                </ChildContent>
            </MudExpansionPanel>
        }
        @if(_settings.Count > 0)
        {
            <MudExpansionPanel>
                <TitleContent>
                    <div class="d-flex align-center gap-2">
                        <MudIcon Icon="@Icons.Material.Filled.Landscape" Size="Size.Small"/>
                        <MudText>@L["By setting"]</MudText>
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled" Class="ml-2">
                            @_settings.Count
                        </MudChip>
                    </div>
                </TitleContent>
                <ChildContent>
                    <MudList T="RankingIndexEntryDto" Dense="true">
                        @foreach(RankingIndexEntryDto r in _settings)
                        {
                            <MudListItem T="RankingIndexEntryDto" Href="@($"/software/rankings/{r.Id}")">
                                <div class="d-flex align-center justify-space-between gap-2" style="width: 100%;">
                                    <MudText>@r.DimensionName</MudText>
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                                        @string.Format(L["{0} entries"], r.EntryCount)
                                    </MudChip>
                                </div>
                            </MudListItem>
                        }
                    </MudList>
                </ChildContent>
            </MudExpansionPanel>
        }
        @if(_categories.Count > 0)
        {
            <MudExpansionPanel>
                <TitleContent>
                    <div class="d-flex align-center gap-2">
                        <MudIcon Icon="@Icons.Material.Filled.Label" Size="Size.Small"/>
                        <MudText>@L["By category"]</MudText>
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled" Class="ml-2">
                            @_categories.Count
                        </MudChip>
                    </div>
                </TitleContent>
                <ChildContent>
                    <MudList T="RankingIndexEntryDto" Dense="true">
                        @foreach(RankingIndexEntryDto r in _categories)
                        {
                            <MudListItem T="RankingIndexEntryDto" Href="@($"/software/rankings/{r.Id}")">
                                <div class="d-flex align-center justify-space-between gap-2" style="width: 100%;">
                                    <MudText>@r.DimensionName</MudText>
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                                        @string.Format(L["{0} entries"], r.EntryCount)
                                    </MudChip>
                                </div>
                            </MudListItem>
                        }
                    </MudList>
                </ChildContent>
            </MudExpansionPanel>
        }
        @if(_platforms.Count > 0)
        {
            <MudExpansionPanel>
                <TitleContent>
                    <div class="d-flex align-center gap-2">
                        <MudIcon Icon="@Icons.Material.Filled.Devices" Size="Size.Small"/>
                        <MudText>@L["By platform"]</MudText>
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled" Class="ml-2">
                            @_platforms.Count
                        </MudChip>
                    </div>
                </TitleContent>
                <ChildContent>
                    <MudList T="RankingIndexEntryDto" Dense="true">
                        @foreach(RankingIndexEntryDto r in _platforms)
                        {
                            <MudListItem T="RankingIndexEntryDto" Href="@($"/software/rankings/{r.Id}")">
                                <div class="d-flex align-center justify-space-between gap-2" style="width: 100%;">
                                    <MudText>@r.DimensionName</MudText>
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                                        @string.Format(L["{0} entries"], r.EntryCount)
                                    </MudChip>
                                </div>
                            </MudListItem>
                        }
                    </MudList>
                </ChildContent>
            </MudExpansionPanel>
        }
    </MudExpansionPanels>
}
