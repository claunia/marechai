@page "/software/{Id:int}"
@using Marechai.ApiClient.Models
@using Marechai.Data
@inherits OwningComponentBase<SoftwareService>
@inject SoftwareService                   AuthService
@inject IStringLocalizer<SoftwareService>  L
@inject IStringLocalizer<CountriesService> CountryL
@inject ApiAssetUrlProvider               AssetUrls
@inject AuthenticationStateProvider       AuthStateProvider
@inject IDialogService                    DialogService
@inject ISnackbar                         Snackbar

@if(!_loaded)
{
    <div class="d-flex justify-center pa-8">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large"/>
    </div>

    return;
}

@if(_software is null)
{
    <MudAlert Severity="Severity.Warning">@L["Software not found."]</MudAlert>

    return;
}

@* ── Hero Header ── *@
<MudPaper Class="pa-6 mb-6" Elevation="0" Style="background: linear-gradient(135deg, #7e57c2 0%, #42a5f5 100%); border-radius: 16px;">
    <MudStack AlignItems="AlignItems.Center" Spacing="3">
        @if(_heroCover is not null)
        {
            <picture>
                <source srcset="@(AssetUrls.BaseUrl)/assets/photos/software-covers/jxl/hd/@(_heroCover.Id).jxl, @(AssetUrls.BaseUrl)/assets/photos/software-covers/jxl/1440p/@(_heroCover.Id).jxl 2x, @(AssetUrls.BaseUrl)/assets/photos/software-covers/jxl/4k/@(_heroCover.Id).jxl 3x" type="image/jxl">
                <source srcset="@(AssetUrls.BaseUrl)/assets/photos/software-covers/avif/hd/@(_heroCover.Id).avif, @(AssetUrls.BaseUrl)/assets/photos/software-covers/avif/1440p/@(_heroCover.Id).avif 2x, @(AssetUrls.BaseUrl)/assets/photos/software-covers/avif/4k/@(_heroCover.Id).avif 3x" type="image/avif">
                <source srcset="@(AssetUrls.BaseUrl)/assets/photos/software-covers/heif/hd/@(_heroCover.Id).heic, @(AssetUrls.BaseUrl)/assets/photos/software-covers/heif/1440p/@(_heroCover.Id).heic 2x, @(AssetUrls.BaseUrl)/assets/photos/software-covers/heif/4k/@(_heroCover.Id).heic 3x" type="image/heic">
                <source srcset="@(AssetUrls.BaseUrl)/assets/photos/software-covers/webp/hd/@(_heroCover.Id).webp, @(AssetUrls.BaseUrl)/assets/photos/software-covers/webp/1440p/@(_heroCover.Id).webp 2x, @(AssetUrls.BaseUrl)/assets/photos/software-covers/webp/4k/@(_heroCover.Id).webp 3x" type="image/webp">
                <img alt="@_software.Name"
                     src="@(AssetUrls.BaseUrl)/assets/photos/software-covers/jpeg/hd/@(_heroCover.Id).jpg"
                     srcset="@(AssetUrls.BaseUrl)/assets/photos/software-covers/jpeg/hd/@(_heroCover.Id).jpg, @(AssetUrls.BaseUrl)/assets/photos/software-covers/jpeg/1440p/@(_heroCover.Id).jpg 2x, @(AssetUrls.BaseUrl)/assets/photos/software-covers/jpeg/4k/@(_heroCover.Id).jpg 3x"
                     style="max-height: 256px; object-fit: contain; border-radius: 8px; box-shadow: 0 4px 16px rgba(0,0,0,0.3);"/>
            </picture>
        }
        else
        {
            <MudIcon Icon="@Icons.Material.Filled.Apps" Size="Size.Large" Style="color: white;"/>
        }
        <MudText Typo="Typo.h4" Align="Align.Center" Style="color: white; font-weight: 700;">@_software.Name</MudText>
        <div class="d-flex gap-2">
            @switch((Marechai.Data.SoftwareKind)(_software.Kind ?? 0))
            {
                case Marechai.Data.SoftwareKind.OperatingSystem:
                    <MudChip T="string" Color="Color.Info" Variant="Variant.Filled" Size="Size.Small">@L["Operating System"]</MudChip>
                    break;
                case Marechai.Data.SoftwareKind.Game:
                    <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Size="Size.Small">@L["Game"]</MudChip>
                    break;
                case Marechai.Data.SoftwareKind.Dlc:
                    <MudChip T="string" Color="Color.Warning" Variant="Variant.Filled" Size="Size.Small">@L["DLC / Addon"]</MudChip>
                    break;
                case Marechai.Data.SoftwareKind.SystemSoftware:
                    <MudChip T="string" Variant="Variant.Filled" Size="Size.Small" Style="background-color: #455A64; color: white;">@L["System software"]</MudChip>
                    break;
                case Marechai.Data.SoftwareKind.Application:
                    <MudChip T="string" Variant="Variant.Filled" Size="Size.Small" Style="background-color: #1976D2; color: white;">@L["Application"]</MudChip>
                    break;
                case Marechai.Data.SoftwareKind.DevelopmentSoftware:
                    <MudChip T="string" Variant="Variant.Filled" Size="Size.Small" Style="background-color: #3F51B5; color: white;">@L["Development software"]</MudChip>
                    break;
                case Marechai.Data.SoftwareKind.ServerSoftware:
                    <MudChip T="string" Variant="Variant.Filled" Size="Size.Small" Style="background-color: #795548; color: white;">@L["Server software"]</MudChip>
                    break;
                case Marechai.Data.SoftwareKind.Middleware:
                    <MudChip T="string" Variant="Variant.Filled" Size="Size.Small" Style="background-color: #00BCD4; color: white;">@L["Middleware"]</MudChip>
                    break;
                case Marechai.Data.SoftwareKind.Firmware:
                    <MudChip T="string" Variant="Variant.Filled" Size="Size.Small" Style="background-color: #CDDC39; color: black;">@L["Firmware"]</MudChip>
                    break;
                case Marechai.Data.SoftwareKind.EmbeddedSoftware:
                    <MudChip T="string" Variant="Variant.Filled" Size="Size.Small" Style="background-color: #009688; color: white;">@L["Embedded software"]</MudChip>
                    break;
                default:
                    <MudChip T="string" Color="Color.Default" Variant="Variant.Filled" Size="Size.Small">@L["Software"]</MudChip>
                    break;
            }
        </div>

        @* ── Marechai Score ── *@
        @if(_marechaiScore?.MarechaiScore is not null)
        {
            var score = _marechaiScore.MarechaiScore.Value;
            var scoreColor = score >= 7.5 ? "#4caf50" : score >= 5.0 ? "#ff9800" : "#f44336";
            <div style="display: flex; flex-direction: column; align-items: center; margin-top: 8px;">
                <div style="width: 72px; height: 72px; border-radius: 50%; background: @scoreColor;
                            display: flex; align-items: center; justify-content: center;
                            box-shadow: 0 2px 12px rgba(0,0,0,0.3); border: 3px solid rgba(255,255,255,0.3);">
                    <span style="color: white; font-size: 1.5rem; font-weight: 800;">@($"{score:F1}")</span>
                </div>
                <MudText Typo="Typo.caption" Style="color: rgba(255,255,255,0.9); margin-top: 4px;">@L["Marechai Score"]</MudText>
                @if(_marechaiScore.Rank is not null)
                {
                    <MudText Typo="Typo.caption" Style="color: rgba(255,255,255,0.7);">
                        @L["Ranked #{0} of {1}", _marechaiScore.Rank, _marechaiScore.TotalRanked]
                    </MudText>
                }
            </div>
        }

        @* ── Aggregate User Rating ── *@
        @if(_userReviewSummary?.AverageRating is not null)
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Style="margin-top: 8px;">
                <HalfStarRating ReadOnly="true" Value="@((float)_userReviewSummary.AverageRating.Value)" Size="Size.Small"/>
                <MudText Typo="Typo.body2" Style="color: rgba(255,255,255,0.9);">
                    @($"{_userReviewSummary.AverageRating.Value:F1}") (@_userReviewSummary.TotalRatings @L["ratings"])
                </MudText>
            </MudStack>
        }

        @* ── Your Rating ── *@
        @if(_isAuthenticated)
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Style="margin-top: 4px;">
                <MudText Typo="Typo.caption" Style="color: rgba(255,255,255,0.8);">@L["Your Rating"]:</MudText>
                <HalfStarRating Value="@_myRatingFloat" ValueChanged="OnMyRatingChanged" Size="Size.Small"/>
            </MudStack>
        }
    </MudStack>
</MudPaper>

@* ── Tabbed content (sticky frosted-glass tab bar; icon+label desktop, icon-only mobile) ── *@
<style>
    /* Rounded="true" sets overflow:hidden on .mud-tabs which breaks position:sticky on the tabbar.
       Force overflow:visible so the tabbar can stick to the page viewport. */
    .sticky-tabs.mud-tabs,
    .sticky-tabs .mud-tabs-panels {
        overflow: visible !important;
    }

    .sticky-tabs .mud-tabs-tabbar {
        position: sticky;
        /* MudAppBar (mt-16 = 64px) is fixed at top:0; offset the tabbar so it docks just below. */
        top: 64px;
        z-index: 5;
        /* Frosted-glass: white tint over a strong backdrop blur. Layered so it reads as
           "icy translucent" in both light and dark themes. */
        background-color: color-mix(in srgb, white 35%, var(--mud-palette-surface) 65%) !important;
        background-image: linear-gradient(rgba(255, 255, 255, 0.18), rgba(255, 255, 255, 0.06));
        backdrop-filter: blur(20px) saturate(180%) brightness(110%);
        -webkit-backdrop-filter: blur(20px) saturate(180%) brightness(110%);
        border-radius: 12px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.18);
        /* Visual breathing room between tab bar and content below. */
        margin-bottom: 20px;
    }

    /* MudTabPanel renders text directly next to the icon component, with no .mud-typography wrapper.
       Use font-size:0 to collapse the bare text node on mobile, then null the icon-text margin so
       the icon stays centered. SVG icons are unaffected by font-size. */
    @@media (max-width: 599.98px) {
        .sticky-tabs .mud-tab {
            font-size: 0 !important;
            min-width: 56px !important;
            padding: 6px 10px !important;
        }
        .sticky-tabs .mud-tab .mud-tab-icon-text {
            margin-right: 0 !important;
            margin-inline-end: 0 !important;
        }
    }
</style>

<MudTabs Rounded="true"
         ApplyEffectsToContainer="true"
         KeepPanelsAlive="true"
         Centered="true"
         Color="Color.Primary"
         SliderColor="Color.Primary"
         Class="sticky-tabs mb-4"
         ActivePanelIndex="@_activeTabIndex"
         ActivePanelIndexChanged="OnTabChanged">

@* ── OVERVIEW TAB ── *@
<MudTabPanel Text="@L["Overview"]" Icon="@Icons.Material.Filled.Info" ToolTip="@L["Overview"]">

@* ── Description Card ── *@
@if(!string.IsNullOrWhiteSpace(_description))
{
    <MudCard Elevation="2" Class="mb-4 rounded-lg">
        <MudCardContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                <MudIcon Icon="@Icons.Material.Filled.Description" Color="Color.Primary"/>
                <MudText Typo="Typo.h6">@L["Description"]</MudText>
            </MudStack>
            <div style="color: var(--mud-palette-text-primary); overflow-wrap: break-word; word-break: break-word;">
                <style>
                    .software-description {
                        color: inherit;
                        line-height: 1.7;
                    }
                    .software-description h1 {
                        font-size: 1.75rem;
                        font-weight: 700;
                        margin: 2rem 0 1rem;
                        line-height: 1.3;
                    }
                    .software-description h2 {
                        font-size: 1.5rem;
                        font-weight: 600;
                        margin: 2rem 0 1rem;
                        line-height: 1.3;
                    }
                    .software-description h3 {
                        font-size: 1.25rem;
                        font-weight: 600;
                        margin: 1.5rem 0 0.75rem;
                        line-height: 1.3;
                    }
                    .software-description h4, .software-description h5, .software-description h6 {
                        font-size: 1.1rem;
                        font-weight: 600;
                        margin: 1.25rem 0 0.6rem;
                        line-height: 1.3;
                    }
                    .software-description p {
                        margin: 1rem 0;
                        line-height: 1.8;
                    }
                    .software-description ul, .software-description ol {
                        margin: 1rem 0;
                        padding-left: 1.75rem;
                    }
                    .software-description li {
                        margin: 0.6rem 0;
                        line-height: 1.7;
                    }
                    .software-description strong {
                        font-weight: 700;
                    }
                    .software-description img {
                        max-width: 100%;
                        height: auto;
                    }
                    .software-description pre {
                        overflow-x: auto;
                        max-width: 100%;
                        background: var(--mud-palette-surface);
                        padding: 1rem;
                        border-radius: 4px;
                    }
                    .software-description code {
                        background: var(--mud-palette-surface);
                        padding: 0.125rem 0.25rem;
                        border-radius: 3px;
                        font-size: 0.875em;
                    }
                    .software-description blockquote {
                        border-left: 4px solid var(--mud-palette-primary);
                        margin: 0.75rem 0;
                        padding: 0.5rem 1rem;
                        opacity: 0.85;
                    }
                    .software-description table {
                        border-collapse: collapse;
                        margin: 0.75rem 0;
                        width: 100%;
                    }
                    .software-description th, .software-description td {
                        border: 1px solid var(--mud-palette-lines-default);
                        padding: 0.5rem;
                    }
                    .software-description hr {
                        border: none;
                        border-top: 1px solid var(--mud-palette-lines-default);
                        margin: 1rem 0;
                    }
                </style>
                <div class="software-description" style="padding: 8px;">
                    @((MarkupString)_description)
                </div>
            </div>
        </MudCardContent>
    </MudCard>
}

@* ── General Information Card ── *@
<MudCard Elevation="2" Class="mb-4 rounded-lg">
    <MudCardContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
            <MudIcon Icon="@Icons.Material.Filled.Info" Color="Color.Primary"/>
            <MudText Typo="Typo.h6">@L["General"]</MudText>
        </MudStack>
        <MudSimpleTable Elevation="0" Dense="true">
            <tbody>
            <tr>
                <td style="width: 33%; text-align: right;"><strong>@L["Name"]</strong></td>
                <td>@_software.Name</td>
            </tr>
            @if(!string.IsNullOrEmpty(_software.Family))
            {
                <tr>
                    <td style="width: 33%; text-align: right;"><strong>@L["Family"]</strong></td>
                    <td>@_software.Family</td>
                </tr>
            }
            @if(_software.PredecessorId is not null && !string.IsNullOrEmpty(_software.Predecessor))
            {
                <tr>
                    <td style="width: 33%; text-align: right; padding-left: 2em;"><strong>@L["Predecessor"]</strong></td>
                    <td style="padding-left: 2em;"><MudLink Href="@($"/software/{_software.PredecessorId}")">@_software.Predecessor</MudLink></td>
                </tr>
            }
            @if(_software.SuccessorId is not null && !string.IsNullOrEmpty(_software.Successor))
            {
                <tr>
                    <td style="width: 33%; text-align: right; padding-left: 2em;"><strong>@L["Successor"]</strong></td>
                    <td style="padding-left: 2em;"><MudLink Href="@($"/software/{_software.SuccessorId}")">@_software.Successor</MudLink></td>
                </tr>
            }
            <tr>
                <td style="width: 33%; text-align: right;"><strong>@L["Kind"]</strong></td>
                <td>@(((Marechai.Data.SoftwareKind)(_software.Kind ?? 0)) switch
                    {
                        Marechai.Data.SoftwareKind.OperatingSystem     => L["Operating System"],
                        Marechai.Data.SoftwareKind.Game                => L["Game"],
                        Marechai.Data.SoftwareKind.Dlc                 => L["DLC / Addon"],
                        Marechai.Data.SoftwareKind.SystemSoftware      => L["System software"],
                        Marechai.Data.SoftwareKind.Application         => L["Application"],
                        Marechai.Data.SoftwareKind.DevelopmentSoftware => L["Development software"],
                        Marechai.Data.SoftwareKind.ServerSoftware      => L["Server software"],
                        Marechai.Data.SoftwareKind.Middleware          => L["Middleware"],
                        Marechai.Data.SoftwareKind.Firmware            => L["Firmware"],
                        Marechai.Data.SoftwareKind.EmbeddedSoftware    => L["Embedded software"],
                        _                                              => L["Software"]
                    })
                </td>
            </tr>
            @if(_software.BaseSoftwareId is not null && !string.IsNullOrEmpty(_software.BaseSoftware))
            {
                <tr>
                    <td style="width: 33%; text-align: right; padding-left: 2em;"><strong>@L["Base Software"]</strong></td>
                    <td style="padding-left: 2em;"><MudLink Href="@($"/software/{_software.BaseSoftwareId}")">@_software.BaseSoftware</MudLink></td>
                </tr>
            }
            </tbody>
        </MudSimpleTable>
    </MudCardContent>
</MudCard>

@* ── Genres Card ── *@
@if(_genres.Count > 0)
{
<MudCard Elevation="2" Class="mb-4 rounded-lg">
    <MudCardContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
            <MudIcon Icon="@Icons.Material.Filled.Category" Color="Color.Primary"/>
            <MudText Typo="Typo.h6">@L["Genres"]</MudText>
        </MudStack>
        @foreach(var genreType in _genresByType)
        {
            <MudText Typo="Typo.subtitle1" Class="mt-3 mb-2"><strong>@L[genreType.Key]</strong></MudText>
            <div class="d-flex flex-wrap gap-2 mb-2">
                @foreach(SoftwareGenreDto genre in genreType.Value)
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" Href="@($"/software/genre/{genre.Id}")">@L[genre.Name]</MudChip>
                }
            </div>
        }
    </MudCardContent>
</MudCard>
}

@* ── Addons / DLC Card ── *@
@if(_addons.Count > 0)
{
<MudCard Elevation="2" Class="mb-4 rounded-lg">
    <MudCardContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
            <MudIcon Icon="@Icons.Material.Filled.Extension" Color="Color.Warning"/>
            <MudText Typo="Typo.h6">@L["Addons"]</MudText>
        </MudStack>
        <MudList T="SoftwareDto" Dense="true">
            @foreach(SoftwareDto addon in _addons)
            {
                <MudListItem T="SoftwareDto">
                    <MudLink Href="@($"/software/{addon.Id}")">@addon.Name</MudLink>
                </MudListItem>
            }
        </MudList>
    </MudCardContent>
</MudCard>
}

</MudTabPanel>

@* ── SPECIFICATIONS TAB ── *@
<MudTabPanel Text="@L["Specifications"]" Icon="@Icons.Material.Filled.Tune" ToolTip="@L["Specifications"]">

@* ── Specifications & Ratings Card ── *@
@if(_specs.Count > 0 || _ratings.Count > 0)
{
<MudCard Elevation="2" Class="mb-4 rounded-lg">
    <MudCardContent>
        @if(_specs.Count > 0)
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                <MudIcon Icon="@Icons.Material.Filled.Settings" Color="Color.Primary"/>
                <MudText Typo="Typo.h6">@L["Specifications"]</MudText>
            </MudStack>
            @foreach(var platformGroup in _specsByPlatform)
            {
                <MudText Typo="Typo.subtitle1" Class="mt-3 mb-2"><strong>@platformGroup.Key</strong></MudText>
                <MudSimpleTable Elevation="0" Dense="true" Class="mb-3">
                    <tbody>
                    @foreach(SoftwareAttributeDto spec in platformGroup.Value)
                    {
                        <tr>
                            <td style="width: 33%; text-align: right;"><strong>@L[spec.Key]</strong></td>
                            <td>@L[spec.Value]</td>
                        </tr>
                    }
                    </tbody>
                </MudSimpleTable>
            }
        }
        @if(_ratings.Count > 0)
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3 mt-4">
                <MudIcon Icon="@Icons.Material.Filled.Star" Color="Color.Primary"/>
                <MudText Typo="Typo.h6">@L["Ratings"]</MudText>
            </MudStack>
            @foreach(var platformGroup in _ratingsByPlatform)
            {
                <MudText Typo="Typo.subtitle1" Class="mt-3 mb-2"><strong>@platformGroup.Key</strong></MudText>
                <div class="d-flex flex-wrap gap-2 mb-2">
                    @foreach(SoftwareAttributeDto rating in platformGroup.Value)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning">@L[rating.Key]: @L[rating.Value]</MudChip>
                    }
                </div>
            }
        }
    </MudCardContent>
</MudCard>
}

@* ── Companies Card ── *@
@if(_companies.Count > 0)
{
<MudExpansionPanels Elevation="2" Class="mb-4 rounded-lg">
    <MudExpansionPanel>
        <TitleContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.Business" Color="Color.Primary"/>
                <MudText Typo="Typo.h6">@L["Companies"]</MudText>
                <MudChip T="string" Size="Size.Small" Color="Color.Success">@_companies.Count</MudChip>
            </MudStack>
        </TitleContent>
        <ChildContent>
            <MudList T="SoftwareCompanyRoleDto" Dense="true">
                @foreach(SoftwareCompanyRoleDto company in _companies)
                {
                    <MudListItem T="SoftwareCompanyRoleDto" Href="@($"/company/{company.CompanyId}")" Icon="@Icons.Material.Filled.Business">
                        @company.Company
                        @if(!string.IsNullOrEmpty(company.Role))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="ml-2" Style="display: inline;">— @L[company.Role]</MudText>
                        }
                    </MudListItem>
                }
            </MudList>
        </ChildContent>
    </MudExpansionPanel>
</MudExpansionPanels>
}

@* ── Credits Card ── *@
@if(_credits.Count > 0)
{
<MudExpansionPanels Elevation="2" Class="mb-4 rounded-lg">
    <MudExpansionPanel>
        <TitleContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.People" Color="Color.Primary"/>
                <MudText Typo="Typo.h6">@L["Credits"]</MudText>
                <MudChip T="string" Size="Size.Small" Color="Color.Success">@_credits.Count</MudChip>
            </MudStack>
        </TitleContent>
        <ChildContent>
            @foreach(var group in _creditsByRole)
            {
                <MudText Typo="Typo.subtitle1" Class="mt-3 mb-2"><strong>@L[group.Key]</strong></MudText>
                <MudList T="PersonBySoftwareDto" Dense="true">
                    @foreach(PersonBySoftwareDto credit in group.Value)
                    {
                        <MudListItem T="PersonBySoftwareDto" Href="@($"/person/{credit.PersonId}")" Icon="@Icons.Material.Filled.Person">
                            @(credit.DisplayName ?? credit.Alias ?? $"{credit.Name} {credit.Surname}")
                        </MudListItem>
                    }
                </MudList>
            }
        </ChildContent>
    </MudExpansionPanel>
</MudExpansionPanels>
}

</MudTabPanel>

@* ── RELEASES TAB ── *@
<MudTabPanel Text="@L["Releases"]" Icon="@Icons.Material.Filled.LibraryBooks" ToolTip="@L["Releases"]">

@* ── Versions Card ── *@
@if(_versions.Count > 0)
{
<MudExpansionPanels Elevation="2" Class="mb-4 rounded-lg">
    <MudExpansionPanel>
        <TitleContent>
