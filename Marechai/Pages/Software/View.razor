        @if(_reviewSummary is not null)
        {
            <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Class="mb-4" Wrap="Wrap.Wrap">
                @if(_reviewSummary.AverageScore.HasValue)
                {
                    <MudChip T="string" Size="Size.Large" Variant="Variant.Filled" Color="Color.Primary">
                        @L["Overall:"] @($"{_reviewSummary.AverageScore:F0}%") (@_reviewSummary.TotalReviews @L["reviews"])
                    </MudChip>
                }
                @if(_reviewSummary.ByPlatform is not null)
                {
                    @foreach(var plat in _reviewSummary.ByPlatform)
                    {
                        @if(plat.AverageScore.HasValue)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Secondary">
                                @(plat.PlatformName ?? "Unknown"): @($"{plat.AverageScore:F0}%") (@plat.ReviewCount)
                            </MudChip>
                        }
                    }
                }
            </MudStack>
        }

        <MudExpansionPanels MultiExpansion="true" Elevation="0">
            @foreach(SoftwareCriticReviewDto review in _criticReviews)
            {
                <MudExpansionPanel>
                    <TitleContent>
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="w-100">
                            <MudText Typo="Typo.body1"><strong>@review.MagazineTitle</strong></MudText>
                            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                @if(!string.IsNullOrWhiteSpace(review.PlatformName))
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Default">@review.PlatformName</MudChip>
                                }
                                @if(review.NormalizedScore.HasValue)
                                {
                                    var scoreColor = review.NormalizedScore >= 75 ? Color.Success : review.NormalizedScore >= 50 ? Color.Warning : Color.Error;
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="scoreColor">
                                        @($"{review.NormalizedScore}%")
                                    </MudChip>
                                }
                                else
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default">@L["Unscored"]</MudChip>
                                }
                            </MudStack>
                        </MudStack>
                    </TitleContent>
                    <ChildContent>
                        @if(review.ReviewDate.HasValue)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Primary" Class="mb-2">
                                @FormatReviewDate(review)
                            </MudText>
                        }
                        @if(review.OriginalScore.HasValue && review.OriginalScoreMaximum.HasValue)
                        {
                            <MudText Typo="Typo.caption" Class="mb-2">
                                @($"{review.OriginalScore} / {review.OriginalScoreMaximum}")
                            </MudText>
                        }
                        @if(!string.IsNullOrWhiteSpace(review.ReviewText))
                        {
                            <MudText Typo="Typo.body2" Class="mt-2" Style="white-space: pre-wrap;">@review.ReviewText</MudText>
                        }
                        @if(!string.IsNullOrWhiteSpace(review.ReviewUrl))
                        {
                            <MudLink Href="@review.ReviewUrl" Target="_blank" Class="mt-2">@L["Full Review"]</MudLink>
                        }
                    </ChildContent>
                </MudExpansionPanel>
            }
        </MudExpansionPanels>
    </MudCardContent>
</MudCard>
}

@* ── User Reviews Card (always shown, with empty-state) ── *@
<MudCard Elevation="2" Class="mb-4 rounded-lg">
    <MudCardContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.People" Color="Color.Primary"/>
                <MudText Typo="Typo.h6">@L["User Reviews"]</MudText>
            </MudStack>
            @if(_isAuthenticated)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit"
                           OnClick="OpenReviewDialog" Size="Size.Small">
                    @(_myReview is not null ? L["Edit Review"] : L["Write Review"])
                </MudButton>
            }
        </MudStack>

        @if(_userReviews.Count == 0)
        {
            <MudText Typo="Typo.body2" Color="Color.Primary" Class="mb-2">@L["No reviews yet."]</MudText>
        }

        @foreach(SoftwareUserReviewDto userReview in _userReviews)
        {
            <MudPaper Class="pa-3 mb-3" Elevation="1" Style="border-radius: 8px;">
                @* ── Review Header ── *@
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        @if(!userReview.IsAnonymous.GetValueOrDefault() && !string.IsNullOrEmpty(userReview.UserName))
                        {
                            @if(!string.IsNullOrEmpty(userReview.AvatarUrl))
                            {
                                <MudAvatar Size="Size.Small">
                                    <MudImage Src="@userReview.AvatarUrl" Alt="@userReview.DisplayName"/>
                                </MudAvatar>
                            }
                            else
                            {
                                <MudAvatar Size="Size.Small" Color="Color.Primary">@(userReview.DisplayName?[..1] ?? "?")</MudAvatar>
                            }
                            <MudLink Href="@($"/profile/{userReview.UserName}")">@(userReview.DisplayName ?? userReview.UserName)</MudLink>
                        }
                        else
                        {
                            <MudAvatar Size="Size.Small" Color="Color.Default"><MudIcon Icon="@Icons.Material.Filled.Person"/></MudAvatar>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Anonymous"]</MudText>
                            @if(_isAdmin && userReview.IsAnonymous.GetValueOrDefault())
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning">@L["Anonymous"]</MudChip>
                            }
                        }
                        @if(userReview.Rating.HasValue)
                        {
                            <HalfStarRating ReadOnly="true" Value="@userReview.Rating.Value" Size="Size.Small"/>
                        }
                    </MudStack>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@userReview.CreatedOn?.DateTime.ToString("d")</MudText>
                        @* ── Admin actions ── *@
                        @if(_isAdmin || userReview.UserId == _currentUserId)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => OpenEditReviewDialog(userReview)"/>
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => DeleteReviewAsync(userReview)"/>
                        }
                        @if(_isAdmin && userReview.ReportCount > 0)
                        {
                            <MudBadge Content="@userReview.ReportCount" Color="Color.Error" Overlap="true">
                                <MudIcon Icon="@Icons.Material.Filled.Flag" Color="Color.Warning" Size="Size.Small"/>
                            </MudBadge>
                        }
                    </MudStack>
                </MudStack>

                @* ── Review Content (Good/Bad/Ugly) ── *@
                @if(!string.IsNullOrWhiteSpace(userReview.TheGood))
                {
                    <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="1" Class="mb-1">
                        <MudIcon Icon="@Icons.Material.Filled.ThumbUp" Color="Color.Success" Size="Size.Small"/>
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Success"><strong>@L["The Good"]</strong></MudText>
                            <MudText Typo="Typo.body2" Style="white-space: pre-wrap;">@userReview.TheGood</MudText>
                        </div>
                    </MudStack>
                }
                @if(!string.IsNullOrWhiteSpace(userReview.TheBad))
                {
                    <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="1" Class="mb-1">
                        <MudIcon Icon="@Icons.Material.Filled.ThumbDown" Color="Color.Error" Size="Size.Small"/>
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Error"><strong>@L["The Bad"]</strong></MudText>
                            <MudText Typo="Typo.body2" Style="white-space: pre-wrap;">@userReview.TheBad</MudText>
                        </div>
                    </MudStack>
                }
                @if(!string.IsNullOrWhiteSpace(userReview.TheUgly))
                {
                    <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="1" Class="mb-1">
                        <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" Size="Size.Small"/>
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Warning"><strong>@L["The Ugly"]</strong></MudText>
                            <MudText Typo="Typo.body2" Style="white-space: pre-wrap;">@userReview.TheUgly</MudText>
                        </div>
                    </MudStack>
                }

                @* ── Voting + Report ── *@
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-2">
                    <MudIconButton Icon="@Icons.Material.Filled.ThumbUp" Size="Size.Small"
                                   Color="@(userReview.CurrentUserVote == true ? Color.Success : Color.Default)"
                                   Disabled="@(!_isAuthenticated || userReview.UserId == _currentUserId)"
                                   OnClick="() => VoteAsync(userReview, true)"
                                   title="@L["Helpful"]"/>
                    <MudText Typo="Typo.caption">@userReview.ThumbsUp</MudText>

                    <MudIconButton Icon="@Icons.Material.Filled.ThumbDown" Size="Size.Small"
                                   Color="@(userReview.CurrentUserVote == false ? Color.Error : Color.Default)"
                                   Disabled="@(!_isAuthenticated || userReview.UserId == _currentUserId)"
                                   OnClick="() => VoteAsync(userReview, false)"
                                   title="@L["Not helpful"]"/>
                    <MudText Typo="Typo.caption">@userReview.ThumbsDown</MudText>

                    @if(_isAuthenticated && userReview.UserId != _currentUserId)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Flag" Size="Size.Small" Color="Color.Default"
                                       OnClick="() => OpenReportDialog(userReview)" title="@L["Report"]"/>
                    }
                </MudStack>
            </MudPaper>
        }
    </MudCardContent>
</MudCard>

</MudTabPanel>

</MudTabs>
