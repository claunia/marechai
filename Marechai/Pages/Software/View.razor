@page "/software/{Id:int}"
@using Marechai.ApiClient.Models
@inherits OwningComponentBase<SoftwareService>
@inject IStringLocalizer<SoftwareService> L
@inject ApiAssetUrlProvider               AssetUrls

@if(!_loaded)
{
    <div class="d-flex justify-center pa-8">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large"/>
    </div>

    return;
}

@if(_software is null)
{
    <MudAlert Severity="Severity.Warning">@L["Software not found."]</MudAlert>

    return;
}

@* ── Hero Header ── *@
<MudPaper Class="pa-6 mb-6" Elevation="0" Style="background: linear-gradient(135deg, #7e57c2 0%, #42a5f5 100%); border-radius: 16px;">
    <MudStack AlignItems="AlignItems.Center" Spacing="3">
        @if(_heroCover is not null)
        {
            <picture>
                <source srcset="@(AssetUrls.BaseUrl)/assets/photos/software-covers/jxl/hd/@(_heroCover.Id).jxl, @(AssetUrls.BaseUrl)/assets/photos/software-covers/jxl/1440p/@(_heroCover.Id).jxl 2x, @(AssetUrls.BaseUrl)/assets/photos/software-covers/jxl/4k/@(_heroCover.Id).jxl 3x" type="image/jxl">
                <source srcset="@(AssetUrls.BaseUrl)/assets/photos/software-covers/avif/hd/@(_heroCover.Id).avif, @(AssetUrls.BaseUrl)/assets/photos/software-covers/avif/1440p/@(_heroCover.Id).avif 2x, @(AssetUrls.BaseUrl)/assets/photos/software-covers/avif/4k/@(_heroCover.Id).avif 3x" type="image/avif">
                <source srcset="@(AssetUrls.BaseUrl)/assets/photos/software-covers/heif/hd/@(_heroCover.Id).heic, @(AssetUrls.BaseUrl)/assets/photos/software-covers/heif/1440p/@(_heroCover.Id).heic 2x, @(AssetUrls.BaseUrl)/assets/photos/software-covers/heif/4k/@(_heroCover.Id).heic 3x" type="image/heic">
                <source srcset="@(AssetUrls.BaseUrl)/assets/photos/software-covers/webp/hd/@(_heroCover.Id).webp, @(AssetUrls.BaseUrl)/assets/photos/software-covers/webp/1440p/@(_heroCover.Id).webp 2x, @(AssetUrls.BaseUrl)/assets/photos/software-covers/webp/4k/@(_heroCover.Id).webp 3x" type="image/webp">
                <img alt="@_software.Name"
                     src="@(AssetUrls.BaseUrl)/assets/photos/software-covers/jpeg/hd/@(_heroCover.Id).jpg"
                     srcset="@(AssetUrls.BaseUrl)/assets/photos/software-covers/jpeg/hd/@(_heroCover.Id).jpg, @(AssetUrls.BaseUrl)/assets/photos/software-covers/jpeg/1440p/@(_heroCover.Id).jpg 2x, @(AssetUrls.BaseUrl)/assets/photos/software-covers/jpeg/4k/@(_heroCover.Id).jpg 3x"
                     style="max-height: 256px; object-fit: contain; border-radius: 8px; box-shadow: 0 4px 16px rgba(0,0,0,0.3);"/>
            </picture>
        }
        else
        {
            <MudIcon Icon="@Icons.Material.Filled.Apps" Size="Size.Large" Style="color: white;"/>
        }
        <MudText Typo="Typo.h4" Align="Align.Center" Style="color: white; font-weight: 700;">@_software.Name</MudText>
        <div class="d-flex gap-2">
            @if(_software.IsOperatingSystem == true)
            {
                <MudChip T="string" Color="Color.Info" Variant="Variant.Filled" Size="Size.Small">@L["Operating System"]</MudChip>
            }
            @if(_software.IsGame == true)
            {
                <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Size="Size.Small">@L["Game"]</MudChip>
            }
        </div>
    </MudStack>
</MudPaper>

@* ── Description Card ── *@
@if(!string.IsNullOrWhiteSpace(_description))
{
    <MudCard Elevation="2" Class="mb-4 rounded-lg">
        <MudCardContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                <MudIcon Icon="@Icons.Material.Filled.Description" Color="Color.Primary"/>
                <MudText Typo="Typo.h6">@L["Description"]</MudText>
            </MudStack>
            <div style="color: var(--mud-palette-text-primary); overflow-wrap: break-word; word-break: break-word;">
                <style>
                    .software-description {
                        color: inherit;
                        line-height: 1.7;
                    }
                    .software-description h1 {
                        font-size: 1.75rem;
                        font-weight: 700;
                        margin: 1.5rem 0 0.75rem;
                    }
                    .software-description h2 {
                        font-size: 1.5rem;
                        font-weight: 600;
                        margin: 1.25rem 0 0.5rem;
                    }
                    .software-description h3 {
                        font-size: 1.25rem;
                        font-weight: 600;
                        margin: 1rem 0 0.5rem;
                    }
                    .software-description h4, .software-description h5, .software-description h6 {
                        font-size: 1.1rem;
                        font-weight: 600;
                        margin: 0.75rem 0 0.5rem;
                    }
                    .software-description p {
                        margin: 0.5rem 0;
                    }
                    .software-description ul, .software-description ol {
                        margin: 0.5rem 0;
                        padding-left: 1.5rem;
                    }
                    .software-description li {
                        margin: 0.25rem 0;
                    }
                    .software-description strong {
                        font-weight: 700;
                    }
                    .software-description img {
                        max-width: 100%;
                        height: auto;
                    }
                    .software-description pre {
                        overflow-x: auto;
                        max-width: 100%;
                        background: var(--mud-palette-surface);
                        padding: 1rem;
                        border-radius: 4px;
                    }
                    .software-description code {
                        background: var(--mud-palette-surface);
                        padding: 0.125rem 0.25rem;
                        border-radius: 3px;
                        font-size: 0.875em;
                    }
                    .software-description blockquote {
                        border-left: 4px solid var(--mud-palette-primary);
                        margin: 0.75rem 0;
                        padding: 0.5rem 1rem;
                        opacity: 0.85;
                    }
                    .software-description table {
                        border-collapse: collapse;
                        margin: 0.75rem 0;
                        width: 100%;
                    }
                    .software-description th, .software-description td {
                        border: 1px solid var(--mud-palette-lines-default);
                        padding: 0.5rem;
                    }
                    .software-description hr {
                        border: none;
                        border-top: 1px solid var(--mud-palette-lines-default);
                        margin: 1rem 0;
                    }
                </style>
                <div class="software-description" style="padding: 8px;">
                    @((MarkupString)_description)
                </div>
            </div>
        </MudCardContent>
    </MudCard>
}

@* ── General Information Card ── *@
<MudCard Elevation="2" Class="mb-4 rounded-lg">
    <MudCardContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
            <MudIcon Icon="@Icons.Material.Filled.Info" Color="Color.Primary"/>
            <MudText Typo="Typo.h6">@L["General"]</MudText>
        </MudStack>
        <MudSimpleTable Elevation="0" Dense="true">
            <tbody>
            <tr>
                <td style="width: 33%; text-align: right;"><strong>@L["Name"]</strong></td>
                <td>@_software.Name</td>
            </tr>
            @if(!string.IsNullOrEmpty(_software.Family))
            {
                <tr>
                    <td style="width: 33%; text-align: right;"><strong>@L["Family"]</strong></td>
                    <td>@_software.Family</td>
                </tr>
            }
            <tr>
                <td style="width: 33%; text-align: right;"><strong>@L["Operating System"]</strong></td>
                <td>@(_software.IsOperatingSystem == true ? L["Yes"] : L["No"])</td>
            </tr>
            <tr>
                <td style="width: 33%; text-align: right;"><strong>@L["Game"]</strong></td>
                <td>@(_software.IsGame == true ? L["Yes"] : L["No"])</td>
            </tr>
            </tbody>
        </MudSimpleTable>
    </MudCardContent>
</MudCard>

@* ── Genres Card ── *@
@if(_genres.Count > 0)
{
<MudCard Elevation="2" Class="mb-4 rounded-lg">
    <MudCardContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
            <MudIcon Icon="@Icons.Material.Filled.Category" Color="Color.Primary"/>
            <MudText Typo="Typo.h6">@L["Genres"]</MudText>
        </MudStack>
        @foreach(var genreType in _genresByType)
        {
            <MudText Typo="Typo.subtitle1" Class="mt-3 mb-2"><strong>@L[genreType.Key]</strong></MudText>
            <div class="d-flex flex-wrap gap-2 mb-2">
                @foreach(SoftwareGenreDto genre in genreType.Value)
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" Href="@($"/software/genre/{genre.Id}")">@L[genre.Name]</MudChip>
                }
            </div>
        }
    </MudCardContent>
</MudCard>
}

@* ── Specifications & Ratings Card ── *@
@if(_specs.Count > 0 || _ratings.Count > 0)
{
<MudCard Elevation="2" Class="mb-4 rounded-lg">
    <MudCardContent>
        @if(_specs.Count > 0)
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                <MudIcon Icon="@Icons.Material.Filled.Settings" Color="Color.Primary"/>
                <MudText Typo="Typo.h6">@L["Specifications"]</MudText>
            </MudStack>
            @foreach(var platformGroup in _specsByPlatform)
            {
                <MudText Typo="Typo.subtitle1" Class="mt-3 mb-2"><strong>@platformGroup.Key</strong></MudText>
                <MudSimpleTable Elevation="0" Dense="true" Class="mb-3">
                    <tbody>
                    @foreach(SoftwareAttributeDto spec in platformGroup.Value)
                    {
                        <tr>
                            <td style="width: 33%; text-align: right;"><strong>@L[spec.Key]</strong></td>
                            <td>@L[spec.Value]</td>
                        </tr>
                    }
                    </tbody>
                </MudSimpleTable>
            }
        }
        @if(_ratings.Count > 0)
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3 mt-4">
                <MudIcon Icon="@Icons.Material.Filled.Star" Color="Color.Primary"/>
                <MudText Typo="Typo.h6">@L["Ratings"]</MudText>
            </MudStack>
            @foreach(var platformGroup in _ratingsByPlatform)
            {
                <MudText Typo="Typo.subtitle1" Class="mt-3 mb-2"><strong>@platformGroup.Key</strong></MudText>
                <div class="d-flex flex-wrap gap-2 mb-2">
                    @foreach(SoftwareAttributeDto rating in platformGroup.Value)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning">@L[rating.Key]: @L[rating.Value]</MudChip>
                    }
                </div>
            }
        }
    </MudCardContent>
</MudCard>
}

@* ── Companies Card ── *@
@if(_companies.Count > 0)
{
<MudExpansionPanels Elevation="2" Class="mb-4 rounded-lg">
    <MudExpansionPanel>
        <TitleContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.Business" Color="Color.Primary"/>
                <MudText Typo="Typo.h6">@L["Companies"]</MudText>
                <MudChip T="string" Size="Size.Small" Color="Color.Success">@_companies.Count</MudChip>
            </MudStack>
        </TitleContent>
        <ChildContent>
            <MudList T="SoftwareCompanyRoleDto" Dense="true">
                @foreach(SoftwareCompanyRoleDto company in _companies)
                {
                    <MudListItem T="SoftwareCompanyRoleDto" Href="@($"/company/{company.CompanyId}")" Icon="@Icons.Material.Filled.Business">
                        @company.Company
                        @if(!string.IsNullOrEmpty(company.Role))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="ml-2" Style="display: inline;">— @L[company.Role]</MudText>
                        }
                    </MudListItem>
                }
            </MudList>
        </ChildContent>
    </MudExpansionPanel>
</MudExpansionPanels>
}

@* ── Credits Card ── *@
@if(_credits.Count > 0)
{
<MudExpansionPanels Elevation="2" Class="mb-4 rounded-lg">
    <MudExpansionPanel>
        <TitleContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.People" Color="Color.Primary"/>
                <MudText Typo="Typo.h6">@L["Credits"]</MudText>
                <MudChip T="string" Size="Size.Small" Color="Color.Success">@_credits.Count</MudChip>
            </MudStack>
        </TitleContent>
        <ChildContent>
            @foreach(var group in _creditsByRole)
            {
                <MudText Typo="Typo.subtitle1" Class="mt-3 mb-2"><strong>@L[group.Key]</strong></MudText>
                <MudList T="PersonBySoftwareDto" Dense="true">
                    @foreach(PersonBySoftwareDto credit in group.Value)
                    {
                        <MudListItem T="PersonBySoftwareDto" Href="@($"/person/{credit.PersonId}")" Icon="@Icons.Material.Filled.Person">
                            @(credit.DisplayName ?? credit.Alias ?? $"{credit.Name} {credit.Surname}")
                        </MudListItem>
                    }
                </MudList>
            }
        </ChildContent>
    </MudExpansionPanel>
</MudExpansionPanels>
}

@* ── Versions Card ── *@
@if(_versions.Count > 0)
{
<MudExpansionPanels Elevation="2" Class="mb-4 rounded-lg">
    <MudExpansionPanel>
        <TitleContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.History" Color="Color.Primary"/>
                <MudText Typo="Typo.h6">@L["Versions"]</MudText>
                <MudChip T="string" Size="Size.Small" Color="Color.Success">@_versions.Count</MudChip>
            </MudStack>
        </TitleContent>
        <ChildContent>
            @foreach(SoftwareVersionDto version in _versions)
            {
                <MudCard Elevation="1" Class="mb-3 rounded-lg">
                    <MudCardContent>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                            <MudIcon Icon="@Icons.Material.Filled.Label" Color="Color.Secondary" Size="Size.Small"/>
                            <MudText Typo="Typo.subtitle1"><strong>@version.VersionString</strong></MudText>
                            @if(!string.IsNullOrEmpty(version.PublicVersion))
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary">(@version.PublicVersion)</MudText>
                            }
                        </MudStack>
                        @if(!string.IsNullOrEmpty(version.Codename))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Tertiary" Class="mb-2">@L["Codename"]: @version.Codename</MudText>
                        }
                        @if(!string.IsNullOrEmpty(version.License))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Tertiary" Class="mb-2">@L["License"]: @version.License</MudText>
                        }
                    </MudCardContent>
                </MudCard>
            }
        </ChildContent>
    </MudExpansionPanel>
</MudExpansionPanels>
}

@* ── Releases Card (flat list) ── *@
@if(_releases.Count > 0)
{
<MudExpansionPanels Elevation="2" Class="mb-4 rounded-lg">
    <MudExpansionPanel>
        <TitleContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.NewReleases" Color="Color.Primary"/>
                <MudText Typo="Typo.h6">@L["Releases"]</MudText>
                <MudChip T="string" Size="Size.Small" Color="Color.Success">@_releases.Count</MudChip>
            </MudStack>
        </TitleContent>
        <ChildContent>
            <MudList T="SoftwareReleaseDto" Dense="true">
                @foreach(SoftwareReleaseDto release in _releases)
                {
                    <MudListItem T="SoftwareReleaseDto" Href="@($"/software/release/{release.Id}")" Icon="@Icons.Material.Filled.NewReleases">
                        <div class="d-flex flex-wrap align-center gap-2">
                            @if(!string.IsNullOrEmpty(release.Title) && release.IsCompilation != true)
                            {
                                <MudText Typo="Typo.body2" Style="font-style: italic;">@release.Title</MudText>
                            }
                            @if(!string.IsNullOrEmpty(release.SoftwareVersion))
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">@release.SoftwareVersion</MudChip>
                            }
                            @if(!string.IsNullOrEmpty(release.Platform))
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info">@release.Platform</MudChip>
                            }
                            @if(release.Regions is not null && release.Regions.Count > 0)
                            {
                                @foreach(var region in release.Regions)
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Secondary">@region.RegionName</MudChip>
                                }
                            }
                            @if(release.Languages is not null && release.Languages.Count > 0)
                            {
                                @foreach(var lang in release.Languages)
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Tertiary">@lang.Language</MudChip>
                                }
                            }
                            @if(!string.IsNullOrEmpty(release.Publisher))
                            {
                                <MudText Typo="Typo.body2">@release.Publisher</MudText>
                            }
                            @if(release.ReleaseDate.HasValue)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@(((release.ReleaseDatePrecision ?? 0) == 2 ? release.ReleaseDate.Value.Year.ToString() : (release.ReleaseDatePrecision ?? 0) == 1 ? release.ReleaseDate.Value.ToString("MMMM yyyy") : release.ReleaseDate.Value.DateTime.ToLongDateString()))</MudText>
                            }
                        </div>
                    </MudListItem>
                }
            </MudList>
        </ChildContent>
    </MudExpansionPanel>
</MudExpansionPanels>
}

@* ── Compilations Card ── *@
@if(_compilations.Count > 0)
{
    <MudExpansionPanels Elevation="2" Class="mb-4 rounded-lg">
        <MudExpansionPanel>
            <TitleContent>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.LibraryBooks" Color="Color.Primary"/>
                    <MudText Typo="Typo.h6">@L["Compilations"]</MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Success">@_compilations.Count</MudChip>
                </MudStack>
            </TitleContent>
            <ChildContent>
                <MudList T="SoftwareReleaseDto" Dense="true">
                    @foreach(SoftwareReleaseDto compilation in _compilations)
                    {
                        <MudListItem T="SoftwareReleaseDto" Href="@($"/software/release/{compilation.Id}")" Icon="@Icons.Material.Filled.Collections">
                            <div class="d-flex flex-wrap align-center gap-2">
                                <MudText Typo="Typo.body1"><strong>@(compilation.Title ?? L["Compilation"])</strong></MudText>
                                @if(!string.IsNullOrEmpty(compilation.Platform))
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info">@compilation.Platform</MudChip>
                                }
                                @if(compilation.Regions is not null && compilation.Regions.Count > 0)
                                {
                                    @foreach(var region in compilation.Regions)
                                    {
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Secondary">@region.RegionName</MudChip>
                                    }
                                }
                                @if(compilation.Languages is not null && compilation.Languages.Count > 0)
                                {
                                    @foreach(var lang in compilation.Languages)
                                    {
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Tertiary">@lang.Language</MudChip>
                                    }
                                }
                                @if(compilation.ReleaseDate.HasValue)
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@(((compilation.ReleaseDatePrecision ?? 0) == 2 ? compilation.ReleaseDate.Value.Year.ToString() : (compilation.ReleaseDatePrecision ?? 0) == 1 ? compilation.ReleaseDate.Value.ToString("MMMM yyyy") : compilation.ReleaseDate.Value.DateTime.ToLongDateString()))</MudText>
                                }
                            </div>
                        </MudListItem>
                    }
                </MudList>
            </ChildContent>
        </MudExpansionPanel>
    </MudExpansionPanels>
}

@* ── Covers Card ── *@
@if(_covers.Count > 0)
{
    <MudExpansionPanels Elevation="2" Class="mb-4 rounded-lg">
        <MudExpansionPanel>
            <TitleContent>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Photo" Color="Color.Primary"/>
                    <MudText Typo="Typo.h6">@L["Covers"]</MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Success">@_covers.Count</MudChip>
                </MudStack>
            </TitleContent>
            <ChildContent>
                @foreach(var group in _coversByRelease)
                {
                    <MudText Typo="Typo.subtitle1" Class="mt-3 mb-2"><strong>@group.Key</strong></MudText>
                    <div class="d-flex flex-wrap gap-3">
                        @foreach(SoftwareCoverDto cover in group.Value)
                        {
                            <MudCard Elevation="1" Class="rounded-lg" Style="width: 200px; cursor: pointer;" @onclick="() => _fullscreenCover = cover">
                                <MudCardContent Class="pa-2">
                                    <picture>
                                        <source srcset="@(AssetUrls.BaseUrl)/assets/photos/software-covers/jxl/hd/@(cover.Id).jxl, @(AssetUrls.BaseUrl)/assets/photos/software-covers/jxl/1440p/@(cover.Id).jxl 2x, @(AssetUrls.BaseUrl)/assets/photos/software-covers/jxl/4k/@(cover.Id).jxl 3x" type="image/jxl">
                                        <source srcset="@(AssetUrls.BaseUrl)/assets/photos/software-covers/avif/hd/@(cover.Id).avif, @(AssetUrls.BaseUrl)/assets/photos/software-covers/avif/1440p/@(cover.Id).avif 2x, @(AssetUrls.BaseUrl)/assets/photos/software-covers/avif/4k/@(cover.Id).avif 3x" type="image/avif">
                                        <source srcset="@(AssetUrls.BaseUrl)/assets/photos/software-covers/heif/hd/@(cover.Id).heic, @(AssetUrls.BaseUrl)/assets/photos/software-covers/heif/1440p/@(cover.Id).heic 2x, @(AssetUrls.BaseUrl)/assets/photos/software-covers/heif/4k/@(cover.Id).heic 3x" type="image/heic">
                                        <source srcset="@(AssetUrls.BaseUrl)/assets/photos/software-covers/webp/hd/@(cover.Id).webp, @(AssetUrls.BaseUrl)/assets/photos/software-covers/webp/1440p/@(cover.Id).webp 2x, @(AssetUrls.BaseUrl)/assets/photos/software-covers/webp/4k/@(cover.Id).webp 3x" type="image/webp">
                                        <img alt="@(cover.TypeName ?? cover.Caption)"
                                             src="@(AssetUrls.BaseUrl)/assets/photos/software-covers/jpeg/hd/@(cover.Id).jpg"
                                             srcset="@(AssetUrls.BaseUrl)/assets/photos/software-covers/jpeg/hd/@(cover.Id).jpg, @(AssetUrls.BaseUrl)/assets/photos/software-covers/jpeg/1440p/@(cover.Id).jpg 2x, @(AssetUrls.BaseUrl)/assets/photos/software-covers/jpeg/4k/@(cover.Id).jpg 3x"
                                             style="width: 100%; max-height: 250px; object-fit: contain; border-radius: 4px;"/>
                                    </picture>
                                    <MudText Typo="Typo.caption" Align="Align.Center" Class="mt-1"><strong>@cover.TypeName</strong></MudText>
                                    @if(!string.IsNullOrEmpty(cover.Caption))
                                    {
                                        <MudText Typo="Typo.caption" Align="Align.Center">@cover.Caption</MudText>
                                    }
                                </MudCardContent>
                            </MudCard>
                        }
                    </div>
                }
            </ChildContent>
        </MudExpansionPanel>
    </MudExpansionPanels>
}

@if(_fullscreenCover is not null)
{
    <MudOverlay Visible="true" DarkBackground="true" ZIndex="9999" OnClick="() => _fullscreenCover = null">
        <div class="d-flex flex-column align-center justify-center" style="width: 100vw; height: 100vh;">
            <picture>
                <source srcset="@(AssetUrls.BaseUrl)/assets/photos/software-covers/jxl/4k/@(_fullscreenCover.Id).jxl" type="image/jxl">
                <source srcset="@(AssetUrls.BaseUrl)/assets/photos/software-covers/avif/4k/@(_fullscreenCover.Id).avif" type="image/avif">
                <source srcset="@(AssetUrls.BaseUrl)/assets/photos/software-covers/heif/4k/@(_fullscreenCover.Id).heic" type="image/heic">
                <source srcset="@(AssetUrls.BaseUrl)/assets/photos/software-covers/webp/4k/@(_fullscreenCover.Id).webp" type="image/webp">
                <img alt="@(_fullscreenCover.TypeName ?? _fullscreenCover.Caption)"
                     src="@(AssetUrls.BaseUrl)/assets/photos/software-covers/jpeg/4k/@(_fullscreenCover.Id).jpg"
                     style="max-width: 95vw; max-height: 90vh; object-fit: contain;"/>
            </picture>
            <MudText Typo="Typo.subtitle1" Style="color: white;" Class="mt-2">@_fullscreenCover.TypeName</MudText>
            @if(!string.IsNullOrEmpty(_fullscreenCover.Caption))
            {
                <MudText Typo="Typo.body2" Style="color: rgba(255,255,255,0.8);" Class="mt-1">@_fullscreenCover.Caption</MudText>
            }
        </div>
    </MudOverlay>
}

@* ── Screenshots Card ── *@
@if(_screenshots.Count > 0)
{
    <MudExpansionPanels Elevation="2" Class="mb-4 rounded-lg">
        <MudExpansionPanel>
            <TitleContent>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Image" Color="Color.Primary"/>
                    <MudText Typo="Typo.h6">@L["Screenshots"]</MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Success">@_screenshots.Count</MudChip>
                </MudStack>
            </TitleContent>
            <ChildContent>
                @foreach(var group in _screenshotsByPlatform)
                {
                    <MudText Typo="Typo.subtitle1" Class="mt-3 mb-2"><strong>@group.Key</strong></MudText>
                    <div class="d-flex flex-wrap gap-3">
                        @foreach(SoftwareScreenshotDto screenshot in group.Value)
                        {
                            <MudCard Elevation="1" Class="rounded-lg" Style="width: 200px; cursor: pointer;" @onclick="() => _fullscreenScreenshot = screenshot">
                                <MudCardContent Class="pa-2">
                                    <picture>
                                        <source srcset="@(AssetUrls.BaseUrl)/assets/photos/software-screenshots/jxl/hd/@(screenshot.Id).jxl, @(AssetUrls.BaseUrl)/assets/photos/software-screenshots/jxl/1440p/@(screenshot.Id).jxl 2x, @(AssetUrls.BaseUrl)/assets/photos/software-screenshots/jxl/4k/@(screenshot.Id).jxl 3x" type="image/jxl">
                                        <source srcset="@(AssetUrls.BaseUrl)/assets/photos/software-screenshots/avif/hd/@(screenshot.Id).avif, @(AssetUrls.BaseUrl)/assets/photos/software-screenshots/avif/1440p/@(screenshot.Id).avif 2x, @(AssetUrls.BaseUrl)/assets/photos/software-screenshots/avif/4k/@(screenshot.Id).avif 3x" type="image/avif">
                                        <source srcset="@(AssetUrls.BaseUrl)/assets/photos/software-screenshots/heif/hd/@(screenshot.Id).heic, @(AssetUrls.BaseUrl)/assets/photos/software-screenshots/heif/1440p/@(screenshot.Id).heic 2x, @(AssetUrls.BaseUrl)/assets/photos/software-screenshots/heif/4k/@(screenshot.Id).heic 3x" type="image/heic">
                                        <source srcset="@(AssetUrls.BaseUrl)/assets/photos/software-screenshots/webp/hd/@(screenshot.Id).webp, @(AssetUrls.BaseUrl)/assets/photos/software-screenshots/webp/1440p/@(screenshot.Id).webp 2x, @(AssetUrls.BaseUrl)/assets/photos/software-screenshots/webp/4k/@(screenshot.Id).webp 3x" type="image/webp">
                                        <img alt="@screenshot.Caption"
                                             src="@(AssetUrls.BaseUrl)/assets/photos/software-screenshots/jpeg/hd/@(screenshot.Id).jpg"
                                             srcset="@(AssetUrls.BaseUrl)/assets/photos/software-screenshots/jpeg/hd/@(screenshot.Id).jpg, @(AssetUrls.BaseUrl)/assets/photos/software-screenshots/jpeg/1440p/@(screenshot.Id).jpg 2x, @(AssetUrls.BaseUrl)/assets/photos/software-screenshots/jpeg/4k/@(screenshot.Id).jpg 3x"
                                             style="width: 100%; max-height: 150px; object-fit: contain; border-radius: 4px;"/>
                                    </picture>
                                    @if(!string.IsNullOrEmpty(screenshot.Caption))
                                    {
                                        <MudText Typo="Typo.caption" Align="Align.Center" Class="mt-1">@screenshot.Caption</MudText>
                                    }
                                </MudCardContent>
                            </MudCard>
                        }
                    </div>
                }
            </ChildContent>
        </MudExpansionPanel>
    </MudExpansionPanels>
}

