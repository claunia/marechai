@page "/software/all"
@page "/software/year/{Year:int}"
@page "/software/letter/{StartingCharacter}"
@page "/software/platform/{PlatformId:int}"
@page "/software/genre/{GenreId:int}"
@page "/software/spec"
@using Marechai.ApiClient.Models
@using Marechai.Data
@inherits OwningComponentBase<SoftwareService>
@inject IStringLocalizer<SoftwareService> L
@inject ApiAssetUrlProvider               AssetUrls

@if(_software is null)
{
    <div class="d-flex justify-center pa-8">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true"/>
    </div>

    return;
}

<EntityMetaTags Title="@L["Browse software"]"
               Description="Search and browse software applications, games and operating systems by title, year, platform or genre."
               CanonicalPath="/software/all"
               OgType="website"
               Breadcrumbs="@(new (string, string?)[] { (L["Software"], "/software"), (L["Browse"], null) })" />

<MudPaper Class="pa-6 mb-6" Elevation="0" Style="background: linear-gradient(135deg, #7e57c2 0%, #42a5f5 100%); border-radius: 16px;">
    <MudText Typo="Typo.h5" Style="color: white;">@L["Search results:"]</MudText>
    @if(_character.HasValue)
    {
        <MudText Typo="Typo.h6" Style="color: rgba(255,255,255,0.85);">@string.Format(L["Software starting with {0}"], _character)</MudText>
    }
    else if(Year.HasValue)
    {
        <MudText Typo="Typo.h6" Style="color: rgba(255,255,255,0.85);">@string.Format(L["Software from {0}"], Year)</MudText>
    }
    else if(PlatformId.HasValue && !string.IsNullOrEmpty(_platformName))
    {
        <MudText Typo="Typo.h6" Style="color: rgba(255,255,255,0.85);">@string.Format(L["Software for {0}"], _platformName)</MudText>
    }
    else if(GenreId.HasValue && !string.IsNullOrEmpty(_genreName))
    {
        <MudText Typo="Typo.h6" Style="color: rgba(255,255,255,0.85);">@string.Format(L["Software in genre {0}"], _genreName)</MudText>
    }
    else if(!string.IsNullOrEmpty(SpecKey) && !string.IsNullOrEmpty(SpecValue))
    {
        @* Server canonical (English) values for filter round-trip; UI heading echoes them
           verbatim. A per-string translation endpoint could replace this if a localized
           heading is desired (low-impact today: heading is small, page body is fully localized). *@
        <MudText Typo="Typo.h6" Style="color: rgba(255,255,255,0.85);">@string.Format(L["Software with {0}: {1}"], SpecKey, SpecValue)</MudText>
    }
    @if(_kind.HasValue)
    {
        <MudText Typo="Typo.body2" Style="color: rgba(255,255,255,0.85);">@string.Format(L["Filtered by kind: {0}"], L[KindLabel(_kind.Value)])</MudText>
    }
</MudPaper>

<div class="mb-4" style="max-width: 360px;">
    <MudSelect T="SoftwareKind?" Value="_kind" ValueChanged="OnKindChanged"
               Label="@L["Filter by kind"]"
               Variant="Variant.Outlined"
               Margin="Margin.Dense"
               Clearable="true">
        <MudSelectItem T="SoftwareKind?" Value="@((SoftwareKind?)null)">@L["Any kind"]</MudSelectItem>
        <MudSelectItem T="SoftwareKind?" Value="SoftwareKind.OperatingSystem">@L["OS"]</MudSelectItem>
        <MudSelectItem T="SoftwareKind?" Value="SoftwareKind.Game">@L["Game"]</MudSelectItem>
        <MudSelectItem T="SoftwareKind?" Value="SoftwareKind.Dlc">@L["DLC / Addon"]</MudSelectItem>
        <MudSelectItem T="SoftwareKind?" Value="SoftwareKind.SystemSoftware">@L["System software"]</MudSelectItem>
        <MudSelectItem T="SoftwareKind?" Value="SoftwareKind.Application">@L["Application"]</MudSelectItem>
        <MudSelectItem T="SoftwareKind?" Value="SoftwareKind.DevelopmentSoftware">@L["Development software"]</MudSelectItem>
        <MudSelectItem T="SoftwareKind?" Value="SoftwareKind.ServerSoftware">@L["Server software"]</MudSelectItem>
        <MudSelectItem T="SoftwareKind?" Value="SoftwareKind.Middleware">@L["Middleware"]</MudSelectItem>
        <MudSelectItem T="SoftwareKind?" Value="SoftwareKind.Firmware">@L["Firmware"]</MudSelectItem>
        <MudSelectItem T="SoftwareKind?" Value="SoftwareKind.EmbeddedSoftware">@L["Embedded software"]</MudSelectItem>
        <MudSelectItem T="SoftwareKind?" Value="SoftwareKind.Software">@L["Software"]</MudSelectItem>
    </MudSelect>
</div>

@code {
    static string KindLabel(SoftwareKind kind) => kind switch
    {
        SoftwareKind.OperatingSystem     => "OS",
        SoftwareKind.Game                => "Game",
        SoftwareKind.Dlc                 => "DLC / Addon",
        SoftwareKind.SystemSoftware      => "System software",
        SoftwareKind.Application         => "Application",
        SoftwareKind.DevelopmentSoftware => "Development software",
        SoftwareKind.ServerSoftware      => "Server software",
        SoftwareKind.Middleware          => "Middleware",
        SoftwareKind.Firmware            => "Firmware",
        SoftwareKind.EmbeddedSoftware    => "Embedded software",
        _                                 => "Software"
    };
}

@if(_software?.Count > 0)
{
    <MudText Typo="Typo.body2" Class="mb-2">@string.Format(L["{0} software titles found in the database."], _total)</MudText>
    <div id="@_scrollerId" style="height: calc(100dvh - 280px); min-height: 360px; overflow-y: auto;">
        <MudList T="SoftwareDto" Dense="true">
            <Virtualize Items="_software" Context="sw" ItemSize="100">
            <MudListItem T="SoftwareDto" Href="@(sw.IsCompilation == true ? $"/software-compilation/{sw.Id}" : $"/software/{sw.Id}")">
                <div class="d-flex align-center gap-3">
                    @if(sw.FrontCoverId.HasValue)
                    {
                        <div class="sw-cover-thumb sw-cover-thumb-md">
                            <picture>
                                <source srcset="@(AssetUrls.BaseUrl)/assets/photos/software-covers/avif/4k/@(sw.FrontCoverId).avif" type="image/avif">
                                <source srcset="@(AssetUrls.BaseUrl)/assets/photos/software-covers/webp/4k/@(sw.FrontCoverId).webp" type="image/webp">
                                <img alt="@sw.Name"
                                     src="@(AssetUrls.BaseUrl)/assets/photos/software-covers/jpeg/4k/@(sw.FrontCoverId).jpg"
                                     srcset="@(AssetUrls.BaseUrl)/assets/photos/software-covers/jpeg/4k/@(sw.FrontCoverId).jpg"/>
                            </picture>
                        </div>
                    }
                    else
                    {
                        <div class="sw-cover-thumb sw-cover-thumb-md">
                            <MudIcon Icon="@Icons.Material.Filled.Apps" Size="Size.Large" Color="Color.Default"/>
                        </div>
                    }
                    <div>
                        <MudText Typo="Typo.body1">@sw.Name</MudText>
                        @if(!string.IsNullOrEmpty(sw.Family))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@sw.Family</MudText>
                        }
                    </div>
                    @if(sw.IsCompilation == true)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Style="color: #9C27B0; border-color: #9C27B0;">@L["Compilation"]</MudChip>
                    }
                    else
                    {
                        @switch((Marechai.Data.SoftwareKind)(sw.Kind ?? 0))
                        {
                            case Marechai.Data.SoftwareKind.OperatingSystem:
                                <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">@L["OS"]</MudChip>
                                break;
                            case Marechai.Data.SoftwareKind.Game:
                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">@L["Game"]</MudChip>
                                break;
                            case Marechai.Data.SoftwareKind.Dlc:
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">@L["DLC / Addon"]</MudChip>
                                break;
                            case Marechai.Data.SoftwareKind.SystemSoftware:
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Style="color: #455A64; border-color: #455A64;">@L["System software"]</MudChip>
                                break;
                            case Marechai.Data.SoftwareKind.Application:
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Style="color: #1976D2; border-color: #1976D2;">@L["Application"]</MudChip>
                                break;
                            case Marechai.Data.SoftwareKind.DevelopmentSoftware:
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Style="color: #3F51B5; border-color: #3F51B5;">@L["Development software"]</MudChip>
                                break;
                            case Marechai.Data.SoftwareKind.ServerSoftware:
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Style="color: #795548; border-color: #795548;">@L["Server software"]</MudChip>
                                break;
                            case Marechai.Data.SoftwareKind.Middleware:
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Style="color: #00BCD4; border-color: #00BCD4;">@L["Middleware"]</MudChip>
                                break;
                            case Marechai.Data.SoftwareKind.Firmware:
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Style="color: #827717; border-color: #CDDC39;">@L["Firmware"]</MudChip>
                                break;
                            case Marechai.Data.SoftwareKind.EmbeddedSoftware:
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Style="color: #009688; border-color: #009688;">@L["Embedded software"]</MudChip>
                                break;
                            default:
                                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">@L["Software"]</MudChip>
                                break;
                        }
                    }
                </div>
            </MudListItem>
        </Virtualize>
        </MudList>
        <div id="@_sentinelId" style="height: 1px;"></div>
        @if(_loadingMore)
        {
            <div class="d-flex justify-center pa-3">
                <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true"/>
            </div>
        }
    </div>
}
else
{
    @if(_character.HasValue)
    {
        <MudAlert Severity="Severity.Info">@L["There is no software found in the database that starts with this letter."]</MudAlert>
    }
    else if(Year.HasValue)
    {
        <MudAlert Severity="Severity.Info">@L["There is no software found from this year."]</MudAlert>
    }
    else if(PlatformId.HasValue)
    {
        <MudAlert Severity="Severity.Info">@L["There is no software found for this platform."]</MudAlert>
    }
    else if(GenreId.HasValue)
    {
        <MudAlert Severity="Severity.Info">@L["There is no software found for this genre."]</MudAlert>
    }
    else if(!string.IsNullOrEmpty(SpecKey) && !string.IsNullOrEmpty(SpecValue))
    {
        <MudAlert Severity="Severity.Info">@L["There is no software found with this specification."]</MudAlert>
    }
}
