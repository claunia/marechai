@page "/software"
@using Marechai.ApiClient.Models
@using Marechai.Data
@using Marechai.Pages.Suggestions
@using MudBlazor
@inherits OwningComponentBase<SoftwareService>
@inject IStringLocalizer<SoftwareService> L
@inject IDialogService                    DialogService

@if(!_loaded)
{
    <div class="d-flex justify-center pa-8">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large"/>
    </div>

    return;
}

<MudPaper Class="pa-6 mb-6" Elevation="0" Style="background: linear-gradient(135deg, #7e57c2 0%, #42a5f5 100%); border-radius: 16px;">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
            <MudIcon Icon="@Icons.Material.Filled.Apps" Size="Size.Large" Style="color: white;"/>
            <MudText Typo="Typo.h4" Style="color: white;">@L["Software"]</MudText>
        </MudStack>
        <AuthorizeView>
            <Authorized>
                <MudTooltip Text="@L["Suggest a new software to be added to the catalogue. A first release is required."]">
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Inherit"
                               StartIcon="@Icons.Material.Filled.AddCircle"
                               OnClick="OpenSuggestNewSoftwareDialog"
                               Style="color: white; border-color: rgba(255,255,255,0.7);">@L["Suggest new software"]</MudButton>
                </MudTooltip>
            </Authorized>
        </AuthorizeView>
    </MudStack>
    <MudText Typo="Typo.body1" Style="color: rgba(255,255,255,0.85);">@L["Here you can consult our database."]</MudText>
    <MudText Typo="Typo.body1" Style="color: rgba(255,255,255,0.85);">@L["The database contains information about software related to computing history."]</MudText>
    <MudChip T="string" Color="Color.Dark" Variant="Variant.Filled" Class="mt-2" Style="color: white; white-space: normal; height: auto; overflow: visible; text-overflow: unset; padding: 8px 16px;">@string.Format(L["There are {0} software titles in the database at this moment."], _count)</MudChip>
</MudPaper>

<MudPaper Elevation="2" Class="pa-4 mb-4 rounded-lg">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
        <MudIcon Icon="@Icons.Material.Filled.Business" Color="Color.Secondary" Size="Size.Small"/>
        <MudText Typo="Typo.subtitle1">@L["Search by companies"]</MudText>
    </MudStack>
    <MudStack Spacing="1" AlignItems="AlignItems.Center">
        <div class="d-flex flex-wrap justify-center gap-1">
            @foreach(char c in "QWERTYUIOP") { <MudChip T="string" Href="@($"/software/companies/{c}")">@c</MudChip> }
        </div>
        <div class="d-flex flex-wrap justify-center gap-1">
            @foreach(char c in "ASDFGHJKL") { <MudChip T="string" Href="@($"/software/companies/{c}")">@c</MudChip> }
        </div>
        <div class="d-flex flex-wrap justify-center gap-1">
            @foreach(char c in "ZXCVBNM") { <MudChip T="string" Href="@($"/software/companies/{c}")">@c</MudChip> }
        </div>
        <MudChip T="string" Href="/software/companies" Color="Color.Primary" Class="mt-1">@L["All companies"]</MudChip>
    </MudStack>
</MudPaper>

<MudPaper Elevation="2" Class="pa-4 mb-4 rounded-lg">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
        <MudIcon Icon="@Icons.Material.Filled.SortByAlpha" Color="Color.Secondary" Size="Size.Small"/>
        <MudText Typo="Typo.subtitle1">@L["Search software alphabetically"]</MudText>
    </MudStack>
    <MudStack Spacing="1" AlignItems="AlignItems.Center">
        <div class="d-flex flex-wrap justify-center gap-1">
            @foreach(char c in "QWERTYUIOP") { <MudChip T="string" Href="@($"/software/letter/{c}")">@c</MudChip> }
        </div>
        <div class="d-flex flex-wrap justify-center gap-1">
            @foreach(char c in "ASDFGHJKL") { <MudChip T="string" Href="@($"/software/letter/{c}")">@c</MudChip> }
        </div>
        <div class="d-flex flex-wrap justify-center gap-1">
            @foreach(char c in "ZXCVBNM") { <MudChip T="string" Href="@($"/software/letter/{c}")">@c</MudChip> }
        </div>
        <MudChip T="string" Href="/software/all" Color="Color.Primary" Class="mt-1">@L["All software"]</MudChip>
    </MudStack>
</MudPaper>

@if(_platforms.Count > 0)
{
    <MudPaper Elevation="2" Class="pa-4 mb-4 rounded-lg">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
            <MudIcon Icon="@Icons.Material.Filled.Devices" Color="Color.Secondary" Size="Size.Small"/>
            <MudText Typo="Typo.subtitle1">@L["Search software by platform"]</MudText>
        </MudStack>
        <div class="d-flex flex-wrap gap-1">
            @foreach(SoftwarePlatformDto platform in _platforms.OrderBy(p => p.Name, NaturalUnitComparer.Instance))
            {
                <MudChip T="string" Href="@($"/software/platform/{platform.Id}")">@platform.Name</MudChip>
            }
        </div>
    </MudPaper>
}

@* Genre section is collapsed by default and its chip body is rendered only when the
   panel is expanded. Without the `@if(_genresPanelExpanded)` gate MudBlazor would
   keep the ~150 genre chips in the render tree with `display:none`, which still
   costs the initial SignalR diff. *@
@if(_genresByType?.Count > 0)
{
    <MudExpansionPanels Elevation="2" Class="mb-4 rounded-lg">
        <MudExpansionPanel Expanded="@_genresPanelExpanded"
                           ExpandedChanged="@(v => _genresPanelExpanded = v)">
            <TitleContent>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Category" Color="Color.Secondary" Size="Size.Small"/>
                    <MudText Typo="Typo.subtitle1">@L["Search software by genre"] (@_genresByType.Sum(t => t.Value.Count))</MudText>
                </MudStack>
            </TitleContent>
            <ChildContent>
                @if(_genresPanelExpanded)
                {
                    @foreach(var genreType in _genresByType)
                    {
                        <MudText Typo="Typo.subtitle2" Class="mt-2 mb-1"><strong>@L[genreType.Key]</strong></MudText>
                        <div class="d-flex flex-wrap gap-1">
                            @foreach(SoftwareGenreDto genre in genreType.Value.OrderBy(g => g.Name, NaturalUnitComparer.Instance))
                            {
                                <MudChip T="string" Href="@($"/software/genre/{genre.Id}")">@genre.Name</MudChip>
                            }
                        </div>
                    }
                }
            </ChildContent>
        </MudExpansionPanel>
    </MudExpansionPanels>
}

@* Specifications section dominates the chip count: ~70 keys, some with 100–200 values
   each (~1500–2000 chips total). Outer panel is collapsed by default; once expanded
   it renders one nested panel per spec key (chip count only — no values yet); the
   inner panels lazy-render their value chips when individually expanded. *@
@if(_specsByKey?.Count > 0)
{
    <MudExpansionPanels Elevation="2" Class="mb-4 rounded-lg">
        <MudExpansionPanel Expanded="@_specsPanelExpanded"
                           ExpandedChanged="@(v => _specsPanelExpanded = v)">
            <TitleContent>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Settings" Color="Color.Secondary" Size="Size.Small"/>
                    <MudText Typo="Typo.subtitle1">@L["Search software by specifications"] (@_specsByKey.Count)</MudText>
                </MudStack>
            </TitleContent>
            <ChildContent>
                @if(_specsPanelExpanded)
                {
                    <MudExpansionPanels MultiExpansion="true" Class="mt-2">
                        @foreach(var specKey in _specsByKey)
                        {
                            // Capture loop variable for the lambda + dictionary lookup.
                            var keyForClosure = specKey.Key;
                            <MudExpansionPanel Text="@($"{specKey.DisplayKey} ({specKey.Values.Count})")"
                                               Expanded="@(_specKeyExpanded.GetValueOrDefault(keyForClosure))"
                                               ExpandedChanged="@(v => _specKeyExpanded[keyForClosure] = v)">
                                @if(_specKeyExpanded.GetValueOrDefault(keyForClosure))
                                {
                                    // Pair canonical Values[i] (used in the URL filter) with DisplayValues[i] (the
                                    // translated label) and sort by display so the UI order matches the user's locale.
                                    var paired = specKey.Values
                                                        .Select((v, i) => new
                                                                          {
                                                                              Raw     = v,
                                                                              Display = i < specKey.DisplayValues.Count
                                                                                            ? specKey.DisplayValues[i]
                                                                                            : v
                                                                          })
                                                        .OrderBy(p => p.Display, NaturalUnitComparer.Instance);

                                    <div class="d-flex flex-wrap gap-1">
                                        @foreach(var pair in paired)
                                        {
                                            <MudChip T="string" Href="@($"/software/spec?key={Uri.EscapeDataString(specKey.Key)}&value={Uri.EscapeDataString(pair.Raw)}")">@pair.Display</MudChip>
                                        }
                                    </div>
                                }
                            </MudExpansionPanel>
                        }
                    </MudExpansionPanels>
                }
            </ChildContent>
        </MudExpansionPanel>
    </MudExpansionPanels>
}

<MudPaper Elevation="2" Class="pa-4 mb-4 rounded-lg">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
        <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Color="Color.Secondary" Size="Size.Small"/>
        <MudText Typo="Typo.subtitle1">@L["Search software by year"]</MudText>
    </MudStack>
    <div class="d-flex flex-wrap gap-1">
        @for(int i = _minYear; i <= _maxYear; i++)
        {
            var year = i;
            <MudChip T="string" Href="@($"/software/year/{year}")">@year</MudChip>
        }
    </div>
</MudPaper>
