@page "/software/release/{Id:int}"
@using Marechai.ApiClient.Models
@inherits OwningComponentBase<SoftwareService>
@inject IStringLocalizer<SoftwareService> L
@inject CollectionService                 CollectionSvc
@inject ApiAssetUrlProvider               Assets

@if(!_loaded)
{
    <div class="d-flex justify-center pa-8">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large"/>
    </div>

    return;
}

@if(_release is null)
{
    <MudAlert Severity="Severity.Warning">@L["Release not found."]</MudAlert>

    return;
}

@* ── Hero Header ── *@
<MudPaper Class="pa-6 mb-6" Elevation="0" Style="background: linear-gradient(135deg, #7e57c2 0%, #42a5f5 100%); border-radius: 16px;">
    <MudStack AlignItems="AlignItems.Center" Spacing="3">
        <MudIcon Icon="@Icons.Material.Filled.NewReleases" Size="Size.Large" Style="color: white;"/>
        @if(_release.IsCompilation == true)
        {
            <MudText Typo="Typo.h4" Align="Align.Center" Style="color: white; font-weight: 700;">@(!string.IsNullOrEmpty(_release.Title) ? _release.Title : L["Compilation"])</MudText>
            <MudChip T="string" Color="Color.Warning" Variant="Variant.Filled" Size="Size.Small">@L["Compilation"]</MudChip>
        }
        else
        {
            <MudText Typo="Typo.h4" Align="Align.Center" Style="color: white; font-weight: 700;">@(!string.IsNullOrEmpty(_softwareName) ? _softwareName : L["Software Release"])</MudText>
            @if(!string.IsNullOrEmpty(_release.SoftwareVersion))
            {
                <MudText Typo="Typo.h6" Align="Align.Center" Style="color: rgba(255,255,255,0.85);">@_release.SoftwareVersion</MudText>
            }
            @if(!string.IsNullOrEmpty(_release.Title))
            {
                <MudText Typo="Typo.subtitle1" Align="Align.Center" Style="color: rgba(255,255,255,0.7); font-style: italic;">@_release.Title</MudText>
            }
        }
        <AuthorizeView>
            <Authorized>
                <MudButton Variant="Variant.Filled"
                           Color="@(_isCollected ? Color.Success : Color.Default)"
                           StartIcon="@(_isCollected ? Icons.Material.Filled.Bookmark : Icons.Material.Outlined.BookmarkBorder)"
                           OnClick="ToggleCollectionAsync"
                           Disabled="_togglingCollection"
                           Size="Size.Small">
                    @(_isCollected ? L["In Collection"] : L["Add to Collection"])
                </MudButton>
            </Authorized>
        </AuthorizeView>
    </MudStack>
</MudPaper>

@* ── Covers Card ── *@
@if(_covers.Count > 0)
{
    <MudExpansionPanels Elevation="2" Class="mb-4 rounded-lg">
        <MudExpansionPanel IsInitiallyExpanded="true">
            <TitleContent>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Photo" Color="Color.Primary"/>
                    <MudText Typo="Typo.h6">@L["Covers"]</MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Success">@_covers.Count</MudChip>
                </MudStack>
            </TitleContent>
            <ChildContent>
                @foreach(var group in _coversByType)
                {
                    <MudText Typo="Typo.subtitle1" Class="mt-3 mb-2"><strong>@group.Key</strong></MudText>
                    <div class="d-flex flex-wrap gap-3">
                        @foreach(SoftwareCoverDto cover in group.Value)
                        {
                            <MudCard Elevation="1" Class="rounded-lg" Style="width: 200px; cursor: pointer;" @onclick="() => _fullscreenCover = cover">
                                <MudCardContent Class="pa-2">
                                    <picture>
                                        <source srcset="@(Assets.BaseUrl)/assets/photos/software-covers/jxl/hd/@(cover.Id).jxl, @(Assets.BaseUrl)/assets/photos/software-covers/jxl/1440p/@(cover.Id).jxl 2x, @(Assets.BaseUrl)/assets/photos/software-covers/jxl/4k/@(cover.Id).jxl 3x" type="image/jxl">
                                        <source srcset="@(Assets.BaseUrl)/assets/photos/software-covers/avif/hd/@(cover.Id).avif, @(Assets.BaseUrl)/assets/photos/software-covers/avif/1440p/@(cover.Id).avif 2x, @(Assets.BaseUrl)/assets/photos/software-covers/avif/4k/@(cover.Id).avif 3x" type="image/avif">
                                        <source srcset="@(Assets.BaseUrl)/assets/photos/software-covers/heif/hd/@(cover.Id).heic, @(Assets.BaseUrl)/assets/photos/software-covers/heif/1440p/@(cover.Id).heic 2x, @(Assets.BaseUrl)/assets/photos/software-covers/heif/4k/@(cover.Id).heic 3x" type="image/heic">
                                        <source srcset="@(Assets.BaseUrl)/assets/photos/software-covers/webp/hd/@(cover.Id).webp, @(Assets.BaseUrl)/assets/photos/software-covers/webp/1440p/@(cover.Id).webp 2x, @(Assets.BaseUrl)/assets/photos/software-covers/webp/4k/@(cover.Id).webp 3x" type="image/webp">
                                        <source srcset="@(Assets.BaseUrl)/assets/photos/software-covers/jp2k/hd/@(cover.Id).jp2, @(Assets.BaseUrl)/assets/photos/software-covers/jp2k/1440p/@(cover.Id).jp2 2x, @(Assets.BaseUrl)/assets/photos/software-covers/jp2k/4k/@(cover.Id).jp2 3x" type="image/jp2">
                                        <img alt="@(cover.TypeName ?? cover.Caption)"
                                             src="@(Assets.BaseUrl)/assets/photos/software-covers/jpeg/hd/@(cover.Id).jpg"
                                             srcset="@(Assets.BaseUrl)/assets/photos/software-covers/jpeg/hd/@(cover.Id).jpg, @(Assets.BaseUrl)/assets/photos/software-covers/jpeg/1440p/@(cover.Id).jpg 2x, @(Assets.BaseUrl)/assets/photos/software-covers/jpeg/4k/@(cover.Id).jpg 3x"
                                             style="width: 100%; max-height: 250px; object-fit: contain; border-radius: 4px;"/>
                                    </picture>
                                    @if(!string.IsNullOrEmpty(cover.Caption))
                                    {
                                        <MudText Typo="Typo.caption" Align="Align.Center" Class="mt-1">@cover.Caption</MudText>
                                    }
                                </MudCardContent>
                            </MudCard>
                        }
                    </div>
                }
            </ChildContent>
        </MudExpansionPanel>
    </MudExpansionPanels>
}

@if(_fullscreenCover is not null)
{
    <MudOverlay Visible="true" DarkBackground="true" ZIndex="9999" OnClick="() => _fullscreenCover = null">
        <div class="d-flex flex-column align-center justify-center" style="width: 100vw; height: 100vh;">
            <picture>
                <source srcset="@(Assets.BaseUrl)/assets/photos/software-covers/jxl/4k/@(_fullscreenCover.Id).jxl" type="image/jxl">
                <source srcset="@(Assets.BaseUrl)/assets/photos/software-covers/avif/4k/@(_fullscreenCover.Id).avif" type="image/avif">
                <source srcset="@(Assets.BaseUrl)/assets/photos/software-covers/heif/4k/@(_fullscreenCover.Id).heic" type="image/heic">
                <source srcset="@(Assets.BaseUrl)/assets/photos/software-covers/webp/4k/@(_fullscreenCover.Id).webp" type="image/webp">
                <source srcset="@(Assets.BaseUrl)/assets/photos/software-covers/jp2k/4k/@(_fullscreenCover.Id).jp2" type="image/jp2">
                <img alt="@(_fullscreenCover.TypeName ?? _fullscreenCover.Caption)"
                     src="@(Assets.BaseUrl)/assets/photos/software-covers/jpeg/4k/@(_fullscreenCover.Id).jpg"
                     style="max-width: 95vw; max-height: 90vh; object-fit: contain;"/>
            </picture>
            <MudText Typo="Typo.subtitle1" Style="color: white;" Class="mt-2">@_fullscreenCover.TypeName</MudText>
            @if(!string.IsNullOrEmpty(_fullscreenCover.Caption))
            {
                <MudText Typo="Typo.body2" Style="color: rgba(255,255,255,0.8);" Class="mt-1">@_fullscreenCover.Caption</MudText>
            }
        </div>
    </MudOverlay>
}

@* ── General Information Card ── *@
<MudCard Elevation="2" Class="mb-4 rounded-lg">
    <MudCardContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
            <MudIcon Icon="@Icons.Material.Filled.Info" Color="Color.Primary"/>
            <MudText Typo="Typo.h6">@L["General"]</MudText>
        </MudStack>
        <MudSimpleTable Elevation="0" Dense="true">
            <tbody>
            @if(!string.IsNullOrEmpty(_release.SoftwareVersion))
            {
                <tr>
                    <td style="width: 33%; text-align: right;"><strong>@L["Version"]</strong></td>
                    <td>@_release.SoftwareVersion</td>
                </tr>
            }
            @if(!string.IsNullOrEmpty(_release.Title) && _release.IsCompilation != true)
            {
                <tr>
                    <td style="width: 33%; text-align: right;"><strong>@L["Regional title"]</strong></td>
                    <td><em>@_release.Title</em></td>
                </tr>
            }
            @if(!string.IsNullOrEmpty(_release.Platform))
            {
                <tr>
                    <td style="width: 33%; text-align: right;"><strong>@L["Platform"]</strong></td>
                    <td>@_release.Platform</td>
                </tr>
            }
            @if(_release.Regions is not null && _release.Regions.Count > 0)
            {
                <tr>
                    <td style="width: 33%; text-align: right;"><strong>@L["Regions"]</strong></td>
                    <td>@string.Join(", ", _release.Regions.Select(r => r.RegionName))</td>
                </tr>
            }
            @if(_release.Languages is not null && _release.Languages.Count > 0)
            {
                <tr>
                    <td style="width: 33%; text-align: right;"><strong>@L["Languages"]</strong></td>
                    <td>@string.Join(", ", _release.Languages.Select(l => l.Language))</td>
                </tr>
            }
            @if(!string.IsNullOrEmpty(_release.Publisher))
            {
                <tr>
                    <td style="width: 33%; text-align: right;"><strong>@L["Publisher"]</strong></td>
                    <td>
                        @if(_release.PublisherId.HasValue)
                        {
                            <MudLink Href="@($"/company/{_release.PublisherId}")">@_release.Publisher</MudLink>
                        }
                        else
                        {
                            @_release.Publisher
                        }
                    </td>
                </tr>
            }
            @if(_release.ReleaseDate.HasValue)
            {
                <tr>
                    <td style="width: 33%; text-align: right;"><strong>@L["Release date"]</strong></td>
                    <td>@(((_release.ReleaseDatePrecision ?? 0) == 2 ? _release.ReleaseDate.Value.Year.ToString() : (_release.ReleaseDatePrecision ?? 0) == 1 ? _release.ReleaseDate.Value.ToString("MMMM yyyy") : _release.ReleaseDate.Value.DateTime.ToLongDateString()))</td>
                </tr>
            }
            </tbody>
        </MudSimpleTable>
    </MudCardContent>
</MudCard>

@* ── Included Software Card (compilations only) ── *@
@if(_release.IsCompilation == true && (_includedVersions.Count > 0 || _includedSoftware.Count > 0))
{
    <MudExpansionPanels Elevation="2" Class="mb-4 rounded-lg">
        <MudExpansionPanel>
            <TitleContent>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.LibraryBooks" Color="Color.Primary"/>
                    <MudText Typo="Typo.h6">@L["Included Software"]</MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Success">@(_includedVersions.Count + _includedSoftware.Count)</MudChip>
                </MudStack>
            </TitleContent>
            <ChildContent>
                @if(_includedVersions.Count > 0)
                {
                    <MudList T="SoftwareVersionBySoftwareReleaseDto" Dense="true">
                        @foreach(SoftwareVersionBySoftwareReleaseDto iv in _includedVersions)
                        {
                            <MudListItem T="SoftwareVersionBySoftwareReleaseDto" Icon="@Icons.Material.Filled.Apps">
                                <MudText>@iv.SoftwareName — @iv.SoftwareVersion</MudText>
                            </MudListItem>
                        }
                    </MudList>
                }
                @if(_includedSoftware.Count > 0)
                {
                    <MudList T="SoftwareBySoftwareReleaseDto" Dense="true">
                        @foreach(SoftwareBySoftwareReleaseDto sw in _includedSoftware)
                        {
                            <MudListItem T="SoftwareBySoftwareReleaseDto" Icon="@Icons.Material.Filled.Apps">
                                <MudText>@sw.SoftwareName</MudText>
                            </MudListItem>
                        }
                    </MudList>
                }
            </ChildContent>
        </MudExpansionPanel>
    </MudExpansionPanels>
}

@* ── Barcodes Card ── *@
<MudExpansionPanels Elevation="2" Class="mb-4 rounded-lg">
    <MudExpansionPanel Disabled="@(_barcodes.Count == 0)">
        <TitleContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.QrCode" Color="Color.Primary"/>
                <MudText Typo="Typo.h6">@L["Barcodes"]</MudText>
                <MudChip T="string" Size="Size.Small" Color="@(_barcodes.Count > 0 ? Color.Success : Color.Error)">@_barcodes.Count</MudChip>
            </MudStack>
        </TitleContent>
        <ChildContent>
            <MudList T="SoftwareBarcodeDto" Dense="true">
                @foreach(SoftwareBarcodeDto barcode in _barcodes)
                {
                    <MudListItem T="SoftwareBarcodeDto" Icon="@Icons.Material.Filled.QrCode">
                        @barcode.Code
                        @if(barcode.Type.HasValue)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="ml-2" Style="display: inline;">— @GetBarcodeTypeName(barcode.Type.Value)</MudText>
                        }
                    </MudListItem>
                }
            </MudList>
        </ChildContent>
    </MudExpansionPanel>
</MudExpansionPanels>

@* ── Product Codes Card ── *@
<MudExpansionPanels Elevation="2" Class="mb-4 rounded-lg">
    <MudExpansionPanel Disabled="@(_productCodes.Count == 0)">
        <TitleContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.Pin" Color="Color.Primary"/>
                <MudText Typo="Typo.h6">@L["Product codes"]</MudText>
                <MudChip T="string" Size="Size.Small" Color="@(_productCodes.Count > 0 ? Color.Success : Color.Error)">@_productCodes.Count</MudChip>
            </MudStack>
        </TitleContent>
        <ChildContent>
            <MudList T="SoftwareProductCodeDto" Dense="true">
                @foreach(SoftwareProductCodeDto productCode in _productCodes)
                {
                    <MudListItem T="SoftwareProductCodeDto" Icon="@Icons.Material.Filled.Pin">
                        @productCode.Code
                        @if(productCode.Issuer.HasValue)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="ml-2" Style="display: inline;">— @GetProductCodeIssuerName(productCode.Issuer.Value)</MudText>
                        }
                    </MudListItem>
                }
            </MudList>
        </ChildContent>
    </MudExpansionPanel>
</MudExpansionPanels>

@* ── Companies Card ── *@
<MudExpansionPanels Elevation="2" Class="mb-4 rounded-lg">
    <MudExpansionPanel Disabled="@(_aggregatedCompanies.Count == 0)">
        <TitleContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.Business" Color="Color.Primary"/>
                <MudText Typo="Typo.h6">@L["Companies"]</MudText>
                <MudChip T="string" Size="Size.Small" Color="@(_aggregatedCompanies.Count > 0 ? Color.Success : Color.Error)">@_aggregatedCompanies.Count</MudChip>
            </MudStack>
        </TitleContent>
        <ChildContent>
            <MudList T="string" Dense="true">
                @foreach((int companyId, string companyName, string role) in _aggregatedCompanies)
                {
                    <MudListItem T="string" Href="@($"/company/{companyId}")" Icon="@Icons.Material.Filled.Business">
                        @companyName
                        @if(!string.IsNullOrEmpty(role))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="ml-2" Style="display: inline;">— @role</MudText>
                        }
                    </MudListItem>
                }
            </MudList>
        </ChildContent>
    </MudExpansionPanel>
</MudExpansionPanels>

@* ── Minimum GPUs Card ── *@
<MudExpansionPanels Elevation="2" Class="mb-4 rounded-lg">
    <MudExpansionPanel Disabled="@(_minimumGpus.Count == 0)">
        <TitleContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.Tv" Color="Color.Primary"/>
                <MudText Typo="Typo.h6">@L["Minimum GPUs"]</MudText>
                <MudChip T="string" Size="Size.Small" Color="@(_minimumGpus.Count > 0 ? Color.Success : Color.Error)">@_minimumGpus.Count</MudChip>
            </MudStack>
        </TitleContent>
        <ChildContent>
            <MudList T="GpuBySoftwareReleaseDto" Dense="true">
                @foreach(GpuBySoftwareReleaseDto gpu in _minimumGpus)
                {
                    <MudListItem T="GpuBySoftwareReleaseDto" Href="@($"/gpu/{gpu.GpuId}")" Icon="@Icons.Material.Filled.Tv">
                        @gpu.Gpu
                    </MudListItem>
                }
            </MudList>
        </ChildContent>
    </MudExpansionPanel>
</MudExpansionPanels>

@* ── Recommended GPUs Card ── *@
<MudExpansionPanels Elevation="2" Class="mb-4 rounded-lg">
    <MudExpansionPanel Disabled="@(_recommendedGpus.Count == 0)">
        <TitleContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.Tv" Color="Color.Primary"/>
                <MudText Typo="Typo.h6">@L["Recommended GPUs"]</MudText>
                <MudChip T="string" Size="Size.Small" Color="@(_recommendedGpus.Count > 0 ? Color.Success : Color.Error)">@_recommendedGpus.Count</MudChip>
            </MudStack>
        </TitleContent>
        <ChildContent>
            <MudList T="GpuBySoftwareReleaseDto" Dense="true">
                @foreach(GpuBySoftwareReleaseDto gpu in _recommendedGpus)
                {
                    <MudListItem T="GpuBySoftwareReleaseDto" Href="@($"/gpu/{gpu.GpuId}")" Icon="@Icons.Material.Filled.Tv">
                        @gpu.Gpu
                    </MudListItem>
                }
            </MudList>
        </ChildContent>
    </MudExpansionPanel>
</MudExpansionPanels>

@* ── Sound Synthesizers Card ── *@
<MudExpansionPanels Elevation="2" Class="mb-4 rounded-lg">
    <MudExpansionPanel Disabled="@(_soundSynths.Count == 0)">
        <TitleContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.MusicNote" Color="Color.Primary"/>
                <MudText Typo="Typo.h6">@L["Sound synthesizers"]</MudText>
                <MudChip T="string" Size="Size.Small" Color="@(_soundSynths.Count > 0 ? Color.Success : Color.Error)">@_soundSynths.Count</MudChip>
            </MudStack>
        </TitleContent>
        <ChildContent>
            <MudList T="SoundSynthBySoftwareReleaseDto" Dense="true">
                @foreach(SoundSynthBySoftwareReleaseDto synth in _soundSynths)
                {
                    <MudListItem T="SoundSynthBySoftwareReleaseDto" Href="@($"/soundsynth/{synth.SoundSynthId}")" Icon="@Icons.Material.Filled.MusicNote">
                        @synth.SoundSynth
                    </MudListItem>
                }
            </MudList>
        </ChildContent>
    </MudExpansionPanel>
</MudExpansionPanels>

@* ── Specifications Card ── *@
@if(_releaseSpecs.Count > 0)
{
<MudCard Elevation="2" Class="mb-4 rounded-lg">
    <MudCardContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
            <MudIcon Icon="@Icons.Material.Filled.Settings" Color="Color.Primary"/>
            <MudText Typo="Typo.h6">@L["Specifications"]</MudText>
        </MudStack>
        <MudSimpleTable Elevation="0" Dense="true">
            <tbody>
            @foreach(SoftwareAttributeDto spec in _releaseSpecs)
            {
                <tr>
                    <td style="width: 33%; text-align: right;"><strong>@L[spec.Key]</strong></td>
                    <td>@spec.Value</td>
                </tr>
            }
            </tbody>
        </MudSimpleTable>
    </MudCardContent>
</MudCard>
}

@* ── Ratings Card ── *@
@if(_releaseRatings.Count > 0)
{
<MudCard Elevation="2" Class="mb-4 rounded-lg">
    <MudCardContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
            <MudIcon Icon="@Icons.Material.Filled.Star" Color="Color.Primary"/>
            <MudText Typo="Typo.h6">@L["Ratings"]</MudText>
        </MudStack>
        <div class="d-flex flex-wrap gap-2">
            @foreach(SoftwareAttributeDto rating in _releaseRatings)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning">@rating.Key: @rating.Value</MudChip>
            }
        </div>
    </MudCardContent>
</MudCard>
}
