@page "/processor/{Id:int}"
@using Marechai.ApiClient.Models
@using Marechai.Data
@using Marechai.Pages.Suggestions
@inherits OwningComponentBase<ProcessorsService>
@inject IStringLocalizer<ProcessorsService> L
@inject ProcessorPhotosService ProcessorPhotosService
@inject ApiAssetUrlProvider AssetUrls
@inject IDialogService      DialogService
@inject SuggestionsService  Suggestions

@if(!_loaded)
{
    <div class="d-flex justify-center pa-8">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large"/>
    </div>

    return;
}

@if(_processor is null)
{
    <MudAlert Severity="Severity.Warning">@L["No processors found"]</MudAlert>

    return;
}

<EntityMetaTags Title="@_processor.Name"
                Description="@string.Format(L["Seo description"], _processor.Name)"
                CanonicalPath="@($"/processor/{Id}")"
                Breadcrumbs="@(new (string, string?)[] { ("Processors", "/processors"), (_processor.Name, null) })" />

@* ── Hero Header ── *@
<MudPaper Class="pa-6 mb-6" Elevation="0" Style="background: linear-gradient(135deg, #7e57c2 0%, #42a5f5 100%); border-radius: 16px;">
    <MudStack AlignItems="AlignItems.Center" Spacing="3">
        <MudIcon Icon="@Icons.Material.Filled.Memory" Size="Size.Large" Style="color: white;"/>
        <MudText Typo="Typo.h3" Align="Align.Center" Style="color: white; font-weight: 700;">
            @if(_processor.Speed > 0)
            {
                @(_processor.GprSize > 0
                    ? string.Format(L["{0} @{1}MHz ({2} bits)"], _processor.Name, _processor.Speed, _processor.GprSize)
                    : string.Format(L["{0} @{1}MHz"], _processor.Name, _processor.Speed))
            }
            else
            {
                @_processor.Name
            }
        </MudText>
        @if(!string.IsNullOrEmpty(_processor.Company))
        {
            <MudText Typo="Typo.subtitle1" Align="Align.Center" Style="color: rgba(255,255,255,0.85);">@_processor.Company</MudText>
        }
    </MudStack>
</MudPaper>

@* ── Tabbed content (sticky frosted-glass tab bar; icon+label desktop, icon-only mobile) ── *@
<style>
    /* Rounded="true" sets overflow:hidden on .mud-tabs which breaks position:sticky on the tabbar.
       Force overflow:visible so the tabbar can stick to the page viewport. */
    .sticky-tabs.mud-tabs,
    .sticky-tabs .mud-tabs-panels {
        overflow: visible !important;
    }

    .sticky-tabs .mud-tabs-tabbar {
        position: sticky;
        /* MudAppBar (mt-16 = 64px) is fixed at top:0; offset the tabbar so it docks just below. */
        top: 64px;
        z-index: 5;
        /* Frosted-glass: white tint over a strong backdrop blur. Layered so it reads as
           "icy translucent" in both light and dark themes. */
        background-color: color-mix(in srgb, white 35%, var(--mud-palette-surface) 65%) !important;
        background-image: linear-gradient(rgba(255, 255, 255, 0.18), rgba(255, 255, 255, 0.06));
        backdrop-filter: blur(20px) saturate(180%) brightness(110%);
        -webkit-backdrop-filter: blur(20px) saturate(180%) brightness(110%);
        border-radius: 12px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.18);
        /* Visual breathing room between tab bar and content below. */
        margin-bottom: 20px;
    }

    /* MudTabPanel renders text directly next to the icon component, with no .mud-typography wrapper.
       Use font-size:0 to collapse the bare text node on mobile, then null the icon-text margin so
       the icon stays centered. SVG icons are unaffected by font-size. */
    @@media (max-width: 599.98px) {
        .sticky-tabs .mud-tab {
            font-size: 0 !important;
            min-width: 56px !important;
            padding: 6px 10px !important;
        }
        .sticky-tabs .mud-tab .mud-tab-icon-text {
            margin-right: 0 !important;
            margin-inline-end: 0 !important;
        }
    }
</style>

<MudTabs Rounded="true"
         ApplyEffectsToContainer="true"
         KeepPanelsAlive="true"
         Centered="true"
         Color="Color.Primary"
         SliderColor="Color.Primary"
         Class="sticky-tabs mb-4"
         ActivePanelIndex="@_activeTabIndex"
         ActivePanelIndexChanged="OnTabChanged">

@* ── SPECIFICATIONS TAB ── *@
<MudTabPanel Text="@L["Specifications"]" Icon="@Icons.Material.Filled.Tune" ToolTip="@L["Specifications"]">

@* ── General Information Card ── *@
<MudCard Elevation="2" Class="mb-4 rounded-lg">
    <MudCardContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.Info" Color="Color.Primary"/>
                <MudText Typo="Typo.h6">@L["Details"]</MudText>
            </MudStack>
            <AuthorizeView>
                <Authorized>
                    <MudTooltip Text="@L["Suggest changes"]">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                                       OnClick="OpenProcessorSuggestionDialogAsync"/>
                    </MudTooltip>
                </Authorized>
            </AuthorizeView>
        </MudStack>
        <MudSimpleTable Elevation="0" Dense="true">
            <tbody>
            @if(_processor.ModelCode != null && _processor.ModelCode != _processor.Name)
            {
                <tr><td style="width: 33%; text-align: right;"><strong>@L["Model"]</strong></td><td>@_processor.ModelCode</td></tr>
            }
            @if(_processor.CompanyId.HasValue)
            {
                <tr><td style="width: 33%; text-align: right;"><strong>@L["Manufacturer"]</strong></td><td><MudLink Href="@($"/company/{_processor.CompanyId}")">@_processor.Company</MudLink></td></tr>
            }
            @if(_processor.Introduced != null)
            {
                <tr><td style="width: 33%; text-align: right;"><strong>@L["Introduction date"]</strong></td><td>@($"{_processor.Introduced:yyyy}")</td></tr>
            }
            @if(_processor.InstructionSet != null)
            {
                <tr><td style="width: 33%; text-align: right;"><strong>@L["Instruction set"]</strong></td><td>@_processor.InstructionSet</td></tr>
            }
            @if(_processor.InstructionSetExtensions is { Count: > 0 })
            {
                <tr>
                    <td style="width: 33%; text-align: right;"><strong>@L["Instruction set extensions"]</strong></td>
                    <td>
                        <div class="d-flex flex-wrap gap-1">
                            @foreach(string ext in _processor.InstructionSetExtensions)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Outlined">@ext</MudChip>
                            }
                        </div>
                    </td>
                </tr>
            }
            @if(_processor.Speed > 0)
            {
                <tr><td style="width: 33%; text-align: right;"><strong>@L["Nominal speed"]</strong></td><td>@string.Format(L["{0} MHz"], _processor.Speed)</td></tr>
            }
            @if(_processor.Gprs > 0 || _processor.Fprs > 0 || _processor.SimdRegisters > 0)
            {
                <tr>
                    <td style="width: 33%; text-align: right;"><strong>@L["Registers"]</strong></td>
                    <td>
                        <MudStack Spacing="1">
                            @if(_processor.Gprs > 0)
                            {
                                <MudText Typo="Typo.body2">
                                    @if(_processor.FprSize > 0 && _processor.Fprs == 0 && _processor.SimdSize > 0 && _processor.SimdRegisters == 0)
                                    {
                                        @(string.Format(L["{0} general purpose registers of {1} bits that can be used as floating point registers of {2} bits and SIMD registers of {3} bits."], _processor.Gprs, _processor.GprSize, _processor.FprSize, _processor.SimdSize))
                                    }
                                    else if(_processor.FprSize > 0 && _processor.Fprs == 0)
                                    {
                                        @(string.Format(L["{0} general purpose registers of {1} bits that can be used as floating point registers of {2} bits."], _processor.Gprs, _processor.GprSize, _processor.FprSize))
                                    }
                                    else if(_processor.FprSize == 0 && _processor.SimdSize > 0 && _processor.SimdRegisters == 0)
                                    {
                                        @(string.Format(L["{0} general purpose registers of {1} bits that can be used as SIMD registers of {2} bits."], _processor.Gprs, _processor.GprSize, _processor.SimdSize))
                                    }
                                    else
                                    {
                                        @(string.Format(L["{0} general purpose registers of {1} bits."], _processor.Gprs, _processor.GprSize))
                                    }
                                </MudText>
                            }
                            @if(_processor.Fprs > 0)
                            {
                                <MudText Typo="Typo.body2">
                                    @if(_processor.SimdSize > 0 && _processor.SimdRegisters == 0)
                                    {
                                        @(string.Format(L["{0} floating point registers of {1} bits that can be used as SIMD registers of {2} bits."], _processor.Fprs, _processor.FprSize, _processor.SimdSize))
                                    }
                                    else
                                    {
                                        @(string.Format(L["{0} floating point registers of {1} bits."], _processor.Fprs, _processor.FprSize))
                                    }
                                </MudText>
                            }
                            @if(_processor.SimdRegisters > 0)
                            {
                                <MudText Typo="Typo.body2">
                                    <MudTooltip Text="@L["Single instruction, multiple data"]">
                                        @string.Format(L["{0} SIMD registers of {1} bits."], _processor.SimdRegisters, _processor.SimdSize)
                                    </MudTooltip>
                                </MudText>
                            }
                        </MudStack>
                    </td>
                </tr>
            }
            @if(_processor.Cores > 1)
            {
                <tr><td style="width: 33%; text-align: right;"><strong>@L["Multi-core"]</strong></td><td>@string.Format(L["{0} cores."], _processor.Cores)</td></tr>
            }
            @if(_processor.ThreadsPerCore > 1)
            {
                <tr>
                    <td style="width: 33%; text-align: right;"><strong><MudTooltip Text="@L["Simultaneous multithreading"]">SMT</MudTooltip></strong></td>
                    <td>@string.Format(_processor.Cores > 1 ? L["{0} threads per core."] : L["{0} threads."], _processor.ThreadsPerCore)</td>
                </tr>
            }
            @if(_processor.DataBus > 0 || _processor.AddressBus > 0)
            {
                <tr>
                    <td style="width: 33%; text-align: right;"><strong>@L["Bus"]</strong></td>
                    <td>
                        <MudStack Spacing="0">
                            @if(_processor.DataBus > 0)
                            {
                                <MudText Typo="Typo.body2">@string.Format(L["{0}-bit data."], _processor.DataBus)</MudText>
                            }
                            @if(_processor.AddressBus > 0)
                            {
                                <MudText Typo="Typo.body2">@string.Format(L["{0}-bit address."], _processor.AddressBus)</MudText>
                            }
                        </MudStack>
                    </td>
                </tr>
            }
            @if(_processor.L1Instruction > 0 || _processor.L1Data > 0 || _processor.L2 > 0 || _processor.L3 > 0)
            {
                <tr>
                    <td style="width: 33%; text-align: right;"><strong>@L["Cache"]</strong></td>
                    <td>
                        <MudStack Spacing="0">
                            @if(_processor.L1Instruction > 0)
                            {
                                <MudText Typo="Typo.body2">@string.Format(_processor.L1Data < 0 ? L["{0}KiB combined instruction-data L1"] : L["{0}KiB instruction L1"], _processor.L1Instruction)</MudText>
                            }
                            @if(_processor.L1Data > 0)
                            {
                                <MudText Typo="Typo.body2">@string.Format(L["{0}KiB data L1"], _processor.L1Data)</MudText>
                            }
                            @if(_processor.L2 > 0)
                            {
                                <MudText Typo="Typo.body2">@string.Format(L["{0}KiB L2"], _processor.L2)</MudText>
                            }
                            @if(_processor.L3 > 0)
                            {
                                <MudText Typo="Typo.body2">@string.Format(L["{0}KiB L3"], _processor.L3)</MudText>
                            }
                        </MudStack>
                    </td>
                </tr>
            }
            @if(_processor.Package != null)
            {
                <tr><td style="width: 33%; text-align: right;"><strong>@L["Package"]</strong></td><td>@_processor.Package</td></tr>
            }
            @if(_processor.Process != null || _processor.ProcessNm > 0)
            {
                <tr>
                    <td style="width: 33%; text-align: right;"><strong>@L["Manufacturing process"]</strong></td>
                    <td>
                        @if(_processor.Process != null && _processor.ProcessNm > 0)
                        { @(_processor.ProcessNm > 100 ? string.Format(L["{0} @{1}µm"], _processor.Process, _processor.ProcessNm / 100) : string.Format(L["{0} @{1}nm"], _processor.Process, _processor.ProcessNm)) }
                        else if(_processor.ProcessNm > 0)
                        { @(_processor.ProcessNm > 100 ? string.Format(L["{0}µm"], _processor.ProcessNm / 100) : string.Format(L["{0}nm"], _processor.ProcessNm)) }
                        else
                        { @_processor.Process }
                    </td>
                </tr>
            }
            @if(_processor.DieSize > 0)
            {
                <tr><td style="width: 33%; text-align: right;"><strong>@L["Die size"]</strong></td><td>@string.Format(L["{0} mm²"], _processor.DieSize)</td></tr>
            }
            @if(_processor.Transistors > 0)
            {
                <tr><td style="width: 33%; text-align: right;"><strong>@L["Transistors"]</strong></td><td>@_processor.Transistors</td></tr>
            }
            </tbody>
        </MudSimpleTable>
    </MudCardContent>
</MudCard>

@* ── Description Card ── *@
@if(!_hasAnyDescription)
{
    <MudCard Elevation="2" Class="mb-4 rounded-lg">
        <MudCardContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Description" Color="Color.Primary"/>
                    <MudText Typo="Typo.h6">@L["Description"]</MudText>
                </MudStack>
            </MudStack>
            <AuthorizeView>
                <Authorized>
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-2">
                        @L["We do not have a description for this processor, you could collaborate by suggesting one"]
                    </MudAlert>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.AddComment"
                               OnClick="OpenDescriptionPickerAsync">
                        @L["Suggest description"]
                    </MudButton>
                </Authorized>
                <NotAuthorized>
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                        @L["We do not have a description for this processor, you could collaborate by suggesting one"]
                    </MudAlert>
                </NotAuthorized>
            </AuthorizeView>
        </MudCardContent>
    </MudCard>
}
else
{
    @if(_descriptionFellBack)
    {
        <AuthorizeView>
            <Authorized>
                <MudAlert Severity="Severity.Info"
                          Variant="Variant.Outlined"
                          Class="mb-3">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="3" Style="width: 100%;">
                        <MudText>
                            @L["We do not have a description in your language, you could collaborate by translating the English description we show below"]
                        </MudText>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Translate"
                                   OnClick="OpenDescriptionPickerAsync">
                            @L["Suggest translation"]
                        </MudButton>
                    </MudStack>
                </MudAlert>
            </Authorized>
        </AuthorizeView>
    }

    <MudCard Elevation="2" Class="mb-4 rounded-lg">
        <MudCardContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Description" Color="Color.Primary"/>
                    <MudText Typo="Typo.h6">@L["Description"]</MudText>
                </MudStack>
                <AuthorizeView>
                    <Authorized>
                        <MudTooltip Text="@L["Suggest changes"]">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Size="Size.Small"
                                           Color="Color.Secondary"
                                           OnClick="OpenDescriptionPickerAsync"
                                           aria-label="@L["Suggest changes"]"/>
                        </MudTooltip>
                    </Authorized>
                </AuthorizeView>
            </MudStack>
            <div style="color: var(--mud-palette-text-primary); overflow-wrap: break-word;">
                <style>
                    .processor-description { line-height: 1.7; color: inherit; }
                    .processor-description h1 { font-size: 1.75rem; margin: 2rem 0 1rem; line-height: 1.3; }
                    .processor-description h2 { font-size: 1.5rem; margin: 2rem 0 1rem; line-height: 1.3; }
                    .processor-description h3 { font-size: 1.25rem; margin: 1.5rem 0 0.75rem; line-height: 1.3; }
                    .processor-description p { margin: 1rem 0; line-height: 1.8; }
                    .processor-description ul, .processor-description ol { margin: 1rem 0; padding-left: 1.75rem; }
                    .processor-description li { margin: 0.6rem 0; line-height: 1.7; }
                    .processor-description pre { background: var(--mud-palette-surface); padding: 1rem; overflow-x: auto; }
                    .processor-description code { background: var(--mud-palette-surface); padding: 0.125rem 0.25rem; }
                    .processor-description blockquote { border-left: 4px solid var(--mud-palette-primary); padding: 0.5rem 1rem; }
                    .processor-description table { border-collapse: collapse; width: 100%; }
                    .processor-description th, .processor-description td { border: 1px solid var(--mud-palette-lines-default); padding: 0.5rem; }
                </style>
                <div class="processor-description" style="padding: 8px;">
                    @((MarkupString)_description)
                </div>
            </div>
        </MudCardContent>
    </MudCard>
}

</MudTabPanel>

@* ── MACHINES TAB (only when at least one of Computers/Consoles/Smartphones has entries) ── *@
@if(_computers.Count > 0 || _consoles.Count > 0 || _smartphones.Count > 0 || _tablets.Count > 0 || _pdas.Count > 0)
{
<MudTabPanel Text="@L["Machines"]" Icon="@Icons.Material.Filled.Devices" ToolTip="@L["Machines"]">

@* ── Computers Card ── *@
@if(_computers.Count > 0)
{
<MudExpansionPanels Elevation="2" Class="mb-4 rounded-lg">
    <MudExpansionPanel>
        <TitleContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.Computer" Color="Color.Primary"/>
                <MudText Typo="Typo.h6">@L["Computers"]</MudText>
                <MudChip T="string" Size="Size.Small" Color="@(_computers.Count > 0 ? Color.Success : Color.Error)">@_computers.Count</MudChip>
            </MudStack>
        </TitleContent>
        <ChildContent>
            <MudList T="MachineDto" Dense="true">
                @foreach(MachineDto computer in _computers)
                {
                    <MudListItem T="MachineDto" Href="@($"/machine/{computer.Id}")" Icon="@Icons.Material.Filled.Computer">
                        @computer.Company @computer.Name
                    </MudListItem>
                }
            </MudList>
        </ChildContent>
    </MudExpansionPanel>
</MudExpansionPanels>
}

@* ── Consoles Card ── *@
@if(_consoles.Count > 0)
{
<MudExpansionPanels Elevation="2" Class="mb-4 rounded-lg">
    <MudExpansionPanel>
        <TitleContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.SportsEsports" Color="Color.Primary"/>
                <MudText Typo="Typo.h6">@L["Consoles"]</MudText>
                <MudChip T="string" Size="Size.Small" Color="@(_consoles.Count > 0 ? Color.Success : Color.Error)">@_consoles.Count</MudChip>
            </MudStack>
        </TitleContent>
        <ChildContent>
            <MudList T="MachineDto" Dense="true">
                @foreach(MachineDto console in _consoles)
                {
                    <MudListItem T="MachineDto" Href="@($"/machine/{console.Id}")" Icon="@Icons.Material.Filled.SportsEsports">
                        @console.Company @console.Name
                    </MudListItem>
                }
            </MudList>
        </ChildContent>
    </MudExpansionPanel>
</MudExpansionPanels>
}

@* ── Smartphones Card ── *@
@if(_smartphones.Count > 0)
{
<MudExpansionPanels Elevation="2" Class="mb-4 rounded-lg">
    <MudExpansionPanel>
        <TitleContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.Smartphone" Color="Color.Primary"/>
                <MudText Typo="Typo.h6">@L["Smartphones"]</MudText>
                <MudChip T="string" Size="Size.Small" Color="@(_smartphones.Count > 0 ? Color.Success : Color.Error)">@_smartphones.Count</MudChip>
            </MudStack>
        </TitleContent>
        <ChildContent>
            <MudList T="MachineDto" Dense="true">
                @foreach(MachineDto smartphone in _smartphones)
