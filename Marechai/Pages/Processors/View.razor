                    </MudListItem>
                }
            </MudList>
        </ChildContent>
    </MudExpansionPanel>
</MudExpansionPanels>
}

</MudTabPanel>
}

@* ── MEDIA TAB ── *@
<MudTabPanel Text="@L["Media tab"]" Icon="@Icons.Material.Filled.PhotoLibrary" ToolTip="@L["Media tab"]">

@* ── Photos Card ── *@
@if(_photos.Count > 0)
{
    <MudCard Elevation="2" Class="mb-4 rounded-lg">
        <MudCardContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.PhotoLibrary" Color="Color.Primary"/>
                    <MudText Typo="Typo.h6">@L["Photos"]</MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Secondary">@_photos.Count</MudChip>
                </MudStack>
                <AuthorizeView>
                    <Authorized>
                        <MudTooltip Text="@L["Suggest more processor photos"]">
                            <MudIconButton Icon="@Icons.Material.Filled.AddPhotoAlternate"
                                           Color="Color.Primary" Size="Size.Small"
                                           OnClick="OpenSuggestPhotosDialog"/>
                        </MudTooltip>
                    </Authorized>
                </AuthorizeView>
            </MudStack>

            <MudGrid>
                @foreach(Guid photo in _photos)
                {
                    <MudItem xs="6" sm="4" md="3">
                        <MudCard Elevation="1" Class="rounded-lg">
                            <MudCardContent Class="pa-2 d-flex justify-center"
                                          Style="cursor: pointer;"
                                          @onclick="() => _lightbox.Show(_photos, photo)">

                                <picture>
                                    <source srcset="@(AssetUrls.BaseUrl)/assets/photos/processors/thumbs/avif/4k/@(photo).avif" type="image/avif">
                                    <source srcset="@(AssetUrls.BaseUrl)/assets/photos/processors/thumbs/webp/4k/@(photo).webp" type="image/webp">
                                    <img alt="" src="@(AssetUrls.BaseUrl)/assets/photos/processors/thumbs/jpeg/4k/@(photo).jpg"
                                         srcset="@(AssetUrls.BaseUrl)/assets/photos/processors/thumbs/jpeg/4k/@(photo).jpg"
                                         style="max-height: 256px; max-width: 100%; border-radius: 8px;"/>
                                </picture>
                            </MudCardContent>

                            <MudCardActions Class="justify-center">
                                <MudButton Href="@($"/processors/photo/{photo}")" Target="_blank"
                                         Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                                         StartIcon="@Icons.Material.Filled.ZoomIn">@L["Details"]</MudButton>
                            </MudCardActions>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
        </MudCardContent>
    </MudCard>
}
else
{
    @* No photos yet — show empty-state hint with an AuthorizeView-gated upload button.
       NO MudCard wrapper per the design: the absence-of-photos message is intentionally
       slim so it doesn't compete visually with the populated cards on other processors. *@
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="mb-4 pa-3"
              Style="background: var(--mud-palette-background-grey); border-radius: 8px;">
        <MudIcon Icon="@Icons.Material.Filled.PhotoLibrary" Color="Color.Default"/>
        <MudText Typo="Typo.body1" Style="flex: 1;">@L["No photos for this processor yet — help us by uploading some."]</MudText>
        <AuthorizeView>
            <Authorized>
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.AddPhotoAlternate"
                           OnClick="OpenSuggestPhotosDialog">
                    @L["Suggest processor photos"]
                </MudButton>
            </Authorized>
        </AuthorizeView>
    </MudStack>
}

@* ── Videos Card ──
   When videos exist, render the existing iframe grid AND a `+` icon button in the title
   row for authenticated users to suggest a new YouTube video. When no videos exist, the
   card is HIDDEN ENTIRELY from anonymous visitors (per user spec — keeps the public page
   minimal); authenticated visitors see a slim empty-state hint with a Suggest button.
   Add-only convention: collaborators can ONLY add videos, never edit/remove existing
   ones — the icon is `+` (AddCircle), NOT pencil. *@
@if(_videos is { Count: > 0 })
{
    <MudCard Elevation="2" Class="mb-4 rounded-lg">
        <MudCardContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.VideoLibrary" Color="Color.Primary"/>
                    <MudText Typo="Typo.h6">@L["Videos"]</MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Secondary">@_videos.Count</MudChip>
                </MudStack>
                <AuthorizeView>
                    <Authorized>
                        <MudTooltip Text="@L["Suggest more videos"]">
                            <MudIconButton Icon="@Icons.Material.Filled.AddCircle"
                                           Color="Color.Primary" Size="Size.Small"
                                           OnClick="OpenSuggestVideoDialog"/>
                        </MudTooltip>
                    </Authorized>
                </AuthorizeView>
            </MudStack>
            <MudGrid Spacing="3">
                @foreach(ProcessorVideoDto video in _videos)
                {
                    <MudItem xs="12" sm="6">
                        <MudCard Elevation="1" Class="rounded-lg">
                            @if(string.Equals(video.Provider, "YouTube", StringComparison.OrdinalIgnoreCase))
                            {
                                <div style="position: relative; width: 100%; padding-bottom: 56.25%; border-radius: 8px 8px 0 0; overflow: hidden;">
                                    <iframe src="@($"https://www.youtube-nocookie.com/embed/{video.VideoId}")"
                                            style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: 0;"
                                            title="@(video.Title ?? "Video")"
                                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                            allowfullscreen
                                            loading="lazy"
                                            referrerpolicy="no-referrer-when-downgrade"></iframe>
                                </div>
                            }
                            @if(!string.IsNullOrWhiteSpace(video.Title))
                            {
                                <MudCardContent>
                                    <MudText Typo="Typo.body2">@video.Title</MudText>
                                </MudCardContent>
                            }
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
        </MudCardContent>
    </MudCard>
}
else
{
    <AuthorizeView>
        <Authorized>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="mb-4 pa-3"
                      Style="background: var(--mud-palette-background-grey); border-radius: 8px;">
                <MudIcon Icon="@Icons.Material.Filled.VideoLibrary" Color="Color.Default"/>
                <MudText Typo="Typo.body1" Style="flex: 1;">@L["We have no videos available about this processor."]</MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.AddCircle"
                           OnClick="OpenSuggestVideoDialog">
                    @L["Suggest a YouTube video"]
                </MudButton>
            </MudStack>
        </Authorized>
    </AuthorizeView>
}

</MudTabPanel>

</MudTabs>

<PhotoLightbox @ref="_lightbox" BaseUrl="@AssetUrls.BaseUrl" Category="processors"/>
