                    <MudListItem T="MachineDto" Href="@($"/machine/{smartphone.Id}")" Icon="@Icons.Material.Filled.Smartphone">
                        @smartphone.Company @smartphone.Name
                    </MudListItem>
                }
            </MudList>
        </ChildContent>
    </MudExpansionPanel>
</MudExpansionPanels>
}

@* ── Tablets Card ── *@
@if(_tablets.Count > 0)
{
<MudExpansionPanels Elevation="2" Class="mb-4 rounded-lg">
    <MudExpansionPanel>
        <TitleContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.Tablet" Color="Color.Primary"/>
                <MudText Typo="Typo.h6">@L["Tablets"]</MudText>
                <MudChip T="string" Size="Size.Small" Color="@(_tablets.Count > 0 ? Color.Success : Color.Error)">@_tablets.Count</MudChip>
