@page "/processors"
@using Marechai.ApiClient.Models
@inherits OwningComponentBase<ProcessorsService>
@inject IStringLocalizer<ProcessorsService> L
@inject IDialogService                       DialogService

@if(!_initialized)
{
    <div class="d-flex justify-center pa-8">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large"/>
    </div>

    return;
}

@* ── Hero Header ── *@
<MudPaper Class="pa-6 mb-6" Elevation="0" Style="background: linear-gradient(135deg, #7e57c2 0%, #42a5f5 100%); border-radius: 16px;">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
            <MudIcon Icon="@Icons.Material.Filled.Memory" Size="Size.Large" Style="color: white;"/>
            <MudText Typo="Typo.h4" Style="color: white;">@L["Processors"]</MudText>
        </MudStack>
        <AuthorizeView>
            <Authorized>
                <MudTooltip Text="@L["Suggest a new processor to be added to the catalogue."]">
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Inherit"
                               StartIcon="@Icons.Material.Filled.AddCircle"
                               OnClick="OpenSuggestNewProcessorDialog"
                               Style="color: white; border-color: rgba(255,255,255,0.7);">
                        @L["Suggest new processor"]
                    </MudButton>
                </MudTooltip>
            </Authorized>
        </AuthorizeView>
    </MudStack>
    <MudChip T="string" Color="Color.Dark" Variant="Variant.Filled" Class="mt-2" Style="color: white; white-space: normal; height: auto; overflow: visible; text-overflow: unset; padding: 8px 16px;">@string.Format(L["{0} processors found in the database."], _total)</MudChip>
</MudPaper>

@if(_total > 0)
{
    <div id="@_scrollerId" style="height: 70vh; overflow-y: auto;">
        <Virtualize Items="_processors" Context="processor" ItemSize="88">
            @{
                string displayName = processor.Name ?? string.Empty;

                if(processor.Speed > 0)
                {
                    displayName = processor.GprSize > 0
                                      ? string.Format(L["{0} @{1}MHz ({2} bits)"], processor.Name, processor.Speed,
                                                      processor.GprSize)
                                      : string.Format(L["{0} @{1}MHz"], processor.Name, processor.Speed);
                }
            }
            <a href="/processor/@processor.Id" style="text-decoration: none; color: inherit;">
                <MudCard Elevation="1" Class="mb-2 rounded-lg" Style="cursor: pointer;">
                    <MudCardContent>
                        <div class="d-flex align-center gap-3">
                            <MudIcon Icon="@Icons.Material.Filled.DeveloperBoard" Color="Color.Primary"/>
                            <div>
                                <MudText Typo="Typo.body1" Style="font-weight: 500;">@displayName</MudText>
                                @if(!string.IsNullOrEmpty(processor.Company))
                                {
                                    <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary);">@processor.Company</MudText>
                                }
                            </div>
                        </div>
                    </MudCardContent>
                </MudCard>
            </a>
        </Virtualize>
        <div id="@_sentinelId" style="height: 1px;"></div>
        @if(_loadingMore)
        {
            <div class="d-flex justify-center pa-3">
                <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true"/>
            </div>
        }
    </div>
}
else
{
    <MudAlert Severity="Severity.Info">@L["No processors found"]</MudAlert>
}
