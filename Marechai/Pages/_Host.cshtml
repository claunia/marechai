@namespace Marechai.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
    <title>Marechai</title>
    <base href="~/"/>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet"/>
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet"/>
    <link href="_content/PSC.Blazor.Components.MarkdownEditor/css/easymde.min.css" rel="stylesheet"/>
    <link href="_content/PSC.Blazor.Components.MarkdownEditor/css/markdowneditor.css" rel="stylesheet"/>
    <link href="css/site.css" rel="stylesheet"/>
    <script src="js/ga.js"></script>
    <!-- Privacy-friendly analytics by Plausible -->
    <script async src="/js/pa.js"></script>
    <script>
      window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
      plausible.init({endpoint: "/api/event"})
    </script>
</head>
<body>
<app>
    <component render-mode="ServerPrerendered" type="typeof(App)"/>
</app>
<div id="blazor-error-ui">
    <environment include="Staging,Production">
        An error has occurred. This application may no longer respond until reloaded.
    </environment>
    <environment include="Development">
        An unhandled exception has occurred. See browser dev tools for details.
    </environment>
    <a class="reload" href="">Reload</a>
    <a class="dismiss">🗙</a>
</div>
<script src="_framework/blazor.server.js"></script>
<script src="_content/MudBlazor/MudBlazor.min.js"></script>
<script src="_content/PSC.Blazor.Components.MarkdownEditor/js/easymde.min.js"></script>
<script src="_content/PSC.Blazor.Components.MarkdownEditor/js/markdownEditor.js"></script>
<script src="js/easymde-helper.js"></script>
<script src="js/download.js"></script>
<script src="js/theme-fonts.js"></script>
<script src="js/infinite-scroll.js"></script>
<script src="js/download-blob.js"></script>
<script src="js/pending-cover.js"></script>
<script src="js/gpu-photo-upload.js"></script>
<script src="js/processor-photo-upload.js"></script>
<script src="js/sound-synth-photo-upload.js"></script>
</body>
</html>