@page "/soundsynth/{Id:int}"
@using Marechai.ApiClient.Models
@using Marechai.Data
@using Humanizer
@using Marechai.Pages.Suggestions
@inherits OwningComponentBase<SoundSynthsService>
@inject IStringLocalizer<SoundSynthsService> L
@inject SoundSynthPhotosService SoundSynthPhotosService
@inject ApiAssetUrlProvider AssetUrls
@inject IDialogService DialogService
@inject SuggestionsService Suggestions

@if(!_loaded)
{
    <div class="d-flex justify-center pa-8">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large"/>
    </div>

    return;
}

@if(_synth is null)
{
    <MudAlert Severity="Severity.Warning">@L["No sound synthesizers found"]</MudAlert>

    return;
}

@* ── Hero Header ── *@
<MudPaper Class="pa-6 mb-6" Elevation="0" Style="background: linear-gradient(135deg, #7e57c2 0%, #42a5f5 100%); border-radius: 16px;">
    <MudStack AlignItems="AlignItems.Center" Spacing="3">
        <MudIcon Icon="@Icons.Material.Filled.MusicNote" Size="Size.Large" Style="color: white;"/>
        <MudText Typo="Typo.h3" Align="Align.Center" Style="color: white; font-weight: 700;">@_displayName</MudText>
        @if(!string.IsNullOrEmpty(_synth.Company))
        {
            <MudText Typo="Typo.subtitle1" Align="Align.Center" Style="color: rgba(255,255,255,0.85);">@_synth.Company</MudText>
        }
    </MudStack>
</MudPaper>

@* ── Tabbed content (sticky frosted-glass tab bar; icon+label desktop, icon-only mobile) ── *@
<style>
    /* Rounded="true" sets overflow:hidden on .mud-tabs which breaks position:sticky on the tabbar.
       Force overflow:visible so the tabbar can stick to the page viewport. */
    .sticky-tabs.mud-tabs,
    .sticky-tabs .mud-tabs-panels {
        overflow: visible !important;
    }

    .sticky-tabs .mud-tabs-tabbar {
        position: sticky;
        /* MudAppBar (mt-16 = 64px) is fixed at top:0; offset the tabbar so it docks just below. */
        top: 64px;
        z-index: 5;
        /* Frosted-glass: white tint over a strong backdrop blur. Layered so it reads as
           "icy translucent" in both light and dark themes. */
        background-color: color-mix(in srgb, white 35%, var(--mud-palette-surface) 65%) !important;
        background-image: linear-gradient(rgba(255, 255, 255, 0.18), rgba(255, 255, 255, 0.06));
        backdrop-filter: blur(20px) saturate(180%) brightness(110%);
        -webkit-backdrop-filter: blur(20px) saturate(180%) brightness(110%);
        border-radius: 12px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.18);
        /* Visual breathing room between tab bar and content below. */
        margin-bottom: 20px;
    }

    /* MudTabPanel renders text directly next to the icon component, with no .mud-typography wrapper.
       Use font-size:0 to collapse the bare text node on mobile, then null the icon-text margin so
       the icon stays centered. SVG icons are unaffected by font-size. */
    @@media (max-width: 599.98px) {
        .sticky-tabs .mud-tab {
            font-size: 0 !important;
            min-width: 56px !important;
            padding: 6px 10px !important;
        }
        .sticky-tabs .mud-tab .mud-tab-icon-text {
            margin-right: 0 !important;
            margin-inline-end: 0 !important;
        }
    }
</style>

@* Sentinel rows (currently only DB_SOFTWARE) have no specs/machines/media,
   so skip the entire tab block and render the description card alone. *@
@if(!_isSentinel)
{
<MudTabs Rounded="true"
         ApplyEffectsToContainer="true"
         KeepPanelsAlive="true"
         Centered="true"
         Color="Color.Primary"
         SliderColor="Color.Primary"
         Class="sticky-tabs mb-4"
         ActivePanelIndex="@_activeTabIndex"
         ActivePanelIndexChanged="OnTabChanged">

@* ── SPECIFICATIONS TAB ── *@
<MudTabPanel Text="@L["Specifications"]" Icon="@Icons.Material.Filled.Tune" ToolTip="@L["Specifications"]">

@* ── General Information Card ── *@
<MudCard Elevation="2" Class="mb-4 rounded-lg">
    <MudCardContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.Info" Color="Color.Primary"/>
                <MudText Typo="Typo.h6">@L["Details"]</MudText>
            </MudStack>
            <AuthorizeView>
                <Authorized>
                    <MudTooltip Text="@L["Suggest changes"]">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Size="Size.Small"
                                       Color="Color.Secondary"
                                       OnClick="OpenSoundSynthSuggestionDialogAsync"
                                       aria-label="@L["Suggest changes"]"/>
                    </MudTooltip>
                </Authorized>
            </AuthorizeView>
        </MudStack>
        <MudSimpleTable Elevation="0" Dense="true">
            <tbody>
            @if(_synth.ModelCode != null && _synth.ModelCode != _synth.Name)
            {
                <tr><td style="width: 33%; text-align: right;"><strong>@L["Model"]</strong></td><td>@_synth.ModelCode</td></tr>
            }
            @if(_synth.CompanyId.HasValue)
            {
                <tr><td style="width: 33%; text-align: right;"><strong>@L["Manufacturer"]</strong></td><td><MudLink Href="@($"/company/{_synth.CompanyId}")">@_synth.Company</MudLink></td></tr>
            }
            @if(_synth.Introduced != null)
            {
                <tr><td style="width: 33%; text-align: right;"><strong>@L["Introduction date"]</strong></td><td>@($"{_synth.Introduced:yyyy}")</td></tr>
            }
            @if(_synth.Voices != null || _synth.SquareWave != null || _synth.WhiteNoise != null)
            {
                <tr>
                    <td style="width: 33%; text-align: right;"><strong>@L["Generators"]</strong></td>
                    <td>
                        <MudStack Spacing="0">
                            @if(_synth.Voices != null) { <MudText Typo="Typo.body2">@string.Format(L["{0} voices"], _synth.Voices)</MudText> }
                            @if(_synth.SquareWave != null) { <MudText Typo="Typo.body2">@string.Format(L["{0} square wave"], _synth.SquareWave)</MudText> }
                            @if(_synth.WhiteNoise != null) { <MudText Typo="Typo.body2">@string.Format(L["{0} white noise"], _synth.WhiteNoise)</MudText> }
                        </MudStack>
                    </td>
                </tr>
            }
            @if(_synth.Depth != null || _synth.Frequency != null)
            {
                <tr>
                    <td style="width: 33%; text-align: right;"><strong>@L["Sample rate"]</strong></td>
                    <td>
                        @if(_synth.Depth != null && _synth.Frequency != null)
                        { @(_synth.Frequency > 1000 ? string.Format(L["{0} bits at {1} KHz"], _synth.Depth, _synth.Frequency / 1000) : string.Format(L["{0} bits at {1} Hz"], _synth.Depth, _synth.Frequency)) }
                        else if(_synth.Depth != null)
                        { @string.Format(L["{0} bits"], _synth.Depth) }
                        else
                        { @(_synth.Frequency > 1000 ? string.Format(L["{0} KHz"], _synth.Frequency / 1000) : string.Format(L["{0} Hz"], _synth.Frequency)) }
                    </td>
                </tr>
            }
            @if(_synth.Type != null)
            {
                <tr><td style="width: 33%; text-align: right;"><strong>@L["Synthesizer type"]</strong></td><td>@(((SoundSynthType)(_synth.Type ?? 0)).Humanize())</td></tr>
            }
            </tbody>
        </MudSimpleTable>
    </MudCardContent>
</MudCard>

@* ── Description Card ── *@
@if(!_hasAnyDescription)
{
    <MudCard Elevation="2" Class="mb-4 rounded-lg">
        <MudCardContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Description" Color="Color.Primary"/>
                    <MudText Typo="Typo.h6">@L["Description"]</MudText>
                </MudStack>
            </MudStack>
            <AuthorizeView>
                <Authorized>
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-2">
                        @L["We do not have a description for this sound synth, you could collaborate by suggesting one"]
                    </MudAlert>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.AddComment"
                               OnClick="OpenDescriptionPickerAsync">
                        @L["Suggest description"]
                    </MudButton>
                </Authorized>
                <NotAuthorized>
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                        @L["We do not have a description for this sound synth, you could collaborate by suggesting one"]
                    </MudAlert>
                </NotAuthorized>
            </AuthorizeView>
        </MudCardContent>
    </MudCard>
}
else
{
    @if(_descriptionFellBack)
    {
        <AuthorizeView>
            <Authorized>
                <MudAlert Severity="Severity.Info"
                          Variant="Variant.Outlined"
                          Class="mb-3">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="3" Style="width: 100%;">
                        <MudText>
                            @L["We do not have a description in your language, you could collaborate by translating the English description we show below"]
                        </MudText>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Translate"
                                   OnClick="OpenDescriptionPickerAsync">
                            @L["Suggest translation"]
                        </MudButton>
                    </MudStack>
                </MudAlert>
            </Authorized>
        </AuthorizeView>
    }

    <MudCard Elevation="2" Class="mb-4 rounded-lg">
        <MudCardContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Description" Color="Color.Primary"/>
                    <MudText Typo="Typo.h6">@L["Description"]</MudText>
                </MudStack>
                <AuthorizeView>
                    <Authorized>
                        <MudTooltip Text="@L["Suggest changes"]">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Size="Size.Small"
                                           Color="Color.Secondary"
                                           OnClick="OpenDescriptionPickerAsync"
                                           aria-label="@L["Suggest changes"]"/>
                        </MudTooltip>
                    </Authorized>
                </AuthorizeView>
            </MudStack>
            <div style="color: var(--mud-palette-text-primary); overflow-wrap: break-word; word-break: break-word;">
                <style>
                    .sound-synth-description {
                        color: inherit;
                        line-height: 1.7;
                    }
                    .sound-synth-description h1 {
                        font-size: 1.75rem;
                        font-weight: 700;
                        margin: 2rem 0 1rem;
                        line-height: 1.3;
                    }
                    .sound-synth-description h2 {
                        font-size: 1.5rem;
                        font-weight: 600;
                        margin: 2rem 0 1rem;
                        line-height: 1.3;
                    }
                    .sound-synth-description h3 {
                        font-size: 1.25rem;
                        font-weight: 600;
                        margin: 1.5rem 0 0.75rem;
                        line-height: 1.3;
                    }
                    .sound-synth-description h4, .sound-synth-description h5, .sound-synth-description h6 {
                        font-size: 1.1rem;
                        font-weight: 600;
                        margin: 1.25rem 0 0.6rem;
                        line-height: 1.3;
                    }
                    .sound-synth-description p {
                        margin: 1rem 0;
                        line-height: 1.8;
                    }
                    .sound-synth-description ul, .sound-synth-description ol {
                        margin: 1rem 0;
                        padding-left: 1.75rem;
                    }
                    .sound-synth-description li {
                        margin: 0.6rem 0;
                        line-height: 1.7;
                    }
                    .sound-synth-description strong {
                        font-weight: 700;
                    }
                    .sound-synth-description img {
                        max-width: 100%;
                        height: auto;
                    }
                    .sound-synth-description pre {
                        overflow-x: auto;
                        max-width: 100%;
                        background: var(--mud-palette-surface);
                        padding: 1rem;
                        border-radius: 4px;
                    }
                    .sound-synth-description code {
                        background: var(--mud-palette-surface);
                        padding: 0.125rem 0.25rem;
                        border-radius: 3px;
                        font-size: 0.875em;
                    }
                    .sound-synth-description blockquote {
                        border-left: 4px solid var(--mud-palette-primary);
                        margin: 0.75rem 0;
                        padding: 0.5rem 1rem;
                        opacity: 0.85;
                    }
                    .sound-synth-description table {
                        border-collapse: collapse;
                        margin: 0.75rem 0;
                        width: 100%;
                    }
                    .sound-synth-description th, .sound-synth-description td {
                        border: 1px solid var(--mud-palette-lines-default);
                        padding: 0.5rem;
                    }
                    .sound-synth-description hr {
                        border: none;
                        border-top: 1px solid var(--mud-palette-lines-default);
                        margin: 1rem 0;
                    }
                </style>
                <div class="sound-synth-description" style="padding: 8px;">
                    @((MarkupString)_description)
                </div>
            </div>
        </MudCardContent>
    </MudCard>
}

</MudTabPanel>

@* ── MACHINES TAB (only when at least one of Computers/Consoles/Smartphones has entries) ── *@
@if(_computers.Count > 0 || _consoles.Count > 0 || _smartphones.Count > 0)
{
<MudTabPanel Text="@L["Machines"]" Icon="@Icons.Material.Filled.Devices" ToolTip="@L["Machines"]">

@* ── Computers Card ── *@
@if(_computers.Count > 0)
{
<MudExpansionPanels Elevation="2" Class="mb-4 rounded-lg">
    <MudExpansionPanel>
        <TitleContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.Computer" Color="Color.Primary"/>
                <MudText Typo="Typo.h6">@L["Computers"]</MudText>
                <MudChip T="string" Size="Size.Small" Color="@(_computers.Count > 0 ? Color.Success : Color.Error)">@_computers.Count</MudChip>
            </MudStack>
        </TitleContent>
        <ChildContent>
            <MudList T="MachineDto" Dense="true">
                @foreach(MachineDto computer in _computers)
                {
                    <MudListItem T="MachineDto" Href="@($"/machine/{computer.Id}")" Icon="@Icons.Material.Filled.Computer">
                        @computer.Company @computer.Name
                    </MudListItem>
                }
            </MudList>
        </ChildContent>
    </MudExpansionPanel>
</MudExpansionPanels>
}

@* ── Consoles Card ── *@
@if(_consoles.Count > 0)
{
<MudExpansionPanels Elevation="2" Class="mb-4 rounded-lg">
    <MudExpansionPanel>
        <TitleContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.SportsEsports" Color="Color.Primary"/>
                <MudText Typo="Typo.h6">@L["Consoles"]</MudText>
                <MudChip T="string" Size="Size.Small" Color="@(_consoles.Count > 0 ? Color.Success : Color.Error)">@_consoles.Count</MudChip>
            </MudStack>
        </TitleContent>
        <ChildContent>
            <MudList T="MachineDto" Dense="true">
                @foreach(MachineDto console in _consoles)
                {
                    <MudListItem T="MachineDto" Href="@($"/machine/{console.Id}")" Icon="@Icons.Material.Filled.SportsEsports">
                        @console.Company @console.Name
                    </MudListItem>
                }
            </MudList>
        </ChildContent>
    </MudExpansionPanel>
</MudExpansionPanels>
}

@* ── Smartphones Card ── *@
@if(_smartphones.Count > 0)
{
<MudExpansionPanels Elevation="2" Class="mb-4 rounded-lg">
    <MudExpansionPanel>
        <TitleContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.Smartphone" Color="Color.Primary"/>
                <MudText Typo="Typo.h6">@L["Smartphones"]</MudText>
                <MudChip T="string" Size="Size.Small" Color="@(_smartphones.Count > 0 ? Color.Success : Color.Error)">@_smartphones.Count</MudChip>
            </MudStack>
        </TitleContent>
        <ChildContent>
            <MudList T="MachineDto" Dense="true">
                @foreach(MachineDto smartphone in _smartphones)
                {
                    <MudListItem T="MachineDto" Href="@($"/machine/{smartphone.Id}")" Icon="@Icons.Material.Filled.Smartphone">
                        @smartphone.Company @smartphone.Name
                    </MudListItem>
                }
            </MudList>
        </ChildContent>
    </MudExpansionPanel>
</MudExpansionPanels>
}

</MudTabPanel>
}

@* ── MEDIA TAB ── *@
<MudTabPanel Text="@L["Media tab"]" Icon="@Icons.Material.Filled.PhotoLibrary" ToolTip="@L["Media tab"]">

@* ── Photos Card ── *@
@if(_photos.Count > 0)
{
    <MudCard Elevation="2" Class="mb-4 rounded-lg">
        <MudCardContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.PhotoLibrary" Color="Color.Primary"/>
                    <MudText Typo="Typo.h6">@L["Photos"]</MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Success">@_photos.Count</MudChip>
                </MudStack>
                <AuthorizeView>
                    <Authorized>
                        <MudTooltip Text="@L["Suggest more sound synth photos"]">
                            <MudIconButton Icon="@Icons.Material.Filled.AddPhotoAlternate"
                                           Color="Color.Primary" Size="Size.Small"
                                           OnClick="OpenSuggestPhotosDialog"/>
                        </MudTooltip>
                    </Authorized>
                </AuthorizeView>
            </MudStack>
            <MudGrid>
                @foreach(Guid photo in _photos)
                {
                    <MudItem xs="6" sm="4" md="3">
                        <MudCard Elevation="1" Class="rounded-lg">
                            <MudCardContent Class="pa-2 d-flex justify-center" @onclick="() => _lightbox.Show(_photos, photo)" Style="cursor: pointer;">
                                <picture>
                                    <source srcset="@(AssetUrls.BaseUrl)/assets/photos/sound-synths/thumbs/jxl/hd/@(photo).jxl, @(AssetUrls.BaseUrl)/assets/photos/sound-synths/thumbs/jxl/1440p/@(photo).jxl 2x, @(AssetUrls.BaseUrl)/assets/photos/sound-synths/thumbs/jxl/4k/@(photo).jxl 3x" type="image/jxl">
                                    <source srcset="@(AssetUrls.BaseUrl)/assets/photos/sound-synths/thumbs/avif/hd/@(photo).avif, @(AssetUrls.BaseUrl)/assets/photos/sound-synths/thumbs/avif/1440p/@(photo).avif 2x, @(AssetUrls.BaseUrl)/assets/photos/sound-synths/thumbs/avif/4k/@(photo).avif 3x" type="image/avif">
                                    <source srcset="@(AssetUrls.BaseUrl)/assets/photos/sound-synths/thumbs/webp/hd/@(photo).webp, @(AssetUrls.BaseUrl)/assets/photos/sound-synths/thumbs/webp/1440p/@(photo).webp 2x, @(AssetUrls.BaseUrl)/assets/photos/sound-synths/thumbs/webp/4k/@(photo).webp 3x" type="image/webp">
                                    <img alt="" height="auto" src="@(AssetUrls.BaseUrl)/assets/photos/sound-synths/thumbs/jpeg/hd/@(photo).jpg"
                                         srcset="@(AssetUrls.BaseUrl)/assets/photos/sound-synths/thumbs/jpeg/hd/@(photo).jpg, @(AssetUrls.BaseUrl)/assets/photos/sound-synths/thumbs/jpeg/1440p/@(photo).jpg 2x, @(AssetUrls.BaseUrl)/assets/photos/sound-synths/thumbs/jpeg/4k/@(photo).jpg 3x"
                                         style="max-height: 256px; max-width: 100%; border-radius: 8px;" width="auto"/>
                                </picture>
                            </MudCardContent>
                            <MudCardActions Class="justify-center">
                                <MudButton Href="@($"/sound-synths/photo/{photo}")" Target="_blank" Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.ZoomIn">@L["Details"]</MudButton>
                            </MudCardActions>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
        </MudCardContent>
    </MudCard>
}
else
{
    @* No photos yet — show empty-state hint with an AuthorizeView-gated upload button.
       NO MudCard wrapper per the design: the absence-of-photos message is intentionally
       slim so it doesn't compete visually with the populated cards on other sound synths. *@
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="mb-4 pa-3"
              Style="background: var(--mud-palette-background-grey); border-radius: 8px;">
        <MudIcon Icon="@Icons.Material.Filled.PhotoLibrary" Color="Color.Default"/>
        <MudText Typo="Typo.body1" Style="flex: 1;">@L["No photos for this sound synth yet — help us by uploading some."]</MudText>
        <AuthorizeView>
            <Authorized>
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.AddPhotoAlternate"
                           OnClick="OpenSuggestPhotosDialog">
                    @L["Suggest sound synth photos"]
                </MudButton>
            </Authorized>
        </AuthorizeView>
    </MudStack>
}

@* ── Videos Card ──
   Conditional always-visible: when count > 0, the populated card renders with a `+`
   AddCircle button overlay (auth-only) so collaborators can suggest more videos. When
   empty, the card is HIDDEN from anonymous visitors (keeps the public page minimal);
   authenticated visitors see a slim empty-state hint with a Suggest button.
   Add-only convention: collaborators can ONLY add videos, never edit/remove existing
   ones — the icon is `+` (AddCircle), NOT pencil. *@
@if(_videos is { Count: > 0 })
{
    <MudCard Elevation="2" Class="mb-4 rounded-lg">
        <MudCardContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.VideoLibrary" Color="Color.Primary"/>
                    <MudText Typo="Typo.h6">@L["Videos"]</MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Secondary">@_videos.Count</MudChip>
                </MudStack>
                <AuthorizeView>
                    <Authorized>
                        <MudTooltip Text="@L["Suggest more videos"]">
                            <MudIconButton Icon="@Icons.Material.Filled.AddCircle"
                                           Color="Color.Primary" Size="Size.Small"
                                           OnClick="OpenSuggestVideoDialog"/>
                        </MudTooltip>
                    </Authorized>
                </AuthorizeView>
            </MudStack>
            <MudGrid Spacing="3">
                @foreach(SoundSynthVideoDto video in _videos)
                {
                    <MudItem xs="12" sm="6">
                        <MudCard Elevation="1" Class="rounded-lg">
                            @if(string.Equals(video.Provider, "YouTube", StringComparison.OrdinalIgnoreCase))
                            {
                                <div style="position: relative; width: 100%; padding-bottom: 56.25%; border-radius: 8px 8px 0 0; overflow: hidden;">
                                    <iframe src="@($"https://www.youtube-nocookie.com/embed/{video.VideoId}")"
                                            style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: 0;"
                                            title="@(video.Title ?? "Video")"
                                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                            allowfullscreen
                                            loading="lazy"
                                            referrerpolicy="no-referrer-when-downgrade"></iframe>
                                </div>
                            }
                            @if(!string.IsNullOrWhiteSpace(video.Title))
                            {
                                <MudCardContent>
                                    <MudText Typo="Typo.body2">@video.Title</MudText>
                                </MudCardContent>
                            }
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
        </MudCardContent>
    </MudCard>
}
else
{
    <AuthorizeView>
        <Authorized>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="mb-4 pa-3"
                      Style="background: var(--mud-palette-background-grey); border-radius: 8px;">
                <MudIcon Icon="@Icons.Material.Filled.VideoLibrary" Color="Color.Default"/>
                <MudText Typo="Typo.body1" Style="flex: 1;">@L["We have no videos available about this sound synth."]</MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.AddCircle"
                           OnClick="OpenSuggestVideoDialog">
                    @L["Suggest a YouTube video"]
                </MudButton>
            </MudStack>
        </Authorized>
    </AuthorizeView>
}

</MudTabPanel>

</MudTabs>
}
else if(!string.IsNullOrWhiteSpace(_description))
{
    @* Sentinel branch: render only the description card (markup mirrors the
       Description Card inside the Specifications tab above). *@
    <MudCard Elevation="2" Class="mb-4 rounded-lg">
        <MudCardContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                <MudIcon Icon="@Icons.Material.Filled.Description" Color="Color.Primary"/>
                <MudText Typo="Typo.h6">@L["Description"]</MudText>
            </MudStack>
            <div style="color: var(--mud-palette-text-primary); overflow-wrap: break-word; word-break: break-word;">
                @* Same .sound-synth-description rules as the Description Card
                   inside the Specifications tab — duplicated here because the
                   non-sentinel branch is hidden on /soundsynth/-2 so its
                   <style> block never enters the DOM. *@
                <style>
                    .sound-synth-description {
                        color: inherit;
                        line-height: 1.7;
                    }
                    .sound-synth-description h1 {
                        font-size: 1.75rem;
                        font-weight: 700;
                        margin: 2rem 0 1rem;
                        line-height: 1.3;
                    }
                    .sound-synth-description h2 {
                        font-size: 1.5rem;
                        font-weight: 600;
                        margin: 2rem 0 1rem;
                        line-height: 1.3;
                    }
                    .sound-synth-description h3 {
                        font-size: 1.25rem;
                        font-weight: 600;
                        margin: 1.5rem 0 0.75rem;
                        line-height: 1.3;
                    }
                    .sound-synth-description h4, .sound-synth-description h5, .sound-synth-description h6 {
                        font-size: 1.1rem;
                        font-weight: 600;
                        margin: 1.25rem 0 0.6rem;
                        line-height: 1.3;
                    }
                    .sound-synth-description p {
                        margin: 1rem 0;
                        line-height: 1.8;
                    }
                    .sound-synth-description ul, .sound-synth-description ol {
                        margin: 1rem 0;
                        padding-left: 1.75rem;
                    }
                    .sound-synth-description li {
                        margin: 0.6rem 0;
                        line-height: 1.7;
                    }
                    .sound-synth-description strong {
                        font-weight: 700;
                    }
                </style>
                <div class="sound-synth-description" style="padding: 8px;">
                    @((MarkupString)_description)
                </div>
            </div>
        </MudCardContent>
    </MudCard>
}

<PhotoLightbox @ref="_lightbox" BaseUrl="@AssetUrls.BaseUrl" Category="sound-synths"/>
