@page "/soundsynths"
@using Marechai.ApiClient.Models
@inherits OwningComponentBase<SoundSynthsService>
@inject IStringLocalizer<SoundSynthsService> L
@inject IDialogService                       DialogService

@if(!_initialized)
{
    <div class="d-flex justify-center pa-8">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large"/>
    </div>

    return;
}

<EntityMetaTags Title="@L["Sound synthesizers"]"
               Description="Browse the Marechai catalogue of sound synthesizer chips and audio processors from computing history."
               CanonicalPath="/soundsynths"
               OgType="website"
               Breadcrumbs="@(new (string, string?)[] { (L["Sound synthesizers"], null) })" />

@* ── Hero Header ── *@
<MudPaper Class="pa-6 mb-6" Elevation="0" Style="background: linear-gradient(135deg, #7e57c2 0%, #42a5f5 100%); border-radius: 16px;">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
            <MudIcon Icon="@Icons.Material.Filled.MusicNote" Size="Size.Large" Style="color: white;"/>
            <MudText Typo="Typo.h4" Style="color: white;">@L["Sound synthesizers"]</MudText>
        </MudStack>
        <AuthorizeView>
            <Authorized>
                <MudTooltip Text="@L["Suggest a new sound synthesizer to be added to the catalogue."]">
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Inherit"
                               StartIcon="@Icons.Material.Filled.AddCircle"
                               OnClick="OpenSuggestNewSoundSynthDialog"
                               Style="color: white; border-color: rgba(255,255,255,0.7);">
                        @L["Suggest new sound synthesizer"]
                    </MudButton>
                </MudTooltip>
            </Authorized>
        </AuthorizeView>
    </MudStack>
    <MudChip T="string" Color="Color.Dark" Variant="Variant.Filled" Class="mt-2" Style="color: white; white-space: normal; height: auto; overflow: visible; text-overflow: unset; padding: 8px 16px;">@string.Format(L["{0} sound synthesizers found in the database."], _total)</MudChip>
</MudPaper>

@if(_total > 0)
{
    <div id="@_scrollerId" style="height: 70vh; overflow-y: auto;">
        <Virtualize Items="_synths" Context="synth" ItemSize="88">
            @{
                bool   isSpecial   = synth.Name == "DB_SOFTWARE";
                string displayName = isSpecial ? L["Software"] : synth.Name ?? string.Empty;
            }
            <a href="/soundsynth/@synth.Id" style="text-decoration: none; color: inherit;">
                <MudCard Elevation="1" Class="mb-2 rounded-lg" Style="cursor: pointer;">
                    <MudCardContent>
                        <div class="d-flex align-center gap-3">
                            @if(isSpecial)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Code" Color="Color.Secondary"/>
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Speaker" Color="Color.Primary"/>
                            }
                            <div>
                                <MudText Typo="Typo.body1" Style="font-weight: 500;">@displayName</MudText>
                                @if(!string.IsNullOrEmpty(synth.Company))
                                {
                                    <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary);">@synth.Company</MudText>
                                }
                            </div>
                        </div>
                    </MudCardContent>
                </MudCard>
            </a>
        </Virtualize>
        <div id="@_sentinelId" style="height: 1px;"></div>
        @if(_loadingMore)
        {
            <div class="d-flex justify-center pa-3">
                <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true"/>
            </div>
        }
    </div>
}
else
{
    <MudAlert Severity="Severity.Info">@L["No sound synthesizers found"]</MudAlert>
}
