@page "/messages/{Id:long}"
@attribute [Authorize]
@using Marechai.ApiClient.Models
@using Marechai.Helpers
@using Marechai.Services
@inject MessagingService MessagingService
@inject IStringLocalizer<MessagingService> L
@inject IDialogService DialogService
@inject NavigationManager NavigationManager

<MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack"
           OnClick="@(() => NavigationManager.NavigateTo("/messages"))" Class="mb-4">@L["Back to messages"]</MudButton>

@if(_isLoading)
{
    <div class="d-flex justify-center pa-8">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large"/>
    </div>
    return;
}

@if(_conversation is null)
{
    <MudAlert Severity="Severity.Error">@(_errorMessage ?? "Conversation not found.")</MudAlert>
    return;
}

<MudPaper Class="pa-6 mb-6" Elevation="0" Style="background: linear-gradient(135deg, #0d47a1 0%, #1976d2 100%); border-radius: 16px;">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
        <MudStack Spacing="1">
            <MudText Typo="Typo.h5" Style="color: white;">@(_conversation.Subject ?? L["Conversation"])</MudText>
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                @foreach(UserSummaryDto p in (_conversation.Participants ?? new()))
                {
                    if(p.IsSystem == true)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled" Style="color: white;">@L["System"]</MudChip>
                    }
                    else if(p.IsAdmin == true)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Style="background-color: #ff9800; color: #1a1a1a;">@p.DisplayName <small>(@L["Admin"])</small></MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Style="background-color: rgba(255,255,255,0.92); color: #0d47a1;">@p.DisplayName</MudChip>
                    }
                }
            </MudStack>
        </MudStack>
        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Inherit" Style="color: white;"
                       OnClick="ConfirmDeleteConversation" aria-label="@L["Delete conversation"]"/>
    </MudStack>
</MudPaper>

@if(!string.IsNullOrWhiteSpace(_errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="() => _errorMessage = null">@_errorMessage</MudAlert>
}

@if(!string.IsNullOrWhiteSpace(_successMessage))
{
    <MudAlert Severity="Severity.Success" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="() => _successMessage = null">@_successMessage</MudAlert>
}

<MudStack Spacing="3" Class="mb-4">
    @foreach(MessageDto msg in (_conversation.Messages ?? new()))
    {
        MessageDto m = msg;
        UserSummaryDto sender = m.Sender;
        bool isMine = !string.IsNullOrEmpty(_currentUserId) && sender?.Id == _currentUserId;
        bool isSystemMsg = m.IsSystemAuthored == true;

        <MudPaper Elevation="2" Class="pa-4 rounded-lg" Style="@(isSystemMsg ? "border-left: 4px solid #d32f2f;" : isMine ? "border-left: 4px solid #1976d2;" : "")">
            <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="3">
                @if(!string.IsNullOrEmpty(sender?.AvatarUrl))
                {
                    <MudAvatar Size="Size.Medium" Image="@sender.AvatarUrl"/>
                }
                else
                {
                    <MudAvatar Size="Size.Medium" Color="Color.Default">@(sender?.DisplayName?[..1] ?? "?")</MudAvatar>
                }
                <MudStack Spacing="2" Style="flex: 1; min-width: 0;">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudText Typo="Typo.subtitle2"><strong>@(sender?.DisplayName ?? L["(deleted)"])</strong></MudText>
                            @if(isSystemMsg)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Error">@L["System"]</MudChip>
                            }
                            else if(sender?.IsAdmin == true)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Info">@L["Admin"]</MudChip>
                            }
                            <MudText Typo="Typo.caption" Color="Color.Default">@(m.CreatedOn?.LocalDateTime.ToString("yyyy-MM-dd HH:mm"))</MudText>
                        </MudStack>
                        <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" AnchorOrigin="Origin.BottomLeft">
                            @if(!isSystemMsg && !isMine)
                            {
                                <MudMenuItem Icon="@Icons.Material.Filled.Flag" OnClick="@(() => OpenReportDialog(m))">@L["Report message"]</MudMenuItem>
                            }
                            <MudMenuItem Icon="@Icons.Material.Filled.Delete" OnClick="@(() => ConfirmDeleteMessage(m))">@L["Delete message"]</MudMenuItem>
                        </MudMenu>
                    </MudStack>
                    <div class="markdown-body">
                        @SafeMarkdownRenderer.Render(m.Body)
                    </div>
                </MudStack>
            </MudStack>
        </MudPaper>
    }
</MudStack>

@if(CanReply)
{
    <MudPaper Elevation="3" Class="pa-4 rounded-lg" Style="position: sticky; bottom: 0; background: var(--mud-palette-surface);">
        <MudText Typo="Typo.subtitle2" Class="mb-2">@L["Reply"]</MudText>
        <MarkdownEditor @bind-Value="_replyBody"
                        @ref="_editor"
                        @key="_editorKey"
                        SpellChecker="false"
                        MinHeight="180px"
                        MaxHeight="320px"
                        Placeholder="@L["Message body"]"/>
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mt-2">
            <MudText Typo="Typo.caption" Color="@(ReplyLength > MaxBody ? Color.Error : Color.Default)">
                @string.Format(L["{0} / 5000 characters"], ReplyLength)
            </MudText>
            <MudButton Color="Color.Primary"
                       Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Send"
                       OnClick="SendReplyAsync"
                       Disabled="@(_isSending || string.IsNullOrWhiteSpace(_replyBody) || ReplyLength > MaxBody)">
                @if(_isSending)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2"/>
                    @L["Sending..."]
                }
                else
                {
                    @L["Send"]
                }
            </MudButton>
        </MudStack>
        @if(ReplyLength > MaxBody)
        {
            <MudAlert Severity="Severity.Warning" Class="mt-2">@L["Message exceeds 5000 character limit."]</MudAlert>
        }
    </MudPaper>
}
else if(_conversation.IsSystemThread == true)
{
    <MudAlert Severity="Severity.Info">@L["Reply to system threads is restricted to administrators."]</MudAlert>
}

@code {
    const int MaxBody = MessagingService.MaxBodyLength;

    [Parameter]
    public long Id { get; set; }

    [CascadingParameter]
    public Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState> AuthState { get; set; }

    bool             _isLoading = true;
    bool             _isSending;
    bool             _isAdmin;
    string           _errorMessage;
    string           _successMessage;
    string           _currentUserId;
    string           _replyBody;
    int              _editorKey;
    MarkdownEditor   _editor;
    ConversationDto  _conversation;

    protected override async Task OnInitializedAsync()
    {
        if(AuthState is not null)
        {
            var auth = await AuthState;
            _currentUserId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.Sid)?.Value;
            _isAdmin = auth.User.IsInRole("Admin") || auth.User.IsInRole("UberAdmin");
        }

        await LoadAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if(_conversation is not null && _conversation.Id != Id)
        {
            await LoadAsync();
        }
    }

    async Task LoadAsync()
    {
        _isLoading = true;
        StateHasChanged();

        var (conv, err) = await MessagingService.GetConversationAsync(Id);
        _conversation   = conv;
        _errorMessage   = err;
        _isLoading      = false;
        StateHasChanged();
    }

    int ReplyLength => _replyBody?.Length ?? 0;

    bool CanReply => _conversation is not null && (_conversation.IsSystemThread != true || _isAdmin);

    async Task SendReplyAsync()
    {
        if(string.IsNullOrWhiteSpace(_replyBody)) return;

        _isSending    = true;
        _errorMessage = null;
        StateHasChanged();

        var (result, _, err) = await MessagingService.ReplyAsync(Id, _replyBody);
        _isSending = false;

        switch(result)
        {
            case MessageSendResult.Sent:
                _successMessage = L["Reply sent."];
                _replyBody      = string.Empty;
                _editorKey++;
                await LoadAsync();
                break;
            case MessageSendResult.InboxFull:
                await DialogService.ShowAsync<InboxFullDialog>(
                    L["Inbox Full"],
                    new DialogParameters { ["Message"] = err ?? L["Cannot send: {0}'s inbox is full."].Value });
                break;
            case MessageSendResult.RateLimited:
                _errorMessage = err ?? L["Rate limited"];
                break;
            default:
                _errorMessage = err ?? "Failed to send reply.";
                break;
        }

        StateHasChanged();
    }

    async Task ConfirmDeleteConversation()
    {
        var parameters = new DialogParameters
        {
            ["ContentText"] = L["Are you sure you want to delete this conversation? It will only be removed from your view."].Value
        };
        var dialog = await DialogService.ShowAsync<Marechai.Pages.Admin.DeleteConfirmDialog>(L["Delete conversation"], parameters);
        var result = await dialog.Result;
        if(result.Canceled || result.Data is not bool ok || !ok) return;

        var (succeeded, err) = await MessagingService.DeleteConversationAsync(Id);
        if(succeeded)
        {
            NavigationManager.NavigateTo("/messages");
        }
        else
        {
            _errorMessage = err;
            StateHasChanged();
        }
    }

    async Task ConfirmDeleteMessage(MessageDto m)
    {
        if(m?.Id is null) return;
        var parameters = new DialogParameters
        {
            ["ContentText"] = L["Are you sure you want to delete this message? It will only be removed from your view."].Value
        };
        var dialog = await DialogService.ShowAsync<Marechai.Pages.Admin.DeleteConfirmDialog>(L["Delete message"], parameters);
        var result = await dialog.Result;
        if(result.Canceled || result.Data is not bool ok || !ok) return;

        var (succeeded, err) = await MessagingService.DeleteMessageAsync(m.Id.Value);
        if(succeeded)
        {
            _successMessage = L["Message deleted"];
            await LoadAsync();
        }
        else
        {
            _errorMessage = err;
            StateHasChanged();
        }
    }

    async Task OpenReportDialog(MessageDto m)
    {
        if(m?.Id is null) return;
        var parameters = new DialogParameters
        {
            ["MessageId"] = m.Id.Value
        };
        var dialog = await DialogService.ShowAsync<ReportMessageDialog>(L["Report message"], parameters);
        var result = await dialog.Result;
        if(!result.Canceled && result.Data is bool ok && ok)
        {
            _successMessage = L["Message reported. An administrator will review it shortly."];
            StateHasChanged();
        }
    }
}
