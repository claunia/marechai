@using System
@using System.Globalization
@using System.Linq
@using System.Text.Json
@using System.Threading
@using Marechai.ApiClient.Models
@using Marechai.Data
@using Marechai.Services
@using Marechai.Suggestions
@using Marechai.Suggestions.Metadata

@inject IStringLocalizer<MagazinesService> L
@inject ISnackbar          Snackbar
@inject MagazinesService   MagazinesService
@inject SuggestionsService SuggestionsService

@*
    Dedicated suggestion dialog for editing a Magazine. Mirrors the admin MagazineDialog editing
    surface (scalar fields + the Companies junction) but produces a Suggestion JSON payload
    instead of writing directly. Each junction add/remove operation is queued in local state
    and serialised under a unique field-name key (companies.add.<uuid> or companies.remove.<row_id>)
    so the admin can later accept or reject each operation independently in the diff panel.

    Magazines have no cover image, no Internet Archive URL, and no People junction (people
    belong to MagazineIssue, not Magazine). Otherwise the structure mirrors the Document
    equivalent.
*@

<MudDialog>
    <DialogContent>
        @if(_loading)
        {
            <MudProgressLinear Indeterminate="true"/>
        }
        else
        {
            <MudText Typo="Typo.body2" Class="mb-3">
                @L["Edit any field or junction below. Only your changes will be sent for review; an administrator can accept or reject each one independently."]
            </MudText>

            @* ── Scalar fields ── *@
            <MudPaper Outlined="true" Class="pa-3 mb-3">
                <MudText Typo="Typo.h6" Class="mb-2">@L["General"]</MudText>

                <MudTextField T="string" Label="@L["Title"]"
                              MaxLength="255"
                              Value="@_title"
                              ValueChanged="@(v => { _title = v; })"
                              Required="true"
                              Class="mb-3"/>

                <MudTextField T="string" Label="@L["Native title"]"
                              MaxLength="255"
                              Value="@_nativeTitle"
                              ValueChanged="@(v => { _nativeTitle = v; })"
                              Class="mb-3"/>

                <MudTextField T="string" Label="@L["Sort title"]"
                              MaxLength="255"
                              Value="@_sortTitle"
                              ValueChanged="@(v => { _sortTitle = v; })"
                              Class="mb-3"/>

                <MudTextField T="string" Label="@L["ISSN"]"
                              MaxLength="8"
                              HelperText="@L["8 characters (eg. 0123-4567)"]"
                              Value="@_issn"
                              ValueChanged="@(v => { _issn = v; })"
                              Class="mb-3"/>

                <MudDatePicker Label="@L["First publication"]" Editable="true" Clearable="true"
                               Date="@_firstPublication"
                               DateChanged="@(d => { _firstPublication = d; })" Class="mb-3"/>

                <MudSelect T="int" Label="@L["First publication precision"]"
                           Value="@_firstPublicationPrecision"
                           ValueChanged="@(v => { _firstPublicationPrecision = v; })" Class="mb-3">
                    <MudSelectItem T="int" Value="0">@L["Full date"]</MudSelectItem>
                    <MudSelectItem T="int" Value="1">@L["Month and year only"]</MudSelectItem>
                    <MudSelectItem T="int" Value="2">@L["Year only"]</MudSelectItem>
                </MudSelect>

                <MudDatePicker Label="@L["Published"]" Editable="true" Clearable="true"
                               Date="@_published"
                               DateChanged="@(d => { _published = d; })" Class="mb-3"/>

                <MudSelect T="int" Label="@L["Date precision"]"
                           Value="@_publishedPrecision"
                           ValueChanged="@(v => { _publishedPrecision = v; })" Class="mb-3">
                    <MudSelectItem T="int" Value="0">@L["Full date"]</MudSelectItem>
                    <MudSelectItem T="int" Value="1">@L["Month and year only"]</MudSelectItem>
                    <MudSelectItem T="int" Value="2">@L["Year only"]</MudSelectItem>
                </MudSelect>

                <MudAutocomplete T="Iso31661NumericDto" Label="@L["Country"]"
                                 Value="@_selectedCountry"
                                 ValueChanged="@(c => { _selectedCountry = c; })"
                                 SearchFunc="SearchCountries"
                                 ToStringFunc="@(c => c?.Name ?? string.Empty)"
                                 Clearable="true"/>
            </MudPaper>

            @* ── Junctions ── *@
            <MudExpansionPanels MultiExpansion="true" Class="mb-3">

                @* Companies *@
                <MudExpansionPanel Text="@($"{L["Companies"]} ({CountActive(_companyRows, _companyRemoves) + _companyAdds.Count})")"
                                   Expanded="@HasOps(_companyAdds, _companyRemoves)">
                    @foreach(CompanyByMagazineDto c in _companyRows ?? new())
                    {
                        bool removed = _companyRemoves.Contains(c.Id ?? 0);
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-1">
                            <MudText Style="@(removed ? "text-decoration: line-through;" : "")">@FormatCompany(c)</MudText>
                            @if(removed)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default"
                                           OnClick="@(() => UndoRemove(_companyRemoves, c.Id ?? 0))">@L["Undo"]</MudButton>
                            }
                            else
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                               OnClick="@(() => MarkRemove(_companyRemoves, c.Id ?? 0))"/>
                            }
                        </MudStack>
                    }
                    @foreach(KeyValuePair<string, JunctionAddState> kv in _companyAdds)
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-1">
                            <MudText><strong>+ @kv.Value.Display</strong></MudText>
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default"
                                       OnClick="@(() => _companyAdds.Remove(kv.Key))">@L["Undo"]</MudButton>
                        </MudStack>
                    }
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-2">
                        <MudAutocomplete T="CompanyDto" Value="@_pickCompany" ValueChanged="@(c => { _pickCompany = c; })"
                                         SearchFunc="SearchCompanies" Clearable="true"
                                         ToStringFunc="@(c => c?.Name ?? string.Empty)"
                                         Style="flex: 1;"/>
                        <MudSelect T="DocumentRoleDto" Value="@_pickCompanyRole" ValueChanged="@(r => { _pickCompanyRole = r; })"
                                   Label="@L["Role"]" Style="max-width: 200px;"
                                   ToStringFunc="@(r => r?.Name ?? string.Empty)">
                            @foreach(DocumentRoleDto role in _roles ?? new())
                            {
                                <MudSelectItem T="DocumentRoleDto" Value="role">@role.Name</MudSelectItem>
                            }
                        </MudSelect>
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                   OnClick="AddCompany"
                                   Disabled="@(_pickCompany is null || _pickCompanyRole is null)">@L["Add company"]</MudButton>
                    </MudStack>
                </MudExpansionPanel>

            </MudExpansionPanels>

            <MudTextField T="string" Label="@L["Optional comment (References, sources, etc...)"]" Lines="2"
                          MaxLength="2000" @bind-Value="_userComment"/>

            @if(!string.IsNullOrWhiteSpace(_validationError))
            {
                <MudAlert Severity="Severity.Error" Class="mt-2">@_validationError</MudAlert>
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit"
                   Disabled="@(_loading || _submitting || !HasAnyChange())">
            @if(_submitting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true"/>
            }
            else
            {
                @L["Submit suggestion"]
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code
{
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; }

    [Parameter] public long        EntityId   { get; set; }
    [Parameter] public MagazineDto CurrentDto { get; set; }

    sealed class JunctionAddState
    {
        public Dictionary<string, object> Payload { get; set; }
        public string                     Display { get; set; }
    }

    bool _loading = true;
    bool _submitting;
    string _validationError;
    string _userComment;

    // Scalar state (mirrors the original CurrentDto values; diff'd at submit time)
    string                _title;
    string                _nativeTitle;
    string                _sortTitle;
    string                _issn;
    DateTime?             _firstPublication;
    int                   _firstPublicationPrecision;
    DateTime?             _published;
    int                   _publishedPrecision;
    Iso31661NumericDto    _selectedCountry;

    // Snapshot of the original scalar values (for diff computation at Submit time)
    string    _orig_title;
    string    _orig_nativeTitle;
    string    _orig_sortTitle;
    string    _orig_issn;
    DateTime? _orig_firstPublication;
    int       _orig_firstPublicationPrecision;
    DateTime? _orig_published;
    int       _orig_publishedPrecision;
    int?      _orig_countryId;

    // Picker source lists
    List<Iso31661NumericDto> _allCountries;
    List<CompanyDto>         _allCompanies;
    List<DocumentRoleDto>    _roles;

    // Existing junction rows
    List<CompanyByMagazineDto> _companyRows;

    // Pending operations: removes (set of existing row ids) + adds (uuid → state)
    HashSet<long> _companyRemoves = new();

    Dictionary<string, JunctionAddState> _companyAdds = new();

    // Picker state
    CompanyDto      _pickCompany;
    DocumentRoleDto _pickCompanyRole;

    protected override async Task OnInitializedAsync()
    {
        // Seed scalar state from the current DTO snapshot.
        if(CurrentDto is not null)
        {
            _title                          = CurrentDto.Title;
            _nativeTitle                    = CurrentDto.NativeTitle;
            _sortTitle                      = CurrentDto.SortTitle;
            _issn                           = CurrentDto.Issn;
            _firstPublication               = CurrentDto.FirstPublication?.UtcDateTime;
            _firstPublicationPrecision      = CurrentDto.FirstPublicationPrecision ?? 0;
            _published                      = CurrentDto.Published?.UtcDateTime;
            _publishedPrecision             = CurrentDto.PublishedPrecision ?? 0;
            _orig_title                     = _title;
            _orig_nativeTitle               = _nativeTitle;
            _orig_sortTitle                 = _sortTitle;
            _orig_issn                      = _issn;
            _orig_firstPublication          = _firstPublication;
            _orig_firstPublicationPrecision = _firstPublicationPrecision;
            _orig_published                 = _published;
            _orig_publishedPrecision        = _publishedPrecision;
            _orig_countryId                 = CurrentDto.CountryId;
        }

        Task<List<Iso31661NumericDto>>      countriesT     = MagazinesService.GetCountriesAsync();
        Task<List<CompanyDto>>              allCompaniesT  = MagazinesService.GetAllCompaniesAsync();
        Task<List<DocumentRoleDto>>         rolesT         = MagazinesService.GetDocumentRolesAsync();
        Task<List<CompanyByMagazineDto>>    companiesByT   = MagazinesService.GetCompaniesByMagazineAsync(EntityId);

        await Task.WhenAll(countriesT, allCompaniesT, rolesT, companiesByT);

        _allCountries = countriesT.Result;
        _allCompanies = allCompaniesT.Result;
        _roles        = rolesT.Result;
        _companyRows  = companiesByT.Result;

        if(_orig_countryId.HasValue && _allCountries is not null)
            _selectedCountry = _allCountries.Find(c => c.Id == _orig_countryId.Value);

        _loading = false;
    }

    // ───────────────────────────── Search functions ─────────────────────────────

    Task<IEnumerable<Iso31661NumericDto>> SearchCountries(string value, CancellationToken ct)
    {
        IEnumerable<Iso31661NumericDto> r = _allCountries ?? [];
        if(!string.IsNullOrWhiteSpace(value))
            r = r.Where(c => c.Name?.Contains(value, StringComparison.OrdinalIgnoreCase) ?? false);
        return Task.FromResult(r);
    }

    Task<IEnumerable<CompanyDto>> SearchCompanies(string value, CancellationToken ct)
    {
        IEnumerable<CompanyDto> r = _allCompanies ?? [];
        if(!string.IsNullOrWhiteSpace(value))
            r = r.Where(c => c.Name?.Contains(value, StringComparison.OrdinalIgnoreCase) ?? false);
        return Task.FromResult(r.Take(50));
    }

    // ───────────────────────────── Format helpers ─────────────────────────────

    static string FormatCompany(CompanyByMagazineDto c)
    {
        string name = c.Company ?? $"#{c.CompanyId}";
        return string.IsNullOrEmpty(c.Role) ? name : $"{name} ({c.Role})";
    }

    // ───────────────────────────── Junction queue helpers ─────────────────────────────

    void MarkRemove(HashSet<long> set, long id)
    {
        if(id == 0) return;
        set.Add(id);
    }

    void UndoRemove(HashSet<long> set, long id) => set.Remove(id);

    static int CountActive<T>(List<T> rows, HashSet<long> removes) where T : class
    {
        if(rows is null) return 0;
        int n = 0;
        foreach(T r in rows)
        {
            long id = (r as dynamic).Id ?? 0L;
            if(id == 0 || !removes.Contains(id)) n++;
        }
        return n;
    }

    static bool HasOps(Dictionary<string, JunctionAddState> adds, HashSet<long> removes) =>
        (adds is { Count: > 0 }) || (removes is { Count: > 0 });

    static string NewKey(string group, string op) => $"{group}.{op}.{Guid.NewGuid():N}";

    // ───────────────────────────── Add handlers ─────────────────────────────

    void AddCompany()
    {
        if(_pickCompany is null || _pickCompanyRole is null) return;
        string key = NewKey(MagazineSuggestionMetadata.GroupCompanies, "add");
        var payload = new Dictionary<string, object>(StringComparer.Ordinal)
        {
            ["company_id"] = _pickCompany.Id,
            ["role_id"]    = _pickCompanyRole.Id
        };
        _companyAdds[key] = new JunctionAddState
        {
            Payload = payload,
            Display = $"{_pickCompany.Name} ({_pickCompanyRole.Name})"
        };
        _pickCompany     = null;
        _pickCompanyRole = null;
    }

    // ───────────────────────────── Submit ─────────────────────────────

    bool HasAnyChange()
    {
        if(!Equals(_orig_title, _title)) return true;
        if(!Equals(_orig_nativeTitle, _nativeTitle)) return true;
        if(!Equals(_orig_sortTitle, _sortTitle)) return true;
        if(!Equals(_orig_issn, _issn)) return true;
        if(!Nullable.Equals(_orig_firstPublication, _firstPublication)) return true;
        if(_orig_firstPublicationPrecision != _firstPublicationPrecision) return true;
        if(!Nullable.Equals(_orig_published, _published)) return true;
        if(_orig_publishedPrecision != _publishedPrecision) return true;
        if(_orig_countryId != _selectedCountry?.Id) return true;

        if(_companyAdds.Count > 0) return true;
        if(_companyRemoves.Count > 0) return true;

        return false;
    }

    void Cancel() => MudDialog.Cancel();

    async Task Submit()
    {
        _validationError = null;
        if(_loading) return;

        // Title is required: never let the user clear it.
        if(string.IsNullOrWhiteSpace(_title))
        {
            _validationError = L["Title is required."];
            return;
        }

        // ISSN must be exactly 8 chars when supplied (server enforces too, but reject early).
        string issnTrimmed = _issn?.Trim();
        if(!string.IsNullOrEmpty(issnTrimmed) && issnTrimmed.Length != 8)
        {
            _validationError = L["ISSN must be exactly 8 characters."];
            return;
        }

        var diff = new Dictionary<string, object>(StringComparer.Ordinal);

        if(!Equals(_orig_title, _title))             diff[MagazineSuggestionMetadata.FieldTitle]       = _title;
        if(!Equals(_orig_nativeTitle, _nativeTitle)) diff[MagazineSuggestionMetadata.FieldNativeTitle] = _nativeTitle;
        if(!Equals(_orig_sortTitle, _sortTitle))     diff[MagazineSuggestionMetadata.FieldSortTitle]   = _sortTitle;
        if(!Equals(_orig_issn, _issn))               diff[MagazineSuggestionMetadata.FieldIssn]        = issnTrimmed;
        if(!Nullable.Equals(_orig_firstPublication, _firstPublication))
            diff[MagazineSuggestionMetadata.FieldFirstPublication] = _firstPublication?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
        if(_orig_firstPublicationPrecision != _firstPublicationPrecision)
            diff[MagazineSuggestionMetadata.FieldFirstPublicationPrecision] = _firstPublicationPrecision;
        if(!Nullable.Equals(_orig_published, _published))
            diff[MagazineSuggestionMetadata.FieldPublished] = _published?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
        if(_orig_publishedPrecision != _publishedPrecision)
            diff[MagazineSuggestionMetadata.FieldPublishedPrecision] = _publishedPrecision;
        if(_orig_countryId != _selectedCountry?.Id)
            diff[MagazineSuggestionMetadata.FieldCountryId] = _selectedCountry?.Id;

        AddJunctionOps(diff, _companyAdds, _companyRemoves, MagazineSuggestionMetadata.GroupCompanies);

        if(diff.Count == 0)
        {
            _validationError = L["No changes detected — modify at least one field before submitting."];
            return;
        }

        _submitting = true;
        try
        {
            string json = JsonSerializer.Serialize(diff);
            var dto = new SuggestionDto
            {
                EntityType          = (int?)SuggestionEntityType.Magazine,
                EntityId            = EntityId,
                Status              = (int?)SuggestionStatus.Pending,
                UserComment         = string.IsNullOrWhiteSpace(_userComment) ? null : _userComment.Trim(),
                SuggestedValuesJson = json
            };

            var (created, error) = await SuggestionsService.CreateAsync(dto);

            if(created is null)
            {
                _validationError = string.IsNullOrWhiteSpace(error) ? L["Failed to submit suggestion."].Value : error;
                return;
            }

            Snackbar.Add(L["Suggestion submitted. An administrator will review it."], Severity.Success);
            MudDialog.Close(DialogResult.Ok(created));
        }
        finally
        {
            _submitting = false;
        }
    }

    static void AddJunctionOps(Dictionary<string, object> diff,
                               Dictionary<string, JunctionAddState> adds,
                               HashSet<long> removes,
                               string group)
    {
        foreach(KeyValuePair<string, JunctionAddState> kv in adds) diff[kv.Key] = kv.Value.Payload;
        foreach(long id in removes) diff[$"{group}.remove.{id.ToString(CultureInfo.InvariantCulture)}"] = null;
    }
}
