    // ───────────────────────────── Submit ─────────────────────────────

    bool HasAnyChange()
    {
        if(!Equals(_orig_title, _title)) return true;
        int? newPlatformId  = _selectedPlatform?.Id;
        int? newPublisherId = _selectedPublisher?.Id;
        if(!Nullable.Equals(_orig_platformId, newPlatformId)) return true;
        if(!Nullable.Equals(_orig_publisherId, newPublisherId)) return true;
        string newDate = _releaseDate?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
        if(!Equals(_orig_releaseDate, newDate)) return true;
        if(_orig_releaseDatePrecision != _releaseDatePrecision) return true;

        if(_regionAdds.Count + _languageAdds.Count + _barcodeAdds.Count + _productCodeAdds.Count
           + _minGpuAdds.Count + _recGpuAdds.Count + _soundSynthAdds.Count > 0) return true;
        if(_regionRemoves.Count + _languageRemoves.Count + _barcodeRemoves.Count + _productCodeRemoves.Count
           + _minGpuRemoves.Count + _recGpuRemoves.Count + _soundSynthRemoves.Count > 0) return true;

        return false;
    }

    /// <summary>
    ///     UX gate for the Submit button in CREATION mode. Server still only requires
    ///     PublisherId on the entity, but a release without title / publisher / platform is
    ///     of little use in the queue — require all three plus the prefilled parent.
    /// </summary>
    bool HasMandatoryFieldsForCreation() =>
        PrefillSoftwareId.HasValue
        && !string.IsNullOrWhiteSpace(_title)
        && _selectedPublisher is not null
        && _selectedPlatform is not null;

    void Cancel() => MudDialog.Cancel();

    async Task Submit()
    {
        _validationError = null;
        if(_loading) return;

        if(IsCreation)
        {
            // Defence-in-depth: in creation mode the parent Software MUST be prefilled.
            if(!PrefillSoftwareId.HasValue)
            {
                _validationError = L["Cannot submit: parent software is missing."];
                return;
            }
            // Per-field validation in priority order — surface a specific error for the
            // first missing mandatory field (matches the server's ValidateAdditionPayload).
            if(string.IsNullOrWhiteSpace(_title))
            {
                _validationError = L["Title is required."];
                return;
            }
            if(_selectedPublisher is null || !_selectedPublisher.Id.HasValue)
            {
                _validationError = L["Publisher is required."];
                return;
            }
            if(_selectedPlatform is null || !_selectedPlatform.Id.HasValue)
            {
                _validationError = L["Platform is required."];
                return;
            }
        }
        else
        {
            // Publisher is required server-side ([Required] on the entity) — never let the
            // user clear it.
            if(_selectedPublisher is null || !_selectedPublisher.Id.HasValue)
            {
                _validationError = L["Publisher is required."];
                return;
            }
        }

        var diff = new Dictionary<string, object>(StringComparer.Ordinal);

        if(IsCreation)
        {
            // Emit the parent FK pseudo-field + every populated scalar (no diff vs.
            // snapshot — there is no snapshot in creation mode). The applier consumes
            // software_id explicitly; ApplyAsync rejects it on edit (re-parenting stays
            // admin-only).
            diff[SoftwareReleaseSuggestionMetadata.FieldSoftwareId] = PrefillSoftwareId.Value;
            diff[SoftwareReleaseSuggestionMetadata.FieldTitle]      = _title;
            diff[SoftwareReleaseSuggestionMetadata.FieldPublisherId] = _selectedPublisher.Id.Value;
            diff[SoftwareReleaseSuggestionMetadata.FieldPlatformId]  = _selectedPlatform.Id.Value;
            string createDate = _releaseDate?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
            if(!string.IsNullOrEmpty(createDate))
                diff[SoftwareReleaseSuggestionMetadata.FieldReleaseDate] = createDate;
            if(_releaseDatePrecision != 0)
                diff[SoftwareReleaseSuggestionMetadata.FieldReleaseDatePrecision] = _releaseDatePrecision;
        }
        else
        {
            if(!Equals(_orig_title, _title))
                diff[SoftwareReleaseSuggestionMetadata.FieldTitle] = _title;

            int? newPlatformId  = _selectedPlatform?.Id;
            int? newPublisherId = _selectedPublisher?.Id;
            if(!Nullable.Equals(_orig_platformId, newPlatformId))
                diff[SoftwareReleaseSuggestionMetadata.FieldPlatformId] = newPlatformId;
            if(!Nullable.Equals(_orig_publisherId, newPublisherId))
                diff[SoftwareReleaseSuggestionMetadata.FieldPublisherId] = newPublisherId;

            string newDate = _releaseDate?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
            if(!Equals(_orig_releaseDate, newDate))
                diff[SoftwareReleaseSuggestionMetadata.FieldReleaseDate] = newDate;
            if(_orig_releaseDatePrecision != _releaseDatePrecision)
                diff[SoftwareReleaseSuggestionMetadata.FieldReleaseDatePrecision] = _releaseDatePrecision;
        }

        AddJunctionAdds(diff, _regionAdds);
        AddJunctionAdds(diff, _languageAdds);
        AddJunctionAdds(diff, _barcodeAdds);
        AddJunctionAdds(diff, _productCodeAdds);
        AddJunctionAdds(diff, _minGpuAdds);
        AddJunctionAdds(diff, _recGpuAdds);
        AddJunctionAdds(diff, _soundSynthAdds);

        // Drop ALL remove ops in creation mode — a brand-new entity has nothing to remove.
        if(!IsCreation)
        {
            foreach(short id in _regionRemoves)
                diff[$"{SoftwareReleaseSuggestionMetadata.GroupRegions}.remove.{id.ToString(CultureInfo.InvariantCulture)}"] = null;
            foreach(string code in _languageRemoves)
                diff[$"{SoftwareReleaseSuggestionMetadata.GroupLanguages}.remove.{code}"] = null;
            foreach(long id in _barcodeRemoves)
                diff[$"{SoftwareReleaseSuggestionMetadata.GroupBarcodes}.remove.{id.ToString(CultureInfo.InvariantCulture)}"] = null;
            foreach(long id in _productCodeRemoves)
                diff[$"{SoftwareReleaseSuggestionMetadata.GroupProductCodes}.remove.{id.ToString(CultureInfo.InvariantCulture)}"] = null;
            foreach(int id in _minGpuRemoves)
                diff[$"{SoftwareReleaseSuggestionMetadata.GroupMinGpus}.remove.{id.ToString(CultureInfo.InvariantCulture)}"] = null;
            foreach(int id in _recGpuRemoves)
                diff[$"{SoftwareReleaseSuggestionMetadata.GroupRecGpus}.remove.{id.ToString(CultureInfo.InvariantCulture)}"] = null;
            foreach(int id in _soundSynthRemoves)
                diff[$"{SoftwareReleaseSuggestionMetadata.GroupSoundSynths}.remove.{id.ToString(CultureInfo.InvariantCulture)}"] = null;
        }

        if(diff.Count == 0)
        {
            _validationError = L["No changes detected — modify at least one field before submitting."];
            return;
        }

        _submitting = true;
        try
        {
            string json = JsonSerializer.Serialize(diff);
            var dto = new SuggestionDto
            {
                EntityType          = (int?)SuggestionEntityType.SoftwareRelease,
                EntityId            = IsCreation ? null : EntityId,
                Status              = (int?)SuggestionStatus.Pending,
                UserComment         = string.IsNullOrWhiteSpace(_userComment) ? null : _userComment.Trim(),
                SuggestedValuesJson = json
            };

            var (created, error) = await SuggestionsService.CreateAsync(dto);

            if(created is null)
            {
                _validationError = string.IsNullOrWhiteSpace(error) ? L["Failed to submit suggestion."].Value : error;
                return;
            }

            Snackbar.Add(L["Suggestion submitted. An administrator will review it."], Severity.Success);
            MudDialog.Close(DialogResult.Ok(created));
        }
        finally
        {
            _submitting = false;
        }
    }

    static void AddJunctionAdds(Dictionary<string, object> diff, Dictionary<string, JunctionAddState> adds)
    {
        foreach(KeyValuePair<string, JunctionAddState> kv in adds) diff[kv.Key] = kv.Value.Payload;
    }
}
