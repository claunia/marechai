@using System
@using System.Globalization
@using System.Linq
@using System.Text.Json
@using System.Threading
@using Marechai.ApiClient.Models
@using Marechai.Data
@using Marechai.Services
@using Marechai.Suggestions
@inject IStringLocalizer<NewEntitySuggestionDialog> L
@inject ISnackbar              Snackbar
@inject SuggestionsService     Service
@inject CompaniesService       CompaniesService

@*
    Suggest a brand-new entity (e.g. a new Company). Renders one form input per field
    descriptor in the metadata, starting from an empty payload. Submit is disabled until the
    metadata's primary field (Name for Company) is non-empty. The server enforces the same
    rule and rejects submissions whose primary field is missing.
*@

<MudDialog>
    <DialogContent>
        @if(_metadata is null || _metadata.Fields.Count == 0)
        {
            <MudAlert Severity="Severity.Warning">@L["This entity type does not support new-entity suggestions."]</MudAlert>
        }
        else
        {
            <MudText Typo="Typo.body2" Class="mb-3">@L["Fill in the fields you know. Only the marked field is required."]</MudText>

            @foreach(SuggestionFieldDescriptor field in _metadata.Fields)
            {
                <div class="mb-2">
                    @{
                        string label   = L[field.LabelKey];
                        bool   primary = field.Name == _metadata.PrimaryFieldName;
                        string fullLabel = primary ? label + " *" : label;
                    }
                    @switch(field.Kind)
                    {
                        case SuggestionFieldKind.Text:
                        case SuggestionFieldKind.Url:
                            <MudTextField T="string" Label="@fullLabel"
                                          MaxLength="@(field.MaxLength ?? 4096)"
                                          InputType="@(field.Kind == SuggestionFieldKind.Url ? InputType.Url : InputType.Text)"
                                          Value="@GetString(field.Name)"
                                          ValueChanged="@(v => SetValue(field.Name, v))"
                                          Required="@primary"/>
                            break;
                        case SuggestionFieldKind.MultilineText:
                            <MudTextField T="string" Label="@fullLabel" Lines="3"
                                          MaxLength="@(field.MaxLength ?? 4096)"
                                          Value="@GetString(field.Name)"
                                          ValueChanged="@(v => SetValue(field.Name, v))"/>
                            break;
                        case SuggestionFieldKind.Int:
                            <MudNumericField T="int?" Label="@fullLabel"
                                             Value="@GetInt(field.Name)"
                                             ValueChanged="@(v => SetValue(field.Name, v))"/>
                            break;
                        case SuggestionFieldKind.Short:
                            <MudNumericField T="short?" Label="@fullLabel"
                                             Value="@GetShort(field.Name)"
                                             ValueChanged="@(v => SetValue(field.Name, v))"/>
                            break;
                        case SuggestionFieldKind.Bool:
                            <MudCheckBox T="bool?" Label="@fullLabel"
                                         Value="@GetBool(field.Name)"
                                         ValueChanged="@(v => SetValue(field.Name, v))"/>
                            break;
                        case SuggestionFieldKind.Date:
                            <MudDatePicker Label="@fullLabel" Editable="true" Clearable="true"
                                           Date="@GetDate(field.Name)"
                                           DateChanged="@(d => SetValue(field.Name, d))"/>
                            break;
                        case SuggestionFieldKind.Enum:
                            <MudSelect T="int?" Label="@fullLabel" Clearable="true"
                                       Value="@GetInt(field.Name)"
                                       ValueChanged="@(v => SetValue(field.Name, v))">
                                @if(field.EnumOptions is not null)
                                {
                                    @foreach(SuggestionEnumOption opt in field.EnumOptions)
                                    {
                                        <MudSelectItem T="int?" Value="@(((int?)opt.Value))">@L[opt.LabelKey]</MudSelectItem>
                                    }
                                }
                            </MudSelect>
                            break;
                        case SuggestionFieldKind.ForeignKeyCountry:
                            <MudAutocomplete T="Iso31661NumericDto" Label="@fullLabel"
                                             Value="@GetCountry(field.Name)"
                                             ValueChanged="@(c => SetValue(field.Name, c?.Id))"
                                             SearchFunc="SearchCountries"
                                             ToStringFunc="@(c => c?.Name ?? string.Empty)"
                                             Clearable="true"/>
                            break;
                        case SuggestionFieldKind.ForeignKeyCompany:
                            <MudAutocomplete T="CompanyDto" Label="@fullLabel"
                                             Value="@GetCompany(field.Name)"
                                             ValueChanged="@(c => SetValue(field.Name, c?.Id))"
                                             SearchFunc="SearchCompanies"
                                             ToStringFunc="@(c => c?.Name ?? string.Empty)"
                                             Clearable="true"/>
                            break;
                        default:
                            <MudAlert Severity="Severity.Info">@L["Field kind not supported in this dialog yet."]</MudAlert>
                            break;
                    }
                </div>
            }

            <MudTextField T="string" Label="@L["Optional comment (References, sources, etc...)"]" Lines="2"
                          MaxLength="2000"
                          @bind-Value="_userComment"/>

            @if(!string.IsNullOrWhiteSpace(_validationError))
            {
                <MudAlert Severity="Severity.Error" Class="mt-2">@_validationError</MudAlert>
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit"
                   Disabled="@(_metadata is null || _metadata.Fields.Count == 0 || _submitting || !PrimaryFieldFilled)">
            @if(_submitting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true"/>
            }
            else
            {
                @L["Submit suggestion"]
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code
{
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; }

    [Parameter] public SuggestionEntityType EntityType { get; set; }

    SuggestionMetadata _metadata;
    Dictionary<string, object> _input = new(StringComparer.Ordinal);
    string _userComment;
    string _validationError;
    bool   _submitting;

    // FK picker caches.
    List<Iso31661NumericDto> _countries;
    List<CompanyDto>         _companies;
    bool                     _fkLoadStarted;

    bool PrimaryFieldFilled
    {
        get
        {
            if(_metadata?.PrimaryFieldName is null) return true;
            string s = GetString(_metadata.PrimaryFieldName);
            return !string.IsNullOrWhiteSpace(s);
        }
    }

    protected override void OnInitialized()
    {
        _metadata = SuggestionMetadataRegistry.Get(EntityType);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(!firstRender || _fkLoadStarted || _metadata is null) return;

        bool needsCountries = false;
        bool needsCompanies = false;
        foreach(SuggestionFieldDescriptor f in _metadata.Fields)
        {
            if(f.Kind == SuggestionFieldKind.ForeignKeyCountry) needsCountries = true;
            if(f.Kind == SuggestionFieldKind.ForeignKeyCompany) needsCompanies = true;
        }

        if(!needsCountries && !needsCompanies) return;

        _fkLoadStarted = true;

        Task<List<Iso31661NumericDto>> countriesTask = needsCountries ? CompaniesService.GetCountriesAsync() : Task.FromResult<List<Iso31661NumericDto>>(null);
        Task<List<CompanyDto>>         companiesTask = needsCompanies ? CompaniesService.GetAsync()           : Task.FromResult<List<CompanyDto>>(null);

        await Task.WhenAll(countriesTask, companiesTask);

        _countries = countriesTask.Result;
        _companies = companiesTask.Result;

        StateHasChanged();
    }

    string GetString(string name)
    {
        if(_input.TryGetValue(name, out object v) && v is not null)
            return v switch
            {
                JsonElement je => je.ValueKind == JsonValueKind.Null ? null : je.ToString(),
                _              => v.ToString()
            };
        return null;
    }

    int? GetInt(string name)
    {
        if(!_input.TryGetValue(name, out object v) || v is null) return null;
        return v switch
        {
            int i           => i,
            short s         => s,
            long l          => (int?)l,
            JsonElement je  => je.ValueKind == JsonValueKind.Number ? je.GetInt32() : null,
            string str      => int.TryParse(str, NumberStyles.Integer, CultureInfo.InvariantCulture, out int p) ? p : null,
            _               => null
        };
    }

    short? GetShort(string name)
    {
        int? i = GetInt(name);
        return i.HasValue ? (short)i.Value : null;
    }

    bool? GetBool(string name)
    {
        if(!_input.TryGetValue(name, out object v) || v is null) return null;
        return v switch
        {
            bool b         => b,
            JsonElement je => je.ValueKind switch
            {
                JsonValueKind.True  => true,
                JsonValueKind.False => false,
                _                   => (bool?)null
            },
            _              => null
        };
    }

    DateTime? GetDate(string name)
    {
        if(!_input.TryGetValue(name, out object v) || v is null) return null;
        return v switch
        {
            DateTime dt    => dt,
            JsonElement je => je.ValueKind == JsonValueKind.String && DateTime.TryParse(je.GetString(), CultureInfo.InvariantCulture, DateTimeStyles.AssumeUniversal | DateTimeStyles.AdjustToUniversal, out DateTime p) ? p : null,
            string str     => DateTime.TryParse(str, CultureInfo.InvariantCulture, DateTimeStyles.AssumeUniversal | DateTimeStyles.AdjustToUniversal, out DateTime p) ? p : null,
            _              => null
        };
    }

    void SetValue(string name, object value)
    {
        if(value is string s && string.IsNullOrEmpty(s)) value = null;
        _input[name] = value;
    }

    Iso31661NumericDto GetCountry(string name)
    {
        int? id = GetInt(name);
        if(!id.HasValue || _countries is null) return null;
        return _countries.Find(c => c.Id == id.Value);
    }

    CompanyDto GetCompany(string name)
    {
        int? id = GetInt(name);
        if(!id.HasValue || _companies is null) return null;
        return _companies.Find(c => c.Id == id.Value);
    }

    Task<IEnumerable<Iso31661NumericDto>> SearchCountries(string value, CancellationToken ct)
    {
        IEnumerable<Iso31661NumericDto> results = _countries ?? (IEnumerable<Iso31661NumericDto>)Array.Empty<Iso31661NumericDto>();

        if(!string.IsNullOrWhiteSpace(value))
            results = _countries?.Where(c => c.Name?.Contains(value, StringComparison.OrdinalIgnoreCase) ?? false) ?? Array.Empty<Iso31661NumericDto>();

        return Task.FromResult(results);
    }

    Task<IEnumerable<CompanyDto>> SearchCompanies(string value, CancellationToken ct)
    {
        IEnumerable<CompanyDto> results = _companies ?? (IEnumerable<CompanyDto>)Array.Empty<CompanyDto>();

        if(!string.IsNullOrWhiteSpace(value))
            results = _companies?.Where(c => c.Name?.Contains(value, StringComparison.OrdinalIgnoreCase) ?? false) ?? Array.Empty<CompanyDto>();

        return Task.FromResult(results);
    }

    void Cancel() => MudDialog.Cancel();

    async Task Submit()
    {
        _validationError = null;

        // Build the payload from filled-in fields. Skip null/empty so the wire payload stays compact.
        var payload = new Dictionary<string, object>(StringComparer.Ordinal);
        foreach(SuggestionFieldDescriptor f in _metadata.Fields)
        {
            if(!_input.TryGetValue(f.Name, out object v) || v is null) continue;
            if(v is string s && string.IsNullOrWhiteSpace(s)) continue;
            payload[f.Name] = v;
        }

        if(_metadata.PrimaryFieldName is not null && !payload.ContainsKey(_metadata.PrimaryFieldName))
        {
            _validationError = L["The primary field is required."];
            return;
        }

        _submitting = true;
        try
        {
            string json = JsonSerializer.Serialize(payload);
            var dto = new SuggestionDto
            {
                EntityType          = (int?)EntityType,
                EntityId            = null, // brand-new entity
                Status              = (int?)SuggestionStatus.Pending,
                UserComment         = string.IsNullOrWhiteSpace(_userComment) ? null : _userComment.Trim(),
                SuggestedValuesJson = json
            };

            var (created, error) = await Service.CreateAsync(dto);

            if(created is null)
            {
                _validationError = string.IsNullOrWhiteSpace(error) ? L["Failed to submit suggestion."].Value : error;
                return;
            }

            Snackbar.Add(L["Suggestion submitted. An administrator will review it."], Severity.Success);
            MudDialog.Close(DialogResult.Ok(created));
        }
        finally
        {
            _submitting = false;
        }
    }
}
