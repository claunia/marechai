@*
    MachineVideoSuggestionDialog — collaborative machine video link suggestion (single item).

    A logged-in user can suggest ONE brand-new YouTube video link for an existing
    machine. The dialog asks only for a YouTube URL (or 11-character video ID);
    the canonical title is fetched server-side from YouTube's oEmbed endpoint at
    submission time and patched into the persisted SuggestedValues so admins see
    it in the diff panel from the start. An inline 16:9 youtube-nocookie iframe
    previews the video as soon as the URL parses, so the user can verify they
    typed the right thing before submitting.

    Architecture notes:
    * NO file upload, NO pending sidecars, NO per-item dynamic accept-keys — the
      whole suggestion is accepted or rejected as a unit by the admin reviewer.
    * Subkey = the extracted YouTube video ID, so the per-(user, machine, video)
      Pending dedupe gates resubmission of the same video while a previous
      suggestion is still pending.
    * Duplicate URLs that already link to this machine are rejected at
      submission with a helpful inline error.
    * Provider is hardcoded to "YouTube" — other providers are out of scope for
      this port.
*@
@using System
@using System.Collections.Generic
@using System.Text.Json
@using System.Threading.Tasks
@using Marechai.ApiClient.Models
@using Marechai.Data
@using Marechai.Helpers
@using Marechai.Services

@inject IStringLocalizer<MachinesService> L
@inject ISnackbar                           Snackbar
@inject SuggestionsService                  SuggestionsService

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-3">
            @string.Format(L["Suggest a YouTube video for {0}. The video title will be fetched automatically from YouTube when you submit."].Value, MachineName)
        </MudText>

        <MudTextField T="string"
                      Value="@_videoUrl"
                      ValueChanged="@OnUrlChanged"
                      Label="@L["YouTube URL or video ID"]"
                      HelperText="@L["Paste a YouTube URL or 11-character video ID. The title will be fetched automatically from YouTube."]"
                      Required="true"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      MaxLength="2048"
                      Immediate="true"
                      Class="mb-2"/>

        @if(!string.IsNullOrWhiteSpace(_videoUrl) && string.IsNullOrEmpty(_videoIdPreview))
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-2">
                @L["This is not a valid YouTube URL or video ID."]
            </MudAlert>
        }

        @if(!string.IsNullOrEmpty(_videoIdPreview))
        {
            <MudPaper Outlined="true" Class="pa-2 mb-3">
                <MudText Typo="Typo.caption" Class="mb-2">
                    @L["Preview"] (@_videoIdPreview)
                </MudText>
                <div style="position: relative; width: 100%; padding-bottom: 56.25%; border-radius: 8px; overflow: hidden;">
                    <iframe src="@($"https://www.youtube-nocookie.com/embed/{_videoIdPreview}")"
                            style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: 0;"
                            title="YouTube video preview"
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                            allowfullscreen
                            loading="lazy"
                            referrerpolicy="no-referrer-when-downgrade"></iframe>
                </div>
            </MudPaper>

            <MudText Typo="Typo.caption" Class="mb-3">
                @L["Title will be fetched from YouTube when you submit."]
            </MudText>
        }

        <MudTextField T="string"
                      @bind-Value="_userComment"
                      Label="@L["Note to reviewer (optional)"]"
                      HelperText="@L["Add any context that helps the admin decide."]"
                      Lines="2"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      MaxLength="2000"
                      Class="mb-2"/>

        @if(!string.IsNullOrEmpty(_validationError))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-2">
                @_validationError
            </MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="OnCancel" Disabled="@_submitting">@L["Cancel"]</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   Disabled="@(_submitting || string.IsNullOrEmpty(_videoIdPreview))"
                   OnClick="OnSubmitAsync">
            @if(_submitting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true"/>
                <span class="ml-2">@L["Submitting…"]</span>
            }
            else
            {
                @L["Submit"]
            }
        </MudButton>
    </DialogActions>
</MudDialog>
