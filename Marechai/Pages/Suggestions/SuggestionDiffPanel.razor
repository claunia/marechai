@using System.Text.Json
@using DiffPlex.DiffBuilder
@using DiffPlex.DiffBuilder.Model
@using Marechai.ApiClient.Models
@using Marechai.Data
@using Marechai.Services
@using Marechai.Suggestions
@using Microsoft.JSInterop
@inject IStringLocalizer<SuggestionDiffPanel> L
@inject IJSRuntime           JS
@inject TokenProvider        TokenProvider
@inject ApiAssetUrlProvider  ApiAssetUrls

@*
    Renders a diff table per suggested field with a checkbox per row so the admin can pick
    exactly which fields to accept. Bound HashSet<string> in the parent receives the
    accepted-field-names set.

    For Markdown-kind fields, the row spans full width and renders a colored inline line-diff
    (green inserts / red deletes / muted unchanged context) instead of the side-by-side cells.
*@

@if(_suggestedDict is null)
{
    <MudText Color="Color.Secondary">@L["No suggestion data."]</MudText>
}
else if(_suggestedDict.Count == 0)
{
    <MudAlert Severity="Severity.Info">@L["This suggestion has no field changes."]</MudAlert>
}
else if(Suggestion?.EntityType == (int)SuggestionEntityType.GpuPhoto)
{
    @RenderGpuPhotoBatch()
}
else if(Suggestion?.EntityType == (int)SuggestionEntityType.ProcessorPhoto)
{
    @RenderProcessorPhotoBatch()
}
else
{
    <MudSimpleTable Hover="true" Dense="true" Bordered="true" Style="width: 100%;">
        <thead>
            <tr>
                <th style="width: 60px;">@L["Accept"]</th>
                <th style="width: 28%;">@L["Field"]</th>
                <th style="width: 36%;">@L["Current value"]</th>
                <th style="width: 36%;">@L["Suggested value"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach(KeyValuePair<string, JsonElement> entry in _suggestedDict)
            {
                string fieldName = entry.Key;
                _currentDict.TryGetValue(fieldName, out JsonElement currentValue);
                bool isChecked = AcceptedFieldNames.Contains(fieldName);
                SuggestionFieldKind kind = ResolveFieldKind(fieldName);
                bool isMarkdown = kind == SuggestionFieldKind.Markdown;
                bool isJunctionAdd    = kind == SuggestionFieldKind.JunctionAdd;
                bool isJunctionRemove = kind == SuggestionFieldKind.JunctionRemove;
                bool isImage          = kind == SuggestionFieldKind.Image;

                if(isMarkdown)
                {
                    string currentText  = JsonElementToText(currentValue);
                    string suggestedText = JsonElementToText(entry.Value);
                    DiffPaneModel diff   = InlineDiffBuilder.Diff(currentText, suggestedText, ignoreWhiteSpace: false, ignoreCase: false);
                    int inserted = 0, deleted = 0, unchanged = 0;
                    foreach(DiffPiece line in diff.Lines)
                    {
                        switch(line.Type)
                        {
                            case ChangeType.Inserted: inserted++; break;
                            case ChangeType.Deleted:  deleted++; break;
                            default:                  unchanged++; break;
                        }
                    }

                    <tr>
                        <td>
                            <MudCheckBox T="bool" Value="@isChecked"
                                         ValueChanged="@(v => ToggleAccepted(fieldName, v))"
                                         Disabled="@(ReadOnly || IsRequired(fieldName))"/>
                        </td>
                        <td colspan="3">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                                <strong>@FormatLabel(fieldName)</strong>
                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">+@inserted</MudChip>
                                <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined">−@deleted</MudChip>
                                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">@unchanged @L["unchanged"]</MudChip>
                            </MudStack>
                            @{ bool collapse = diff.Lines.Count > 500; }
                            @if(collapse)
                            {
                                <MudExpansionPanels Elevation="0" Dense="true">
                                    <MudExpansionPanel Text="@L["Show full diff ({0} lines)", diff.Lines.Count]">
                                        @MarkdownDiffMarkup(diff)
                                    </MudExpansionPanel>
                                </MudExpansionPanels>
                            }
                            else
                            {
                                @MarkdownDiffMarkup(diff)
                            }
                        </td>
                    </tr>
                }
                else if(isImage)
                {
                    // Pending-cover render. The CURRENT side is the existing cover (a guid in
                    // the public asset CDN — no auth needed, so a plain <img> tag works). The
                    // SUGGESTED side is the just-uploaded pending image (JWT-protected, so
                    // we fetch it via JS interop and apply a blob URL after render). Lightbox
                    // click on either opens a full-size view. The asset folder is keyed by
                    // entity type (Book → book-covers, MagazineIssue → magazine-issue-covers).
                    string currentGuid   = JsonElementToText(currentValue);
                    string suggestedGuid = JsonElementToText(entry.Value);
                    string suggestedImgId = $"diffimg-sug-{Suggestion?.Id}-{fieldName}";
                    string itemFolder = (Suggestion?.EntityType) switch
                    {
                        (int)SuggestionEntityType.MagazineIssue => "magazine-issue-covers",
                        (int)SuggestionEntityType.Person        => "people",
                        _                                       => "book-covers"
                    };
                    if(!string.IsNullOrEmpty(suggestedGuid)) _pendingImageRefs[suggestedImgId] = suggestedGuid;

                    <tr style="background-color: rgba(25, 118, 210, 0.05);">
                        <td>
                            <MudCheckBox T="bool" Value="@isChecked"
                                         ValueChanged="@(v => ToggleAccepted(fieldName, v))"
                                         Disabled="@(ReadOnly || IsRequired(fieldName))"/>
                        </td>
                        <td>@FormatLabel(fieldName)</td>
                        <td>
                            @if(!string.IsNullOrEmpty(currentGuid))
                            {
                                string currentUrl = $"{ApiAssetUrls.BaseUrl}/assets/photos/{itemFolder}/jpeg/hd/{currentGuid}.jpg";
                                <a href="@currentUrl" target="_blank" rel="noopener">
                                    <img src="@currentUrl" alt="Current cover"
                                         style="max-height: 100px; max-width: 80px; object-fit: contain; cursor: zoom-in; border-radius: 3px;"/>
                                </a>
                            }
                            else
                            {
                                <span class="text-muted">@L["(no image)"]</span>
                            }
                        </td>
                        <td>
                            @if(!string.IsNullOrEmpty(suggestedGuid))
                            {
                                <img id="@suggestedImgId" alt="Suggested cover"
                                     style="max-height: 100px; max-width: 80px; object-fit: contain; cursor: zoom-in; border-radius: 3px; box-shadow: 0 0 0 2px #1976d2;"
                                     @onclick="@(() => OpenImageInNewTab(suggestedGuid, isPending: true))"/>
                            }
                            else
                            {
                                <span class="text-muted">@L["(no image)"]</span>
                            }
                        </td>
                    </tr>
                }
                else if(isJunctionAdd)
                {
                    string label = SuggestedLabels is not null && SuggestedLabels.TryGetValue(fieldName, out string addLabel)
                                       ? addLabel
                                       : L["(new junction row)"];
                    <tr style="background-color: rgba(46, 160, 67, 0.08);">
                        <td>
                            <MudCheckBox T="bool" Value="@isChecked"
                                         ValueChanged="@(v => ToggleAccepted(fieldName, v))"
                                         Disabled="@(ReadOnly || IsRequired(fieldName))"/>
                        </td>
                        <td colspan="3">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled">+ @L["Add"]</MudChip>
                                <strong>@FormatLabel(fieldName)</strong>
                                <MudText Typo="Typo.body2">@label</MudText>
                            </MudStack>
                        </td>
                    </tr>
                }
                else if(isJunctionRemove)
                {
                    string label = CurrentLabels is not null && CurrentLabels.TryGetValue(fieldName, out string remLabel)
                                       ? remLabel
                                       : L["(existing junction row)"];
                    <tr style="background-color: rgba(248, 81, 73, 0.08);">
                        <td>
                            <MudCheckBox T="bool" Value="@isChecked"
                                         ValueChanged="@(v => ToggleAccepted(fieldName, v))"
                                         Disabled="@(ReadOnly || IsRequired(fieldName))"/>
                        </td>
                        <td colspan="3">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled">− @L["Remove"]</MudChip>
                                <strong>@FormatLabel(fieldName)</strong>
                                <MudText Typo="Typo.body2" Style="text-decoration: line-through;">@label</MudText>
                            </MudStack>
                        </td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td>
                            <MudCheckBox T="bool" Value="@isChecked"
                                         ValueChanged="@(v => ToggleAccepted(fieldName, v))"
                                         Disabled="@(ReadOnly || IsRequired(fieldName))"/>
                        </td>
                        <td>@FormatLabel(fieldName)</td>
                        <td><span class="text-muted">@FormatCurrent(fieldName, currentValue)</span></td>
                        <td><strong style="color: #1976d2;">@FormatSuggested(fieldName, entry.Value)</strong></td>
                    </tr>
                }
            }
        </tbody>
    </MudSimpleTable>
}

@code
{
    [Parameter] public SuggestionDto      Suggestion        { get; set; }
    [Parameter] public string             CurrentValuesJson { get; set; }
    [Parameter] public Dictionary<string, string> CurrentLabels   { get; set; }
    [Parameter] public Dictionary<string, string> SuggestedLabels { get; set; }
    [Parameter] public HashSet<string>    AcceptedFieldNames { get; set; } = new(StringComparer.Ordinal);
    [Parameter] public EventCallback<HashSet<string>> AcceptedFieldNamesChanged { get; set; }
    [Parameter] public bool               ReadOnly          { get; set; }
    /// <summary>
    ///     Optional set of field names that MUST be accepted (checkbox forced on + disabled).
    ///     Used by the new-entity review flow to require <c>name</c> for additions.
    /// </summary>
    [Parameter] public IReadOnlyCollection<string> RequireFields { get; set; }

    SuggestionMetadata _metadata;
    Dictionary<string, JsonElement> _suggestedDict;
    Dictionary<string, JsonElement> _currentDict = new(StringComparer.Ordinal);
    long? _seededRequireForId;

    /// <summary>
    ///     Map of <c>img id → guid</c> populated during the render pass for any
    ///     <see cref="SuggestionFieldKind.Image" /> fields. Consumed in
    ///     <see cref="OnAfterRenderAsync" /> so the JS interop helper fetches each pending
    ///     image with the JWT in an Authorization header (which a plain <c>&lt;img src&gt;</c>
    ///     can't carry) and applies the resulting blob URL to the matching element.
    /// </summary>
    Dictionary<string, string> _pendingImageRefs = new(StringComparer.Ordinal);
    HashSet<string>            _appliedImageRefs = new(StringComparer.Ordinal);

    protected override void OnParametersSet()
    {
        if(Suggestion?.EntityType is null) { _suggestedDict = null; return; }

        _metadata = SuggestionMetadataRegistry.Get((SuggestionEntityType)Suggestion.EntityType.Value);

        _suggestedDict = ParseJsonObject(Suggestion.SuggestedValuesJson);
        _currentDict   = ParseJsonObject(CurrentValuesJson);

        // Reset the per-render pending-image lookup; the table-rendering loop will
        // repopulate it with whatever Image-kind fields exist in the current diff.
        // The applied-set is reset too so a different suggestion (e.g. when the parent
        // navigates between rows) re-fetches its blobs instead of reusing stale URLs.
        _pendingImageRefs = new Dictionary<string, string>(StringComparer.Ordinal);
        _appliedImageRefs = new HashSet<string>(StringComparer.Ordinal);
    }

    /// <summary>
    ///     Lightbox-style open: fetch the pending image with auth, then open the resulting
    ///     blob URL in a new tab. Only used for pending (collaborator-uploaded) images;
    ///     existing covers are served from the public asset CDN and don't need auth.
    /// </summary>
    async Task OpenImageInNewTab(string guid, bool isPending)
    {
        if(string.IsNullOrEmpty(guid)) return;
        try
        {
            string token = await TokenProvider.GetTokenAsync();
            if(string.IsNullOrEmpty(token)) return;
            string fnName = (Suggestion?.EntityType) switch
            {
                (int)SuggestionEntityType.MagazineIssue => "MarechaiPendingCover.openPendingMagazineIssueCoverInNewTab",
                (int)SuggestionEntityType.Person        => "MarechaiPendingCover.openPendingPersonPhotoInNewTab",
                (int)SuggestionEntityType.GpuPhoto      => "MarechaiGpuPhotoUpload.openPendingPhotoInNewTab",
                (int)SuggestionEntityType.ProcessorPhoto => "MarechaiProcessorPhotoUpload.openPendingPhotoInNewTab",
                _                                       => "MarechaiPendingCover.openPendingCoverInNewTab"
            };
            await JS.InvokeAsync<object>(fnName, ApiAssetUrls.BaseUrl, token, guid);
        }
        catch
        {
            // best-effort
        }
    }

    /// <summary>
    ///     After the first render, seed any RequireFields into the accepted set AND notify the
    ///     parent so its <c>Disabled</c> bindings re-evaluate. Done in <see cref="OnAfterRenderAsync" />
    ///     instead of <see cref="OnParametersSet" /> so the parent's button correctly enables on
    ///     first display (mutating the shared HashSet inside OnParametersSet doesn't trigger a
    ///     parent re-render). Guarded by <c>_seededRequireForId</c> so re-renders don't loop.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Apply any pending-image blob URLs that were registered during the last render.
        // Each img-id → guid pair is fetched via JS with the JWT in an Authorization header
        // (a plain <img src> can't carry one). Already-applied refs are skipped via
        // _appliedImageRefs so successive re-renders don't re-fetch.
        if(_pendingImageRefs.Count > 0)
        {
            string token = await TokenProvider.GetTokenAsync();
            if(!string.IsNullOrEmpty(token))
            {
                string applyFnName = (Suggestion?.EntityType) switch
                {
                    (int)SuggestionEntityType.MagazineIssue => "MarechaiPendingCover.applyPendingMagazineIssueCoverImage",
                    (int)SuggestionEntityType.Person        => "MarechaiPendingCover.applyPendingPersonPhotoImage",
                    (int)SuggestionEntityType.GpuPhoto      => "MarechaiGpuPhotoUpload.applyPendingPhotoImage",
                    (int)SuggestionEntityType.ProcessorPhoto => "MarechaiProcessorPhotoUpload.applyPendingPhotoImage",
                    _                                       => "MarechaiPendingCover.applyPendingCoverImage"
                };
                foreach(KeyValuePair<string, string> kv in _pendingImageRefs)
                {
                    string refKey = kv.Key + "|" + kv.Value;
                    if(_appliedImageRefs.Contains(refKey)) continue;
                    try
                    {
                        await JS.InvokeVoidAsync(applyFnName,
                                                 ApiAssetUrls.BaseUrl, token, kv.Value, kv.Key);
                        _appliedImageRefs.Add(refKey);
                    }
                    catch
                    {
                        // best-effort — admin will see the broken-image fallback if the
                        // pending file got swept while the dialog was open.
                    }
                }
            }
        }

        if(RequireFields is null || RequireFields.Count == 0 || _suggestedDict is null) return;
        if(_seededRequireForId == Suggestion?.Id) return;

        AcceptedFieldNames ??= new HashSet<string>(StringComparer.Ordinal);
        bool added = false;
        foreach(string r in RequireFields)
        {
            if(_suggestedDict.ContainsKey(r) && AcceptedFieldNames.Add(r))
                added = true;
        }

        _seededRequireForId = Suggestion?.Id;

        if(added && AcceptedFieldNamesChanged.HasDelegate)
            await AcceptedFieldNamesChanged.InvokeAsync(AcceptedFieldNames);
    }

    bool IsRequired(string fieldName) =>
        RequireFields is not null && RequireFields.Contains(fieldName);

    static Dictionary<string, JsonElement> ParseJsonObject(string json)
    {
        if(string.IsNullOrWhiteSpace(json)) return new Dictionary<string, JsonElement>(StringComparer.Ordinal);
        try
        {
            return JsonSerializer.Deserialize<Dictionary<string, JsonElement>>(json) ??
                   new Dictionary<string, JsonElement>(StringComparer.Ordinal);
        }
        catch { return new Dictionary<string, JsonElement>(StringComparer.Ordinal); }
    }

    SuggestionFieldDescriptor GetFieldDescriptor(string fieldName)
    {
        if(_metadata is not null && _metadata.FieldsByName.TryGetValue(fieldName, out SuggestionFieldDescriptor d))
            return d;
        return null;
    }

    /// <summary>
    ///     Resolve the rendering kind for a field. First checks the static descriptor; falls
    ///     back to the metadata's <see cref="SuggestionMetadata.GetFieldKind" /> hook so dynamic
    ///     field-name patterns (e.g. <c>gpus.add.&lt;uuid&gt;</c>) can map to JunctionAdd /
    ///     JunctionRemove kinds without a static <see cref="SuggestionFieldDescriptor" />.
    /// </summary>
    SuggestionFieldKind ResolveFieldKind(string fieldName)
    {
        SuggestionFieldDescriptor d = GetFieldDescriptor(fieldName);
        if(d is not null) return d.Kind;
        return _metadata?.GetFieldKind(fieldName) ?? SuggestionFieldKind.Text;
    }

    string FormatLabel(string fieldName)
    {
        SuggestionFieldDescriptor d = GetFieldDescriptor(fieldName);
        if(d is not null) return L[d.LabelKey];
        string key = _metadata?.GetFieldLabelKey(fieldName) ?? fieldName;
        return L[key];
    }

    string FormatValue(string fieldName, JsonElement value)
    {
        if(value.ValueKind == JsonValueKind.Undefined || value.ValueKind == JsonValueKind.Null) return "—";

        if(_metadata is not null)
            return _metadata.FormatDisplayValue(fieldName, value);

        return value.ValueKind switch
        {
            JsonValueKind.String => value.GetString() ?? string.Empty,
            JsonValueKind.True   => "true",
            JsonValueKind.False  => "false",
            _                    => value.ToString()
        };
    }

    string FormatCurrent(string fieldName, JsonElement value)
    {
        if(CurrentLabels is not null && CurrentLabels.TryGetValue(fieldName, out string label) &&
           !string.IsNullOrEmpty(label))
            return label;
        return FormatValue(fieldName, value);
    }

    string FormatSuggested(string fieldName, JsonElement value)
    {
        if(SuggestedLabels is not null && SuggestedLabels.TryGetValue(fieldName, out string label) &&
           !string.IsNullOrEmpty(label))
            return label;
        return FormatValue(fieldName, value);
    }

    static string JsonElementToText(JsonElement value)
    {
        if(value.ValueKind == JsonValueKind.Undefined || value.ValueKind == JsonValueKind.Null) return string.Empty;
        return value.ValueKind == JsonValueKind.String ? value.GetString() ?? string.Empty : value.ToString();
    }

    RenderFragment MarkdownDiffMarkup(DiffPaneModel diff) => builder =>
    {
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "suggestion-markdown-diff");
        builder.AddAttribute(2, "style",
                             "font-family: var(--mud-default-font-family-monospace, ui-monospace, SFMono-Regular, Menlo, Consolas, monospace); " +
                             "font-size: 0.85rem; line-height: 1.5; max-height: 500px; overflow: auto; " +
                             "border: 1px solid var(--mud-palette-lines-default); border-radius: 4px; padding: 4px 0; " +
                             "background: var(--mud-palette-surface);");
        int seq = 100;
        foreach(DiffPiece line in diff.Lines)
        {
            string text   = line.Text ?? string.Empty;
            string prefix = line.Type switch
            {
                ChangeType.Inserted => "+ ",
                ChangeType.Deleted  => "- ",
                _                   => "  "
            };
            string style = line.Type switch
            {
                ChangeType.Inserted =>
                    "background-color: rgba(46, 160, 67, 0.18); border-left: 3px solid var(--mud-palette-success); padding: 2px 6px; white-space: pre-wrap; color: var(--mud-palette-text-primary);",
                ChangeType.Deleted =>
                    "background-color: rgba(248, 81, 73, 0.18); border-left: 3px solid var(--mud-palette-error); padding: 2px 6px; white-space: pre-wrap; color: var(--mud-palette-text-primary); text-decoration: line-through;",
                _ =>
                    "padding: 2px 6px; white-space: pre-wrap; color: var(--mud-palette-text-secondary);"
            };
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "style", style);
            builder.AddContent(seq++, prefix + text);
            builder.CloseElement();
        }
        builder.CloseElement();
    };

    async Task ToggleAccepted(string fieldName, bool isChecked)
    {
        // Required fields cannot be toggled off (the checkbox is also disabled visually).
        if(!isChecked && IsRequired(fieldName)) return;

        AcceptedFieldNames ??= new HashSet<string>(StringComparer.Ordinal);
        if(isChecked) AcceptedFieldNames.Add(fieldName);
        else          AcceptedFieldNames.Remove(fieldName);

        if(AcceptedFieldNamesChanged.HasDelegate)
            await AcceptedFieldNamesChanged.InvokeAsync(AcceptedFieldNames);
    }

    /// <summary>
    ///     Custom renderer for <see cref="SuggestionEntityType.GpuPhoto" /> batch suggestions.
    ///     The generic field-by-field table doesn't fit a 1-15-photo array payload, so this
    ///     branch parses the suggestion-level <c>license_id</c> + <c>source_url</c> ONCE at
    ///     the top, then iterates the <c>photos</c> JSON array and renders one MudPaper card
    ///     per photo with a thumbnail (fetched via JS interop with the JWT) + comment + a
    ///     per-photo Accept checkbox bound to the <c>photo.&lt;guid&gt;</c> field-name key.
    /// </summary>
    RenderFragment RenderGpuPhotoBatch() => __builder =>
    {
        string licenseLabel = SuggestedLabels is not null &&
                              SuggestedLabels.TryGetValue("license_id", out string lic) &&
                              !string.IsNullOrEmpty(lic)
                                  ? lic
                                  : (_suggestedDict.TryGetValue("license_id", out JsonElement lje)
                                         ? "#" + JsonElementToText(lje)
                                         : "");

        string sourceUrl = _suggestedDict.TryGetValue("source_url", out JsonElement sje)
                               ? JsonElementToText(sje)
                               : "";

        List<JsonElement> photos = _suggestedDict.TryGetValue("photos", out JsonElement pje) &&
                                   pje.ValueKind == JsonValueKind.Array
                                       ? pje.EnumerateArray().ToList()
                                       : new List<JsonElement>();

        int totalPhotos    = photos.Count;
        int acceptedPhotos = AcceptedFieldNames?.Count(k => k.StartsWith("photo.", StringComparison.Ordinal)) ?? 0;

        <MudPaper Outlined="true" Class="pa-3 mb-3">
            <MudText Typo="Typo.subtitle2" Class="mb-2">@L["Batch metadata (applies to every accepted photo)"]</MudText>
            <MudStack Row="true" Spacing="3">
                <MudStack Spacing="0" Style="flex: 1;">
                    <MudText Typo="Typo.caption">@L["License"]</MudText>
                    <MudText Typo="Typo.body2"><strong>@licenseLabel</strong></MudText>
                </MudStack>
                <MudStack Spacing="0" Style="flex: 2;">
                    <MudText Typo="Typo.caption">@L["Source URL"]</MudText>
                    @if(string.IsNullOrEmpty(sourceUrl))
                    {
                        <MudText Typo="Typo.body2" Class="text-muted">@L["(none)"]</MudText>
                    }
                    else
                    {
                        <MudLink Href="@sourceUrl" Target="_blank" Underline="Underline.Always">@sourceUrl</MudLink>
                    }
                </MudStack>
            </MudStack>
        </MudPaper>

        <MudText Typo="Typo.body2" Class="mb-2">
            @string.Format(L["Accepting {0} of {1} photo(s). Rejected photos and their pending files will be deleted on submit."].Value, acceptedPhotos, totalPhotos)
        </MudText>

        <MudStack Spacing="2" Class="mb-2">
            @for(int i = 0; i < photos.Count; i++)
            {
                JsonElement photo = photos[i];
                string guidStr = photo.TryGetProperty("guid", out JsonElement gj) && gj.ValueKind == JsonValueKind.String
                                     ? gj.GetString()
                                     : "";
                string extension = photo.TryGetProperty("extension", out JsonElement xj) && xj.ValueKind == JsonValueKind.String
                                       ? xj.GetString()
                                       : "";
                string comment = photo.TryGetProperty("comment", out JsonElement cj) && cj.ValueKind == JsonValueKind.String
                                     ? cj.GetString()
                                     : "";
                if(string.IsNullOrEmpty(guidStr) || !Guid.TryParse(guidStr, out _)) continue;

                string acceptKey = "photo." + guidStr;
                bool   accepted  = AcceptedFieldNames is not null && AcceptedFieldNames.Contains(acceptKey);
                string imgId     = "gpu-photo-pending-" + guidStr.Replace("-", "");
                int    photoNum  = i + 1;

                // Register the img element id → guid pair so OnAfterRenderAsync can fetch the
                // blob via JS interop with the JWT in an Authorization header.
                _pendingImageRefs[imgId] = guidStr;

                <MudPaper Outlined="true" Class="pa-3" @key="@guidStr">
                    <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Start">
                        <div style="width: 120px; height: 120px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; background: var(--mud-palette-background-grey); border-radius: 4px; cursor: pointer;"
                             @onclick="@(() => OpenImageInNewTab(guidStr, true))">
                            <img id="@imgId" alt="@($"Photo {photoNum}")"
                                 style="max-width: 120px; max-height: 120px; object-fit: contain; border-radius: 4px;"/>
                        </div>
                        <MudStack Spacing="1" Style="flex: 1; min-width: 0;">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <MudText Typo="Typo.body2"><strong>@($"Photo {photoNum}")</strong> <span class="text-muted">— @extension</span></MudText>
                                <MudCheckBox T="bool" Value="@accepted"
                                             ValueChanged="@(v => ToggleAccepted(acceptKey, v))"
                                             Disabled="@ReadOnly"
                                             Label="@L["Accept this photo"]"/>
                            </MudStack>
                            @if(!string.IsNullOrEmpty(comment))
                            {
                                <MudText Typo="Typo.body2" Class="mt-1"><em>@comment</em></MudText>
                            }
                        </MudStack>
                    </MudStack>
                </MudPaper>
            }
        </MudStack>
    };

    /// <summary>
    ///     Custom renderer for <see cref="SuggestionEntityType.ProcessorPhoto" /> batch
    ///     suggestions. Mirrors <see cref="RenderGpuPhotoBatch" /> verbatim — only the
    ///     thumbnail-fetch JS module differs (handled in OnAfterRenderAsync via the
    ///     entity-type switch).
    /// </summary>
    RenderFragment RenderProcessorPhotoBatch() => __builder =>
    {
        string licenseLabel = SuggestedLabels is not null &&
                              SuggestedLabels.TryGetValue("license_id", out string lic) &&
                              !string.IsNullOrEmpty(lic)
                                  ? lic
                                  : (_suggestedDict.TryGetValue("license_id", out JsonElement lje)
                                         ? "#" + JsonElementToText(lje)
                                         : "");

        string sourceUrl = _suggestedDict.TryGetValue("source_url", out JsonElement sje)
                               ? JsonElementToText(sje)
                               : "";

        List<JsonElement> photos = _suggestedDict.TryGetValue("photos", out JsonElement pje) &&
                                   pje.ValueKind == JsonValueKind.Array
                                       ? pje.EnumerateArray().ToList()
                                       : new List<JsonElement>();

        int totalPhotos    = photos.Count;
        int acceptedPhotos = AcceptedFieldNames?.Count(k => k.StartsWith("photo.", StringComparison.Ordinal)) ?? 0;

        <MudPaper Outlined="true" Class="pa-3 mb-3">
            <MudText Typo="Typo.subtitle2" Class="mb-2">@L["Batch metadata (applies to every accepted photo)"]</MudText>
            <MudStack Row="true" Spacing="3">
                <MudStack Spacing="0" Style="flex: 1;">
                    <MudText Typo="Typo.caption">@L["License"]</MudText>
                    <MudText Typo="Typo.body2"><strong>@licenseLabel</strong></MudText>
                </MudStack>
                <MudStack Spacing="0" Style="flex: 2;">
                    <MudText Typo="Typo.caption">@L["Source URL"]</MudText>
                    @if(string.IsNullOrEmpty(sourceUrl))
                    {
                        <MudText Typo="Typo.body2" Class="text-muted">@L["(none)"]</MudText>
                    }
                    else
                    {
                        <MudLink Href="@sourceUrl" Target="_blank" Underline="Underline.Always">@sourceUrl</MudLink>
                    }
                </MudStack>
            </MudStack>
        </MudPaper>

        <MudText Typo="Typo.body2" Class="mb-2">
            @string.Format(L["Accepting {0} of {1} photo(s). Rejected photos and their pending files will be deleted on submit."].Value, acceptedPhotos, totalPhotos)
        </MudText>

        <MudStack Spacing="2" Class="mb-2">
            @for(int i = 0; i < photos.Count; i++)
            {
                JsonElement photo = photos[i];
                string guidStr = photo.TryGetProperty("guid", out JsonElement gj) && gj.ValueKind == JsonValueKind.String
                                     ? gj.GetString()
                                     : "";
                string extension = photo.TryGetProperty("extension", out JsonElement xj) && xj.ValueKind == JsonValueKind.String
                                       ? xj.GetString()
                                       : "";
                string comment = photo.TryGetProperty("comment", out JsonElement cj) && cj.ValueKind == JsonValueKind.String
                                     ? cj.GetString()
                                     : "";
                if(string.IsNullOrEmpty(guidStr) || !Guid.TryParse(guidStr, out _)) continue;

                string acceptKey = "photo." + guidStr;
                bool   accepted  = AcceptedFieldNames is not null && AcceptedFieldNames.Contains(acceptKey);
                string imgId     = "processor-photo-pending-" + guidStr.Replace("-", "");
                int    photoNum  = i + 1;

                // Register the img element id → guid pair so OnAfterRenderAsync can fetch the
                // blob via JS interop with the JWT in an Authorization header.
                _pendingImageRefs[imgId] = guidStr;

                <MudPaper Outlined="true" Class="pa-3" @key="@guidStr">
                    <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Start">
                        <div style="width: 120px; height: 120px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; background: var(--mud-palette-background-grey); border-radius: 4px; cursor: pointer;"
                             @onclick="@(() => OpenImageInNewTab(guidStr, true))">
                            <img id="@imgId" alt="@($"Photo {photoNum}")"
                                 style="max-width: 120px; max-height: 120px; object-fit: contain; border-radius: 4px;"/>
                        </div>
                        <MudStack Spacing="1" Style="flex: 1; min-width: 0;">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <MudText Typo="Typo.body2"><strong>@($"Photo {photoNum}")</strong> <span class="text-muted">— @extension</span></MudText>
                                <MudCheckBox T="bool" Value="@accepted"
                                             ValueChanged="@(v => ToggleAccepted(acceptKey, v))"
                                             Disabled="@ReadOnly"
                                             Label="@L["Accept this photo"]"/>
                            </MudStack>
                            @if(!string.IsNullOrEmpty(comment))
                            {
                                <MudText Typo="Typo.body2" Class="mt-1"><em>@comment</em></MudText>
                            }
                        </MudStack>
                    </MudStack>
                </MudPaper>
            }
        </MudStack>
    };
}