@using System
@using System.Globalization
@using System.Linq
@using System.Text.Json
@using System.Threading
@using Marechai.ApiClient.Models
@using Marechai.Data
@using Marechai.Services
@using Marechai.Suggestions
@using Marechai.Suggestions.Metadata

@inject IStringLocalizer<SoftwareService> L
@inject ISnackbar          Snackbar
@inject SoftwareService    SoftwareService
@inject SuggestionsService SuggestionsService

@*
    Dedicated suggestion dialog for editing the Companies card of a Software entry.
    Companion to SoftwareSuggestionDialog (which handles General Info scalars + Genres).

    The SoftwareCompanyRole junction has a 3-column composite primary key
    (SoftwareId ulong + CompanyId int + RoleId char(3)) with NO surrogate Id, so the
    remove token is the 2-component composite "{companyId}_{roleId}" rather than a
    row id. Underscore is safe because every seeded SoftwareRole id is 3 lowercase
    ASCII letters with no underscore. The same company CAN be linked under DIFFERENT
    roles (publisher + developer), so dedup is on the full triple.

    Wire shape: companies.add.<uuid> = {company_id, role_id}; companies.remove.<token>
    = null. Server-side dispatch goes through the existing SoftwareSuggestionApplier
    (entity_type = SuggestionEntityType.Software) — the applier and metadata both
    accept companies.* keys.
*@

<MudDialog>
    <DialogContent>
        @if(_loading)
        {
            <MudProgressLinear Indeterminate="true"/>
        }
        else
        {
            <MudText Typo="Typo.body2" Class="mb-3">
                @L["Edit any field or junction below. Only your changes will be sent for review; an administrator can accept or reject each one independently."]
            </MudText>

            <MudPaper Outlined="true" Class="pa-3 mb-3">
                @foreach(SoftwareCompanyRoleDto c in _companyRows ?? new())
                {
                    string token   = $"{c.CompanyId}_{c.RoleId}";
                    bool   removed = _companyRemoveTokens.Contains(token);
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-1">
                        <MudText Style="@(removed ? "text-decoration: line-through;" : "")">@FormatCompany(c)</MudText>
                        @if(removed)
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default"
                                       OnClick="@(() => _companyRemoveTokens.Remove(token))">@L["Undo"]</MudButton>
                        }
                        else
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                           OnClick="@(() => _companyRemoveTokens.Add(token))"/>
                        }
                    </MudStack>
                }
                @foreach(KeyValuePair<string, JunctionAddState> kv in _companyAdds)
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-1">
                        <MudText><strong>+ @kv.Value.Display</strong></MudText>
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default"
                                   OnClick="@(() => _companyAdds.Remove(kv.Key))">@L["Undo"]</MudButton>
                    </MudStack>
                }
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-2">
                    <MudAutocomplete T="CompanyDto" Value="@_pickCompany" ValueChanged="@(c => { _pickCompany = c; })"
                                     SearchFunc="SearchCompanies" Clearable="true"
                                     ToStringFunc="@(c => c?.Name ?? string.Empty)"
                                     Style="flex: 1;"/>
                    <MudSelect T="SoftwareRoleDto" Value="@_pickCompanyRole" ValueChanged="@(r => { _pickCompanyRole = r; })"
                               Label="@L["Role"]" Style="max-width: 200px;"
                               ToStringFunc="@(r => r?.Name ?? string.Empty)">
                        @foreach(SoftwareRoleDto role in _roles ?? new())
                        {
                            <MudSelectItem T="SoftwareRoleDto" Value="role">@role.Name</MudSelectItem>
                        }
                    </MudSelect>
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                               OnClick="AddCompany"
                               Disabled="@(_pickCompany is null || _pickCompanyRole is null)">@L["Add company"]</MudButton>
                </MudStack>
            </MudPaper>

            <MudTextField T="string" Label="@L["Optional comment (References, sources, etc...)"]" Lines="2"
                          MaxLength="2000" @bind-Value="_userComment"/>

            @if(!string.IsNullOrWhiteSpace(_validationError))
            {
                <MudAlert Severity="Severity.Error" Class="mt-2">@_validationError</MudAlert>
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit"
                   Disabled="@(_loading || _submitting || !HasAnyChange())">
            @if(_submitting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true"/>
            }
            else
            {
                @L["Submit suggestion"]
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code
{
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; }

    [Parameter] public long EntityId { get; set; }

    sealed class JunctionAddState
    {
        public Dictionary<string, object> Payload { get; set; }
        public string                     Display { get; set; }
    }

    bool   _loading = true;
    bool   _submitting;
    string _validationError;
    string _userComment;

    // Picker source lists
    List<CompanyDto>      _allCompanies;
    List<SoftwareRoleDto> _roles;

    // Existing junction rows (read once on init, displayed verbatim).
    List<SoftwareCompanyRoleDto> _companyRows;

    // Pending company operations. Removes track a "{companyId}_{roleId}" string token
    // because SoftwareCompanyRole has a 3-column composite key with no surrogate Id.
    HashSet<string>                      _companyRemoveTokens = new();
    Dictionary<string, JunctionAddState> _companyAdds         = new();

    // Picker state (single flat panel — no per-role split).
    CompanyDto      _pickCompany;
    SoftwareRoleDto _pickCompanyRole;

    protected override async Task OnInitializedAsync()
    {
        Task<List<CompanyDto>>             allCompaniesT = SoftwareService.GetAllCompaniesAsync();
        Task<List<SoftwareRoleDto>>        rolesT        = SoftwareService.GetSoftwareRolesAsync();
        Task<List<SoftwareCompanyRoleDto>> companyRowsT  = SoftwareService.GetCompanyRolesAsync((int)EntityId);
        await Task.WhenAll(allCompaniesT, rolesT, companyRowsT);

        _allCompanies = allCompaniesT.Result;
        _roles        = rolesT.Result;
        _companyRows  = companyRowsT.Result;

        _loading = false;
    }

    Task<IEnumerable<CompanyDto>> SearchCompanies(string value, CancellationToken ct)
    {
        IEnumerable<CompanyDto> r = _allCompanies ?? [];
        if(!string.IsNullOrWhiteSpace(value))
            r = r.Where(c => c.Name?.Contains(value, StringComparison.OrdinalIgnoreCase) ?? false);
        return Task.FromResult(r.Take(50));
    }

    string FormatCompany(SoftwareCompanyRoleDto c)
    {
        string name = c?.Company ?? $"#{c?.CompanyId}";
        return string.IsNullOrEmpty(c?.Role) ? name : $"{name} ({c.Role})";
    }

    static string NewKey(string group, string op) => $"{group}.{op}.{Guid.NewGuid():N}";

    void AddCompany()
    {
        if(_pickCompany is null || _pickCompanyRole is null) return;
        if(!_pickCompany.Id.HasValue || string.IsNullOrEmpty(_pickCompanyRole.Id)) return;

        int    cid = _pickCompany.Id.Value;
        string rid = _pickCompanyRole.Id;

        // Local dedup against existing rows (skip pairs already removed) + queued adds.
        // The same company under a different role is a DIFFERENT pair and is allowed.
        string token = $"{cid}_{rid}";
        if(_companyRows is not null)
            foreach(SoftwareCompanyRoleDto c in _companyRows)
                if(c.CompanyId == cid && string.Equals(c.RoleId, rid, StringComparison.Ordinal) &&
                   !_companyRemoveTokens.Contains(token))
                    return;
        foreach(JunctionAddState a in _companyAdds.Values)
        {
            int?   existCid = a.Payload != null && a.Payload.TryGetValue("company_id", out object cv) && cv is int cvi ? cvi : (int?)null;
            string existRid = a.Payload != null && a.Payload.TryGetValue("role_id",    out object rv) ? rv as string : null;
            if(existCid == cid && string.Equals(existRid, rid, StringComparison.Ordinal)) return;
        }

        string key = NewKey(SoftwareSuggestionMetadata.GroupCompanies, "add");
        _companyAdds[key] = new JunctionAddState
        {
            Payload = new Dictionary<string, object>(StringComparer.Ordinal)
            {
                ["company_id"] = cid,
                ["role_id"]    = rid
            },
            Display = $"{_pickCompany.Name} ({_pickCompanyRole.Name})"
        };
        _pickCompany     = null;
        _pickCompanyRole = null;
    }

    bool HasAnyChange() => _companyAdds.Count > 0 || _companyRemoveTokens.Count > 0;

    void Cancel() => MudDialog.Cancel();

    async Task Submit()
    {
        _validationError = null;
        if(_loading) return;

        if(!HasAnyChange())
        {
            _validationError = L["No changes detected — modify at least one field before submitting."];
            return;
        }

        var diff = new Dictionary<string, object>(StringComparer.Ordinal);

        foreach(KeyValuePair<string, JunctionAddState> kv in _companyAdds)
            diff[kv.Key] = kv.Value.Payload;
        foreach(string token in _companyRemoveTokens)
            diff[$"{SoftwareSuggestionMetadata.GroupCompanies}.remove.{token}"] = null;

        _submitting = true;
        try
        {
            string json = JsonSerializer.Serialize(diff);
            var dto = new SuggestionDto
            {
                EntityType          = (int?)SuggestionEntityType.Software,
                EntityId            = EntityId,
                Status              = (int?)SuggestionStatus.Pending,
                UserComment         = string.IsNullOrWhiteSpace(_userComment) ? null : _userComment.Trim(),
                SuggestedValuesJson = json
            };

            var (created, error) = await SuggestionsService.CreateAsync(dto);

            if(created is null)
            {
                _validationError = string.IsNullOrWhiteSpace(error) ? L["Failed to submit suggestion."].Value : error;
                return;
            }

            Snackbar.Add(L["Suggestion submitted. An administrator will review it."], Severity.Success);
            MudDialog.Close(DialogResult.Ok(created));
        }
        finally
        {
            _submitting = false;
        }
    }
}
