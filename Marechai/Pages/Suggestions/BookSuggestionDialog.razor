    // ───────────────────────────── Cover upload (direct browser → API) ─────────────────────────────

    /// <summary>
    ///     Trigger the hidden &lt;input type="file"&gt; via a JS click. Cleaner UX than rendering
    ///     a raw file input next to the styled buttons.
    /// </summary>
    async Task TriggerCoverPicker()
    {
        _coverError = null;
        try { await JS.InvokeVoidAsync("MarechaiPendingCover.clickInput", _coverInputId); }
        catch(Exception ex) { _coverError = ex.Message; }
    }

    /// <summary>
    ///     Fired by the @onchange on the hidden &lt;input type="file"&gt; right after the user
    ///     selects a file. The actual upload happens in JS so the file bytes go directly to
    ///     the API server (single hop) instead of being relayed through SignalR. The Blazor
    ///     side just receives the resulting {guid, extension} for the diff payload.
    /// </summary>
    async Task OnCoverInputChanged()
    {
        _coverError = null;
        _uploadingCover = true;
        StateHasChanged();

        try
        {
            string token = await TokenProvider.GetTokenAsync();
            if(string.IsNullOrEmpty(token))
            {
                _coverError = L["You must be signed in to upload a cover."];
                return;
            }

            // Capture old guid so we can revoke its preview blob URL after the new one
            // takes its place. The server is also told to delete the prior pending file
            // for this (uploader, book) tuple — see PendingImageStore.DeleteByUploaderForEntity.
            string oldGuid = _pendingCoverGuid;

            UploadResult res = IsCreation
                ? await JS.InvokeAsync<UploadResult>(
                      "MarechaiPendingCover.uploadNewBookCover",
                      ApiAssetUrls.BaseUrl, token, _coverInputId)
                : await JS.InvokeAsync<UploadResult>(
                      "MarechaiPendingCover.uploadBookCover",
                      ApiAssetUrls.BaseUrl, token, EntityId, _coverInputId);

            if(res is null || !res.ok || string.IsNullOrEmpty(res.guid))
            {
                _coverError = string.IsNullOrEmpty(res?.error) ? L["Cover upload failed."].Value : res.error;
                return;
            }

            _pendingCoverGuid      = res.guid;
            _pendingCoverExtension = res.extension ?? string.Empty;
            _pendingCoverFilename  = $"{res.guid[..8]}…{(_pendingCoverExtension is { Length: > 0 } ? "." + _pendingCoverExtension : string.Empty)}";

            // After Blazor re-renders the <img> element appears; apply the blob now.
            StateHasChanged();
            await Task.Yield();
            await JS.InvokeVoidAsync("MarechaiPendingCover.applyPendingCoverImage",
                                     ApiAssetUrls.BaseUrl, token, _pendingCoverGuid, _coverImgId);

            // Note: the server already deleted the prior pending file for this (user, book)
            // pair on the new upload, so we don't need to call deletePendingCover for oldGuid.
            _ = oldGuid;
        }
        catch(Exception ex)
        {
            _coverError = ex.Message;
        }
        finally
        {
            _uploadingCover = false;
            StateHasChanged();
        }
    }

    /// <summary>
    ///     Drop the pending cover from this in-flight suggestion. Tells the API to delete
    ///     the file too so we don't leak storage on cancel.
    /// </summary>
    async Task RemovePendingCover()
    {
        _coverError = null;
        if(string.IsNullOrEmpty(_pendingCoverGuid)) return;

        string guidToDelete = _pendingCoverGuid;
        _pendingCoverGuid = null;
        _pendingCoverExtension = null;
        _pendingCoverFilename = null;
        StateHasChanged();

        try
        {
            string token = await TokenProvider.GetTokenAsync();
            if(!string.IsNullOrEmpty(token))
                await JS.InvokeAsync<UploadResult>(
                    "MarechaiPendingCover.deletePendingCover",
                    ApiAssetUrls.BaseUrl, token, guidToDelete);
        }
        catch
        {
            // best-effort — orphan-sweep on review will catch leftovers
        }
    }

    sealed class UploadResult
    {
        public bool   ok        { get; set; }
        public int    status    { get; set; }
        public string guid      { get; set; }
        public string extension { get; set; }
        public string error     { get; set; }
    }

    // ───────────────────────────── Submit ─────────────────────────────

    bool HasAnyChange()
    {
        if(!Equals(_orig_title, _title)) return true;
        if(!Equals(_orig_nativeTitle, _nativeTitle)) return true;
        if(!Equals(_orig_sortTitle, _sortTitle)) return true;
        if(!Equals(_orig_isbn, _isbn)) return true;
        if(!Nullable.Equals(_orig_pages, _pages)) return true;
        if(!Nullable.Equals(_orig_edition, _edition)) return true;
        if(!Nullable.Equals(_orig_published, _published)) return true;
        if(_orig_publishedPrecision != _publishedPrecision) return true;
        if(_orig_countryId != _selectedCountry?.Id) return true;
        if(_orig_previousId != _selectedPrevious?.Id) return true;
        if(_orig_sourceId != _selectedSource?.Id) return true;
        if(!Equals(_orig_internetArchiveUrl, _internetArchiveUrl)) return true;

        if(_peopleAdds.Count + _companyAdds.Count + _machineAdds.Count + _machineFamilyAdds.Count > 0) return true;
        if(_peopleRemoves.Count + _companyRemoves.Count + _machineRemoves.Count + _machineFamilyRemoves.Count > 0) return true;

        if(!string.IsNullOrEmpty(_pendingCoverGuid)) return true;

        return false;
    }

    void Cancel() => MudDialog.Cancel();

    bool HasMandatoryFieldsForCreation() => !string.IsNullOrWhiteSpace(_title);

    async Task Submit()
    {
        _validationError = null;
        if(_loading) return;

        // Title is required: never let the user clear it (edit mode) or omit it (creation mode).
        if(string.IsNullOrWhiteSpace(_title))
        {
            _validationError = L["Title is required."];
            return;
        }

        // ISBN length validation if provided.
        if(!string.IsNullOrWhiteSpace(_isbn))
        {
            string isbn = _isbn.Trim();
            if(isbn.Length < 10 || isbn.Length > 13)
            {
                _validationError = L["ISBN must be between 10 and 13 characters."];
                return;
            }
        }

        var diff = new Dictionary<string, object>(StringComparer.Ordinal);

        if(IsCreation)
        {
            // Brand-new entity: emit every populated scalar plus the cover and all queued
            // junction adds. Remove ops are ignored (no existing rows in creation mode).
            diff[BookSuggestionMetadata.FieldTitle] = _title;
            if(!string.IsNullOrWhiteSpace(_nativeTitle))
                diff[BookSuggestionMetadata.FieldNativeTitle] = _nativeTitle;
            if(!string.IsNullOrWhiteSpace(_sortTitle))
                diff[BookSuggestionMetadata.FieldSortTitle] = _sortTitle;
            if(!string.IsNullOrWhiteSpace(_isbn))
                diff[BookSuggestionMetadata.FieldIsbn] = _isbn;
            if(_pages.HasValue)
                diff[BookSuggestionMetadata.FieldPages] = _pages;
            if(_edition.HasValue)
                diff[BookSuggestionMetadata.FieldEdition] = _edition;
            if(_published.HasValue)
                diff[BookSuggestionMetadata.FieldPublished] = _published.Value.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
            if(_publishedPrecision != 0)
                diff[BookSuggestionMetadata.FieldPublishedPrecision] = _publishedPrecision;
            if(_selectedCountry?.Id is int icid)
                diff[BookSuggestionMetadata.FieldCountryId] = icid;
            if(_selectedPrevious?.Id is long ipid)
                diff[BookSuggestionMetadata.FieldPreviousId] = ipid;
            if(_selectedSource?.Id is long isid)
                diff[BookSuggestionMetadata.FieldSourceId] = isid;
            if(!string.IsNullOrWhiteSpace(_internetArchiveUrl))
                diff[BookSuggestionMetadata.FieldInternetArchiveUrl] = _internetArchiveUrl;
            if(!string.IsNullOrEmpty(_pendingCoverGuid))
                diff[BookSuggestionMetadata.FieldCoverPendingGuid] = _pendingCoverGuid;

            foreach(KeyValuePair<string, JunctionAddState> kv in _peopleAdds)        diff[kv.Key] = kv.Value.Payload;
            foreach(KeyValuePair<string, JunctionAddState> kv in _companyAdds)       diff[kv.Key] = kv.Value.Payload;
            foreach(KeyValuePair<string, JunctionAddState> kv in _machineAdds)       diff[kv.Key] = kv.Value.Payload;
            foreach(KeyValuePair<string, JunctionAddState> kv in _machineFamilyAdds) diff[kv.Key] = kv.Value.Payload;
        }
        else
        {
            if(!Equals(_orig_title, _title))             diff[BookSuggestionMetadata.FieldTitle]       = _title;
            if(!Equals(_orig_nativeTitle, _nativeTitle)) diff[BookSuggestionMetadata.FieldNativeTitle] = _nativeTitle;
            if(!Equals(_orig_sortTitle, _sortTitle))     diff[BookSuggestionMetadata.FieldSortTitle]   = _sortTitle;
            if(!Equals(_orig_isbn, _isbn))               diff[BookSuggestionMetadata.FieldIsbn]        = _isbn;
            if(!Nullable.Equals(_orig_pages, _pages))     diff[BookSuggestionMetadata.FieldPages]      = _pages;
            if(!Nullable.Equals(_orig_edition, _edition)) diff[BookSuggestionMetadata.FieldEdition]    = _edition;
            if(!Nullable.Equals(_orig_published, _published))
                diff[BookSuggestionMetadata.FieldPublished] = _published?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
            if(_orig_publishedPrecision != _publishedPrecision)
                diff[BookSuggestionMetadata.FieldPublishedPrecision] = _publishedPrecision;
            if(_orig_countryId != _selectedCountry?.Id)
                diff[BookSuggestionMetadata.FieldCountryId] = _selectedCountry?.Id;
            if(_orig_previousId != _selectedPrevious?.Id)
                diff[BookSuggestionMetadata.FieldPreviousId] = _selectedPrevious?.Id;
            if(_orig_sourceId != _selectedSource?.Id)
                diff[BookSuggestionMetadata.FieldSourceId] = _selectedSource?.Id;
            if(!Equals(_orig_internetArchiveUrl, _internetArchiveUrl))
                diff[BookSuggestionMetadata.FieldInternetArchiveUrl] = _internetArchiveUrl;

            // Cover-pending: emit the guid only. The applier reads the extension from the
            // pending-image sidecar (so we don't need to round-trip it on the wire).
            if(!string.IsNullOrEmpty(_pendingCoverGuid))
                diff[BookSuggestionMetadata.FieldCoverPendingGuid] = _pendingCoverGuid;

            AddJunctionOps(diff, _peopleAdds,        _peopleRemoves,        BookSuggestionMetadata.GroupPeople);
            AddJunctionOps(diff, _companyAdds,       _companyRemoves,       BookSuggestionMetadata.GroupCompanies);
            AddJunctionOps(diff, _machineAdds,       _machineRemoves,       BookSuggestionMetadata.GroupMachines);
            AddJunctionOps(diff, _machineFamilyAdds, _machineFamilyRemoves, BookSuggestionMetadata.GroupMachineFamilies);

            if(diff.Count == 0)
            {
                _validationError = L["No changes detected — modify at least one field before submitting."];
                return;
            }
        }

        _submitting = true;
        try
        {
            string json = JsonSerializer.Serialize(diff);
            var dto = new SuggestionDto
            {
                EntityType          = (int?)SuggestionEntityType.Book,
                EntityId            = IsCreation ? null : EntityId,
                Status              = (int?)SuggestionStatus.Pending,
                UserComment         = string.IsNullOrWhiteSpace(_userComment) ? null : _userComment.Trim(),
                SuggestedValuesJson = json
            };

            var (created, error) = await SuggestionsService.CreateAsync(dto);

            if(created is null)
            {
                _validationError = string.IsNullOrWhiteSpace(error) ? L["Failed to submit suggestion."].Value : error;
                return;
            }

            Snackbar.Add(L["Suggestion submitted. An administrator will review it."], Severity.Success);
            MudDialog.Close(DialogResult.Ok(created));
        }
        finally
        {
            _submitting = false;
        }
    }

    static void AddJunctionOps(Dictionary<string, object> diff,
                               Dictionary<string, JunctionAddState> adds,
                               HashSet<long> removes,
                               string group)
    {
        foreach(KeyValuePair<string, JunctionAddState> kv in adds) diff[kv.Key] = kv.Value.Payload;
        foreach(long id in removes) diff[$"{group}.remove.{id.ToString(CultureInfo.InvariantCulture)}"] = null;
    }
}
