@using System
@using System.Globalization
@using System.Linq
@using System.Text.Json
@using System.Threading
@using Marechai.ApiClient.Models
@using Marechai.Data
@using Marechai.Services
@using Marechai.Suggestions
@using Marechai.Suggestions.Metadata
@using Microsoft.JSInterop

@inject IStringLocalizer<BooksService> L
@inject ISnackbar          Snackbar
@inject BooksService       BooksService
@inject SuggestionsService SuggestionsService
@inject IJSRuntime         JS
@inject TokenProvider      TokenProvider
@inject ApiAssetUrlProvider ApiAssetUrls

@*
    Dedicated suggestion dialog for editing a Book. Mirrors the admin BookDialog editing
    surface but produces a Suggestion JSON payload instead of writing directly. Each junction
    add/remove operation is queued in local state and serialised under a unique field-name
    key (<group>.add.<uuid> or <group>.remove.<row_id>) so the admin can later accept or
    reject each operation independently in the diff panel.
*@

<MudDialog>
    <DialogContent>
        @if(_loading)
        {
            <MudProgressLinear Indeterminate="true"/>
        }
        else
        {
            <MudText Typo="Typo.body2" Class="mb-3">
                @if(IsCreation)
                {
                    @L["Fill in the fields below to suggest a new book. Title is required; you can attach a cover image and queue people, companies, machines and machine families that will all be added together once an administrator accepts the suggestion."]
                }
                else
                {
                    @L["Edit any field or junction below. Only your changes will be sent for review; an administrator can accept or reject each one independently."]
                }
            </MudText>

            @* ── Scalar fields ── *@
            <MudPaper Outlined="true" Class="pa-3 mb-3">
                <MudText Typo="Typo.h6" Class="mb-2">@L["General"]</MudText>

                <MudTextField T="string" Label="@L["Title"]"
                              MaxLength="255"
                              Value="@_title"
                              ValueChanged="@(v => { _title = v; })"
                              Required="true"
                              Class="mb-3"/>

                <MudTextField T="string" Label="@L["Native title"]"
                              MaxLength="255"
                              Value="@_nativeTitle"
                              ValueChanged="@(v => { _nativeTitle = v; })"
                              Class="mb-3"/>

                <MudTextField T="string" Label="@L["Sort title"]"
                              MaxLength="255"
                              Value="@_sortTitle"
                              ValueChanged="@(v => { _sortTitle = v; })"
                              Class="mb-3"/>

                <MudTextField T="string" Label="@L["ISBN"]"
                              MaxLength="13"
                              Value="@_isbn"
                              ValueChanged="@(v => { _isbn = v; })"
                              Class="mb-3"/>

                <MudStack Row="true" Spacing="2" Class="mb-3">
                    <MudNumericField T="int?" Label="@L["Pages"]" Value="@_pages"
                                     ValueChanged="@(v => { _pages = v; })" Clearable="true" Style="flex: 1;"/>
                    <MudNumericField T="int?" Label="@L["Edition"]" Value="@_edition"
                                     ValueChanged="@(v => { _edition = v; })" Clearable="true" Style="flex: 1;"/>
                </MudStack>

                <MudDatePicker Label="@L["Published"]" Editable="true" Clearable="true"
                               Date="@_published"
                               DateChanged="@(d => { _published = d; })" Class="mb-3"/>

                <MudSelect T="int" Label="@L["Date precision"]"
                           Value="@_publishedPrecision"
                           ValueChanged="@(v => { _publishedPrecision = v; })" Class="mb-3">
                    <MudSelectItem T="int" Value="0">@L["Full date"]</MudSelectItem>
                    <MudSelectItem T="int" Value="1">@L["Month and year only"]</MudSelectItem>
                    <MudSelectItem T="int" Value="2">@L["Year only"]</MudSelectItem>
                </MudSelect>

                <MudAutocomplete T="Iso31661NumericDto" Label="@L["Country"]"
                                 Value="@_selectedCountry"
                                 ValueChanged="@(c => { _selectedCountry = c; })"
                                 SearchFunc="SearchCountries"
                                 ToStringFunc="@(c => c?.Name ?? string.Empty)"
                                 Clearable="true"
                                 Class="mb-3"/>

                <MudAutocomplete T="BookDto" Label="@L["Previous book"]"
                                 Value="@_selectedPrevious"
                                 ValueChanged="@(b => { _selectedPrevious = b; })"
                                 SearchFunc="SearchPreviousBooks"
                                 ToStringFunc="@(b => b?.Title ?? string.Empty)"
                                 Clearable="true"
                                 Class="mb-3"/>

                <MudAutocomplete T="BookDto" Label="@L["Source book"]"
                                 Value="@_selectedSource"
                                 ValueChanged="@(b => { _selectedSource = b; })"
                                 SearchFunc="SearchSourceBooks"
                                 ToStringFunc="@(b => b?.Title ?? string.Empty)"
                                 Clearable="true"
                                 Class="mb-3"/>

                <MudTextField T="string" Label="@L["Internet Archive URL"]"
                              MaxLength="2048"
                              Value="@_internetArchiveUrl"
                              ValueChanged="@(v => { _internetArchiveUrl = v; })"/>
            </MudPaper>

            @* ── Cover ── *@
            <MudPaper Outlined="true" Class="pa-3 mb-3">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2">
                    <MudText Typo="Typo.h6">@L["Cover"]</MudText>
                </MudStack>
                <MudText Typo="Typo.caption" Class="mb-2">
                    @L["Allowed: JPG, PNG, WebP up to 50 MB. The image is uploaded directly to the API for review and only takes effect once an administrator accepts the suggestion."]
                </MudText>

                @* Plain HTML file input — uploaded directly to the API via JS interop
                   (NOT Blazor's <InputFile>, which would round-trip the file through
                   the SignalR circuit and double the bandwidth). The input is hidden
                   and triggered by the buttons below. The change handler is wired in JS
                   via the helper's clickInput; the actual file read happens in JS. *@
                <input type="file" id="@_coverInputId" accept="image/jpeg,image/png,image/webp" style="display:none"
                       @onchange="OnCoverInputChanged"/>

                @if(string.IsNullOrEmpty(_pendingCoverGuid))
                {
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.UploadFile"
                               Disabled="@_uploadingCover" OnClick="TriggerCoverPicker">
                        @if(_uploadingCover)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2"/>
                        }
                        @L["Upload cover"]
                    </MudButton>
                }
                else
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <img id="@_coverImgId" alt="Pending cover" style="max-height: 120px; max-width: 90px; object-fit: contain; border-radius: 4px; box-shadow: 0 1px 4px rgba(0,0,0,0.2);"/>
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.body2"><strong>@_pendingCoverFilename</strong></MudText>
                            <MudStack Row="true" Spacing="1">
                                <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                           StartIcon="@Icons.Material.Filled.SwapHoriz"
                                           Disabled="@_uploadingCover" OnClick="TriggerCoverPicker">@L["Replace cover"]</MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error"
                                           StartIcon="@Icons.Material.Filled.Delete"
                                           Disabled="@_uploadingCover" OnClick="RemovePendingCover">@L["Remove"]</MudButton>
                            </MudStack>
                        </MudStack>
                    </MudStack>
                }

                @if(!string.IsNullOrEmpty(_coverError))
                {
                    <MudAlert Severity="Severity.Error" Class="mt-2">@_coverError</MudAlert>
                }
            </MudPaper>

            @* ── Junctions ── *@
            <MudExpansionPanels MultiExpansion="true" Class="mb-3">

                @* People *@
                <MudExpansionPanel Text="@($"{L["People"]} ({CountActive(_peopleRows, _peopleRemoves) + _peopleAdds.Count})")"
                                   Expanded="@HasOps(_peopleAdds, _peopleRemoves)">
                    @foreach(PersonByBookDto p in _peopleRows ?? new())
                    {
                        bool removed = _peopleRemoves.Contains(p.Id ?? 0);
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-1">
                            <MudText Style="@(removed ? "text-decoration: line-through;" : "")">@FormatPerson(p)</MudText>
                            @if(removed)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default"
                                           OnClick="@(() => UndoRemove(_peopleRemoves, p.Id ?? 0))">@L["Undo"]</MudButton>
                            }
                            else
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                               OnClick="@(() => MarkRemove(_peopleRemoves, p.Id ?? 0))"/>
                            }
                        </MudStack>
                    }
                    @foreach(KeyValuePair<string, JunctionAddState> kv in _peopleAdds)
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-1">
                            <MudText><strong>+ @kv.Value.Display</strong></MudText>
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default"
                                       OnClick="@(() => _peopleAdds.Remove(kv.Key))">@L["Undo"]</MudButton>
                        </MudStack>
                    }
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-2">
                        <MudAutocomplete T="PersonDto" Value="@_pickPerson" ValueChanged="@(p => { _pickPerson = p; })"
                                         SearchFunc="SearchPeople" Clearable="true"
                                         ToStringFunc="@(p => p is null ? string.Empty : FormatPersonDto(p))"
                                         Style="flex: 1;"/>
                        <MudSelect T="DocumentRoleDto" Value="@_pickPersonRole" ValueChanged="@(r => { _pickPersonRole = r; })"
                                   Label="@L["Role"]" Style="max-width: 200px;"
                                   ToStringFunc="@(r => r?.Name ?? string.Empty)">
                            @foreach(DocumentRoleDto role in _roles ?? new())
                            {
                                <MudSelectItem T="DocumentRoleDto" Value="role">@role.Name</MudSelectItem>
                            }
                        </MudSelect>
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                   OnClick="AddPerson"
                                   Disabled="@(_pickPerson is null || _pickPersonRole is null)">@L["Add person"]</MudButton>
                    </MudStack>
                </MudExpansionPanel>

                @* Companies *@
                <MudExpansionPanel Text="@($"{L["Companies"]} ({CountActive(_companyRows, _companyRemoves) + _companyAdds.Count})")"
                                   Expanded="@HasOps(_companyAdds, _companyRemoves)">
                    @foreach(CompanyByBookDto c in _companyRows ?? new())
                    {
                        bool removed = _companyRemoves.Contains(c.Id ?? 0);
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-1">
                            <MudText Style="@(removed ? "text-decoration: line-through;" : "")">@FormatCompany(c)</MudText>
                            @if(removed)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default"
                                           OnClick="@(() => UndoRemove(_companyRemoves, c.Id ?? 0))">@L["Undo"]</MudButton>
                            }
                            else
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                               OnClick="@(() => MarkRemove(_companyRemoves, c.Id ?? 0))"/>
                            }
                        </MudStack>
                    }
                    @foreach(KeyValuePair<string, JunctionAddState> kv in _companyAdds)
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-1">
                            <MudText><strong>+ @kv.Value.Display</strong></MudText>
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default"
                                       OnClick="@(() => _companyAdds.Remove(kv.Key))">@L["Undo"]</MudButton>
                        </MudStack>
                    }
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-2">
                        <MudAutocomplete T="CompanyDto" Value="@_pickCompany" ValueChanged="@(c => { _pickCompany = c; })"
                                         SearchFunc="SearchCompanies" Clearable="true"
                                         ToStringFunc="@(c => c?.Name ?? string.Empty)"
                                         Style="flex: 1;"/>
                        <MudSelect T="DocumentRoleDto" Value="@_pickCompanyRole" ValueChanged="@(r => { _pickCompanyRole = r; })"
                                   Label="@L["Role"]" Style="max-width: 200px;"
                                   ToStringFunc="@(r => r?.Name ?? string.Empty)">
                            @foreach(DocumentRoleDto role in _roles ?? new())
                            {
                                <MudSelectItem T="DocumentRoleDto" Value="role">@role.Name</MudSelectItem>
                            }
                        </MudSelect>
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                   OnClick="AddCompany"
                                   Disabled="@(_pickCompany is null || _pickCompanyRole is null)">@L["Add company"]</MudButton>
                    </MudStack>
                </MudExpansionPanel>

                @* Machines *@
                <MudExpansionPanel Text="@($"{L["Machines"]} ({CountActive(_machineRows, _machineRemoves) + _machineAdds.Count})")"
                                   Expanded="@HasOps(_machineAdds, _machineRemoves)">
                    @foreach(BookByMachineDto m in _machineRows ?? new())
                    {
                        bool removed = _machineRemoves.Contains(m.Id ?? 0);
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-1">
                            <MudText Style="@(removed ? "text-decoration: line-through;" : "")">@(m.Machine ?? $"#{m.MachineId}")</MudText>
                            @if(removed)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default"
                                           OnClick="@(() => UndoRemove(_machineRemoves, m.Id ?? 0))">@L["Undo"]</MudButton>
                            }
                            else
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                               OnClick="@(() => MarkRemove(_machineRemoves, m.Id ?? 0))"/>
                            }
                        </MudStack>
                    }
                    @foreach(KeyValuePair<string, JunctionAddState> kv in _machineAdds)
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-1">
                            <MudText><strong>+ @kv.Value.Display</strong></MudText>
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default"
                                       OnClick="@(() => _machineAdds.Remove(kv.Key))">@L["Undo"]</MudButton>
                        </MudStack>
                    }
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-2">
                        <MudAutocomplete T="MachineDto" Value="@_pickMachine" ValueChanged="@(m => { _pickMachine = m; })"
                                         SearchFunc="SearchMachines" Clearable="true"
                                         ToStringFunc="@(m => m?.Name ?? string.Empty)"
                                         Style="flex: 1;"/>
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                   OnClick="AddMachine"
                                   Disabled="@(_pickMachine is null)">@L["Add machine"]</MudButton>
                    </MudStack>
                </MudExpansionPanel>

                @* Machine Families *@
                <MudExpansionPanel Text="@($"{L["Machine families"]} ({CountActive(_machineFamilyRows, _machineFamilyRemoves) + _machineFamilyAdds.Count})")"
                                   Expanded="@HasOps(_machineFamilyAdds, _machineFamilyRemoves)">
                    @foreach(BookByMachineFamilyDto f in _machineFamilyRows ?? new())
                    {
                        bool removed = _machineFamilyRemoves.Contains(f.Id ?? 0);
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-1">
                            <MudText Style="@(removed ? "text-decoration: line-through;" : "")">@(f.MachineFamily ?? $"#{f.MachineFamilyId}")</MudText>
                            @if(removed)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default"
                                           OnClick="@(() => UndoRemove(_machineFamilyRemoves, f.Id ?? 0))">@L["Undo"]</MudButton>
                            }
                            else
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                               OnClick="@(() => MarkRemove(_machineFamilyRemoves, f.Id ?? 0))"/>
                            }
                        </MudStack>
                    }
                    @foreach(KeyValuePair<string, JunctionAddState> kv in _machineFamilyAdds)
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-1">
                            <MudText><strong>+ @kv.Value.Display</strong></MudText>
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default"
                                       OnClick="@(() => _machineFamilyAdds.Remove(kv.Key))">@L["Undo"]</MudButton>
                        </MudStack>
                    }
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-2">
                        <MudAutocomplete T="MachineFamilyDto" Value="@_pickMachineFamily" ValueChanged="@(f => { _pickMachineFamily = f; })"
                                         SearchFunc="SearchMachineFamilies" Clearable="true"
                                         ToStringFunc="@(f => f?.Name ?? string.Empty)"
                                         Style="flex: 1;"/>
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                   OnClick="AddMachineFamily"
                                   Disabled="@(_pickMachineFamily is null)">@L["Add machine family"]</MudButton>
                    </MudStack>
                </MudExpansionPanel>

            </MudExpansionPanels>

            <MudTextField T="string" Label="@L["Optional comment (References, sources, etc...)"]" Lines="2"
                          MaxLength="2000" @bind-Value="_userComment"/>

            @if(!string.IsNullOrWhiteSpace(_validationError))
            {
                <MudAlert Severity="Severity.Error" Class="mt-2">@_validationError</MudAlert>
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit"
                   Disabled="@(_loading || _submitting || (!IsCreation && !HasAnyChange()) || (IsCreation && !HasMandatoryFieldsForCreation()))">
            @if(_submitting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true"/>
            }
            else
            {
                @L["Submit suggestion"]
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code
{
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; }

    [Parameter] public long    EntityId   { get; set; }
    [Parameter] public BookDto CurrentDto { get; set; }

    /// <summary>
    ///     When <c>true</c>, the dialog operates in addition mode: <see cref="CurrentDto" /> is
    ///     ignored, no existing-row queries are issued, the cover upload targets the
    ///     <c>POST /books/cover/pending/new</c> endpoint, and <see cref="Submit" /> emits
    ///     a suggestion with <c>EntityId == null</c>. The submit button is gated on
    ///     <see cref="HasMandatoryFieldsForCreation" /> rather than <see cref="HasAnyChange" />.
    /// </summary>
    [Parameter] public bool IsCreation { get; set; }

    sealed class JunctionAddState
    {
        public Dictionary<string, object> Payload { get; set; }
        public string                     Display { get; set; }
    }

    bool _loading = true;
    bool _submitting;
    string _validationError;
    string _userComment;

    // Scalar state (mirrors the original CurrentDto values; diff'd at submit time)
    string                _title;
    string                _nativeTitle;
    string                _sortTitle;
    string                _isbn;
    int?                  _pages;
    int?                  _edition;
    DateTime?             _published;
    int                   _publishedPrecision;
    Iso31661NumericDto    _selectedCountry;
    BookDto               _selectedPrevious;
    BookDto               _selectedSource;
    string                _internetArchiveUrl;

    // Snapshot of the original scalar values (for diff computation at Submit time)
    string    _orig_title;
    string    _orig_nativeTitle;
    string    _orig_sortTitle;
    string    _orig_isbn;
    int?      _orig_pages;
    int?      _orig_edition;
    DateTime? _orig_published;
    int       _orig_publishedPrecision;
    int?      _orig_countryId;
    long?     _orig_previousId;
    long?     _orig_sourceId;
    string    _orig_internetArchiveUrl;

    // Picker source lists
    List<Iso31661NumericDto> _allCountries;
    List<PersonDto>          _allPeople;
    List<CompanyDto>         _allCompanies;
    List<MachineDto>         _allMachines;
    List<MachineFamilyDto>   _allMachineFamilies;
    List<DocumentRoleDto>    _roles;

    // Existing junction rows
    List<PersonByBookDto>        _peopleRows;
    List<CompanyByBookDto>       _companyRows;
    List<BookByMachineDto>       _machineRows;
    List<BookByMachineFamilyDto> _machineFamilyRows;

    // Pending operations: removes (set of existing row ids) + adds (uuid → state)
    HashSet<long> _peopleRemoves         = new();
    HashSet<long> _companyRemoves        = new();
    HashSet<long> _machineRemoves        = new();
    HashSet<long> _machineFamilyRemoves  = new();

    Dictionary<string, JunctionAddState> _peopleAdds        = new();
    Dictionary<string, JunctionAddState> _companyAdds       = new();
    Dictionary<string, JunctionAddState> _machineAdds       = new();
    Dictionary<string, JunctionAddState> _machineFamilyAdds = new();

    // Picker state
    PersonDto         _pickPerson;
    DocumentRoleDto   _pickPersonRole;
    CompanyDto        _pickCompany;
    DocumentRoleDto   _pickCompanyRole;
    MachineDto        _pickMachine;
    MachineFamilyDto  _pickMachineFamily;

    // Cover-pending state. Upload is direct browser → API (single hop) via the
    // pending-cover.js JS interop helper. The dialog only stores the returned guid +
    // extension; the actual file lives on the API server until accepted/rejected.
    string _coverInputId      = $"cover-input-{Guid.NewGuid():N}";
    string _coverImgId        = $"cover-img-{Guid.NewGuid():N}";
    string _pendingCoverGuid;
    string _pendingCoverExtension;
    string _pendingCoverFilename;
    bool   _uploadingCover;
    string _coverError;

    protected override async Task OnInitializedAsync()
    {
        // Seed scalar state from the current DTO snapshot (only in edit mode).
        if(!IsCreation && CurrentDto is not null)
        {
            _title                   = CurrentDto.Title;
            _nativeTitle             = CurrentDto.NativeTitle;
            _sortTitle               = CurrentDto.SortTitle;
            _isbn                    = CurrentDto.Isbn;
            _pages                   = CurrentDto.Pages;
            _edition                 = CurrentDto.Edition;
            _published               = CurrentDto.Published?.UtcDateTime;
            _publishedPrecision      = CurrentDto.PublishedPrecision ?? 0;
            _internetArchiveUrl      = CurrentDto.InternetArchiveUrl;
            _orig_title              = _title;
            _orig_nativeTitle        = _nativeTitle;
            _orig_sortTitle          = _sortTitle;
            _orig_isbn               = _isbn;
            _orig_pages              = _pages;
            _orig_edition            = _edition;
            _orig_published          = _published;
            _orig_publishedPrecision = _publishedPrecision;
            _orig_countryId          = CurrentDto.CountryId;
            _orig_previousId         = CurrentDto.PreviousId;
            _orig_sourceId           = CurrentDto.SourceId;
            _orig_internetArchiveUrl = _internetArchiveUrl;
        }

        // Always load picker corpora; existing-by-book queries are skipped in creation mode.
        Task<List<Iso31661NumericDto>>    countriesT     = BooksService.GetCountriesAsync();
        Task<List<PersonDto>>             allPeopleT     = BooksService.GetAllPeopleAsync();
        Task<List<CompanyDto>>            allCompaniesT  = BooksService.GetAllCompaniesAsync();
        Task<List<MachineDto>>            allMachinesT   = BooksService.GetAllMachinesAsync();
        Task<List<MachineFamilyDto>>      allFamiliesT   = BooksService.GetAllMachineFamiliesAsync();
        Task<List<DocumentRoleDto>>       rolesT         = BooksService.GetDocumentRolesAsync();

        if(IsCreation)
        {
            await Task.WhenAll(countriesT, allPeopleT, allCompaniesT, allMachinesT, allFamiliesT, rolesT);

            _allCountries        = countriesT.Result;
            _allPeople           = allPeopleT.Result;
            _allCompanies        = allCompaniesT.Result;
            _allMachines         = allMachinesT.Result;
            _allMachineFamilies  = allFamiliesT.Result;
            _roles               = rolesT.Result;

            _peopleRows         = new List<PersonByBookDto>();
            _companyRows        = new List<CompanyByBookDto>();
            _machineRows        = new List<BookByMachineDto>();
            _machineFamilyRows  = new List<BookByMachineFamilyDto>();

            _loading = false;
            return;
        }

        Task<List<PersonByBookDto>>       peopleByT      = BooksService.GetPeopleByBookAsync(EntityId);
        Task<List<CompanyByBookDto>>      companiesByT   = BooksService.GetCompaniesByBookAsync(EntityId);
        Task<List<BookByMachineDto>>      machinesByT    = BooksService.GetMachinesByBookAsync(EntityId);
        Task<List<BookByMachineFamilyDto>> familiesByT   = BooksService.GetMachineFamiliesByBookAsync(EntityId);

        await Task.WhenAll(countriesT, allPeopleT, allCompaniesT, allMachinesT, allFamiliesT, rolesT,
                           peopleByT, companiesByT, machinesByT, familiesByT);

        _allCountries        = countriesT.Result;
        _allPeople           = allPeopleT.Result;
        _allCompanies        = allCompaniesT.Result;
        _allMachines         = allMachinesT.Result;
        _allMachineFamilies  = allFamiliesT.Result;
        _roles               = rolesT.Result;

        _peopleRows          = peopleByT.Result;
        _companyRows         = companiesByT.Result;
        _machineRows         = machinesByT.Result;
        _machineFamilyRows   = familiesByT.Result;

        if(_orig_countryId.HasValue && _allCountries is not null)
            _selectedCountry = _allCountries.Find(c => c.Id == _orig_countryId.Value);

        if(_orig_previousId.HasValue)
            _selectedPrevious = await BooksService.GetBookAsync(_orig_previousId.Value);

        if(_orig_sourceId.HasValue)
            _selectedSource = await BooksService.GetBookAsync(_orig_sourceId.Value);

        _loading = false;
    }

    // ───────────────────────────── Search functions ─────────────────────────────

    Task<IEnumerable<Iso31661NumericDto>> SearchCountries(string value, CancellationToken ct)
    {
        IEnumerable<Iso31661NumericDto> r = _allCountries ?? [];
        if(!string.IsNullOrWhiteSpace(value))
            r = r.Where(c => c.Name?.Contains(value, StringComparison.OrdinalIgnoreCase) ?? false);
        return Task.FromResult(r);
    }

    Task<IEnumerable<PersonDto>> SearchPeople(string value, CancellationToken ct)
    {
        IEnumerable<PersonDto> r = _allPeople ?? [];
        if(!string.IsNullOrWhiteSpace(value))
            r = r.Where(p => FormatPersonDto(p).Contains(value, StringComparison.OrdinalIgnoreCase));
        // Take a reasonable cap to avoid rendering thousands of items in the dropdown.
        return Task.FromResult(r.Take(50));
    }

    Task<IEnumerable<CompanyDto>> SearchCompanies(string value, CancellationToken ct)
    {
        IEnumerable<CompanyDto> r = _allCompanies ?? [];
        if(!string.IsNullOrWhiteSpace(value))
            r = r.Where(c => c.Name?.Contains(value, StringComparison.OrdinalIgnoreCase) ?? false);
        return Task.FromResult(r.Take(50));
    }

    Task<IEnumerable<MachineDto>> SearchMachines(string value, CancellationToken ct)
    {
        // Dedup against existing rows minus removed plus pending adds — same machine cannot
        // be linked twice to the same book.
        HashSet<int?> assigned = new(GetEffectiveIds(_machineRows, _machineRemoves,
                                                     m => m.MachineId,
                                                     _machineAdds,
                                                     p => GetIntField(p, "machine_id")));
        IEnumerable<MachineDto> r = (_allMachines ?? []).Where(m => !assigned.Contains(m.Id));
        if(!string.IsNullOrWhiteSpace(value))
            r = r.Where(m => m.Name?.Contains(value, StringComparison.OrdinalIgnoreCase) ?? false);
        return Task.FromResult(r.Take(50));
    }

    Task<IEnumerable<MachineFamilyDto>> SearchMachineFamilies(string value, CancellationToken ct)
    {
        HashSet<int?> assigned = new(GetEffectiveIds(_machineFamilyRows, _machineFamilyRemoves,
                                                     f => f.MachineFamilyId,
                                                     _machineFamilyAdds,
                                                     p => GetIntField(p, "machine_family_id")));
        IEnumerable<MachineFamilyDto> r = (_allMachineFamilies ?? []).Where(f => !assigned.Contains(f.Id));
        if(!string.IsNullOrWhiteSpace(value))
            r = r.Where(f => f.Name?.Contains(value, StringComparison.OrdinalIgnoreCase) ?? false);
        return Task.FromResult(r.Take(50));
    }

    Task<IEnumerable<BookDto>> SearchPreviousBooks(string value, CancellationToken ct)
        => SearchBooks(value);

    Task<IEnumerable<BookDto>> SearchSourceBooks(string value, CancellationToken ct)
        => SearchBooks(value);

    async Task<IEnumerable<BookDto>> SearchBooks(string value)
    {
        // No bulk "all books" client cache — search via service.
        List<BookDto> books = await BooksService.GetBooksAsync(skip: 0, take: 50);
        IEnumerable<BookDto> r = (books ?? []).Where(b => b.Id != EntityId);
        if(!string.IsNullOrWhiteSpace(value))
            r = r.Where(b => b.Title?.Contains(value, StringComparison.OrdinalIgnoreCase) ?? false);
        return r;
    }

    static IEnumerable<int?> GetEffectiveIds<T>(List<T> rows, HashSet<long> removes,
                                                Func<T, int?> idSelector,
                                                Dictionary<string, JunctionAddState> adds,
                                                Func<Dictionary<string, object>, int?> addIdSelector) where T : class
    {
        if(rows is not null)
            foreach(T r in rows)
            {
                long rowId = (r as dynamic).Id ?? 0L;
                if(rowId != 0 && removes.Contains(rowId)) continue;
                int? id = idSelector(r);
                if(id.HasValue) yield return id;
            }

        if(adds is not null)
            foreach(JunctionAddState a in adds.Values)
            {
                int? id = addIdSelector(a.Payload);
                if(id.HasValue) yield return id;
            }
    }

    static int? GetIntField(Dictionary<string, object> payload, string key)
    {
        if(payload is null || !payload.TryGetValue(key, out object v) || v is null) return null;
        return v switch
        {
            int i      => i,
            long l     => (int?)l,
            short s    => s,
            string str => int.TryParse(str, NumberStyles.Integer, CultureInfo.InvariantCulture, out int p) ? p : null,
            _          => null
        };
    }

    // ───────────────────────────── Format helpers ─────────────────────────────

    static string FormatPersonDto(PersonDto p) =>
        !string.IsNullOrEmpty(p?.DisplayName) ? p.DisplayName
        : !string.IsNullOrEmpty(p?.Alias) ? p.Alias
        : $"{p?.Name} {p?.Surname}".Trim();

    static string FormatPerson(PersonByBookDto p)
    {
        string name = !string.IsNullOrEmpty(p.DisplayName) ? p.DisplayName
                    : !string.IsNullOrEmpty(p.Alias) ? p.Alias
                    : $"{p.Name} {p.Surname}".Trim();
        return string.IsNullOrEmpty(p.Role) ? name : $"{name} ({p.Role})";
    }

    static string FormatCompany(CompanyByBookDto c)
    {
        string name = c.Company ?? $"#{c.CompanyId}";
        return string.IsNullOrEmpty(c.Role) ? name : $"{name} ({c.Role})";
    }

    // ───────────────────────────── Junction queue helpers ─────────────────────────────

    void MarkRemove(HashSet<long> set, long id)
    {
        if(id == 0) return;
        set.Add(id);
    }

    void UndoRemove(HashSet<long> set, long id) => set.Remove(id);

    static int CountActive<T>(List<T> rows, HashSet<long> removes) where T : class
    {
        if(rows is null) return 0;
        int n = 0;
        foreach(T r in rows)
        {
            long id = (r as dynamic).Id ?? 0L;
            if(id == 0 || !removes.Contains(id)) n++;
        }
        return n;
    }

    static bool HasOps(Dictionary<string, JunctionAddState> adds, HashSet<long> removes) =>
        (adds is { Count: > 0 }) || (removes is { Count: > 0 });

    static string NewKey(string group, string op) => $"{group}.{op}.{Guid.NewGuid():N}";

    // ───────────────────────────── Add handlers ─────────────────────────────

    void AddPerson()
    {
        if(_pickPerson is null || _pickPersonRole is null) return;
        string key = NewKey(BookSuggestionMetadata.GroupPeople, "add");
        var payload = new Dictionary<string, object>(StringComparer.Ordinal)
        {
            ["person_id"] = _pickPerson.Id,
            ["role_id"]   = _pickPersonRole.Id
        };
        _peopleAdds[key] = new JunctionAddState
        {
            Payload = payload,
            Display = $"{FormatPersonDto(_pickPerson)} ({_pickPersonRole.Name})"
        };
        _pickPerson     = null;
        _pickPersonRole = null;
    }

    void AddCompany()
    {
        if(_pickCompany is null || _pickCompanyRole is null) return;
        string key = NewKey(BookSuggestionMetadata.GroupCompanies, "add");
        var payload = new Dictionary<string, object>(StringComparer.Ordinal)
        {
            ["company_id"] = _pickCompany.Id,
            ["role_id"]    = _pickCompanyRole.Id
        };
        _companyAdds[key] = new JunctionAddState
        {
            Payload = payload,
            Display = $"{_pickCompany.Name} ({_pickCompanyRole.Name})"
        };
        _pickCompany     = null;
        _pickCompanyRole = null;
    }

    void AddMachine()
    {
        if(_pickMachine is null) return;
        string key = NewKey(BookSuggestionMetadata.GroupMachines, "add");
        _machineAdds[key] = new JunctionAddState
        {
