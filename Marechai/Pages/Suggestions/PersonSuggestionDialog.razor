@using System
@using System.Globalization
@using System.Linq
@using System.Text.Json
@using System.Threading
@using Marechai.ApiClient.Models
@using Marechai.Data
@using Marechai.Services
@using Marechai.Suggestions
@using Marechai.Suggestions.Metadata
@using Microsoft.JSInterop

@inject IStringLocalizer<PeopleService> L
@inject ISnackbar           Snackbar
@inject PeopleService       PeopleService
@inject SuggestionsService  SuggestionsService
@inject IJSRuntime          JS
@inject TokenProvider       TokenProvider
@inject ApiAssetUrlProvider ApiAssetUrls

@*
    Dedicated suggestion dialog for editing a Person. Mirrors the admin PersonDialog
    editing surface but produces a Suggestion JSON payload instead of writing directly.
    Person has NO in-scope junctions — the five Person junctions are owned by the other
    side per the established convention and stay admin-only. The dialog includes a
    direct-browser-to-API photo upload (mirroring Book covers) gated behind the
    suggestion review.
*@

<MudDialog>
    <DialogContent>
        @if(_loading)
        {
            <MudProgressLinear Indeterminate="true"/>
        }
        else
        {
            <MudText Typo="Typo.body2" Class="mb-3">
                @L["Edit any field below. Only your changes will be sent for review; an administrator can accept or reject each one independently."]
            </MudText>

            @* ── Scalar fields ── *@
            <MudPaper Outlined="true" Class="pa-3 mb-3">
                <MudText Typo="Typo.h6" Class="mb-2">@L["General"]</MudText>

                <MudTextField T="string" Label="@L["Name"]"
                              MaxLength="100"
                              Value="@_name"
                              ValueChanged="@(v => { _name = v; })"
                              Required="true"
                              Class="mb-3"/>

                <MudTextField T="string" Label="@L["Surname"]"
                              MaxLength="100"
                              Value="@_surname"
                              ValueChanged="@(v => { _surname = v; })"
                              Class="mb-3"/>

                <MudTextField T="string" Label="@L["Alias"]"
                              MaxLength="100"
                              Value="@_alias"
                              ValueChanged="@(v => { _alias = v; })"
                              Class="mb-3"/>

                <MudTextField T="string" Label="@L["Display name"]"
                              MaxLength="100"
                              Value="@_displayName"
                              ValueChanged="@(v => { _displayName = v; })"
                              Class="mb-3"/>

                <MudAutocomplete T="Iso31661NumericDto" Label="@L["Country of birth"]"
                                 Value="@_selectedCountry"
                                 ValueChanged="@(c => { _selectedCountry = c; })"
                                 SearchFunc="SearchCountries"
                                 ToStringFunc="@(c => c?.Name ?? string.Empty)"
                                 Clearable="true"
                                 Class="mb-3"/>

                <MudStack Row="true" Spacing="2" Class="mb-3">
                    <MudDatePicker Label="@L["Birth date"]" Editable="true" Clearable="true"
                                   Date="@_birthDate"
                                   DateChanged="@(d => { _birthDate = d; })" Style="flex: 1;"/>
                    <MudSelect T="int" Label="@L["Date precision"]"
                               Value="@_birthDatePrecision"
                               ValueChanged="@(v => { _birthDatePrecision = v; })" Style="flex: 1;">
                        <MudSelectItem T="int" Value="0">@L["Full date"]</MudSelectItem>
                        <MudSelectItem T="int" Value="1">@L["Month and year only"]</MudSelectItem>
                        <MudSelectItem T="int" Value="2">@L["Year only"]</MudSelectItem>
                    </MudSelect>
                </MudStack>

                <MudStack Row="true" Spacing="2" Class="mb-3">
                    <MudDatePicker Label="@L["Death date"]" Editable="true" Clearable="true"
                                   Date="@_deathDate"
                                   DateChanged="@(d => { _deathDate = d; })" Style="flex: 1;"/>
                    <MudSelect T="int" Label="@L["Date precision"]"
                               Value="@_deathDatePrecision"
                               ValueChanged="@(v => { _deathDatePrecision = v; })" Style="flex: 1;">
                        <MudSelectItem T="int" Value="0">@L["Full date"]</MudSelectItem>
                        <MudSelectItem T="int" Value="1">@L["Month and year only"]</MudSelectItem>
                        <MudSelectItem T="int" Value="2">@L["Year only"]</MudSelectItem>
                    </MudSelect>
                </MudStack>

                <MudTextField T="string" Label="@L["Webpage"]"
                              MaxLength="255"
                              Value="@_webpage"
                              ValueChanged="@(v => { _webpage = v; })"
                              Class="mb-3"/>

                <MudStack Row="true" Spacing="2" Class="mb-3">
                    <MudTextField T="string" Label="@L["Twitter"]"
                                  MaxLength="50"
                                  Value="@_twitter"
                                  ValueChanged="@(v => { _twitter = v; })" Style="flex: 1;"/>
                    <MudTextField T="string" Label="@L["Facebook"]"
                                  MaxLength="100"
                                  Value="@_facebook"
                                  ValueChanged="@(v => { _facebook = v; })" Style="flex: 1;"/>
                </MudStack>
            </MudPaper>

            @* ── Photo ── *@
            <MudPaper Outlined="true" Class="pa-3 mb-3">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2">
                    <MudText Typo="Typo.h6">@L["Photo"]</MudText>
                </MudStack>
                <MudText Typo="Typo.caption" Class="mb-2">
                    @L["Allowed: JPG, PNG, WebP up to 50 MB. The image is uploaded directly to the API for review and only takes effect once an administrator accepts the suggestion."]
                </MudText>

                @* Plain HTML file input — uploaded directly to the API via JS interop
                   (NOT Blazor's <InputFile>, which would round-trip the file through
                   the SignalR circuit and double the bandwidth). The input is hidden
                   and triggered by the buttons below. *@
                <input type="file" id="@_photoInputId" accept="image/jpeg,image/png,image/webp" style="display:none"
                       @onchange="OnPhotoInputChanged"/>

                @if(string.IsNullOrEmpty(_pendingPhotoGuid))
                {
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.UploadFile"
                               Disabled="@_uploadingPhoto" OnClick="TriggerPhotoPicker">
                        @if(_uploadingPhoto)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2"/>
                        }
                        @L["Upload photo"]
                    </MudButton>
                }
                else
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <img id="@_photoImgId" alt="Pending photo" style="max-height: 120px; max-width: 120px; object-fit: contain; border-radius: 4px; box-shadow: 0 1px 4px rgba(0,0,0,0.2);"/>
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.body2"><strong>@_pendingPhotoFilename</strong></MudText>
                            <MudStack Row="true" Spacing="1">
                                <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                           StartIcon="@Icons.Material.Filled.SwapHoriz"
                                           Disabled="@_uploadingPhoto" OnClick="TriggerPhotoPicker">@L["Replace photo"]</MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error"
                                           StartIcon="@Icons.Material.Filled.Delete"
                                           Disabled="@_uploadingPhoto" OnClick="RemovePendingPhoto">@L["Remove"]</MudButton>
                            </MudStack>
                        </MudStack>
                    </MudStack>
                }

                @if(!string.IsNullOrEmpty(_photoError))
                {
                    <MudAlert Severity="Severity.Error" Class="mt-2">@_photoError</MudAlert>
                }
            </MudPaper>

            <MudTextField T="string" Label="@L["Optional comment (References, sources, etc...)"]" Lines="2"
                          MaxLength="2000" @bind-Value="_userComment"/>

            @if(!string.IsNullOrWhiteSpace(_validationError))
            {
                <MudAlert Severity="Severity.Error" Class="mt-2">@_validationError</MudAlert>
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit"
                   Disabled="@(_loading || _submitting || !HasAnyChange())">
            @if(_submitting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true"/>
            }
            else
            {
                @L["Submit suggestion"]
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code
{
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; }

    [Parameter] public long      EntityId   { get; set; }
    [Parameter] public PersonDto CurrentDto { get; set; }

    bool _loading = true;
    bool _submitting;
    string _validationError;
    string _userComment;

    // Scalar state (mirrors the original CurrentDto values; diff'd at submit time)
    string    _name;
    string    _surname;
    string    _alias;
    string    _displayName;
    DateTime? _birthDate;
    int       _birthDatePrecision;
    DateTime? _deathDate;
    int       _deathDatePrecision;
    string    _webpage;
    string    _twitter;
    string    _facebook;

    // Original values (set in OnInitializedAsync, used by HasAnyChange / Submit)
    string    _orig_name;
    string    _orig_surname;
    string    _orig_alias;
    string    _orig_displayName;
    short?    _orig_countryId;
    DateTime? _orig_birthDate;
    int       _orig_birthDatePrecision;
    DateTime? _orig_deathDate;
    int       _orig_deathDatePrecision;
    string    _orig_webpage;
    string    _orig_twitter;
    string    _orig_facebook;

    // Lookup caches
    List<Iso31661NumericDto> _allCountries;
    Iso31661NumericDto       _selectedCountry;

    // Photo-pending state. Upload is direct browser → API (single hop) via the
    // pending-cover.js JS interop helper. The dialog only stores the returned guid +
    // extension; the actual file lives on the API server until accepted/rejected.
    string _photoInputId      = $"photo-input-{Guid.NewGuid():N}";
    string _photoImgId        = $"photo-img-{Guid.NewGuid():N}";
    string _pendingPhotoGuid;
    string _pendingPhotoExtension;
    string _pendingPhotoFilename;
    bool   _uploadingPhoto;
    string _photoError;

    protected override async Task OnInitializedAsync()
    {
        // Seed scalar state from the current DTO snapshot.
        if(CurrentDto is not null)
        {
            _name               = CurrentDto.Name;
            _surname            = CurrentDto.Surname;
            _alias              = CurrentDto.Alias;
            _displayName        = CurrentDto.DisplayName;
            _birthDate          = CurrentDto.Birthdate?.UtcDateTime;
            _birthDatePrecision = CurrentDto.BirthdatePrecision ?? 0;
            _deathDate          = CurrentDto.DeathDate?.UtcDateTime;
            _deathDatePrecision = CurrentDto.DeathDatePrecision ?? 0;
            _webpage            = CurrentDto.Webpage;
            _twitter            = CurrentDto.Twitter;
            _facebook           = CurrentDto.Facebook;

            _orig_name               = _name;
            _orig_surname            = _surname;
            _orig_alias              = _alias;
            _orig_displayName        = _displayName;
            // Kiota wire DTO exposes country_id as int? — narrow to short? to match the
            // database column type. The wire submission re-serialises as a JSON number
            // and the server applier coerces back to short.
            _orig_countryId          = CurrentDto.CountryId.HasValue ? (short?)CurrentDto.CountryId.Value : null;
            _orig_birthDate          = _birthDate;
            _orig_birthDatePrecision = _birthDatePrecision;
            _orig_deathDate          = _deathDate;
            _orig_deathDatePrecision = _deathDatePrecision;
            _orig_webpage            = _webpage;
            _orig_twitter            = _twitter;
            _orig_facebook           = _facebook;
        }

        _allCountries = await PeopleService.GetCountriesAsync();

        if(_orig_countryId.HasValue && _allCountries is not null)
            _selectedCountry = _allCountries.Find(c => c.Id == _orig_countryId.Value);

        _loading = false;
    }

    // ───────────────────────────── Search functions ─────────────────────────────

    Task<IEnumerable<Iso31661NumericDto>> SearchCountries(string value, CancellationToken ct)
    {
        IEnumerable<Iso31661NumericDto> r = _allCountries ?? [];
        if(!string.IsNullOrWhiteSpace(value))
            r = r.Where(c => c.Name?.Contains(value, StringComparison.OrdinalIgnoreCase) ?? false);
        return Task.FromResult(r);
    }

    // ───────────────────────────── Photo upload (direct browser → API) ─────────────────────────────

    /// <summary>
    ///     Trigger the hidden &lt;input type="file"&gt; via a JS click. Cleaner UX than
    ///     rendering a raw file input next to the styled buttons.
    /// </summary>
    async Task TriggerPhotoPicker()
    {
        _photoError = null;
        try { await JS.InvokeVoidAsync("MarechaiPendingCover.clickInput", _photoInputId); }
        catch(Exception ex) { _photoError = ex.Message; }
    }

    /// <summary>
    ///     Fired by the @onchange on the hidden &lt;input type="file"&gt; right after the
    ///     user selects a file. The actual upload happens in JS so the file bytes go
    ///     directly to the API server (single hop) instead of being relayed through
    ///     SignalR. The Blazor side just receives the resulting {guid, extension} for the
    ///     diff payload.
    /// </summary>
    async Task OnPhotoInputChanged()
    {
        _photoError = null;
        _uploadingPhoto = true;
        StateHasChanged();

        try
        {
            string token = await TokenProvider.GetTokenAsync();
            if(string.IsNullOrEmpty(token))
            {
                _photoError = L["You must be signed in to upload a photo."];
                return;
            }

            UploadResult res = await JS.InvokeAsync<UploadResult>(
                "MarechaiPendingCover.uploadPersonPhoto",
                ApiAssetUrls.BaseUrl, token, (int)EntityId, _photoInputId);

            if(res is null || !res.ok || string.IsNullOrEmpty(res.guid))
            {
                _photoError = string.IsNullOrEmpty(res?.error) ? L["Photo upload failed."].Value : res.error;
                return;
            }

            _pendingPhotoGuid      = res.guid;
            _pendingPhotoExtension = res.extension ?? string.Empty;
            _pendingPhotoFilename  = $"{res.guid[..8]}…{(_pendingPhotoExtension is { Length: > 0 } ? "." + _pendingPhotoExtension : string.Empty)}";

            // After Blazor re-renders the <img> element appears; apply the blob now.
            StateHasChanged();
            await Task.Yield();
            await JS.InvokeVoidAsync("MarechaiPendingCover.applyPendingPersonPhotoImage",
                                     ApiAssetUrls.BaseUrl, token, _pendingPhotoGuid, _photoImgId);
        }
        catch(Exception ex)
        {
            _photoError = ex.Message;
        }
        finally
        {
            _uploadingPhoto = false;
            StateHasChanged();
        }
    }

    /// <summary>
    ///     Drop the pending photo from this in-flight suggestion. Tells the API to delete
    ///     the file too so we don't leak storage on cancel.
    /// </summary>
    async Task RemovePendingPhoto()
    {
        _photoError = null;
        if(string.IsNullOrEmpty(_pendingPhotoGuid)) return;

        string guidToDelete = _pendingPhotoGuid;
        _pendingPhotoGuid = null;
        _pendingPhotoExtension = null;
        _pendingPhotoFilename = null;
        StateHasChanged();

        try
        {
            string token = await TokenProvider.GetTokenAsync();
            if(!string.IsNullOrEmpty(token))
                await JS.InvokeAsync<UploadResult>(
                    "MarechaiPendingCover.deletePendingPersonPhoto",
                    ApiAssetUrls.BaseUrl, token, guidToDelete);
        }
        catch
        {
            // best-effort — orphan-sweep on review will catch leftovers
        }
    }

    sealed class UploadResult
    {
        public bool   ok        { get; set; }
        public int    status    { get; set; }
        public string guid      { get; set; }
        public string extension { get; set; }
        public string error     { get; set; }
    }

    // ───────────────────────────── Submit ─────────────────────────────

    bool HasAnyChange()
    {
        if(!Equals(_orig_name, _name)) return true;
        if(!Equals(_orig_surname, _surname)) return true;
        if(!Equals(_orig_alias, _alias)) return true;
        if(!Equals(_orig_displayName, _displayName)) return true;
        if(_orig_countryId != (_selectedCountry?.Id.HasValue == true ? (short?)_selectedCountry.Id.Value : null)) return true;
        if(!Nullable.Equals(_orig_birthDate, _birthDate)) return true;
        if(_orig_birthDatePrecision != _birthDatePrecision) return true;
        if(!Nullable.Equals(_orig_deathDate, _deathDate)) return true;
        if(_orig_deathDatePrecision != _deathDatePrecision) return true;
        if(!Equals(_orig_webpage, _webpage)) return true;
        if(!Equals(_orig_twitter, _twitter)) return true;
        if(!Equals(_orig_facebook, _facebook)) return true;

        if(!string.IsNullOrEmpty(_pendingPhotoGuid)) return true;

        return false;
    }

    void Cancel() => MudDialog.Cancel();

    async Task Submit()
    {
        _validationError = null;
        if(_loading) return;

        // Name is required: never let the user clear it.
        if(string.IsNullOrWhiteSpace(_name))
        {
            _validationError = L["Name is required."];
            return;
        }

        var diff = new Dictionary<string, object>(StringComparer.Ordinal);

        if(!Equals(_orig_name, _name))               diff[PersonSuggestionMetadata.FieldName]        = _name;
        if(!Equals(_orig_surname, _surname))         diff[PersonSuggestionMetadata.FieldSurname]     = _surname;
        if(!Equals(_orig_alias, _alias))             diff[PersonSuggestionMetadata.FieldAlias]       = _alias;
        if(!Equals(_orig_displayName, _displayName)) diff[PersonSuggestionMetadata.FieldDisplayName] = _displayName;

        short? newCountryId = _selectedCountry?.Id.HasValue == true ? (short?)_selectedCountry.Id.Value : null;
        if(_orig_countryId != newCountryId)
            diff[PersonSuggestionMetadata.FieldCountryOfBirthId] = newCountryId;

        if(!Nullable.Equals(_orig_birthDate, _birthDate))
            diff[PersonSuggestionMetadata.FieldBirthDate] = _birthDate?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
        if(_orig_birthDatePrecision != _birthDatePrecision)
            diff[PersonSuggestionMetadata.FieldBirthDatePrecision] = _birthDatePrecision;
        if(!Nullable.Equals(_orig_deathDate, _deathDate))
            diff[PersonSuggestionMetadata.FieldDeathDate] = _deathDate?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
        if(_orig_deathDatePrecision != _deathDatePrecision)
            diff[PersonSuggestionMetadata.FieldDeathDatePrecision] = _deathDatePrecision;
        if(!Equals(_orig_webpage, _webpage))   diff[PersonSuggestionMetadata.FieldWebpage]  = _webpage;
        if(!Equals(_orig_twitter, _twitter))   diff[PersonSuggestionMetadata.FieldTwitter]  = _twitter;
        if(!Equals(_orig_facebook, _facebook)) diff[PersonSuggestionMetadata.FieldFacebook] = _facebook;

        // Photo-pending: emit the guid only. The applier reads the extension from the
        // pending-image sidecar (so we don't need to round-trip it on the wire).
        if(!string.IsNullOrEmpty(_pendingPhotoGuid))
            diff[PersonSuggestionMetadata.FieldCoverPendingGuid] = _pendingPhotoGuid;

        if(diff.Count == 0)
        {
            _validationError = L["No changes detected — modify at least one field before submitting."];
            return;
        }

        _submitting = true;
        try
        {
            string json = JsonSerializer.Serialize(diff);
            var dto = new SuggestionDto
            {
                EntityType          = (int?)SuggestionEntityType.Person,
                EntityId            = EntityId,
                Status              = (int?)SuggestionStatus.Pending,
                UserComment         = string.IsNullOrWhiteSpace(_userComment) ? null : _userComment.Trim(),
                SuggestedValuesJson = json
            };

            var (created, error) = await SuggestionsService.CreateAsync(dto);

            if(created is null)
            {
                _validationError = string.IsNullOrWhiteSpace(error) ? L["Failed to submit suggestion."].Value : error;
                return;
            }

            Snackbar.Add(L["Suggestion submitted. An administrator will review it."], Severity.Success);
            MudDialog.Close(DialogResult.Ok(created));
        }
        finally
        {
            _submitting = false;
        }
    }
}
