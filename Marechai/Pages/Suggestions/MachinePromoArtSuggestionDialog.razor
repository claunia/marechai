@*
    MachinePromoArtSuggestionDialog — collaborative machine promo art batch upload.

    A logged-in user can stage 1-30 pending images for an existing machine, choose
    a promo-art group (free-text autocomplete over existing groups; the server does
    get-or-create on accept), optionally annotate each image with a caption, then
    submit ONE Suggestion row that an admin reviews per-image. Accepted images are
    persisted with the pending Guid as the new MachinePromoArt row Id and run
    through the same fire-and-forget conversion worker the admin upload uses.
*@
@using System
@using System.Collections.Generic
@using System.Globalization
@using System.Linq
@using System.Text.Json
@using System.Threading.Tasks
@using Marechai.ApiClient.Models
@using Marechai.Data
@using Marechai.Services
@using Microsoft.JSInterop

@inject IStringLocalizer<MachinesService> L
@inject ISnackbar                         Snackbar
@inject MachinePromoArtService            MachinePromoArtService
@inject SuggestionsService                SuggestionsService
@inject IJSRuntime                        JS
@inject TokenProvider                     TokenProvider
@inject ApiAssetUrlProvider               ApiAssetUrls

<MudDialog>
    <DialogContent>
        @if(_loading)
        {
            <MudProgressLinear Indeterminate="true"/>
        }
        else
        {
            <MudText Typo="Typo.body2" Class="mb-3">
                @string.Format(L["Suggest promo art for {0}. Upload up to {1} JPG, PNG or WebP files (max 50 MB each). All images in this batch share the same group."].Value, MachineName, MaxPhotos)
            </MudText>

            <MudPaper Outlined="true" Class="pa-3 mb-3">
                <MudText Typo="Typo.subtitle2" Class="mb-2">@L["Group"]</MudText>

                <MudAutocomplete T="string" Label="@L["Group name"]"
                                 Value="@_groupName"
                                 ValueChanged="@(v => { _groupName = v; })"
                                 SearchFunc="SearchGroupsAsync"
                                 CoerceValue="true"
                                 CoerceText="true"
                                 ResetValueOnEmptyText="false"
                                 Required="true"
                                 MaxLength="256"
                                 Class="mb-1"
                                 HelperText="@L["Pick an existing promo art group, or type a new name to create one."]"/>
            </MudPaper>

            <MudPaper Outlined="true" Class="pa-3 mb-3">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2">
                    <MudText Typo="Typo.subtitle2">@string.Format(L["Images: {0}/{1}"].Value, _staged.Count, MaxPhotos)</MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.AddPhotoAlternate"
                               Disabled="@(_staged.Count >= MaxPhotos)"
                               OnClick="TriggerFilePicker">
                        @L["Add images"]
                    </MudButton>
                </MudStack>
                <MudText Typo="Typo.caption">
                    @L["Pick one or more files at a time. Each image is uploaded immediately and held on the server until you submit the batch."]
                </MudText>

                <input type="file" id="@_fileInputId" accept="image/jpeg,image/png,image/webp" multiple style="display:none"
                       @onchange="OnFilesPicked"/>
            </MudPaper>

            @if(_staged.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-3">
                    @L["No images staged yet. Use the Add images button above to pick files from your device."]
                </MudAlert>
            }
            else
            {
                <MudStack Spacing="2" Class="mb-3">
                    @foreach(StagedPromo p in _staged)
                    {
                        <MudPaper Outlined="true" Class="pa-3" Key="@p.ClientGuid">
                            <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Start">
                                <div style="width: 100px; height: 100px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; background: var(--mud-palette-background-grey); border-radius: 4px;">
                                    @if(p.Status == StagedPromoStatus.Ready)
                                    {
                                        <img id="@p.ImgElementId" alt="@p.FileName"
                                             style="max-width: 100px; max-height: 100px; object-fit: contain; border-radius: 4px;"/>
                                    }
                                    else if(p.Status == StagedPromoStatus.Uploading)
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Color="Color.Default"/>
                                    }
                                    else
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Color="Color.Error"/>
                                    }
                                </div>

                                <MudStack Spacing="1" Style="flex: 1; min-width: 0;">
                                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                        <MudText Typo="Typo.body2"><strong>@p.FileName</strong></MudText>
                                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                                       Color="Color.Error"
                                                       OnClick="@(() => RemoveStagedAsync(p.ClientGuid))"/>
                                    </MudStack>

                                    <MudText Typo="Typo.caption">@FormatBytes(p.SizeBytes)</MudText>

                                    @if(p.Status == StagedPromoStatus.Uploading)
                                    {
                                        <MudProgressLinear Color="Color.Primary"
                                                           Value="@p.UploadPercent"
                                                           Min="0" Max="100" Class="my-1"/>
                                        <MudText Typo="Typo.caption">@($"{p.UploadPercent:0}%")</MudText>
                                    }
                                    else if(p.Status == StagedPromoStatus.Error)
                                    {
                                        <MudAlert Severity="Severity.Error" Dense="true" Class="my-1">@p.ErrorText</MudAlert>
                                    }
                                    else if(p.Status == StagedPromoStatus.Ready)
                                    {
                                        <MudTextField T="string" Label="@L["Caption (optional)"]"
                                                      Lines="2" MaxLength="500"
                                                      Value="@p.Caption"
                                                      ValueChanged="@(v => { p.Caption = v; })"
                                                      Class="mt-1"/>
                                    }
                                </MudStack>
                            </MudStack>
                        </MudPaper>
                    }
                </MudStack>
            }

            <MudTextField T="string" Label="@L["Note for the reviewer (optional)"]"
                          Lines="2" MaxLength="2000"
                          Value="@_userComment"
                          ValueChanged="@(v => { _userComment = v; })"/>

            @if(!string.IsNullOrEmpty(_validationError))
            {
                <MudAlert Severity="Severity.Error" Class="mt-3">@_validationError</MudAlert>
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="OnCancelAsync" Disabled="@_submitting">@L["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   OnClick="SubmitAsync"
                   Disabled="@(_loading || _submitting || !CanSubmit())">
            @if(_submitting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2"/>
            }
            @L["Submit"]
        </MudButton>
    </DialogActions>
</MudDialog>
