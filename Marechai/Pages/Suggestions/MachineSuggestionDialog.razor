    Task<IEnumerable<SoftwarePlatformDto>> SearchSoftwarePlatforms(string value, CancellationToken ct)
    {
        HashSet<int?> assigned = new(GetEffectiveIds(_softwarePlatformRows, _softwarePlatformRemoves,
                                                     s => s.SoftwarePlatformId,
                                                     _softwarePlatformAdds,
                                                     p => GetIntField(p, "software_platform_id")));
        IEnumerable<SoftwarePlatformDto> r = (_allSoftwarePlatforms ?? []).Where(s => !assigned.Contains((int?)s.Id));
        if(!string.IsNullOrWhiteSpace(value))
            r = r.Where(s => s.Name?.Contains(value, StringComparison.OrdinalIgnoreCase) ?? false);
        return Task.FromResult(r);
    }

    static IEnumerable<int?> GetEffectiveIds<T>(List<T> rows, HashSet<long> removes,
                                                Func<T, int?> idSelector,
                                                Dictionary<string, JunctionAddState> adds,
                                                Func<Dictionary<string, object>, int?> addIdSelector) where T : class
    {
        if(rows is not null)
            foreach(T r in rows)
            {
                long rowId = (r as dynamic).Id ?? 0L;
                if(rowId != 0 && removes.Contains(rowId)) continue;
                int? id = idSelector(r);
                if(id.HasValue) yield return id;
            }

        if(adds is not null)
            foreach(JunctionAddState a in adds.Values)
            {
                int? id = addIdSelector(a.Payload);
                if(id.HasValue) yield return id;
            }
    }

    static int? GetIntField(Dictionary<string, object> payload, string key)
    {
        if(payload is null || !payload.TryGetValue(key, out object v) || v is null) return null;
        return v switch
        {
            int i      => i,
            long l     => (int?)l,
            short s    => s,
            string str => int.TryParse(str, NumberStyles.Integer, CultureInfo.InvariantCulture, out int p) ? p : null,
            _          => null
        };
    }

    // ───────────────────────────── Format helpers ─────────────────────────────

    static string FormatGpu(GpuByMachineDto g) => $"{g.Name} ({g.Company})";

    static string FormatProcessor(ProcessorByMachineDto p) =>
        p.Speed is > 0 ? $"{p.Name} ({p.Company}) @ {p.Speed} MHz" : $"{p.Name} ({p.Company})";

    static string FormatSoundSynth(SoundSynthByMachineDto s) => $"{s.Name} ({s.Company})";

    string FormatScreen(ScreenByMachineDto s)
    {
        ScreenDto sd = s.Screen?.ScreenDto;
        return sd is null ? $"Screen #{s.ScreenId}" : FormatScreenDto(sd);
    }

    static string FormatScreenDto(ScreenDto s) =>
        string.IsNullOrWhiteSpace(s.Type) ? $"{s.Diagonal}\"" : $"{s.Diagonal}\" {s.Type}";

    string FormatMemory(MemoryByMachineDto m)
    {
        string type  = m.Type.HasValue && MemoryTypeNames.TryGetValue(m.Type.Value, out string tn) ? tn : L["Unknown"].Value;
        string usage = m.Usage.HasValue && MemoryUsageNames.TryGetValue(m.Usage.Value, out string un) ? un : L["Unknown"].Value;
        string size  = m.Size.HasValue ? FormatBytes(m.Size.Value) : L["Unknown"].Value;
        return $"{size} {type} ({usage})";
    }

    string FormatStorage(StorageByMachineDto s)
    {
        string type  = s.Type.HasValue && StorageTypeNames.TryGetValue(s.Type.Value, out string tn) ? tn : L["Unknown"].Value;
        string iface = s.Interface.HasValue && StorageInterfaceNames.TryGetValue(s.Interface.Value, out string ifn) ? ifn : L["Unknown"].Value;
        string cap   = s.Capacity.HasValue ? FormatBytes(s.Capacity.Value) : "";
        return string.IsNullOrEmpty(cap) ? $"{type} ({iface})" : $"{type} ({iface}) - {cap}";
    }

    static string FormatBytes(long bytes) => bytes switch
    {
        >= 1073741824 => $"{bytes / 1073741824.0:F1} GiB",
        >= 1048576    => $"{bytes / 1048576.0:F1} MiB",
        >= 1024       => $"{bytes / 1024.0:F1} KiB",
        _             => $"{bytes} bytes"
    };

    // ───────────────────────────── Junction queue helpers ─────────────────────────────

    void MarkRemove(HashSet<long> set, long id)
    {
        if(id == 0) return;
        set.Add(id);
    }

    void UndoRemove(HashSet<long> set, long id) => set.Remove(id);

    static int CountActive<T>(List<T> rows, HashSet<long> removes) where T : class
    {
        if(rows is null) return 0;
        int n = 0;
        foreach(T r in rows)
        {
            long id = (r as dynamic).Id ?? 0L;
            if(id == 0 || !removes.Contains(id)) n++;
        }
        return n;
    }

    static bool HasOps(Dictionary<string, JunctionAddState> adds, HashSet<long> removes) =>
        (adds is { Count: > 0 }) || (removes is { Count: > 0 });

    static string NewKey(string group, string op) => $"{group}.{op}.{Guid.NewGuid():N}";

    // ───────────────────────────── Add handlers ─────────────────────────────

    void AddGpu()
    {
        if(_pickGpu is null) return;
        string key = NewKey(MachineSuggestionMetadata.GroupGpus, "add");
        _gpuAdds[key] = new JunctionAddState
        {
            Payload = new Dictionary<string, object>(StringComparer.Ordinal) { ["gpu_id"] = _pickGpu.Id },
            Display = $"{_pickGpu.Name} ({_pickGpu.Company})"
        };
        _pickGpu = null;
    }

    void AddProcessor()
    {
        if(_pickProcessor is null) return;
        string key = NewKey(MachineSuggestionMetadata.GroupProcessors, "add");
        var payload = new Dictionary<string, object>(StringComparer.Ordinal)
        {
            ["processor_id"] = _pickProcessor.Id
        };
        if(_pickProcessorSpeed.HasValue) payload["speed"] = _pickProcessorSpeed.Value;
        string display = _pickProcessorSpeed is > 0
                             ? $"{_pickProcessor.Name} ({_pickProcessor.Company}) @ {_pickProcessorSpeed} MHz"
                             : $"{_pickProcessor.Name} ({_pickProcessor.Company})";
        _processorAdds[key] = new JunctionAddState { Payload = payload, Display = display };
        _pickProcessor      = null;
        _pickProcessorSpeed = null;
    }

    void AddSoundSynth()
    {
        if(_pickSoundSynth is null) return;
        string key = NewKey(MachineSuggestionMetadata.GroupSoundSynths, "add");
        _soundSynthAdds[key] = new JunctionAddState
        {
            Payload = new Dictionary<string, object>(StringComparer.Ordinal) { ["sound_synth_id"] = _pickSoundSynth.Id },
            Display = $"{_pickSoundSynth.Name} ({_pickSoundSynth.Company})"
        };
        _pickSoundSynth = null;
    }

    void AddScreen()
    {
        if(_pickScreen is null) return;
        string key = NewKey(MachineSuggestionMetadata.GroupScreens, "add");
        _screenAdds[key] = new JunctionAddState
        {
            Payload = new Dictionary<string, object>(StringComparer.Ordinal) { ["screen_id"] = _pickScreen.Id },
            Display = FormatScreenDto(_pickScreen)
        };
        _pickScreen = null;
    }

    void AddMemory()
    {
        string key = NewKey(MachineSuggestionMetadata.GroupMemory, "add");
        var payload = new Dictionary<string, object>(StringComparer.Ordinal)
        {
            ["type"]  = _pickMemoryType,
            ["usage"] = _pickMemoryUsage
        };
        if(_pickMemorySize.HasValue)  payload["size"]  = _pickMemorySize.Value;
        if(_pickMemorySpeed.HasValue) payload["speed"] = _pickMemorySpeed.Value;

        string typeName  = MemoryTypeNames.TryGetValue(_pickMemoryType, out string tn) ? tn : L["Unknown"].Value;
        string usageName = MemoryUsageNames.TryGetValue(_pickMemoryUsage, out string un) ? un : L["Unknown"].Value;
        string sizeStr   = _pickMemorySize.HasValue ? FormatBytes(_pickMemorySize.Value) : L["Unknown"].Value;
        string speedStr  = _pickMemorySpeed.HasValue ? $" @ {_pickMemorySpeed} MHz" : string.Empty;
        string display   = $"{sizeStr} {typeName} ({usageName}){speedStr}";

        _memoryAdds[key] = new JunctionAddState { Payload = payload, Display = display };
        _pickMemorySize  = null;
        _pickMemorySpeed = null;
    }

    void AddStorage()
    {
        string key = NewKey(MachineSuggestionMetadata.GroupStorage, "add");
        var payload = new Dictionary<string, object>(StringComparer.Ordinal)
        {
            ["type"]      = _pickStorageType,
            ["interface"] = _pickStorageInterface
        };
        if(_pickStorageCapacity.HasValue) payload["capacity"] = _pickStorageCapacity.Value;

        string typeName  = StorageTypeNames.TryGetValue(_pickStorageType, out string tn) ? tn : L["Unknown"].Value;
        string ifaceName = StorageInterfaceNames.TryGetValue(_pickStorageInterface, out string ifn) ? ifn : L["Unknown"].Value;
        string capStr    = _pickStorageCapacity.HasValue ? $" - {FormatBytes(_pickStorageCapacity.Value)}" : string.Empty;
        string display   = $"{typeName} ({ifaceName}){capStr}";

        _storageAdds[key]    = new JunctionAddState { Payload = payload, Display = display };
        _pickStorageCapacity = null;
    }

    void AddSoftwarePlatform()
    {
        if(_pickSoftwarePlatform is null) return;
        string key = NewKey(MachineSuggestionMetadata.GroupSoftwarePlatforms, "add");
        _softwarePlatformAdds[key] = new JunctionAddState
        {
            Payload = new Dictionary<string, object>(StringComparer.Ordinal) { ["software_platform_id"] = (long)(_pickSoftwarePlatform.Id ?? 0) },
            Display = _pickSoftwarePlatform.Name ?? string.Empty
        };
        _pickSoftwarePlatform = null;
    }

    // ───────────────────────────── Submit ─────────────────────────────

    bool HasAnyChange()
    {
        if(!Equals(_orig_name, _name)) return true;
        if(!Equals(_orig_model, _model)) return true;
        if(_orig_type != _type) return true;
        if(_orig_prototype != _prototype) return true;
        if(!Nullable.Equals(_orig_introduced, _introduced)) return true;
        if(_orig_introducedPrecision != _introducedPrecision) return true;
        if(_orig_companyId != _selectedCompany?.Id) return true;
        if(_orig_familyId != _selectedFamily?.Id) return true;

        if(_gpuAdds.Count + _processorAdds.Count + _soundSynthAdds.Count + _screenAdds.Count
         + _memoryAdds.Count + _storageAdds.Count + _softwarePlatformAdds.Count > 0) return true;

        if(_gpuRemoves.Count + _processorRemoves.Count + _soundSynthRemoves.Count + _screenRemoves.Count
         + _memoryRemoves.Count + _storageRemoves.Count + _softwarePlatformRemoves.Count > 0) return true;

        return false;
    }

    bool HasMandatoryFieldsForCreation()
    {
        if(string.IsNullOrWhiteSpace(_name)) return false;
        if(_selectedCompany?.Id is not int) return false;
        if(_type <= 0 || !Enum.IsDefined(typeof(MachineType), _type)) return false;
        return true;
    }

    void Cancel() => MudDialog.Cancel();

    async Task Submit()
    {
        _validationError = null;
        if(_loading) return;

        var diff = new Dictionary<string, object>(StringComparer.Ordinal);

        if(IsCreation)
        {
            // Brand-new entity: emit every populated scalar plus all queued junction adds.
            // Remove ops are ignored (the dialog never produces them in creation mode because
            // _xxxRows is empty, but defensive: junction-remove keys would be meaningless on a
            // non-existent parent).
            diff[MachineSuggestionMetadata.FieldName]      = _name;
            diff[MachineSuggestionMetadata.FieldCompanyId] = _selectedCompany?.Id;
            diff[MachineSuggestionMetadata.FieldType]      = _type;
            if(!string.IsNullOrWhiteSpace(_model))
                diff[MachineSuggestionMetadata.FieldModel] = _model;
            if(_prototype)
                diff[MachineSuggestionMetadata.FieldPrototype] = _prototype;
            if(_introduced.HasValue)
                diff[MachineSuggestionMetadata.FieldIntroduced] = _introduced.Value.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
            if(_introducedPrecision != 0)
                diff[MachineSuggestionMetadata.FieldIntroducedPrecision] = _introducedPrecision;
            if(_selectedFamily?.Id is int famId)
                diff[MachineSuggestionMetadata.FieldFamilyId] = famId;

            foreach(KeyValuePair<string, JunctionAddState> kv in _gpuAdds)              diff[kv.Key] = kv.Value.Payload;
            foreach(KeyValuePair<string, JunctionAddState> kv in _processorAdds)        diff[kv.Key] = kv.Value.Payload;
            foreach(KeyValuePair<string, JunctionAddState> kv in _soundSynthAdds)       diff[kv.Key] = kv.Value.Payload;
            foreach(KeyValuePair<string, JunctionAddState> kv in _screenAdds)           diff[kv.Key] = kv.Value.Payload;
            foreach(KeyValuePair<string, JunctionAddState> kv in _memoryAdds)           diff[kv.Key] = kv.Value.Payload;
            foreach(KeyValuePair<string, JunctionAddState> kv in _storageAdds)          diff[kv.Key] = kv.Value.Payload;
            foreach(KeyValuePair<string, JunctionAddState> kv in _softwarePlatformAdds) diff[kv.Key] = kv.Value.Payload;

            if(!HasMandatoryFieldsForCreation())
            {
                _validationError = L["Name, company and type are required to suggest a new machine."];
                return;
            }
        }
        else
        {
            if(!Equals(_orig_name, _name))                  diff[MachineSuggestionMetadata.FieldName]  = _name;
            if(!Equals(_orig_model, _model))                diff[MachineSuggestionMetadata.FieldModel] = _model;
            if(_orig_type != _type)                         diff[MachineSuggestionMetadata.FieldType]  = _type;
            if(_orig_prototype != _prototype)               diff[MachineSuggestionMetadata.FieldPrototype] = _prototype;
            if(!Nullable.Equals(_orig_introduced, _introduced))
                diff[MachineSuggestionMetadata.FieldIntroduced] = _introduced?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
            if(_orig_introducedPrecision != _introducedPrecision)
                diff[MachineSuggestionMetadata.FieldIntroducedPrecision] = _introducedPrecision;
            if(_orig_companyId != _selectedCompany?.Id)
                diff[MachineSuggestionMetadata.FieldCompanyId] = _selectedCompany?.Id;
            if(_orig_familyId != _selectedFamily?.Id)
                diff[MachineSuggestionMetadata.FieldFamilyId] = _selectedFamily?.Id;

            AddJunctionOps(diff, _gpuAdds, _gpuRemoves, MachineSuggestionMetadata.GroupGpus);
            AddJunctionOps(diff, _processorAdds, _processorRemoves, MachineSuggestionMetadata.GroupProcessors);
            AddJunctionOps(diff, _soundSynthAdds, _soundSynthRemoves, MachineSuggestionMetadata.GroupSoundSynths);
            AddJunctionOps(diff, _screenAdds, _screenRemoves, MachineSuggestionMetadata.GroupScreens);
            AddJunctionOps(diff, _memoryAdds, _memoryRemoves, MachineSuggestionMetadata.GroupMemory);
            AddJunctionOps(diff, _storageAdds, _storageRemoves, MachineSuggestionMetadata.GroupStorage);
            AddJunctionOps(diff, _softwarePlatformAdds, _softwarePlatformRemoves, MachineSuggestionMetadata.GroupSoftwarePlatforms);

            if(diff.Count == 0)
            {
                _validationError = L["No changes detected — modify at least one field before submitting."];
                return;
            }
        }

        _submitting = true;
        try
        {
            string json = JsonSerializer.Serialize(diff);
            var dto = new SuggestionDto
            {
                EntityType          = (int?)SuggestionEntityType.Machine,
                EntityId            = IsCreation ? null : EntityId,
                Status              = (int?)SuggestionStatus.Pending,
                UserComment         = string.IsNullOrWhiteSpace(_userComment) ? null : _userComment.Trim(),
                SuggestedValuesJson = json
            };

            var (created, error) = await SuggestionsService.CreateAsync(dto);

            if(created is null)
            {
                _validationError = string.IsNullOrWhiteSpace(error) ? L["Failed to submit suggestion."].Value : error;
                return;
            }

            Snackbar.Add(L["Suggestion submitted. An administrator will review it."], Severity.Success);
            MudDialog.Close(DialogResult.Ok(created));
        }
        finally
        {
            _submitting = false;
        }
    }

    static void AddJunctionOps(Dictionary<string, object> diff,
                               Dictionary<string, JunctionAddState> adds,
                               HashSet<long> removes,
                               string group)
    {
        foreach(KeyValuePair<string, JunctionAddState> kv in adds) diff[kv.Key] = kv.Value.Payload;
        foreach(long id in removes) diff[$"{group}.remove.{id.ToString(CultureInfo.InvariantCulture)}"] = null;
    }
}
