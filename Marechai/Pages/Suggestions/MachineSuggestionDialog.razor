@using System
@using System.Globalization
@using System.Linq
@using System.Text.Json
@using System.Threading
@using Humanizer
@using Marechai.ApiClient.Models
@using Marechai.Data
@using Marechai.Services
@using Marechai.Suggestions
@using Marechai.Suggestions.Metadata

@inject IStringLocalizer<MachinesService> L
@inject ISnackbar          Snackbar
@inject MachinesService    MachinesService
@inject SuggestionsService SuggestionsService

@*
    Dedicated suggestion dialog for editing a Machine. Mirrors the admin MachineDialog editing
    surface but produces a Suggestion JSON payload instead of writing directly. Each junction
    add/remove operation is queued in local state and serialised under a unique field-name
    key (<group>.add.<uuid> or <group>.remove.<row_id>) so the admin can later accept or
    reject each operation independently in the diff panel.
*@

<MudDialog>
    <DialogContent>
        @if(_loading)
        {
            <MudProgressLinear Indeterminate="true"/>
        }
        else
        {
            <MudText Typo="Typo.body2" Class="mb-3">
                @if(IsCreation)
                {
                    @L["Fill in the fields below to suggest a new machine. Name, company and type are required; any junctions you add will be queued for admin review along with the scalar fields."]
                }
                else
                {
                    @L["Edit any field or junction below. Only your changes will be sent for review; an administrator can accept or reject each one independently."]
                }
            </MudText>

            @* ── Scalar fields ── *@
            <MudPaper Outlined="true" Class="pa-3 mb-3">
                <MudText Typo="Typo.h6" Class="mb-2">@L["General"]</MudText>

                <MudTextField T="string" Label="@L["Name"]"
                              MaxLength="255"
                              Value="@_name"
                              ValueChanged="@(v => { _name = v; })"
                              Class="mb-3"/>

                <MudTextField T="string" Label="@L["Model"]"
                              MaxLength="50"
                              Value="@_model"
                              ValueChanged="@(v => { _model = v; })"
                              Class="mb-3"/>

                <MudAutocomplete T="CompanyDto" Label="@L["Company"]"
                                 Value="@_selectedCompany"
                                 ValueChanged="@(c => { _selectedCompany = c; })"
                                 SearchFunc="SearchCompanies"
                                 ToStringFunc="@(c => c?.Name ?? string.Empty)"
                                 Clearable="true"
                                 Class="mb-3"/>

                <MudSelect T="int" Label="@L["Type"]" Value="@_type" ValueChanged="@(v => { _type = v; })"
                           Disabled="@(IsCreation && PrefillType.HasValue)" Class="mb-3">
                    <MudSelectItem T="int" Value="0">@L["Unknown"]</MudSelectItem>
                    <MudSelectItem T="int" Value="1">@L["Computer"]</MudSelectItem>
                    <MudSelectItem T="int" Value="2">@L["Console"]</MudSelectItem>
                    <MudSelectItem T="int" Value="3">@L["Smartphone"]</MudSelectItem>
                </MudSelect>

                <MudCheckBox T="bool" Label="@L["Prototype"]" Value="@_prototype"
                             ValueChanged="@(v => { _prototype = v; })" Class="mb-3"/>

                <MudDatePicker Label="@L["Introduction date"]" Editable="true" Clearable="true"
                               Disabled="@_prototype"
                               Date="@_introduced"
                               DateChanged="@(d => { _introduced = d; })" Class="mb-3"/>

                <MudSelect T="int" Label="@L["Date precision"]"
                           Value="@_introducedPrecision"
                           ValueChanged="@(v => { _introducedPrecision = v; })" Class="mb-3">
                    <MudSelectItem T="int" Value="0">@L["Full date"]</MudSelectItem>
                    <MudSelectItem T="int" Value="1">@L["Month and year only"]</MudSelectItem>
                    <MudSelectItem T="int" Value="2">@L["Year only"]</MudSelectItem>
                </MudSelect>

                <MudAutocomplete T="MachineFamilyDto" Label="@L["Family"]"
                                 Value="@_selectedFamily"
                                 ValueChanged="@(f => { _selectedFamily = f; })"
                                 SearchFunc="SearchFamilies"
                                 ToStringFunc="@(f => f?.Name ?? string.Empty)"
                                 Clearable="true"/>
            </MudPaper>

            @* ── Junctions ── *@
            <MudExpansionPanels MultiExpansion="true" Class="mb-3">

                @* GPUs *@
                <MudExpansionPanel Text="@($"{L["GPUs"]} ({CountActive(_gpuRows, _gpuRemoves) + _gpuAdds.Count})")"
                                   Expanded="@HasOps(_gpuAdds, _gpuRemoves)">
                    @foreach(GpuByMachineDto g in _gpuRows ?? new())
                    {
                        bool removed = _gpuRemoves.Contains(g.Id ?? 0);
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-1">
                            <MudText Style="@(removed ? "text-decoration: line-through;" : "")">@FormatGpu(g)</MudText>
                            @if(removed)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default"
                                           OnClick="@(() => UndoRemove(_gpuRemoves, g.Id ?? 0))">@L["Undo"]</MudButton>
                            }
                            else
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                               OnClick="@(() => MarkRemove(_gpuRemoves, g.Id ?? 0))"/>
                            }
                        </MudStack>
                    }
                    @foreach(KeyValuePair<string, JunctionAddState> kv in _gpuAdds)
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-1">
                            <MudText><strong>+ @kv.Value.Display</strong></MudText>
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default"
                                       OnClick="@(() => _gpuAdds.Remove(kv.Key))">@L["Undo"]</MudButton>
                        </MudStack>
                    }
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-2">
                        <MudAutocomplete T="GpuDto" Value="@_pickGpu" ValueChanged="@(g => { _pickGpu = g; })"
                                         SearchFunc="SearchGpus" Clearable="true"
                                         ToStringFunc="@(g => g is null ? string.Empty : $"{g.Name} ({g.Company})")"
                                         Style="flex: 1;"/>
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                   OnClick="AddGpu" Disabled="@(_pickGpu is null)">@L["Add GPU"]</MudButton>
                    </MudStack>
                </MudExpansionPanel>

                @* Processors *@
                <MudExpansionPanel Text="@($"{L["Processors"]} ({CountActive(_processorRows, _processorRemoves) + _processorAdds.Count})")"
                                   Expanded="@HasOps(_processorAdds, _processorRemoves)">
                    @foreach(ProcessorByMachineDto p in _processorRows ?? new())
                    {
                        bool removed = _processorRemoves.Contains(p.Id ?? 0);
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-1">
                            <MudText Style="@(removed ? "text-decoration: line-through;" : "")">@FormatProcessor(p)</MudText>
                            @if(removed)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default"
                                           OnClick="@(() => UndoRemove(_processorRemoves, p.Id ?? 0))">@L["Undo"]</MudButton>
                            }
                            else
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                               OnClick="@(() => MarkRemove(_processorRemoves, p.Id ?? 0))"/>
                            }
                        </MudStack>
                    }
                    @foreach(KeyValuePair<string, JunctionAddState> kv in _processorAdds)
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-1">
                            <MudText><strong>+ @kv.Value.Display</strong></MudText>
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default"
                                       OnClick="@(() => _processorAdds.Remove(kv.Key))">@L["Undo"]</MudButton>
                        </MudStack>
                    }
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-2">
                        <MudAutocomplete T="ProcessorDto" Value="@_pickProcessor" ValueChanged="@(p => { _pickProcessor = p; })"
                                         SearchFunc="SearchProcessors" Clearable="true"
                                         ToStringFunc="@(p => p is null ? string.Empty : $"{p.Name} ({p.Company})")"
                                         Style="flex: 1;"/>
                        <MudNumericField T="float?" Value="@_pickProcessorSpeed" ValueChanged="@(v => { _pickProcessorSpeed = v; })"
                                         Label="@L["Speed (MHz)"]" Clearable="true" Style="max-width: 160px;"/>
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                   OnClick="AddProcessor" Disabled="@(_pickProcessor is null)">@L["Add Processor"]</MudButton>
                    </MudStack>
                </MudExpansionPanel>

                @* Sound Synthesizers *@
                <MudExpansionPanel Text="@($"{L["Sound Synthesizers"]} ({CountActive(_soundSynthRows, _soundSynthRemoves) + _soundSynthAdds.Count})")"
                                   Expanded="@HasOps(_soundSynthAdds, _soundSynthRemoves)">
                    @foreach(SoundSynthByMachineDto s in _soundSynthRows ?? new())
                    {
                        bool removed = _soundSynthRemoves.Contains(s.Id ?? 0);
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-1">
                            <MudText Style="@(removed ? "text-decoration: line-through;" : "")">@FormatSoundSynth(s)</MudText>
                            @if(removed)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default"
                                           OnClick="@(() => UndoRemove(_soundSynthRemoves, s.Id ?? 0))">@L["Undo"]</MudButton>
                            }
                            else
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                               OnClick="@(() => MarkRemove(_soundSynthRemoves, s.Id ?? 0))"/>
                            }
                        </MudStack>
                    }
                    @foreach(KeyValuePair<string, JunctionAddState> kv in _soundSynthAdds)
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-1">
                            <MudText><strong>+ @kv.Value.Display</strong></MudText>
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default"
                                       OnClick="@(() => _soundSynthAdds.Remove(kv.Key))">@L["Undo"]</MudButton>
                        </MudStack>
                    }
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-2">
                        <MudAutocomplete T="SoundSynthDto" Value="@_pickSoundSynth" ValueChanged="@(s => { _pickSoundSynth = s; })"
                                         SearchFunc="SearchSoundSynths" Clearable="true"
                                         ToStringFunc="@(s => s is null ? string.Empty : $"{s.Name} ({s.Company})")"
                                         Style="flex: 1;"/>
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                   OnClick="AddSoundSynth" Disabled="@(_pickSoundSynth is null)">@L["Add Sound Synth"]</MudButton>
                    </MudStack>
                </MudExpansionPanel>

                @* Screens *@
                <MudExpansionPanel Text="@($"{L["Screens"]} ({CountActive(_screenRows, _screenRemoves) + _screenAdds.Count})")"
                                   Expanded="@HasOps(_screenAdds, _screenRemoves)">
                    @foreach(ScreenByMachineDto s in _screenRows ?? new())
                    {
                        bool removed = _screenRemoves.Contains(s.Id ?? 0);
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-1">
                            <MudText Style="@(removed ? "text-decoration: line-through;" : "")">@FormatScreen(s)</MudText>
                            @if(removed)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default"
                                           OnClick="@(() => UndoRemove(_screenRemoves, s.Id ?? 0))">@L["Undo"]</MudButton>
                            }
                            else
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                               OnClick="@(() => MarkRemove(_screenRemoves, s.Id ?? 0))"/>
                            }
                        </MudStack>
                    }
                    @foreach(KeyValuePair<string, JunctionAddState> kv in _screenAdds)
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-1">
                            <MudText><strong>+ @kv.Value.Display</strong></MudText>
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default"
                                       OnClick="@(() => _screenAdds.Remove(kv.Key))">@L["Undo"]</MudButton>
                        </MudStack>
                    }
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-2">
                        <MudAutocomplete T="ScreenDto" Value="@_pickScreen" ValueChanged="@(s => { _pickScreen = s; })"
                                         SearchFunc="SearchScreens" Clearable="true"
                                         ToStringFunc="@(s => s is null ? string.Empty : FormatScreenDto(s))"
                                         Style="flex: 1;"/>
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                   OnClick="AddScreen" Disabled="@(_pickScreen is null)">@L["Add Screen"]</MudButton>
                    </MudStack>
                </MudExpansionPanel>

                @* Memory *@
                <MudExpansionPanel Text="@($"{L["Memory"]} ({CountActive(_memoryRows, _memoryRemoves) + _memoryAdds.Count})")"
                                   Expanded="@HasOps(_memoryAdds, _memoryRemoves)">
                    @foreach(MemoryByMachineDto m in _memoryRows ?? new())
                    {
                        bool removed = _memoryRemoves.Contains(m.Id ?? 0);
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-1">
                            <MudText Style="@(removed ? "text-decoration: line-through;" : "")">@FormatMemory(m)</MudText>
                            @if(removed)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default"
                                           OnClick="@(() => UndoRemove(_memoryRemoves, m.Id ?? 0))">@L["Undo"]</MudButton>
                            }
                            else
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                               OnClick="@(() => MarkRemove(_memoryRemoves, m.Id ?? 0))"/>
                            }
                        </MudStack>
                    }
                    @foreach(KeyValuePair<string, JunctionAddState> kv in _memoryAdds)
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-1">
                            <MudText><strong>+ @kv.Value.Display</strong></MudText>
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default"
                                       OnClick="@(() => _memoryAdds.Remove(kv.Key))">@L["Undo"]</MudButton>
                        </MudStack>
                    }
                    <MudPaper Class="pa-2 mt-2" Elevation="0" Outlined="true">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                            <MudSelect T="int" Value="@_pickMemoryType" ValueChanged="@(v => { _pickMemoryType = v; })"
                                       Label="@L["Memory Type"]" Style="flex: 1;">
                                @foreach(MemoryType mt in Enum.GetValues<MemoryType>())
                                {
                                    int v = (int)mt;
                                    <MudSelectItem T="int" Value="v">@mt.Humanize()</MudSelectItem>
                                }
                            </MudSelect>
                            <MudSelect T="int" Value="@_pickMemoryUsage" ValueChanged="@(v => { _pickMemoryUsage = v; })"
                                       Label="@L["Memory Usage"]" Style="flex: 1;">
                                @foreach(MemoryUsage mu in Enum.GetValues<MemoryUsage>())
                                {
                                    int v = (int)mu;
                                    <MudSelectItem T="int" Value="v">@mu.Humanize()</MudSelectItem>
                                }
                            </MudSelect>
                        </MudStack>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudNumericField T="long?" Value="@_pickMemorySize" ValueChanged="@(v => { _pickMemorySize = v; })"
                                             Label="@L["Size (bytes)"]" Clearable="true" Style="flex: 1;"/>
                            <MudNumericField T="double?" Value="@_pickMemorySpeed" ValueChanged="@(v => { _pickMemorySpeed = v; })"
                                             Label="@L["Speed (MHz) memory"]" Clearable="true" Style="flex: 1;"/>
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                       OnClick="AddMemory">@L["Add Memory"]</MudButton>
                        </MudStack>
                    </MudPaper>
                </MudExpansionPanel>

                @* Storage *@
                <MudExpansionPanel Text="@($"{L["Storage"]} ({CountActive(_storageRows, _storageRemoves) + _storageAdds.Count})")"
                                   Expanded="@HasOps(_storageAdds, _storageRemoves)">
                    @foreach(StorageByMachineDto s in _storageRows ?? new())
                    {
                        bool removed = _storageRemoves.Contains(s.Id ?? 0);
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-1">
                            <MudText Style="@(removed ? "text-decoration: line-through;" : "")">@FormatStorage(s)</MudText>
                            @if(removed)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default"
                                           OnClick="@(() => UndoRemove(_storageRemoves, s.Id ?? 0))">@L["Undo"]</MudButton>
                            }
                            else
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                               OnClick="@(() => MarkRemove(_storageRemoves, s.Id ?? 0))"/>
                            }
                        </MudStack>
                    }
                    @foreach(KeyValuePair<string, JunctionAddState> kv in _storageAdds)
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-1">
                            <MudText><strong>+ @kv.Value.Display</strong></MudText>
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default"
                                       OnClick="@(() => _storageAdds.Remove(kv.Key))">@L["Undo"]</MudButton>
                        </MudStack>
                    }
                    <MudPaper Class="pa-2 mt-2" Elevation="0" Outlined="true">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudSelect T="int" Value="@_pickStorageType" ValueChanged="@(v => { _pickStorageType = v; })"
                                       Label="@L["Storage Type"]" Style="flex: 1;">
                                @foreach(StorageType st in Enum.GetValues<StorageType>())
                                {
                                    int v = (int)st;
                                    <MudSelectItem T="int" Value="v">@st.Humanize()</MudSelectItem>
                                }
                            </MudSelect>
                            <MudSelect T="int" Value="@_pickStorageInterface" ValueChanged="@(v => { _pickStorageInterface = v; })"
                                       Label="@L["Storage Interface"]" Style="flex: 1;">
                                @foreach(StorageInterface si in Enum.GetValues<StorageInterface>())
                                {
                                    int v = (int)si;
                                    <MudSelectItem T="int" Value="v">@si.Humanize()</MudSelectItem>
                                }
                            </MudSelect>
                            <MudNumericField T="long?" Value="@_pickStorageCapacity" ValueChanged="@(v => { _pickStorageCapacity = v; })"
                                             Label="@L["Capacity (bytes)"]" Clearable="true" Style="max-width: 180px;"/>
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                       OnClick="AddStorage">@L["Add Storage"]</MudButton>
                        </MudStack>
                    </MudPaper>
                </MudExpansionPanel>

                @* Software Platforms *@
                <MudExpansionPanel Text="@($"{L["Software Platforms"]} ({CountActive(_softwarePlatformRows, _softwarePlatformRemoves) + _softwarePlatformAdds.Count})")"
                                   Expanded="@HasOps(_softwarePlatformAdds, _softwarePlatformRemoves)">
                    @foreach(SoftwarePlatformByMachineDto s in _softwarePlatformRows ?? new())
                    {
                        bool removed = _softwarePlatformRemoves.Contains(s.Id ?? 0);
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-1">
                            <MudText Style="@(removed ? "text-decoration: line-through;" : "")">@s.Name</MudText>
                            @if(removed)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default"
                                           OnClick="@(() => UndoRemove(_softwarePlatformRemoves, s.Id ?? 0))">@L["Undo"]</MudButton>
                            }
                            else
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                               OnClick="@(() => MarkRemove(_softwarePlatformRemoves, s.Id ?? 0))"/>
                            }
                        </MudStack>
                    }
                    @foreach(KeyValuePair<string, JunctionAddState> kv in _softwarePlatformAdds)
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-1">
                            <MudText><strong>+ @kv.Value.Display</strong></MudText>
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default"
                                       OnClick="@(() => _softwarePlatformAdds.Remove(kv.Key))">@L["Undo"]</MudButton>
                        </MudStack>
                    }
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-2">
                        <MudAutocomplete T="SoftwarePlatformDto" Value="@_pickSoftwarePlatform" ValueChanged="@(s => { _pickSoftwarePlatform = s; })"
                                         SearchFunc="SearchSoftwarePlatforms" Clearable="true"
                                         ToStringFunc="@(s => s?.Name ?? string.Empty)"
                                         Style="flex: 1;"/>
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                   OnClick="AddSoftwarePlatform" Disabled="@(_pickSoftwarePlatform is null)">@L["Add Software Platform"]</MudButton>
                    </MudStack>
                </MudExpansionPanel>

            </MudExpansionPanels>

            <MudTextField T="string" Label="@L["Optional comment (References, sources, etc...)"]" Lines="2"
                          MaxLength="2000" @bind-Value="_userComment"/>

            @if(!string.IsNullOrWhiteSpace(_validationError))
            {
                <MudAlert Severity="Severity.Error" Class="mt-2">@_validationError</MudAlert>
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit"
                   Disabled="@(_loading || _submitting || (!IsCreation && !HasAnyChange()) || (IsCreation && !HasMandatoryFieldsForCreation()))">
            @if(_submitting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true"/>
            }
            else
            {
                @L["Submit suggestion"]
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code
{
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; }

    [Parameter] public long       EntityId   { get; set; }
    [Parameter] public MachineDto CurrentDto { get; set; }

    /// <summary>
    ///     When <c>true</c>, the dialog is in creation mode: <c>CurrentDto</c> is null,
    ///     <c>EntityId</c> is ignored (the submitted suggestion will carry <c>EntityId=null</c>),
    ///     and the submit gate switches from "any change vs snapshot" to
    ///     "all mandatory creation fields populated".
    /// </summary>
    [Parameter] public bool         IsCreation  { get; set; }

    /// <summary>
    ///     Pre-select and lock the machine Type when in creation mode. Set by the caller based
    ///     on the entry-point landing page (Computer / Console / Smartphone). When null in
    ///     creation mode the Type select is editable and defaults to <c>Unknown</c>.
    /// </summary>
    [Parameter] public MachineType? PrefillType { get; set; }

    sealed class JunctionAddState
    {
        public Dictionary<string, object> Payload { get; set; }
        public string                     Display { get; set; }
    }

    bool _loading = true;
    bool _submitting;
    string _validationError;
    string _userComment;

    // Scalar state (mirrors the original CurrentDto values; diff'd at submit time)
    string _name;
    string _model;
    int _type;
    bool _prototype;
    DateTime? _introduced;
    int _introducedPrecision;
    CompanyDto _selectedCompany;
    MachineFamilyDto _selectedFamily;

    // Snapshot of the original scalar values (for diff computation at Submit time)
    string _orig_name;
    string _orig_model;
    int _orig_type;
    bool _orig_prototype;
    DateTime? _orig_introduced;
    int _orig_introducedPrecision;
    int? _orig_companyId;
    int? _orig_familyId;

    // Picker source lists
    List<CompanyDto>          _allCompanies;
    List<MachineFamilyDto>    _allFamilies;
    List<GpuDto>              _allGpus;
    List<ProcessorDto>        _allProcessors;
    List<SoundSynthDto>       _allSoundSynths;
    List<ScreenDto>           _allScreens;
    List<SoftwarePlatformDto> _allSoftwarePlatforms;

    // Existing junction rows
    List<GpuByMachineDto>              _gpuRows;
    List<ProcessorByMachineDto>        _processorRows;
    List<SoundSynthByMachineDto>       _soundSynthRows;
    List<ScreenByMachineDto>           _screenRows;
    List<MemoryByMachineDto>           _memoryRows;
    List<StorageByMachineDto>          _storageRows;
    List<SoftwarePlatformByMachineDto> _softwarePlatformRows;

    // Pending operations: removes (set of existing row ids) + adds (uuid → state)
    HashSet<long> _gpuRemoves              = new();
    HashSet<long> _processorRemoves        = new();
    HashSet<long> _soundSynthRemoves       = new();
    HashSet<long> _screenRemoves           = new();
    HashSet<long> _memoryRemoves           = new();
    HashSet<long> _storageRemoves          = new();
    HashSet<long> _softwarePlatformRemoves = new();

    Dictionary<string, JunctionAddState> _gpuAdds              = new();
    Dictionary<string, JunctionAddState> _processorAdds        = new();
    Dictionary<string, JunctionAddState> _soundSynthAdds       = new();
    Dictionary<string, JunctionAddState> _screenAdds           = new();
    Dictionary<string, JunctionAddState> _memoryAdds           = new();
    Dictionary<string, JunctionAddState> _storageAdds          = new();
    Dictionary<string, JunctionAddState> _softwarePlatformAdds = new();

    // Picker state
    GpuDto              _pickGpu;
    ProcessorDto        _pickProcessor;
    float?              _pickProcessorSpeed;
    SoundSynthDto       _pickSoundSynth;
    ScreenDto           _pickScreen;
    SoftwarePlatformDto _pickSoftwarePlatform;

    int     _pickMemoryType;
    int     _pickMemoryUsage;
    long?   _pickMemorySize;
    double? _pickMemorySpeed;

    int   _pickStorageType;
    int   _pickStorageInterface;
    long? _pickStorageCapacity;

    static readonly Dictionary<int, string> MemoryTypeNames =
        Enum.GetValues<MemoryType>().ToDictionary(e => (int)e, e => e.Humanize());

    static readonly Dictionary<int, string> MemoryUsageNames =
        Enum.GetValues<MemoryUsage>().ToDictionary(e => (int)e, e => e.Humanize());

    static readonly Dictionary<int, string> StorageTypeNames =
        Enum.GetValues<StorageType>().ToDictionary(e => (int)e, e => e.Humanize());

    static readonly Dictionary<int, string> StorageInterfaceNames =
        Enum.GetValues<StorageInterface>().ToDictionary(e => (int)e, e => e.Humanize());

    protected override async Task OnInitializedAsync()
    {
        // Seed scalar state from the current DTO snapshot.
        if(CurrentDto is not null)
        {
            _name                    = CurrentDto.Name;
            _model                   = CurrentDto.Model;
            _type                    = CurrentDto.Type ?? 0;
            _prototype               = CurrentDto.Prototype ?? false;
            _introduced              = CurrentDto.Introduced?.UtcDateTime;
            _introducedPrecision     = CurrentDto.IntroducedPrecision ?? 0;
            _orig_name               = _name;
            _orig_model              = _model;
            _orig_type               = _type;
            _orig_prototype          = _prototype;
            _orig_introduced         = _introduced;
            _orig_introducedPrecision = _introducedPrecision;
            _orig_companyId          = CurrentDto.CompanyId;
            _orig_familyId           = CurrentDto.FamilyId;
        }
        else if(IsCreation)
        {
            // Brand-new entity. Snapshot is "empty" so any populated field counts as a change.
            _type            = (int)(PrefillType ?? MachineType.Unknown);
            _orig_type       = _type;  // type carries through to Submit() even when locked
            _orig_companyId  = null;
            _orig_familyId   = null;
        }

        // Load picker corpora always. Existing-junction-by-machine loads are skipped in
        // creation mode because there's no parent row yet.
        Task<List<CompanyDto>>          companiesT = MachinesService.GetCompaniesAsync();
        Task<List<MachineFamilyDto>>    familiesT  = MachinesService.GetFamiliesAsync();
        Task<List<GpuDto>>              allGpusT   = MachinesService.GetAllGpusAsync();
        Task<List<ProcessorDto>>        allProcsT  = MachinesService.GetAllProcessorsAsync();
        Task<List<SoundSynthDto>>       allSoundsT = MachinesService.GetAllSoundSynthsAsync();
        Task<List<ScreenDto>>           allScrnT   = MachinesService.GetAllScreensAsync();
        Task<List<SoftwarePlatformDto>> allSpT     = MachinesService.GetAllSoftwarePlatformsAsync();

        if(IsCreation)
        {
            await Task.WhenAll(companiesT, familiesT, allGpusT, allProcsT, allSoundsT, allScrnT, allSpT);

            _allCompanies         = companiesT.Result;
            _allFamilies          = familiesT.Result;
            _allGpus              = allGpusT.Result;
            _allProcessors        = allProcsT.Result;
            _allSoundSynths       = allSoundsT.Result;
            _allScreens           = allScrnT.Result;
            _allSoftwarePlatforms = allSpT.Result;

            // Junction rows stay empty in creation mode (no parent row to load from).
            _gpuRows              = new List<GpuByMachineDto>();
            _processorRows        = new List<ProcessorByMachineDto>();
            _soundSynthRows       = new List<SoundSynthByMachineDto>();
            _screenRows           = new List<ScreenByMachineDto>();
            _memoryRows           = new List<MemoryByMachineDto>();
            _storageRows          = new List<StorageByMachineDto>();
            _softwarePlatformRows = new List<SoftwarePlatformByMachineDto>();

            _loading = false;
            return;
        }

        int machineId = (int)EntityId;

        Task<List<GpuByMachineDto>>              gpusByT       = MachinesService.GetGpusByMachineAsync(machineId);
        Task<List<ProcessorByMachineDto>>        procsByT      = MachinesService.GetProcessorsByMachineAsync(machineId);
        Task<List<SoundSynthByMachineDto>>       soundsByT     = MachinesService.GetSoundSynthsByMachineAsync(machineId);
        Task<List<ScreenByMachineDto>>           screensByT    = MachinesService.GetScreensByMachineAsync(machineId);
        Task<List<MemoryByMachineDto>>           memByT        = MachinesService.GetMemoryByMachineAsync(machineId);
        Task<List<StorageByMachineDto>>          storByT       = MachinesService.GetStorageByMachineAsync(machineId);
        Task<List<SoftwarePlatformByMachineDto>> spByT         = MachinesService.GetSoftwarePlatformsByMachineAsync(machineId);

        await Task.WhenAll(companiesT, familiesT, allGpusT, allProcsT, allSoundsT, allScrnT, allSpT,
                           gpusByT, procsByT, soundsByT, screensByT, memByT, storByT, spByT);

        _allCompanies         = companiesT.Result;
        _allFamilies          = familiesT.Result;
        _allGpus              = allGpusT.Result;
        _allProcessors        = allProcsT.Result;
        _allSoundSynths       = allSoundsT.Result;
        _allScreens           = allScrnT.Result;
        _allSoftwarePlatforms = allSpT.Result;

        _gpuRows              = gpusByT.Result;
        _processorRows        = procsByT.Result;
        _soundSynthRows       = soundsByT.Result;
        _screenRows           = screensByT.Result;
        _memoryRows           = memByT.Result;
        _storageRows          = storByT.Result;
        _softwarePlatformRows = spByT.Result;

        if(_orig_companyId.HasValue && _allCompanies is not null)
            _selectedCompany = _allCompanies.Find(c => c.Id == _orig_companyId.Value);

        if(_orig_familyId.HasValue && _allFamilies is not null)
            _selectedFamily = _allFamilies.Find(f => f.Id == _orig_familyId.Value);

        _loading = false;
    }

    // ───────────────────────────── Search functions ─────────────────────────────

    Task<IEnumerable<CompanyDto>> SearchCompanies(string value, CancellationToken ct)
    {
        IEnumerable<CompanyDto> r = _allCompanies ?? [];
        if(!string.IsNullOrWhiteSpace(value))
            r = r.Where(c => c.Name?.Contains(value, StringComparison.OrdinalIgnoreCase) ?? false);
        return Task.FromResult(r);
    }

    Task<IEnumerable<MachineFamilyDto>> SearchFamilies(string value, CancellationToken ct)
    {
        IEnumerable<MachineFamilyDto> r = _allFamilies ?? [];
        if(!string.IsNullOrWhiteSpace(value))
            r = r.Where(f => f.Name?.Contains(value, StringComparison.OrdinalIgnoreCase) ?? false);
        return Task.FromResult(r);
    }

    Task<IEnumerable<GpuDto>> SearchGpus(string value, CancellationToken ct)
    {
        HashSet<int?> assigned = new(GetEffectiveIds(_gpuRows, _gpuRemoves, g => g.GpuId, _gpuAdds, p => GetIntField(p, "gpu_id")));
        IEnumerable<GpuDto> r = (_allGpus ?? []).Where(g => !assigned.Contains(g.Id));
        if(!string.IsNullOrWhiteSpace(value))
            r = r.Where(g => $"{g.Name} ({g.Company})".Contains(value, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(r);
    }

    Task<IEnumerable<ProcessorDto>> SearchProcessors(string value, CancellationToken ct)
    {
        IEnumerable<ProcessorDto> r = _allProcessors ?? [];
        if(!string.IsNullOrWhiteSpace(value))
            r = r.Where(p => $"{p.Name} ({p.Company})".Contains(value, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(r);
    }

    Task<IEnumerable<SoundSynthDto>> SearchSoundSynths(string value, CancellationToken ct)
    {
        HashSet<int?> assigned = new(GetEffectiveIds(_soundSynthRows, _soundSynthRemoves, s => s.SoundSynthId, _soundSynthAdds, p => GetIntField(p, "sound_synth_id")));
        IEnumerable<SoundSynthDto> r = (_allSoundSynths ?? []).Where(s => !assigned.Contains(s.Id));
        if(!string.IsNullOrWhiteSpace(value))
            r = r.Where(s => $"{s.Name} ({s.Company})".Contains(value, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(r);
    }

    Task<IEnumerable<ScreenDto>> SearchScreens(string value, CancellationToken ct)
    {
        HashSet<int?> assigned = new(GetEffectiveIds(_screenRows, _screenRemoves, s => s.ScreenId, _screenAdds, p => GetIntField(p, "screen_id")));
        IEnumerable<ScreenDto> r = (_allScreens ?? []).Where(s => !assigned.Contains(s.Id));
        if(!string.IsNullOrWhiteSpace(value))
            r = r.Where(s => FormatScreenDto(s).Contains(value, StringComparison.OrdinalIgnoreCase));
