@using System
@using System.Globalization
@using System.Linq
@using System.Text.Json
@using System.Threading
@using Marechai.ApiClient.Models
@using Marechai.Data
@using Marechai.Services
@using Marechai.Suggestions
@using Marechai.Suggestions.Metadata

@inject IStringLocalizer<SoftwareService> L
@inject ISnackbar          Snackbar
@inject SoftwareService    SoftwareService
@inject SuggestionsService SuggestionsService

@*
    Dedicated suggestion dialog for editing the Credits card of a Software entry.
    Companion to SoftwareSuggestionDialog (General Info + Genres) and
    SoftwareCompaniesSuggestionDialog (Companies card).

    The PeopleBySoftware junction extends BaseModel<long> so it has a SURROGATE row Id —
    the remove token is therefore the row Id directly (parsed long), not a composite
    tuple. Per spec, RoleId (FK to DocumentRole) STAYS NULL — only the free-text Role
    string column is populated/edited via suggestions. The role picker is a
    MudAutocomplete<string> over the DISTINCT current Role values returned by
    GET /software/credits/roles, allowing reuse of established roles AND custom new
    entries (CoerceValue/CoerceText, no Strict gating).

    People corpus is too large to pre-load — picker uses server-typeahead via
    SoftwareService.SearchPeopleAsync (MinCharacters=2, debounced 300ms).

    Wire shape: credits.add.<uuid> = {person_id, role}; credits.remove.<rowId> = null.
    Server-side dispatch goes through the existing SoftwareSuggestionApplier
    (entity_type = SuggestionEntityType.Software). Dedup matches the unique index
    (SoftwareId, PersonId, Role) — same person CAN appear under multiple distinct
    role strings.
*@

<MudDialog>
    <DialogContent>
        @if(_loading)
        {
            <MudProgressLinear Indeterminate="true"/>
        }
        else
        {
            <MudText Typo="Typo.body2" Class="mb-3">
                @L["Edit any field or junction below. Only your changes will be sent for review; an administrator can accept or reject each one independently."]
            </MudText>

            <MudPaper Outlined="true" Class="pa-3 mb-3">
                @foreach(PersonBySoftwareDto c in _creditRows ?? new())
                {
                    string token   = c.Id?.ToString(CultureInfo.InvariantCulture) ?? string.Empty;
                    bool   removed = !string.IsNullOrEmpty(token) && _creditRemoveTokens.Contains(token);
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-1">
                        <MudText Style="@(removed ? "text-decoration: line-through;" : "")">@FormatCredit(c)</MudText>
                        @if(removed)
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default"
                                       OnClick="@(() => _creditRemoveTokens.Remove(token))">@L["Undo"]</MudButton>
                        }
                        else if(!string.IsNullOrEmpty(token))
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                           OnClick="@(() => _creditRemoveTokens.Add(token))"/>
                        }
                    </MudStack>
                }
                @foreach(KeyValuePair<string, JunctionAddState> kv in _creditAdds)
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-1">
                        <MudText><strong>+ @kv.Value.Display</strong></MudText>
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default"
                                   OnClick="@(() => _creditAdds.Remove(kv.Key))">@L["Undo"]</MudButton>
                    </MudStack>
                }
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-2">
                    <MudAutocomplete T="PersonDto" Value="@_pickPerson" ValueChanged="@(p => { _pickPerson = p; })"
                                     SearchFunc="SearchPeople" Clearable="true"
                                     MinCharacters="2" DebounceInterval="300"
                                     ResetValueOnEmptyText="false"
                                     ToStringFunc="@(p => FormatPerson(p))"
                                     Label="@L["Person"]"
                                     Style="flex: 1;"/>
                    <MudAutocomplete T="string" Value="@_pickRole" ValueChanged="@(r => { _pickRole = r; })"
                                     SearchFunc="SearchRoles" Clearable="true"
                                     CoerceValue="true" CoerceText="true"
                                     Label="@L["Role"]" Style="max-width: 240px;"/>
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                               OnClick="AddCredit"
                               Disabled="@(_pickPerson is null || string.IsNullOrWhiteSpace(_pickRole))">@L["Add credit"]</MudButton>
                </MudStack>
            </MudPaper>

            <MudTextField T="string" Label="@L["Optional comment (References, sources, etc...)"]" Lines="2"
                          MaxLength="2000" @bind-Value="_userComment"/>

            @if(!string.IsNullOrWhiteSpace(_validationError))
            {
                <MudAlert Severity="Severity.Error" Class="mt-2">@_validationError</MudAlert>
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit"
                   Disabled="@(_loading || _submitting || !HasAnyChange())">
            @if(_submitting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true"/>
            }
            else
            {
                @L["Submit suggestion"]
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code
{
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; }

    [Parameter] public long EntityId { get; set; }

    sealed class JunctionAddState
    {
        public Dictionary<string, object> Payload { get; set; }
        public string                     Display { get; set; }
    }

    bool   _loading = true;
    bool   _submitting;
    string _validationError;
    string _userComment;

    // Picker source list — DISTINCT role display strings in the contributor's UI language
    // (English fallback when no translation row exists yet). Populated from the new
    // SoftwareCreditRoleDto pairs so the autocomplete shows the localized text.
    List<string> _allRoles;

    // Display→canonical-English lookup. The autocomplete shows the localized role; the
    // canonical English equivalent is what we send on the wire so the database keys on the
    // same English row regardless of UI locale. Free-text new entries fall through unchanged.
    Dictionary<string, string> _roleCanonicalByDisplayName = new(StringComparer.OrdinalIgnoreCase);

    // Existing credit rows (read once on init, displayed verbatim).
    List<PersonBySoftwareDto> _creditRows;

    // Pending credit operations. Removes track the surrogate row Id stringified;
    // PeopleBySoftware extends BaseModel<long> so a row id is stable.
    HashSet<string>                      _creditRemoveTokens = new();
    Dictionary<string, JunctionAddState> _creditAdds         = new();

    // Picker state (single flat panel — no per-role split).
    PersonDto _pickPerson;
    string    _pickRole;

    protected override async Task OnInitializedAsync()
    {
        Task<List<PersonBySoftwareDto>>   creditsT = SoftwareService.GetCreditsBySoftwareAsync((int)EntityId);
        Task<List<SoftwareCreditRoleDto>> rolesT   = SoftwareService.GetCreditsRolesAsync();
        await Task.WhenAll(creditsT, rolesT);

        _creditRows = creditsT.Result;

        // Build the localized display list and the display→canonical lookup in one pass.
        // GroupBy on the localized Role collapses any duplicates (shouldn't occur given the
        // server-side DISTINCT, but defensive). First() picks an arbitrary canonical mapping.
        List<SoftwareCreditRoleDto> roles = rolesT.Result ?? [];
        _allRoles = roles
                   .Where(r => !string.IsNullOrWhiteSpace(r.Role))
                   .Select(r => r.Role!)
                   .Distinct(StringComparer.CurrentCultureIgnoreCase)
                   .OrderBy(s => s, StringComparer.CurrentCultureIgnoreCase)
                   .ToList();
        _roleCanonicalByDisplayName = roles
                                     .Where(r => !string.IsNullOrWhiteSpace(r.Role) &&
                                                 !string.IsNullOrWhiteSpace(r.CanonicalRole))
                                     .GroupBy(r => r.Role!, StringComparer.OrdinalIgnoreCase)
                                     .ToDictionary(g => g.Key,
                                                   g => g.First().CanonicalRole!,
                                                   StringComparer.OrdinalIgnoreCase);

        _loading = false;
    }

    async Task<IEnumerable<PersonDto>> SearchPeople(string value, CancellationToken ct)
    {
        if(string.IsNullOrWhiteSpace(value) || value.Length < 2) return [];
        List<PersonDto> hits = await SoftwareService.SearchPeopleAsync(value);
        return hits;
    }

    Task<IEnumerable<string>> SearchRoles(string value, CancellationToken ct)
    {
        IEnumerable<string> r = _allRoles ?? [];
        if(!string.IsNullOrWhiteSpace(value))
            r = r.Where(s => s?.Contains(value, StringComparison.OrdinalIgnoreCase) ?? false);
        return Task.FromResult(r.Take(50));
    }

    static string FormatPerson(PersonDto p)
    {
        if(p is null) return string.Empty;
        if(!string.IsNullOrEmpty(p.DisplayName)) return p.DisplayName;
        if(!string.IsNullOrEmpty(p.Alias))       return p.Alias;
        return $"{p.Name} {p.Surname}".Trim();
    }

    string FormatCredit(PersonBySoftwareDto c)
    {
        if(c is null) return string.Empty;
        string name = !string.IsNullOrEmpty(c.DisplayName) ? c.DisplayName
                      : !string.IsNullOrEmpty(c.Alias)     ? c.Alias
                      :                                      $"{c.Name} {c.Surname}".Trim();
        if(string.IsNullOrWhiteSpace(name)) name = $"#{c.PersonId}";
        return string.IsNullOrEmpty(c.Role) ? name : $"{name} ({c.Role})";
    }

    static string NewKey(string group, string op) => $"{group}.{op}.{Guid.NewGuid():N}";

    void AddCredit()
    {
        if(_pickPerson is null || !_pickPerson.Id.HasValue) return;
        if(string.IsNullOrWhiteSpace(_pickRole)) return;

        int    pid     = _pickPerson.Id.Value;
        string display = _pickRole.Trim();

        // Variant-B resolve: if the contributor picked an existing localized role, swap to the
        // canonical English equivalent for the wire payload. Free-text new entries fall through
        // unchanged — the server creates a new English row, the worker translates next sweep.
        string role = _roleCanonicalByDisplayName.TryGetValue(display, out string canonical)
                          ? canonical
                          : display;
        if(role.Length > 256) return;

        // Local dedup against existing rows (skip pairs already removed) + queued adds.
        // The same person CAN appear under DIFFERENT roles, so dedup is on the triple
        // (PersonId, Role) within this software's scope. Compare against CanonicalRole
        // because `role` is now canonical English and existing rows expose both Role
        // (localized) and CanonicalRole. Falls back to Role for legacy entries that
        // lack a populated CanonicalRole.
        if(_creditRows is not null)
        {
            foreach(PersonBySoftwareDto c in _creditRows)
            {
                string existingCanonical = !string.IsNullOrEmpty(c.CanonicalRole) ? c.CanonicalRole : c.Role;
                if(c.PersonId == pid && string.Equals(existingCanonical, role, StringComparison.Ordinal))
                {
                    string existingToken = c.Id?.ToString(CultureInfo.InvariantCulture);
                    if(!string.IsNullOrEmpty(existingToken) && !_creditRemoveTokens.Contains(existingToken))
                        return;
                }
            }
        }
        foreach(JunctionAddState a in _creditAdds.Values)
        {
            int?   existPid  = a.Payload != null && a.Payload.TryGetValue("person_id", out object pv) && pv is int pvi ? pvi : (int?)null;
            string existRole = a.Payload != null && a.Payload.TryGetValue("role",      out object rv) ? rv as string : null;
            if(existPid == pid && string.Equals(existRole, role, StringComparison.Ordinal)) return;
        }

        string key = NewKey(SoftwareSuggestionMetadata.GroupCredits, "add");
        _creditAdds[key] = new JunctionAddState
        {
            Payload = new Dictionary<string, object>(StringComparer.Ordinal)
            {
                ["person_id"] = pid,
                ["role"]      = role
            },
            Display = $"{FormatPerson(_pickPerson)} ({display})"
        };
        _pickPerson = null;
        _pickRole   = null;
    }

    bool HasAnyChange() => _creditAdds.Count > 0 || _creditRemoveTokens.Count > 0;

    void Cancel() => MudDialog.Cancel();

    async Task Submit()
    {
        _validationError = null;
        if(_loading) return;

        if(!HasAnyChange())
        {
            _validationError = L["No changes detected — modify at least one field before submitting."];
            return;
        }

        var diff = new Dictionary<string, object>(StringComparer.Ordinal);

        foreach(KeyValuePair<string, JunctionAddState> kv in _creditAdds)
            diff[kv.Key] = kv.Value.Payload;
        foreach(string token in _creditRemoveTokens)
            diff[$"{SoftwareSuggestionMetadata.GroupCredits}.remove.{token}"] = null;

        _submitting = true;
        try
        {
            string json = JsonSerializer.Serialize(diff);
            var dto = new SuggestionDto
            {
                EntityType          = (int?)SuggestionEntityType.Software,
                EntityId            = EntityId,
                Status              = (int?)SuggestionStatus.Pending,
                UserComment         = string.IsNullOrWhiteSpace(_userComment) ? null : _userComment.Trim(),
                SuggestedValuesJson = json
            };

            var (created, error) = await SuggestionsService.CreateAsync(dto);

            if(created is null)
            {
                _validationError = string.IsNullOrWhiteSpace(error) ? L["Failed to submit suggestion."].Value : error;
                return;
            }

            Snackbar.Add(L["Suggestion submitted. An administrator will review it."], Severity.Success);
            MudDialog.Close(DialogResult.Ok(created));
        }
        finally
        {
            _submitting = false;
        }
    }
}
