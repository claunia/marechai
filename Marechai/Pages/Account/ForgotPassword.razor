@page "/forgot-password"
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject IStringLocalizer<ProfileService> L

<EntityMetaTags Title="@L["Forgot password"]" Description="Reset your Marechai password." CanonicalPath="/forgot-password" NoIndex="true" />

<MudPaper Class="pa-6 mb-6" Elevation="0" Style="background: linear-gradient(135deg, #7e57c2 0%, #42a5f5 100%); border-radius: 16px;">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
        <MudIcon Icon="@Icons.Material.Filled.LockReset" Size="Size.Large" Style="color: white;"/>
        <MudText Typo="Typo.h4" Style="color: white;">@L["Forgot Password"]</MudText>
    </MudStack>
</MudPaper>

<MudGrid Justify="Justify.Center">
    <MudItem xs="12" sm="8" md="6" lg="4">
        <MudPaper Elevation="2" Class="pa-6 rounded-lg">
            @if(!_submitted)
            {
                <MudText Typo="Typo.body1" Class="mb-4">
                    @L["Enter the email address for your account and we will send you a link to reset your password."]
                </MudText>

                @if(!string.IsNullOrWhiteSpace(_errorMessage))
                {
                    <MudAlert Severity="Severity.Error" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="() => _errorMessage = null">@_errorMessage</MudAlert>
                }

                <MudTextField @bind-Value="_email"
                              Label="@L["Email"]"
                              Variant="Variant.Outlined"
                              InputType="InputType.Email"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Email"
                              Class="mb-4"
                              Disabled="_isLoading"
                              OnKeyDown="OnEmailKeyDown"/>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Size="Size.Large"
                           OnClick="SubmitAsync"
                           Disabled="_isLoading"
                           StartIcon="@(_isLoading ? null : Icons.Material.Filled.Send)">
                    @if(_isLoading)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2"/>
                        <span>@L["Sending..."]</span>
                    }
                    else
                    {
                        <span>@L["Send reset link"]</span>
                    }
                </MudButton>
            }
            else
            {
                <MudAlert Severity="Severity.Info" Class="mb-4">
                    @L["If an account with that email exists, we have sent a password reset link to it. Please check your inbox (and spam folder) and follow the link to choose a new password."]
                </MudAlert>
            }

            <div class="d-flex justify-center mt-3">
                <MudLink Href="/login" Underline="Underline.Hover">@L["Back to sign in"]</MudLink>
            </div>
        </MudPaper>
    </MudItem>
</MudGrid>
