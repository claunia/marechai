@page "/account/change-password"
@attribute [Authorize]
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject IStringLocalizer<ProfileService> L

<MudPaper Class="pa-6 mb-6" Elevation="0" Style="background: linear-gradient(135deg, #7e57c2 0%, #42a5f5 100%); border-radius: 16px;">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
        <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Large" Style="color: white;"/>
        <MudText Typo="Typo.h4" Style="color: white;">@L["Change password"]</MudText>
    </MudStack>
</MudPaper>

<MudGrid Justify="Justify.Center">
    <MudItem xs="12" sm="8" md="6" lg="4">
        <MudPaper Elevation="2" Class="pa-6 rounded-lg">
            @if(!string.IsNullOrWhiteSpace(_successMessage))
            {
                <MudAlert Severity="Severity.Success" Class="mb-4">@_successMessage</MudAlert>
            }

            @if(!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="() => _errorMessage = null">@_errorMessage</MudAlert>
            }

            <MudTextField @bind-Value="_currentPassword"
                          Label="@L["Current password"]"
                          Variant="Variant.Outlined"
                          InputType="InputType.Password"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Lock"
                          Class="mb-4"
                          Disabled="_isSaving"/>

            <MudTextField @bind-Value="_newPassword"
                          Label="@L["New password"]"
                          Variant="Variant.Outlined"
                          InputType="InputType.Password"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.LockReset"
                          Class="mb-4"
                          Disabled="_isSaving"
                          HelperText="@L["Minimum 6 characters"]"/>

            <MudTextField @bind-Value="_confirmPassword"
                          Label="@L["Confirm new password"]"
                          Variant="Variant.Outlined"
                          InputType="InputType.Password"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.LockReset"
                          Class="mb-6"
                          Disabled="_isSaving"/>

            <MudStack Row="true" Spacing="2" Justify="Justify.FlexEnd">
                <MudButton Variant="Variant.Text" Color="Color.Default" Href="/account/profile" Disabled="_isSaving">@L["Cancel"]</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ChangePasswordAsync" Disabled="_isSaving"
                           StartIcon="@(_isSaving ? null : Icons.Material.Filled.Save)">
                    @if(_isSaving)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2"/>
                        <span>@L["Changing..."]</span>
                    }
                    else
                    {
                        <span>@L["Change password"]</span>
                    }
                </MudButton>
            </MudStack>
        </MudPaper>
    </MudItem>
</MudGrid>
