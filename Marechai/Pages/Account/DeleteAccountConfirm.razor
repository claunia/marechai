@page "/account/delete-confirm"
@attribute [Authorize]
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject IStringLocalizer<ProfileService> L

<EntityMetaTags Title="@L["Delete account"]" Description="Confirm Marechai account deletion." CanonicalPath="/account/delete-confirm" NoIndex="true" />

<MudPaper Class="pa-6 mb-6" Elevation="0" Style="background: linear-gradient(135deg, #c62828 0%, #ef5350 100%); border-radius: 16px;">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
        <MudIcon Icon="@Icons.Material.Filled.HourglassTop" Size="Size.Large" Style="color: white;"/>
        <MudText Typo="Typo.h4" Style="color: white;">@L["Confirm account deletion"]</MudText>
    </MudStack>
</MudPaper>

<MudGrid Justify="Justify.Center">
    <MudItem xs="12" sm="8" md="6" lg="4">
        <MudPaper Elevation="2" Class="pa-6 rounded-lg">
            @if(_isLoading)
            {
                <div class="d-flex justify-center"><MudProgressCircular Indeterminate="true"/></div>
            }
            else if(_succeeded)
            {
                <MudAlert Severity="Severity.Warning" Class="mb-4">
                    @L["Your account is now scheduled for deletion. We will permanently remove it after the 30-day grace window. To cancel, sign in any time before then and choose 'Cancel deletion'."]
                </MudAlert>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Href="/account/deletion-pending" StartIcon="@Icons.Material.Filled.Info">
                    @L["View deletion status"]
                </MudButton>
            }
            else
            {
                <MudAlert Severity="Severity.Error" Class="mb-4">@(_errorMessage ?? L["Invalid or expired deletion link."])</MudAlert>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true" Href="/account/delete">@L["Restart deletion request"]</MudButton>
            }
        </MudPaper>
    </MudItem>
</MudGrid>
