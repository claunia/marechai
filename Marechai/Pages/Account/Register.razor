@page "/register"
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject IStringLocalizer<ProfileService> L

<MudPaper Class="pa-6 mb-6" Elevation="0" Style="background: linear-gradient(135deg, #7e57c2 0%, #42a5f5 100%); border-radius: 16px;">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
        <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Size="Size.Large" Style="color: white;"/>
        <MudText Typo="Typo.h4" Style="color: white;">@L["Create an account"]</MudText>
    </MudStack>
</MudPaper>

<MudGrid Justify="Justify.Center">
    <MudItem xs="12" sm="10" md="8" lg="6">
        <MudPaper Elevation="2" Class="pa-6 rounded-lg">
            @if(!_submitted)
            {
                <MudText Typo="Typo.body1" Class="mb-4">
                    @L["Marechai is an invitation-only community. Paste the code an admin shared with you, fill in the fields below, and we will email you a link to confirm your account."]
                </MudText>

                @if(!string.IsNullOrWhiteSpace(_errorMessage))
                {
                    <MudAlert Severity="Severity.Error" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="() => _errorMessage = null">@_errorMessage</MudAlert>
                }

                <MudTextField @bind-Value="_invitationCode"
                              Label="@L["Invitation code"]"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Key"
                              HelperText="@L["Format: XXXX-YYYY"]"
                              Class="mb-4"
                              Disabled="_isLoading"/>

                <MudTextField @bind-Value="_email"
                              Label="@L["Email"]"
                              Variant="Variant.Outlined"
                              InputType="InputType.Email"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Email"
                              Class="mb-4"
                              Disabled="_isLoading"/>

                <MudTextField @bind-Value="_userName"
                              Label="@L["Username"]"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.AlternateEmail"
                              Class="mb-4"
                              Disabled="_isLoading"/>

                <MudTextField @bind-Value="_displayName"
                              Label="@L["Display name"]"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Badge"
                              HelperText="@L["Shown publicly on your profile and contributions."]"
                              Class="mb-4"
                              Disabled="_isLoading"/>

                <MudTextField @bind-Value="_password"
                              Label="@L["Password"]"
                              Variant="Variant.Outlined"
                              InputType="InputType.Password"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Lock"
                              Class="mb-4"
                              Disabled="_isLoading"/>

                <MudTextField @bind-Value="_confirmPassword"
                              Label="@L["Confirm password"]"
                              Variant="Variant.Outlined"
                              InputType="InputType.Password"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Lock"
                              Class="mb-4"
                              Disabled="_isLoading"/>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Size="Size.Large"
                           OnClick="SubmitAsync"
                           Disabled="_isLoading"
                           StartIcon="@(_isLoading ? null : Icons.Material.Filled.PersonAdd)">
                    @if(_isLoading)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2"/>
                        <span>@L["Creating account..."]</span>
                    }
                    else
                    {
                        <span>@L["Create account"]</span>
                    }
                </MudButton>
            }
            else
            {
                <MudAlert Severity="Severity.Success" Class="mb-4">
                    @L["Account created. We have sent you a confirmation email — click the link inside to activate your account, then come back here to sign in."]
                </MudAlert>
                <div class="d-flex justify-center mt-2">
                    <MudLink Href="/resend-confirmation" Underline="Underline.Hover">@L["Didn't get the email?"]</MudLink>
                </div>
            }

            <div class="d-flex justify-center mt-3">
                <MudLink Href="/login" Underline="Underline.Hover">@L["Already have an account? Sign in"]</MudLink>
            </div>
        </MudPaper>
    </MudItem>
</MudGrid>
