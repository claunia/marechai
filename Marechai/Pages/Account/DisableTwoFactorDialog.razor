@inject IDialogService DialogService

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-3">For your security, please confirm by entering your current password and a valid two-factor code.</MudText>

        <MudTextField @bind-Value="_password" Label="Current password" InputType="InputType.Password" Variant="Variant.Outlined" Class="mb-3"/>

        @if(AuthenticatorAvailable && EmailAvailable)
        {
            <MudSelect T="string" @bind-Value="_provider" Label="Code source" Variant="Variant.Outlined" Class="mb-3">
                <MudSelectItem Value="@("authenticator")">Authenticator app</MudSelectItem>
                <MudSelectItem Value="@("email")">Email code</MudSelectItem>
                <MudSelectItem Value="@("recovery")">Recovery code</MudSelectItem>
            </MudSelect>
        }
        else
        {
            <MudSelect T="string" @bind-Value="_provider" Label="Code source" Variant="Variant.Outlined" Class="mb-3">
                @if(AuthenticatorAvailable)
                {
                    <MudSelectItem Value="@("authenticator")">Authenticator app</MudSelectItem>
                }
                @if(EmailAvailable)
                {
                    <MudSelectItem Value="@("email")">Email code</MudSelectItem>
                }
                <MudSelectItem Value="@("recovery")">Recovery code</MudSelectItem>
            </MudSelect>
        }

        @if(_provider == "email")
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Class="mb-3" OnClick="SendEmailCodeAsync" Disabled="_busy">Send code to my email</MudButton>
            @if(!string.IsNullOrEmpty(_emailMessage))
            {
                <MudAlert Severity="Severity.Info" Class="mb-3">@_emailMessage</MudAlert>
            }
        }

        <MudTextField @bind-Value="_code" Label="@(_provider == "recovery" ? "Recovery code" : "Verification code")" Variant="Variant.Outlined"/>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">Confirm</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; }

    [Parameter] public string Title                  { get; set; } = "Confirm";
    [Parameter] public bool   AuthenticatorAvailable { get; set; }
    [Parameter] public bool   EmailAvailable         { get; set; }
    [Parameter] public string DefaultProvider        { get; set; } = "authenticator";

    [Inject] AuthService AuthService { get; set; }

    string _password;
    string _code;
    string _provider;
    string _emailMessage;
    bool   _busy;

    protected override void OnInitialized() => _provider = DefaultProvider;

    async Task SendEmailCodeAsync()
    {
        // Reuse the start-email-enable endpoint: it dispatches a fresh code to the user's email regardless of
        // whether email-2FA is currently enabled, because the underlying Identity provider only needs the user
        // record + Email provider key. The code is the same one VerifyTwoFactorTokenAsync(user, "Email", ...)
        // accepts.
        _busy = true;
        (bool ok, string err) = await AuthService.StartEmailEnableAsync();
        _busy = false;

        _emailMessage = ok ? "Code sent to your email." : err ?? "Could not send code.";
    }

    void Cancel() => MudDialog.Cancel();

    void Submit()
    {
        if(string.IsNullOrWhiteSpace(_password) || string.IsNullOrWhiteSpace(_code))
            return;

        MudDialog.Close(DialogResult.Ok(new DisableTwoFactorPrompt
        {
            Password = _password,
            Code     = _code.Trim(),
            Provider = _provider
        }));
    }
}
