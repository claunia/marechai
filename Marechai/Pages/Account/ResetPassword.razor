@page "/reset-password"
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject IStringLocalizer<ProfileService> L

<EntityMetaTags Title="@L["Reset password"]" Description="Reset your Marechai password." CanonicalPath="/reset-password" NoIndex="true" />

<MudPaper Class="pa-6 mb-6" Elevation="0" Style="background: linear-gradient(135deg, #7e57c2 0%, #42a5f5 100%); border-radius: 16px;">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
        <MudIcon Icon="@Icons.Material.Filled.Password" Size="Size.Large" Style="color: white;"/>
        <MudText Typo="Typo.h4" Style="color: white;">@L["Reset Password"]</MudText>
    </MudStack>
</MudPaper>

<MudGrid Justify="Justify.Center">
    <MudItem xs="12" sm="8" md="6" lg="4">
        <MudPaper Elevation="2" Class="pa-6 rounded-lg">
            @if(string.IsNullOrEmpty(Email) || string.IsNullOrEmpty(Token))
            {
                <MudAlert Severity="Severity.Warning" Class="mb-4">
                    @L["The reset link is invalid or incomplete. Please request a new one."]
                </MudAlert>
                <div class="d-flex justify-center mt-3">
                    <MudLink Href="/forgot-password" Underline="Underline.Hover">@L["Request a new link"]</MudLink>
                </div>
            }
            else if(_succeeded)
            {
                <MudAlert Severity="Severity.Success" Class="mb-4">
                    @L["Your password has been reset. You can now sign in with your new password."]
                </MudAlert>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Href="/login">@L["Go to sign in"]</MudButton>
            }
            else
            {
                @if(!string.IsNullOrWhiteSpace(_errorMessage))
                {
                    <MudAlert Severity="Severity.Error" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="() => _errorMessage = null">@_errorMessage</MudAlert>
                }

                <MudText Typo="Typo.body1" Class="mb-4">
                    @((MarkupString)string.Format(L["Choose a new password for {0}."], $"<strong>{System.Net.WebUtility.HtmlEncode(Email)}</strong>"))
                </MudText>

                <MudTextField @bind-Value="_newPassword"
                              Label="@L["New password"]"
                              Variant="Variant.Outlined"
                              InputType="InputType.Password"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Lock"
                              Class="mb-4"
                              Disabled="_isLoading"/>

                <MudTextField @bind-Value="_confirmPassword"
                              Label="@L["Confirm new password"]"
                              Variant="Variant.Outlined"
                              InputType="InputType.Password"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Lock"
                              Class="mb-4"
                              Disabled="_isLoading"
                              OnKeyDown="OnConfirmKeyDown"/>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Size="Size.Large"
                           OnClick="SubmitAsync"
                           Disabled="_isLoading"
                           StartIcon="@(_isLoading ? null : Icons.Material.Filled.Save)">
                    @if(_isLoading)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2"/>
                        <span>@L["Resetting..."]</span>
                    }
                    else
                    {
                        <span>@L["Reset Password"]</span>
                    }
                </MudButton>

                <div class="d-flex justify-center mt-3">
                    <MudLink Href="/login" Underline="Underline.Hover">@L["Back to sign in"]</MudLink>
                </div>
            }
        </MudPaper>
    </MudItem>
</MudGrid>
