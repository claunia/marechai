@page "/account/profile"
@using Marechai.ApiClient.Models
@using Marechai.Theming
@attribute [Authorize]
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject CollectionService CollectionSvc
@inject SuggestionsService SuggestionsSvc
@inject ThemeStateService ThemeState
@inject IDialogService DialogService
@inject IStringLocalizer<ProfileService> L

<EntityMetaTags Title="@L["Profile"]" Description="Your Marechai profile." CanonicalPath="/account/profile" NoIndex="true" />

<MudPaper Class="pa-6 mb-6" Elevation="0" Style="background: linear-gradient(135deg, #7e57c2 0%, #42a5f5 100%); border-radius: 16px;">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
        <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Large" Style="color: white;"/>
        <MudText Typo="Typo.h4" Style="color: white;">@L["My Profile"]</MudText>
    </MudStack>
</MudPaper>

@if(_isLoading)
{
    <div class="d-flex justify-center pa-8">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large"/>
    </div>

    return;
}

@if(_profile is null)
{
    <MudAlert Severity="Severity.Error">@L["Failed to load profile."]</MudAlert>

    return;
}

<MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" Class="mb-4">
    @* ── Account Settings Tab ── *@
    <MudTabPanel Text="@L["Account Settings"]" Icon="@Icons.Material.Filled.Settings">
        <MudGrid Justify="Justify.Center" Class="pa-4">
            <MudItem xs="12" sm="8" md="6">
                @if(!string.IsNullOrWhiteSpace(_successMessage))
                {
                    <MudAlert Severity="Severity.Success" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="() => _successMessage = null">@_successMessage</MudAlert>
                }

                @if(!string.IsNullOrWhiteSpace(_errorMessage))
                {
                    <MudAlert Severity="Severity.Error" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="() => _errorMessage = null">@_errorMessage</MudAlert>
                }

                @if(_isEditing)
                {
                    <MudTextField @bind-Value="_editUserName"
                                  Label="@L["Username"]"
                                  Variant="Variant.Outlined"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Person"
                                  Class="mb-4"
                                  Disabled="_isSaving"/>

                    <MudTextField @bind-Value="_editEmail"
                                  Label="@L["Email"]"
                                  Variant="Variant.Outlined"
                                  InputType="InputType.Email"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Email"
                                  Class="mb-4"
                                  Disabled="_isSaving"/>

                    <MudTextField @bind-Value="_editPhoneNumber"
                                  Label="@L["Phone Number"]"
                                  Variant="Variant.Outlined"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Phone"
                                  Class="mb-4"
                                  Disabled="_isSaving"/>

                    <MudStack Row="true" Spacing="2" Justify="Justify.FlexEnd">
                        <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="CancelEdit" Disabled="_isSaving">@L["Cancel"]</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveProfileAsync" Disabled="_isSaving"
                                   StartIcon="@(_isSaving ? null : Icons.Material.Filled.Save)">
                            @if(_isSaving)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2"/>
                                <span>@L["Saving..."]</span>
                            }
                            else
                            {
                                <span>@L["Save"]</span>
                            }
                        </MudButton>
                    </MudStack>
                }
                else
                {
                    <MudList T="string" Dense="true">
                        <MudListItem T="string" Icon="@Icons.Material.Filled.Person">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Username"]</MudText>
                            <MudText Typo="Typo.body1">@_profile.UserName</MudText>
                        </MudListItem>
                        <MudListItem T="string" Icon="@Icons.Material.Filled.Email">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Email"]</MudText>
                            <MudText Typo="Typo.body1">@_profile.Email</MudText>
                        </MudListItem>
                        <MudListItem T="string" Icon="@Icons.Material.Filled.Phone">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Phone Number"]</MudText>
                            <MudText Typo="Typo.body1">@(_profile.PhoneNumber ?? "—")</MudText>
                        </MudListItem>
                        <MudListItem T="string" Icon="@Icons.Material.Filled.Security">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Roles"]</MudText>
                            <MudStack Row="true" Spacing="1" Class="mt-1">
                                @if(_profile.Roles is { Count: > 0 })
                                {
                                    @foreach(string role in _profile.Roles)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">@role</MudChip>
                                    }
                                }
                                else
                                {
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">@L["No roles assigned"]</MudText>
                                }
                            </MudStack>
                        </MudListItem>
                    </MudList>

                    <MudDivider Class="my-4"/>

                    <MudStack Row="true" Spacing="2" Justify="Justify.FlexEnd">
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="StartEdit"
                                   StartIcon="@Icons.Material.Filled.Edit">@L["Edit Account"]</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Href="/account/change-password"
                                   StartIcon="@Icons.Material.Filled.Lock">@L["Change password"]</MudButton>
                    </MudStack>
                }
            </MudItem>
        </MudGrid>
    </MudTabPanel>

    @* ── Public Profile Tab ── *@
    <MudTabPanel Text="@L["Public Profile"]" Icon="@Icons.Material.Filled.Public">
        <MudGrid Justify="Justify.Center" Class="pa-4">
            <MudItem xs="12" sm="8" md="6">
                @if(!string.IsNullOrWhiteSpace(_publicSuccessMessage))
                {
                    <MudAlert Severity="Severity.Success" Class="mb-4" ShowCloseIcon="true"
                              CloseIconClicked="() => _publicSuccessMessage = null">@_publicSuccessMessage</MudAlert>
                }

                @if(!string.IsNullOrWhiteSpace(_publicErrorMessage))
                {
                    <MudAlert Severity="Severity.Error" Class="mb-4" ShowCloseIcon="true"
                              CloseIconClicked="() => _publicErrorMessage = null">@_publicErrorMessage</MudAlert>
                }

                @* ── Avatar Section ── *@
                <MudText Typo="Typo.h6" Class="mb-2">@L["Avatar"]</MudText>

                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="mb-4">
                    @if(!string.IsNullOrWhiteSpace(_publicProfile?.AvatarUrl))
                    {
                        <MudAvatar Size="Size.Large" Style="width: 96px; height: 96px;">
                            <MudImage Src="@_publicProfile.AvatarUrl" Alt="@L["Avatar"]"/>
                        </MudAvatar>
                    }
                    else
                    {
                        <MudAvatar Size="Size.Large" Style="width: 96px; height: 96px;">
                            <MudIcon Icon="@Icons.Material.Filled.Person" Style="font-size: 48px;"/>
                        </MudAvatar>
                    }

                    <MudStack Spacing="1">
                        <MudSwitch T="bool" @bind-Value="_editUseGravatar" Color="Color.Primary"
                                   Label="@L["Use Gravatar"]" Disabled="_isSavingPublic"/>

                        @if(!_editUseGravatar)
                        {
                            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                <MudFileUpload T="IBrowserFile" Accept=".jpg,.jpeg,.png,.webp,.tiff,.tif,.bmp"
                                               FilesChanged="OnAvatarFileSelected" MaximumFileCount="1">
                                    <CustomContent>
                                        <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                                   StartIcon="@Icons.Material.Filled.CloudUpload"
                                                   Size="Size.Small" Disabled="_isUploadingAvatar"
                                                   OnClick="@context.OpenFilePickerAsync">
                                            @L["Upload Avatar"]
                                        </MudButton>
                                    </CustomContent>
                                </MudFileUpload>

                                @if(_publicProfile?.AvatarGuid.HasValue == true)
                                {
                                    <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                                               OnClick="DeleteAvatar" Disabled="_isUploadingAvatar">
                                        @L["Delete"]
                                    </MudButton>
                                }
                            </MudStack>
                        }
                    </MudStack>
                </MudStack>

                @if(_isUploadingAvatar)
                {
                    <MudProgressLinear Indeterminate="true" Class="mb-4"/>
                }

                @if(!string.IsNullOrWhiteSpace(_avatarMessage))
                {
                    <MudAlert Severity="@_avatarMessageSeverity" Class="mb-4" ShowCloseIcon="true"
                              CloseIconClicked="() => _avatarMessage = null">@_avatarMessage</MudAlert>
                }

                <MudDivider Class="my-4"/>

                @* ── Profile Fields ── *@
                <MudTextField @bind-Value="_editDisplayName"
                              Label="@L["Display Name"]"
                              Variant="Variant.Outlined"
                              HelperText="@L["Shown instead of your username on your public profile."]"
                              Counter="100" MaxLength="100"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Badge"
                              Class="mb-4"
                              Disabled="_isSavingPublic"/>

                <MudTextField @bind-Value="_editBio"
                              Label="@L["Bio"]"
                              Variant="Variant.Outlined"
                              Lines="4"
                              HelperText="@L["Tell people about yourself."]"
                              Counter="2000" MaxLength="2000"
                              Class="mb-4"
                              Disabled="_isSavingPublic"/>

                <MudTextField @bind-Value="_editWebsite"
                              Label="@L["Website"]"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Language"
                              Class="mb-4"
                              Disabled="_isSavingPublic"/>

                <MudTextField @bind-Value="_editLocation"
                              Label="@L["Location"]"
                              Variant="Variant.Outlined"
                              HelperText="@L["City, country, etc."]"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.LocationOn"
                              Class="mb-4"
                              Disabled="_isSavingPublic"/>

                <MudDivider Class="my-4"/>
                <MudText Typo="Typo.h6" Class="mb-2">@L["Social Links"]</MudText>

                <MudTextField @bind-Value="_editTwitter"
                              Label="@L["Twitter / X"]"
                              Variant="Variant.Outlined"
                              HelperText="@L["Username (without @)"]"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Custom.Brands.X"
                              Class="mb-4"
                              Disabled="_isSavingPublic"/>

                <MudTextField @bind-Value="_editGitHub"
                              Label="@L["GitHub"]"
                              Variant="Variant.Outlined"
                              HelperText="@L["Username"]"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Custom.Brands.GitHub"
                              Class="mb-4"
                              Disabled="_isSavingPublic"/>

                <MudTextField @bind-Value="_editMastodon"
                              Label="@L["Mastodon"]"
                              Variant="Variant.Outlined"
                              HelperText="@L["user@instance.social"]"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Forum"
                              Class="mb-4"
                              Disabled="_isSavingPublic"/>

                <MudTextField @bind-Value="_editFacebook"
                              Label="@L["Facebook"]"
                              Variant="Variant.Outlined"
                              HelperText="@L["Profile name or URL"]"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Custom.Brands.Facebook"
                              Class="mb-4"
                              Disabled="_isSavingPublic"/>

                <MudTextField @bind-Value="_editLinkedIn"
                              Label="@L["LinkedIn"]"
                              Variant="Variant.Outlined"
                              HelperText="@L["Profile slug (e.g. john-doe)"]"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Custom.Brands.LinkedIn"
                              Class="mb-4"
                              Disabled="_isSavingPublic"/>

                <MudStack Row="true" Spacing="2" Justify="Justify.FlexEnd">
                    <MudButton Variant="Variant.Outlined" Color="Color.Default"
                               Href="@($"/profile/{_profile?.UserName}")" Target="_blank"
                               StartIcon="@Icons.Material.Filled.Visibility">
                        @L["View Public Profile"]
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SavePublicProfileAsync"
                               Disabled="_isSavingPublic"
                               StartIcon="@(_isSavingPublic ? null : Icons.Material.Filled.Save)">
                        @if(_isSavingPublic)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2"/>
                            <span>@L["Saving..."]</span>
                        }
                        else
                        {
                            <span>@L["Save Public Profile"]</span>
                        }
                    </MudButton>
                </MudStack>
            </MudItem>
        </MudGrid>
    </MudTabPanel>

    @* ── Appearance Tab ── *@
    <MudTabPanel Text="@L["Appearance"]" Icon="@Icons.Material.Filled.Palette">
        <MudGrid Justify="Justify.Center" Class="pa-4">
            <MudItem xs="12" sm="10" md="8">
                <MudText Typo="Typo.body2" Class="mb-4">@L["Pick a theme to personalise the look of Marechai. Changes apply instantly and are saved to your profile."]</MudText>

                @if(!string.IsNullOrWhiteSpace(_themeSuccessMessage))
                {
                    <MudAlert Severity="Severity.Success" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="() => _themeSuccessMessage = null">@_themeSuccessMessage</MudAlert>
                }

                @if(!string.IsNullOrWhiteSpace(_themeErrorMessage))
                {
                    <MudAlert Severity="Severity.Error" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="() => _themeErrorMessage = null">@_themeErrorMessage</MudAlert>
                }

                <MudGrid>
                    @foreach(var theme in ThemeCatalog.All)
                    {
                        var isSelected = string.Equals(theme.Id, ThemeState.CurrentTheme.Id, StringComparison.OrdinalIgnoreCase);
                        var palette    = theme.IsDark ? (Palette)theme.MudTheme.PaletteDark : theme.MudTheme.PaletteLight;
                        var primary    = palette.Primary.Value;
                        var secondary  = palette.Secondary.Value;
                        var background = palette.Background.Value;
                        var surface    = palette.Surface.Value;
                        var text       = palette.TextPrimary.Value;

                        <MudItem xs="12" sm="6" md="4">
                            <MudPaper Class="@(isSelected ? "pa-4 mud-elevation-8" : "pa-4 mud-elevation-2")"
                                      Style="@($"cursor: pointer; border: 2px solid {(isSelected ? primary : "transparent")}; transition: all 0.2s;")"
                                      @onclick="@(() => SelectThemeAsync(theme))">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                                    <MudText Typo="Typo.subtitle1"><b>@theme.DisplayName</b></MudText>
                                    @if(isSelected)
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Style="@($"color: {primary};")"/>
                                    }
                                </MudStack>

                                @* Mock palette preview: header + body + accent stripe *@
                                <div style="@($"background: {background}; border-radius: 8px; overflow: hidden; border: 1px solid rgba(255,255,255,0.05);")">
                                    <div style="@($"background: {primary}; padding: 8px 12px; color: #fff;")">
                                        <span style="font-size: 0.75rem; font-weight: 600;">Marechai</span>
                                    </div>
                                    <div style="@($"background: {surface}; padding: 12px; color: {text};")">
                                        <div style="@($"font-size: 0.8rem; margin-bottom: 6px;")">@L["Aa Bb 123"]</div>
                                        <div style="@($"display: inline-block; background: {secondary}; color: #fff; font-size: 0.65rem; padding: 2px 8px; border-radius: 4px;")">@L["Accent"]</div>
                                    </div>
                                </div>

                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-3">
                                    <MudChip T="string" Size="Size.Small" Color="@(theme.IsDark ? Color.Dark : Color.Default)" Variant="Variant.Filled">
                                        @(theme.IsDark ? L["Dark"] : L["Light"])
                                    </MudChip>
                                    <MudSpacer/>
                                    @if(_isSavingTheme && string.Equals(theme.Id, _pendingThemeId, StringComparison.OrdinalIgnoreCase))
                                    {
                                        <MudProgressCircular Size="Size.Small" Indeterminate="true"/>
                                    }
                                </MudStack>
                            </MudPaper>
                        </MudItem>
                    }
                </MudGrid>

                @if(!string.IsNullOrWhiteSpace(_savedThemeId))
                {
                    <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-4">
                        <MudButton Variant="Variant.Text" Color="Color.Default" StartIcon="@Icons.Material.Filled.RestartAlt"
                                   OnClick="ResetThemeAsync" Disabled="_isSavingTheme">
                            @L["Reset to default"]
                        </MudButton>
                    </MudStack>
                }
            </MudItem>
        </MudGrid>
    </MudTabPanel>

    @* ── Security Tab (Two-Factor Authentication) ── *@
    <MudTabPanel Text="@L["Security"]" Icon="@Icons.Material.Filled.Security">
        <MudGrid Justify="Justify.Center" Class="pa-4">
            <MudItem xs="12" sm="10" md="8">
                @if(_securityMessage is not null)
                {
                    <MudAlert Severity="@_securitySeverity" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="() => _securityMessage = null">@_securityMessage</MudAlert>
                }

                <MudCard Elevation="2" Class="mb-4">
                    <MudCardContent>
                        <MudText Typo="Typo.h6" Class="mb-2">@L["Two-factor authentication"]</MudText>
                        @if(_twoFactorStatus is null)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true"/>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Class="mb-2">
                                @if(_twoFactorStatus.Enabled == true)
                                {
                                    @((MarkupString)L["Two-factor authentication is enabled."].Value)
                                }
                                else
                                {
                                    @((MarkupString)L["Two-factor authentication is disabled."].Value)
                                }
                            </MudText>

                            <MudText Typo="Typo.body2">
                                @L["Authenticator app: {0}", _twoFactorStatus.AuthenticatorEnabled == true ? L["enabled"] : L["disabled"]]
                            </MudText>
                            <MudText Typo="Typo.body2">
                                @L["Email: {0}", _twoFactorStatus.EmailEnabled == true ? L["enabled"] : L["disabled"]]
                            </MudText>
                            <MudText Typo="Typo.body2">
                                @L["Recovery codes remaining: {0}", _twoFactorStatus.RecoveryCodesRemaining]
                            </MudText>
                        }
                    </MudCardContent>
                </MudCard>

                @* Authenticator app section *@
                <MudCard Elevation="2" Class="mb-4">
                    <MudCardContent>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.h6">@L["Authenticator app"]</MudText>
                            @if(_twoFactorStatus?.AuthenticatorEnabled == true)
                            {
                                <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.LockOpen" OnClick="OpenDisableAuthenticatorDialog">@L["Disable"]</MudButton>
                            }
                            else if(_authSetup is null)
                            {
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PhoneAndroid" OnClick="StartAuthenticatorSetupAsync">@L["Setup authenticator"]</MudButton>
                            }
                        </MudStack>

                        @if(_authSetup is not null && _twoFactorStatus?.AuthenticatorEnabled != true)
                        {
                            <MudDivider Class="my-3"/>
                            <MudText Typo="Typo.body2" Class="mb-2">@L["Scan this QR code with your authenticator app, or enter the key manually:"]</MudText>
                            <div class="my-2">@((MarkupString)_authQrSvg)</div>
                            <MudText Typo="Typo.body2" Class="mb-2"><strong>@L["Manual entry key:"]</strong> <code>@_authSetup.SharedKey</code></MudText>
                            <MudTextField @bind-Value="_authVerifyCode" Label="@L["Verification code"]" Variant="Variant.Outlined" Class="mt-2" Disabled="_isSecurityBusy"/>
                            <MudStack Row="true" Class="mt-2">
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="EnableAuthenticatorAsync" Disabled="_isSecurityBusy">@L["Enable"]</MudButton>
                                <MudButton Variant="Variant.Text" OnClick="@(() => { _authSetup = null; _authQrSvg = string.Empty; _authVerifyCode = null; })" Disabled="_isSecurityBusy">@L["Cancel"]</MudButton>
                            </MudStack>
                        }
                    </MudCardContent>
                </MudCard>

                @* Email section *@
                <MudCard Elevation="2" Class="mb-4">
                    <MudCardContent>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.h6">@L["Email two-factor"]</MudText>
                            @if(_twoFactorStatus?.EmailEnabled == true)
                            {
                                <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.LockOpen" OnClick="OpenDisableEmailDialog">@L["Disable"]</MudButton>
                            }
                            else if(!_emailEnableMode)
                            {
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Email" OnClick="StartEmailEnableAsync" Disabled="_isSecurityBusy">@L["Send code to my email"]</MudButton>
                            }
                        </MudStack>

                        @if(_emailEnableMode && _twoFactorStatus?.EmailEnabled != true)
                        {
                            <MudDivider Class="my-3"/>
                            <MudTextField @bind-Value="_emailEnablePassword" Label="@L["Current password"]" InputType="InputType.Password" Variant="Variant.Outlined" Class="mb-2" Disabled="_isSecurityBusy"/>
                            <MudTextField @bind-Value="_emailEnableCode" Label="@L["Email code"]" Variant="Variant.Outlined" Class="mb-2" Disabled="_isSecurityBusy"/>
                            <MudStack Row="true">
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="EnableEmailAsync" Disabled="_isSecurityBusy">@L["Enable"]</MudButton>
                                <MudButton Variant="Variant.Text" OnClick="@(() => { _emailEnableMode = false; _emailEnablePassword = null; _emailEnableCode = null; })" Disabled="_isSecurityBusy">@L["Cancel"]</MudButton>
                            </MudStack>
                        }
                    </MudCardContent>
                </MudCard>

                @* Recovery codes section *@
                @if(_twoFactorStatus?.Enabled == true)
                {
                    <MudCard Elevation="2" Class="mb-4">
                        <MudCardContent>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                <MudText Typo="Typo.h6">@L["Recovery codes"]</MudText>
                                <MudButton Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Refresh" OnClick="OpenRegenerateRecoveryDialog">@L["Regenerate"]</MudButton>
                            </MudStack>
                        </MudCardContent>
                    </MudCard>
                }

                @* New recovery codes display (one-shot after enable / regenerate) *@
                @if(_displayedRecoveryCodes is { Count: > 0 })
                {
                    <MudAlert Severity="Severity.Warning" Class="mb-4">
                        <MudText Typo="Typo.body2" Class="mb-2"><strong>@L["Save these recovery codes in a safe place. They will not be shown again."]</strong></MudText>
                        <MudGrid Spacing="2">
                            @foreach(string rc in _displayedRecoveryCodes)
                            {
                                <MudItem xs="6"><code>@rc</code></MudItem>
                            }
                        </MudGrid>
                        <MudButton Variant="Variant.Text" Class="mt-2" OnClick="@(() => _displayedRecoveryCodes = null)">@L["I have saved them"]</MudButton>
                    </MudAlert>
                }
            </MudItem>
        </MudGrid>
    </MudTabPanel>

    @* ── Notifications Tab ── *@
    <MudTabPanel Text="@L["Notifications"]" Icon="@Icons.Material.Filled.NotificationsActive">
        <MudGrid Justify="Justify.Center" Class="pa-4">
            <MudItem xs="12" sm="8" md="6">
                @if(!string.IsNullOrWhiteSpace(_notificationsSuccessMessage))
                {
                    <MudAlert Severity="Severity.Success" Class="mb-4" ShowCloseIcon="true"
                              CloseIconClicked="() => _notificationsSuccessMessage = null">@_notificationsSuccessMessage</MudAlert>
                }

                @if(!string.IsNullOrWhiteSpace(_notificationsErrorMessage))
                {
                    <MudAlert Severity="Severity.Error" Class="mb-4" ShowCloseIcon="true"
                              CloseIconClicked="() => _notificationsErrorMessage = null">@_notificationsErrorMessage</MudAlert>
                }

                <MudText Typo="Typo.h6" Class="mb-2">@L["Email notifications"]</MudText>
                <MudText Typo="Typo.body2" Class="mb-4" Style="color: var(--mud-palette-text-secondary);">
                    @L["Choose which email notifications you'd like to receive from Marechai."]
                </MudText>

                <MudSwitch T="bool" @bind-Value="_editNotifyOnNewMessage" Color="Color.Primary"
                           Label="@L["Notify me by email when I receive a new message"]"
                           Disabled="_isSavingNotifications"/>

                <MudStack Row="true" Spacing="2" Justify="Justify.FlexEnd" Class="mt-4">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               OnClick="SaveNotificationPreferencesAsync"
                               Disabled="_isSavingNotifications"
                               StartIcon="@(_isSavingNotifications ? null : Icons.Material.Filled.Save)">
                        @if(_isSavingNotifications)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2"/>
                            <span>@L["Saving..."]</span>
                        }
                        else
                        {
                            <span>@L["Save notification preferences"]</span>
                        }
                    </MudButton>
                </MudStack>
            </MudItem>
        </MudGrid>
    </MudTabPanel>

    @* ── My Collection Tab ── *@
    <MudTabPanel Text="@L["My Collection"]" Icon="@Icons.Material.Filled.Collections">
        <MudGrid Justify="Justify.Center" Class="pa-4">
            <MudItem xs="12" sm="10" md="8">
                @if(_isLoadingCollection)
                {
                    <div class="d-flex justify-center pa-8">
                        <MudProgressCircular Color="Color.Primary" Indeterminate="true"/>
                    </div>
                }
                else
                {
                    @* ── Books ── *@
                    <MudText Typo="Typo.h6" Class="mb-2">
                        <MudIcon Icon="@Icons.Material.Filled.MenuBook" Class="mr-1"/>
                        @L["Books ({0})", _myBooks?.Count ?? 0]
                    </MudText>
                    @if(_myBooks?.Count > 0)
                    {
                        <MudSimpleTable Elevation="1" Dense="true" Class="mb-4">
                            <thead>
                            <tr>
                                <th>@L["Title"]</th>
                                <th style="width: 120px;">@L["Added"]</th>
                                <th style="width: 80px;"></th>
                            </tr>
                            </thead>
                            <tbody>
                            @foreach(CollectedBookDto book in _myBooks)
                            {
                                <tr>
                                    <td>
                                        <MudLink Href="@($"/book/{book.BookId}")">@book.Title</MudLink>
                                    </td>
                                    <td>@book.CollectedOn?.Date.ToShortDateString()</td>
                                    <td>
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                       Color="Color.Error" Size="Size.Small"
                                                       OnClick="@(() => RemoveBookAsync(book.BookId))"/>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </MudSimpleTable>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info" Class="mb-4">@L["No books in your collection yet."]</MudAlert>
                    }

                    @* ── Documents ── *@
                    <MudText Typo="Typo.h6" Class="mb-2">
                        <MudIcon Icon="@Icons.Material.Filled.Article" Class="mr-1"/>
                        @L["Documents ({0})", _myDocuments?.Count ?? 0]
                    </MudText>
                    @if(_myDocuments?.Count > 0)
                    {
                        <MudSimpleTable Elevation="1" Dense="true" Class="mb-4">
                            <thead>
                            <tr>
                                <th>@L["Title"]</th>
                                <th style="width: 120px;">@L["Added"]</th>
                                <th style="width: 80px;"></th>
                            </tr>
                            </thead>
                            <tbody>
                            @foreach(CollectedDocumentDto doc in _myDocuments)
                            {
                                <tr>
                                    <td>
                                        <MudLink Href="@($"/document/{doc.DocumentId}")">@doc.Title</MudLink>
                                    </td>
                                    <td>@doc.CollectedOn?.Date.ToShortDateString()</td>
                                    <td>
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                       Color="Color.Error" Size="Size.Small"
                                                       OnClick="@(() => RemoveDocumentAsync(doc.DocumentId))"/>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </MudSimpleTable>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info" Class="mb-4">@L["No documents in your collection yet."]</MudAlert>
                    }

                    @* ── Magazine Issues ── *@
                    <MudText Typo="Typo.h6" Class="mb-2">
                        <MudIcon Icon="@Icons.Material.Filled.Bookmarks" Class="mr-1"/>
                        @L["Magazine Issues ({0})", _myMagazineIssues?.Count ?? 0]
                    </MudText>
                    @if(_myMagazineIssues?.Count > 0)
                    {
                        <MudSimpleTable Elevation="1" Dense="true" Class="mb-4">
                            <thead>
                            <tr>
                                <th>@L["Issue"]</th>
                                <th style="width: 120px;">@L["Added"]</th>
                                <th style="width: 80px;"></th>
                            </tr>
                            </thead>
                            <tbody>
                            @foreach(CollectedMagazineIssueDto issue in _myMagazineIssues)
                            {
                                <tr>
                                    <td>
                                        <MudLink Href="@($"/magazine/issue/{issue.MagazineIssueId}")">
                                            @if(!string.IsNullOrWhiteSpace(issue.MagazineTitle))
                                            {
                                                <text>@issue.MagazineTitle &mdash; </text>
                                            }
                                            @issue.Caption
                                            @if(issue.IssueNumber.HasValue)
                                            {
                                                <text> (#@issue.IssueNumber.Value)</text>
                                            }
                                        </MudLink>
                                    </td>
                                    <td>@issue.CollectedOn?.Date.ToShortDateString()</td>
                                    <td>
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                       Color="Color.Error" Size="Size.Small"
                                                       OnClick="@(() => RemoveMagazineIssueAsync(issue.MagazineIssueId))"/>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </MudSimpleTable>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info" Class="mb-4">@L["No magazine issues in your collection yet."]</MudAlert>
                    }

                    @* ── Machines ── *@
                    <MudText Typo="Typo.h6" Class="mb-2">
                        <MudIcon Icon="@Icons.Material.Filled.Computer" Class="mr-1"/>
                        @L["Machines ({0})", _myMachines?.Count ?? 0]
                    </MudText>
                    @if(_myMachines?.Count > 0)
                    {
                        <MudSimpleTable Elevation="1" Dense="true" Class="mb-4">
                            <thead>
                            <tr>
                                <th>@L["Machine"]</th>
                                <th style="width: 120px;">@L["Added"]</th>
                                <th style="width: 80px;"></th>
                            </tr>
                            </thead>
                            <tbody>
                            @foreach(CollectedMachineDto machine in _myMachines)
                            {
                                <tr>
                                    <td>
                                        <MudLink Href="@($"/machine/{machine.MachineId}")">
                                            @(machine.CompanyName is not null ? $"{machine.CompanyName} {machine.Name}" : machine.Name)
                                        </MudLink>
                                    </td>
                                    <td>@machine.CollectedOn?.Date.ToShortDateString()</td>
                                    <td>
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                       Color="Color.Error" Size="Size.Small"
                                                       OnClick="@(() => RemoveMachineAsync(machine.MachineId))"/>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </MudSimpleTable>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info" Class="mb-4">@L["No machines in your collection yet."]</MudAlert>
                    }

                    @* ── Software Releases ── *@
                    <MudText Typo="Typo.h6" Class="mb-2">
                        <MudIcon Icon="@Icons.Material.Filled.Apps" Class="mr-1"/>
                        @L["Software ({0})", _myReleases?.Count ?? 0]
                    </MudText>
                    @if(_myReleases?.Count > 0)
                    {
                        <MudSimpleTable Elevation="1" Dense="true" Class="mb-4">
                            <thead>
                            <tr>
                                <th>@L["Software"]</th>
                                <th style="width: 120px;">@L["Added"]</th>
                                <th style="width: 80px;"></th>
                            </tr>
                            </thead>
                            <tbody>
                            @foreach(CollectedSoftwareReleaseDto release in _myReleases)
                            {
                                <tr>
                                    <td>
                                        <MudLink Href="@($"/software/release/{release.SoftwareReleaseId}")">
                                            @release.SoftwareName
                                            @if(!string.IsNullOrEmpty(release.Version))
                                            {
                                                <text> @release.Version</text>
                                            }
                                            @if(!string.IsNullOrEmpty(release.Platform))
                                            {
                                                <text> (@release.Platform)</text>
                                            }
                                        </MudLink>
                                    </td>
                                    <td>@release.CollectedOn?.Date.ToShortDateString()</td>
                                    <td>
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                       Color="Color.Error" Size="Size.Small"
                                                       OnClick="@(() => RemoveReleaseAsync(release.SoftwareReleaseId))"/>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </MudSimpleTable>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info" Class="mb-4">@L["No software in your collection yet."]</MudAlert>
                    }
                }
            </MudItem>
        </MudGrid>
    </MudTabPanel>

    @* ── My Suggestions Tab ── *@
    <MudTabPanel Text="@L["My Suggestions"]" Icon="@Icons.Material.Filled.RateReview">
        <MudText Typo="Typo.h5" GutterBottom="true">@L["My Suggestions"]</MudText>
        <MudText Typo="Typo.body2" Class="mb-4">@L["Suggestions you submitted, including their current review status."]</MudText>

        @if(_mySuggestions?.Count > 0)
        {
            <MudTable Items="_mySuggestions" Hover="true" Dense="true" Striped="true">
                <HeaderContent>
                    <MudTh>@L["Entity"]</MudTh>
                    <MudTh>@L["Item"]</MudTh>
                    <MudTh>@L["Status"]</MudTh>
                    <MudTh>@L["Submitted"]</MudTh>
                    <MudTh>@L["Reviewed"]</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@(context.EntityType.HasValue ? ((Marechai.Data.SuggestionEntityType)context.EntityType.Value).ToString() : string.Empty)</MudChip>
                    </MudTd>
                    <MudTd>
                        @if(!context.EntityId.HasValue)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled" Class="mr-1">@L["New"]</MudChip>
                        }
                        @if(!string.IsNullOrWhiteSpace(context.EntityDisplayName))
                        {
                            <text>@context.EntityDisplayName</text>
                            @if(context.EntityId.HasValue)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary"> #@context.EntityId</MudText>
                            }
                        }
                        else if(context.EntityId.HasValue)
                        {
                            <text>#@context.EntityId</text>
                        }
                        @if(!string.IsNullOrEmpty(context.Subkey))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary"> @SuggestionSubkeyLabel(context)</MudText>
                        }
                    </MudTd>
                    <MudTd>
                        <MudChip T="string" Size="Size.Small" Color="@SuggestionStatusColor((Marechai.Data.SuggestionStatus?)context.Status)" Variant="Variant.Filled">
                            @SuggestionStatusLabel((Marechai.Data.SuggestionStatus?)context.Status)
                        </MudChip>
                        @if(!string.IsNullOrWhiteSpace(context.AdminReviewComment))
                        {
                            <MudTooltip Text="@context.AdminReviewComment" Placement="Placement.Top">
                                <MudIcon Icon="@Icons.Material.Filled.ChatBubbleOutline"
                                         Size="Size.Small"
                                         Color="Color.Secondary"
                                         Class="ml-1"/>
                            </MudTooltip>
                        }
                    </MudTd>
                    <MudTd>@(context.CreatedOn?.LocalDateTime.ToString("g"))</MudTd>
                    <MudTd>@(context.ReviewedOn?.LocalDateTime.ToString("g") ?? "—")</MudTd>
                    <MudTd>
                        @if((Marechai.Data.SuggestionStatus?)context.Status == Marechai.Data.SuggestionStatus.Pending)
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Undo"
                                       OnClick="@(() => WithdrawSuggestionAsync(context))">
                                @L["Withdraw"]
                            </MudButton>
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
        else
        {
            <MudAlert Severity="Severity.Info">@L["You haven't submitted any suggestions yet."]</MudAlert>
        }
    </MudTabPanel>
</MudTabs>

<MudPaper Elevation="0" Class="pa-4 mt-6 rounded-lg" Style="border: 2px solid #e57373; background: rgba(229, 115, 115, 0.05);">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
        <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Error"/>
        <MudText Typo="Typo.h6" Color="Color.Error">@L["Danger zone"]</MudText>
    </MudStack>
    <MudText Typo="Typo.body2" Class="mb-3">@L["Download a copy of your data, or permanently delete your Marechai account."]</MudText>
    <MudStack Row="true" Spacing="2">
        <MudButton Variant="Variant.Outlined" Color="Color.Default" Href="/account/deletion-pending" StartIcon="@Icons.Material.Filled.Download">@L["Download my data"]</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Error" Href="/account/delete" StartIcon="@Icons.Material.Filled.DeleteForever">@L["Delete my account"]</MudButton>
    </MudStack>
</MudPaper>
