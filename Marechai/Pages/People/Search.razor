@page "/people/all"
@page "/people/year/{Year:int}"
@page "/people/{StartingCharacter}"
@using Marechai.ApiClient.Models
@inherits OwningComponentBase<PeopleService>
@inject IStringLocalizer<PeopleService> L
@inject ApiAssetUrlProvider            AssetUrls

@if(!_initialized)
{
    <div class="d-flex justify-center pa-8">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true"/>
    </div>

    return;
}

<MudPaper Class="pa-6 mb-6" Elevation="0" Style="background: linear-gradient(135deg, #7e57c2 0%, #42a5f5 100%); border-radius: 16px;">
    <MudText Typo="Typo.h5" Style="color: white;">@L["Search results:"]</MudText>
    @if(_character.HasValue)
    {
        <MudText Typo="Typo.h6" Style="color: rgba(255,255,255,0.85);">@string.Format(L["People starting with {0}"], _character)</MudText>
    }
    else if(Year.HasValue)
    {
        <MudText Typo="Typo.h6" Style="color: rgba(255,255,255,0.85);">@string.Format(L["People born in {0}"], Year)</MudText>
    }
</MudPaper>

@if(_total > 0)
{
    <MudText Typo="Typo.body2" Class="mb-2">@string.Format(L["{0} people found in the database."], _total)</MudText>
    <div id="@_scrollerId" style="height: calc(100dvh - 220px); min-height: 360px; overflow-y: auto;">
        <MudList T="PersonDto" Dense="true">
            <Virtualize Items="_people" Context="person" ItemSize="64">
                <MudListItem T="PersonDto" Href="@($"/person/{person.Id}")" Icon="@Icons.Material.Filled.Person">
                    <div class="d-flex align-center gap-3">
                        @if(person.Photo.HasValue && person.Photo.Value != Guid.Empty)
                        {
                            <picture>
                                <source srcset="@(AssetUrls.BaseUrl)/assets/photos/people/jxl/hd/@(person.Photo).jxl, @(AssetUrls.BaseUrl)/assets/photos/people/jxl/1440p/@(person.Photo).jxl 2x, @(AssetUrls.BaseUrl)/assets/photos/people/jxl/4k/@(person.Photo).jxl 3x" type="image/jxl">
                                <source srcset="@(AssetUrls.BaseUrl)/assets/photos/people/avif/hd/@(person.Photo).avif, @(AssetUrls.BaseUrl)/assets/photos/people/avif/1440p/@(person.Photo).avif 2x, @(AssetUrls.BaseUrl)/assets/photos/people/avif/4k/@(person.Photo).avif 3x" type="image/avif">
                                <source srcset="@(AssetUrls.BaseUrl)/assets/photos/people/webp/hd/@(person.Photo).webp, @(AssetUrls.BaseUrl)/assets/photos/people/webp/1440p/@(person.Photo).webp 2x, @(AssetUrls.BaseUrl)/assets/photos/people/webp/4k/@(person.Photo).webp 3x" type="image/webp">
                                <img alt="@(person.DisplayName ?? person.Alias ?? $"{person.Name} {person.Surname}".Trim())" height="48"
                                     src="@(AssetUrls.BaseUrl)/assets/photos/people/jpeg/hd/@(person.Photo).jpg"
                                     srcset="@(AssetUrls.BaseUrl)/assets/photos/people/jpeg/hd/@(person.Photo).jpg, @(AssetUrls.BaseUrl)/assets/photos/people/jpeg/1440p/@(person.Photo).jpg 2x, @(AssetUrls.BaseUrl)/assets/photos/people/jpeg/4k/@(person.Photo).jpg 3x"
                                     style="object-fit: contain; border-radius: 4px;"/>
                            </picture>
                        }
                        <div>
                            <MudText Typo="Typo.body1">@(person.DisplayName ?? person.Alias ?? $"{person.Name} {person.Surname}".Trim())</MudText>
                            @if(person.Birthdate.HasValue && person.Birthdate.Value.Year > 1000)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@person.Birthdate.Value.Year</MudText>
                            }
                        </div>
                    </div>
                </MudListItem>
            </Virtualize>
        </MudList>
        <div id="@_sentinelId" style="height: 1px;"></div>
        @if(_loadingMore)
        {
            <div class="d-flex justify-center pa-3">
                <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true"/>
            </div>
        }
    </div>
}
else
{
    @if(_character.HasValue)
    {
        <MudAlert Severity="Severity.Info">@L["There are no people found in the database that start with this letter."]</MudAlert>
    }
    else if(Year.HasValue)
    {
        <MudAlert Severity="Severity.Info">@L["There are no people found born this year."]</MudAlert>
    }
}
