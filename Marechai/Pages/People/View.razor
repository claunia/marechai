@page "/person/{Id:int}"
@using Marechai.ApiClient.Models
@using Marechai.Pages.Suggestions
@inherits OwningComponentBase<PeopleService>
@inject IStringLocalizer<PeopleService> L
@inject ApiAssetUrlProvider            AssetUrls
@inject IDialogService                 DialogService
@inject SuggestionsService             Suggestions

@if(!_loaded)
{
    <div class="d-flex justify-center pa-8">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large"/>
    </div>

    return;
}

@if(_person is null)
{
    <MudAlert Severity="Severity.Warning">@L["Person not found."]</MudAlert>

    return;
}

<EntityMetaTags Title="@(_person.DisplayName ?? _person.Name)"
                Description="@string.Format(L["Seo description"], _person.DisplayName ?? _person.Name)"
                CanonicalPath="@($"/person/{Id}")"
                Breadcrumbs="@(new (string, string?)[] { ("People", "/people"), (_person.DisplayName ?? _person.Name, null) })" />

@* ── Hero Header ── *@
<MudPaper Class="pa-6 mb-6" Elevation="0" Style="background: linear-gradient(135deg, #7e57c2 0%, #42a5f5 100%); border-radius: 16px;">
    <MudStack AlignItems="AlignItems.Center" Spacing="3">
        @if(_person.Photo.HasValue && _person.Photo.Value != Guid.Empty)
        {
            <picture>
                <source srcset="@(AssetUrls.BaseUrl)/assets/photos/people/jxl/4k/@(_person.Photo).jxl" type="image/jxl">
                <source srcset="@(AssetUrls.BaseUrl)/assets/photos/people/avif/4k/@(_person.Photo).avif" type="image/avif">
                <source srcset="@(AssetUrls.BaseUrl)/assets/photos/people/webp/4k/@(_person.Photo).webp" type="image/webp">
                <img alt="@(_person.DisplayName ?? _person.Alias ?? $"{_person.Name} {_person.Surname}".Trim())" height="200"
                     src="@(AssetUrls.BaseUrl)/assets/photos/people/jpeg/4k/@(_person.Photo).jpg"
                     srcset="@(AssetUrls.BaseUrl)/assets/photos/people/jpeg/4k/@(_person.Photo).jpg"
                     style="object-fit: contain; border-radius: 4px; filter: drop-shadow(0 4px 8px rgba(0,0,0,0.3));" />
            </picture>
        }
        else
        {
            <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Large" Style="color: white;"/>
        }
        <MudText Typo="Typo.h4" Align="Align.Center" Style="color: white; font-weight: 700;">@(_person.DisplayName ?? _person.Alias ?? $"{_person.Name} {_person.Surname}".Trim())</MudText>
    </MudStack>
</MudPaper>

@* ── Personal Information Card ── *@
<MudCard Elevation="2" Class="mb-4 rounded-lg">
    <MudCardContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.Info" Color="Color.Primary"/>
                <MudText Typo="Typo.h6">@L["General"]</MudText>
            </MudStack>
            <AuthorizeView>
                <Authorized>
                    <MudTooltip Text="@L["Suggest changes"]">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Size="Size.Small"
                                       Color="Color.Secondary"
                                       OnClick="OpenPersonSuggestionDialogAsync"
                                       aria-label="@L["Suggest changes"]"/>
                    </MudTooltip>
                </Authorized>
            </AuthorizeView>
        </MudStack>
        <MudSimpleTable Elevation="0" Dense="true">
            <tbody>
            @if(!string.IsNullOrEmpty(_person.Name))
            {
                <tr>
                    <td style="width: 33%; text-align: right;"><strong>@L["Name"]</strong></td>
                    <td>@_person.Name</td>
                </tr>
            }
            @if(!string.IsNullOrEmpty(_person.Surname))
            {
                <tr>
                    <td style="width: 33%; text-align: right;"><strong>@L["Surname"]</strong></td>
                    <td>@_person.Surname</td>
                </tr>
            }
            @if(!string.IsNullOrEmpty(_person.Alias))
            {
                <tr>
                    <td style="width: 33%; text-align: right;"><strong>@L["Alias"]</strong></td>
                    <td>@_person.Alias</td>
                </tr>
            }
            @if(!string.IsNullOrEmpty(_person.DisplayName))
            {
                <tr>
                    <td style="width: 33%; text-align: right;"><strong>@L["Display name"]</strong></td>
                    <td>@_person.DisplayName</td>
                </tr>
            }
            @if(_person.Birthdate.HasValue && _person.Birthdate.Value.Year > 1000)
            {
                <tr>
                    <td style="width: 33%; text-align: right;"><strong>@L["Birth date"]</strong></td>
                    <td>@(((_person.BirthdatePrecision ?? 0) == 2 ? _person.Birthdate.Value.Year.ToString() : (_person.BirthdatePrecision ?? 0) == 1 ? _person.Birthdate.Value.ToString("MMMM yyyy") : _person.Birthdate.Value.DateTime.ToLongDateString()))</td>
                </tr>
            }
            @if(_person.DeathDate.HasValue)
            {
                <tr>
                    <td style="width: 33%; text-align: right;"><strong>@L["Death date"]</strong></td>
                    <td>@(((_person.DeathDatePrecision ?? 0) == 2 ? _person.DeathDate.Value.Year.ToString() : (_person.DeathDatePrecision ?? 0) == 1 ? _person.DeathDate.Value.ToString("MMMM yyyy") : _person.DeathDate.Value.DateTime.ToLongDateString()))</td>
                </tr>
            }
            @if(!string.IsNullOrEmpty(_person.Country))
            {
                <tr>
                    <td style="width: 33%; text-align: right;"><strong>@L["Country of birth"]</strong></td>
                    <td>
                        @if(_person.CountryId.HasValue)
                        {
                            <picture>
                                <source srcset="@(AssetUrls.BaseUrl)/assets/flags/countries/@($"{_person.CountryId:D3}").svg" type="image/svg+xml">
                                <source srcset="@(AssetUrls.BaseUrl)/assets/flags/countries/webp/1x/@($"{_person.CountryId:D3}").webp" type="image/webp">
                                <img alt="" height="32" src="@(AssetUrls.BaseUrl)/assets/flags/countries/png/1x/@($"{_person.CountryId:D3}").png"/>
                            </picture>
                        }
                        @L[_person.Country]
                    </td>
                </tr>
            }
            @if(!string.IsNullOrEmpty(_person.Webpage))
            {
                <tr>
                    <td style="width: 33%; text-align: right;"><strong>@L["Webpage"]</strong></td>
                    <td><MudLink Href="@_person.Webpage" Target="_blank">@_person.Webpage</MudLink></td>
                </tr>
            }
            @if(!string.IsNullOrEmpty(_person.Twitter))
            {
                <tr>
                    <td style="width: 33%; text-align: right;"><strong>@L["Twitter"]</strong></td>
                    <td><MudLink Href="@($"https://twitter.com/{_person.Twitter}")" Target="_blank">@@@_person.Twitter</MudLink></td>
                </tr>
            }
            @if(!string.IsNullOrEmpty(_person.Facebook))
            {
                <tr>
                    <td style="width: 33%; text-align: right;"><strong>@L["Facebook"]</strong></td>
                    <td><MudLink Href="@($"https://facebook.com/{_person.Facebook}")" Target="_blank">@_person.Facebook</MudLink></td>
                </tr>
            }
            </tbody>
        </MudSimpleTable>
    </MudCardContent>
</MudCard>

@* ── Photo Card ── *@
@if(_person.Photo.HasValue && _person.Photo.Value != Guid.Empty)
{
    <MudCard Elevation="2" Class="mb-4 rounded-lg">
        <MudCardContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Image" Color="Color.Primary"/>
                    <MudText Typo="Typo.h6">@L["Photo"]</MudText>
                </MudStack>
                <AuthorizeView>
                    <Authorized>
                        <MudTooltip Text="@L["Suggest a new photo"]">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Size="Size.Small"
                                           Color="Color.Secondary"
                                           OnClick="OpenPersonSuggestionDialogAsync"
                                           aria-label="@L["Suggest a new photo"]"/>
                        </MudTooltip>
                    </Authorized>
                </AuthorizeView>
            </MudStack>
            <div class="d-flex justify-center" style="cursor: pointer;" @onclick="() => _lightbox.Show(new List<Guid> { _person.Photo.Value }, _person.Photo.Value)">
                <picture>
                    <source srcset="@(AssetUrls.BaseUrl)/assets/photos/people/jxl/4k/@(_person.Photo).jxl" type="image/jxl">
                    <source srcset="@(AssetUrls.BaseUrl)/assets/photos/people/avif/4k/@(_person.Photo).avif" type="image/avif">
                    <source srcset="@(AssetUrls.BaseUrl)/assets/photos/people/webp/4k/@(_person.Photo).webp" type="image/webp">
                    <img alt="@(_person.DisplayName ?? _person.Alias ?? $"{_person.Name} {_person.Surname}".Trim())" src="@(AssetUrls.BaseUrl)/assets/photos/people/jpeg/4k/@(_person.Photo).jpg"
                         style="max-height: 600px; max-width: 100%; object-fit: contain; border-radius: 4px;"/>
                </picture>
            </div>
        </MudCardContent>
    </MudCard>
}
else
{
    <AuthorizeView>
        <Authorized>
            <MudCard Elevation="2" Class="mb-4 rounded-lg">
                <MudCardContent>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                        <MudIcon Icon="@Icons.Material.Filled.Image" Color="Color.Primary"/>
                        <MudText Typo="Typo.h6">@L["Photo"]</MudText>
                    </MudStack>
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-2">
                        @L["We do not have a photo of this person, you could collaborate by suggesting one"]
                    </MudAlert>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.AddPhotoAlternate"
                               OnClick="OpenPersonSuggestionDialogAsync">
                        @L["Suggest a photo"]
                    </MudButton>
                </MudCardContent>
            </MudCard>
        </Authorized>
    </AuthorizeView>
}

@* ── Biography Card (3-state: no biography / fallback / native) ── *@
@if(!_hasAnyDescription)
{
    <MudCard Elevation="2" Class="mb-4 rounded-lg">
        <MudCardContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Description" Color="Color.Primary"/>
                    <MudText Typo="Typo.h6">@L["Biography"]</MudText>
                </MudStack>
            </MudStack>
            <AuthorizeView>
                <Authorized>
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-2">
                        @L["We do not have a biography for this person, you could collaborate by suggesting one"]
                    </MudAlert>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.AddComment"
                               OnClick="OpenDescriptionPickerAsync">
                        @L["Suggest biography"]
                    </MudButton>
                </Authorized>
                <NotAuthorized>
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                        @L["We do not have a biography for this person, you could collaborate by suggesting one"]
                    </MudAlert>
                </NotAuthorized>
            </AuthorizeView>
        </MudCardContent>
    </MudCard>
}
else
{
    @if(_descriptionFellBack)
    {
        <AuthorizeView>
            <Authorized>
                <MudAlert Severity="Severity.Info"
                          Variant="Variant.Outlined"
                          Class="mb-3">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="3" Style="width: 100%;">
                        <MudText>
                            @L["We do not have a biography in your language, you could collaborate by translating the English biography we show below"]
                        </MudText>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Translate"
                                   OnClick="OpenDescriptionPickerAsync">
                            @L["Suggest translation"]
                        </MudButton>
                    </MudStack>
                </MudAlert>
            </Authorized>
        </AuthorizeView>
    }

    <MudCard Elevation="2" Class="mb-4 rounded-lg">
        <MudCardContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Description" Color="Color.Primary"/>
                    <MudText Typo="Typo.h6">@L["Biography"]</MudText>
                </MudStack>
                <AuthorizeView>
                    <Authorized>
                        <MudTooltip Text="@L["Suggest changes"]">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Size="Size.Small"
                                           Color="Color.Secondary"
                                           OnClick="OpenDescriptionPickerAsync"
                                           aria-label="@L["Suggest changes"]"/>
                        </MudTooltip>
                    </Authorized>
                </AuthorizeView>
            </MudStack>
            <div style="color: var(--mud-palette-text-primary); overflow-wrap: break-word; word-break: break-word;">
                <style>
                    .person-description {
                        color: inherit;
                        line-height: 1.7;
                    }
                    .person-description h1 {
                        font-size: 1.75rem;
                        font-weight: 700;
                        margin: 2rem 0 1rem;
                        line-height: 1.3;
                    }
                    .person-description h2 {
                        font-size: 1.5rem;
                        font-weight: 600;
                        margin: 2rem 0 1rem;
                        line-height: 1.3;
                    }
                    .person-description h3 {
                        font-size: 1.25rem;
                        font-weight: 600;
                        margin: 1.5rem 0 0.75rem;
                        line-height: 1.3;
                    }
                    .person-description h4, .person-description h5, .person-description h6 {
                        font-size: 1.1rem;
                        font-weight: 600;
                        margin: 1.25rem 0 0.6rem;
                        line-height: 1.3;
                    }
                    .person-description p {
                        margin: 1rem 0;
                        line-height: 1.8;
                    }
                    .person-description ul, .person-description ol {
                        margin: 1rem 0;
                        padding-left: 1.75rem;
                    }
                    .person-description li {
                        margin: 0.6rem 0;
                        line-height: 1.7;
                    }
                    .person-description strong {
                        font-weight: 700;
                    }
                    .person-description img {
                        max-width: 100%;
                        height: auto;
                    }
                    .person-description pre {
                        overflow-x: auto;
                        max-width: 100%;
                        background: var(--mud-palette-surface);
                        padding: 1rem;
                        border-radius: 4px;
                    }
                    .person-description code {
                        background: var(--mud-palette-surface);
                        padding: 0.125rem 0.25rem;
                        border-radius: 3px;
                        font-size: 0.875em;
                    }
                    .person-description blockquote {
                        border-left: 4px solid var(--mud-palette-primary);
                        margin: 0.75rem 0;
                        padding: 0.5rem 1rem;
                        opacity: 0.85;
                    }
                    .person-description table {
                        border-collapse: collapse;
                        margin: 0.75rem 0;
                        width: 100%;
                    }
                    .person-description th, .person-description td {
                        border: 1px solid var(--mud-palette-lines-default);
                        padding: 0.5rem;
                    }
                    .person-description hr {
                        border: none;
                        border-top: 1px solid var(--mud-palette-lines-default);
                        margin: 1rem 0;
                    }
                </style>
                <div class="person-description" style="padding: 8px;">
                    @((MarkupString)_description)
                </div>
            </div>
        </MudCardContent>
    </MudCard>
}

@* ── Companies Card ── *@
@if(_companies.Count > 0)
{
<MudExpansionPanels Elevation="2" Class="mb-4 rounded-lg">
    <MudExpansionPanel>
        <TitleContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.Business" Color="Color.Primary"/>
                <MudText Typo="Typo.h6">@L["Companies"]</MudText>
                <MudChip T="string" Size="Size.Small" Color="@(_companies.Count > 0 ? Color.Success : Color.Error)">@_companies.Count</MudChip>
            </MudStack>
        </TitleContent>
        <ChildContent>
            <MudList T="PersonByCompanyDto" Dense="true">
                @foreach(PersonByCompanyDto company in _companies)
                {
                    <MudListItem T="PersonByCompanyDto" Href="@($"/company/{company.CompanyId}")" Icon="@Icons.Material.Filled.Business">
                        @company.CompanyName
                        @if(!string.IsNullOrEmpty(company.Position))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="ml-2" Style="display: inline;">— @company.Position</MudText>
                        }
                        @if(company.Start.HasValue || company.End.HasValue || company.Ongoing == true)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Tertiary" Class="ml-2" Style="display: inline;">
                                (@(company.Start.HasValue ? company.Start.Value.Year.ToString() : "?")–@(company.Ongoing == true ? L["present"] : company.End.HasValue ? company.End.Value.Year.ToString() : "?"))
                            </MudText>
                        }
                    </MudListItem>
                }
            </MudList>
        </ChildContent>
    </MudExpansionPanel>
</MudExpansionPanels>
}

