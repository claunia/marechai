@* ── Software Credits Card ── *@
@if(_softwareCredits.Count > 0)
{
<MudExpansionPanels Elevation="2" Class="mb-4 rounded-lg">
    <MudExpansionPanel>
        <TitleContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.Code" Color="Color.Primary"/>
                <MudText Typo="Typo.h6">@L["Software"]</MudText>
                <MudChip T="string" Size="Size.Small" Color="@(_softwareCredits.Count > 0 ? Color.Success : Color.Error)">@_softwareCredits.Count</MudChip>
            </MudStack>
        </TitleContent>
        <ChildContent>
            <MudList T="PersonBySoftwareDto" Dense="true">
                @foreach(PersonBySoftwareDto credit in _softwareCredits)
                {
                    <MudListItem T="PersonBySoftwareDto" Href="@($"/software/{credit.SoftwareId}")">
                        <div class="d-flex align-center gap-3">
                            @if(credit.FrontCoverId.HasValue)
                            {
                                <div class="sw-cover-thumb sw-cover-thumb-md">
                                    <picture>
                                        <source srcset="@(AssetUrls.BaseUrl)/assets/photos/software-covers/jxl/4k/@(credit.FrontCoverId).jxl" type="image/jxl">
                                        <source srcset="@(AssetUrls.BaseUrl)/assets/photos/software-covers/avif/4k/@(credit.FrontCoverId).avif" type="image/avif">
                                        <source srcset="@(AssetUrls.BaseUrl)/assets/photos/software-covers/webp/4k/@(credit.FrontCoverId).webp" type="image/webp">
                                        <img alt="@credit.SoftwareName"
                                             src="@(AssetUrls.BaseUrl)/assets/photos/software-covers/jpeg/4k/@(credit.FrontCoverId).jpg"
                                             srcset="@(AssetUrls.BaseUrl)/assets/photos/software-covers/jpeg/4k/@(credit.FrontCoverId).jpg"/>
                                    </picture>
                                </div>
                            }
                            else
                            {
                                <div class="sw-cover-thumb sw-cover-thumb-md">
                                    <MudIcon Icon="@Icons.Material.Filled.Code" Size="Size.Large" Color="Color.Default"/>
                                </div>
                            }
                            <div>
                                <MudText Typo="Typo.body1">
                                    @credit.SoftwareName
                                    @if(!string.IsNullOrEmpty(credit.Role))
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="ml-2" Style="display: inline;">— @L[credit.Role]</MudText>
                                    }
                                </MudText>
                            </div>
                        </div>
                    </MudListItem>
                }
            </MudList>
        </ChildContent>
    </MudExpansionPanel>
</MudExpansionPanels>
}

