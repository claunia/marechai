@if(_books.Count > 0)
{
<MudExpansionPanels Elevation="2" Class="mb-4 rounded-lg">
    <MudExpansionPanel>
        <TitleContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.Book" Color="Color.Primary"/>
                <MudText Typo="Typo.h6">@L["Books"]</MudText>
                <MudChip T="string" Size="Size.Small" Color="@(_books.Count > 0 ? Color.Success : Color.Error)">@_books.Count</MudChip>
            </MudStack>
        </TitleContent>
        <ChildContent>
            <MudList T="PersonByBookDto" Dense="true">
                @foreach(PersonByBookDto book in _books)
                {
                    <MudListItem T="PersonByBookDto" Href="@($"/book/{book.BookId}")" Icon="@Icons.Material.Filled.Book">
                        @book.BookTitle
                        @if(!string.IsNullOrEmpty(book.Role))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="ml-2" Style="display: inline;">— @book.Role</MudText>
                        }
                    </MudListItem>
