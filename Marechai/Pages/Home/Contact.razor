@page "/contact"
<MudContainer MaxWidth="MaxWidth.Small">
    <MudText Typo="Typo.h4" Class="mb-4">Contact</MudText>
    <MudPaper Elevation="1" Class="pa-6">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.Email" Color="Color.Primary"/>
            <MudText Typo="Typo.body1"><strong>Support:</strong></MudText>
            <MudLink Href="mailto:museum@claunia.com">museum@claunia.com</MudLink>
        </MudStack>
    </MudPaper>
</MudContainer>