@page "/about"
@inject IStringLocalizer<About> L

<MudContainer MaxWidth="MaxWidth.Medium">

    <!-- Header Banner -->
    <MudPaper Class="pa-6 mb-6" Elevation="0"
              Style="background: linear-gradient(135deg, #7e57c2 0%, #42a5f5 100%); border-radius: 16px;">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
            <MudIcon Icon="@Icons.Material.Filled.Museum" Size="Size.Large" Style="color: white;" />
            <MudText Typo="Typo.h4" Style="color: white;">@L["About Marechai"]</MudText>
        </MudStack>
    </MudPaper>

    <!-- Who Are We -->
    <MudCard Elevation="2" Class="mb-4 rounded-lg">
        <MudCardContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                <MudIcon Icon="@Icons.Material.Filled.Groups" Color="Color.Primary" />
                <MudText Typo="Typo.h6">@L["Who Are We"]</MudText>
            </MudStack>
            <MudText Typo="Typo.body1">
                @((MarkupString)L["Who Are We Body"].Value)
            </MudText>
        </MudCardContent>
    </MudCard>

    <!-- What Is Marechai -->
    <MudCard Elevation="2" Class="mb-4 rounded-lg">
        <MudCardContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                <MudIcon Icon="@Icons.Material.Filled.Storage" Color="Color.Primary" />
                <MudText Typo="Typo.h6">@L["What Is Marechai"]</MudText>
            </MudStack>
            <MudText Typo="Typo.body1">
                @((MarkupString)L["What Is Marechai Body"].Value)
            </MudText>
        </MudCardContent>
    </MudCard>

    <!-- Why Not Wikipedia -->
    <MudCard Elevation="2" Class="mb-4 rounded-lg">
        <MudCardContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                <MudIcon Icon="@Icons.Material.Filled.Public" Color="Color.Primary" />
                <MudText Typo="Typo.h6">@L["Why Not Wikipedia"]</MudText>
            </MudStack>
            <MudText Typo="Typo.body1">
                @((MarkupString)L["Why Not Wikipedia Body"].Value)
            </MudText>
        </MudCardContent>
    </MudCard>

    <!-- Is the Material Free -->
    <MudCard Elevation="2" Class="mb-4 rounded-lg">
        <MudCardContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                <MudIcon Icon="@Icons.Material.Filled.LockOpen" Color="Color.Primary" />
                <MudText Typo="Typo.h6">@L["Is the Material Free"]</MudText>
            </MudStack>
            <MudText Typo="Typo.body1">
                @((MarkupString)L["Is the Material Free Body"].Value)
            </MudText>
        </MudCardContent>
    </MudCard>

    <!-- API Access -->
    <MudCard Elevation="2" Class="mb-4 rounded-lg">
        <MudCardContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                <MudIcon Icon="@Icons.Material.Filled.Api" Color="Color.Primary" />
                <MudText Typo="Typo.h6">@L["Do You Provide API Access"]</MudText>
            </MudStack>
            <MudText Typo="Typo.body1">
                @L["API Access Body"]
            </MudText>
        </MudCardContent>
    </MudCard>

    <!-- How Can I Help -->
    <MudCard Elevation="2" Class="mb-4 rounded-lg">
        <MudCardContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                <MudIcon Icon="@Icons.Material.Filled.VolunteerActivism" Color="Color.Primary" />
                <MudText Typo="Typo.h6">@L["How Can I Help"]</MudText>
            </MudStack>
            <MudText Typo="Typo.body1">
                @((MarkupString)L["How Can I Help Body 1"].Value)
            </MudText>
            <MudText Typo="Typo.body1" Class="mt-2">
                @L["How Can I Help Body 2"]
            </MudText>
        </MudCardContent>
    </MudCard>

    <!-- Why Another Site -->
    <MudCard Elevation="2" Class="mb-4 rounded-lg">
        <MudCardContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                <MudIcon Icon="@Icons.Material.Filled.QuestionAnswer" Color="Color.Primary" />
                <MudText Typo="Typo.h6">@L["Why Another Site"]</MudText>
            </MudStack>
            <MudText Typo="Typo.body1">
                @((MarkupString)L["Why Another Site Body"].Value)
            </MudText>
        </MudCardContent>
    </MudCard>

    <!-- Founder -->
    <MudCard Elevation="2" Class="mb-4 rounded-lg">
        <MudCardContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                <MudIcon Icon="@Icons.Material.Filled.Person" Color="Color.Primary" />
                <MudText Typo="Typo.h6">@L["Founder"]</MudText>
            </MudStack>
            <MudText Typo="Typo.body1">
                @((MarkupString)L["Founder Body"].Value)
            </MudText>
        </MudCardContent>
    </MudCard>

    <!-- Copyright -->
    <MudCard Elevation="2" Class="mb-4 rounded-lg">
        <MudCardContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                <MudIcon Icon="@Icons.Material.Filled.Copyright" Color="Color.Primary" />
                <MudText Typo="Typo.h6">@L["Copyright & Licensing"]</MudText>
            </MudStack>
            <MudText Typo="Typo.body1">
                @((MarkupString)L["Copyright Body"].Value)
            </MudText>
            <MudText Typo="Typo.body2" Class="mt-2">
                @((MarkupString)L["Copyright Cookies"].Value)
            </MudText>
        </MudCardContent>
    </MudCard>

    <!-- Dedication -->
    <MudCard Elevation="2" Class="mb-4 rounded-lg">
        <MudCardContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                <MudIcon Icon="@Icons.Material.Filled.Favorite" Color="Color.Primary" />
                <MudText Typo="Typo.h6">@L["Dedication"]</MudText>
            </MudStack>
            <MudText Typo="Typo.body1">
                @L["Dedication Intro"]
            </MudText>
            <MudList Dense="true" Class="mt-2" T="string">
                <MudListItem Text="@L["Dedication Tata"].Value" />
                <MudListItem Text="@L["Dedication Jhenn"].Value" />
            </MudList>
        </MudCardContent>
    </MudCard>

    <!-- Contact -->
    <MudCard id="contact" Elevation="2" Class="mb-4 rounded-lg mb-8">
        <MudCardContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                <MudIcon Icon="@Icons.Material.Filled.AlternateEmail" Color="Color.Primary" />
                <MudText Typo="Typo.h6">@L["Contact"]</MudText>
            </MudStack>
            <MudText Typo="Typo.body1">@L["Contact Body"]</MudText>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-3">
                <MudIcon Icon="@Icons.Material.Filled.Email" Color="Color.Primary" />
                <MudText Typo="Typo.body1"><strong>@L["Support"]:</strong></MudText>
                <MudLink Href="mailto:museum@claunia.com">museum@claunia.com</MudLink>
            </MudStack>
        </MudCardContent>
    </MudCard>

</MudContainer>
