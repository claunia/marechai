@page "/about"
<MudContainer MaxWidth="MaxWidth.Medium">
    <MudPaper Class="pa-6 mb-6" Elevation="0" Style="background: linear-gradient(135deg, #7e57c2 0%, #42a5f5 100%); border-radius: 16px;">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
            <MudIcon Icon="@Icons.Material.Filled.Museum" Size="Size.Large" Style="color: white;"/>
            <MudText Typo="Typo.h4" Style="color: white;">About</MudText>
        </MudStack>
    </MudPaper>

    <MudCard Elevation="2" Class="mb-4 rounded-lg">
        <MudCardContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                <MudIcon Icon="@Icons.Material.Filled.Groups" Color="Color.Primary"/>
                <MudText Typo="Typo.h6">Who are we</MudText>
            </MudStack>
            <MudText Typo="Typo.body1">We are a non-profit organization with the goal of conserve and restore old computers, video-consoles and arcade
                machines as well as to expose these machines in an office disposed for that purpose with information about computing
                history.</MudText>
        </MudCardContent>
    </MudCard>

    <MudCard Elevation="2" Class="mb-4 rounded-lg">
        <MudCardContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                <MudIcon Icon="@Icons.Material.Filled.LocationOn" Color="Color.Primary"/>
                <MudText Typo="Typo.h6">Where are we</MudText>
            </MudStack>
            <MudText Typo="Typo.body1">Actually we are located on Gran Canary island, on Las Palmas of G.C. city, in the search of a office where start
                machines exhibition and restoring activities.</MudText>
        </MudCardContent>
    </MudCard>

    <MudCard Elevation="2" Class="mb-4 rounded-lg">
        <MudCardContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                <MudIcon Icon="@Icons.Material.Filled.HistoryEdu" Color="Color.Primary"/>
                <MudText Typo="Typo.h6">Exactly what we pretend</MudText>
            </MudStack>
            <MudText Typo="Typo.body1">We pretend to conserve the computing history, as well as make it accessible to public in general, show the evolution
                and advance of a technology that concretely became part of any activity in our lifes..</MudText>
        </MudCardContent>
    </MudCard>

    <MudCard Elevation="2" Class="mb-4 rounded-lg">
        <MudCardContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                <MudIcon Icon="@Icons.Material.Filled.VolunteerActivism" Color="Color.Primary"/>
                <MudText Typo="Typo.h6">How to help</MudText>
            </MudStack>
            <MudText Typo="Typo.body1">
                Any collector is welcome to become part of tha association as well as to let his/her collection to public
                exhibition.
            </MudText>
            <MudText Typo="Typo.body1" Class="mt-2">
                Another form of helping is translating the page to other languages as well as colaborating in it maintainment and
                improvement.
            </MudText>
            <MudText Typo="Typo.body1" Class="mt-2">
                We also agree material dontions, such as machines (consoles, computers, arcade machines, monitors, peripherals, etc)
                and economic donation. Money donations will be exclusively dedicated to getting an exhibition office, as well as
                getting new machines and parts for restoring damaged machines. Repeated machines are considered trading (change
                and/or sell) objects to obtain new machines.
            </MudText>
        </MudCardContent>
    </MudCard>

    <MudCard Elevation="2" Class="mb-4 rounded-lg">
        <MudCardContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                <MudIcon Icon="@Icons.Material.Filled.Copyright" Color="Color.Primary"/>
                <MudText Typo="Typo.h6">Copyrights</MudText>
            </MudStack>
            <MudText Typo="Typo.body1">
                &copy; 2003-2026 Natalia Portillo, all rights reserved.
            </MudText>
            <MudText Typo="Typo.body2" Class="mt-1">The names are property of their respective authors.</MudText>
            <MudText Typo="Typo.body2">Photos are property of their respective authors.</MudText>
            <MudText Typo="Typo.body2">Rest of content if property of Natalia Portillo except other indication.</MudText>
        </MudCardContent>
    </MudCard>

    <MudCard Elevation="2" Class="mb-4 rounded-lg">
        <MudCardContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                <MudIcon Icon="@Icons.Material.Filled.Translate" Color="Color.Primary"/>
                <MudText Typo="Typo.h6">Greetings to translators</MudText>
            </MudStack>
            <MudList T="string" Dense="true">
                <MudListItem T="string">Natalia Portillo (English)</MudListItem>
            </MudList>
        </MudCardContent>
    </MudCard>
</MudContainer>