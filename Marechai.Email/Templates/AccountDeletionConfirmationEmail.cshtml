@using Marechai.Email.Templates
@model AccountDeletionConfirmationEmailModel
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@Model.Title</title>
</head>
<body style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background:#f4f4f6; margin:0; padding:24px;">
    <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="max-width:520px; margin:0 auto; background:#ffffff; border-radius:8px; padding:32px;">
        <tr>
            <td style="text-align:center;">
                <h1 style="margin:0 0 16px; font-size:20px; color:#c62828;">@Model.Title</h1>
                <p style="margin:0 0 24px; color:#555; font-size:14px;">@Model.Intro</p>
                <p style="margin:0 0 24px;">
                    <a href="@Model.ConfirmUrl"
                       style="display:inline-block; padding:14px 28px; background:#c62828; color:#ffffff; text-decoration:none; border-radius:6px; font-size:15px; font-weight:600;">
                        @Model.ButtonText
                    </a>
                </p>
                <p style="margin:0 0 8px; color:#777; font-size:13px;">@Model.LinkFallback</p>
                <p style="margin:0 0 24px; word-break:break-all; font-family: 'SFMono-Regular', Menlo, Consolas, monospace; font-size:12px; color:#444; background:#f0f0f3; padding:12px; border-radius:6px;">
                    <a href="@Model.ConfirmUrl" style="color:#444; text-decoration:none;">@Model.ConfirmUrl</a>
                </p>
                <p style="margin:0; color:#aaa; font-size:12px;">@Model.Footer</p>
            </td>
        </tr>
    </table>
</body>
</html>
