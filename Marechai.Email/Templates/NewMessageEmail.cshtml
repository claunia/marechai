@using System.Net
@using Marechai.Email.Templates
@model NewMessageEmailModel
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@Model.Title</title>
</head>
<body style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background:#f4f4f6; margin:0; padding:24px;">
    <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="max-width:560px; margin:0 auto; background:#ffffff; border-radius:8px; padding:32px;">
        <tr>
            <td>
                <h1 style="margin:0 0 16px; font-size:20px; color:#222;">@Model.Title</h1>
                <p style="margin:0 0 16px; color:#444; font-size:14px;">@Model.Intro</p>
                <blockquote style="margin:0 0 24px; padding:14px 18px; background:#f0f0f3; border-left:4px solid #7e57c2; border-radius:4px; color:#333; font-size:14px; line-height:1.5; white-space:pre-wrap; word-wrap:break-word;">@Html.Raw(WebUtility.HtmlEncode(Model.MessageBody).Replace("\n", "<br>"))</blockquote>
                <p style="margin:0 0 24px; text-align:center;">
                    <a href="@Model.MessageUrl"
                       style="display:inline-block; padding:14px 28px; background:#7e57c2; color:#ffffff; text-decoration:none; border-radius:6px; font-size:15px; font-weight:600;">
                        @Model.ButtonText
                    </a>
                </p>
                <p style="margin:0 0 8px; color:#777; font-size:13px;">@Model.LinkFallback</p>
                <p style="margin:0 0 24px; word-break:break-all; font-family: 'SFMono-Regular', Menlo, Consolas, monospace; font-size:12px; color:#444; background:#f0f0f3; padding:12px; border-radius:6px;">
                    <a href="@Model.MessageUrl" style="color:#444; text-decoration:none;">@Model.MessageUrl</a>
                </p>
                <p style="margin:0; color:#aaa; font-size:12px;">@Model.Footer</p>
            </td>
        </tr>
    </table>
</body>
</html>
